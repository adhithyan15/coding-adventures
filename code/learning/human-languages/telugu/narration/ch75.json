        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ముందు",
          "segments": [
            {
              "kind": "speech",
              "text": "ముందు (mundu) — \"before\"."
            },
            {
              "kind": "speech",
              "text": "You already have తరువాత, \"after that\". ముందు (mundu) is its other half, and until now you could only order events one way."
            },
            {
              "kind": "speech",
              "text": "Like most Telugu relation words it follows its noun: భోజనం ముందు (mundu) — \"before the meal\". It also means \"in front\" in space, which is the same idea pointed at a room instead of a day."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "Both ends of an order: ముందు (mundu) and తరువాత."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
