        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: पठनम्",
          "segments": [
            {
              "kind": "speech",
              "text": "पठनम् — paṭhanam — \"reading\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "paṭhana is built on the root √paṭh, \"to read aloud, recite\" (MW; CDIAL 7713), the root of paṭhati, \"reads\", which you have already met. The verb lives on as Hindi paṛhnā, \"to read\" (CDIAL 7712)."
            }
          ]
        },
