              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *patlā*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "say patlā",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: say *patlā*]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say the Punjabi for sweet, then the Punjabi for fat, then say patlā again",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say the Punjabi for sweet, then the Punjabi for fat, then say *patlā* again]"
            }
          ]
        },
        {
          "index": 5,
