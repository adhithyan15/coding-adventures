  -- bounds, to_int / to_nat -----------------------------------------------------------
  model m_max_value_u8() -> U8 = max_value<U8>()
  model m_min_value_u8() -> U8 = min_value<U8>()
  model m_to_int_u8(a: U8) -> Int = to_int(a)
  model m_to_nat_u8(a: U8) -> Nat = to_nat(a)
  model m_max_value_u16() -> U16 = max_value<U16>()
