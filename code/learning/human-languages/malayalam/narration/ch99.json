        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:8ad71bc317c52a3c",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
