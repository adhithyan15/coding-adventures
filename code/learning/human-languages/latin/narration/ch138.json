            {
              "kind": "speech",
              "text": "Before the new one: say the Latin for a barber, then the Latin for a shepherd."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: piscātor, piscātōris",
          "segments": [
            {
              "kind": "speech",
              "text": "piscātor, piscātōris — \"a fisherman\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "piscātor is built on piscor, \"to fish\", from piscis, \"a fish\" (EtymDB 2.1), with -tor, \"one who does it\". piscis is usually traced to Proto-Indo-European pisk-, \"fish\" (EtymDB 2.1); English fish is a cousin."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for this chapter."
