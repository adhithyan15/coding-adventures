        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: a boia",
          "segments": [
            {
              "kind": "speech",
              "text": "a boia — \"the buoy; the float, the rubber ring\"."
            },
            {
              "kind": "speech",
              "text": "As crianças nadam com boias nos braços. The children swim with armbands on."
            },
            {
              "kind": "speech",
              "text": "Boias on the arms are armbands; uma boia in the sea marks a safe area."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "boia was borrowed from Old French; EtymDB traces the French word to a Frankish word related to beacon 'sign'."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
