        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: le diplôme",
          "segments": [
            {
              "kind": "speech",
              "text": "le diplôme — \"the diploma, the degree\"."
            },
            {
              "kind": "speech",
              "text": "Il a enfin son diplôme d'infirmier. He finally has his nursing diploma."
            },
            {
              "kind": "speech",
              "text": "Passer un diplôme — to take a qualification."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "diplôme comes from Latin diplōma \"a letter folded double, a state letter of recommendation\" (EtymDB; Lewis & Short), from Greek díplōma \"a folded paper\", built on diplóos \"double\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
