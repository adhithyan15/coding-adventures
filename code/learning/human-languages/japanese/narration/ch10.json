              "text": "Hide it and write it from ne."
            },
            {
              "kind": "speech",
              "text": "Assemble お (o) | ね (ne) | が | い | し (shi) | ま | す."
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "speech",
              "text": "Read おねがいします without romanization, then stop."
