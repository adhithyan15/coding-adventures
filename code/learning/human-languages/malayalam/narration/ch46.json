      "id": "ML-C46-fruit",
      "sequence": 1190,
      "title": "പഴം (paḻaṁ) — a fruit",
      "headword": "പഴം",
      "romanization": "paḻaṁ",
      "gloss": "a fruit",
      "script": "malayalam",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
