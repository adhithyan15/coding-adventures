          "title": "You'll want to know: anteriormente",
          "segments": [
            {
              "kind": "speech",
              "text": "anteriormente — \"previously, earlier\"."
            },
            {
              "kind": "speech",
              "text": "Anteriormente vivía en Madrid. Previously she lived in Madrid."
            },
            {
              "kind": "speech",
              "text": "A formal word; in speech people say antes."
            }
          ]
        },
        {
