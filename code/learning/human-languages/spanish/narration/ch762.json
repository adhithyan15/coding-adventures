        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: el crucigrama",
          "segments": [
            {
              "kind": "speech",
              "text": "el crucigrama — \"the crossword\"."
            },
            {
              "kind": "speech",
              "text": "Hago el crucigrama del periódico. I do the newspaper crossword."
            },
            {
              "kind": "speech",
              "text": "Masculine, though it ends in -a."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "crucigrama is built on cruz \"cross\", from Latin crux, and Greek grámma \"letter\", a twentieth-century coinage for crossed words."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
