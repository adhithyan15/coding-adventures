        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: die Trauer",
          "segments": [
            {
              "kind": "speech",
              "text": "die Trauer — \"the grief, mourning\"."
            },
            {
              "kind": "speech",
              "text": "Die Trauer in der Familie war groß. The grief in the family was great."
            },
            {
              "kind": "speech",
              "text": "No plural. Traurig, already known, is related."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Trauer comes from Middle High German trūre \"mourning\", from Old High German trūrēn \"to mourn\" (EtymDB)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
