# frozen_string_literal: true

require "rake/testtask"
Rake::TestTask.new(:test) do |task|
  task.libs << "lib" << "test"
  task.pattern = "test/test_*.rb"
end
task :package_smoke do
  ruby "scripts/gem_smoke.rb"
end
task :command_coverage do
  ruby "scripts/check_command_coverage.rb"
end
task default: [:test, :package_smoke, :command_coverage]
