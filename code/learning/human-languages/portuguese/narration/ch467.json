            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Portuguese for a jungle, then the Portuguese for a slipper."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: o orgulho",
          "segments": [
            {
              "kind": "speech",
              "text": "o orgulho — \"pride\"."
            },
            {
              "kind": "speech",
              "text": "O meu pai fala do meu trabalho com muito orgulho. My father talks about my work with great pride."
            },
            {
              "kind": "speech",
              "text": "Ter orgulho em alguém (or de alguém) — to be proud of someone."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "orgulho came into Old Portuguese from Catalan orgull \"pride\" (EtymDB), which was borrowed from a Frankish word urgol of the same meaning."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
