-- DSP-DCT -- Discrete Cosine Transform for the DSP layer
--
-- Warrant specification for typescript/dsp-dct (VER04h / DSP02).
-- Covers memory safety, resource bounding (CWE-400), integer overflow prevention (CWE-190),
-- strictly iterative execution (CWE-674), and all-operands-public guarantees.

warrant dsp_dct v1
  error DctError = INVALID_INPUT | EMPTY_INPUT | FFT_ERROR

  op dct(signal: Bytes, dct_type: Nat, norm: Nat) -> Result<Bytes, DctError>
  op idct(coeffs: Bytes, dct_type: Nat, norm: Nat) -> Result<Bytes, DctError>
  op dct_2d(image: Bytes, height: Nat, width: Nat, dct_type: Nat, norm: Nat) -> Result<Bytes, DctError>
  op idct_2d(image: Bytes, height: Nat, width: Nat, dct_type: Nat, norm: Nat) -> Result<Bytes, DctError>

  assume platform:
    none
  assume environment:
    none

  -- All operands are public spectral/signal data.
  labels dct:
    signal public
    dct_type public
    norm public
  labels idct:
    coeffs public
    dct_type public
    norm public
  labels dct_2d:
    image public
    height public
    width public
    dct_type public
    norm public
  labels idct_2d:
    image public
    height public
    width public
    dct_type public
    norm public

  -- Bounded inputs: MAX_DCT_LEN = 1 << 20, MAX_SAMPLES = 1 << 24.
  input dct.signal:
    hostile
    rejects len(signal) == 0 with DctError.EMPTY_INPUT
    rejects len(signal) > 67108864 with DctError.INVALID_INPUT
    ensures no_panic, terminates
  input dct.dct_type:
    hostile
    ensures no_panic, terminates
  input dct.norm:
    hostile
    ensures no_panic, terminates

  input idct.coeffs:
    hostile
    rejects len(coeffs) == 0 with DctError.EMPTY_INPUT
    rejects len(coeffs) > 67108864 with DctError.INVALID_INPUT
    ensures no_panic, terminates
  input idct.dct_type:
    hostile
    ensures no_panic, terminates
  input idct.norm:
    hostile
    ensures no_panic, terminates

  input dct_2d.image:
    hostile
    rejects len(image) == 0 with DctError.EMPTY_INPUT
    rejects len(image) > 67108864 with DctError.INVALID_INPUT
    ensures no_panic, terminates
  input dct_2d.height:
    hostile
    rejects height == 0 with DctError.INVALID_INPUT
    rejects height > 1048576 with DctError.INVALID_INPUT
    ensures no_panic, terminates
  input dct_2d.width:
    hostile
    rejects width == 0 with DctError.INVALID_INPUT
    rejects width > 1048576 with DctError.INVALID_INPUT
    ensures no_panic, terminates
  input dct_2d.dct_type:
    hostile
    ensures no_panic, terminates
  input dct_2d.norm:
    hostile
    ensures no_panic, terminates

  input idct_2d.image:
    hostile
    rejects len(image) == 0 with DctError.EMPTY_INPUT
    rejects len(image) > 67108864 with DctError.INVALID_INPUT
    ensures no_panic, terminates
  input idct_2d.height:
    hostile
    rejects height == 0 with DctError.INVALID_INPUT
    rejects height > 1048576 with DctError.INVALID_INPUT
    ensures no_panic, terminates
  input idct_2d.width:
    hostile
    rejects width == 0 with DctError.INVALID_INPUT
    rejects width > 1048576 with DctError.INVALID_INPUT
    ensures no_panic, terminates
  input idct_2d.dct_type:
    hostile
    ensures no_panic, terminates
  input idct_2d.norm:
    hostile
    ensures no_panic, terminates

  -- Declared bounds (WX-H): O(N log N) for II/III, O(N^2) for I/IV.
  bound dct:
    output <= len(signal)
    steps <= 64 * len(signal) + 4096
    heap <= 4 * len(signal) + 8192
    depth <= 32

  bound idct:
    output <= len(coeffs)
    steps <= 64 * len(coeffs) + 4096
    heap <= 4 * len(coeffs) + 8192
    depth <= 32

  bound dct_2d:
    output <= len(image)
    steps <= 64 * len(image) + 4096
    heap <= 4 * len(image) + 8192
    depth <= 32

  bound idct_2d:
    output <= len(image)
    steps <= 64 * len(image) + 4096
    heap <= 4 * len(image) + 8192
    depth <= 32
