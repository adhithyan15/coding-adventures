    {
      "id": "MW-C05-practice",
      "sequence": 400,
      "title": "Practice — ask one name and give one name",
      "headword": "थारो नाम कांई है? — म्हारो नाम राम है।",
      "romanization": "thāro nām kāĩ hai? — mhāro nām rām hai.",
      "gloss": "What is your name? My name is Ram.",
      "script": "devanagari",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:9c47f3942c50897f",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 25,
              "perItem": false,
              "source": "[PAUSE 25s]"
            },
            {
              "kind": "speech",
              "text": "Say the four older meanings as you hear rām-rām sā, ābhār, hā(n) sā, and pāṇī. Write only पाणी from the last cue."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know",
          "segments": [
            {
              "kind": "speech",
              "text": "थारो (thāro) नाम कांई (kāĩ) है? म्हारो नाम राम है।."
            },
            {
              "kind": "speech",
              "text": "The question asks What is your name? The answer says My name is Ram. In speech, replace rām with the name the speaker chooses. This book teaches one documented central-Marwari form; regional speakers may use another possessive or copula, and that variation is not an error."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "speech",
              "text": "Listen: hear one of the two lines and identify question or answer."
            },
            {
              "kind": "speech",
              "text": "Speak: hear the question and answer with a chosen name, without notes."
            },
            {
              "kind": "speech",
              "text": "Read: match the printed question to the printed answer."
            },
            {
              "kind": "speech",
              "text": "Write: hear the question, wait ten seconds, and write it with no model."
            },
            {
              "kind": "speech",
              "text": "Score each line separately. Speaking cannot cover a missing word in writing; reading cannot cover an unanswered spoken question."
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "speech",
              "text": "Stop after one complete exchange. Accuracy comes before speed."
            },
            {
              "kind": "speech",
              "text": "Sources: Ek Bharat Shreshtha Bharat language report, SIL International, Marwari–English Dictionary (2015), and Rajasthan Sahitya Akademi, Jāgtī Jot, September 1999."
            },
            {
              "kind": "activity",
              "scored": true,
              "id": "MW-C05-practice-name-exchange",
              "prompt": "From sound alone, write the Marwadi question What is your name?, then answer aloud with a chosen name.",
              "assesses": [
                "MW-QUESTION-NAME-01",
                "MW-DIALOGUE-NAME-EXCHANGE-01",
                "MW-SCRIPT-THARO-01",
                "MW-SCRIPT-NAAM-01",
                "MW-SCRIPT-KAIN-01",
                "MW-SCRIPT-HAI-01",
                "MW-PHRASE-MY-NAME-IS-01"
              ],
              "responseSeconds": 30,
              "acceptedResponses": [
                "थारो नाम कांई है? — म्हारो नाम [name] है।",
                "थारो नाम कांई है",
                "thāro nām kāĩ hai"
              ],
              "feedback": {
                "correct": "The question is complete; now answer with mhāro nām and a chosen name.",
                "incorrect": "Repair one known group: थारो | नाम | कांई | है."
              }
            }
          ]
        }
      ]
    }
