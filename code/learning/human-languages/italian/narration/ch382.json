          "segments": [
            {
              "kind": "speech",
              "text": "appunti is built on appuntare \"to jot down, to pin\", from a- and punto \"point\", which is inherited from Latin punctum \"a prick, a point\" (Lewis & Short)."
            }
          ]
        },
