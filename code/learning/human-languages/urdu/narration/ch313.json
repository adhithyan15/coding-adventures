          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "انگریز (angrez) is usually traced to Portuguese inglês, \"English\", which reached Urdu through Persian angrez. انگریزی is the language."
            }
          ]
        },
