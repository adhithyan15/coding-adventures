            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Marathi for an aunt, then the Marathi for an uncle."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: नवरा",
          "segments": [
            {
              "kind": "speech",
              "text": "नवरा — navrā — \"a husband\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "नवरा (navrā) is a tadbhava, a word inherited and reshaped by sound change. It comes from navavaraka, \"newly wed\", a form CDIAL reconstructs from its descendants (CDIAL 7013). It is nava, \"new\", and vara, \"bridegroom\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for this chapter."
            }
          ]
        },
