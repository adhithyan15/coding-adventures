              "action": "SAY",
              "instruction": "el tío y la tía",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *el tío y la tía*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "la tía y la abuela",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *la tía y la abuela*]"
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Where does English aunt come from? (Latin amita.) How many ancient words are in play for uncle and aunt? (Three --- thius, avunculus, amita.) Is calling a stranger tía neutral? (No --- casual.)"
            }
          ]
        }
      ]
