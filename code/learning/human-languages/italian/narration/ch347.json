          "segments": [
            {
              "kind": "speech",
              "text": "il giudizio — \"the judgement; good sense\"."
            },
            {
              "kind": "speech",
              "text": "Non dare un giudizio prima di conoscerlo. Do not pass judgement before you know him."
            },
            {
              "kind": "speech",
              "text": "Mettere giudizio — to grow sensible. A mio giudizio — in my judgement."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "giudizio is inherited from Latin iūdicium \"a trial, a judgement, an opinion\" (Lewis & Short), built on iūdex \"a judge\"."
            }
          ]
        },
