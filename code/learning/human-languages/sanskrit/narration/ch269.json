              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: **आकाशवाणी** — radio]"
            },
            {
              "kind": "prompt",
              "action": "CONTRAST",
              "instruction": "आकाशवाणी (ākāśavāṇī) — radio; दूरभाषः — telephone",
