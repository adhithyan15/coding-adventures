cabal-version:      2.4
name:               conduit-hello
version:            0.1.0.0
synopsis:           Hello-world demo application for the Haskell Conduit web framework.
description:
    An 8-route demo that exercises the full Conduit DSL: route registration,
    path parameters, query parameters, before-filters, after-hooks, halt,
    custom not-found, and error handlers.
license:            MIT
author:             Coding Adventures
maintainer:         contact@coding-adventures.com
build-type:         Simple

executable conduit-hello
    main-is:          Main.hs
    hs-source-dirs:   src
    default-language: Haskell2010
    default-extensions: OverloadedStrings
    ghc-options:      -Wall -threaded -rtsopts -with-rtsopts=-N
    build-depends:
        base       >= 4.7  && < 5
      , text       >= 1.2  && < 2.2
      , conduit

test-suite conduit-hello-test
    default-language: Haskell2010
    default-extensions: OverloadedStrings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          SmokeSpec.hs
    ghc-options:      -Wall -threaded -rtsopts -with-rtsopts=-N
    build-depends:
        base       >= 4.7  && < 5
      , bytestring >= 0.10 && < 0.13
      , text       >= 1.2  && < 2.2
      , conduit
      , hspec      >= 2.0  && < 3
      , network    >= 3.0  && < 4
