# Parked, not active (VOS-D064).  Renamed from `evidence.bindings` because the generator
# (gen_evidence, and warrant-grammar's v0_compat test) treats every package with that file name
# as having a checked-in harness, and none can be generated until the contract block's lemmas
# are supported or moved.  Rename it back and run gen_evidence when VOS-D064 is resolved.
#
# Warrant binding manifest (VER04 section 6, VER04j section 4.6) for
# code/specs/vos-sched-fp-bitmap.warrant, which `vos-link gen-doc` generates (VOS02 10.1):
# never edit that document by hand.
#
# Every operation is bound to a `vos_ghost_` wrapper of the crate root (VOS02 4.3, SH17): the
# production state keeps its field private, the harness builds states through the
# public-field `ghost::Image`.  `Impl` is that image, `AbsW` and `CfgN` the one-field integer
# records of the interim vocabulary (VOS02 4.4); `Upd` and `Pick` are the contract's own enums.
#
# faults=: the deliberate faults the negative controls attack each operation with.  The
# tuple-returning operations are bound as a projection pair (`_out`, `_img`) so a fault applies
# to each (VOS02 4.4, VOS-D021).  `init` is bound with `field-zero`, which is inert on a zero
# initial state (VOS02 13.4 F4): no control for `init` can pass.
package vos_sched_fp_bitmap
revision 0.1.0
spec code/specs/vos-sched-fp-bitmap.warrant
output code/packages/rust/vos-sched-fp-bitmap/tests/generated/warrant_evidence.rs
seed 0x564f_5331_315f_5746
property_cases 4096
fuzz_iterations 5000
negctl_fuzz_iterations 1000
exhaustive_budget 400000

struct Impl path=vos_sched_fp_bitmap::ghost::Image fields=mask:u8
struct AbsW path=vos_sched_fp_bitmap::ghost::AbsW fields=w:u8
struct CfgN path=vos_sched_fp_bitmap::ghost::CfgN fields=v:u8
enum Upd path=vos_sched_contract::Upd ctors=Changed,Unchanged,OutOfRange
enum Pick path=vos_sched_contract::Pick ctors=Idle,Run(0:u8)

op init export=vos_ghost_init ret=Impl faults=field-zero
op insert_out export=vos_ghost_insert_out args=Impl,u8 ret=Upd faults=wrong-ctor
op insert_img export=vos_ghost_insert_img args=Impl,u8 ret=Impl faults=field-zero
op remove_out export=vos_ghost_remove_out args=Impl,u8 ret=Upd faults=wrong-ctor
op remove_img export=vos_ghost_remove_img args=Impl,u8 ret=Impl faults=field-zero
op dispatch_out export=vos_ghost_dispatch_out args=Impl ret=Pick faults=wrong-ctor
op dispatch_img export=vos_ghost_dispatch_img args=Impl ret=Impl faults=field-zero
op alpha_w export=vos_ghost_alpha_w args=Impl ret=AbsW faults=field-zero
op cfg_n export=vos_ghost_cfg_n ret=CfgN faults=field-zero
