        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: accélérer",
          "segments": [
            {
              "kind": "speech",
              "text": "accélérer — \"to speed up, to accelerate\"."
            },
            {
              "kind": "speech",
              "text": "Sur l'autoroute, mon père accélère un peu trop. On the motorway my father speeds up a little too much."
            },
            {
              "kind": "speech",
              "text": "L'accélérateur is the accelerator pedal."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "accélérer is a learned borrowing from Latin accelerāre 'to hasten', built on celer 'swift' (Lewis & Short)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
