        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "MW lists \"necklace, string of pearls\" among the senses of hāra, a noun of the root √hṛ, \"to carry, take\". CDIAL 14059 treats the necklace word as a separate hāra, so the link is not settled. It lives on as Punjabi and Gujarati hār, \"necklace\"."
            }
          ]
        },
