        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: l'enquêteur",
          "segments": [
            {
              "kind": "speech",
              "text": "l'enquêteur — \"the investigator\"."
            },
            {
              "kind": "speech",
              "text": "Les enquêteurs ont parlé avec les voisins. The investigators talked to the neighbours."
            },
            {
              "kind": "speech",
              "text": "Feminine: l'enquêtrice."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "enquêteur is built on the noun for \"an inquiry\", which is inherited from Latin inquīsīta \"things sought\", from inquīrere \"to seek into\", built on quaerere \"to seek\" (Lewis & Short)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
