      "expected": {
        "outcome": "value",
        "value": {"kind": "finite", "decimal": "1"},
        "comparison": {"kind": "absolute", "tolerance": "1e-10"}
      }
    },
    {
      "id": "phy01/evaluate/periodic-base",
      "operation": "evaluate",
      "summary": "A representative phased wave value anchors periodicity.",
      "input": {
        "wave": {
          "amplitude": {"kind": "finite", "decimal": "2.5"},
          "frequency": {"kind": "finite", "decimal": "3"},
          "phase": {"kind": "finite", "decimal": "0.7"}
        },
        "time": {"kind": "finite", "decimal": "0.137"}
      },
      "expected": {
        "outcome": "value",
        "value": {"kind": "finite", "decimal": "-0.35082946230776246"},
        "comparison": {"kind": "absolute", "tolerance": "1e-10"}
      }
    },
    {
      "id": "phy01/evaluate/periodic-next-cycle",
      "operation": "evaluate",
      "summary": "Adding one period preserves the representative phased wave value.",
      "input": {
        "wave": {
          "amplitude": {"kind": "finite", "decimal": "2.5"},
          "frequency": {"kind": "finite", "decimal": "3"},
          "phase": {"kind": "finite", "decimal": "0.7"}
        },
        "time": {"kind": "finite", "decimal": "0.4703333333333333"}
      },
      "expected": {
        "outcome": "value",
        "value": {"kind": "finite", "decimal": "-0.35082946230776246"},
        "comparison": {"kind": "absolute", "tolerance": "1e-10"}
      }
    },
