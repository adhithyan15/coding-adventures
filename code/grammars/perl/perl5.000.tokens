# Perl 5.000 (1994-10-17) tokens: verified arithmetic-print subset only.
# @version 1
# PARTIAL: this does not lex all Perl 5.000 source.
# Evidence: https://github.com/Perl/perl5/blob/perl-5.000/perly.y
# Evidence: https://github.com/Perl/perl5/blob/perl-5.000/toke.c
# The tagged tokenizer maps `print` to KEY_print and a list-operator token.

PRINT     = "print"
INT       = /[0-9]+/
PLUS      = "+"
DECREMENT = "--"
MINUS     = "-"
STAR      = "*"
LPAREN    = "("
RPAREN    = ")"
SEMICOLON = ";"

skip:
  WHITESPACE = /[ \t\r\n]+/
