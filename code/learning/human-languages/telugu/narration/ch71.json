      ],
      "sourceHash": "fnv1a64:85f71d8322695bbe",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: what did sālīḍu mean?"
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: మామ",
          "segments": [
            {
              "kind": "speech",
              "text": "మామ (māma) — \"an uncle; a father-in-law\"."
            },
            {
              "kind": "speech",
              "text": "మామ (māma) is a mother's brother, and it is also a father-in-law. Telugu keeps one word for both because for a very long time they were often the same man."
            },
            {
              "kind": "speech",
              "text": "That is the whole of it: a man's sister's daughter was the expected match for his son, so the uncle a child grew up with became the father-in-law they married into."
            },
            {
              "kind": "speech",
              "text": "Asking after a మామ (māma)'s ఆరోగ్యం is the first thing said after నమస్కారం in a house you have married into."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One. And the reason Telugu needs fewer family words than you expect."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "māma",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *māma*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "it once more, slowly",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: it once more, slowly]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "māma, then ārōgyaṁ, as one question",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *māma*, then *ārōgyaṁ*, as one question]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What does మామ (māma) mean? (\"an uncle; a father-in-law\".) Say it once more."
            }
          ]
        }
      ]
    },
