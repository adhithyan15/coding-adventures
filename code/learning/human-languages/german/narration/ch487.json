        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: der Hausarzt",
          "segments": [
            {
              "kind": "speech",
              "text": "der Hausarzt — \"family doctor, GP\"."
            },
            {
              "kind": "speech",
              "text": "Mit Fieber gehe ich zuerst zum Hausarzt. With a fever I go to my GP first."
            },
            {
              "kind": "speech",
              "text": "Plural: die Hausärzte. A woman is die Hausärztin."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Hausarzt is built on Haus \"house\" and Arzt \"doctor\", which comes through Old High German arzāt from Late Latin archiāter \"physician\" (EtymDB), a word from Greek."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
