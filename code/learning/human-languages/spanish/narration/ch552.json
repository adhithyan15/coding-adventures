            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Spanish for to emigrate, then the Spanish for to adapt."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: el inmigrante",
          "segments": [
            {
              "kind": "speech",
              "text": "el inmigrante — \"the immigrant\"."
            },
            {
              "kind": "speech",
              "text": "Muchos inmigrantes trabajan en el campo. Many immigrants work on the land."
            },
            {
              "kind": "speech",
              "text": "The same form for a woman: la inmigrante."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "inmigrante is built on inmigrar, a learned word from Latin immigrāre 'to move into' (Lewis & Short), built on in and migrāre 'to move'."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
