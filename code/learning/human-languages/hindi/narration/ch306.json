              "instruction": "say the Hindi for a deluge, then the Hindi for a whirlpool, then say akāl again",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say the Hindi for a deluge, then the Hindi for a whirlpool, then say *akāl* again]"
            }
          ]
        },
        {
          "index": 5,
