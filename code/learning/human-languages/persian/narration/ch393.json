          "segments": [
            {
              "kind": "speech",
              "text": "تردید (tardid) — \"doubt, hesitation\"."
            },
            {
              "kind": "speech",
              "text": "بدون تردید این بهترین راه است. bedun-e tardid in behtarin râh ast. Without doubt this is the best way."
            },
            {
              "kind": "speech",
              "text": "Tardid dâshtan — to be in doubt, to hesitate."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "تردید (tardid) is usually traced to Arabic tardīd, a verbal noun usually explained as going back and forth: a doubting mind wavers."
            }
          ]
        },
