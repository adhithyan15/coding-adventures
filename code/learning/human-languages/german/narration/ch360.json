          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "diskriminieren is a learned borrowing from Latin discrīmināre \"to divide, to separate\", from discrīmen \"that which divides\" (Lewis & Short): you set people apart."
            }
          ]
        },
