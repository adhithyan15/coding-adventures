          "segments": [
            {
              "kind": "speech",
              "text": "ответственный (otvétstvennyy) — \"responsible, in charge\"."
            },
            {
              "kind": "speech",
              "text": "Кто ответственный за этот проект? Kto otvétstvennyy za étot proyékt? Who is responsible for this project?"
            },
            {
              "kind": "speech",
              "text": "Ответственный за + accusative. Short form ответствен. Of a moment: ответственный (otvétstvennyy) момент, a crucial moment."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ответственный (otvétstvennyy) is built on ответ \"an answer\", from от- \"back\" and the old word for counsel and speech, Old Russian větŭ. The person responsible is the one who must answer for it."
            }
          ]
        },
