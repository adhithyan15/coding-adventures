        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: die Wut",
          "segments": [
            {
              "kind": "speech",
              "text": "die Wut — \"rage, fury\"."
            },
            {
              "kind": "speech",
              "text": "Vor Wut warf er sein Handy auf das Sofa. In a rage, he threw his phone onto the sofa."
            },
            {
              "kind": "speech",
              "text": "No plural. Eine Wut haben auf + accusative — to be furious with."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Wut is inherited from Middle High German wuot and Old High German wuot \"mad, madness\", from Proto-Germanic wōdaz (EtymDB)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
