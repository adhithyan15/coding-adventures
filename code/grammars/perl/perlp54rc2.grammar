# Perl p54rc2 (1997-05-14) grammar: plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: unsupported Perl p54rc2 syntax is rejected.
# Evidence: https://mirrors.develooper.com/perl/historical-perl/perl-p54rc2.tar.gz
# Archive SHA-256: 973d9cadb2a1efbcdac705fe1eb08e351d746f9480aa806d6b54ecc3344e5f9d.
# Archive yacc matches 5.004; this separate file retains only arithmetic
# precedence, parentheses and print subset.

program         = print_statement { print_statement } ;
print_statement = PRINT LPAREN expr RPAREN SEMICOLON ;
expr            = term { ( PLUS | MINUS ) term } ;
term            = unary { STAR unary } ;
unary           = MINUS unary | atom ;
atom            = INT | LPAREN expr RPAREN ;
