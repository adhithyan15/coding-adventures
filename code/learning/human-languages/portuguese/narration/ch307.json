          "type": "input",
          "title": "You'll want to know: o ferido",
          "segments": [
            {
              "kind": "speech",
              "text": "o ferido — \"the injured person, the wounded\"."
            },
            {
              "kind": "speech",
              "text": "O ferido foi levado para o hospital. The injured man was taken to hospital."
            },
            {
              "kind": "speech",
              "text": "Feridos ligeiros — minor injuries; feridos graves — serious ones."
            }
          ]
        },
