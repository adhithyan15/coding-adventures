          "type": "input",
          "title": "You'll want to know: lūctus, lūctūs",
          "segments": [
            {
              "kind": "speech",
              "text": "lūctus, lūctūs — \"grief, mourning\"."
            },
            {
              "kind": "speech",
              "text": "Tōta domus in lūctū erat. The whole household was in mourning."
            },
            {
              "kind": "speech",
              "text": "Masculine, 4th declension, from lūgeō, 'to mourn' (taught). Mourners wore dark clothes."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "lūctus is built on lūgeō, \"to mourn\" (EtymDB): sorrow shown for the dead."
            }
          ]
        },
