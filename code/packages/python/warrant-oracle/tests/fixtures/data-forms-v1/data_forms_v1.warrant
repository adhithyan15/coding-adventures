  -- claims: one reference claim per model (op_<m>(args) == m(args)) -----------------------------
  claim c_some_u8:
    forall a: U8. op_some_u8(a) == some_u8(a)
  claim c_none_u8:
    forall u: Bool. op_none_u8(u) == none_u8(u)
  claim c_none_bytes:
    forall u: Bool. op_none_bytes(u) == none_bytes(u)
  claim c_some_lit:
    forall u: Bool. op_some_lit(u) == some_lit(u)
  claim c_some_nested:
    forall a: U8. op_some_nested(a) == some_nested(a)
  claim c_some_none:
    forall u: Bool. op_some_none(u) == some_none(u)
  claim c_opt_if:
    forall c: Bool, a: U8. op_opt_if(c, a) == opt_if(c, a)
  claim c_opt_if_rev:
    forall c: Bool, a: U8. op_opt_if_rev(c, a) == opt_if_rev(c, a)
  claim c_opt_bytes:
    forall d: Bytes. op_opt_bytes(d) == opt_bytes(d)
  claim c_opt_fixed_bytes:
    forall d: Bytes<2>. op_opt_fixed_bytes(d) == opt_fixed_bytes(d)
  claim c_opt_pair:
    forall a: Bool. op_opt_pair(a) == opt_pair(a)
  claim c_opt_rec:
    forall a: U8, b: U8. op_opt_rec(a, b) == opt_rec(a, b)
  claim c_res_opt:
    forall a: U8. op_res_opt(a) == res_opt(a)
  claim c_res_none:
    forall u: Bool. op_res_none(u) == res_none(u)
  claim c_opt_eq:
    forall a: Option<U8>, b: Option<U8>. op_opt_eq(a, b) == opt_eq(a, b)
  claim c_opt_ne:
    forall a: Option<U8>, b: Option<U8>. op_opt_ne(a, b) == opt_ne(a, b)
  claim c_opt_is_none:
    forall a: Option<U8>. op_opt_is_none(a) == opt_is_none(a)
  claim c_opt_is_some_lit:
    forall a: Option<U8>. op_opt_is_some_lit(a) == opt_is_some_lit(a)
  claim c_unwrap_binder:
    forall o: Option<U8>. op_unwrap_binder(o) == unwrap_binder(o)
  claim c_inter_add:
    forall a: U8, b: U8. op_inter_add(a, b) == inter_add(a, b)
  claim c_inter_at:
    forall d: Bytes, i: Nat. op_inter_at(d, i) == inter_at(d, i)
  claim c_inter_div_nat:
    forall a: Nat, b: Nat. op_inter_div_nat(a, b) == inter_div_nat(a, b)
  claim c_prod_eq:
    forall a: U8, b: U8. op_prod_eq(a, b) == prod_eq(a, b)
  claim c_prod_in_ok:
    forall a: U8, b: U8. op_prod_in_ok(a, b) == prod_in_ok(a, b)
  claim c_prod_in_if:
    forall c: Bool, d: Bytes, i: Nat. op_prod_in_if(c, d, i) == prod_in_if(c, d, i)
  claim c_prod_try:
    forall a: Nat. op_prod_try(a) == prod_try(a)
  claim c_mk_point:
    forall a: U8, b: U8. op_mk_point(a, b) == mk_point(a, b)
  claim c_px:
    forall p: Point. op_px(p) == px(p)
  claim c_py:
    forall p: Point. op_py(p) == py(p)
  claim c_mk_wrapped:
    forall a: U8, b: U8, t: Bool. op_mk_wrapped(a, b, t) == mk_wrapped(a, b, t)
  claim c_wrapped_y:
    forall w: Wrapped. op_wrapped_y(w) == wrapped_y(w)
  claim c_mk_blob:
    forall d: Bytes, n: Nat. op_mk_blob(d, n) == mk_blob(d, n)
  claim c_mk_blob_lit:
    forall u: Bool. op_mk_blob_lit(u) == mk_blob_lit(u)
  claim c_blob_len:
    forall b: Blob. op_blob_len(b) == blob_len(b)
  claim c_mk_slot:
    forall o: Option<U8>, a: Bool. op_mk_slot(o, a) == mk_slot(o, a)
  claim c_slot_o:
    forall s: Slot. op_slot_o(s) == slot_o(s)
  claim c_slot_t0:
    forall s: Slot. op_slot_t0(s) == slot_t0(s)
  claim c_rec_eq:
    forall a: Point, b: Point. op_rec_eq(a, b) == rec_eq(a, b)
  claim c_rec_ne:
    forall a: Wrapped, b: Wrapped. op_rec_ne(a, b) == rec_ne(a, b)
  claim c_rec_postfix:
    forall a: U8, b: U8. op_rec_postfix(a, b) == rec_postfix(a, b)
  claim c_rec_lit_field:
    forall a: U8. op_rec_lit_field(a) == rec_lit_field(a)
  claim c_mk_circle:
    forall r: U8. op_mk_circle(r) == mk_circle(r)
  claim c_mk_rect:
    forall w: U8, h: U8. op_mk_rect(w, h) == mk_rect(w, h)
  claim c_mk_dot:
    forall u: Bool. op_mk_dot(u) == mk_dot(u)
  claim c_mk_done:
    forall n: Nat. op_mk_done(n) == mk_done(n)
  claim c_mk_opt_msg:
    forall o: Option<U8>. op_mk_opt_msg(o) == mk_opt_msg(o)
  claim c_mk_opt_some:
    forall a: U8. op_mk_opt_some(a) == mk_opt_some(a)
  claim c_mk_opt_none:
    forall u: Bool. op_mk_opt_none(u) == mk_opt_none(u)
  claim c_mk_short:
    forall u: Bool. op_mk_short(u) == mk_short(u)
  claim c_mk_neg:
    forall u: Bool. op_mk_neg(u) == mk_neg(u)
  claim c_var_eq:
    forall a: Shape, b: Shape. op_var_eq(a, b) == var_eq(a, b)
  claim c_var_ne:
    forall a: Shape, b: Shape. op_var_ne(a, b) == var_ne(a, b)
  claim c_var_eq_lit:
    forall a: Shape. op_var_eq_lit(a) == var_eq_lit(a)
  claim c_m_opt:
    forall o: Option<U8>. op_m_opt(o) == m_opt(o)
  claim c_m_opt_wild:
    forall o: Option<U8>. op_m_opt_wild(o) == m_opt_wild(o)
  claim c_m_opt_wild_arm:
    forall o: Option<U8>. op_m_opt_wild_arm(o) == m_opt_wild_arm(o)
  claim c_m_opt_nested:
    forall o: Option<Option<U8>>. op_m_opt_nested(o) == m_opt_nested(o)
  claim c_m_opt_ret_opt:
    forall o: Option<U8>. op_m_opt_ret_opt(o) == m_opt_ret_opt(o)
  claim c_m_opt_bind_whole:
    forall o: Option<U8>. op_m_opt_bind_whole(o) == m_opt_bind_whole(o)
  claim c_m_opt_on_call:
    forall a: U8. op_m_opt_on_call(a) == m_opt_on_call(a)
  claim c_m_opt_literal:
    forall u: Bool. op_m_opt_literal(u) == m_opt_literal(u)
  claim c_m_opt_tuple:
    forall o: Option<(Bool,Nat)>. op_m_opt_tuple(o) == m_opt_tuple(o)
  claim c_m_bool:
    forall b: Bool. op_m_bool(b) == m_bool(b)
  claim c_m_bool_wild:
    forall b: Bool. op_m_bool_wild(b) == m_bool_wild(b)
  claim c_m_bool_expr:
    forall a: U8. op_m_bool_expr(a) == m_bool_expr(a)
  claim c_m_tuple:
    forall t: (Bool,Bool). op_m_tuple(t) == m_tuple(t)
  claim c_m_tuple_bool:
    forall t: (Bool,Bool). op_m_tuple_bool(t) == m_tuple_bool(t)
  claim c_m_tuple_nested:
    forall t: ((Bool,Bool),Nat). op_m_tuple_nested(t) == m_tuple_nested(t)
  claim c_m_point:
    forall p: Point. op_m_point(p) == m_point(p)
  claim c_m_point_wild:
    forall p: Point. op_m_point_wild(p) == m_point_wild(p)
  claim c_m_wrapped:
    forall w: Wrapped. op_m_wrapped(w) == m_wrapped(w)
  claim c_m_blob:
    forall b: Blob. op_m_blob(b) == m_blob(b)
  claim c_m_slot:
    forall s: Slot. op_m_slot(s) == m_slot(s)
  claim c_m_shape:
    forall s: Shape. op_m_shape(s) == m_shape(s)
  claim c_m_shape_wild:
    forall s: Shape. op_m_shape_wild(s) == m_shape_wild(s)
  claim c_m_mode:
    forall o: Mode. op_m_mode(o) == m_mode(o)
  claim c_m_is_neg:
    forall o: Mode. op_m_is_neg(o) == m_is_neg(o)
  claim c_m_msg:
    forall m: Msg. op_m_msg(m) == m_msg(m)
  claim c_m_msg_bind:
    forall m: Msg. op_m_msg_bind(m) == m_msg_bind(m)
  claim c_m_shape_ret_var:
    forall s: Shape. op_m_shape_ret_var(s) == m_shape_ret_var(s)
  claim c_m_res_bool:
    forall r: Result<Bool,DataError>. op_m_res_bool(r) == m_res_bool(r)
  claim c_m_res_opt:
    forall r: Result<Option<U8>,DataError>. op_m_res_opt(r) == m_res_opt(r)
  claim c_m_res_rec:
    forall r: Result<Point,DataError>. op_m_res_rec(r) == m_res_rec(r)
  claim c_m_res_err_unused:
    forall r: Result<Bool,DataError>. op_m_res_err_unused(r) == m_res_err_unused(r)
  claim c_m_res_plain:
    forall r: Result<Bool,DataError>. op_m_res_plain(r) == m_res_plain(r)
  claim c_m_inner:
    forall o: Option<U8>, b: Bool. op_m_inner(o, b) == m_inner(o, b)
  claim c_some_only:
    forall o: Option<U8> | match o with Some(_) -> true | None -> false. op_some_only(o) == m_opt(o)
  claim c_point_ok:
    forall p: Point | p.x < 100u8. op_point_ok(p) == px(p)

  -- claims: data inline in the pure side, a subject call in an arm and as the scrutinee -------
  claim c_inline_match:
    forall o: Option<U8>. op_m_opt(o) == (match o with Some(x) -> x | None -> 0u8)
  claim c_inline_ctor:
    forall a: U8, b: U8. op_mk_point(a, b) == Point(a, b)
  claim c_inline_field:
    forall p: Point. op_px(p) == p.x
  claim c_arm_calls:
    forall o: Option<U8>. match o with Some(x) -> op_px(Point(x, x)) == x | None -> true
  claim c_scrutinee_calls:
    forall a: U8. match op_some_u8(a) with Some(x) -> x == a | None -> false
  claim c_option_binder_compare:
    forall o: Option<U8>. op_opt_is_none(o) == (o == None)

  -- examples: Option, record and variant values in TFV (not evaluated here) ----------------------
  example e_some:
    op_some_u8(7u8) == Some(7u8)
  example e_none:
    op_none_u8(true) == None
  example e_point:
    op_mk_point(1u8, 2u8) == Point(1u8, 2u8)
  example e_circle:
    op_mk_circle(3u8) == Circle(3u8)
  example e_dot:
    op_mk_dot(true) == Dot
  example e_done:
    op_mk_done(5) == Done(5, b"")
  example e_opt_msg:
    op_mk_opt_some(1u8) == Opt(Some(1u8))
  example e_res_opt:
    op_res_opt(1u8) == Ok(Some(1u8))
  example e_nested:
    op_some_nested(1u8) == Some(Some(1u8))
  example e_wrapped:
    op_mk_wrapped(1u8, 2u8, true) == Wrapped(Point(1u8, 2u8), true)
  example e_field_arg:
    op_px(Point(4u8, 5u8)) == 4u8

