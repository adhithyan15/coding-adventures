{
  "schema_version": 1,
  "suite": "phy01-wave",
  "summary": "PHY01 construction, derived quantities, time evaluation, validation, and binary64 boundaries.",
  "cases": [
    {
      "id": "phy01/construct/ordinary",
      "operation": "construct",
      "summary": "Finite non-negative amplitude, positive frequency, and finite phase are accepted.",
      "input": {
        "wave": {
          "amplitude": {"kind": "finite", "decimal": "3.5"},
          "frequency": {"kind": "finite", "decimal": "2"},
          "phase": {"kind": "finite", "decimal": "1.25"}
        }
      },
      "expected": {
        "outcome": "accepted"
      }
    },
    {
      "id": "phy01/construct/zero-amplitude",
      "operation": "construct",
      "summary": "A zero-amplitude flat wave is accepted.",
      "input": {
        "wave": {
          "amplitude": {"kind": "finite", "decimal": "0"},
          "frequency": {"kind": "finite", "decimal": "1"},
          "phase": {"kind": "finite", "decimal": "0"}
        }
      },
      "expected": {
        "outcome": "accepted"
      }
    },
    {
      "id": "phy01/construct/negative-amplitude",
      "operation": "construct",
      "summary": "Negative amplitude is rejected.",
      "input": {
        "wave": {
          "amplitude": {"kind": "finite", "decimal": "-1"},
          "frequency": {"kind": "finite", "decimal": "1"},
          "phase": {"kind": "finite", "decimal": "0"}
        }
      },
      "expected": {
        "outcome": "error",
        "error_code": "invalid-argument"
      }
    },
    {
      "id": "phy01/construct/nan-amplitude",
      "operation": "construct",
      "summary": "NaN amplitude is rejected.",
      "input": {
        "wave": {
