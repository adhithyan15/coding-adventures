# @version 1
# Mermaid 11.16.1 Gantt core token grammar.
# Upstream: packages/mermaid/src/diagrams/gantt/parser/gantt.jison

case_sensitive: false

skip:
  WHITESPACE          = /[ \t]+/
  COMMENT             = /%%[^\r\n]*/

NEWLINE               = /\r?\n/
HEADER                = /gantt/
ACC_DESCR_BLOCK       = /accDescr[ \t]*\{[^}]*\}/
ACC_TITLE_STATEMENT   = /accTitle[ \t]*:[^#\r\n;]+/
ACC_DESCR_STATEMENT   = /accDescr[ \t]*:[^#\r\n;]+/
TITLE_STATEMENT       = /title[ \t]+(?:[;#][^;\r\n]*|[^#;\r\n][^;\r\n]*)/
DATE_FORMAT_STATEMENT = /dateFormat[ \t]+[^#\r\n;]+/
AXIS_FORMAT_STATEMENT = /axisFormat[ \t]+[^#\r\n;]+/
TICK_INTERVAL_STATEMENT = /tickInterval[ \t]+[^#\r\n;]+/
INCLUDES_STATEMENT    = /includes[ \t]+[^#\r\n;]+/
EXCLUDES_STATEMENT    = /excludes[ \t]+[^#\r\n;]+/
INCLUSIVE_END_DATES   = /inclusiveEndDates/
TOP_AXIS              = /topAxis/
TODAY_MARKER_STATEMENT = /todayMarker[ \t]+[^#\r\n;]+/
WEEKDAY_STATEMENT     = /weekday[ \t]+(?:monday|tuesday|wednesday|thursday|friday|saturday|sunday)/
WEEKEND_STATEMENT     = /weekend[ \t]+(?:friday|saturday)/
SECTION_STATEMENT     = /section[ \t]+(?:[;#][^;\r\n]*|[^#;\r\n][^;\r\n]*)/
CLICK_STATEMENT       = /click[ \t]+[^#\r\n;]+/
TASK_STATEMENT        = /(?:[;#][^:\r\n;]+|[^#:\r\n;][^:\r\n;]*):[^#\r\n;]+/
SEMICOLON             = ";"
