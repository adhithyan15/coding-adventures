{
  "schema_version": 1,
  "_comment": "Declarative CI gate registry. See code/specs/ci-gate-registry.md. Every gate needs BOTH a package list and a path list: changes under code/specs, code/fixtures, code/grammars and code/scripts map to ZERO packages (sharedPrefixes in build-tool main.go is empty), so a package-only gate would skip the very staleness check the job exists to perform. scope=job entries must match a job key in .github/workflows/ci.yml; scope=step entries gate a step inside a job.",
  "gates": {
    "phy00-phy01-fixture-consumers": {
      "scope": "job",
      "description": "PHY00/PHY01 generated fixtures and their two Dart consumers.",
      "packages": [
        "dart/trig",
        "dart/wave"
      ],
      "paths": [
        "code/specs/fixtures/phy00-phy01-v1/**",
        "code/scripts/generate_phy00_phy01_dart_fixtures.py",
        "code/scripts/tests/test_phy00_phy01_fixtures.py"
      ]
    },

    "d18f-message-conformance": {
      "scope": "job",
      "description": "Six-language D18F chief-of-staff message manifest conformance and regeneration.",
      "packages": [
        "rust/chief-of-staff-channel-crypto",
        "python/chief-of-staff-channel-crypto",
        "typescript/chief-of-staff-channel-crypto",
        "go/chief-of-staff-channel-crypto",
        "ruby/chief-of-staff-channel-crypto",
        "elixir/chief-of-staff-channel-crypto"
      ],
      "paths": [
        "code/fixtures/chief-of-staff-message/**",
        "code/scripts/validate_d18f_message_conformance.py",
        "code/scripts/tests/test_d18f_message_conformance.py",
        "code/packages/rust/Cargo.toml",
        "code/packages/rust/Cargo.lock"
      ]
    },

