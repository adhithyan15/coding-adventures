        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: കാണിക്കൂ",
          "segments": [
            {
              "kind": "speech",
              "text": "കാണിക്കൂ (kāṇikkū) — \"please show (me)\", from കാണുക (kāṇuka), \"to see\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "കാണിക്കൂ (kāṇikkū) is native Dravidian, the causative of kāṇuka, \"to see\": \"make see\"; DEDR 1443 lists the root with Tamil kāṇ and Kannada kāṇ."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "To see, turned into to show."
