        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: tóuyūn",
          "segments": [
            {
              "kind": "speech",
              "text": "tóuyūn — \"dizzy\"."
            },
            {
              "kind": "speech",
              "text": "wǒ gǎnjué yǒudiǎnr tóuyūn — I feel a bit dizzy."
            },
            {
              "kind": "speech",
              "text": "Its characters come later; for now it is a word for the ear."
