# Perl 5.004_70 (1998-07-06) plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: unsupported Perl 5.004_70 syntax is rejected by this grammar.
# Evidence: https://mirrors.develooper.com/perl/historical-perl/perl-5.004_70.tar.gz
# Archive SHA-256: 427fe9a0d1659cfcc3bbaac9a510abd6f640223c513e11dbdc359cabb9179e3e
# perly.y, keywords.h, and complete scan_num are byte-identical to 5.004_69.
# Other tokenizer changes affect keyword overrides, our, hooks, and regex t.
# Standalone subset: no pragmas, BEGIN, imports, hint mutation, or overrides.
# Retain the source-backed 250-digit bound (tokenbuf256, six reserved).
# CR, unsupported characters, and leading-zero forms remain refused.
# No platform-wide rejection parity is claimed.

PRINT     = "print"
INT       = /0|[1-9][0-9]{0,249}/
PLUS      = "+"
DECREMENT = "--"
MINUS     = "-"
STAR      = "*"
LPAREN    = "("
RPAREN    = ")"
SEMICOLON = ";"

skip:
  WHITESPACE = /[ \t\n]+/
