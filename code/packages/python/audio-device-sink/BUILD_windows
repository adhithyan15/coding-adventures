# Each line runs as its own `cmd /C`, so the Unix BUILD's sh staging one-liners
# cannot run here. scripts/check_staged_extension.py stages the extension in a
# throwaway package directory, runs ruff and pytest against it, and cleans up,
# all in one Python process.
uv venv --quiet --clear
uv pip install pytest pytest-cov ruff --quiet
uv pip install --no-deps -e ../trig --quiet
uv pip install --no-deps -e ../oscillator --quiet
uv pip install --no-deps -e ../pcm-audio --quiet
cargo build --release
.venv\Scripts\python scripts\check_staged_extension.py
