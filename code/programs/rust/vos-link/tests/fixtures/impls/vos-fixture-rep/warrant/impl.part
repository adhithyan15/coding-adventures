  -- A representation fixture (VOS-D061, VOS02 section 2.7): a one-byte ready mask plus a
  -- round-robin pointer `ptr` that `alpha` forgets.  The operations are bound (no bodies, R3);
  -- the models `rep`, `rr_pick` and `rr_next` are op-free, so a claim can say what the state
  -- and the history do without calling the implementation.
  record Impl(mask: U8, ptr: U8)
  record AbsW(w: U8)
  record CfgN(v: U8)
  model dec(x: AbsW) -> Ready = (
    Ready(not (bit_and(x.w, 1u8) == 0u8), not (bit_and(x.w, 2u8) == 0u8), not (bit_and(x.w, 4u8) == 0u8),
          not (bit_and(x.w, 8u8) == 0u8), not (bit_and(x.w, 16u8) == 0u8), not (bit_and(x.w, 32u8) == 0u8),
          not (bit_and(x.w, 64u8) == 0u8), not (bit_and(x.w, 128u8) == 0u8)))
  op init() -> Impl
  op insert_out(s: Impl, t: U8) -> Upd
  op insert_img(s: Impl, t: U8) -> Impl
  op remove_out(s: Impl, t: U8) -> Upd
  op remove_img(s: Impl, t: U8) -> Impl
  op dispatch_out(s: Impl) -> Pick
  op dispatch_img(s: Impl) -> Impl
  op alpha_w(s: Impl) -> AbsW
  op cfg_n() -> CfgN

  model b2m(b: Bool, k: Nat) -> U8 = if b then shl(1u8, k) else 0u8
  -- build sets the pointer to a constant: the pointer is OUTSIDE the cone of build and alpha.
  model build(m: Ready) -> Impl = (
    Impl(bit_or(bit_or(bit_or(bit_or(bit_or(bit_or(bit_or(b2m(m.p0, 0), b2m(m.p1, 1)), b2m(m.p2, 2)), b2m(m.p3, 3)),
           b2m(m.p4, 4)), b2m(m.p5, 5)), b2m(m.p6, 6)), b2m(m.p7, 7)), 0u8))
  model inv_impl(s: Impl) -> Bool = s.ptr < 8u8

  -- The two models the representation tier names (VOS02 2.7): the state an abstract state and a
  -- history code name (the pointer is the code), and the code of a state.  The contract owns the
  -- packing of the code; this crate only says what the code is.
  model rep(m: Ready, h: U8) -> Impl = Impl(build(m).mask, h)
  model hist(s: Impl) -> U8 = s.ptr

  -- The op-free round-robin model: scan from the pointer, wrapping at 8.
  model has_bit(mask: U8, i: U8) -> Bool = not (bit_and(mask, shl(1u8, to_nat(bit_and(i, 7u8)))) == 0u8)
  model rr_pick(mask: U8, p: U8) -> Pick = (
    if has_bit(mask, p) then Run(bit_and(p, 7u8)) else
    (if has_bit(mask, p + 1u8) then Run(bit_and(p + 1u8, 7u8)) else
    (if has_bit(mask, p + 2u8) then Run(bit_and(p + 2u8, 7u8)) else
    (if has_bit(mask, p + 3u8) then Run(bit_and(p + 3u8, 7u8)) else
    (if has_bit(mask, p + 4u8) then Run(bit_and(p + 4u8, 7u8)) else
    (if has_bit(mask, p + 5u8) then Run(bit_and(p + 5u8, 7u8)) else
    (if has_bit(mask, p + 6u8) then Run(bit_and(p + 6u8, 7u8)) else
    (if has_bit(mask, p + 7u8) then Run(bit_and(p + 7u8, 7u8)) else Idle))))))))
  model rr_next(mask: U8, p: U8) -> Impl = (
    match rr_pick(mask, p) with
      Idle -> Impl(mask, p)
    | Run(t) -> Impl(bit_and(mask, bit_not(shl(1u8, to_nat(t)))), bit_and(t + 1u8, 7u8)))

  -- An OPTIONAL, ungated impl-own claim (VOS02 2.7): the full post-state of dispatch against the
  -- op-free model.  The representation tier does not require it; a round-robin keeps it so that a
  -- dispatch that stops rotating (and stays inside the image) is still caught by evidence.
  claim dispatch_det:
    forall mask: U8, p: U8 | p < 8u8. (
      dispatch_out(Impl(mask, p)) == rr_pick(mask, p) and
      dispatch_img(Impl(mask, p)) == rr_next(mask, p))

  -- The secrecy labels, hostile inputs and step bounds the Warrant checker requires of every
  -- operation (copied in shape from vos-sched-fp-bitmap; check-doc only type-checks them).
  labels insert_out:
    s public
    t public
  labels insert_img:
    s public
    t public
  labels remove_out:
    s public
    t public
  labels remove_img:
    s public
    t public
  labels dispatch_out:
    s public
  labels dispatch_img:
    s public
  labels alpha_w:
    s public

  input insert_out.s:
    hostile
    ensures no_panic, terminates
  input insert_out.t:
    hostile
    ensures no_panic, terminates
  input insert_img.s:
    hostile
    ensures no_panic, terminates
  input insert_img.t:
    hostile
    ensures no_panic, terminates
  input remove_out.s:
    hostile
    ensures no_panic, terminates
  input remove_out.t:
    hostile
    ensures no_panic, terminates
  input remove_img.s:
    hostile
    ensures no_panic, terminates
  input remove_img.t:
    hostile
    ensures no_panic, terminates
  input dispatch_out.s:
    hostile
    ensures no_panic, terminates
  input dispatch_img.s:
    hostile
    ensures no_panic, terminates
  input alpha_w.s:
    hostile
    ensures no_panic, terminates

  -- Bounds: the contract ceilings.
  bound init:
    steps <= 80
  bound insert_out:
    steps <= 160
    heap <= 0
  bound insert_img:
    steps <= 160
  bound remove_out:
    steps <= 160
    heap <= 0
  bound remove_img:
    steps <= 160
  bound dispatch_out:
    steps <= 160
  bound dispatch_img:
    steps <= 160
  bound alpha_w:
    steps <= 160
