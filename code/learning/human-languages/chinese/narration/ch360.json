    {
      "id": "ZH-W360-bi-must",
      "sequence": 27735,
      "title": "必 (bì) — the strokes of the heart, with a sweep through them",
      "headword": "必",
      "romanization": "bì",
      "gloss": "必 — a dot, the curve of 心, a dot, a long sweep and a dot",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:149b7694cae27a27",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — the strokes of the heart, with a sweep through them",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — the strokes of the heart, with a sweep through them and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say bìyào — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *bìyào* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "心 要."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — xīn, yào",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *xīn*, *yào*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — the strokes of the heart, with a sweep through them",
          "segments": [
            {
              "kind": "speech",
              "text": "必 (bì)."
            },
            {
              "kind": "speech",
              "text": "One piece, five strokes. It looks like 心 crossed by a long sweep; the order is its own."
            },
            {
              "kind": "speech",
              "text": "A dot on the left, falling down to the left."
            },
            {
              "kind": "speech",
              "text": "The long curve along the foot, sweeping right and hooking up, as in 心."
            },
            {
              "kind": "speech",
              "text": "A dot on top, falling to the right."
            },
            {
              "kind": "speech",
              "text": "A long left-falling stroke from the top right down through the curve to the bottom left. Only then:"
            },
            {
              "kind": "speech",
              "text": "the dot on the right, last."
            },
            {
              "kind": "speech",
              "text": "Five strokes, and the sweep comes before the last dot."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "必 (bì), all five, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 必, all five, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many strokes in 必 (bì)? (Five.) Which character you know has the same curve? (心.) What comes right before the last dot? (The long left-falling stroke.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 必 (bì), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
