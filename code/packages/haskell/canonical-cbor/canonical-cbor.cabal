cabal-version: 3.0
name:          canonical-cbor
version:       0.1.0
synopsis:      RFC 8949 deterministic canonical CBOR (CBR01 profile)
description:   Pure deterministic canonical CBOR codec implementing length-first map key ordering and 7-class CVE resilience.
category:      Codec, Data
license:       MIT
author:        Adhithya Rajasekaran
maintainer:    Adhithya Rajasekaran
build-type:    Simple
extra-doc-files:
    README.md
    CHANGELOG.md

library
    exposed-modules:  CodingAdventures.CanonicalCbor
                    , CodingAdventures.CanonicalCbor.Codec
                    , CodingAdventures.CanonicalCbor.Constants
                    , CodingAdventures.CanonicalCbor.Messages
                    , CodingAdventures.CanonicalCbor.Types
    build-depends:    base >=4.14 && <5
                    , bytestring >=0.11 && <0.13
                    , containers >=0.6 && <0.9
                    , text >=1.2 && <2.2
    hs-source-dirs:   src
    ghc-options:      -Wall -Werror
    default-language: Haskell2010

test-suite spec
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    other-modules:    CorpusSpec
                    , CanonicalCborSpec
                    , SimpleJson
    hs-source-dirs:   test
    build-depends:    base >=4.14 && <5
                    , canonical-cbor
                    , bytestring >=0.11 && <0.13
                    , containers >=0.6 && <0.9
                    , directory >=1.3 && <1.4
                    , filepath >=1.4 && <1.6
                    , text >=1.2 && <2.2
    ghc-options:      -Wall -Werror
    default-language: Haskell2010
