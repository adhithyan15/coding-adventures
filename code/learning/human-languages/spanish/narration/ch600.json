          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "colectivo is a learned borrowing from Latin collectivus 'gathered together', built on colligere, from legere 'to gather' (Lewis & Short)."
            }
          ]
        },
