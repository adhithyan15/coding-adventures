              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *no está permitido hacer fotografías en la sala*]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Say it is not permitted to take photographs. (No está permitido hacer fotografías.)"
            },
            {
              "kind": "speech",
              "text": "Source: DLE: permitir."
