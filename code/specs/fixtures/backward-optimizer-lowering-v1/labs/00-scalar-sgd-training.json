          "source_instructions": []
        },
        {
          "id": "b4",
          "op": "ACCUMULATE_GRAD",
          "output": "grad_w",
          "inputs": ["grad_w", "local_d_w"],
          "attributes": { "parameter_id": "w", "order": "row_ascending" },
