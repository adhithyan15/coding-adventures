      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "You learned ver before its past: veo, ves, ve. Its imperfect keeps ve- and adds the familiar -ía row. That gives veía — “I was seeing” or “I used to see.”"
            }
          ]
        },
        {
          "index": 1,
          "type": "grammar",
          "title": "Grammar Lens: the singular ver row",
          "segments": [
            {
              "kind": "table",
              "headers": [
                "person",
                "open or habitual past"
              ],
              "columns": 2,
              "rowCount": 3,
              "utterances": [
                "person: yo. open or habitual past: veía.",
                "person: tú. open or habitual past: veías.",
                "person: él / ella / usted. open or habitual past: veía."
              ]
            },
            {
              "kind": "speech",
              "text": "Say veía, veías, veía. Keep í-a in separate syllables. Plural persons wait."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The extra e, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Old Spanish veer displays the ve- shape clearly. The imperfect veía preserves that vowel before the familiar -ía material. It is useful to call this an exceptional learned row, but not to pretend that ver was already known before this chapter or that the history is merely “regular plus one letter.”"
            }
          ]
        },
