              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "speech",
              "text": "Ask \"What time is it?\" (Kam as-sāʿa? — sāʿa is both \"hour\" and \"clock.\")"
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: إبريق",
          "segments": [
            {
              "kind": "speech",
              "text": "إبريق — ibrīq — \"a jug, a teapot\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "إبريق (ibrīq) is usually traced to Persian ābrīz, \"water-pourer\"; it has no Arabic root."
            }
          ]
        },
