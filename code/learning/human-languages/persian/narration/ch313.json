        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: آمار",
          "segments": [
            {
              "kind": "speech",
              "text": "آمار (âmâr) — \"statistics, figures\"."
            },
            {
              "kind": "speech",
              "text": "آمار (âmâr) تصادف ها امسال بالا بود. Âmâr-e tasâdof-hâ emsâl bâlâ bud. The accident figures were high this year."
            },
            {
              "kind": "speech",
              "text": "Singular in form: âmâr neshân midahad \"the statistics show\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "âmâr is a native Persian word; EtymDB glosses it \"numeration, calculation\" and gives no parent, so its deeper origin is not settled."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
