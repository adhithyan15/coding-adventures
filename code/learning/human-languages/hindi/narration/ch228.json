        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: उगना",
          "segments": [
            {
              "kind": "speech",
              "text": "उगना — ugnā — \"to grow, to sprout\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "उगना (ugnā) is a tadbhava, a word inherited and reshaped by sound change. It comes from udgāti, \"rises, comes forth\", a form CDIAL reconstructs from its descendants (CDIAL 1954)."
            }
          ]
        },
