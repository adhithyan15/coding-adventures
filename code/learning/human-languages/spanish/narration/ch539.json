        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: el semestre",
          "segments": [
            {
              "kind": "speech",
              "text": "el semestre — \"the semester, the half-year\"."
            },
            {
              "kind": "speech",
              "text": "El primer semestre del año fue muy difícil. The first half of the year was very hard."
            },
            {
              "kind": "speech",
              "text": "At university it is a term of six months."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "semestre comes from Latin sēmestris 'of six months' (EtymDB), built on sex 'six' and mēnsis 'month'."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
