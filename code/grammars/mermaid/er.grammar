# @version 1
#
# Mermaid 11.16.1 entity-relationship parser grammar.

document = { NEWLINE } HEADER { NEWLINE | statement } EOF ;
statement = relationship | entity_decl | direction_stmt | title_stmt | accessibility_stmt | classdef_stmt | class_stmt | style_stmt ;

relationship = entity_name [ class_suffix ] cardinality relation_type cardinality entity_name [ class_suffix ] COLON role ;
entity_decl = entity_name [ alias ] [ class_suffix ] [ attribute_block ] ;
alias = LBRACKET entity_name RBRACKET ;
class_suffix = STYLE_SEPARATOR id_list ;

attribute_block = LBRACE { NEWLINE } { attribute { NEWLINE } } RBRACE ;
attribute = attribute_type attribute_name [ key_list ] [ STRING ] ;
attribute_type = attribute_atom [ LBRACKET RBRACKET ] [ QUESTION ] ;
attribute_name = attribute_atom ;
attribute_atom = entity_name | TITLE_KW | ESCAPED_ATTRIBUTE | COMMA_ATTRIBUTE_TYPE ;
key_list = ATTRIBUTE_KEY { COMMA ATTRIBUTE_KEY } ;

cardinality = ZERO_OR_ONE | ZERO_OR_MORE | ONE_OR_MORE | ONLY_ONE | MD_PARENT ;
relation_type = NON_IDENTIFYING | IDENTIFYING ;
role = STRING | entity_name { entity_name } ;
entity_name = IDENTIFIER | NUMBER | ATTRIBUTE_KEY | MD_PARENT | STRING ;

direction_stmt = DIRECTION_KW DIRECTION ;
title_stmt = TITLE_KW role ;
accessibility_stmt = ACC_TITLE | ACC_DESCR | ACC_DESCR_BLOCK ;
classdef_stmt = CLASSDEF_KW id_list style_declaration { COMMA style_declaration } ;
class_stmt = CLASS_KW id_list id_list ;
style_stmt = STYLE_KW id_list style_declaration { COMMA style_declaration } ;
id_list = entity_name { COMMA entity_name } ;
style_declaration = entity_name COLON style_value { style_value } ;
style_value = entity_name | NUMBER | STYLE_VALUE ;
