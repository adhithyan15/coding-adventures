          "segments": [
            {
              "kind": "speech",
              "text": "conséquent is a learned borrowing from Latin cōnsequēns \"following, consistent\" (EtymDB), the participle of cōnsequī \"to follow after\", built on sequī \"to follow\" (Lewis & Short)."
            }
          ]
        },
