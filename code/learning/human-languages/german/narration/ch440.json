          "segments": [
            {
              "kind": "speech",
              "text": "die Parkbank — \"the park bench\"."
            },
            {
              "kind": "speech",
              "text": "Ein alter Mann füttert auf der Parkbank die Tauben. An old man feeds the pigeons on the park bench."
            },
            {
              "kind": "speech",
              "text": "Plural: die Parkbänke. Die Bank is a bench (plural Bänke) or a bank (plural Banken)."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Parkbank is built from Park, which EtymDB traces to Old French parc 'enclosure, pen', and Bank 'bench', inherited from Old High German bank (EtymDB). The money Bank came back into German from Italian banca, a money-changer's counter."
            }
          ]
        },
