          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Reihenfolge joins Reihe \"row\", from Middle High German rīhe \"row, line\", and Folge \"what follows\", from Middle High German volge (EtymDB). Both are inherited Germanic words."
            }
          ]
        },
