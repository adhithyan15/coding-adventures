              "source": "[YOU WRITE: copy **ਕੱਲ੍ਹ** once from the model]"
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What does ਕੱਲ੍ਹ (kallh) mean? (\"Yesterday; tomorrow\".) Which one, with ਗਿਆ? (Yesterday.)"
            }
          ]
