              "responseSeconds": 8,
              "source": "[YOU SAY: *surakṣit*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "surakṣit, once more",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *surakṣit*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "say surakṣit",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: say *surakṣit*]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say the Marathi for foolish, then the Marathi for famous, then say surakṣit again",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say the Marathi for foolish, then the Marathi for famous, then say *surakṣit* again]"
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
