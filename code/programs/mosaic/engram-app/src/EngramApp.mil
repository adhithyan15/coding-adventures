// EngramApp.mil - Engram's Mosaic app/root surface.
//
// Engram is an app, so it owns the product-level interface here. Reusable UI
// building blocks live in component packages and are referenced from the app
// layout instead of being named after the product.

component EngramApp {
  slot app-title : text ;
  slot deck-name : text ;
  slot deck-stats-label : text ;
  slot deck-total-label : text ;
  slot deck-total-value : text ;
  slot deck-new-label : text ;
  slot deck-new-value : text ;
  slot deck-due-label : text ;
  slot deck-due-value : text ;
  slot deck-learning-label : text ;
  slot deck-learning-value : text ;
  slot deck-hidden-label : text ;
  slot deck-hidden-value : text ;
  slot deck-options-settings-label : text ;
  slot deck-options-new-cards-label : text ;
  slot deck-options-new-cards-value : number ;
  slot deck-options-reviews-label : text ;
  slot deck-options-reviews-value : number ;
  slot deck-options-graduating-interval-label : text ;
  slot deck-options-graduating-interval-value : number ;
  slot deck-options-easy-interval-label : text ;
  slot deck-options-easy-interval-value : number ;
  slot deck-options-maximum-interval-label : text ;
  slot deck-options-maximum-interval-value : number ;
  slot deck-options-interval-modifier-label : text ;
  slot deck-options-interval-modifier-value : number ;
  slot deck-options-hard-multiplier-label : text ;
  slot deck-options-hard-multiplier-value : number ;
  slot deck-options-easy-bonus-label : text ;
  slot deck-options-easy-bonus-value : number ;
  slot deck-options-lapse-multiplier-label : text ;
  slot deck-options-lapse-multiplier-value : number ;
  slot collection-label : text ;
  slot collection-note-count-label : text ;
  slot collection-note-count-value : text ;
  slot collection-note-type-count-label : text ;
  slot collection-note-type-count-value : text ;
  slot collection-media-count-label : text ;
  slot collection-media-count-value : text ;
  slot collection-import-label : text ;
  slot collection-export-label : text ;
  slot collection-add-note-label : text ;
  slot collection-add-note-type-label : text ;
  slot collection-delete-note-label : text ;
  slot collection-delete-note-type-label : text ;
  slot browser-label : text ;
  slot browser-query-label : text ;
  slot browser-query : text ;
  slot browser-query-placeholder : text ;
  slot browser-search-label : text ;
  slot browser-results-label : text ;
  slot browser-results-summary : text ;
  slot browser-results : list<text> ;
  slot browser-result-card-ids : list<text> ;
  slot browser-result-note-ids : list<text> ;
  slot browser-result-template-ids : list<text> ;
  slot browser-result-states : list<text> ;
  slot browser-selected-index : number ;
  slot browser-selected-card-id : text ;
  slot browser-selected-note-id : text ;
  slot browser-selected-template-id : text ;
  slot browser-selected-state : text ;
  slot browser-open-label : text ;
  slot browser-edit-label : text ;
  slot browser-suspend-label : text ;
  slot browser-mark-label : text ;
  slot prompt-label : text ;
  slot prompt : text ;
  slot answer-label : text ;
  slot answer : text ;
  slot answer-visible : bool ;
  slot progress-label : text ;
  slot current-label : text ;
  slot current-value : text ;
  slot remaining-label : text ;
  slot remaining-value : text ;
  slot correct-label : text ;
  slot correct-value : text ;
  slot total-label : text ;
  slot total-value : text ;
  slot action-undo-label : text ;
  slot action-bury-card-label : text ;
  slot action-bury-siblings-label : text ;
  slot action-suspend-card-label : text ;
  slot action-mark-label : text ;

  emit onReveal ;
  emit onAgain ;
  emit onHard ;
  emit onGood ;
  emit onEasy ;
  emit onUndo ;
  emit onBuryCard ;
  emit onBurySiblings ;
  emit onSuspendCard ;
  emit onToggleMark ;
  emit onImportAnki ;
  emit onExportAnki ;
  emit onAddNote ;
  emit onAddNoteType ;
  emit onDeleteNote ;
  emit onDeleteNoteType ;
  emit onDeckOptionsNewCardsChange ( value : number ) ;
  emit onDeckOptionsReviewsChange ( value : number ) ;
  emit onDeckOptionsGraduatingIntervalChange ( value : number ) ;
  emit onDeckOptionsEasyIntervalChange ( value : number ) ;
  emit onDeckOptionsMaximumIntervalChange ( value : number ) ;
  emit onDeckOptionsIntervalModifierChange ( value : number ) ;
  emit onDeckOptionsHardMultiplierChange ( value : number ) ;
  emit onDeckOptionsEasyBonusChange ( value : number ) ;
  emit onDeckOptionsLapseMultiplierChange ( value : number ) ;
  emit onBrowserQueryChange ( value : text ) ;
  emit onBrowserSearch ;
  emit onBrowserSelectResult ( index : number ) ;
  emit onBrowserOpenSelected ;
  emit onBrowserEditSelected ;
  emit onBrowserToggleSuspendSelected ;
  emit onBrowserToggleMarkSelected ;
}
