        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: deprimido",
          "segments": [
            {
              "kind": "speech",
              "text": "deprimido — \"depressed, low\"."
            },
            {
              "kind": "speech",
              "text": "Desde que perdió el trabajo está deprimido. Since he lost his job he has been depressed."
            },
            {
              "kind": "speech",
              "text": "Used with estar. For the illness, say tener depresión."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "deprimido is the participle of deprimir, which comes from Latin dēprimere \"to press down\" (EtymDB), a learned word built on premere \"to press\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
