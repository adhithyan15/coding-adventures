          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "kilometr was borrowed from French kilomètre (EtymDB), which was built from Greek khílioi 'a thousand' and métron 'measure'."
            }
          ]
        },
