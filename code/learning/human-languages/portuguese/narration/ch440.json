        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: a morada",
          "segments": [
            {
              "kind": "speech",
              "text": "a morada — \"the address (where someone lives)\"."
            },
            {
              "kind": "speech",
              "text": "Escrevi a morada no envelope. I wrote the address on the envelope."
            },
            {
              "kind": "speech",
              "text": "In Brazil: o endereço, which Portugal uses for e-mail: o endereço eletrónico."
            }
          ]
        },
