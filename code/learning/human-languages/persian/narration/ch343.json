          "segments": [
            {
              "kind": "speech",
              "text": "باختن (bâkhtan) — \"to lose (a game)\"."
            },
            {
              "kind": "speech",
              "text": "تیم ما دو بر یک باخت. Tim-e mâ do bar yek bâkht. Our team lost two to one."
            },
            {
              "kind": "speech",
              "text": "Present stem bâz-: mibâzad. For losing a thing Persian says gom kardan."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "bâkhtan is a native Persian verb with the present stem bâz-, the same shape as in bâzi \"game\"; EtymDB lists no entry."
            }
          ]
        },
