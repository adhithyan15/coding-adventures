          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ગણિત (gaṇit) is Sanskrit gaṇita, \"counted, reckoned\", taken over whole as a learned loan, a tatsama (CDIAL 3996). The taught verb gaṇvũ, \"to count\", is built on the same root."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for everyday life at A2."
