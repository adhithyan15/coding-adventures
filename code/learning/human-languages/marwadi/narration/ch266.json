          "segments": [
            {
              "kind": "speech",
              "text": "हाजर — hājar — \"present; at your service\"."
            },
            {
              "kind": "speech",
              "text": "हूं हाजर हूं सा। hū̃ hājar hū̃ sā. I'm here, at your service."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "हाजर (hājar) is usually traced, through Persian hāzir, to Arabic ḥāḍir, \"present\". With सा it tells a host or an elder that you are here and ready to help."
            }
          ]
        },
        {
