      "id": "KA-C154-yaru",
      "sequence": 6790,
      "title": "ಯಾರೂ (yārū) — nobody (with a negative verb)",
      "headword": "ಯಾರೂ",
      "romanization": "yārū",
      "gloss": "nobody (with a negative verb)",
      "script": "kannada",
