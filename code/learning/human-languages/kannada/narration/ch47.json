    {
      "id": "KA-C47-hair",
      "sequence": 1210,
      "title": "ಕೂದಲು (kūdalu) — hair",
      "headword": "ಕೂದಲು",
      "romanization": "kūdalu",
      "gloss": "hair",
      "script": "kannada",
      "modality": "voice",
