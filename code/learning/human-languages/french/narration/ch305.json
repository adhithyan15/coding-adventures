        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: le naufrage",
          "segments": [
            {
              "kind": "speech",
              "text": "le naufrage — \"the shipwreck\"."
            },
            {
              "kind": "speech",
              "text": "Le naufrage a eu lieu près de la côte. The shipwreck happened near the coast."
            },
            {
              "kind": "speech",
              "text": "Faire naufrage — to be shipwrecked."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "naufrage is a learned borrowing from Latin naufragium \"a shipwreck\" (EtymDB), from nāvis \"ship\" and frangere \"to break\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
