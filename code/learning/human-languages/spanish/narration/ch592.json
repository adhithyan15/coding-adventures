        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: el empresario",
          "segments": [
            {
              "kind": "speech",
              "text": "el empresario — \"the businessman, the employer\"."
            },
            {
              "kind": "speech",
              "text": "Su padre es empresario. His father is a businessman."
            },
            {
              "kind": "speech",
              "text": "A woman is la empresaria. Los empresarios can mean employers as a group."
            }
          ]
        },
