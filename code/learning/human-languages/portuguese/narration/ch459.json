        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: o rochedo",
          "segments": [
            {
              "kind": "speech",
              "text": "o rochedo — \"the big rock, the crag\"."
            },
            {
              "kind": "speech",
              "text": "Sentámo-nos num rochedo a ver o mar. We sat on a big rock watching the sea."
            },
            {
              "kind": "speech",
              "text": "Built on a rocha."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "rochedo is built on rocha 'rock' with -edo, a group of things. Rocha came from French roche (EtymDB), whose earlier origin is not settled."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
