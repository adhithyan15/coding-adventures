        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: die Halbzeit",
          "segments": [
            {
              "kind": "speech",
              "text": "die Halbzeit — \"half-time; half\"."
            },
            {
              "kind": "speech",
              "text": "In der Halbzeit trinken die Spieler Wasser. At half-time the players drink water."
            },
            {
              "kind": "speech",
              "text": "Plural: die Halbzeiten. Die erste Halbzeit — the first half."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Halbzeit is built on halb \"half\", from Proto-Germanic halbaz, and Zeit \"time\", inherited from Old High German zīt, from Proto-Germanic tīdiz (EtymDB)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
            }
          ]
        },
