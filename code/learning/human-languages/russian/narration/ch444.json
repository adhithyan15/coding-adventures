        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ратуша",
          "segments": [
            {
              "kind": "speech",
              "text": "ратуша (rátusha) — \"a town hall (in an old town)\"."
            },
            {
              "kind": "speech",
              "text": "На площади стоит старая ратуша. Na plóshchadi stoít stáraya rátusha. The old town hall stands on the square."
            },
            {
              "kind": "speech",
              "text": "Feminine. Said of old town halls in central Europe and the Baltic."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ратуша (rátusha) came through Old East Slavic ratuša from Polish ratusz (EtymDB), a cousin of German Rathaus 'a council house'."
            }
          ]
        },
        {
          "index": 3,
