            },
            {
              "kind": "speech",
              "text": "Before the new one: say the French for marble, then the French for sculptor."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: l'exposition",
          "segments": [
            {
              "kind": "speech",
              "text": "l'exposition — \"exhibition\"."
            },
            {
              "kind": "speech",
              "text": "Nous avons vu une exposition de photos. We saw an exhibition of photos."
            },
            {
              "kind": "speech",
              "text": "Feminine. Informally une expo."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "l'exposition is a learned borrowing from Latin expositiō \"a setting out\" (EtymDB), from expōnere \"to put out\", built on pōnere \"to put\" (Lewis & Short)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
            }
          ]
        },
