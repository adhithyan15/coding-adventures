        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: la musculation",
          "segments": [
            {
              "kind": "speech",
              "text": "la musculation — \"weight training, bodybuilding\"."
            },
            {
              "kind": "speech",
              "text": "Je fais de la musculation deux fois par semaine. I do weight training twice a week."
            },
            {
              "kind": "speech",
              "text": "Informally la muscu."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "la musculation is built on muscle, a learned borrowing from Latin musculus \"a little mouse, a muscle\", from mūs \"mouse\" (Lewis & Short): a moving muscle looked like a mouse under the skin."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
