        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: вакансия",
          "segments": [
            {
              "kind": "speech",
              "text": "вакансия (vakánsiya) — \"a vacancy, a job opening\"."
            },
            {
              "kind": "speech",
              "text": "В этой компании есть вакансия бухгалтера. V étoy kompánii yest vakánsiya bukhgáltera. This company has a vacancy for an accountant."
            },
            {
              "kind": "speech",
              "text": "Feminine. Открытая вакансия (vakánsiya) — an open position."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "вакансия (vakánsiya) was borrowed from French vacance, from Latin vacantia \"emptiness, vacancy\" (EtymDB), built on vacāre \"to be empty\" (Lewis & Short). A vacancy is an empty place."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
