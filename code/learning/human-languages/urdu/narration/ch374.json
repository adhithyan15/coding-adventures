          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "سہارا (sahārā) is inherited: CDIAL lists the Hindi cousin sahārā, \"help\", under Sanskrit sahakāra, \"assistance\" (CDIAL 13299)."
            }
          ]
        },
