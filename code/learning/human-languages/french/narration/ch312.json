        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: le déménagement",
          "segments": [
            {
              "kind": "speech",
              "text": "le déménagement — \"the move, the house move\"."
            },
            {
              "kind": "speech",
              "text": "Le déménagement a pris toute la journée. The move took the whole day."
            },
            {
              "kind": "speech",
              "text": "The verb is déménager."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "déménagement is built on ménage \"household\", which goes back to Vulgar Latin mansiōnāticum, built on Latin mānsiō \"a dwelling\", from manēre \"to stay\" (Lewis & Short)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
