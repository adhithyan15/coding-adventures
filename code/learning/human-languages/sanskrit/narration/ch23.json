            },
            {
              "kind": "speech",
              "text": "Before the new one: what did dahati mean?"
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: पिता",
          "segments": [
            {
              "kind": "speech",
              "text": "पिता (pitā) — \"father\"."
            },
            {
              "kind": "speech",
              "text": "The stem behind it is पितृ (pitṛ-), and its family reaches further than that of any word you have met: Latin pater, Greek patēr, Gothic fadar, Old Irish athir, English father. The people lesson laid out four noun endings; this is a fifth family, the -ṛ stems, and most of Sanskrit's kinship words live in it."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "The first of the four oldest words in the family. Three follow, and each reuses the ones before."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "pitā",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *pitā*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "it once more, slowly",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: it once more, slowly]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "it beside pater and father, and hear the one word underneath",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: it beside *pater* and *father*, and hear the one word underneath]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say nṛtyati, then read शृणोति",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *nṛtyati*, then read **शृणोति**]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What does पिता (pitā) mean? (\"father\".) Say it once more."
            }
          ]
        }
      ]
    },
