              "instruction": "nīlaḥ, then prātaḥ",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *nīlaḥ*, then *prātaḥ*]"
            }
          ]
        },
        {
          "index": 4,
