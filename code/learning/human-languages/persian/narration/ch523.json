        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: تئاتر",
          "segments": [
            {
              "kind": "speech",
              "text": "تئاتر (te'âtr) — \"a theatre; a play\"."
            },
            {
              "kind": "speech",
              "text": "ما دیشب به تئاتر رفتیم. mâ dishab be te'âtr raftim. We went to the theatre last night."
            },
            {
              "kind": "speech",
              "text": "Both the place and the play."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "te'âtr was borrowed from French théâtre, which EtymDB traces through Latin theatrum to Greek theatron, 'a place for viewing' (EtymDB); Lewis & Short gloss theatrum 'a theatre' (Lewis & Short)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
