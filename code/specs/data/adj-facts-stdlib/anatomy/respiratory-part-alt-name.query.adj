% ============================================================================
% respiratory-part-alt-name.query.adj — worked recall over the
% respiratory-part-alt-name library.
% ============================================================================
% The shape a learner (or an LLM) produces to ANSWER "what is the trachea
% also called?" (direct) or "which part is called the air sacs?" (reverse) —
% it states no fact of its own — it only `import`s the grounded table and
% asks binding queries. A part not tabled here abstains honestly — the
% engine never invents an alternate name.
% ============================================================================

import "respiratory-part-alt-name.adj"

? respiratory_part_alt_name(trachea, $AltName)   % expect windpipe
? respiratory_part_alt_name($Part, air_sacs)      % reverse bind — expect alveoli
? respiratory_part_alt_name(larynx, $AltName)      % expect abstain -- a real, already-tabled part whose own quote states only its function, never an everyday alternate name
