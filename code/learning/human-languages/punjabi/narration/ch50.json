            {
              "kind": "speech",
              "text": "Before the new one: say the Punjabi for a tooth, then the Punjabi for the throat."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ਉਂਗਲ",
          "segments": [
            {
              "kind": "speech",
              "text": "ਉਂਗਲ — uṅgal — \"a finger\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ਉਂਗਲ (uṅgal) is a tadbhava, a word inherited from Sanskrit and reshaped by sound change. It comes from aṅguli, \"finger, toe\" (CDIAL 135)."
            }
          ]
        },
