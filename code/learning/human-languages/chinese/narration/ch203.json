    {
      "id": "ZH-W203-dong-east",
      "sequence": 15785,
      "title": "东 (dōng) — a bar, a turn, a hook and two short strokes",
      "headword": "东",
      "romanization": "dōng",
      "gloss": "东 — a bar, a turning stroke, a hooked vertical and two short strokes",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:9962e0aff60230bc",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — a bar, a turn, a hook and two short strokes",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — a bar, a turn, a hook and two short strokes and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say fángdōng — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *fángdōng* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "房 车."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — fáng, chē",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *fáng*, *chē*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — a bar, a turn, a hook and two short strokes",
          "segments": [
            {
              "kind": "speech",
              "text": "东 (dōng)."
            },
            {
              "kind": "speech",
              "text": "One piece, five strokes, top to bottom. Count the strokes in their turns."
            },
            {
              "kind": "speech",
              "text": "First, a bar across the upper middle."
            },
            {
              "kind": "speech",
              "text": "Second, a stroke from above the bar, falling down to the left and turning to run right."
            },
            {
              "kind": "speech",
              "text": "Third, a vertical down the middle, from above the turned stroke and down through it, hooking to the left at its foot."
            },
            {
              "kind": "speech",
              "text": "Last, two short strokes at the foot: one falling to the left, then a dot on the right."
            },
            {
              "kind": "speech",
              "text": "1 + 1 + 1 + 2 = five."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "东 (dōng), all five, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 东, all five, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many strokes in 东 (dōng)? (Five.) Which stroke hooks? (The vertical down the middle.) What comes last? (The dot on the right.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 东 (dōng), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
