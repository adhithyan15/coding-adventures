          "segments": [
            {
              "kind": "speech",
              "text": "emballer — \"to wrap (up), to pack; to thrill (informal)\"."
            },
            {
              "kind": "speech",
              "text": "La vendeuse emballe le cadeau dans du papier rouge. The shop assistant wraps the present in red paper."
            },
            {
              "kind": "speech",
              "text": "Informal: ça m'emballe — I love the idea; s'emballer — to get carried away."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "emballer is built from en- and balle 'bale, bundle' (EtymDB lists the verb), and balle is usually traced to a Frankish word meaning 'ball'."
            }
          ]
        },
