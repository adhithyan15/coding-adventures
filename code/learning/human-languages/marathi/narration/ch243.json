      "id": "MR-C243-thikan",
      "sequence": 13580,
      "title": "ठिकाण (ṭhikāṇ) — a place, a spot",
      "headword": "ठिकाण",
      "romanization": "ṭhikāṇ",
      "gloss": "a place, a spot",
      "script": "devanagari",
      "modality": "voice",
      "derivedModality": "voice",
