              "instruction": "eḷuppaṁ becomes eḷuppamāṇŭ",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *eḷuppaṁ* → *eḷuppamāṇŭ*]"
            },
