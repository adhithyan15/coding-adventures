    "@coding-adventures/sql-planner": "file:../sql-planner",
    "coding-adventures-sql-parser": "file:../sql-parser",
    "coding-adventures-sql-lexer": "file:../sql-lexer",
    "@coding-adventures/lexer": "file:../lexer",
    "@coding-adventures/grammar-tools": "file:../grammar-tools",
    "@coding-adventures/parser": "file:../parser",
