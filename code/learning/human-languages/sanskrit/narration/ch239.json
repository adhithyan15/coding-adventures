        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: आशा",
          "segments": [
            {
              "kind": "speech",
              "text": "आशा — āśā — \"hope\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "āśā is built on ā- and the root √śaṃs, \"to recite, praise; to wish\" (MW; CDIAL 1456). It lives on as Hindi ās, \"hope\"."
            }
          ]
        },
