# Perl 5.003_19 (1997-01-04) tokens: plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: this does not lex all Perl 5.003_19 source.
# Evidence: https://github.com/Perl/perl5/blob/perl-5.003_19/toke.c
# Tagged tokenizer changes to method/subroutine and quote/label handling are
# outside this subset. Multi-digit leading-zero forms remain refused.

PRINT     = "print"
INT       = /0|[1-9][0-9]*/
PLUS      = "+"
DECREMENT = "--"
MINUS     = "-"
STAR      = "*"
LPAREN    = "("
RPAREN    = ")"
SEMICOLON = ";"

skip:
  WHITESPACE = /[ \t\r\n]+/
