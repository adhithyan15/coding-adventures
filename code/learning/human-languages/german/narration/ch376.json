          "segments": [
            {
              "kind": "speech",
              "text": "konzentrieren — \"to concentrate (mostly reflexive, sich konzentrieren)\"."
            },
            {
              "kind": "speech",
              "text": "Bei dem Lärm kann ich mich nicht konzentrieren. I cannot concentrate with this noise."
            },
            {
              "kind": "speech",
              "text": "Mostly reflexive: sich auf etwas konzentrieren. Perfekt: hat sich konzentriert."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "konzentrieren was borrowed from French concentrer (EtymDB), built from con- \"together\" and centre, from Latin centrum \"the middle point\" (Lewis & Short): you bring everything to one centre."
            }
          ]
        },
