{
  "script": "devanagari",
  "name": "Devanagari",
  "font": "_fonts/NotoSansDevanagari-Static.ttf",
  "direction": "ltr",
  "system": "abugida",
  "signature": "A horizontal head-line (shirorekha) runs across the top; letters hang beneath it like laundry on a line.",
  "complete": false,
  "combination": "A consonant carries an inherent 'a' (क = ka). A vowel mark (mātrā) replaces that vowel (क + ी → की = kī). The virama ् strips the vowel, and the bare consonant joins the next into a conjunct (न + ् + म → न्म). The horizontal top line (shirorekhā) runs across the whole word.",
  "notes": "Used by Hindi, Marathi, and Sanskrit in this curriculum. The initial inventory below covers the greeting/self-introduction vocabulary; it grows toward a complete set. Stroke orders are the common handwriting convention, not a standard.",
  "letters": [
    { "glyph": "अ", "sound": "a", "role": "independent-vowel", "components": ["a left C-curve", "a vertical stem with the top bar", "the inherent-vowel default"], "strokeOrder": ["left curve", "vertical stem", "top shirorekhā"], "strokeOrderNote": "conventional" },
    { "glyph": "आ", "sound": "ā", "role": "independent-vowel", "components": ["अ", "plus a trailing vertical (the ā stroke)"], "strokeOrder": ["write अ", "add the vertical on the right", "top bar"], "strokeOrderNote": "conventional" },
    { "glyph": "इ", "sound": "i", "role": "independent-vowel", "components": ["a hook curving left over the stem"], "strokeOrder": ["body", "the leftward hook", "top bar"], "strokeOrderNote": "conventional" },
    { "glyph": "ई", "sound": "ī", "role": "independent-vowel", "components": ["इ", "with the hook closed into a loop"], "strokeOrder": ["body", "loop", "top bar"], "strokeOrderNote": "conventional" },
    { "glyph": "उ", "sound": "u", "role": "independent-vowel", "components": ["a hook that drops below the line"], "strokeOrder": ["body", "descending hook", "top bar"], "strokeOrderNote": "conventional" },
    { "glyph": "ऊ", "sound": "ū", "role": "independent-vowel", "components": ["उ", "with a longer tail"], "strokeOrder": ["body", "longer descending tail", "top bar"], "strokeOrderNote": "conventional" },
    { "glyph": "ए", "sound": "e", "role": "independent-vowel", "components": ["a stem with a small left flag"], "strokeOrder": ["body", "flag", "top bar"], "strokeOrderNote": "conventional" },
    { "glyph": "ऐ", "sound": "ai", "role": "independent-vowel", "components": ["ए", "with a second stroke above"], "strokeOrder": ["body", "upper stroke", "top bar"], "strokeOrderNote": "conventional" },
    { "glyph": "ओ", "sound": "o", "role": "independent-vowel", "components": ["आ", "plus the e-flag on top"], "strokeOrder": ["आ", "flag", "top bar"], "strokeOrderNote": "conventional" },
    { "glyph": "औ", "sound": "au", "role": "independent-vowel", "components": ["आ", "with a double upper stroke"], "strokeOrder": ["आ", "double upper stroke", "top bar"], "strokeOrderNote": "conventional" },

    { "glyph": "क", "sound": "ka", "role": "consonant", "inherentVowel": "a", "components": ["a left loop", "a vertical spine on the right", "the top bar"], "strokeOrder": ["left loop", "vertical spine", "top bar"], "strokeOrderNote": "conventional", "notes": "Add ् and क loses its spine when it conjuncts (क्, as in क्या)." },
    { "glyph": "ग", "sound": "ga", "role": "consonant", "inherentVowel": "a", "components": ["a hooked body", "right spine", "top bar"], "strokeOrder": ["body hook", "spine", "top bar"], "strokeOrderNote": "conventional" },
    { "glyph": "च", "sound": "ca", "role": "consonant", "inherentVowel": "a", "components": ["a rounded body opening right", "spine", "top bar"], "strokeOrder": ["rounded body", "spine", "top bar"], "strokeOrderNote": "conventional" },
    { "glyph": "त", "sound": "ta", "role": "consonant", "inherentVowel": "a", "components": ["a small left curl", "a tall spine", "top bar"], "strokeOrder": ["left curl", "spine", "top bar"], "strokeOrderNote": "conventional" },
    { "glyph": "द", "sound": "da", "role": "consonant", "inherentVowel": "a", "components": ["an S-like body", "no separate right spine", "top bar"], "strokeOrder": ["upper curve", "lower curve", "top bar"], "strokeOrderNote": "conventional" },
    { "glyph": "ध", "sound": "dha", "role": "consonant", "inherentVowel": "a", "components": ["like द with an extra inner loop", "top bar"], "strokeOrder": ["body", "inner loop", "top bar"], "strokeOrderNote": "conventional" },
    { "glyph": "न", "sound": "na", "role": "consonant", "inherentVowel": "a", "components": ["a left bowl", "right spine", "top bar"], "strokeOrder": ["bowl", "spine", "top bar"], "strokeOrderNote": "conventional" },
    { "glyph": "प", "sound": "pa", "role": "consonant", "inherentVowel": "a", "components": ["a left loop open at the bottom", "right spine", "top bar"], "strokeOrder": ["loop", "spine", "top bar"], "strokeOrderNote": "conventional" },
    { "glyph": "ब", "sound": "ba", "role": "consonant", "inherentVowel": "a", "components": ["like व with an inner bar", "right spine", "top bar"], "strokeOrder": ["body", "inner bar", "spine", "top bar"], "strokeOrderNote": "conventional" },
    { "glyph": "भ", "sound": "bha", "role": "consonant", "inherentVowel": "a", "components": ["a left loop with an inner stroke", "right spine", "top bar"], "strokeOrder": ["loop", "inner stroke", "spine", "top bar"], "strokeOrderNote": "conventional" },
    { "glyph": "म", "sound": "ma", "role": "consonant", "inherentVowel": "a", "components": ["a lower loop", "an upper loop", "right spine", "top bar"], "strokeOrder": ["lower loop", "upper loop", "spine", "top bar"], "strokeOrderNote": "conventional" },
    { "glyph": "य", "sound": "ya", "role": "consonant", "inherentVowel": "a", "components": ["a left loop", "a right hook body", "spine", "top bar"], "strokeOrder": ["left loop", "right body", "spine", "top bar"], "strokeOrderNote": "conventional" },
    { "glyph": "र", "sound": "ra", "role": "consonant", "inherentVowel": "a", "components": ["a single downward stroke with a small shoulder", "top bar"], "strokeOrder": ["shoulder", "downstroke", "top bar"], "strokeOrderNote": "conventional" },
    { "glyph": "ल", "sound": "la", "role": "consonant", "inherentVowel": "a", "components": ["a left curl", "a bowl", "right spine", "top bar"], "strokeOrder": ["curl", "bowl", "spine", "top bar"], "strokeOrderNote": "conventional" },
    { "glyph": "व", "sound": "va", "role": "consonant", "inherentVowel": "a", "components": ["a single left loop", "right spine", "top bar"], "strokeOrder": ["loop", "spine", "top bar"], "strokeOrderNote": "conventional" },
    { "glyph": "श", "sound": "śa", "role": "consonant", "inherentVowel": "a", "components": ["a left hook", "a bowl", "right spine", "top bar"], "strokeOrder": ["hook", "bowl", "spine", "top bar"], "strokeOrderNote": "conventional" },
    { "glyph": "स", "sound": "sa", "role": "consonant", "inherentVowel": "a", "components": ["a left curl", "a body", "right spine", "top bar"], "strokeOrder": ["curl", "body", "spine", "top bar"], "strokeOrderNote": "conventional" },
    { "glyph": "ह", "sound": "ha", "role": "consonant", "inherentVowel": "a", "components": ["a single looped body", "right spine", "top bar"], "strokeOrder": ["loop body", "spine", "top bar"], "strokeOrderNote": "conventional" }
  ],
  "marks": [
    { "mark": "ा", "sound": "ā", "role": "vowel-sign", "attachesAs": "a vertical bar to the right of the consonant", "example": { "base": "न", "combined": "ना", "sound": "nā" } },
    { "mark": "ि", "sound": "i", "role": "vowel-sign", "attachesAs": "a curl placed BEFORE (to the left of) the consonant, though pronounced after", "example": { "base": "श", "combined": "शि", "sound": "śi" } },
    { "mark": "ी", "sound": "ī", "role": "vowel-sign", "attachesAs": "a curl to the right with a tail over the top bar", "example": { "base": "द", "combined": "दी", "sound": "dī" } },
    { "mark": "ु", "sound": "u", "role": "vowel-sign", "attachesAs": "a small hook below the consonant", "example": { "base": "त", "combined": "तु", "sound": "tu" } },
    { "mark": "ू", "sound": "ū", "role": "vowel-sign", "attachesAs": "a longer hook below the consonant", "example": { "base": "त", "combined": "तू", "sound": "tū" } },
    { "mark": "े", "sound": "e", "role": "vowel-sign", "attachesAs": "a stroke above the top bar", "example": { "base": "म", "combined": "मे", "sound": "me" } },
    { "mark": "ै", "sound": "ai", "role": "vowel-sign", "attachesAs": "a double stroke above the top bar", "example": { "base": "ह", "combined": "है", "sound": "hai" } },
    { "mark": "ो", "sound": "o", "role": "vowel-sign", "attachesAs": "the ā bar on the right plus a stroke above", "example": { "base": "क", "combined": "को", "sound": "ko" } },
    { "mark": "ौ", "sound": "au", "role": "vowel-sign", "attachesAs": "the ā bar plus a double stroke above", "example": { "base": "क", "combined": "कौ", "sound": "kau" } },
    { "mark": "ं", "sound": "ṃ (nasal)", "role": "nasal", "attachesAs": "an anusvāra dot above the top bar, nasalizing the syllable", "example": { "base": "स", "combined": "सं", "sound": "saṃ" } },
    { "mark": "्", "sound": "(vowel killer)", "role": "virama", "attachesAs": "a stroke below that removes the inherent 'a' and forms a conjunct with the next consonant", "example": { "base": "क", "combined": "क्", "sound": "k" } },
    { "mark": "ृ", "sound": "ṛ", "role": "vowel-sign", "attachesAs": "a small hook below (the vocalic r, common in Sanskrit)", "example": { "base": "क", "combined": "कृ", "sound": "kṛ" } }
  ]
}
