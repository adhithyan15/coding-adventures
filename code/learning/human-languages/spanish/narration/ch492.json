            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Spanish for the wallet, then the Spanish for the tip."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: intentar",
          "segments": [
            {
              "kind": "speech",
              "text": "intentar — \"to try\"."
            },
            {
              "kind": "speech",
              "text": "Intento llegar a tiempo. I try to arrive on time."
            },
            {
              "kind": "speech",
              "text": "Followed by an infinitive, with no preposition."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "intentar from Latin intentare, \"to stretch out towards\" (EtymDB 2.1), built on tendere, \"to stretch\" — a learned word. To try is to reach for something."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for reading notices, forms and messages."
            }
          ]
        },
