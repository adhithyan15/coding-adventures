        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: le vol",
          "segments": [
            {
              "kind": "speech",
              "text": "le vol — \"the flight\"."
            },
            {
              "kind": "speech",
              "text": "Notre vol part à sept heures du matin. Our flight leaves at seven in the morning."
            },
            {
              "kind": "speech",
              "text": "Le vol is also a theft; that sense comes from voler 'to steal'."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "vol is built on voler 'to fly' (EtymDB), which is inherited from Latin volāre."
            }
          ]
        },
        {
