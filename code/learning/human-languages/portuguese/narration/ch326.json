          "type": "input",
          "title": "You'll want to know: a lenda",
          "segments": [
            {
              "kind": "speech",
              "text": "a lenda — \"the legend\"."
            },
            {
              "kind": "speech",
              "text": "Segundo a lenda, ninguém pode entrar na gruta à noite. According to the legend, nobody may go into the cave at night."
            },
            {
              "kind": "speech",
              "text": "Conta a lenda que… — legend has it that…"
            }
          ]
        },
