% ============================================================================
% months.query.adj — a worked recall over the kindergarten months library.
% ============================================================================
% The shape a learner (or an LLM) produces to ANSWER "what number is January?":
% it states no calendar fact — it only `import`s the grounded table and asks
% binding queries. The engine resolves each `?` against the `month_number` rows
% and returns the number + the table's source/locator/trust. A word that is not a
% month abstains honestly — the engine never invents an index. The relation binds
% both ways, so the reverse query recovers the month name from its number.
%
% Run (from this directory so the relative import resolves):
%     ../../../../packages/rust/target/debug/adj-lang-cli months.query.adj
% ============================================================================

import "months.adj"

? month_number(january, $Number)       % expect 1
? month_number(december, $Number)      % expect 12
? month_number($Month, 1)              % expect january (reverse: number → name)
? month_number(smarch, $Number)        % expect abstain — smarch is not a month
