        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ओरखडा",
          "segments": [
            {
              "kind": "speech",
              "text": "ओरखडा — orakhḍā — \"a scrape; a scratch\"."
            },
            {
              "kind": "speech",
              "text": "गाडीच्या दारावर मोठा ओरखडा आहे. gāḍīcyā dārāvar moṭhā orakhḍā āhe. There is a big scratch on the car door."
            },
            {
              "kind": "speech",
              "text": "Masculine."
            },
            {
              "kind": "speech",
              "text": "ओरखडा (orakhḍā) पडणे, a scratch appears."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ओरखडा (orakhḍā) is a Marathi word for a long, thin scratch; its origin is not settled."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for getting around."
            }
          ]
        },
