          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: agger, aggeris",
          "segments": [
            {
              "kind": "speech",
              "text": "agger, aggeris — \"a raised roadbed; a mound, an embankment\"."
            },
            {
              "kind": "speech",
              "text": "Via in aggere altō per campum it. The road runs across the plain on a high embankment."
            },
            {
              "kind": "speech",
              "text": "Third declension, masculine: agger, aggeris m. A Roman road was laid on a raised bank of earth and stones. English exaggerate first meant 'to heap up'."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "agger is built on ad- 'to' and gerō 'to carry' (EtymDB; Lewis & Short): earth and stones carried to one spot. English exaggerate comes from Latin exaggerāre 'to heap up', built on it."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
