          "segments": [
            {
              "kind": "speech",
              "text": "recordor, recordārī — \"to call to mind, to remember\"."
            },
            {
              "kind": "speech",
              "text": "Diem illum saepe recordor. I often recall that day."
            },
            {
              "kind": "speech",
              "text": "Deponent: recordor, recordārī, recordātus sum, built on cor, heart: to bring back to the heart. English record comes from it."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "recordor is built from re- \"back\" and cor, cordis \"heart\" (EtymDB; Lewis & Short), the seat of memory for the Romans. English record comes from it through French."
            }
          ]
        },
