              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU CONNECT: **do** ← \\**dwoh* → English **two**, Latin **duo**]"
            },
            {
              "kind": "prompt",
              "action": "RUN",
              "instruction": "yek, do",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RUN: **yek, do**]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Which of و's three jobs is it doing in دو? (o.)"
            },
            {
              "kind": "speech",
              "text": "Sources: Wiktionary: دو (do); Omniglot, Numbers in Persian."
            },
            {
              "kind": "activity",
              "scored": true,
