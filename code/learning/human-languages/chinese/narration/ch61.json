    {
      "id": "ZH-W61-chang-long",
      "sequence": 5155,
      "title": "长 (cháng) — four strokes in one piece",
      "headword": "长",
      "romanization": "cháng",
      "gloss": "长 — a fall, a bar, a flicked vertical and a sweep",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:aaf8c062702a6cac",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — four strokes in one piece",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — four strokes in one piece and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say cháng — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *cháng* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "大 八."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — dà, bā",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *dà*, *bā*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — four strokes in one piece",
          "segments": [
            {
              "kind": "speech",
              "text": "长 (cháng)."
            },
            {
              "kind": "speech",
              "text": "One piece, four strokes."
            },
            {
              "kind": "speech",
              "text": "A short left-falling stroke at the top right, falling toward the left."
            },
            {
              "kind": "speech",
              "text": "A long horizontal across the middle."
            },
            {
              "kind": "speech",
              "text": "A vertical from the top left, down through the bar, that turns and flicks up to the right at the foot."
            },
            {
              "kind": "speech",
              "text": "A long stroke falling to the right, from the bar down to the bottom right."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "长 (cháng), all four, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 长, all four, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many strokes in 长 (cháng)? (Four.) Which stroke flicks up at the foot? (The vertical, the third.) Which way does the last one fall? (Down to the right.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 长 (cháng), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
