      ],
      "sourceHash": "fnv1a64:808a0965a4d0359e",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
