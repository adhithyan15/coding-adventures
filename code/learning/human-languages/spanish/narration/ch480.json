          "segments": [
            {
              "kind": "speech",
              "text": "comunicar — \"to communicate, to inform\"."
            },
            {
              "kind": "speech",
              "text": "Le comunicamos que su pedido ha llegado. We inform you that your order has arrived."
            },
            {
              "kind": "speech",
              "text": "In Spain, está comunicando on the phone means the line is busy; elsewhere people say está ocupado."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "comunicar from Latin communicare, \"to share, to make common\" (EtymDB 2.1), from communis, \"common\" — a learned borrowing: the -c- between vowels did not become -g-."
            }
          ]
        },
