        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ایماندار",
          "segments": [
            {
              "kind": "speech",
              "text": "ایماندار — imāndār — \"honest\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ایماندار (imāndār) is \"faith-holder\". It joins Arabic īmān, \"faith\", which reached Urdu through Persian (Lane, root ʾ-m-n), and the Persian -dār, \"holder\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
