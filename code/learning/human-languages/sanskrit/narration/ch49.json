          "index": 1,
          "type": "input",
          "title": "You'll want to know: मुहुः",
          "segments": [
            {
              "kind": "speech",
              "text": "मुहुः (muhuḥ) — \"again and again\"."
            },
            {
              "kind": "speech",
              "text": "मुहुः (muhuḥ) — \"again and again, over and over\"."
            },
            {
              "kind": "speech",
              "text": "You have पुनः for \"again\", meaning one more time. मुहुः is the stronger one: not once more but repeatedly, and doubled as muhur muhuḥ it is stronger still."
            },
            {
              "kind": "speech",
              "text": "It belongs with muhūrta, a short measured stretch of time. The picture underneath is a thing happening moment after moment after moment."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "A stronger \"again\" than the one you had."
            }
          ]
        },
