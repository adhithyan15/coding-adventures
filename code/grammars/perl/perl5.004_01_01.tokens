# Perl 5.004_01_01 (1997-07-29) tokens: plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: this does not lex all Perl 5.004_01_01 source.
# Evidence: https://mirrors.develooper.com/perl/historical-perl/perl-5.004_01_01.tar.gz
# Archived toke.c changes quoted-curly and word-operator handling outside
# this subset and retains its 250-digit decimal bound.
# Unsupported characters, carriage returns and
# leading-zero forms remain refused.

PRINT     = "print"
INT       = /0|[1-9][0-9]{0,249}/
PLUS      = "+"
DECREMENT = "--"
MINUS     = "-"
STAR      = "*"
LPAREN    = "("
RPAREN    = ")"
SEMICOLON = ";"

skip:
  WHITESPACE = /[ \t\n]+/
