      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Say I did the work. Then tea and milk."
            }
          ]
        },
        {
          "index": 1,
          "type": "grammar",
          "title": "Grammar Lens: the thing decides",
          "segments": [
            {
              "kind": "speech",
              "text": "ਪੀਣਾ works like ਕੀਤਾ: after ਮੈਂ, ਅਸੀਂ or ਤੁਸੀਂ, its past agrees with what was drunk. ਚਾਹ is a feminine word, ਦੁੱਧ a masculine one:"
            },
            {
              "kind": "speech",
              "text": "ਮੈਂ ਚਾਹ ਪੀਤੀ। — maiṁ chāh pītī. — I drank tea."
            },
            {
              "kind": "speech",
              "text": "ਮੈਂ ਦੁੱਧ ਪੀਤਾ। — maiṁ duddh pītā. — I drank milk."
            },
            {
              "kind": "speech",
              "text": "A man and a woman say both lines the same way."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "HEAR",
              "instruction": "we drank water",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU HEAR: *we drank water*]"
            },
            {
              "kind": "speech",
              "text": "Say ਅਸੀਂ ਪਾਣੀ ਪੀਤਾ।."
            },
            {
              "kind": "prompt",
              "action": "HEAR",
              "instruction": "you drank tea",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU HEAR: *you drank tea*]"
            },
            {
              "kind": "speech",
              "text": "Say ਤੁਸੀਂ ਚਾਹ ਪੀਤੀ।."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "ਮੈਂ ਚਾਹ ਪੀਤੀ। (maiṁ chāh pītī.)",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: **ਮੈਂ ਚਾਹ ਪੀਤੀ।**]"
            },
            {
              "kind": "speech",
              "text": "Point to ਚਾਹ, then to the ending that follows it."
            },
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "copy ਪੀਤਾ and ਪੀਤੀ once",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: copy **ਪੀਤਾ** and **ਪੀਤੀ** once]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
