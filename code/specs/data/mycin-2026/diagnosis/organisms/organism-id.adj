import "organism-vocab.adj"

rulebook organism_id {
    use organism_vocab

    % ===================== Epidemiologic priors (spider-grounded) =====================
    prior 0.51 for s_pneumoniae
        source "van de Beek D, et al. \"Clinical Features and Prognostic Factors in Adu"
        trust authoritative
    prior 0.139 for n_meningitidis
        source "Bacterial Meningitis — StatPearls, NCBI Bookshelf (NIH)"
        trust authoritative
    prior 0.067 for h_influenzae
        source "Bacterial Meningitis — StatPearls, NCBI Bookshelf (NIH), citing Thigpe"
        trust authoritative
    prior 0.06 for listeria
        source "Outcomes of adults with community-acquired bacterial meningitis in the"
        trust authoritative
    prior 0.03 for gram_negative_bacilli
        source "Acute Bacterial Meningitis in Adults — A Review of 493 Episodes (Duran"
        trust authoritative
    prior 0.02 for group_b_strep
        source "Global etiology of bacterial meningitis: A systematic review and meta-"
        trust inferred   % [FLAG: direction_only]
    prior 0.01 for s_aureus
        source "Clinical characteristics and outcomes of acute bacterial meningitis in"
        trust inferred   % [FLAG: refuted]

    % ===================== Gram-stain morphology (spider-grounded mapping) =====================
    contributes 50 from csf_gram_morphology(gram_positive_diplococci) to s_pneumoniae
        source "Gram-Positive Diplococci in a Cerebrospinal Fluid Gram Stain — Open Fo"
        trust consensus
    contributes 50 from csf_gram_morphology(gram_negative_diplococci) to n_meningitidis
        source "Neisseria meningitidis: Biology, Microbiology, and Epidemiology (Metho"
        trust consensus
    contributes 45 from csf_gram_morphology(gram_positive_bacilli) to listeria
        source "Listeria monocytogenes meningitis (PMC5986172, peer-reviewed case repo"
        trust inferred   % [FLAG: direction_only]
    contributes 45 from csf_gram_morphology(gram_negative_coccobacilli) to h_influenzae
        source "Haemophilus influenzae Infection - StatPearls - NCBI Bookshelf"
        trust inferred   % [FLAG: direction_only]
    contributes 40 from csf_gram_morphology(gram_negative_bacilli) to gram_negative_bacilli
        source "Epidemiology and Prevention of Vaccine-Preventable Diseases (Pink Book"
        trust inferred   % [FLAG: refuted]
    contributes 45 from csf_gram_morphology(gram_positive_cocci_clusters) to s_aureus
        source "Gram-Positive Bacteria — StatPearls, NCBI Bookshelf (NIH)"
        trust inferred   % [FLAG: direction_only]

    % ===================== Host factors (spider-grounded associations) =====================
    contributes 12 from age_band(neonate) to group_b_strep
        source "Disease burden of neonatal invasive Group B Streptococcus infection in"
        trust consensus
    contributes 8 from age_band(neonate) to gram_negative_bacilli
        source "Neonatal Bacterial Meningitis — Merck Manual Professional Edition (Ped"
        trust consensus
    contributes 4 from age_band(neonate) to listeria
        source "The Brief Case: Neonatal Meningitis Caused by Listeria monocytogenes D"
        trust consensus
    contributes 5 from age_band(older_adult) to listeria
        source "Three-year multicenter surveillance of community-acquired Listeria mon"
        trust inferred   % [FLAG: direction_only]
    contributes 2 from age_band(older_adult) to gram_negative_bacilli
        source "The spectrum of acute bacterial meningitis in elderly patients (BMC In"
        trust consensus
    contributes 2 from age_band(infant_child) to n_meningitidis
        source "Meningococcal Disease (Neisseria meningitidis Infection) — StatPearls,"
        trust consensus
    contributes 2 from age_band(infant_child) to h_influenzae
        source "Chapter 8: Haemophilus influenzae — Epidemiology and Prevention of Vac"
        trust inferred   % [FLAG: direction_only]
    contributes 6 from immunocompromised(present) to listeria
        source "Bacterial Meningitis in Patients using Immunosuppressive Medication: a"
        trust consensus
    contributes 3 from immunocompromised(present) to gram_negative_bacilli
        source "Adults with spontaneous aerobic Gram-negative bacillary meningitis adm"
        trust inferred   % [FLAG: direction_only]
    contributes 9 from listeria_exposure(present) to listeria
        source "Listeriosis — WHO (World Health Organization) Fact Sheet"
        trust consensus
    contributes 8 from recent_neurosurgery_or_shunt(present) to s_aureus
        source "Nosocomial Meningitis: Moving beyond Description to Prevention (Hong B"
        trust consensus
    contributes 6 from recent_neurosurgery_or_shunt(present) to gram_negative_bacilli
        source "2017 Infectious Diseases Society of America's Clinical Practice Guidel"
        trust consensus
    contributes 4 from crowding_exposure(present) to n_meningitidis
        source "Meningococcal Disease and College Students — Recommendations of the Ad"
        trust consensus
    contributes 7 from petechial_rash(present) to n_meningitidis
        source "Skin rash in meningitis and meningoencephalitis (PMC3719428, peer-revi"
        trust consensus
}

? s_pneumoniae
? n_meningitidis
? h_influenzae
? listeria
? gram_negative_bacilli
? group_b_strep
? s_aureus
