          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ذات مرة (dhāta marra) is built from dhāta, \"one possessing\", and marra, \"a time, a single passing\", from the root m-r-r, \"to pass\" (Lane): \"on one occasion\"."
            }
          ]
        },
