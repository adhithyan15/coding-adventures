<Project Sdk="Microsoft.NET.Sdk">

<!-- Auto-generated by mosaic-emit-xaml in emit-project mode. -->
<PropertyGroup>
<OutputType>WinExe</OutputType>
<TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
<RootNamespace>Mosaic.Generated</RootNamespace>
<ApplicationManifest>app.manifest</ApplicationManifest>
<Platforms>x64</Platforms>
<RuntimeIdentifier>win-x64</RuntimeIdentifier>
<UseWinUI>true</UseWinUI>
<EnableMsixTooling>false</EnableMsixTooling>
<WindowsPackageType>None</WindowsPackageType>
<Nullable>enable</Nullable>
<ImplicitUsings>enable</ImplicitUsings>
<LangVersion>latest</LangVersion>
<!-- Framework-dependent: the Windows App Runtime must be installed
system-wide (`winget install Microsoft.WindowsAppRuntime.1.7`).
Self-contained bundling (<WindowsAppSDKSelfContained>true) is
available, but the bundled Microsoft.UI.Xaml.dll 3.1.7.0 in the
1.7 NuGet currently crashes on initialization (0xc000027b in
Microsoft.UI.Xaml.dll). Use framework-dependent until that's
resolved upstream. -->
<WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
<SelfContained>false</SelfContained>
<!-- WindowsAppSDK uses the legacy `win10-*` RIDs that .NET 8+
removed from the default graph. UseRidGraph=true restores
support for them. -->
<UseRidGraph>true</UseRidGraph>
<!-- Fix C1 mitigation: the AppxPackage / MrtCore.PriGen targets
ship with Visual Studio's MSBuild tasks, not the bare .NET SDK.
These two flags suppress most of the PRI/MSIX plumbing that
would otherwise fail on a SDK-only machine. The build still
emits one cosmetic MSB4062 error at the very end of the
packaging cleanup; ignore it. The .exe + dependencies are
produced before the failing target runs. -->
<AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
<EnableDefaultPriItems>false</EnableDefaultPriItems>
</PropertyGroup>

<ItemGroup>
<PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250606001" />
<PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.756" />
</ItemGroup>

<!-- Fix B2: dotnet build leaves the native runtime DLLs in
runtimes/win-x64/native/. Flatten them next to the .exe so
the unpackaged bootstrap finds them at launch. -->
<Target Name="FlattenNativeRuntimeDlls" AfterTargets="Build">
<ItemGroup>
<_NativeRuntimeDlls Include="$(OutDir)runtimes/win-x64/native/*.dll" />
</ItemGroup>
<Copy SourceFiles="@(_NativeRuntimeDlls)" DestinationFolder="$(OutDir)"
SkipUnchangedFiles="true" />
</Target>

</Project>
