            {
              "kind": "speech",
              "text": "Before the new one: say the Punjabi for slowly, then the Punjabi for fast."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ਸੌਖਾ",
          "segments": [
            {
              "kind": "speech",
              "text": "ਸੌਖਾ — saukhā — \"easy\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Where ਸੌਖਾ (saukhā) comes from is not settled. CDIAL has no entry for it, though it lists Punjabi suhelā, \"easy\", under Sanskrit sukha, \"easy, pleasant\" (CDIAL 13451)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for this chapter."
