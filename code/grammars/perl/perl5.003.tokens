# Perl 5.003 (1996-06-25) tokens: verified arithmetic-print subset only.
# @version 1
# PARTIAL: this does not lex all Perl 5.003 source.
# Evidence: https://github.com/Perl/perl5/blob/perl-5.003/perly.y
# Evidence: https://github.com/Perl/perl5/blob/perl-5.003/toke.c
# The tagged perly.y and toke.c match 5.002_01 exactly; this release still
# has its own pair. `print` maps to KEY_print, with ADDOP/MULOP and decrement.

PRINT     = "print"
INT       = /[0-9]+/
PLUS      = "+"
DECREMENT = "--"
MINUS     = "-"
STAR      = "*"
LPAREN    = "("
RPAREN    = ")"
SEMICOLON = ";"

skip:
  WHITESPACE = /[ \t\r\n]+/
