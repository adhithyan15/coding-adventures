      "title": "अपचन (apcan) — indigestion",
      "headword": "अपचन",
      "romanization": "apcan",
      "gloss": "indigestion",
      "script": "devanagari",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
