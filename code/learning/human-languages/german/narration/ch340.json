        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: beurteilen",
          "segments": [
            {
              "kind": "speech",
              "text": "beurteilen — \"to judge, to assess\"."
            },
            {
              "kind": "speech",
              "text": "Das kann ich nicht beurteilen, ich kenne das Buch nicht. I cannot judge that; I do not know the book."
            },
            {
              "kind": "speech",
              "text": "Inseparable: er beurteilt, er hat beurteilt."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "beurteilen is built on Urteil \"judgement\", inherited from Old High German urteil and Proto-Germanic uzdailiją \"a dealing out\" (EtymDB), on the word for \"part\": a judge deals out to each his part."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
