          "type": "input",
          "title": "You'll want to know: la norme",
          "segments": [
            {
              "kind": "speech",
              "text": "la norme — \"the norm, the standard\"."
            },
            {
              "kind": "speech",
              "text": "Ce casque est aux normes. This helmet meets the standards."
            },
            {
              "kind": "speech",
              "text": "Être aux normes — to meet the standards."
