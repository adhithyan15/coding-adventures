          "segments": [
            {
              "kind": "speech",
              "text": "diffuser is built on diffus \"spread out\" (EtymDB), a learned borrowing from Latin diffūsus, the past participle of diffundere \"to pour out\" (Lewis & Short)."
            }
          ]
        },
