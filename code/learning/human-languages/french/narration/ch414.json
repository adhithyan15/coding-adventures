        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: la couchette",
          "segments": [
            {
              "kind": "speech",
              "text": "la couchette — \"the berth, the couchette\"."
            },
            {
              "kind": "speech",
              "text": "Dans le train de nuit, j'ai dormi sur la couchette du haut. On the night train I slept on the top berth."
            },
            {
              "kind": "speech",
              "text": "A small couche 'bed'."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "couchette is a small couche 'bed', from coucher 'to lay down', which is inherited from Latin collocāre 'to put in place', built on locus 'place' (Lewis & Short)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
