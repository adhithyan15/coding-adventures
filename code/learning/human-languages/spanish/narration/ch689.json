          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "cascada was borrowed from Italian cascata \"a fall\" (EtymDB), from cascare \"to fall\", which goes back to Latin cadere \"to fall\"."
            }
          ]
        },
        {
