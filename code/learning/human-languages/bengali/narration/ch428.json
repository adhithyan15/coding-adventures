          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "আর্দ্র (ārdrô) is Sanskrit ārdra, \"wet, moist, damp\" (Monier-Williams), taken over whole."
            }
          ]
        },
