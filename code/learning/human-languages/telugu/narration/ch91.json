              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "You meet a neighbour you have not seen in a long time, around lunch. Say three things."
            }
          ]
        },
        {
          "index": 1,
          "type": "grammar",
          "title": "Grammar Lens: the ending -కి, \"to\"",
          "segments": [
