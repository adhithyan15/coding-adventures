# Perl 5.004_04-m1 (1998-03-04) plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: unsupported Perl 5.004_04-m1 syntax is rejected.
# Evidence: https://mirrors.develooper.com/perl/historical-perl/perl-5.004_04-m1.tar.gz
# Archive SHA-256: 2782e92619e296052d45c5b9fc565e7c5558530ab37d39b761e8c9dd246c7605
# Lexical-state and interpolation changes are outside this subset.
# Comment-stripped scan_num is unchanged from 5.004_04, including its 250-digit bound.
# Unsupported characters, carriage returns, and leading-zero forms remain refused.

PRINT     = "print"
INT       = /0|[1-9][0-9]{0,249}/
PLUS      = "+"
DECREMENT = "--"
MINUS     = "-"
STAR      = "*"
LPAREN    = "("
RPAREN    = ")"
SEMICOLON = ";"

skip:
  WHITESPACE = /[ \t\n]+/
