// Checkbox.dark.msl — dark-theme styling (v0.3 trim).
//
// See Checkbox.light.msl header for the rewrite rationale. Only the
// `checkbox` root part survives in v0.3; native widget renders its
// own check glyph and exposes no inner element to style.

style Checkbox {
  part checkbox {
    padding : 4 ;
    // UI57 — activates on the `disabled` bool slot's truthiness.
    //
    // `opacity` composites this part and everything inside it, so a compound
    // control dims as one thing rather than needing every inner part restated
    // in muted colours. The DOM backends need this: they lower `disabled` to
    // the real control property, but an explicit `background` overrides the
    // greying a browser would otherwise apply, so the control went inert
    // without looking it. #14639
    state disabled {
      opacity : $opacity-disabled ;
    }
  }
}
