      "sourceHash": "fnv1a64:c5c4312160c38c16",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: what did kāṟṟŭ mean?"
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: മണൽ",
          "segments": [
            {
              "kind": "speech",
              "text": "മണൽ (maṇal) — \"sand\"."
            },
            {
              "kind": "speech",
              "text": "Inherited, matching Tamil maṇal. The ണ is retroflex, made with the tongue curled back, and the chillu ൽ closes the word without a vowel after it — both of them sounds you have already been handling."
            },
            {
              "kind": "speech",
              "text": "Kerala's sand is a river business as much as a beach one. Sand is dredged from the beds of the rivers that this book has already given you a word for, and the trade is argued about constantly."
            },
            {
              "kind": "speech",
              "text": "The retroflex ṇ is what separates this from a different word altogether, so the tongue position is carrying meaning rather than decorating it."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "Two: the wind, and something it moves."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "maṇal",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *maṇal*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "it once more, slowly",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: it once more, slowly]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "kāṟṟŭ, then maṇal, and curl the tongue back for the middle of the second",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *kāṟṟŭ*, then *maṇal*, and curl the tongue back for the middle of the second]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
