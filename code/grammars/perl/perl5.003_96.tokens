# Perl 5.003_96 (1997-04-01) tokens: plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: this does not lex all Perl 5.003_96 source.
# Evidence: https://github.com/Perl/perl5/blob/perl-5.003_96/toke.c
# Tagged tokenizer now errors on unrecognized characters and revises -a/-F
# loop expansion and diagnostics. This subset rejects unsupported characters,
# carriage returns and leading-zero forms.

PRINT     = "print"
INT       = /0|[1-9][0-9]*/
PLUS      = "+"
DECREMENT = "--"
MINUS     = "-"
STAR      = "*"
LPAREN    = "("
RPAREN    = ")"
SEMICOLON = ";"

skip:
  WHITESPACE = /[ \t\n]+/
