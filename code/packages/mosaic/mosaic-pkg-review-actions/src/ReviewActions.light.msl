// ReviewActions.light.msl - light review-action theme.

style ReviewActions {
  part review-actions-row {
    padding : 4 ;
  }

  part action-undo {
    background    : "#f1f5f9" ;
    border-width  : 1 ;
    border-color  : "#cbd5e1" ;
    border-radius : 6 ;
    color         : "#0f172a" ;
    font-weight   : 700 ;
    padding       : 8 ;
  }

  part action-bury-card {
    background    : "#ede9fe" ;
    border-width  : 1 ;
    border-color  : "#ddd6fe" ;
    border-radius : 6 ;
    color         : "#5b21b6" ;
    font-weight   : 700 ;
    padding       : 8 ;
  }

  part action-bury-siblings {
    background    : "#ccfbf1" ;
    border-width  : 1 ;
    border-color  : "#99f6e4" ;
    border-radius : 6 ;
    color         : "#115e59" ;
    font-weight   : 700 ;
    padding       : 8 ;
  }

  part action-suspend-card {
    background    : "#ffedd5" ;
    border-width  : 1 ;
    border-color  : "#fed7aa" ;
    border-radius : 6 ;
    color         : "#92400e" ;
    font-weight   : 700 ;
    padding       : 8 ;
  }

  part action-toggle-mark {
    background    : "#ffe4e6" ;
    border-width  : 1 ;
    border-color  : "#fecdd3" ;
    border-radius : 6 ;
    color         : "#9f1239" ;
    font-weight   : 700 ;
    padding       : 8 ;
  }
}
