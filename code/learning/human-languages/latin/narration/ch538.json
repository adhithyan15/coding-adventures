        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ōtiōsus, ōtiōsa, ōtiōsum",
          "segments": [
            {
              "kind": "speech",
              "text": "ōtiōsus, ōtiōsa, ōtiōsum — \"at leisure, idle\"."
            },
            {
              "kind": "speech",
              "text": "Diē fēstō cīvēs ōtiōsī in forō ambulant. On the holiday the citizens stroll at leisure in the forum."
            },
            {
              "kind": "speech",
              "text": "From ōtium: free of business, with no blame meant. English otiose."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ōtiōsus is built on ōtium \"leisure\" with -ōsus (EtymDB; Lewis & Short). English otiose comes from it."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
