          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "herrschen is inherited from Middle High German hērschen, Old High German hērisōn (EtymDB), built on hēr \"noble, venerable\" (EtymDB), whose comparative gave Herr \"lord\"."
            }
          ]
        },
