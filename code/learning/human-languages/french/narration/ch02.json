              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: \"comment\" (*ko-MAHN*, nasal ending)]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "the Latin quo modo becomes French comment, Spanish cómo",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: the Latin *quo modo* → French *comment*, Spanish *cómo*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "English mode/model share the modo piece",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: English *mode/model* share the *modo* piece]"
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
