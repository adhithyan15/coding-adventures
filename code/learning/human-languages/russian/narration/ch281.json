          "segments": [
            {
              "kind": "speech",
              "text": "репортаж (reportázh) — \"a report (on TV or radio), a news story\"."
            },
            {
              "kind": "speech",
              "text": "Вечером мы смотрели репортаж о футболе. Vécherom my smotréli reportázh o futbóle. In the evening we watched a report about football."
            },
            {
              "kind": "speech",
              "text": "Masculine. Вести репортаж (reportázh) — to report live."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "репортаж (reportázh) was borrowed from French reportage (EtymDB), built on reporter \"to bring back, to report\" and the ending -age; the verb goes back to Latin reportāre, from portāre \"to carry\"."
            }
          ]
        },
