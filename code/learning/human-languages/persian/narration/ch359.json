          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "sâf \"clear, smooth\" is borrowed from Arabic ṣāfī, \"pure\" (EtymDB). kardan \"to do\" is inherited Persian: to make clear."
            }
          ]
        },
