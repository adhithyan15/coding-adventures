          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ढीला (ḍhīlā) is a tadbhava, inherited from ḍhila, \"slack\", a form CDIAL reconstructs from its descendants (CDIAL 5590)."
            }
          ]
        },
