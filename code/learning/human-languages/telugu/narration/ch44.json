          "segments": [
            {
              "kind": "speech",
              "text": "ఆలకించు (ālakiñcu) — \"listen\"."
            },
            {
              "kind": "speech",
              "text": "'Listen attentively' — a step above simply hearing. Telugu keeps listening and asking separate, where Kannada merges them into one stem."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ఆలకించు (ālakiñcu) is native Dravidian, one word with Kannada ālisu (DEDR 383). DEDR lists Telugu ālakincu, \"to hear, listen\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more. Three follow, and each reuses the ones before."
