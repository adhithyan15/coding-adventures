          "segments": [
            {
              "kind": "speech",
              "text": "سرعت گرفتن (sor'at gereftan) — \"to speed up, to gather speed\"."
            },
            {
              "kind": "speech",
              "text": "بعد از شهر اتوبوس سرعت گرفت. Ba'd az shahr otobus sor'at gereft. After the town the bus sped up."
            },
            {
              "kind": "speech",
              "text": "sor'at + gereftan (to take). Present stem gir-: sor'at migirad."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "sor'at gereftan is built from sor'at 'speed', borrowed from Arabic surʿa (EtymDB), and the native verb gereftan 'to take', which is usually traced to Old Persian grab- 'to seize'."
            }
          ]
        },
