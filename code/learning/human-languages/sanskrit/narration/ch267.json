              "kind": "prompt",
              "action": "RECALL",
              "instruction": "गृहकार्यम्; उत्तरम् — gṛhakāryam; uttaram — homework; answer",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: **गृहकार्यम्; उत्तरम्** — *gṛhakāryam; uttaram* — homework; answer]"
