          "segments": [
            {
              "kind": "speech",
              "text": "તાકીદ (tākīd) is usually traced to Arabic taʾkīd, \"emphasis, insistence\", through Persian; in Gujarati it is the pressing need to get something done."
            }
          ]
        },
