              "action": "SAY",
              "instruction": "bulānā",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *bulānā*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "bulānā, once more",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *bulānā*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "say bulānā",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: say *bulānā*]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say the Hindi for to look for, then the Hindi for to wear, then say bulānā again",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say the Hindi for to look for, then the Hindi for to wear, then say *bulānā* again]"
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What does बुलाना (bulānā) mean? (\"To call\".) Say it once more."
            }
          ]
        }
      ]
