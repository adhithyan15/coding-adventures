            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "राम घरै पूग्यो। — rām gharai pūgyo. — Ram reached home.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: **राम घरै पूग्यो।** — *rām gharai pūgyo.* — Ram reached home.]"
