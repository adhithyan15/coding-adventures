      "title": "అల్పపీడనం (alpapīḍanaṁ) — a low-pressure area",
      "headword": "అల్పపీడనం",
      "romanization": "alpapīḍanaṁ",
      "gloss": "a low-pressure area",
      "script": "telugu",
      "modality": "voice",
      "derivedModality": "voice",
