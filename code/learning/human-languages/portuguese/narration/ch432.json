          "index": 1,
          "type": "input",
          "title": "You'll want to know: o fusível",
          "segments": [
            {
              "kind": "speech",
              "text": "o fusível — \"the fuse\"."
            },
            {
              "kind": "speech",
              "text": "Saltou um fusível e a cozinha ficou sem luz. A fuse blew and the kitchen lost its lights."
            },
            {
              "kind": "speech",
              "text": "Saltar — to blow, of a fuse or a breaker."
