{
  "name": "@coding-adventures/spice-netlist-parser",
  "version": "0.3.0",
  "description": "SPICE3 netlist parser that builds coding-adventures SPICE engine circuits",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "spice-netlist-parser": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc && esbuild src/cli.ts --bundle --platform=node --format=esm --outfile=dist/cli.js",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "spice",
    "netlist",
    "parser",
    "circuits",
    "education"
  ],
  "author": "Adhithya Rajasekaran",
  "license": "MIT",
  "dependencies": {
    "@coding-adventures/spice-engine": "file:../spice-engine"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.1",
    "vitest": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11"
  }
}
