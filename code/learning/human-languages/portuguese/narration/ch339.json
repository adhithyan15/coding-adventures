          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "concordar is a learned borrowing from Latin concordāre \"to agree together, to be of one mind\" (EtymDB, Lewis & Short), from concors, built from con- \"together\" and cor, cordis \"heart\"."
            }
          ]
        },
