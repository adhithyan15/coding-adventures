        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: laus, laudis",
          "segments": [
            {
              "kind": "speech",
              "text": "laus, laudis — \"praise\"."
            },
            {
              "kind": "speech",
              "text": "Mīles laudem ducis accipit. The soldier receives the general's praise."
            },
            {
              "kind": "speech",
              "text": "Feminine, third declension. Laudō, already known, comes from it. English laud."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "laus is a native Latin noun, and laudō \"to praise\" is built on it (Lewis & Short). Lewis & Short links it with clueō \"to be spoken of\", but the origin is not settled. English laud and laudable come from the family."
            }
          ]
        },
        {
