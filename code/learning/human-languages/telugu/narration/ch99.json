        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: నమస్తే",
          "segments": [
            {
              "kind": "speech",
              "text": "నమస్తే (namastē) — \"namaste\", said with the palms together."
            },
            {
              "kind": "speech",
              "text": "It sits beside నమస్కారం, your first word. Both bow: నమస్తే (namastē) is \"a bow to you\", heard all across India; నమస్కారం is the fuller Telugu form."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "A second hello, shared with most of India."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
