  op sh_i64_by_i32(a: I64, n: I32) -> I32
  op sh_u64_by_u64(a: U64, n: U64) -> U64
  op sh_only(a: U16) -> U16
  op me_u8(a: U8, b: U32) -> Result<U8,E>
  op me_u16_zero(a: U8) -> Result<U16,E>
