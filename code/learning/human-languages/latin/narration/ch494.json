          "segments": [
            {
              "kind": "speech",
              "text": "odiōsus, odiōsa, odiōsum — \"hateful, tiresome\"."
            },
            {
              "kind": "speech",
              "text": "Iter longum et odiōsum fuit. The journey was long and tiresome."
            },
            {
              "kind": "speech",
              "text": "Built on odium — hatred. In everyday Latin it often means no more than annoying. English odious."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "odiōsus is built on odium \"hatred\" with the ending -ōsus \"full of\" (Lewis & Short; EtymDB). English odious comes from it."
            }
          ]
        },
