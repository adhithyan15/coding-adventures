          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Latin for a roundabout way, then the Latin for to wander about."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ductor, ductōris",
          "segments": [
            {
              "kind": "speech",
              "text": "ductor, ductōris — \"a leader, one who leads the way; a commander\"."
            },
            {
              "kind": "speech",
              "text": "Ductor viātōrēs per montēs dūcit. The leader takes the travellers through the mountains."
            },
            {
              "kind": "speech",
              "text": "Third declension, masculine: ductor, ductōris m., from dūcō 'to lead'. Dux itineris is the usual phrase for a guide."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ductor is built on dūcō 'to lead' with the suffix -tor 'one who' (EtymDB; Lewis & Short). English conductor comes from a compound of the same verb."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
            }
          ]
        },
