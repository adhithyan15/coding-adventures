      ],
      "sourceHash": "fnv1a64:5fd0f5a16fd07ee6",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new word: what did sarpaḥ mean?"
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: दधि",
          "segments": [
            {
              "kind": "speech",
              "text": "दधि (dadhi) — \"curd\"."
            },
            {
              "kind": "speech",
              "text": "दधि (dadhi) is curd — दुग्धम् set thick, the dahī of every kitchen in India."
            },
            {
              "kind": "speech",
              "text": "The word is a doubled thing, da-dh-i. MW files it with the doubled form of dhā, \"to set, to place\", which would make curd the milk that has been set."
            },
            {
              "kind": "speech",
              "text": "Hindi dahī, Marathi dahī, Gujarati dahī — the word barely moved."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "EtymDB traces dadhi to a Proto-Indo-European word for milk, so the \"set milk\" reading is MW's, not the only one. It lives on as Hindi dahī (CDIAL 6146)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "Milk, set thick."
            }
          ]
        },
        {
          "index": 4,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
