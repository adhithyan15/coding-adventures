          "segments": [
            {
              "kind": "speech",
              "text": "auparavant — \"before, previously\"."
            },
            {
              "kind": "speech",
              "text": "Elle est médecin; auparavant, elle était professeur. She is a doctor; before that, she was a teacher."
            },
            {
              "kind": "speech",
              "text": "An adverb that stands alone. Before a noun, French uses avant."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "auparavant is built from au, par and avant; avant is inherited from Late Latin abante, built on Latin ante \"before\" (Lewis & Short)."
            }
          ]
        },
