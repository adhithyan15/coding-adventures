        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: сапоги",
          "segments": [
            {
              "kind": "speech",
              "text": "сапоги (sapogí) — \"boots\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "сапоги (sapogí) is the plural of сапог, \"a boot\", Old Church Slavonic sapogŭ. Vasmer reports the usual link with сопеть, \"to wheeze\", through \"a pipe\" and so \"a boot shaft\"; Trubachev, in a note, takes it from early Bulgar or Turkic sapag, \"a boot with a shaft\", from a word for \"stem\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for this chapter."
            }
          ]
