        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: die Großmutter",
          "segments": [
            {
              "kind": "speech",
              "text": "die Großmutter — \"a grandmother\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Großmutter is the word for \"great, big\" + Mutter: a \"great mother\", modelled on French grand-mère. The \"great\" word from Old High German grōz from Proto-Germanic grautaz. (EtymDB 2.1)."
            }
          ]
        },
        {
