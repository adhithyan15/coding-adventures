        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: носилки",
          "segments": [
            {
              "kind": "speech",
              "text": "носилки (nosílki) — \"a stretcher\"."
            },
            {
              "kind": "speech",
              "text": "Раненого несли на носилках. Ránenovo neslí na nosílkakh. The wounded man was carried on a stretcher."
            },
            {
              "kind": "speech",
              "text": "Plural only: носилки (nosílki), genitive носилок."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "носилки (nosílki) is built on носить \"to carry\", which is inherited from Proto-Slavic nositi, from PIE h₁neḱ- \"to carry\" (EtymDB)."
            }
          ]
        },
        {
