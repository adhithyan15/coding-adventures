        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: der Wettkampf",
          "segments": [
            {
              "kind": "speech",
              "text": "der Wettkampf — \"competition, contest\"."
            },
            {
              "kind": "speech",
              "text": "Beim Wettkampf war sie sehr nervös. She was very nervous at the competition."
            },
            {
              "kind": "speech",
              "text": "Plural: die Wettkämpfe. For sport; a general contest is der Wettbewerb."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Wettkampf is built on Wette \"bet\", inherited from Old High German wetti, and Kampf \"fight\", which came through Old High German kampf from Latin campus \"field\" (EtymDB)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
