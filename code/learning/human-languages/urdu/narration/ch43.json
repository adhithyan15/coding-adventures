              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Urdu for a father, then the Urdu for dad."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: امی",
          "segments": [
            {
              "kind": "speech",
              "text": "امی — ammī — \"mum\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "امی (ammī) is the fond form of ammā, \"mother\", which CDIAL lists under Sanskrit ambā, \"mother\" (CDIAL 574). CDIAL lists ammā, not ammī."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for this chapter."
            }
          ]
        },
