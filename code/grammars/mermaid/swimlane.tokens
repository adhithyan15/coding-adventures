# @version 1
# Mermaid 11.16.1 Swimlane line grammar.
case_sensitive: false
skip:
  COMMENT = /[ \t]*%%[^\r\n]*/
NEWLINE = /\r?\n/
HEADER = /swimlane-beta(?:[ \t]+(?:TB|TD|BT|LR|RL))?[ \t]*/
TITLE_LINE = /[ \t]*title[ \t]+[^\r\n]+/
ACC_TITLE_LINE = /[ \t]*accTitle:[ \t]*[^\r\n]+/
ACC_DESCR_LINE = /[ \t]*accDescr:[ \t]*[^\r\n]+/
SUBGRAPH_LINE = /[ \t]*subgraph[ \t]+[^\r\n]+/
END_LINE = /[ \t]*end[ \t]*/
CLICK_LINE = /[ \t]*click[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]+[^\r\n]+/
CLASS_DEF_LINE = /[ \t]*classDef[ \t]+[A-Za-z_][A-Za-z0-9_-]*[ \t]+[^;\r\n]+[ \t]*;?/
CLASS_LINE = /[ \t]*class[ \t]+[A-Za-z_][A-Za-z0-9_,]*[ \t]+[A-Za-z_][A-Za-z0-9_,-]*[ \t]*;?/
STYLE_LINE = /[ \t]*style[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]+[^\r\n]+/
CONTINUATION_LINE = /[ \t]*(?:<-.->|<-->|<==>|o--o|x--x|o--x|x--o|o-->|x-->|-.->|-->|---|==>|--o|--x)[^\r\n]+/
EDGE_LINE = /[ \t]*[A-Za-z_][^\r\n]*(?:<-.->|<-->|<==>|o--o|x--x|o--x|x--o|o-->|x-->|-.->|-->|---|==>|--o|--x)[^\r\n]+/
DECORATED_NODE_LINE = /[ \t]*[A-Za-z_][A-Za-z0-9_]*[^\r\n]*:::[A-Za-z_][A-Za-z0-9_-]*(?:::[A-Za-z_][A-Za-z0-9_-]*)*[ \t]*/
NODE_LINE = /[ \t]*[A-Za-z_][A-Za-z0-9_]*(?:\(\(\([^\r\n]*\)\)\)|\(\([^\r\n]*\)\)|\(\[[^\r\n]*\]\)|\[\[[^\r\n]*\]\]|\[\([^\r\n]*\)\]|\{\{[^\r\n]*\}\}|>[^\r\n]*\]|\([^\r\n]*\)|\[[^\r\n]*\]|\{[^\r\n]*\}|@\{[^\r\n}]+\})?(?:::[A-Za-z_][A-Za-z0-9_-]*)*[ \t]*/
