          "segments": [
            {
              "kind": "speech",
              "text": "l'évidence — \"the obvious, what is plain to see\"."
            },
            {
              "kind": "speech",
              "text": "Il faut se rendre à l'évidence: nous sommes perdus. We have to face the facts: we are lost."
            },
            {
              "kind": "speech",
              "text": "A false friend: l'évidence is what is plain to see; evidence in court is la preuve. Se rendre à l'évidence — to face the facts."
            }
          ]
        },
