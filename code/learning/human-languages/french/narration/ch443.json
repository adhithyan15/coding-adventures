          "title": "You'll want to know: l'égout",
          "segments": [
            {
              "kind": "speech",
              "text": "l'égout — \"the sewer, the drain\"."
            },
            {
              "kind": "speech",
              "text": "Après l'orage, les égouts sont pleins. After the storm the sewers are full."
            },
            {
              "kind": "speech",
              "text": "A masculine noun."
            }
          ]
        },
