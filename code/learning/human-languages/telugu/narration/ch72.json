      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: what did aṅgaḍi mean?"
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: డబ్బు",
          "segments": [
            {
              "kind": "speech",
              "text": "డబ్బు (ḍabbu) — \"money\"."
            },
            {
              "kind": "speech",
              "text": "డబ్బు (ḍabbu) is money. You have said it once already without being told what it was: డబ్బు (ḍabbu) లేదు, there is no money, turned up early as an example of how లేదు denies that a thing exists. Here is the word itself."
            },
            {
              "kind": "speech",
              "text": "It is a borrowing, from the name of a small copper coin, and it travelled across the region on the coin's back."
            },
            {
              "kind": "speech",
              "text": "It is blunt and it is not rude. Asking whether somebody has డబ్బు (ḍabbu) today is an ordinary question in an అంగడి (aṅgaḍi) where the account is settled by the month."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "Two. And one of them you had already used once."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
