          "type": "input",
          "title": "You'll want to know: peu à peu",
          "segments": [
            {
              "kind": "speech",
              "text": "peu à peu — \"little by little\"."
            },
            {
              "kind": "speech",
              "text": "Peu à peu, la ville s'est réveillée. Little by little, the town woke up."
            },
            {
              "kind": "speech",
              "text": "The same as petit à petit."
            }
          ]
