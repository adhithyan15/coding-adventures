        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: bañarse",
          "segments": [
            {
              "kind": "speech",
              "text": "bañarse — \"to have a swim; to have a bath\"."
            },
            {
              "kind": "speech",
              "text": "Nos bañamos en el mar por la mañana. We swim in the sea in the morning."
            },
            {
              "kind": "speech",
              "text": "At the beach, bañarse is to go in the water, not to swim lengths."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "bañarse is built on baño \"bath\", which is inherited from Latin balneum \"a bath\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
