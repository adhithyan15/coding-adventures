            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Latin for early, then the Latin for a little while ago."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: initium, initiī",
          "segments": [
            {
              "kind": "speech",
              "text": "initium, initiī — \"a beginning\"."
            },
            {
              "kind": "speech",
              "text": "Initium fābulae laetum erat, fīnis trīstis. The beginning of the story was happy, the end sad."
            },
            {
              "kind": "speech",
              "text": "Neuter, 2nd declension. Initiō: at the start. English initial."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "initium is built on ineō, \"to go in, to begin\", from in and eō, \"to go\" (EtymDB): the going-in. English initial and initiate come from it."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
