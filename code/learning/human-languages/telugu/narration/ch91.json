                "built from"
              ],
              "columns": 2,
              "rowCount": 2,
              "utterances": [
                "word: ఇంటికి. built from: house + -కి.",
                "word: ఎక్కడికి? (ekkaḍiki?) built from: where + -కి."
              ]
            },
            {
              "kind": "speech",
              "text": "The same -కి as నాకు: a direction, to a place or to a person."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
