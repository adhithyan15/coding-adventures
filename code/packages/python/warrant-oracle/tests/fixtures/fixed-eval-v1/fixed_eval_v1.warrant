  claim c_sh_i16:
    forall a: I16, n: Nat. op_sh_i16(a, n) == (shl(a, n), shr(a, n), rotl(a, n), rotr(a, n), bit(a, n), sar(a, n))
  claim c_wrap_i16:
    forall a: I16. op_wrap_i16(a) == wrap_i16(a)
  claim c_try_i16:
    forall a: I16. op_try_i16(a) == try_i16(a)
  claim c_widen_i16:
    forall a: I16. op_widen_i16(a) == widen_i16(a)
  claim c_rt_i16:
    forall a: I16. op_rt_i16(a) == rt_i16(a)
  claim c_fb_i16:
    forall b: Bytes<2>. op_fb_i16(b) == fb_i16(b)
  claim c_bin_i32:
    forall a: I32, b: I32. op_bin_i32(a, b) == bin_i32(a, b)
  claim c_div_i32:
    forall a: I32, b: I32. op_div_i32(a, b) == div_i32(a, b)
  claim c_un_i32:
    forall a: I32. op_un_i32(a) == un_i32(a)
  claim c_sh_i32:
    forall a: I32, n: Nat. op_sh_i32(a, n) == (shl(a, n), shr(a, n), rotl(a, n), rotr(a, n), bit(a, n), sar(a, n))
  claim c_wrap_i32:
    forall a: I32. op_wrap_i32(a) == wrap_i32(a)
  claim c_try_i32:
    forall a: I32. op_try_i32(a) == try_i32(a)
  claim c_widen_i32:
    forall a: I32. op_widen_i32(a) == widen_i32(a)
  claim c_rt_i32:
    forall a: I32. op_rt_i32(a) == rt_i32(a)
  claim c_fb_i32:
    forall b: Bytes<4>. op_fb_i32(b) == fb_i32(b)
  claim c_bin_i64:
    forall a: I64, b: I64. op_bin_i64(a, b) == bin_i64(a, b)
  claim c_div_i64:
    forall a: I64, b: I64. op_div_i64(a, b) == div_i64(a, b)
  claim c_un_i64:
    forall a: I64. op_un_i64(a) == un_i64(a)
  claim c_sh_i64:
    forall a: I64, n: Nat. op_sh_i64(a, n) == (shl(a, n), shr(a, n), rotl(a, n), rotr(a, n), bit(a, n), sar(a, n))
  claim c_wrap_i64:
    forall a: I64. op_wrap_i64(a) == wrap_i64(a)
  claim c_try_i64:
    forall a: I64. op_try_i64(a) == try_i64(a)
  claim c_widen_i64:
    forall a: I64. op_widen_i64(a) == widen_i64(a)
  claim c_rt_i64:
    forall a: I64. op_rt_i64(a) == rt_i64(a)
  claim c_fb_i64:
    forall b: Bytes<8>. op_fb_i64(b) == fb_i64(b)
  claim c_wr_u8:
    forall a: U8, b: U8. op_wr_u8(a, b) == wr_u8(a, b)
  claim c_wr_i8:
    forall a: I8, b: I8. op_wr_i8(a, b) == wr_i8(a, b)
  claim c_wr_u16:
    forall a: U16, b: U16. op_wr_u16(a, b) == wr_u16(a, b)
  claim c_wr_u32:
    forall a: U32, b: U32. op_wr_u32(a, b) == wr_u32(a, b)
  claim c_maxes:
    op_maxes() == maxes()
  claim c_mins:
    op_mins() == mins()
  claim c_nat_div:
    forall a: Nat, b: Nat. op_nat_div(a, b) == nat_div(a, b)
  claim c_int_div:
    forall a: I8, b: I8. op_int_div(a, b) == int_div(a, b)
  claim c_at_dyn:
    forall b: Bytes, i: Nat. op_at_dyn(b, i) == at_dyn(b, i)
  claim c_at_fixed:
    forall b: Bytes<2>, i: Nat. op_at_fixed(b, i) == at_fixed(b, i)
  claim c_at_int:
    forall b: Bytes<2>, n: Nat. op_at_int(b, n) == at_int(b, n)

  -- claims: the shift-count rule (D26, R10) ------------------------------------------------
  claim c_sel_shl:
    forall a: U8, n: Nat. op_sel(a, n) == shl(a, n)
  claim c_sel_shr:
    forall a: U8, n: Nat. op_sel(a, n) == shr(a, n)
  claim c_sel_sar:
    forall a: I8, n: Nat. op_sel_s(a, n) == sar(a, n)
  claim c_sel_rotl:
    forall a: U8, n: Nat. op_sel(a, n) == rotl(a, n)
  claim c_sel_rotr:
    forall a: U8, n: Nat. op_sel(a, n) == rotr(a, n)
  claim c_sel_bit:
    forall a: U8, n: Nat. op_sel_bool(a, n) == bit(a, n)
  claim c_sel_in_tuple:
    forall a: U8, n: Nat. op_sel_pair(a, n) == (shl(a, n), a)
  claim c_sel_in_subject_arg:
    forall a: U8, n: Nat. op_sel_arg(shl(a, n)) == a
  claim c_sel_parenthesised:
    forall a: U8, n: Nat. op_sel(a, n) == shl(a, (n))
  claim c_nosel_expr:
    forall a: U8, n: Nat. op_sel(a, n) == shl(a, len(take(b"0102030405", n)))
  claim c_nosel_model:
    forall a: U8, n: Nat. op_sel(a, n) == m_sel(a, n)
  claim c_nosel_tuple_binder:
    forall t: (U8,Nat). op_sel_t(t.0, t.1) == shl(t.0, t.1)
  claim c_sel_one_of_two:
    forall n: Nat, k: Nat. op_sel_k(n, k) == shl(1u8, n)
  claim c_nosel_admit:
    forall a: U8, n: Nat | bit(a, n). op_sel(a, n) == a
  claim c_sel_and_admit:
    forall a: U8, n: Nat | bit(a, n). op_sel(a, n) == shl(a, n)
  claim c_sel_in_arm:
    forall n: Nat, r: Result<U8,FixedError>. match r with Ok(x) -> op_sel_arm(x, n) == shr(x, n) | Err(_) -> true

  -- claims for the faults (D27): fixed-width results, Bytes, Bytes<N>, Result of each ----------
  claim c_x_u8:
    forall a: U8. op_x_u8(a) == a
  claim c_x_i16:
    forall a: I16. op_x_i16(a) == a
  claim c_x_i32:
    forall a: I32. op_x_i32(a) == a
  claim c_x_u64:
    forall a: U64. op_x_u64(a) == a
  claim c_x_i64:
    forall a: I64. op_x_i64(a) == a
  claim c_eq_u64:
    forall a: U64, b: U64. op_eq_u64(a, b) == (a == b)
  claim c_eq_two:
    forall a: U64, f: Bool, b: U64. op_eq_two(a, f, b) == (a == b)
  claim c_bytes2:
    forall d: Bytes<2>. op_bytes2(d) == d
  claim c_bytes:
    forall d: Bytes. op_bytes(d) == d
  claim c_r2:
    forall d: Bytes<2>. op_r2(d) == Ok(d)
  claim c_r:
    forall d: Bytes. op_r(d) == (if len(d) == 2 then Ok(d) else Err(FixedError.Bad))
  claim c_rfix:
    forall a: U8. op_rfix(a) == Ok(a)
  claim c_be32:
    forall a: U32. op_be32(a) == be_bytes(a)

  -- examples: signed values and wide values in TFV, a tuple of built-ins, a Bytes result -------
  example e_x_u8:
    op_x_u8(255u8) == 255u8
  example e_x_i16_negative:
    op_x_i16(-32768i16) == -32768i16
  example e_x_i32:
    op_x_i32(-1i32) == -1i32
  example e_x_u64:
    op_x_u64(18446744073709551615u64) == 18446744073709551615u64
  example e_x_i64:
    op_x_i64(-9223372036854775807i64) == -9223372036854775807i64
  example e_be32:
    op_be32(16909060u32) == b"01020304"
  example e_un_u8:
    op_un_u8(1u8) == (254u8, 1, 7, 0, b"01", b"01", 1)
  example e_sh_i8:
    op_sh_i8(-128i8, 1) == (0i8, 64i8, 1i8, 64i8, false, -64i8)
  example e_wrap_i8:
    op_wrap_i8(-1i8) == (255u8, 65535u16, 4294967295u32, 18446744073709551615u64, -1i8, -1i16, -1i32, -1i64)
  example e_at_fixed:
    op_at_fixed(b"0a14", 1) == 20u8
  example e_r2:
    op_r2(b"ffff") == Ok(b"ffff")

