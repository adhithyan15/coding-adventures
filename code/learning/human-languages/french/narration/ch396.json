              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *installer*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "installer, once more",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *installer*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "a sentence of your own with installer",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: a sentence of your own with *installer*]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say the French for to connect, then the French for to access, then say installer again",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say the French for to connect, then the French for to access, then say *installer* again]"
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What does installer mean? (\"To install; to set up\".) Say it once more."
            }
          ]
        }
