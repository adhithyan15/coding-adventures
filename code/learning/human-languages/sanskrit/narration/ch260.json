  "lessons": [
    {
      "id": "SA-C260-mam",
      "sequence": 15510,
      "title": "माम् (mām) — me, as the object",
      "headword": "माम्",
      "romanization": "mām",
      "gloss": "me, as the object",
      "script": "devanagari",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:2d176f9d5528098e",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Say सः पश्यति (saḥ paśyati), “he sees”. Keep the seeing verb. Now make the person seen be the speaker."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: माम्",
          "segments": [
            {
              "kind": "speech",
              "text": "माम् (mām) means “me” when I am the object of the action."
            },
            {
              "kind": "speech",
              "text": "सः माम् पश्यति। saḥ mām paśyati. He sees me."
            },
            {
              "kind": "speech",
              "text": "The verb still says who does the seeing. माम् (mām) names the person the seeing reaches."
            },
            {
              "kind": "speech",
              "text": "Whitney's Sanskrit Grammar §491 lists माम् (mām) as the independent accusative singular of the first-person pronoun. “Accusative” is the case label; “the object” is the job you can hear in this sentence."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "Taken Apart",
          "segments": [
            {
              "kind": "speech",
              "text": "As a grammatical form, माम् (mām) comes from the first-person pronoun paradigm; it is not a word from a separate lexical root. Whitney's Sanskrit Grammar §491 records it as the independent accusative singular. This lesson makes no deeper historical derivation claim."
            },
            {
              "kind": "speech",
              "text": "Source: Whitney, Sanskrit Grammar (1889), §491."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "“me” as the object — mām",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: “me” as the object — *mām*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "“he sees me” — saḥ mām paśyati",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: “he sees me” — *saḥ mām paśyati*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "the person seen is the speaker — mām",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: the person seen is the speaker — *mām*]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Someone sees the speaker. Which one-word object do you use? (माम्, mām.)"
            }
          ]
        }
      ]
    },
    {
      "id": "SA-C260-tvam",
