        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ثرثار",
          "segments": [
            {
              "kind": "speech",
              "text": "ثرثار — tharthār — \"talkative; a chatterbox\"."
            },
            {
              "kind": "speech",
              "text": "جارنا ثرثار ويتكلم ساعات. jārunā tharthār wa-yatakallamu sāʿāt. Our neighbour is talkative and talks for hours."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ثرثار (tharthār) goes with the verb tharthara, \"to chatter\"; its doubled shape, thar-thar, is usually said to echo endless talk, but the origin is not settled."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for describing what you lived and felt."
            }
          ]
        },
