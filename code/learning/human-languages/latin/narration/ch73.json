        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "puella is the feminine of puellus, \"a little boy\" (Lewis & Short), a diminutive of puer, \"a boy, a child\": so \"a little girl\"."
