          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 12,
              "perItem": false,
              "source": "[PAUSE 12s]"
            },
            {
              "kind": "speech",
              "text": "Write known ण and new थ (tha) once each. Say kāĩ and its meaning, then write क (ka) and independent ई (ī). Point to the known nasal dot in हां."
            }
          ]
        },
        {
