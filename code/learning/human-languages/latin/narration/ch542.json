        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: strigilis, strigilis",
          "segments": [
            {
              "kind": "speech",
              "text": "strigilis, strigilis — \"a strigil, scraper\"."
            },
            {
              "kind": "speech",
              "text": "Servus dorsum dominī strigile pūrgat. The slave cleans his master's back with a scraper."
            },
            {
              "kind": "speech",
              "text": "Feminine, third declension. After oil and sweat, bathers scraped their skin clean with this curved tool."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "strigilis is built, Lewis & Short says, on stringō \"to strip, graze\"; EtymDB compares Greek stlengis, so the exact history is not settled."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
