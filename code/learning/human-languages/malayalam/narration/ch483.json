            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "ā hōṭṭalile sēvanaṁ vaḷare nallatāyirunnu. — The service at that hotel was very good.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *ā hōṭṭalile sēvanaṁ vaḷare nallatāyirunnu.* — The service at that hotel was very good.]"
