              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *patrapravarttakan*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "enṟe ammāvan oru patrapravarttakan āṇŭ. — My uncle is a journalist.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *enṟe ammāvan oru patrapravarttakan āṇŭ.* — My uncle is a journalist.]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say the Malayalam for to applaud, then the Malayalam for to mention, then say patrapravarttakan again",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say the Malayalam for to applaud, then the Malayalam for to mention, then say *patrapravarttakan* again]"
            }
          ]
        },
