      "title": "打扫 (dǎsǎo) — to clean (a room); to sweep",
      "headword": "打扫",
      "romanization": "dǎsǎo",
      "gloss": "to clean (a room); to sweep",
      "script": "chinese",
      "modality": "voice",
      "derivedModality": "voice",
