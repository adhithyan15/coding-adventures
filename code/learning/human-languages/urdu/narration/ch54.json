        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: چاول",
          "segments": [
            {
              "kind": "speech",
              "text": "چاول — chāval — \"rice\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "چاول (chāval) is a tadbhava, a word inherited and reshaped by sound change. It comes from cāvala, \"husked rice\", a form CDIAL reconstructs from its descendants (CDIAL 4749). CDIAL suggests, with a \"possibly\", that it shares a non-Aryan origin with Sanskrit taṇḍula, \"rice\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for this chapter."
            }
          ]
