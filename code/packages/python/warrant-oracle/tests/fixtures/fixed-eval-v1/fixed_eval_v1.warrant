  claim c_try_u32:
    forall a: U32. op_try_u32(a) == try_u32(a)
  claim c_widen_u32:
    forall a: U32. op_widen_u32(a) == widen_u32(a)
  claim c_rt_u32:
    forall a: U32. op_rt_u32(a) == rt_u32(a)
  claim c_fb_u32:
    forall b: Bytes<4>. op_fb_u32(b) == fb_u32(b)
  claim c_bin_u64:
    forall a: U64, b: U64. op_bin_u64(a, b) == bin_u64(a, b)
  claim c_div_u64:
    forall a: U64, b: U64. op_div_u64(a, b) == div_u64(a, b)
  claim c_un_u64:
    forall a: U64. op_un_u64(a) == un_u64(a)
  claim c_sh_u64:
    forall a: U64, n: Nat. op_sh_u64(a, n) == (shl(a, n), shr(a, n), rotl(a, n), rotr(a, n), bit(a, n))
  claim c_wrap_u64:
