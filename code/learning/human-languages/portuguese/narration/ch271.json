        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ocorrer",
          "segments": [
            {
              "kind": "speech",
              "text": "ocorrer — \"to occur, to happen\"."
            },
            {
              "kind": "speech",
              "text": "O problema ocorreu durante a noite. The problem occurred during the night."
            },
            {
              "kind": "speech",
              "text": "Formal and frequent on the news; in speech, acontecer. Ocorre-me uma ideia — an idea occurs to me."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ocorrer was borrowed from Latin occurrere \"to run to meet, to come up\" (EtymDB), built from ob \"towards\" and currere \"to run\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
