    {
      "id": "ZH-W62-kuai-fast",
      "sequence": 5205,
      "title": "快 (kuài) — the upright heart, then guài",
      "headword": "快",
      "romanization": "kuài",
      "gloss": "快 — the upright heart, then guài",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:81905cae14e8fd41",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — the upright heart, then guài",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — the upright heart, then guài and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say kuài — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *kuài* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "想 大."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — xiǎng, dà",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *xiǎng*, *dà*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — the upright heart, then guài",
          "segments": [
            {
              "kind": "speech",
              "text": "快 (kuài)."
            },
            {
              "kind": "speech",
              "text": "Two pieces, left before right."
            },
            {
              "kind": "speech",
              "text": "The upright heart piece, three strokes: a short dot on the left, a short dot on the right, then a long vertical down between them: the heart piece from the foot of 想, standing upright."
            },
            {
              "kind": "speech",
              "text": "The right piece, four strokes, read guài: a horizontal that turns down at its right end, a long horizontal across, a long left-falling stroke from the top down through the bars, and a stroke falling to the right."
            },
            {
              "kind": "speech",
              "text": "3 + 4 = seven."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "快 (kuài), all seven, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 快, all seven, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many pieces in 快 (kuài)? (Two.) Which dot comes first? (The left one.) How many strokes on the right side? (Four.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 快 (kuài), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
