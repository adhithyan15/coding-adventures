        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ركب",
          "segments": [
            {
              "kind": "speech",
              "text": "ركب — rakiba — \"to ride, to get on (a vehicle)\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ركب (rakiba) is built on the native Arabic root r-k-b, \"to ride, to mount\" (Lane). Rakiba is the plain verb, \"he rode\"."
            }
          ]
        },
