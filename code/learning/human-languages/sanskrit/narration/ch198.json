        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: हरिणः",
          "segments": [
            {
              "kind": "speech",
              "text": "हरिणः — hariṇaḥ — \"a deer\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "hariṇa is built on hari, \"tawny, yellowish\", so the deer is \"the fawn-coloured one\" (MW). MW compares hari with English yellow. The word lives on as Hindi hiran (CDIAL 13982)."
            }
          ]
        },
