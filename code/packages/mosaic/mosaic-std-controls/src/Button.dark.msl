style Button {
  part button-root {
    background    : $foundation-color-accent ;
    color         : $foundation-color-text-dark ;
    border-color : $foundation-color-accent ;
    border-width : 1 ;
    border-radius: $foundation-radius-sm ;
    padding      : $foundation-space-sm ;
    font-size    : $foundation-font-body ;
    font-weight  : 600 ;
  }
}
