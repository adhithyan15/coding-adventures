        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: l'escalade",
          "segments": [
            {
              "kind": "speech",
              "text": "l'escalade — \"climbing\"."
            },
            {
              "kind": "speech",
              "text": "Je fais de l'escalade en salle le mercredi. I go indoor climbing on Wednesdays."
            },
            {
              "kind": "speech",
              "text": "Feminine. Faire de l'escalade — to climb (as a sport)."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "l'escalade was borrowed from Italian scalata (EtymDB), from scalare \"to climb\", built on scala \"ladder\", inherited from Latin scāla (Lewis & Short)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
