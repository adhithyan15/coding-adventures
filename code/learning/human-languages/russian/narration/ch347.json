        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: иными словами",
          "segments": [
            {
              "kind": "speech",
              "text": "иными словами (inými slovámi) — \"in other words\"."
            },
            {
              "kind": "speech",
              "text": "Он не ответил, иными словами, он против. On ne otvétil, inými slovámi, on prótiv. He did not answer; in other words, he is against it."
            },
            {
              "kind": "speech",
              "text": "The instrumental plural of иной \"other\" and слово \"word\". Другими словами means the same."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "иными словами (inými slovámi) is the instrumental plural of иной \"other\", the adjective behind иначе, and слово \"word\", inherited from Proto-Slavic slovo (EtymDB)."
            }
          ]
        },
