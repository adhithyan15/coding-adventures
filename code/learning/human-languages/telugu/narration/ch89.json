        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ఉద్యోగం",
          "segments": [
            {
              "kind": "speech",
              "text": "ఉద్యోగం (udyōgaṁ) — \"a job\"."
            },
            {
              "kind": "speech",
              "text": "మీ ఉద్యోగం (udyōgaṁ) ఏమిటి? — \"what is your job?\". It is built exactly like మీ పేరు ఏమిటి?, with the job where the name was."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "The second question of an introduction, on the frame of the first."
            }
          ]
        },
