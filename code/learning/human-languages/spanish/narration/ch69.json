        {
          "index": 1,
          "type": "grammar",
          "title": "Grammar Lens: the complete small chapter frame",
          "segments": [
            {
              "kind": "speech",
              "text": "wanting: quiero, quieres, quiere plus a known infinitive."
            },
            {
              "kind": "speech",
              "text": "ability: puedo, puedes, puede plus a known infinitive."
            },
            {
              "kind": "speech",
              "text": "the contrast: e becomes ie in the learned querer set; o becomes ue in the learned poder set."
            },
            {
              "kind": "speech",
              "text": "singular “our”: nuestro día, nuestra noche."
            },
            {
              "kind": "speech",
              "text": "Plural persons and plural possessive agreement remain deferred."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The words, taken apart — retrieve the history",
          "segments": [
            {
              "kind": "speech",
              "text": "querer continues Latin quaerere, “seek,” the family of query."
            },
            {
              "kind": "speech",
              "text": "poder continues the Latin ability family behind power and possible."
            },
            {
              "kind": "speech",
              "text": "stressed Latin e and o often opened into Spanish ie and ue."
            },
            {
              "kind": "speech",
              "text": "nuestro, nuestra continue Latin noster, “our.”"
            }
          ]
        },
