    {
      "id": "GE-C12-elf",
      "sequence": 302,
      "title": "elf — \"eleven\"",
      "headword": "elf",
      "romanization": "elf",
      "gloss": "eleven — and it is not irregular, it is a different rule",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:b84233c8a4814b22",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "You can count to ten. Both languages then do something odd for two numbers, and they do the same odd thing."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: elf",
          "segments": [
            {
              "kind": "speech",
              "text": "elf — \"eleven.\""
            },
            {
              "kind": "speech",
              "text": "Not einszehn. Not \"oneteen\" in English either. Eleven is the first of two numbers that refuse the pattern, in German and in English alike."
            }
          ]
        },
        {
          "index": 2,
          "type": "pronunciation",
          "title": "Sounds you'll need",
          "segments": [
            {
              "kind": "speech",
              "text": "herz-short-e — a short open e, the vowel of English bed."
            },
            {
              "kind": "speech",
              "text": "f-final — and a clean f to close."
            },
            {
              "kind": "speech",
              "text": "elf, one syllable, said as it looks. This is the rare German word an English reader can pronounce on sight."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "\"elf\"",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: \"elf\"]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "the two in order — \"zehn, elf\"",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: the two in order — \"zehn, elf\"]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "what it is not — \"not einszehn\"",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: what it is not — \"not einszehn\"]"
            },
            {
              "kind": "repeat",
              "times": 2,
              "source": "[REPEAT x2]"
            },
            {
              "kind": "speech",
              "text": "\"zehn, elf.\""
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Say \"eleven.\" (Elf.) Does it end in -zehn? (No.) Does English say \"oneteen\"? (No — eleven.) Next: the second of the two."
            }
          ]
        }
      ]
    },
    {
      "id": "GE-C12-zwoelf",
      "sequence": 303,
      "title": "zwölf — \"twelve\"",
      "headword": "zwölf",
      "romanization": "zwölf",
      "gloss": "twelve — the second and last number to refuse the pattern",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:f75ae1dfe2aa5698",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Short on the page, and three rules deep in the mouth. You own all three already."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: zwölf",
          "segments": [
            {
              "kind": "speech",
              "text": "zwölf — \"twelve.\""
            },
            {
              "kind": "speech",
              "text": "The second number to refuse the pattern, and the last. After this one German turns regular and stays regular."
            },
            {
              "kind": "speech",
              "text": "You can hear zwei inside it if you listen for the opening: zw- is the same start."
            }
          ]
        },
        {
          "index": 2,
          "type": "pronunciation",
          "title": "Sounds you'll need",
          "segments": [
            {
              "kind": "speech",
              "text": "z-ts — German z is ts."
            },
            {
              "kind": "speech",
              "text": "w-as-v — German w is a v, as on Winter and Wasser."
            },
            {
              "kind": "speech",
              "text": "umlaut-oe — and ö is the rounded vowel from schön: shape your lips for oh and say eh."
            },
            {
              "kind": "speech",
              "text": "So the word opens tsv- and runs tsvölf. Three rules, one syllable, nothing new."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "the opening alone — \"tsv\"",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: the opening alone — \"tsv\"]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "the vowel alone — lips for \"oh\", say \"eh\"",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: the vowel alone — lips for \"oh\", say \"eh\"]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "\"zwölf\"",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: \"zwölf\"]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "the pair — \"elf, zwölf\"",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: the pair — \"elf, zwölf\"]"
            },
            {
              "kind": "repeat",
              "times": 2,
              "source": "[REPEAT x2]"
            },
            {
              "kind": "speech",
              "text": "\"elf, zwölf.\""
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Say \"twelve.\" (Zwölf.) How does it open? (Tsv-.) Why? (z is ts, w is v.) Which number is hiding at the front? (Zwei.) Next: what both of them actually mean."
            }
          ]
        }
      ]
    },
    {
      "id": "GE-C12-lif",
      "sequence": 304,
      "title": "-lif — \"left over\"",
      "headword": "-lif",
      "romanization": "-lif",
      "gloss": "the ending that means \"left over\" — eleven is one left after your fingers run out",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:511ca126e366ba5f",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Two words that look like exceptions. They are not exceptions. They are an older rule, and it is a rule about hands."
            }
          ]
        },
        {
          "index": 1,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Both words are compounds, and both end in the same piece:"
            },
            {
              "kind": "table",
              "headers": [
                "word",
                "older form",
                "the pieces"
              ],
              "columns": 3,
              "rowCount": 2,
              "utterances": [
                "word: elf. older form: ainlif. the pieces: ain \"one\" + lif.",
                "word: zwölf. older form: twalif. the pieces: twa \"two\" + lif."
              ]
            },
            {
              "kind": "speech",
              "text": "And -lif means \"to leave, to remain.\" So elf is \"one left over\" and zwölf is \"two left over.\""
            }
          ]
        },
        {
          "index": 2,
          "type": "culture-pragmatics",
          "title": "Why it's said this way",
          "segments": [
            {
              "kind": "speech",
              "text": "Left over from what? From ten — from your ten fingers."
            },
            {
              "kind": "speech",
              "text": "You count along them, you reach zehn, you run out of hand, and there is one left. That is eleven. Not a number in a sequence but a remainder, named by people counting on the only calculator they had."
            },
            {
              "kind": "speech",
              "text": "And English says the identical thing. Eleven is ain-lif; twelve is twa-lif. Not similar words — the same two words, inherited side by side, the way Vater and father are. The Germanic twinning you have been tracking through the household and the meal reaches all the way into the counting."
            },
            {
              "kind": "speech",
              "text": "It also explains why the trick stops at two. Ten fingers leave room for one and two before the hands are hopeless, and after that a language needs a real rule."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "the two pieces of eleven — \"ain, lif\"",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: the two pieces of eleven — \"ain, lif\"]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "what the ending means — \"left over\"",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: what the ending means — \"left over\"]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "the whole idea — \"one left over from ten\"",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: the whole idea — \"one left over from ten\"]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "the English pair that says the same — \"eleven, twelve\"",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: the English pair that says the same — \"eleven, twelve\"]"
            },
            {
              "kind": "repeat",
              "times": 2,
              "source": "[REPEAT x2]"
            },
            {
              "kind": "speech",
              "text": "\"elf, zwölf — one left, two left.\""
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What does -lif mean? (Left over.) Left over from what? (Ten — your fingers.) So what is elf? (One left over.) Are eleven and twelve the same words? (Yes — inherited, not borrowed.) Next: both of them together."
            }
          ]
        }
      ]
    },
    {
      "id": "GE-C12-elf-zwoelf",
      "sequence": 305,
      "title": "Practice — one left, two left",
      "headword": "(practice)",
      "romanization": "(practice)",
      "gloss": "chapter payoff — two numbers that count what is left rather than counting on",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:f2dd116e7e863515",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "No new words. Two numbers, and the reason they look strange in both languages at once."
            }
          ]
        },
        {
          "index": 1,
          "type": "grammar",
          "title": "Grammar Lens: what the two are made of",
          "segments": [
            {
              "kind": "table",
              "headers": [
                "German",
                "is",
                "and means"
              ],
              "columns": 3,
              "rowCount": 2,
              "utterances": [
                "German: elf. is: ain + lif. and means: one left over.",
                "German: zwölf. is: twa + lif. and means: two left over."
              ]
            },
            {
              "kind": "speech",
              "text": "Two words, one ending, and the ending is a verb: to leave, to remain. Neither number was ever irregular — they were built by a rule that only had room to run twice."
            }
          ]
        },
        {
          "index": 2,
          "type": "culture-pragmatics",
          "title": "Why it's said this way",
          "segments": [
            {
              "kind": "speech",
              "text": "Left over from zehn, from ten fingers. A counting system built on hands has to say something when the hands run out, and what Germanic said was and one is left."
            },
            {
              "kind": "speech",
              "text": "English inherited both words unchanged, which is why eleven and twelve are equally odd there, and odd in exactly the same way. When two languages share an irregularity this precisely, they did not agree on it — they were one language when it was made."
            },
            {
              "kind": "speech",
              "text": "From the next number on, both of them turn regular and never break again."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "count the last three — \"zehn, elf, zwölf\"",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: count the last three — \"zehn, elf, zwölf\"]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "the opening of the second — \"tsv\"",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: the opening of the second — \"tsv\"]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "what each one means — \"one left over, two left over\"",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: what each one means — \"one left over, two left over\"]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "the English pair — \"eleven, twelve\"",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: the English pair — \"eleven, twelve\"]"
            },
            {
              "kind": "repeat",
              "times": 2,
              "source": "[REPEAT x2]"
            },
            {
              "kind": "speech",
              "text": "\"zehn, elf, zwölf.\""
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Say eleven and twelve. (Elf, zwölf.) What does the ending mean? (Left over.) Left over from what? (Zehn — ten fingers.) Why are the English words odd in the same way? (They are the same two words.) How many numbers does this rule cover? (Two — and then it stops.)"
            }
          ]
        }
      ]
    }
  ],
