  -- The most-general scheduler: a bitmap plus an oracle register `choice`. dispatch PROPOSES the
  -- thread the oracle names, VALIDATES it against the ready set, and DEFAULTS to Idle.
  record Impl(mask: U8, choice: U8)
  record AbsW(w: U8)
  record CfgN(v: U8)
  model dec(x: AbsW) -> Ready = (
    Ready(not (bit_and(x.w, 1u8) == 0u8), not (bit_and(x.w, 2u8) == 0u8), not (bit_and(x.w, 4u8) == 0u8),
          not (bit_and(x.w, 8u8) == 0u8), not (bit_and(x.w, 16u8) == 0u8), not (bit_and(x.w, 32u8) == 0u8),
          not (bit_and(x.w, 64u8) == 0u8), not (bit_and(x.w, 128u8) == 0u8)))
  model b2m(b: Bool, k: Nat) -> U8 = if b then shl(1u8, k) else 0u8
  model build(m: Ready) -> Impl = (
    Impl(bit_or(bit_or(bit_or(bit_or(bit_or(bit_or(bit_or(b2m(m.p0, 0), b2m(m.p1, 1)), b2m(m.p2, 2)), b2m(m.p3, 3)),
           b2m(m.p4, 4)), b2m(m.p5, 5)), b2m(m.p6, 6)), b2m(m.p7, 7)), 0u8))
  model inv_impl(s: Impl) -> Bool = true
  model cfg_n() -> CfgN = CfgN(8u8)
  model init() -> Impl = Impl(0u8, 0u8)
  model has(s: Impl, t: U8) -> Bool = not (bit_and(s.mask, shl(1u8, to_nat(t))) == 0u8)
  model insert_out(s: Impl, t: U8) -> Upd = (
    if t >= 8u8 then OutOfRange else (if has(s, t) then Unchanged else Changed))
  model insert_img(s: Impl, t: U8) -> Impl = (
    if t >= 8u8 then s else Impl(bit_or(s.mask, shl(1u8, to_nat(t))), s.choice))
  model remove_out(s: Impl, t: U8) -> Upd = (
    if t >= 8u8 then OutOfRange else (if has(s, t) then Changed else Unchanged))
  model remove_img(s: Impl, t: U8) -> Impl = (
    if t >= 8u8 then s else Impl(bit_and(s.mask, bit_not(shl(1u8, to_nat(t)))), s.choice))
  model proposal_ok(s: Impl) -> Bool = s.choice < 8u8 and has(s, s.choice)
  model dispatch_out(s: Impl) -> Pick = if proposal_ok(s) then Run(s.choice) else Idle
  model dispatch_img(s: Impl) -> Impl = (
    if proposal_ok(s) then Impl(bit_and(s.mask, bit_not(shl(1u8, to_nat(s.choice)))), s.choice) else s)
  model alpha_w(s: Impl) -> AbsW = AbsW(s.mask)
