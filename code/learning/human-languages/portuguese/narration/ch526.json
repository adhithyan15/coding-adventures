          "title": "You'll want to know: o episódio",
          "segments": [
            {
              "kind": "speech",
              "text": "o episódio — \"episode\"."
            },
            {
              "kind": "speech",
              "text": "Vi três episódios seguidos. I watched three episodes in a row."
            },
            {
              "kind": "speech",
              "text": "Also an incident: um episódio estranho."
