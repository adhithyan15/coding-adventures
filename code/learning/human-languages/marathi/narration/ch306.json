      "sequence": 17920,
      "title": "क्रमशः (kramaśaḥ) — step by step; gradually",
      "headword": "क्रमशः",
      "romanization": "kramaśaḥ",
      "gloss": "step by step; gradually",
      "script": "devanagari",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:8acd77c5cc9ddfac",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Marathi for over time, then the Marathi for to elapse."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: क्रमशः",
          "segments": [
            {
              "kind": "speech",
              "text": "क्रमशः — kramaśaḥ — \"step by step; gradually\"."
            },
            {
              "kind": "speech",
              "text": "नदीचं पाणी क्रमशः कमी झालं. nadīcaṁ pāṇī kramaśaḥ kamī jhālaṁ. The water in the river went down step by step."
            },
            {
              "kind": "speech",
              "text": "Formal; at the end of a serial story it means to be continued."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "क्रमशः (kramaśaḥ) is a tatsama, taken from Sanskrit kramaśas, 'gradually, by degrees' (Monier-Williams)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling what happened."
            }
          ]
        },
        {
          "index": 4,
