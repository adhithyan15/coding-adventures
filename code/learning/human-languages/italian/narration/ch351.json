        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: l'origine",
          "segments": [
            {
              "kind": "speech",
              "text": "l'origine — \"the origin\"."
            },
            {
              "kind": "speech",
              "text": "Qual è l'origine di questa tradizione? What is the origin of this tradition?"
            },
            {
              "kind": "speech",
              "text": "Avere origine da — to come from. Di origine italiana — of Italian origin."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "origine is a learned borrowing from Latin orīgō, orīginis \"beginning, source, birth\" (Lewis & Short), from orīrī \"to rise\", as the sun rises."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
