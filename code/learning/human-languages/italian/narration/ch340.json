        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: il dibattito",
          "segments": [
            {
              "kind": "speech",
              "text": "il dibattito — \"the debate\"."
            },
            {
              "kind": "speech",
              "text": "Stasera c'è un dibattito in televisione sulla scuola. Tonight there is a debate on television about schools."
            },
            {
              "kind": "speech",
              "text": "Un dibattito acceso — a heated debate."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "dibattito is built on dibattere \"to debate\", from dis- and battere \"to beat\", which is inherited from Latin battuere \"to beat, to strike\" (Lewis & Short). Ideas are knocked back and forth."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
