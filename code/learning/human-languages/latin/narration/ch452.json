          "segments": [
            {
              "kind": "speech",
              "text": "dēvius, dēvia, dēvium — \"off the road, out of the way; remote\"."
            },
            {
              "kind": "speech",
              "text": "Vīlla dēvia est; nēmō eam facile invenit. The country house is out of the way; nobody finds it easily."
            },
            {
              "kind": "speech",
              "text": "An adjective of three endings, from dē 'off' and via 'road'. English devious first meant 'off the main road'."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "dēvius is built from dē 'off, away from' and via 'road' (Lewis & Short). English devious comes from it, first in the sense 'out of the way'."
            }
          ]
        },
