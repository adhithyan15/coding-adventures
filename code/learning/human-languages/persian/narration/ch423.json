        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: پمپ بنزین",
          "segments": [
            {
              "kind": "speech",
              "text": "پمپ بنزین (pomp-e benzin) — \"a petrol station (US: gas station)\"."
            },
            {
              "kind": "speech",
              "text": "در این جاده پمپ بنزین کم است. Dar in jâdde pomp-e benzin kam ast. There are few petrol stations on this road."
            },
            {
              "kind": "speech",
              "text": "Literally 'petrol pump'. In speech also pomp benzin."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "pomp-e benzin is built from pomp 'pump', a European loan usually traced to French pompe, and benzin 'petrol', usually traced to French benzine. EtymDB does not list the compound."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
