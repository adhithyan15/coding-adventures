        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "gom kardan pairs gom, \"lost\", a native word usually traced to Middle Persian gum, with kardan, \"to make\": \"to make lost\". kardan, \"to do\", is an inherited verb, from Middle Persian kardan (EtymDB)."
            }
