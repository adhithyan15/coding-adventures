          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "cinghiale is usually traced to Late Latin singulāris, short for porcus singulāris 'the pig that lives alone', from singulāris 'alone, solitary' (Lewis & Short); it is inherited, worn down in speech."
            }
          ]
        },
