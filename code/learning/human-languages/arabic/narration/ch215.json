        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: هوية",
          "segments": [
            {
              "kind": "speech",
              "text": "هوية — hawiyya — \"an identity card\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "هوية (hawiyya) is built from the pronoun huwa, \"he\", with the abstract ending -iyya: \"he-ness\", usually explained as a coinage of the medieval philosophers for identity."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
