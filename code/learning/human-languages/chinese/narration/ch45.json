      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — one more bar over 大",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — one more bar over 大 and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say tiān — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *tiān* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "一 大."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — yī, dà",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *yī*, *dà*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — one more bar over 大",
          "segments": [
            {
              "kind": "speech",
              "text": "天 (tiān)."
            },
            {
              "kind": "speech",
              "text": "Two pieces your hand knows, top to bottom: 一, then 大."
            },
            {
              "kind": "speech",
              "text": "一, one stroke, a short horizontal at the top."
            },
            {
              "kind": "speech",
              "text": "大, three strokes: a longer horizontal, a left-falling stroke from above it, and a right-falling stroke."
            },
            {
              "kind": "speech",
              "text": "1 + 3 = four. Keep the top bar shorter than the one under it."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "天 (tiān), all four, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 天, all four, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Which two characters you know make 天 (tiān)? (一 and 大.) Which bar is longer? (The lower one.) How many strokes? (Four.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 天 (tiān), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
