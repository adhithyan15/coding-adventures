              "action": "SAY",
              "instruction": "ceḷi",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *ceḷi*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "it once more, slowly",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: it once more, slowly]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "maṇal, then ceḷi, and hear the two different l-sounds at the end",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *maṇal*, then *ceḷi*, and hear the two different l-sounds at the end]"
