          "type": "input",
          "title": "You'll want to know: o realizador",
          "segments": [
            {
              "kind": "speech",
              "text": "o realizador — \"(film) director\"."
            },
            {
              "kind": "speech",
              "text": "O realizador ganhou um prémio pelo filme. The director won a prize for the film."
            },
            {
              "kind": "speech",
              "text": "In Brazil: o diretor."
            }
          ]
        },
