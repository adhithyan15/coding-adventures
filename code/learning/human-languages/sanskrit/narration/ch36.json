        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: सर्वम्",
          "segments": [
            {
              "kind": "speech",
              "text": "सर्वम् (sarvam) — \"all, the whole of it\"."
            },
            {
              "kind": "speech",
              "text": "सर्वम् (sarvam) answers \"how much?\" with \"all of it\", and it can stand alone as that answer."
            },
            {
              "kind": "speech",
              "text": "Its cousins lean on whole rather than on every: Greek holos, behind holistic and catholic; Latin sollus, \"entire\", and salvus, \"safe and whole\", behind save, salvage and salute. सर्वम् (sarvam), holistic and salvage all start from one idea — nothing missing."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "A reply that says nothing has been left out."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
