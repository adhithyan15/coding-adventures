            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Urdu for friendship, then the Urdu for shame."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: پیچ کس",
          "segments": [
            {
              "kind": "speech",
              "text": "پیچ کس — pechkas — \"a screwdriver\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "پیچ کس (pechkas) is \"screw-turner\". It joins Persian pēch, \"a twist, a screw\", and kash, \"pulling, drawing\"."
            }
          ]
        },
        {
