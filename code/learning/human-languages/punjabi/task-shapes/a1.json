    },
    {
      "id": "ca-punjabi-assessment",
      "title": "Coding Adventures Punjabi Assessment Specification",
      "url": "https://github.com/adhithyan15/coding-adventures/blob/main/code/learning/human-languages/punjabi/assessment-spec.md",
      "published": "2026-08-21",
      "accessed": "2026-08-21"
    }
