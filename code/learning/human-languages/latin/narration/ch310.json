          "segments": [
            {
              "kind": "speech",
              "text": "mentior, mentīrī — \"to lie, to tell a lie\"."
            },
            {
              "kind": "speech",
              "text": "Servus mentītus est; nam pōculum ipse frēgerat. The slave lied, for he had broken the cup himself."
            },
            {
              "kind": "speech",
              "text": "mentior, mentīrī, mentītus sum, a deponent. Its noun mendācium, 'a lie', is taught."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "mentior is probably built, says Lewis & Short, on the root of mēns, \"mind\", with a first sense \"to invent, to make up\"; this is not certain."
            }
          ]
        },
