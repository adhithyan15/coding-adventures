          "segments": [
            {
              "kind": "speech",
              "text": "dirigirse — \"to head (for), to make your way; to speak to\"."
            },
            {
              "kind": "speech",
              "text": "Nos dirigimos a la salida. We are heading for the exit."
            },
            {
              "kind": "speech",
              "text": "Dirigirse a alguien — to address someone. The g becomes j: me dirijo."
            }
          ]
        },
