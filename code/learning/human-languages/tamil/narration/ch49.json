          "segments": [
            {
              "kind": "speech",
              "text": "சந்தோஷம் (santōṣam) — \"gladness\"."
            },
            {
              "kind": "speech",
              "text": "Sanskrit santoṣa, 'contentment', sitting beside the native magiḻcci you met when somebody was pleased to see you. Both are in daily use and neither has driven the other out — the same arrangement as nalam and sugam."
            },
            {
              "kind": "speech",
              "text": "santōṣam is what you reach for when you accept an invitation. On its own, in reply, it means \"gladly\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "Three, and the third one is an answer as much as a feeling."
            }
          ]
        },
