      "id": "TE-C94-pardon",
      "sequence": 3560,
      "title": "మన్నించండి (manniñcaṇḍi) — please pardon me",
      "headword": "మన్నించండి",
      "romanization": "manniñcaṇḍi",
      "gloss": "please pardon me",
      "script": "telugu",
      "modality": "voice",
      "derivedModality": "voice",
