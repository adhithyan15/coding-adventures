            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "purapālaka saṅghaṁ kotta rōḍlu vēsindi. — The municipality laid new roads.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *purapālaka saṅghaṁ kotta rōḍlu vēsindi.* — The municipality laid new roads.]"
