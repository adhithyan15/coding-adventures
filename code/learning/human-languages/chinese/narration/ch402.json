        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: chéngkè",
          "segments": [
            {
              "kind": "speech",
              "text": "chéngkè — \"passenger\"."
            },
            {
              "kind": "speech",
              "text": "huǒchēzhàn lǐ yǒu yìxiē chéngkè — There are a few passengers in the station."
            },
            {
              "kind": "speech",
              "text": "Its characters come later; for now it is a word for the ear."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "chéngkè is built from chéng 'to ride' and kè 'a guest', both inherited from Middle Chinese, zying and khaek (Guangyun, in Baxter's transcription), which glosses the first 'to drive', 'to mount' and 'to prevail'."
            }
          ]
        },
