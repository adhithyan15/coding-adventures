                "haupt"
              ],
              "feedback": {
                "correct": "Correct: Haupt is the inherited head-word retained in compounds.",
                "incorrect": "The inherited word is Haupt, as in Hauptstadt and Hauptbahnhof."
              }
            }
          ]
        }
      ]
    },
