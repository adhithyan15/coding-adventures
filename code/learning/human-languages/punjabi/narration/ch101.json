              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *huṇe*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "say huṇe",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: say *huṇe*]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say the Punjabi for every day, then the Punjabi for a date, then say huṇe again",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say the Punjabi for every day, then the Punjabi for a date, then say *huṇe* again]"
            }
          ]
        },
        {
          "index": 5,
