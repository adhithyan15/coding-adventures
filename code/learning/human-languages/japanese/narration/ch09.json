      "sourceHash": "fnv1a64:be3ef95ded5d9cf8",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 15,
              "perItem": false,
              "source": "[PAUSE 15s]"
            },
            {
              "kind": "speech",
              "text": "Write い, ち, and と. Add the dakuten to と and read the result do. Write め (me) once as a review pulse."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know",
          "segments": [
            {
              "kind": "speech",
              "text": "いちど (ichido) — i-chi-do — one time; once."
            },
            {
              "kind": "speech",
              "text": "The word is built transparently: ichi is “one,” and do counts one occurrence. All four visible marks are already yours: い + ち + と + ゛."
            },
            {
              "kind": "speech",
              "text": "Now join it to the previous word:"
            },
            {
              "kind": "speech",
              "text": "もういちど — mō ichido — one more time."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "speech",
              "text": "Hear i | chi | do without looking."
            },
            {
              "kind": "speech",
              "text": "Write いちど (ichido) from the three morae."
            },
            {
              "kind": "speech",
              "text": "Read もういちど, keeping the two beats in もう (mō)."
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "speech",
              "text": "Circle the dakuten. It changes the final mora, not the first two."
            },
            {
              "kind": "speech",
              "text": "Source: Japan Foundation Irodori Starter lesson 2, pp. 1–3."
            },
            {
              "kind": "activity",
              "scored": true,
              "id": "JA-C09-ichido-dictation",
              "prompt": "From the heard morae i | chi | do, write once in hiragana.",
              "assesses": [
                "JA-LEX-ICHIDO"
              ],
              "responseSeconds": 15,
              "acceptedResponses": [
                "いちど",
                "いちど。"
              ],
              "feedback": {
                "correct": "Right: いちど, with dakuten turning と into ど.",
                "incorrect": "Build it from known signs: い + ち + ど."
              }
            }
          ]
        }
      ]
    },
