        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: دوران",
          "segments": [
            {
              "kind": "speech",
              "text": "دوران (dowrân) — \"an era, a period\"."
            },
            {
              "kind": "speech",
              "text": "در دوران جنگ زندگی سخت بود. Dar dowrân-e jang zendegi sakht bud. During the war years life was hard."
            },
            {
              "kind": "speech",
              "text": "Dowrân-e kudaki \"childhood\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "dowrân is usually traced to Arabic dawarān, \"a turning, a cycle\"; EtymDB lists no entry."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
