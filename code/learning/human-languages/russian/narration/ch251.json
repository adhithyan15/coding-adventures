        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "бык (byk) from Proto-Slavic bykŭ — inherited, from a root for a deep sound. Vasmer relates it to Latvian bucêt, \"to boom\", and Lithuanian bukti, \"to low\": the bull as the bellower."
            }
          ]
        },
