        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: सलाह",
          "segments": [
            {
              "kind": "speech",
              "text": "सलाह — salāh — \"advice\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "सलाह (salāh) is a loan from Arabic ṣalāḥ, \"soundness, what is right\", which reached Hindi through Persian. Its Arabic root is ṣ-l-ḥ (Lane). Hindi uses it for advice."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
