          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "dirigirse is built on dirigir, a learned borrowing from Latin dīrigere \"to lay straight, to direct\" (EtymDB)."
            }
          ]
        },
