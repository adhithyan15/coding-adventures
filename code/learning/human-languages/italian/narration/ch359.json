          "segments": [
            {
              "kind": "speech",
              "text": "il turno — \"the shift; the turn\"."
            },
            {
              "kind": "speech",
              "text": "Questa settimana faccio il turno di notte. This week I am on the night shift."
            },
            {
              "kind": "speech",
              "text": "A turno — taking turns. È il tuo turno — it is your turn."
            }
          ]
        },
