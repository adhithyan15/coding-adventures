          "segments": [
            {
              "kind": "speech",
              "text": "le menteur — \"liar; lying\"."
            },
            {
              "kind": "speech",
              "text": "Ne le crois pas, c'est un menteur. Do not believe him, he is a liar."
            },
            {
              "kind": "speech",
              "text": "A woman is la menteuse. A lie is un mensonge."
            }
          ]
        },
