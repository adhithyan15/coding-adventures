          "type": "input",
          "title": "You'll want to know: frequentemente",
          "segments": [
            {
              "kind": "speech",
              "text": "frequentemente — \"frequently, often\"."
            },
            {
              "kind": "speech",
              "text": "Vou frequentemente ao cinema. I often go to the cinema."
            },
            {
              "kind": "speech",
              "text": "Muitas vezes is the everyday way to say it."
            }
          ]
        },
