              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Latin for geometry, then the Latin for a first principle."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: abacus, abacī",
          "segments": [
            {
              "kind": "speech",
              "text": "abacus, abacī — \"a counting board; a sideboard\"."
            },
            {
              "kind": "speech",
              "text": "Puer in abacō numerōs computat. The boy works out sums on the counting board."
            },
            {
              "kind": "speech",
              "text": "abacus, abacī m., borrowed from Greek abax, a board. Pebbles moved along lines on the board. English abacus."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "abacus was borrowed from Greek abax, abakos \"a board, a counting table\" (EtymDB; Lewis & Short). English took it over as abacus."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
