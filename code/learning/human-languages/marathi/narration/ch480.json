            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Marathi for a cell, then the Marathi for the innermost heart."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: तब्येत",
          "segments": [
            {
              "kind": "speech",
              "text": "तब्येत — tabyet — \"one's health\"."
            },
            {
              "kind": "speech",
              "text": "आजीची तब्येत आता बरी आहे. ājīcī tabyet ātā barī āhe. Grandmother's health is better now."
            },
            {
              "kind": "speech",
              "text": "Feminine."
            },
            {
              "kind": "speech",
              "text": "तब्येत (tabyet) बरी नाही, I am unwell; तब्येतीची काळजी, care of one's health."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "तब्येत (tabyet) is a loan from Persian tabiyat, \"nature, health\", usually traced to Arabic."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for describing what you lived and felt."
            }
          ]
        },
