{
  "schema_version": 1,
  "id": "diff-selection/transitive-package-change",
  "domain": "diff_selection",
  "summary": "A package-local source change selects the package, its dependents, and prerequisite-only closure.",
  "platforms": [
    "darwin",
    "linux",
    "windows"
  ],
  "capabilities": [
    "diff_selection"
  ],
  "workspace": {
