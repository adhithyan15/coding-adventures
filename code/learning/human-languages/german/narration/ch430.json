        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: die Wanze",
          "segments": [
            {
              "kind": "speech",
              "text": "die Wanze — \"the bedbug; a hidden microphone\"."
            },
            {
              "kind": "speech",
              "text": "Im Bett waren Wanzen, und er hat schlecht geschlafen. There were bedbugs in the bed, and he slept badly."
            },
            {
              "kind": "speech",
              "text": "Plural: die Wanzen. A hidden microphone is also eine Wanze."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Wanze goes back to Old High German wantlūs 'wall louse' (EtymDB), from Wand 'wall' and Laus 'louse'."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
