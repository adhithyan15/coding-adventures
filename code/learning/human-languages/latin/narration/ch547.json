      "id": "LA-C547-imago",
      "sequence": 28970,
      "title": "imāgō, imāginis — an image, likeness, portrait",
      "headword": "imāgō, imāginis",
      "romanization": "imāgō, imāginis",
      "gloss": "an image, likeness, portrait",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
