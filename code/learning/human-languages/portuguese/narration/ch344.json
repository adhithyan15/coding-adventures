          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "juízo comes from Latin iūdicium \"a judicial investigation, a judgement\" (Lewis & Short), built on iūdex \"judge\"; Spanish juicio and Italian giudizio are its cousins (EtymDB)."
            }
          ]
        },
