# Perl 5.44.0 tokens: LANG81-style print-arithmetic subset only.
# @version 1
# PARTIAL: this does not lex all Perl 5.44.0 source.
# Evidence: https://github.com/Perl/perl5/blob/v5.44.0/pod/perlop.pod
# and https://github.com/Perl/perl5/blob/v5.44.0/pod/perlfunc.pod

# INT bound (LANG84 4c, read 2026-10-20 from tag object 51698a37efd1d012d1c148bc93adfda0147ae6e1,
# commit e634cc838fb1785dfafb5d13b52807ea16b5c52c): toke.c 81043823c9efeac3d5ca2dc15a1c6d670fa501b9
# line 13056, scan_num's decimal path, stops at C_ARRAY_END(PL_tokenbuf) - 6
# and croaks "Number too long"; parser.h 8333adb7a93b05a0be1a2ff70fab7f3a83b1de21
# line 116 sizes tokenbuf[PERL_IDENTIFIER_LENGTH] = 256 * MAX_UNICODE_UTF8_BYTES,
# and utf8.h 9583e0af4dfa5f2fdcc0ac525ee7075e073d539e line 576
# makes MAX_UNICODE_UTF8_BYTES UNISKIP_BY_MSB_(20) = 4 on ASCII platforms.
# So 1018 decimal digits lex and the 1019th croaks (5.38's tokenbuf was 256).
INT       = /0|[1-9][0-9]{0,1017}/
NAME      = /[a-zA-Z_][a-zA-Z0-9_]*/
PLUS      = "+"
DECREMENT = "--"
MINUS     = "-"
STAR      = "*"
LPAREN    = "("
RPAREN    = ")"
SEMICOLON = ";"

skip:
  WHITESPACE = /[ \t\r\n]+/
