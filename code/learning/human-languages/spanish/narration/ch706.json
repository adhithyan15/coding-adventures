        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: asustar",
          "segments": [
            {
              "kind": "speech",
              "text": "asustar — \"to frighten, to scare\"."
            },
            {
              "kind": "speech",
              "text": "El perro me asustó. The dog frightened me."
            },
            {
              "kind": "speech",
              "text": "Asustarse is to get scared: me asusté."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "asustar is built on susto \"fright\" with the prefix a-. Where susto itself comes from, the origin is not settled; it may be an expressive word."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
