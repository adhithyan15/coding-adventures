              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: 我会说汉语 — *wǒ huì shuō Hànyǔ* — I can speak Chinese.]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say sījī, then say a driver can drive: sījī huì kāichē",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *sījī*, then say a driver can drive: *sījī huì kāichē*]"
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
