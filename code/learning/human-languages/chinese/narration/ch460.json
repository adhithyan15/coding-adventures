        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: yùmèn",
          "segments": [
            {
              "kind": "speech",
              "text": "yùmèn — \"down; gloomy\"."
            },
            {
              "kind": "speech",
              "text": "wǒ bìng le yí ge xīngqī hěn yùmèn — I've been ill for a week, and I'm feeling really down."
            },
            {
              "kind": "speech",
              "text": "Its characters come later; for now it is a word for the ear."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "yùmèn is built from yù 'dense' and mèn 'vexed', both inherited from Middle Chinese, 'jut and mwonH (Guangyun, in Baxter's transcription), which glosses the first as thick and blocked and the second 'vexed'."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
