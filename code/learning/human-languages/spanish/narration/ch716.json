            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Spanish for to kiss, then the Spanish for passion."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: la lástima",
          "segments": [
            {
              "kind": "speech",
              "text": "la lástima — \"pity, shame\"."
            },
            {
              "kind": "speech",
              "text": "¡Qué lástima que no vengas! What a shame you are not coming!"
            },
            {
              "kind": "speech",
              "text": "¡Qué lástima! — What a pity! Qué lástima que takes the subjunctive."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "lástima is built on lastimar \"to hurt\", which comes from a spoken Latin blastemāre, Latin blasphēmāre \"to insult\", from Greek blasphēmía (EtymDB). The sense moved from insulting to hurting to pity."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
            }
          ]
        },
        {
          "index": 4,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
