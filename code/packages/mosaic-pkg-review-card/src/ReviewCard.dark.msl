// ReviewCard.dark.msl - dark review-card theme.

style ReviewCard {
  part review-card {
    background    : "#16213e" ;
    border-width  : 1 ;
    border-color  : "#2a3a5e" ;
    border-radius : 8 ;
    padding       : 24 ;
  }

  part deck-name {
    color       : "#8899aa" ;
    font-size   : 13 ;
    font-weight : 600 ;
  }

  part prompt-panel {
    background    : "#1a1a2e" ;
    border-width  : 1 ;
    border-color  : "#2a3a5e" ;
    border-radius : 8 ;
    padding       : 18 ;
  }

  part prompt-label {
    color          : "#e94560" ;
    font-size      : 11 ;
    font-weight    : 700 ;
    padding-bottom : 8 ;
  }

  part prompt-text {
    color       : "#ffffff" ;
    font-size   : 24 ;
    font-weight : 600 ;
  }

  part answer-panel {
    background    : "#0f3460" ;
    border-width  : 1 ;
    border-color  : "#e94560" ;
    border-radius : 8 ;
    padding       : 18 ;
  }

  part answer-label {
    color          : "#ffb3c0" ;
    font-size      : 11 ;
    font-weight    : 700 ;
    padding-bottom : 8 ;
  }

  part answer-text {
    color       : "#e0ddd5" ;
    font-size   : 22 ;
    font-weight : 500 ;
  }

  part reveal-button {
    background    : "#e94560" ;
    border-width  : 1 ;
    border-color  : "#943040" ;
    border-radius : 6 ;
    color         : "#ffffff" ;
    font-weight   : 700 ;
    padding       : 10 ;
  }

  part rating-row {
    padding : 4 ;
  }

  part rating-again {
    background    : "#f87171" ;
    border-width  : 1 ;
    border-color  : "#991b1b" ;
    border-radius : 6 ;
    color         : "#1a1a2e" ;
    font-weight   : 700 ;
    padding       : 8 ;
  }

  part rating-hard {
    background    : "#fb923c" ;
    border-width  : 1 ;
    border-color  : "#9a3412" ;
    border-radius : 6 ;
    color         : "#1a1a2e" ;
    font-weight   : 700 ;
    padding       : 8 ;
  }

  part rating-good {
    background    : "#4ade80" ;
    border-width  : 1 ;
    border-color  : "#166534" ;
    border-radius : 6 ;
    color         : "#1a1a2e" ;
    font-weight   : 700 ;
    padding       : 8 ;
  }

  part rating-easy {
    background    : "#60a5fa" ;
    border-width  : 1 ;
    border-color  : "#1d4ed8" ;
    border-radius : 6 ;
    color         : "#1a1a2e" ;
    font-weight   : 700 ;
    padding       : 8 ;
  }

  part progress-label {
    color     : "#8899aa" ;
    font-size : 12 ;
  }
}
