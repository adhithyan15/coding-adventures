              "action": "SAY",
              "instruction": "ravivār",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *ravivār*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "ravivār, once more",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *ravivār*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "say ravivār",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: say *ravivār*]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say the Marathi for Friday, then the Marathi for Saturday, then say ravivār again",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say the Marathi for Friday, then the Marathi for Saturday, then say *ravivār* again]"
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What does रविवार (ravivār) mean? (\"Sunday\".) Say it once more."
            }
          ]
        }
      ]
    },
