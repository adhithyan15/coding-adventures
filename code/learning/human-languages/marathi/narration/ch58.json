              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *ekoṇīs* — nineteen]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "pandhrā soḷā satrā aṭhrā vīs — the run up to it, without looking",
              "spoken": true,
