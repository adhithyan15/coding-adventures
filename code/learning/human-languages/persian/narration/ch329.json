        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: انفجار",
          "segments": [
            {
              "kind": "speech",
              "text": "انفجار (enfejâr) — \"an explosion\"."
            },
            {
              "kind": "speech",
              "text": "صدای انفجار همه را بیدار کرد. Sedâ-ye enfejâr hame râ bidâr kard. The sound of the explosion woke everyone up."
            },
            {
              "kind": "speech",
              "text": "Enfejâr-e gâz \"a gas explosion\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "enfejâr is borrowed from Arabic infijār, \"explosion, bursting\" (EtymDB lists both the Arabic and the Persian word)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
