        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ratiō, ratiōnis",
          "segments": [
            {
              "kind": "speech",
              "text": "ratiō, ratiōnis — \"a reason, a way of thinking\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ratiō is built on ratus, \"reckoned\", the participle of reor, \"to reckon, to think\" (Lewis & Short): a reckoning. English reason comes from it through French."
            }
          ]
        },
