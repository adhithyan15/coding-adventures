          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "comprender from Latin comprehendere, \"to grasp, to seize\" (Lewis & Short): com-, \"together\", and prehendere, \"to take hold of\". To understand is to get a grip on a thing."
            }
          ]
        },
