# build-tool: deps=rust/conduit-capi
# The dependency declaration must be repeated here: the build tool reads the
# `deps=` directive out of the BUILD file it selects for the current platform,
# so a directive that lives only in BUILD is invisible on Windows and the
# rust/conduit-capi edge silently disappears from the graph.
( cd ../../rust/conduit-capi && cargo build --release ) && (where swift >/dev/null 2>/dev/null && ( copy ..\..\rust\target\release\conduit_capi.lib Sources\CConduit\ && swift test ) || echo Swift not available on this runner — conduit-capi built, skipping swift test)
