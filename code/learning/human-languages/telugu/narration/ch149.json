            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "red, to fly, to run, to sleep, to get up",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: red, to fly, to run, to sleep, to get up]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "to cook, to cut, to break, to send, to look for",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
