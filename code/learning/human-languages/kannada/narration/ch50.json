        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ನಾಡಿದ್ದು",
          "segments": [
            {
              "kind": "speech",
              "text": "ನಾಡಿದ್ದು (nāḍiddu) — \"the day after tomorrow\"."
            },
            {
              "kind": "speech",
              "text": "English needs four words for this. Kannada needs one, and keeps a matching one running the other way: ಮೊನ್ನೆ (monne), the day before yesterday."
            },
            {
              "kind": "speech",
              "text": "You can hear ನಾಳೆ, 'tomorrow', at the front of ನಾಡಿದ್ದು (nāḍiddu) — the two belong together, one step out and two steps out. A language that sows and marries by the calendar finds it worth keeping single words this far from today."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "Two: now, and the day after tomorrow."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
