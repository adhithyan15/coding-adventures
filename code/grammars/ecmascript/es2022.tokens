# ECMAScript 2022 (ES13) — Lexical Grammar
# @version 1
# @ecmascript_edition 2022
# source_ref: https://github.com/tc39/ecma262/tree/es2022
# source_sha: d711ba960cd12b7658d6bb26d7556e690290190c
# PARTIAL: the IIR path claims es-number-log only (LANG84 phase 6d; see releases.csv); this lexical pair predates LANG84 and is not yet audited clause by clause against the tagged spec text.
#
# ECMA-262, 13th Edition — June 2022
#
# ES2022 brings major class enhancements: public and private class fields,
# private methods, static initialization blocks, and the `d` regex flag.
# It also makes top-level `await` valid in modules.
#
# New features:
#
#   1. Class fields: declare properties directly in the class body
#        class Point { x = 0; y = 0; }
#      No more constructor-only property initialization.
#
#   2. Private class members: `#` prefix for truly private fields and methods
#        class Counter {
#          #count = 0;           // private field
#          #increment() {}       // private method
#          get value() { return this.#count; }
#        }
#      Private members are enforced at the language level — not a convention
#      like the `_` prefix. Accessing `obj.#count` outside the class is a
#      hard SyntaxError.
#
#   3. Static class features: static fields, static private, static blocks
#        class Config {
#          static defaultPort = 3000;         // static field
#          static #secret = loadSecret();     // static private field
#          static { /* complex init logic */ } // static block
#        }
#
#   4. `d` regex flag: match indices (hasIndices)
#      /pattern/d returns start/end indices for each capture group.
#
#   5. Top-level `await`: valid at the top level of ES modules
#      const data = await fetch(url);  // at module scope, not inside async fn
#
#   6. Ergonomic brand checks: `#field in obj` — use `in` with private names
#
#   7. Error.cause — runtime only
#   8. Array.prototype.at() — runtime only
#   9. Object.hasOwn() — runtime only
#
# Token changes from ES2021:
#   - Added: PRIVATE_NAME = /#[a-zA-Z_$][a-zA-Z0-9_$]*/
#   - Changed: REGEX flag set gains `d`

# ============================================================================
# Literals
# ============================================================================

NAME = /[a-zA-Z_$][a-zA-Z0-9_$]*/

# --- NEW IN ES2022: Private names ---
#
# Private names start with `#` and are scoped to the class body where they
# are declared. The `#` is part of the identifier — it is NOT a separate
# operator. `#foo` and `foo` are completely different names.
#
# Why `#` and not `private`? Because private fields need their own namespace.
# `this.#x` and `this.x` can coexist in the same class without conflict.
# The `#` prefix makes this visually clear and prevents accidental access.

PRIVATE_NAME = /#[a-zA-Z_$][a-zA-Z0-9_$]*/

# --- Numbers (with ES2021 numeric separators) ---

# Number literals (ES2021 numeric separators; see es2021.tokens for the full
# rule list): no separator after a leading `0`, none in legacy octal `017` or
# NonOctalDecimal `08`; a legacy octal takes no fraction or exponent; `5.` and
# `5.e1` are valid.
BIGINT_HEX = /0[xX][0-9a-fA-F](_?[0-9a-fA-F])*n/ -> BIGINT
BIGINT_BINARY = /0[bB][01](_?[01])*n/ -> BIGINT
BIGINT_OCTAL = /0[oO][0-7](_?[0-7])*n/ -> BIGINT
BIGINT_DECIMAL = /(0|[1-9](_?[0-9])*)n/ -> BIGINT

BINARY_NUMBER = /0[bB][01](_?[01])*/ -> NUMBER
OCTAL_NUMBER = /0[oO][0-7](_?[0-7])*/ -> NUMBER
HEX_NUMBER = /0[xX][0-9a-fA-F](_?[0-9a-fA-F])*/ -> NUMBER
FLOAT_NUMBER = /(0|[1-9](_?[0-9])*|0[0-7]*[89][0-9]*)\.([0-9](_?[0-9])*)?([eE][+-]?[0-9](_?[0-9])*)?/ -> NUMBER
LEADING_DOT_FLOAT = /\.[0-9](_?[0-9])*([eE][+-]?[0-9](_?[0-9])*)?/ -> NUMBER
SCI_NUMBER = /(0|[1-9](_?[0-9])*|0[0-7]*[89][0-9]*)([eE][+-]?[0-9](_?[0-9])*)/ -> NUMBER
INT_NUMBER = /(0[0-9]*|[1-9](_?[0-9])*)/ -> NUMBER

# --- Strings ---

STRING_DQ = /"([^"\\]|\\.)*"/ -> STRING
STRING_SQ = /'([^'\\]|\\.)*'/ -> STRING

# --- Template literals ---

TEMPLATE_HEAD = /`([^`\\$]|\\.|\$+([^{`\\$]|\\.))*\$*\$\{/
TEMPLATE_NO_SUB = /`([^`\\$]|\\.|\$+([^{`\\$]|\\.))*\$*`/

# --- Regular expressions ---
#
# CHANGED IN ES2022: `d` (hasIndices) flag added.
#
# The `d` flag causes regex matches to include the start and end indices
# of each capture group in the result. Without it, you only get the matched
# text; with it, you also get `indices[0]`, `indices[1]`, etc.
#
# Available flags after ES2022: d, g, i, m, s, u, y

REGEX = /\/([^\/\\\n\r]|\\[^\n\r])+\/[dgimsuy]*/

# ============================================================================
# Multi-character operators (unchanged from ES2021)
# ============================================================================

OR_OR_EQUALS             = "||="
AND_AND_EQUALS           = "&&="
NULLISH_COALESCE_EQUALS  = "??="
OPTIONAL_CHAIN           = "?."
NULLISH_COALESCE         = "??"
STAR_STAR_EQUALS         = "**="
STAR_STAR                = "**"
STRICT_EQUALS            = "==="
STRICT_NOT_EQUALS        = "!=="
UNSIGNED_RIGHT_SHIFT_EQUALS = ">>>="
UNSIGNED_RIGHT_SHIFT     = ">>>"
LEFT_SHIFT_EQUALS        = "<<="
RIGHT_SHIFT_EQUALS       = ">>="
EQUALS_EQUALS            = "=="
NOT_EQUALS               = "!="
LESS_EQUALS              = "<="
GREATER_EQUALS           = ">="
PLUS_EQUALS              = "+="
MINUS_EQUALS             = "-="
STAR_EQUALS              = "*="
SLASH_EQUALS             = "/="
PERCENT_EQUALS           = "%="
AMPERSAND_EQUALS         = "&="
PIPE_EQUALS              = "|="
CARET_EQUALS             = "^="
LEFT_SHIFT               = "<<"
RIGHT_SHIFT              = ">>"
AND_AND                  = "&&"
OR_OR                    = "||"
PLUS_PLUS                = "++"
MINUS_MINUS              = "--"
ARROW                    = "=>"
ELLIPSIS                 = "..."

# ============================================================================
# Single-character operators
# ============================================================================

EQUALS       = "="
PLUS         = "+"
MINUS        = "-"
STAR         = "*"
SLASH        = "/"
PERCENT      = "%"
LESS_THAN    = "<"
GREATER_THAN = ">"
BANG         = "!"
AMPERSAND    = "&"
PIPE         = "|"
CARET        = "^"
TILDE        = "~"
QUESTION     = "?"

# ============================================================================
# Delimiters
# ============================================================================

LPAREN    = "("
RPAREN    = ")"
LBRACE    = "{"
RBRACE    = "}"
LBRACKET  = "["
RBRACKET  = "]"
SEMICOLON = ";"
COMMA     = ","
COLON     = ":"
DOT       = "."

# ============================================================================
# Keywords
# ============================================================================

keywords:
  break
  case
  catch
  class
  const
  continue
  debugger
  default
  delete
  do
  else
  export
  extends
  finally
  for
  function
  if
  import
  in
  instanceof
  let
  new
  return
  super
  switch
  this
  throw
  try
  typeof
  var
  void
  while
  with
  yield
  true
  false
  null

# ============================================================================
# Future reserved words
# ============================================================================

reserved:
  enum

# ============================================================================
# Context keywords
# ============================================================================

context_keywords:
  as
  async
  await
  from
  of
  get
  set
  static

# ============================================================================
# Token groups
# ============================================================================

group template:
  TEMPLATE_MIDDLE = /\}([^`\\$]|\\.|\$+([^{`\\$]|\\.))*\$*\$\{/
  TEMPLATE_TAIL   = /\}([^`\\$]|\\.|\$+([^{`\\$]|\\.))*\$*`/

# ============================================================================
# Declarative lexer modes (F10): regex-vs-division disambiguation
# ============================================================================
#
# A `/` starts a REGEX literal in expression position but is DIVISION in
# operand position, so `a/b/c` must not lex as `a` + regex `/b/` + `c`.
# This is the same table es2025.tokens carries (see its header comment
# for the full explanation), restricted to the token names and keywords
# this edition defines (LANG84 phase 6a). A program starts in `default`
# (expression position); after a value-producing token the lexer switches
# to `div`, whose two overrides make `/` and `/=` division.
#
# `template` / `template_div` keep `${...}` substitutions working: see
# es2025.tokens for the first-slice limits (no nested braces).

start_mode: default

group div:
  SLASH_EQUALS = "/="
  SLASH        = "/"

group template_div:
  SLASH_EQUALS    = "/="
  SLASH           = "/"
  TEMPLATE_MIDDLE = /\}([^`\\$]|\\.|\$+([^{`\\$]|\\.))*\$*\$\{/
  TEMPLATE_TAIL   = /\}([^`\\$]|\\.|\$+([^{`\\$]|\\.))*\$*`/

transitions:
  # ── Template substitution entry/exit (gap-044, first slice) ──────────────
  # After a template opener, enter flat `template` mode so TEMPLATE_TAIL/
  # MIDDLE patterns are tried before the inherited RBRACE.
  on TEMPLATE_HEAD   -> set-mode template
  on TEMPLATE_MIDDLE -> set-mode template

  # Inside `${...}`, after a value-producing NAME, switch to `template_div`
  # (like `div` but still carries TEMPLATE_TAIL/MIDDLE as own patterns).
  # The in_mode guard must come BEFORE the general NAME rule below, because
  # first-match-wins would otherwise fire the general rule in template mode.
  on NAME in template      -> set-mode template_div
  on NAME in template_div  -> set-mode template_div

  # Closing the substitution: TEMPLATE_TAIL is value-producing → div.
  on TEMPLATE_TAIL -> set-mode div

  # ── Regex-vs-division (gap-115, gap-119) ─────────────────────────────────
  # Value-producing tokens -> the next `/` is DIVISION. (One rule per line:
  # the transition parser reads each indented line as a complete rule.)
  on (NAME | NUMBER | BIGINT | STRING | REGEX | TEMPLATE_NO_SUB | PRIVATE_NAME | RPAREN | RBRACKET) -> set-mode div
  on KEYWORD="this"  -> set-mode div
  on KEYWORD="super" -> set-mode div
  on KEYWORD="true"  -> set-mode div
  on KEYWORD="false" -> set-mode div
  on KEYWORD="null"  -> set-mode div

  # Operators, openers, separators -> the next `/` is a REGEX.
  on (LPAREN | LBRACKET | LBRACE | COMMA | SEMICOLON | COLON | DOT | EQUALS | ARROW | QUESTION | ELLIPSIS | PLUS | MINUS | STAR | SLASH | PERCENT | STAR_STAR | EQUALS_EQUALS | NOT_EQUALS | STRICT_EQUALS | STRICT_NOT_EQUALS | LESS_THAN | GREATER_THAN | LESS_EQUALS | GREATER_EQUALS | AND_AND | OR_OR | NULLISH_COALESCE | OPTIONAL_CHAIN | BANG | TILDE | AMPERSAND | PIPE | CARET | LEFT_SHIFT | RIGHT_SHIFT | UNSIGNED_RIGHT_SHIFT | PLUS_EQUALS | MINUS_EQUALS | STAR_EQUALS | SLASH_EQUALS | PERCENT_EQUALS | STAR_STAR_EQUALS | AMPERSAND_EQUALS | PIPE_EQUALS | CARET_EQUALS | LEFT_SHIFT_EQUALS | RIGHT_SHIFT_EQUALS | UNSIGNED_RIGHT_SHIFT_EQUALS | AND_AND_EQUALS | OR_OR_EQUALS | NULLISH_COALESCE_EQUALS) -> set-mode default
  on KEYWORD="return"     -> set-mode default
  on KEYWORD="typeof"     -> set-mode default
  on KEYWORD="delete"     -> set-mode default
  on KEYWORD="void"       -> set-mode default
  on KEYWORD="in"         -> set-mode default
  on KEYWORD="instanceof" -> set-mode default
  on KEYWORD="new"        -> set-mode default
  on KEYWORD="do"         -> set-mode default
  on KEYWORD="else"       -> set-mode default
  on KEYWORD="case"       -> set-mode default
  on KEYWORD="yield"      -> set-mode default
  on KEYWORD="throw"      -> set-mode default

# ============================================================================
# Skip patterns
# ============================================================================

skip:
  WHITESPACE    = /[ \t\r\n\v\f]+/
  LINE_COMMENT  = /\/\/[^\n\r]*/
  BLOCK_COMMENT = /\/\*[^*]*\*+([^\/*][^*]*\*+)*\//

# ============================================================================
# Error recovery tokens
# ============================================================================

errors:
  BAD_STRING_DQ = /"[^"]*$/
  BAD_STRING_SQ = /'[^']*$/
  BAD_REGEX = /\/([^\/\\\n]|\\.)*$/
  BAD_TEMPLATE = /`([^`\\$]|\\.|\$+([^{`\\$]|\\.))*\$*$/
