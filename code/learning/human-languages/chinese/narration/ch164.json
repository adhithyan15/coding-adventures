        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: dǎban",
          "segments": [
            {
              "kind": "speech",
              "text": "dǎban — \"to dress up; to get dressed up\"."
            },
            {
              "kind": "speech",
              "text": "tā zài dǎban wǒmen děng yíhuìr — She's getting ready; let's wait a moment."
            },
            {
              "kind": "speech",
              "text": "Its characters come later; for now it is a word for the ear."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "dǎban is built from 打 'to strike' and ban, both inherited from Middle Chinese, taengX and peanH (Guangyun, in Baxter's transcription), which glosses the second with this very word, 'to dress up'. Dǎ is not the sound taengX would regularly give, and in the word the second loses its tone."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for saying what I do."
            }
          ]
        },
