        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ભાળ",
          "segments": [
            {
              "kind": "speech",
              "text": "ભાળ — bhāḷ — \"a trace; whereabouts\"."
            },
            {
              "kind": "speech",
              "text": "પોલીસ ચોરની ભાળ કાઢતી હતી. polīs cornī bhāḷ kāḍhtī hatī. The police were trying to trace the thief."
            },
            {
              "kind": "speech",
              "text": "A feminine noun."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ભાળ (bhāḷ) comes from bhāla, \"observation\", a form CDIAL reconstructs, and CDIAL lists Gujarati bhāḷ, \"search, investigation\" (CDIAL 9473). It is the trail that leads to someone: ભાળ કાઢવી, to trace a person."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling what happened."
            }
          ]
        },
