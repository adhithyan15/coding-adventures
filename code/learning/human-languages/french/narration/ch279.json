          "segments": [
            {
              "kind": "speech",
              "text": "la rédaction — \"the newsroom, the editorial staff; a school essay\"."
            },
            {
              "kind": "speech",
              "text": "Toute la rédaction a travaillé tard ce soir-là. The whole newsroom worked late that evening."
            },
            {
              "kind": "speech",
              "text": "At school, une rédaction is an essay."
            }
          ]
        },
