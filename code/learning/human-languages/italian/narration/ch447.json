        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: la questura",
          "segments": [
            {
              "kind": "speech",
              "text": "la questura — \"the police headquarters\"."
            },
            {
              "kind": "speech",
              "text": "Per il passaporto devi andare in questura. For a passport you need to go to the police headquarters."
            },
            {
              "kind": "speech",
              "text": "Run by il questore; you go there for a lost passport too."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "questura is a learned borrowing from Latin quaestūra 'the office of a quaestor', from quaerere 'to seek, to inquire' (Lewis & Short)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
