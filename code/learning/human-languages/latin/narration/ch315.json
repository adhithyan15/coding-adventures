          "segments": [
            {
              "kind": "speech",
              "text": "naufragus, naufraga, naufragum — \"shipwrecked\"."
            },
            {
              "kind": "speech",
              "text": "Nautae naufragī in lītore sedēbant. The shipwrecked sailors were sitting on the shore."
            },
            {
              "kind": "speech",
              "text": "As a noun, naufragus is a shipwrecked man; beggars told of their wrecks to win coins."
            }
          ]
        },
