              "kind": "prompt",
              "action": "SAY",
              "instruction": "el localizador, once more",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *el localizador*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "a sentence of your own with el localizador",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: a sentence of your own with *el localizador*]"
            },
            {
              "kind": "prompt",
