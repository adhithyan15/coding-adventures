          "segments": [
            {
              "kind": "speech",
              "text": "意外 — yìwài — \"mishap; something unexpected\"."
            },
            {
              "kind": "speech",
              "text": "意外发生的时候我在家 yìwài fāshēng de shíhou, wǒ zài jiā — When the accident happened, I was at home."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "意外 (yìwài) is built from 意 'an intention' and 外 'outside', both inherited from Middle Chinese, 'iH and ngwajH (Guangyun, in Baxter's transcription), which glosses the first 'will' and the second 'outside' and 'far': outside what anyone intended."
            }
          ]
        },
