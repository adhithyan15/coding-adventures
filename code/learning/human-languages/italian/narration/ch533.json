          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "apparecchiare is usually traced to Vulgar Latin appariculāre \"to prepare\", from Latin apparāre, built on parāre \"to make ready\" (Lewis & Short)."
            }
          ]
        },
