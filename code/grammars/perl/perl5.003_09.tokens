# Perl 5.003_09 (1996-11-26) tokens: plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: this does not lex all Perl 5.003_09 source.
# Evidence: https://github.com/Perl/perl5/blob/perl-5.003_09/toke.c
# The tagged tokenizer changes sigil/interpolation handling and numeric
# conversion. Those forms stay outside this subset; leading-zero multi-digit
# literals are refused rather than assigned invented decimal semantics.

PRINT     = "print"
INT       = /0|[1-9][0-9]*/
PLUS      = "+"
DECREMENT = "--"
MINUS     = "-"
STAR      = "*"
LPAREN    = "("
RPAREN    = ")"
SEMICOLON = ";"

skip:
  WHITESPACE = /[ \t\r\n]+/
