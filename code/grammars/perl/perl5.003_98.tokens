# Perl 5.003_98 (1997-04-30) tokens: plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: this does not lex all Perl 5.003_98 source.
# Evidence: https://github.com/Perl/perl5/blob/perl-5.003_98/toke.c
# Tagged tokenizer matches 5.003_97j and retains its 250-digit decimal bound.
# Unsupported characters, carriage returns and
# leading-zero forms remain refused.

PRINT     = "print"
INT       = /0|[1-9][0-9]{0,249}/
PLUS      = "+"
DECREMENT = "--"
MINUS     = "-"
STAR      = "*"
LPAREN    = "("
RPAREN    = ")"
SEMICOLON = ";"

skip:
  WHITESPACE = /[ \t\n]+/
