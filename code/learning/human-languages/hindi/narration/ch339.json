        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: राजकुमार",
          "segments": [
            {
              "kind": "speech",
              "text": "राजकुमार — rājkumār — \"a prince\"."
            },
            {
              "kind": "speech",
              "text": "राजकुमार घोड़े पर जंगल में गया। rājkumār ghoṛe par jaṅgal meṁ gayā. The prince rode into the forest."
            },
            {
              "kind": "speech",
              "text": "Masculine."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "राजकुमार (rājkumār) is Sanskrit rājakumāra (Monier-Williams), राजा, a king, and kumāra, a boy: a king's son."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling what happened."
