        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "The origin of संतरा (santarā) is uncertain. It is often linked with the Portuguese town of Sintra, once written Cintra, but no source settles it, and CDIAL has no entry for it."
            }
          ]
        },
