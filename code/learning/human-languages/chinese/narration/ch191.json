    {
      "id": "ZH-W191-hui-return",
      "sequence": 15155,
      "title": "回 (huí) — 口 inside a larger frame",
      "headword": "回",
      "romanization": "huí",
      "gloss": "回 — a large frame, 口 inside it, and the frame closed last",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:a780b153a8daa869",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — 口 inside a larger frame",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — 口 inside a larger frame and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say huílái — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *huílái* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "国 来."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — guó, lái",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *guó*, *lái*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — 口 inside a larger frame",
          "segments": [
            {
              "kind": "speech",
              "text": "回 (huí)."
            },
            {
              "kind": "speech",
              "text": "Two pieces: a large frame, and 口 inside it. Count the pieces, not the strokes."
            },
            {
              "kind": "speech",
              "text": "The frame, first two strokes. A vertical down the left side, then a stroke along the top that turns down the right side."
            },
            {
              "kind": "speech",
              "text": "口 inside, three strokes: a short vertical, a stroke that runs right and turns down, and the bar that closes it."
            },
            {
              "kind": "speech",
              "text": "Last, the frame's foot. One bar along the bottom closes the large frame, the way the last stroke of 国 does."
            },
            {
              "kind": "speech",
              "text": "2 + 3 + 1 = six."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "回 (huí), all six, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 回, all six, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many strokes in 回 (huí)? (Six.) What goes inside the frame? (口.) Which stroke comes last? (The bar that closes the large frame.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 回 (huí), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
