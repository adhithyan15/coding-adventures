# Perl 5.003_11 (1996-12-06) grammar: plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: unsupported Perl 5.003_11 syntax is rejected.
# Evidence: https://github.com/Perl/perl5/blob/perl-5.003_11/perly.y
# Tagged yacc changes operator token types and block bookkeeping. The
# arithmetic precedence, unary minus, parentheses and print subset below
# remain deliberately narrow and separately addressable for this release.

program         = print_statement { print_statement } ;
print_statement = PRINT LPAREN expr RPAREN SEMICOLON ;
expr            = term { ( PLUS | MINUS ) term } ;
term            = unary { STAR unary } ;
unary           = MINUS unary | atom ;
atom            = INT | LPAREN expr RPAREN ;
