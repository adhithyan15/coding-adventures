<!-- MainWindow.xaml — hand-written WinUI 3 host shell that mounts
     the auto-generated FormulaBar above the auto-generated Grid.
     Both controls come from the Mosaic pipeline via
     scripts/build.sh — there is no hand-written grid anymore. -->
<Window
    x:Class="Mosaic.Generated.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:gen="using:Mosaic.Generated"
    Title="VisiCalc — Mosaic XAML demo">

    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header label. -->
        <TextBlock Grid.Row="0" Margin="16,16,16,8"
                   Text="VISICALC · MOSAIC XAML DEMO"
                   Foreground="#9D9D9D"
                   FontSize="11"
                   CharacterSpacing="100"/>

        <!-- FormulaBar — auto-generated by mosaic-compile. -->
        <gen:FormulaBar Grid.Row="1" x:Name="FormulaBarControl"/>

        <!-- Grid — auto-generated by mosaic-compile from
             mosaic-pkg-grid (HostTable + nested For + Cell). The
             host feeds its dependency properties (ColumnHeaders,
             ViewportRows, ColumnWidths, Selected*/Edit*) and handles
             its Dispatch event in MainWindow.xaml.cs. -->
        <gen:Grid Grid.Row="2" x:Name="SheetGrid"/>
    </Grid>
</Window>
