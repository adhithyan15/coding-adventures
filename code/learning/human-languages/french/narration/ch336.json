          "segments": [
            {
              "kind": "speech",
              "text": "objecter is a learned borrowing from Latin obiectāre \"to throw against, to set before\" (Lewis & Short), formed on obicere \"to throw before\", from ob and iacere \"to throw\"."
            }
          ]
        },
