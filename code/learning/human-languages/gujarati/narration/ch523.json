          "segments": [
            {
              "kind": "speech",
              "text": "ફરસાણ — pharsāṇ — \"savoury snacks\"."
            },
            {
              "kind": "speech",
              "text": "દિવાળીમાં અમે ઘરે ઘણું ફરસાણ બનાવીએ છીએ. divāḷīmā̃ ame ghare ghaṇũ pharsāṇ banāvīe chīe. At Diwali we make lots of savoury snacks at home."
            },
            {
              "kind": "speech",
              "text": "A neuter noun."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ફરસાણ (pharsāṇ) is the savoury side of a Gujarati meal or a festival tray. No dictionary we use records an older form, so its history is not settled."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for describing what you lived and felt."
            }
          ]
