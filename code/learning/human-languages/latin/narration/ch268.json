        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: alter, altera, alterum",
          "segments": [
            {
              "kind": "speech",
              "text": "alter, altera, alterum — \"the second of two, the other\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "alter is inherited, usually traced to Proto-Indo-European h2elteros, \"the other of two\" (EtymDB 2.1): the root of alius, \"other\", with -ter, an ending that sets one of two against the other."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for this chapter."
