              "responseSeconds": 8,
              "source": "[YOU SAY: *yuddha*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "yuddhada phalitāṃśa havāmānada mēle avalambisittu. — The outcome of the war depended on the weather.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *yuddhada phalitāṃśa havāmānada mēle avalambisittu.* — The outcome of the war depended on the weather.]"
