          "segments": [
            {
              "kind": "speech",
              "text": "прачечная (práchechnaya) — \"a laundry (shop), a launderette\"."
            },
            {
              "kind": "speech",
              "text": "В прачечной стирают бельё. V práchechnoy stiráyut belyó. At the laundry they wash linen."
            },
            {
              "kind": "speech",
              "text": "An adjective used as a noun. Traditionally чн is pronounced шн here."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "прачечная (práchechnaya) is built on прачка 'a washerwoman' with an adjective ending: the washerwomen's place. EtymDB lists прачечная (práchechnaya) beside прачка."
            }
          ]
        },
