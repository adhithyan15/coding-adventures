        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: coepī, coepisse",
          "segments": [
            {
              "kind": "speech",
              "text": "coepī, coepisse — \"I began, I have begun\"."
            },
            {
              "kind": "speech",
              "text": "Ubi nox vēnit, puellae canere coepērunt. When night came, the girls began to sing."
            },
            {
              "kind": "speech",
              "text": "A perfect with no present in classical use: coepī, coepisse, participle coeptus. It serves as the past of incipiō."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "coepī is the perfect of an old verb coepiō, which Lewis & Short take as co- and apiō, \"to fasten\": to join on, to set about."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
