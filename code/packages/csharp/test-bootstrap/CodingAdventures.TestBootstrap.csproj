<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>CodingAdventures.TestBootstrap.CSharp</PackageId>
    <RootNamespace>CodingAdventures.TestBootstrap</RootNamespace>
    <Version>0.3.2</Version>
    <Authors>Adhithya Rajasekaran</Authors>
    <Description>Deterministic property-based testing engine (pbt-v1) and coverage-guided fuzz engine (fuzz-v1) with SplitMix64, integrated shrinking and verdict honesty</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- The engine's arithmetic is modulo 2^64 by design; make that explicit. -->
    <CheckForOverflowUnderflow>false</CheckForOverflowUnderflow>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <EmbeddedResource Remove="tests\**" />
    <None Remove="tests\**" />
    <InternalsVisibleTo Include="CodingAdventures.TestBootstrap.Tests" />
  </ItemGroup>
</Project>
