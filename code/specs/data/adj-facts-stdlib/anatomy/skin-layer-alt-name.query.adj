% ============================================================================
% skin-layer-alt-name.query.adj — worked recall over the skin-layer-alt-name
% library.
% ============================================================================
% The shape a learner (or an LLM) produces to ANSWER "what is the
% subcutaneous layer also called?" (direct) or "which layer is called the
% hypodermis?" (reverse) — it states no fact of its own — it only `import`s
% the grounded table and asks binding queries. A layer not tabled here
% abstains honestly — the engine never invents an alternate name.
% ============================================================================

import "skin-layer-alt-name.adj"

? skin_layer_alt_name(subcutaneous, $AltName)   % expect hypodermis
? skin_layer_alt_name($Layer, hypodermis)        % reverse bind — expect subcutaneous
? skin_layer_alt_name(epidermis, $AltName)        % expect abstain -- a real, already-tabled skin layer whose own quote never supplies an alternate name
