          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "certō is built on cernō, \"to decide\" (Lewis & Short): to decide something by a contest."
            }
          ]
        },
