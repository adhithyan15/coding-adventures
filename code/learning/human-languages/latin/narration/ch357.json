          "segments": [
            {
              "kind": "speech",
              "text": "opīnor, opīnārī — \"to suppose, to imagine\"."
            },
            {
              "kind": "speech",
              "text": "Ille, opīnor, nōn veniet. He will not come, I suppose."
            },
            {
              "kind": "speech",
              "text": "Deponent: opīnor, opīnārī, opīnātus sum. Dropped into a sentence, opīnor softens it, like English I suppose. English opine comes from it."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "opīnor comes from an old adjective opīnus \"expecting\" (EtymDB), which survives in necopīnus \"unexpected\" (Lewis & Short). English opine and opinion come from it."
            }
          ]
        },
        {
