          "segments": [
            {
              "kind": "speech",
              "text": "la répercussion — \"the repercussion, the knock-on effect\"."
            },
            {
              "kind": "speech",
              "text": "Cette décision aura des répercussions sur les prix. This decision will have repercussions on prices."
            },
            {
              "kind": "speech",
              "text": "Mostly in the plural: des répercussions."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "répercussion is a learned borrowing from Latin repercussiō \"a rebounding\" (Lewis & Short), from repercutere \"to strike back\", built on quatere \"to shake, to strike\"."
            }
          ]
        },
