          "segments": [
            {
              "kind": "speech",
              "text": "nervus, nervī — \"a sinew, tendon; a string\"."
            },
            {
              "kind": "speech",
              "text": "Faber nervōs firmōs habet. The smith has strong sinews."
            },
            {
              "kind": "speech",
              "text": "Masculine, second declension. In the plural also strength, vigour. English nerve."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "nervus is inherited from a Proto-Indo-European word for \"sinew, tendon\", and Greek neuron is a cousin (EtymDB; Lewis & Short). English nerve comes from it."
            }
          ]
        },
