          "segments": [
            {
              "kind": "speech",
              "text": "exsistō, exsistere — \"to arise, to come forth; to exist\"."
            },
            {
              "kind": "speech",
              "text": "Ex parvīs initiīs magnum bellum exstitit. From small beginnings a great war arose."
            },
            {
              "kind": "speech",
              "text": "exsistō, exsistere, exstitī. Ex + sistō, to set, to stand: to stand out, to appear. English exist."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "exsistō is built from ex \"out\" and sistō \"to stand, to set\" (Lewis & Short): to step forth. English exist comes from it."
            }
          ]
        },
        {
