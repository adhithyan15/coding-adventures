% ============================================================================
% uti-id — GROUNDED UTI organism-identification rulebook (spider + write gate).
% ============================================================================
% GENERATED by uti_id_ground.py from grounding/uti-id-grounding.json. Do NOT
% hand-edit values — correct a wrong fact by editing the grounding (the spider's
% record) and re-running the gate. Every prior/finding clause is byte-cited to a
% primary source; ACCEPTed clauses carry the source value, FLAGged clauses are
% kept at trust inferred (direction grounded / pending).

import "uti-vocab.adj"

rulebook uti_id {
    use uti_vocab

    % ===================== Epidemiologic priors (spider-grounded) =====================
    prior 0.75 for e_coli
        source "International Clinical Practice Guidelines for the Treatment of Acute "
        trust authoritative
    prior 0.1 for s_saprophyticus
        source "Staphylococcus saprophyticus Infection — StatPearls, NCBI Bookshelf"
        trust authoritative
    prior 0.035 for klebsiella
        source "Local epidemiology and resistance profiles in acute uncomplicated cyst"
        trust authoritative
    prior 0.03 for proteus
        source "Diagnosis and Treatment of Acute Uncomplicated Cystitis — American Fam"
        trust authoritative
    prior 0.048 for enterococcus
        source "Etiology and antimicrobial susceptibility among uropathogens causing c"
        trust authoritative
    prior 0.101 for pseudomonas
        source "Bacterial species and antimicrobial resistance differ between catheter"
        trust authoritative
    prior 0.01 for group_b_strep
        source "Diversity of Group B Streptococcus Serotypes Causing Urinary Tract Inf"
        trust authoritative

    % ===================== Urinalysis findings (spider-grounded mapping) =====================
    contributes 8 from urine_nitrite(positive) to e_coli
        source "Feasibility of serial measurement of nitrite for pharmacodynamic monit"
        trust inferred   % [FLAG: direction_only]
    contributes 8 from urine_nitrite(positive) to klebsiella
        source "Feasibility of serial measurement of nitrite for pharmacodynamic monit"
        trust inferred   % [FLAG: direction_only]
    contributes 8 from urine_nitrite(positive) to proteus
        source "Feasibility of serial measurement of nitrite for pharmacodynamic monit"
        trust inferred   % [FLAG: direction_only]
    contributes 20 from urine_urease_alkaline(present) to proteus
        source "Pathogenesis of Proteus mirabilis Infection (Armbruster CE, Mobley HLT"
        trust consensus
}

? e_coli
? s_saprophyticus
? klebsiella
? proteus
? enterococcus
? pseudomonas
? group_b_strep
