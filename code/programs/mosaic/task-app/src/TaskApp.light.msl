// TaskApp — styling (mosstyle), light theme. Parts match the [ part-name ] labels
// in TaskApp.mll, and TaskApp.dark.msl mirrors this file part-for-part.
//
// The "warm & approachable" identity from code/specs/task-app-ui-design.md: a warm
// paper ground, crisp warm-white cards, warm-charcoal ink, and a single honey accent
// (#e0942a) spent only on *now* — the active project, the primary action, focus.
// Semantic colour is a separate axis: sage for on-track, red for critical/overdue.
// Shadows carry a brown tint rather than neutral black, so they sit in the same warm
// world instead of greying the page.

style TaskApp {
  // ── shell ───────────────────────────────────────────────────────────────
  part app-shell {
    background : "#f0ebe3" ;
    color : "#2b2723" ;
    font-family : "-apple-system, Segoe UI, system-ui, Helvetica Neue, Arial, sans-serif" ;
    min-height : "100vh" ;
  }
  part rail {
    width : 236 ;
    flex-shrink : 0 ;
    padding-top : 20 ;
    padding-right : 14 ;
    padding-bottom : 20 ;
    padding-left : 14 ;
    gap : 22 ;
    border-right-width : 1 ;
    border-right-color : "#e6ded3" ;
    border-right-style : "solid" ;
  }
  part main {
    flex-grow : 1 ;
    min-width : 0 ;
    gap : 14 ;
  }
  part content {
    gap : 14 ;
    padding-top : 8 ;
    padding-right : 30 ;
    padding-bottom : 60 ;
    padding-left : 30 ;
  }

  // ── brand ───────────────────────────────────────────────────────────────
  part brand {
    gap : 10 ;
    align : center-vertical ;
    padding : 4 ;
  }
  part brand-mark {
    width : 28 ;
    height : 28 ;
    border-radius : 8 ;
    background : "#e0942a" ;
    box-shadow : "0 1px 2px rgba(60,45,25,.05), 0 4px 14px rgba(60,45,25,.05)" ;
    elevation  : raised ;
  }
  // The bridge arc (task-app-icon-assets-v1.md) — two posts and a
  // border-only curved top, positioned inside brand-mark's Stack.
  part brand-post-left {
    position : "absolute" ;
    top : 11 ;
    left : 4 ;
    width : 3 ;
    height : 13 ;
    border-radius : 1 ;
    background : "#fffdfa" ;
  }
  part brand-post-right {
    position : "absolute" ;
    top : 11 ;
    left : 21 ;
    width : 3 ;
    height : 13 ;
    border-radius : 1 ;
    background : "#fffdfa" ;
  }
  part brand-arc {
    position : "absolute" ;
    top : 3 ;
    left : 4 ;
    width : 20 ;
    height : 10 ;
    border-top-width : 3 ;
    border-top-color : "#fffdfa" ;
    border-top-style : "solid" ;
    border-top-left-radius : 20 ;
    border-top-right-radius : 20 ;
  }
  part brand-name {
    font-size : 15 ;
    font-weight : bold ;
    color : "#2b2723" ;
  }

  // rail-label/rail-projects/rail-row/project-indent/project-on/project-off/
  // rail-composer/project-input/project-add/project-sub moved to
  // mosaic-pkg-project-nav's own .msl themes — see
  // code/specs/task-app-project-nav-v1.md.

  // ── topbar ──────────────────────────────────────────────────────────────
  part topbar {
    gap : 18 ;
    align : center-vertical ;
    padding-top : 20 ;
    padding-right : 30 ;
    padding-bottom : 14 ;
    padding-left : 30 ;
  }
  part title-block {
    width : 100% ;
    gap : 3 ;
  }
  part title {
    font-size : 22 ;
    font-weight : bold ;
    color : "#2b2723" ;
    letter-spacing : "-0.02em" ;
  }
  part subline {
    gap : 8 ;
    align : center-vertical ;
  }
  part summary {
    color : "#6a625a" ;
    font-size : 13 ;
  }
  // The engine's verdict. Semantic colour, deliberately not the honey accent.
  // Now a Row (dot + label) rather than a bare Text — gap/align added,
  // everything else unchanged, since a Row and a Text both take
  // background/color/padding/border-radius the same way.
  part pill-ok {
    background : "#e4efe7" ;
    color : "#4f8e6a" ;
    font-size : 12 ;
    font-weight : bold ;
    padding-top : 2 ;
    padding-right : 9 ;
    padding-bottom : 2 ;
    padding-left : 9 ;
    border-radius : 20 ;
    gap : 5 ;
    align : center-vertical ;
  }
  part pill-warn {
    background : "#f8e4df" ;
    color : "#cf4b34" ;
    font-size : 12 ;
    font-weight : bold ;
    padding-top : 2 ;
    padding-right : 9 ;
    padding-bottom : 2 ;
    padding-left : 9 ;
    border-radius : 20 ;
    gap : 5 ;
    align : center-vertical ;
  }
  // The status dot (task-app-icon-assets-v1.md) — `background: currentColor`
  // means it always matches whichever pill it's in, no separate warn/ok
  // colour to keep in sync. The label itself takes no styling of its own —
  // it inherits the pill Row's own color/font-size/font-weight, same as the
  // bare Text it replaced.
  part pill-dot-ok {
    width : 6 ;
    height : 6 ;
    border-radius : 50% ;
    background : "currentColor" ;
  }
  part pill-dot-warn {
    width : 6 ;
    height : 6 ;
    border-radius : 50% ;
    background : "currentColor" ;
  }
  // ── progress ring (task-app-icon-assets-v1.md) ─────────────────────────
  part ring-wrap {
    gap : 10 ;
    align : center-vertical ;
  }
  part ring-circle {
    width : 34 ;
    height : 34 ;
  }
  // The only UI36-`background`-bound part in this whole component — see
  // TaskApp.mil's doc comment on `ring-gradient`.
  part ring-fill {
    width : 34 ;
    height : 34 ;
    border-radius : 50% ;
  }
  // Punches the donut hole: a smaller same-surface-colour circle stacked on
  // top of ring-fill. The topbar has no background of its own (it sits
  // directly on app-shell), so this matches app-shell's own background —
  // if the ring ever moves onto a card, this needs to move with it.
  part ring-hole {
    position : "absolute" ;
    top : 5 ;
    left : 5 ;
    width : 24 ;
    height : 24 ;
    border-radius : 50% ;
    background : "#f0ebe3" ;
  }
  part ring-caption {
    gap : 0 ;
  }
  part ring-pct {
    font-size : 14 ;
    font-weight : bold ;
    color : "#2b2723" ;
  }
  part ring-label {
    font-size : 12.5 ;
    color : "#9b9289" ;
  }

  // ── theme toggle (task-app-icon-assets-v1.md) ──────────────────────────
  // See TaskApp.mll's doc comment: HostButton can't render a child, so the
  // shape IS the button's own background/box-shadow, and the accessible
  // label text is kept (for screen readers) but visually hidden via
  // `color: transparent` rather than removed.
  part theme-toggle-sun {
    width : 34 ;
    height : 34 ;
    border-radius : 50% ;
    background : "#e0942a" ;
    border-width : 1 ;
    border-color : "#e6ded3" ;
    color : "transparent" ;
    font-size : 1 ;
  }
  // A crescent: an inset shadow, offset toward one corner, painted in the
  // page's own background colour — it reads as a bite taken out of the
  // filled circle rather than a second shape.
  part theme-toggle-moon {
    width : 34 ;
    height : 34 ;
    border-radius : 50% ;
    background : "#6a625a" ;
    border-width : 1 ;
    border-color : "#e6ded3" ;
    box-shadow : "5px -5px 0 0 #f0ebe3 inset" ;
    color : "transparent" ;
    font-size : 1 ;
  }

  // Per-project complexity toggle — see task-app-complexity-config-v1.md.
  // A pill like pill-ok/pill-warn above, but interactive (a hover state),
  // so it reads as a control rather than a status badge.
  part complexity-toggle {
    background : "#f7f2ea" ;
    color : "#6a625a" ;
    font-size : 12 ;
    font-weight : bold ;
    padding-top : 3 ;
    padding-right : 10 ;
    padding-bottom : 3 ;
    padding-left : 10 ;
    border-width : 1 ;
    border-color : "#e6ded3" ;
    border-radius : 20 ;
    state hover {
      color : "#2b2723" ;
      border-color : "#d8cdbd" ;
    }
  }

  // ── segmented view switch ───────────────────────────────────────────────
  part seg {
    gap : 2 ;
    align : center-vertical ;
    background : "#f7f2ea" ;
    padding : 3 ;
    border-width : 1 ;
    border-color : "#e6ded3" ;
    border-radius : 10 ;
  }
  part seg-list-on {
    background : "#fffdfa" ;
    color : "#2b2723" ;
    font-size : 13 ;
    font-weight : bold ;
    padding-top : 6 ;
    padding-right : 14 ;
    padding-bottom : 6 ;
    padding-left : 14 ;
    border-width : 0 ;
    border-radius : 7 ;
    box-shadow : "0 1px 2px rgba(60,45,25,.05), 0 4px 14px rgba(60,45,25,.05)" ;
    elevation  : raised ;
  }
  part seg-tl-on {
    background : "#fffdfa" ;
    color : "#2b2723" ;
    font-size : 13 ;
    font-weight : bold ;
    padding-top : 6 ;
    padding-right : 14 ;
    padding-bottom : 6 ;
    padding-left : 14 ;
    border-width : 0 ;
    border-radius : 7 ;
    box-shadow : "0 1px 2px rgba(60,45,25,.05), 0 4px 14px rgba(60,45,25,.05)" ;
    elevation  : raised ;
  }
  part seg-board-on {
    background : "#fffdfa" ;
    color : "#2b2723" ;
    font-size : 13 ;
    font-weight : bold ;
    padding-top : 6 ;
    padding-right : 14 ;
    padding-bottom : 6 ;
    padding-left : 14 ;
    border-width : 0 ;
    border-radius : 7 ;
    box-shadow : "0 1px 2px rgba(60,45,25,.05), 0 4px 14px rgba(60,45,25,.05)" ;
    elevation  : raised ;
  }
  part seg-board-off {
    background : "transparent" ;
    color : "#6a625a" ;
    font-size : 13 ;
    padding : 6 ;
    border-width : 0 ;
    border-radius : 7 ;
    state hover {
      color : "#2b2723" ;
    }
  }
  part seg-board-off3 {
    background : "transparent" ;
    color : "#6a625a" ;
    font-size : 13 ;
    padding : 6 ;
    border-width : 0 ;
    border-radius : 7 ;
    state hover {
      color : "#2b2723" ;
    }
  }
  part seg-board-off4 {
    background : "transparent" ;
    color : "#6a625a" ;
    font-size : 13 ;
    padding : 6 ;
    border-width : 0 ;
    border-radius : 7 ;
    state hover {
      color : "#2b2723" ;
    }
  }
  part seg-sheet-on {
    background : "#fffdfa" ;
    color : "#2b2723" ;
    font-size : 13 ;
    font-weight : bold ;
    padding-top : 6 ;
    padding-right : 14 ;
    padding-bottom : 6 ;
    padding-left : 14 ;
    border-width : 0 ;
    border-radius : 7 ;
    box-shadow : "0 1px 2px rgba(60,45,25,.05), 0 4px 14px rgba(60,45,25,.05)" ;
    elevation  : raised ;
  }
  part seg-sheet-off {
    background : "transparent" ;
    color : "#6a625a" ;
    font-size : 13 ;
    padding : 6 ;
    border-width : 0 ;
    border-radius : 7 ;
    state hover {
      color : "#2b2723" ;
    }
  }
  part seg-sheet-off2 {
    background : "transparent" ;
    color : "#6a625a" ;
    font-size : 13 ;
    padding : 6 ;
    border-width : 0 ;
    border-radius : 7 ;
    state hover {
      color : "#2b2723" ;
    }
  }
  part seg-sheet-off3 {
    background : "transparent" ;
    color : "#6a625a" ;
    font-size : 13 ;
    padding : 6 ;
    border-width : 0 ;
    border-radius : 7 ;
    state hover {
      color : "#2b2723" ;
    }
  }
  part seg-tl-off3 {
    background : "transparent" ;
    color : "#6a625a" ;
    font-size : 13 ;
    padding : 6 ;
    border-width : 0 ;
    border-radius : 7 ;
    state hover {
      color : "#2b2723" ;
    }
  }
  part seg-list-off2 {
    background : "transparent" ;
    color : "#6a625a" ;
    font-size : 13 ;
    padding : 6 ;
    border-width : 0 ;
    border-radius : 7 ;
    state hover {
      color : "#2b2723" ;
    }
  }
  part seg-list-off3 {
    background : "transparent" ;
    color : "#6a625a" ;
    font-size : 13 ;
    padding : 6 ;
    border-width : 0 ;
    border-radius : 7 ;
    state hover {
      color : "#2b2723" ;
    }
  }
  part seg-tl-off2 {
    background : "transparent" ;
    color : "#6a625a" ;
    font-size : 13 ;
    padding : 6 ;
    border-width : 0 ;
    border-radius : 7 ;
    state hover {
      color : "#2b2723" ;
    }
  }
  part seg-list-off {
    background : "transparent" ;
    color : "#6a625a" ;
    font-size : 13 ;
    padding : 6 ;
    border-width : 0 ;
    border-radius : 7 ;
    state hover {
      color : "#2b2723" ;
    }
  }
  part seg-tl-off {
    background : "transparent" ;
    color : "#6a625a" ;
    font-size : 13 ;
    padding : 6 ;
    border-width : 0 ;
    border-radius : 7 ;
    state hover {
      color : "#2b2723" ;
    }
  }

  // Calendar tab. "on" mirrors seg-sheet-on's raised-card treatment; every
  // "off" variant (one per other branch) mirrors seg-sheet-off's plain
  // transparent-with-hover treatment — see TaskApp.mll's seg comment for why
  // each mutually-exclusive branch needs its own part name.
  part seg-cal-on {
    background : "#fffdfa" ;
    color : "#2b2723" ;
    font-size : 13 ;
    font-weight : bold ;
    padding-top : 6 ;
    padding-right : 14 ;
    padding-bottom : 6 ;
    padding-left : 14 ;
    border-width : 0 ;
    border-radius : 7 ;
    box-shadow : "0 1px 2px rgba(60,45,25,.05), 0 4px 14px rgba(60,45,25,.05)" ;
    elevation  : raised ;
  }
  part seg-cal-off {
    background : "transparent" ;
    color : "#6a625a" ;
    font-size : 13 ;
    padding : 6 ;
    border-width : 0 ;
    border-radius : 7 ;
    state hover {
      color : "#2b2723" ;
    }
  }
  part seg-cal-off2 {
    background : "transparent" ;
    color : "#6a625a" ;
    font-size : 13 ;
    padding : 6 ;
    border-width : 0 ;
    border-radius : 7 ;
    state hover {
      color : "#2b2723" ;
    }
  }
  part seg-cal-off3 {
    background : "transparent" ;
    color : "#6a625a" ;
    font-size : 13 ;
    padding : 6 ;
    border-width : 0 ;
    border-radius : 7 ;
    state hover {
      color : "#2b2723" ;
    }
  }
  part seg-cal-off4 {
    background : "transparent" ;
    color : "#6a625a" ;
    font-size : 13 ;
    padding : 6 ;
    border-width : 0 ;
    border-radius : 7 ;
    state hover {
      color : "#2b2723" ;
    }
  }

  // The new calendar-mode branch also needs an "off" instance of every OTHER
  // family (list/board/sheet/timeline) — same plain treatment, next unused
  // numeric suffix per family (see TaskApp.mll's seg block for the mapping).
  part seg-list-off4 {
    background : "transparent" ;
    color : "#6a625a" ;
    font-size : 13 ;
    padding : 6 ;
    border-width : 0 ;
    border-radius : 7 ;
    state hover {
      color : "#2b2723" ;
    }
  }
  part seg-board-off5 {
    background : "transparent" ;
    color : "#6a625a" ;
    font-size : 13 ;
    padding : 6 ;
    border-width : 0 ;
    border-radius : 7 ;
    state hover {
      color : "#2b2723" ;
    }
  }
  part seg-sheet-off4 {
    background : "transparent" ;
    color : "#6a625a" ;
    font-size : 13 ;
    padding : 6 ;
    border-width : 0 ;
    border-radius : 7 ;
    state hover {
      color : "#2b2723" ;
    }
  }
  part seg-tl-off4 {
    background : "transparent" ;
    color : "#6a625a" ;
    font-size : 13 ;
    padding : 6 ;
    border-width : 0 ;
    border-radius : 7 ;
    state hover {
      color : "#2b2723" ;
    }
  }

  // Notes tab. "on" mirrors seg-cal-on's raised-card treatment; every "off"
  // variant mirrors seg-cal-off's plain transparent-with-hover treatment.
  part seg-notes-on {
    background : "#fffdfa" ;
    color : "#2b2723" ;
    font-size : 13 ;
    font-weight : bold ;
    padding-top : 6 ;
    padding-right : 14 ;
    padding-bottom : 6 ;
    padding-left : 14 ;
    border-width : 0 ;
    border-radius : 7 ;
    box-shadow : "0 1px 2px rgba(60,45,25,.05), 0 4px 14px rgba(60,45,25,.05)" ;
    elevation  : raised ;
  }
  part seg-notes-off {
    background : "transparent" ;
    color : "#6a625a" ;
    font-size : 13 ;
    padding : 6 ;
    border-width : 0 ;
    border-radius : 7 ;
    state hover {
      color : "#2b2723" ;
    }
  }
  part seg-notes-off2 {
    background : "transparent" ;
    color : "#6a625a" ;
    font-size : 13 ;
    padding : 6 ;
    border-width : 0 ;
    border-radius : 7 ;
    state hover {
      color : "#2b2723" ;
    }
  }
  part seg-notes-off3 {
    background : "transparent" ;
    color : "#6a625a" ;
    font-size : 13 ;
    padding : 6 ;
    border-width : 0 ;
    border-radius : 7 ;
    state hover {
      color : "#2b2723" ;
    }
  }
  part seg-notes-off4 {
    background : "transparent" ;
    color : "#6a625a" ;
    font-size : 13 ;
    padding : 6 ;
    border-width : 0 ;
    border-radius : 7 ;
    state hover {
      color : "#2b2723" ;
    }
  }
  part seg-notes-off5 {
    background : "transparent" ;
    color : "#6a625a" ;
    font-size : 13 ;
    padding : 6 ;
    border-width : 0 ;
    border-radius : 7 ;
    state hover {
      color : "#2b2723" ;
    }
  }

  // The new notes-mode branch also needs an "off" instance of every OTHER
  // family (list/board/sheet/calendar/timeline) — next unused numeric
  // suffix per family (see TaskApp.mll's seg block for the mapping).
  part seg-list-off5 {
    background : "transparent" ;
    color : "#6a625a" ;
    font-size : 13 ;
    padding : 6 ;
    border-width : 0 ;
    border-radius : 7 ;
    state hover {
      color : "#2b2723" ;
    }
  }
  part seg-board-off6 {
    background : "transparent" ;
    color : "#6a625a" ;
    font-size : 13 ;
    padding : 6 ;
    border-width : 0 ;
    border-radius : 7 ;
    state hover {
      color : "#2b2723" ;
    }
  }
  part seg-sheet-off5 {
    background : "transparent" ;
    color : "#6a625a" ;
    font-size : 13 ;
    padding : 6 ;
    border-width : 0 ;
    border-radius : 7 ;
    state hover {
      color : "#2b2723" ;
    }
  }
  part seg-cal-off5 {
    background : "transparent" ;
    color : "#6a625a" ;
    font-size : 13 ;
    padding : 6 ;
    border-width : 0 ;
    border-radius : 7 ;
    state hover {
      color : "#2b2723" ;
    }
  }
  part seg-tl-off5 {
    background : "transparent" ;
    color : "#6a625a" ;
    font-size : 13 ;
    padding : 6 ;
    border-width : 0 ;
    border-radius : 7 ;
    state hover {
      color : "#2b2723" ;
    }
  }

  // ── board (kanban) ──────────────────────────────────────────────────────
  part board {
    gap : 14 ;
  }
  part board-col {
    width : 260 ;
    flex-shrink : 0 ;
    background : "#f7f2ea" ;
    padding : 12 ;
    gap : 10 ;
    border-width : 1 ;
    border-color : "#efe8dd" ;
    border-radius : 13 ;
  }
  part col-head-row {
    gap : 8 ;
    align : center-vertical ;
  }
  // background is the one UI36-bound property here (task-app-icon-assets-v1.md
  // extended UI36 to cover it) — `col[3]` varies per `For`-loop row with a value
  // the stylesheet can't enumerate ahead of render (`state-when-X` only accepts a
  // fixed pseudo-state vocabulary, confirmed against the compiler's diagnostic).
  part col-bar {
    width : 20 ;
    height : 4 ;
    border-radius : 3 ;
  }
  part col-head {
    font-size : 11 ;
    font-weight : bold ;
    color : "#6a625a" ;
    letter-spacing : "0.07em" ;
    text-transform : "uppercase" ;
  }
  // A count pill — same treatment as the icon-assets slice's group-count badge.
  part col-count {
    background : "#efe8dd" ;
    color : "#6a625a" ;
    font-size : 11 ;
    padding-top : 1 ;
    padding-right : 8 ;
    padding-bottom : 1 ;
    padding-left : 8 ;
    border-radius : 20 ;
  }
  // The drop target fills its column, so the whole column is a landing zone rather
  // than only the strip of cards already in it — dropping into an empty column has
  // to work.
  part col-drop {
    min-height : 60 ;
    gap : 9 ;
    // HostDropTarget lowers to a bare <div> with no built-in display, unlike Column —
    // so without these the gap is inert and the cards stack flush against each other.
    display : "flex" ;
    flex-direction : "column" ;
  }
  part board-card {
    background : "#fffdfa" ;
    padding : 11 ;
    gap : 6 ;
    border-width : 1 ;
    border-color : "#e6ded3" ;
    // Explicit border-left-* matching board-card-crit's KEY SET (not just its
    // values) — React warns ("mix shorthand and non-shorthand properties")
    // when a node's style object gains/loses individual longhand keys across
    // a rerender, which happens when a card's overdue-ness flips and it swaps
    // between this part and board-card-crit. Declaring the same keys here,
    // set to this part's own (invisible — border-style stays unset) look,
    // keeps both variants' style objects shaped identically.
    border-left-width : 1 ;
    border-left-color : "#e6ded3" ;
    border-left-style : "none" ;
    border-radius : 9 ;
    box-shadow : "0 1px 2px rgba(60,45,25,.05), 0 4px 14px rgba(60,45,25,.05)" ;
    elevation  : raised ;
    cursor : "grab" ;
    state hover {
      border-color : "#e0942a" ;
    }
  }
  // An overdue card — identical to board-card but with a colored left border in
  // place of the old text chip, per the design-fidelity item's own wording.
  // HostDraggable's dedicated emitter doesn't support state-when- (confirmed by
  // reading it directly), so this is a second static part rather than a
  // conditional style spread on board-card itself — same pattern as
  // pill-warn/pill-ok and theme-toggle-sun/moon earlier this session.
  part board-card-crit {
    background : "#fffdfa" ;
    padding : 11 ;
    gap : 6 ;
    border-width : 1 ;
    border-color : "#e6ded3" ;
    border-left-width : 3 ;
    border-left-color : "#cf4b34" ;
    border-left-style : "solid" ;
    border-radius : 9 ;
    box-shadow : "0 1px 2px rgba(60,45,25,.05), 0 4px 14px rgba(60,45,25,.05)" ;
    elevation  : raised ;
    cursor : "grab" ;
    state hover {
      border-color : "#e0942a" ;
    }
  }
  part card-name {
    font-size : 13 ;
    color : "#2b2723" ;
  }
  part card-name-crit {
    font-size : 13 ;
    color : "#2b2723" ;
  }
  // ── list ────────────────────────────────────────────────────────────────
  part list-wrap {
    max-width : 760 ;
    gap : 16 ;
  }
  part composer {
    gap : 8 ;
    align : center-vertical ;
    background : "#fffdfa" ;
    padding : 8 ;
    border-width : 1 ;
    border-color : "#e6ded3" ;
    border-radius : 13 ;
    box-shadow : "0 1px 2px rgba(60,45,25,.05), 0 4px 14px rgba(60,45,25,.05)" ;
    elevation  : raised ;
  }
  // The decorative plus mark (task-app-icon-assets-v1.md) — two crossed
  // bars, centred inside the dashed box via absolute positioning.
  part composer-plus {
    width : 30 ;
    height : 30 ;
    flex-shrink : 0 ;
    border-radius : 8 ;
    border-width : 1 ;
    border-color : "#e6ded3" ;
    border-style : "dashed" ;
  }
  part plus-bar-h {
    position : "absolute" ;
    top : 14 ;
    left : 10 ;
    width : 10 ;
    height : 2 ;
    border-radius : 1 ;
    background : "#b6a998" ;
  }
  part plus-bar-v {
    position : "absolute" ;
    top : 10 ;
    left : 14 ;
    width : 2 ;
    height : 10 ;
    border-radius : 1 ;
    background : "#b6a998" ;
  }
  part name-input {
    width : 100% ;
    background : "transparent" ;
    color : "#2b2723" ;
    font-size : 14 ;
    padding : 6 ;
    border-width : 0 ;
    border-radius : 8 ;
  }
  part due-input {
    width : 150 ;
    flex-shrink : 0 ;
    background : "transparent" ;
    color : "#2b2723" ;
    font-size : 14 ;
    padding : 6 ;
    border-width : 0 ;
    border-left-width : 1 ;
    border-left-color : "#efe8dd" ;
    border-left-style : "solid" ;
  }
  part add-btn {
    background : "#e0942a" ;
    color : "#ffffff" ;
    font-size : 13 ;
    font-weight : bold ;
    padding-top : 8 ;
    padding-right : 16 ;
    padding-bottom : 8 ;
    padding-left : 16 ;
    border-width : 0 ;
    border-radius : 8 ;
    state hover {
      background : "#c67f1e" ;
    }
    state pressed {
      background : "#a96816" ;
    }
  }

  // ── sheet: label composer ──────────────────────────────────────────────
  part sheet-view-wrap {
    gap : 14 ;
  }
  part label-composer {
    gap : 8 ;
    align : center-vertical ;
    background : "#fffdfa" ;
    padding : 8 ;
    border-width : 1 ;
    border-color : "#e6ded3" ;
    border-radius : 13 ;
    box-shadow : "0 1px 2px rgba(60,45,25,.05), 0 4px 14px rgba(60,45,25,.05)" ;
    elevation  : raised ;
  }
  part label-name-input {
    width : 220 ;
    background : "transparent" ;
    color : "#2b2723" ;
    font-size : 14 ;
    padding : 6 ;
    border-width : 0 ;
    border-radius : 8 ;
  }
  part label-add-btn {
    background : "#e0942a" ;
    color : "#ffffff" ;
    font-size : 13 ;
    font-weight : bold ;
    padding-top : 8 ;
    padding-right : 16 ;
    padding-bottom : 8 ;
    padding-left : 16 ;
    border-width : 0 ;
    border-radius : 8 ;
    state hover {
      background : "#c67f1e" ;
    }
    state pressed {
      background : "#a96816" ;
    }
  }

  part task-list {
    gap : 7 ;
  }
  // Section heading between groups — the engine decides the grouping.
  // Padding moved from group-head onto the row that now wraps it and its
  // count badge (task-app-icon-assets-v1.md) — group-head itself keeps
  // only its own text styling.
  part group-head-row {
    gap : 8 ;
    align : center-vertical ;
    padding : 10 ;
  }
  part group-head {
    font-size : 11 ;
    font-weight : bold ;
    color : "#9b9289" ;
    letter-spacing : "0.07em" ;
    text-transform : "uppercase" ;
  }
  part group-count {
    background : "#efe8dd" ;
    color : "#6a625a" ;
    font-size : 11 ;
    letter-spacing : "0" ;
    font-weight : normal ;
    text-transform : "none" ;
    padding-top : 1 ;
    padding-right : 8 ;
    padding-bottom : 1 ;
    padding-left : 8 ;
    border-radius : 20 ;
  }
  part task-card {
    background : "#fffdfa" ;
    border-width : 1 ;
    border-color : "#e6ded3" ;
    border-radius : 13 ;
    box-shadow : "0 1px 2px rgba(60,45,25,.05), 0 4px 14px rgba(60,45,25,.05)" ;
    elevation  : raised ;
  }
  part task-row {
    gap : 10 ;
    align : center-vertical ;
    padding-top : 12 ;
    padding-right : 14 ;
    padding-bottom : 12 ;
    padding-left : 14 ;
  }
  // The completion toggle — a round control whose label is the engine's glyph.
  part toggle {
    background : "transparent" ;
    color : "#4f8e6a" ;
    font-size : 14 ;
    padding : 3 ;
    border-width : 2 ;
    border-color : "#9b9289" ;
    border-radius : 20 ;
    state hover {
      border-color : "#e0942a" ;
    }
  }
  part task-name {
    width : 100% ;
    background : "transparent" ;
    color : "#2b2723" ;
    font-size : 14 ;
    text-align : "left" ;
    padding : 4 ;
    border-width : 0 ;
    border-radius : 7 ;
    state hover {
      color : "#b6741a" ;
    }
  }
  // Meta chips: due is honey (time), schedule a quiet surface, overdue the one place
  // semantic red appears in a row.
  part chip-due {
    background : "#faedd6" ;
    color : "#b6741a" ;
    font-size : 11 ;
    font-weight : bold ;
    padding : 4 ;
    border-radius : 20 ;
  }
  part chip-sched {
    background : "#f7f2ea" ;
    color : "#6a625a" ;
    font-size : 11 ;
    padding : 4 ;
    border-radius : 20 ;
  }
  part chip-over {
    background : "#f8e4df" ;
    color : "#cf4b34" ;
    font-size : 11 ;
    font-weight : bold ;
    padding : 4 ;
    border-radius : 20 ;
  }
  part chip-priority {
    background : "#f7f2ea" ;
    color : "#6a625a" ;
    font-size : 11 ;
    padding : 4 ;
    border-radius : 20 ;
  }
  part chip-labels {
    background : "#f7f2ea" ;
    color : "#6a625a" ;
    font-size : 11 ;
    padding : 4 ;
    border-radius : 20 ;
  }
  part del-btn {
    background : "transparent" ;
    color : "#9b9289" ;
    font-size : 12 ;
    padding : 6 ;
    border-width : 0 ;
    border-radius : 8 ;
    state hover {
      background : "#f8e4df" ;
      color : "#cf4b34" ;
    }
  }

  // ── progressive disclosure ──────────────────────────────────────────────
  part task-detail {
    background : "#f7f2ea" ;
    border-top-width : 1 ;
    border-top-color : "#efe8dd" ;
    border-top-style : "solid" ;
    // The 47px left indent lines the detail up under the task name (past the
    // checkbox), matching the mock rather than sitting flush with the row edge.
    padding-top : 15 ;
    padding-right : 16 ;
    padding-bottom : 16 ;
    padding-left : 47 ;
    gap : 5 ;
  }
  part detail-sched {
    color : "#6a625a" ;
    font-size : 12 ;
  }
  part detail-slack {
    color : "#6a625a" ;
    font-size : 12 ;
  }
  part detail-free {
    color : "#9b9289" ;
    font-size : 12 ;
  }
  part detail-deps {
    color : "#6a625a" ;
    font-size : 12 ;
  }
  part detail-notes {
    color : "#9b9289" ;
    font-size : 12 ;
  }

  // ── timeline ────────────────────────────────────────────────────────────
  part timeline-card {
    background : "#fffdfa" ;
    padding : 16 ;
    gap : 8 ;
    border-width : 1 ;
    border-color : "#e6ded3" ;
    border-radius : 13 ;
    box-shadow : "0 1px 2px rgba(60,45,25,.05), 0 4px 14px rgba(60,45,25,.05)" ;
    elevation  : raised ;
  }
  part tl-scale {
    color : "#9b9289" ;
    font-size : 11 ;
  }
  part timeline-row {
    gap : 10 ;
    align : center-vertical ;
  }
  part tl-name {
    color : "#2b2723" ;
    font-size : 13 ;
    width : 150 ;
    flex-shrink : 0 ;
  }
  // The shared track every bar is measured against. Bars are positioned by a
  // percentage pad, so the track is one common width for every row.
  part tl-track {
    width : 100% ;
    background : "#f7f2ea" ;
    border-radius : 6 ;
  }
  part tl-pad {
    height : 16 ;
  }
  part tl-bar {
    background : "#e0942a" ;
    height : 16 ;
    border-radius : 6 ;
  }
  part tl-bar-crit {
    background : "#cf4b34" ;
    height : 16 ;
    border-radius : 6 ;
  }
  // The percent-complete overlay, nested inside tl-bar/tl-bar-crit — its
  // bound width (a CSS percentage) is relative to its own parent, so
  // "40%" here means 40% of THAT bar's own rendered length, not the
  // whole track. A darker tint of the same bar colour reads as "fill",
  // not a second unrelated colour.
  part tl-bar-fill {
    background : "rgba(43,39,35,.22)" ;
    height : 16 ;
    border-radius : 6 ;
  }
  part tl-bar-fill-crit {
    background : "rgba(43,39,35,.22)" ;
    height : 16 ;
    border-radius : 6 ;
  }
  // A milestone marker — "inked" (the dark ink colour, matching Calendar's
  // own "milestones inked" convention — see task-app-ui-design.md §4.4),
  // small and fixed-size (deliberately no bound width; see the .mll's doc
  // comment on why), rotated into a diamond.
  part tl-bar-milestone {
    background : "#2b2723" ;
    width : 12 ;
    height : 12 ;
    transform : "rotate(45deg)" ;
    margin-left : 2 ;
  }
  part tl-window {
    color : "#6a625a" ;
    font-size : 11 ;
    width : 190 ;
    flex-shrink : 0 ;
  }
  // ── day-grid ruler ──────────────────────────────────────────────────────
  // A strip above the bars, not composited behind them — see
  // task-app-richer-gantt-v1.md's "Day-grid feasibility note".
  part tl-grid {
    height : 14 ;
    border-radius : 4 ;
    margin-bottom : 2 ;
  }
  part tl-grid-day {
    background : "#f7f2ea" ;
    height : 14 ;
    border-right-width : 1 ;
    border-right-color : "#efe8dd" ;
    border-right-style : "solid" ;
  }
  part tl-grid-weekend {
    background : "#efe4d3" ;
    height : 14 ;
    border-right-width : 1 ;
    border-right-color : "#e6ded3" ;
    border-right-style : "solid" ;
  }
  // The design's "honey today line" — a stronger honey tint than the
  // ordinary weekend shade, distinct at a glance.
  part tl-grid-today {
    background : "#f3cf94" ;
    height : 14 ;
    border-right-width : 1 ;
    border-right-color : "#e0942a" ;
    border-right-style : "solid" ;
  }
  // ── legend ──────────────────────────────────────────────────────────────
  part tl-legend {
    gap : 18 ;
    align : center-vertical ;
    padding-top : 4 ;
    border-top-width : 1 ;
    border-top-color : "#efe8dd" ;
    border-top-style : "solid" ;
  }
  part tl-legend-item {
    gap : 6 ;
    align : center-vertical ;
  }
  part tl-legend-item2 {
    gap : 6 ;
    align : center-vertical ;
  }
  part tl-legend-item3 {
    gap : 6 ;
    align : center-vertical ;
  }
  part tl-legend-item4 {
    gap : 6 ;
    align : center-vertical ;
  }
  part tl-legend-swatch {
    background : "#e0942a" ;
    width : 10 ;
    height : 10 ;
    border-radius : 3 ;
  }
  part tl-legend-swatch-crit {
    background : "#cf4b34" ;
    width : 10 ;
    height : 10 ;
    border-radius : 3 ;
  }
  part tl-legend-swatch-milestone {
    background : "#2b2723" ;
    width : 8 ;
    height : 8 ;
    transform : "rotate(45deg)" ;
  }
  part tl-legend-swatch-today {
    background : "#e0942a" ;
    width : 10 ;
    height : 10 ;
    border-radius : 3 ;
  }
  part tl-legend-label {
    color : "#6a625a" ;
    font-size : 11 ;
  }
  part tl-legend-label2 {
    color : "#6a625a" ;
    font-size : 11 ;
  }
  part tl-legend-label3 {
    color : "#6a625a" ;
    font-size : 11 ;
  }
  part tl-legend-label4 {
    color : "#6a625a" ;
    font-size : 11 ;
  }
}
