        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: la queja",
          "segments": [
            {
              "kind": "speech",
              "text": "la queja — \"the complaint\"."
            },
            {
              "kind": "speech",
              "text": "Tengo una queja sobre el ruido. I have a complaint about the noise."
            },
            {
              "kind": "speech",
              "text": "The verb is quejarse."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "queja is built on quejarse \"to complain\", which is usually traced to a Vulgar Latin form of quassāre \"to shake hard, to batter\" (Lewis & Short)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
            }
          ]
        },
