    {
      "id": "SA-C264-karisyami",
      "sequence": 15650,
      "title": "करिष्यामि (kariṣyāmi) — I will do",
      "headword": "करिष्यामि",
      "romanization": "kariṣyāmi",
      "gloss": "I will do, I will make",
      "script": "devanagari",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:7f26034dac9770ec",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Say “I do,” करोमि, then “I will go,” गमिष्यामि."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: करिष्यामि",
          "segments": [
            {
              "kind": "speech",
              "text": "करिष्यामि — kariṣyāmi — means “I will do” or “I will make.” Keep the whole future form together: करिष्यामि."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "Taken Apart",
          "segments": [
            {
              "kind": "speech",
              "text": "करिष्यामि (kariṣyāmi) comes from the root कृ (kṛ), “do, make,” already met inside करोमि. The future stem appears as करिष्य- (kariṣya-), followed here by first-person -आमि. Whitney, Sanskrit Grammar §§932–935, describes the Sanskrit s-future and its -iṣya- / -sya- formation."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": true,
              "source": "[PAUSE 2s each]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "“I will do” — kariṣyāmi",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: “I will do” — *kariṣyāmi*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "“Tomorrow, I will do the work” — śvaḥ kāryaṃ kariṣyāmi",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: “Tomorrow, I will do the work” — *śvaḥ kāryaṃ kariṣyāmi*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "choose “I will go” — gamiṣyāmi; now “I will do” — kariṣyāmi",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: choose “I will go” — *gamiṣyāmi*; now “I will do” — *kariṣyāmi*]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Say “I will do.” (करिष्यामि (kariṣyāmi).)"
            }
          ]
        }
      ]
    },
    {
