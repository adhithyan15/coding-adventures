        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: مدرک",
          "segments": [
            {
              "kind": "speech",
              "text": "مدرک — madrak — \"a document; a qualification\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "madrak is borrowed from Arabic madrak, \"means of grasping, evidence\". Its Arabic root is d-r-k (Lane). Persian uses it for a document or a qualification."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
