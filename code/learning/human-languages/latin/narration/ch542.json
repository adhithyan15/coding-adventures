        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: unguō, unguere",
          "segments": [
            {
              "kind": "speech",
              "text": "unguō, unguere — \"to anoint, rub with oil\"."
            },
            {
              "kind": "speech",
              "text": "Post balneum corpus oleō unguimus. After the bath we rub the body with oil."
            },
            {
              "kind": "speech",
              "text": "unguō, unguere, ūnxī, ūnctum; also spelt ungō. Unguentum, already known, comes from it. English unction."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "unguō is inherited from a Proto-Indo-European root meaning \"to anoint, salve\" (EtymDB). unguentum \"ointment\" comes from it, and English unction and ointment from its family."
            }
          ]
        },
        {
