              ],
              "responseSeconds": 10,
              "acceptedResponses": [
                "た",
                "hiragana ta"
              ],
              "feedback": {
                "correct": "Right: た closes the final mora of わかりました.",
                "incorrect": "Write た with the left crossing form and two separate right strokes."
              }
            }
          ]
        }
      ]
    },
    {
      "id": "JA-W11-da",
      "sequence": 720,
      "title": "だ (da) — voice the known base",
      "headword": "だ",
      "romanization": "da",
      "gloss": "ta voiced with dakuten to make da",
      "script": "japanese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:e668dcb831eadc4a",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Script — the change"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now — leave the section called Script — the change until you have stopped, and I will say so again when we reach it."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 12,
              "perItem": false,
              "source": "[PAUSE 12s]"
            },
            {
              "kind": "speech",
              "text": "Write た (ta), then add the two-stroke dakuten without changing the base. Say the da in kudasai."
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — the change",
          "segments": [
            {
              "kind": "speech",
              "text": "た + dakuten becomes だ — ta becomes da."
            },
            {
              "kind": "speech",
              "text": "The voicing mark does the same job it did before. This is transfer, not a new complex shape."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "speech",
              "text": "Write た (ta) once."
            },
            {
              "kind": "speech",
              "text": "Add dakuten to make だ."
            },
            {
              "kind": "speech",
              "text": "Point to だ while saying the middle of kudasai."
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "speech",
              "text": "Read ください once, attending to だ (da)."
            },
            {
              "kind": "speech",
              "text": "Source: Unicode Hiragana chart."
            },
            {
              "kind": "activity",
              "scored": true,
              "id": "JA-W11-da-write",
              "prompt": "Voice た (ta) with dakuten. Write the result.",
              "assesses": [
                "JA-SCRIPT-DA-01"
              ],
              "responseSeconds": 10,
              "acceptedResponses": [
                "だ",
                "hiragana da"
              ],
              "feedback": {
                "correct": "Right: た plus dakuten is だ.",
                "incorrect": "Keep た and add the two-stroke voicing mark: だ."
              }
            }
          ]
        }
      ]
    },
