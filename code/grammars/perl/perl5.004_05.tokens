# Perl 5.004_05 (1999-04-29) plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: unsupported Perl 5.004_05 syntax is rejected.
# Evidence: https://mirrors.develooper.com/perl/historical-perl/perl-5.004_05.tar.gz
# Archive SHA-256: 26ca43d9f1067f601c05ebeb3488bc3d473eee1cc772d57085dc43a4a9d5f225
# Its perly.y and toke.c match MT6 and the official perl-5.004_05 tag.
# scan_num matches 5.004_04-m4, including its 250-digit decimal bound.
# Unsupported characters, carriage returns, and leading-zero forms remain refused.

PRINT     = "print"
INT       = /0|[1-9][0-9]{0,249}/
PLUS      = "+"
DECREMENT = "--"
MINUS     = "-"
STAR      = "*"
LPAREN    = "("
RPAREN    = ")"
SEMICOLON = ";"

skip:
  WHITESPACE = /[ \t\n]+/
