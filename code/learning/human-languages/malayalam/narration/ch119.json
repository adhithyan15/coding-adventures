              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *patukke*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "patukke, once more",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *patukke*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "say patukke paṟayū",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: say *patukke paṟayū*]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say the Malayalam for mist, then the Malayalam for thunder and lightning, then say patukke again",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say the Malayalam for mist, then the Malayalam for thunder and lightning, then say *patukke* again]"
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
