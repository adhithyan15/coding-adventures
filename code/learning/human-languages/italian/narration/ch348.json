          "segments": [
            {
              "kind": "speech",
              "text": "lo svantaggio — \"the disadvantage\"."
            },
            {
              "kind": "speech",
              "text": "Lo svantaggio è che la casa è lontana dalla stazione. The disadvantage is that the house is far from the station."
            },
            {
              "kind": "speech",
              "text": "S- in front reverses the meaning, as in comodo and scomodo."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "svantaggio is built from s- \"un-\" and vantaggio, which is usually traced to Old French avantage, from Late Latin abante \"ahead\", made from ab and ante (Lewis & Short)."
            }
          ]
        },
