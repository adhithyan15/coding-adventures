          "segments": [
            {
              "kind": "speech",
              "text": "frequentare — \"to attend; to go around with (people)\"."
            },
            {
              "kind": "speech",
              "text": "Se vuoi passare l'esame, devi frequentare le lezioni. If you want to pass the exam, you have to attend the lessons."
            },
            {
              "kind": "speech",
              "text": "Also of people: frequentare brutte compagnie — to keep bad company."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "frequentare is a learned borrowing from Latin frequentāre \"to visit often, to crowd\" (Lewis & Short), from frequēns \"crowded, frequent\"."
            }
          ]
        },
