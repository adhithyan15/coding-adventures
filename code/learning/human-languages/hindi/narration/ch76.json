              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *rel*, then *gāṛī*, then *relgāṛī*]"
            },
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "गाड़ी (gāṛī) once more, without looking",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: गाड़ी once more, without looking]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What does रेल (rel) mean? (\"the railway\".) What is a रेलगाड़ी? (\"a train\".)"
            }
          ]
        }
      ]
