{
  "name": "@coding-adventures/x25519",
  "version": "0.1.0",
  "description": "X25519 Elliptic Curve Diffie-Hellman (RFC 7748) — from-scratch field arithmetic over GF(2^255-19)",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc",
    "test": "node node_modules/typescript/bin/tsc -p tsconfig.test.json && node --test dist-test/tests/x25519.test.js",
    "test:coverage": "node node_modules/typescript/bin/tsc -p tsconfig.test.json && node --experimental-test-coverage --test-coverage-exclude=dist-test/tests/** --test-coverage-lines=80 --test dist-test/tests/x25519.test.js"
  },
  "author": "Adhithya Rajasekaran",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.0.0"
  }
}
