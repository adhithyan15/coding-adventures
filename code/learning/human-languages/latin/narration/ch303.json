        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: fūrtum, fūrtī",
          "segments": [
            {
              "kind": "speech",
              "text": "fūrtum, fūrtī — \"a theft\"."
            },
            {
              "kind": "speech",
              "text": "Fūrtum in balneō factum est. A theft was committed at the baths."
            },
            {
              "kind": "speech",
              "text": "Neuter, built on fūr, 'thief', which is taught. The ablative fūrtō means 'by stealth'."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "fūrtum is built on fūr, \"thief\" (EtymDB), which is inherited from Proto-Italic fōr."
            }
          ]
        },
        {
