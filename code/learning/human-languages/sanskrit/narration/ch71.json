            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Sanskrit for the shoulder, then the Sanskrit for the lip."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: धावति",
          "segments": [
            {
              "kind": "speech",
              "text": "धावति (dhāvati) — \"(he, she) runs\". It ends in -ति like गच्छति: one person, doing it now."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Dhāvati is the present of the root √dhāv, \"to run, flow\", already in the Rigveda (MW). CDIAL 6802 follows it into Hindi dhāwnā, \"to run\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "A verb in the frame you know."
            }
          ]
        },
        {
          "index": 4,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
