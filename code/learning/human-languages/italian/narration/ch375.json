          "segments": [
            {
              "kind": "speech",
              "text": "rinviare is built from ri- \"again, back\" and inviare \"to send\", usually traced to Late Latin inviāre \"to put on the way\", built on via \"road\" (Lewis & Short)."
            }
          ]
        },
