          "type": "input",
          "title": "You'll want to know: la ciudadanía",
          "segments": [
            {
              "kind": "speech",
              "text": "la ciudadanía — \"the citizenship; the citizens\"."
            },
            {
              "kind": "speech",
              "text": "Tiene la ciudadanía española. He has Spanish citizenship."
            },
            {
              "kind": "speech",
              "text": "It also means all the citizens together: la ciudadanía decide."
            }
          ]
        },
