    {
      "id": "SA-S221-letter-dda",
      "sequence": 1081,
      "title": "ड (ḍa) — one character, met inside words you already say",
      "headword": "ड",
      "romanization": "ḍa",
      "gloss": "the single character ड — recognised inside words you already say",
      "script": "devanagari",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "writing-block",
        "script-block"
      ],
      "sourceHash": "fnv1a64:5eb6a1d0ab0319fc",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Script you'll notice: ड",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now — leave the sections called Script you'll notice: ड and Guided Practice until you have stopped, and I will say so again when we reach it."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one, the ones you have already met: ज, श, छ. Say what each of them does."
            },
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "One character this time. One only — and you have been saying it for pages without knowing which mark on the page it was."
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script you'll notice: ड",
          "segments": [
            {
              "kind": "speech",
              "text": "ड — ḍa."
            },
            {
              "kind": "speech",
              "text": "It is a consonant, and in this script a consonant is never bare: it comes with an a already in it. So it is not ḍ, it is ḍa."
            },
            {
              "kind": "speech",
              "text": "What it is made of:"
            },
            {
              "kind": "speech",
              "text": "a descending stem joined to an upper-left loop and broad open lower bowl."
            },
            {
              "kind": "speech",
              "text": "the top shirorekhā."
            },
            {
              "kind": "speech",
              "text": "You already say these, and every one of them has ड (ḍa) somewhere inside it:"
            },
            {
              "kind": "speech",
              "text": "क्रीडति krīḍati — he, she or it plays."
            }
          ]
        },
        {
          "index": 2,
          "type": "writing",
          "title": "Writing: ड",
          "segments": [
            {
              "kind": "speech",
              "text": "1. start at the stem's headline junction, descend, turn left across the upper shoulder, sweep counterclockwise around the upper-left loop, then continue clockwise around the broad lower bowl to its open up-left tip without lifting."
            },
            {
              "kind": "speech",
              "text": "2. lift and draw the top shirorekhā left-to-right."
            },
            {
              "kind": "speech",
              "text": "Pen lifts: 1. The pen comes up 1 times and no more."
            },
            {
              "kind": "speech",
              "text": "verified two-stroke teaching form fitted to the bundled printed outline."
            },
            {
              "kind": "speech",
              "text": "This is one attested teaching order and not a national standard — handwriting here is taught with school-to-school variation. Source: Opiaterein, ‘Deva-ड (ḍa)-order.gif’, strokes 1–2, Wikimedia Commons, 10 May 2009."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "LOOK",
              "instruction": "at this, and find ड (ḍa) in it",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU LOOK: at this, and find ड in it]"
            },
            {
              "kind": "speech",
              "text": "क्रीडति (krīḍati)."
            },
            {
              "kind": "prompt",
              "action": "TRACE",
              "instruction": "ड three times, saying ḍa as you finish each one",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU TRACE: ड three times, saying *ḍa* as you finish each one]"
            },
            {
              "kind": "prompt",
              "action": "LOOK",
              "instruction": "back at any page of this chapter and find ड (ḍa) once more",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU LOOK: back at any page of this chapter and find ड once more]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Which character is this — ड? What sound does it carry? (ḍa.) Name one word you already say that contains it."
            }
          ]
        }
      ]
    }
  ],
