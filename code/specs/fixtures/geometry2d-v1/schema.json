{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "G2D00/G2D03 neutral geometry cases v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "absolute_tolerance", "cases"],
  "properties": {
    "version": {"const": 1},
    "absolute_tolerance": {"const": 1e-12},
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"oneOf": [
        {"$ref": "#/$defs/normalize"},
        {"$ref": "#/$defs/degenerateArc"}
      ]}
    }
  },
  "$defs": {
    "point": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {"type": "number", "minimum": -1000000, "maximum": 1000000}
    },
    "bounds": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {"type": "number", "minimum": -1000000, "maximum": 1000000}
    },
    "normalize": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "operation", "point", "expected"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "operation": {"const": "point-normalize"},
        "point": {"$ref": "#/$defs/point"},
        "expected": {"$ref": "#/$defs/point"}
      }
    },
    "degenerateArc": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "operation", "from", "to", "rx", "ry", "sample_t", "expected_point", "expected_bounds"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "operation": {"const": "svg-arc-degenerate"},
        "from": {"$ref": "#/$defs/point"},
        "to": {"$ref": "#/$defs/point"},
        "rx": {"type": "number", "minimum": -1000000, "maximum": 1000000},
        "ry": {"type": "number", "minimum": -1000000, "maximum": 1000000},
        "sample_t": {"type": "number", "minimum": 0, "maximum": 1},
        "expected_point": {"$ref": "#/$defs/point"},
        "expected_bounds": {"$ref": "#/$defs/bounds"}
      }
    }
  }
}
