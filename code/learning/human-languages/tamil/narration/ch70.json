          "segments": [
            {
              "kind": "speech",
              "text": "மேசை (mēsai) — \"a table\"."
            },
            {
              "kind": "speech",
              "text": "The table you eat at, or write at."
            },
            {
              "kind": "speech",
              "text": "Put it beside நாற்காலி (nāṟkāli), the chair you already have — the word you could take apart into \"four\" and \"leg\". A மேசை (mēsai) and a நாற்காலி are the pair a room is furnished with, and now you can name both."
            },
            {
              "kind": "speech",
              "text": "Its two signs are old friends: the ே in front of ம, and the ை at the end."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "The first thing in the room."
            }
          ]
        },
