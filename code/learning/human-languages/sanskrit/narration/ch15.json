              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "\"महत् (mahat)\" three times, pointing at something different each time",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: \"महत्\" three times, pointing at something different each time]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "it once with a word you already know after it",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: it once with a word you already know after it]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What is mahat? (big.) Where does it go — before the word it describes, or after? (Before.)"
            }
          ]
        }
      ]
    },
