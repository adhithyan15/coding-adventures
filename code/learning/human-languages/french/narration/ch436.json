        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: le raccourci",
          "segments": [
            {
              "kind": "speech",
              "text": "le raccourci — \"the shortcut\"."
            },
            {
              "kind": "speech",
              "text": "Il connaît un raccourci par le parc. He knows a shortcut through the park."
            },
            {
              "kind": "speech",
              "text": "Built on raccourcir 'to shorten'."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "raccourci is the past participle of raccourcir 'to shorten', used as a noun (EtymDB); the verb is built on court 'short', from Latin curtus (Lewis & Short)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
