              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "You can already name things. This is how you POINT at them."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: महत्",
          "segments": [
            {
              "kind": "speech",
              "text": "महत् — mahat — big."
            },
            {
              "kind": "speech",
              "text": "Put it in front of a word you already know and you have said something new. That is all an adjective does in this language."
            },
            {
              "kind": "speech",
              "text": "The last lesson of this chapter gives the one rule that governs every adjective you will ever meet here."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
