# ECMAScript 2025 (ES16) — Lexical Grammar
# @version 1
# @ecmascript_edition 2025
#
# ECMA-262, 16th Edition — June 2025
#
# ES2025 is the most syntax-rich release since ES2022. It adds three major
# features that have been in development for years: decorators, import
# attributes, and explicit resource management (`using`).
#
# New features:
#
#   1. Decorators: `@decorator`
#      A metaprogramming feature that lets you wrap or modify classes,
#      methods, fields, and accessors using a clean annotation syntax:
#
#        @logged
#        class UserService {
#          @cached
#          async getUser(id) { ... }
#
#          @validate(schema)
#          set data(value) { ... }
#        }
#
#      Decorators are functions that receive the decorated value and can
#      replace it, wrap it, or register metadata about it. They execute
#      at class evaluation time, not at runtime — they transform the class
#      definition itself.
#
#      JavaScript decorators went through NINE TC39 proposals over 7 years
#      before reaching Stage 4. The final design is intentionally simpler
#      than TypeScript's experimental decorators (which were based on an
#      earlier proposal).
#
#   2. Import attributes: `import json from "./data.json" with { type: "json" }`
#      Provides metadata to the module loader about how to interpret the
#      import. The `with` keyword introduces a block of key-value attributes:
#
#        import data from "./data.json" with { type: "json" };
#        import styles from "./app.css" with { type: "css" };
#        const mod = await import("./m.wasm", { with: { type: "webassembly" } });
#
#      This replaces the earlier `assert` keyword from the withdrawn import
#      assertions proposal. The key difference: `with` attributes can
#      influence HOW a module is loaded (not just assert properties after).
#
#   3. Explicit resource management: `using` and `await using`
#      Deterministic cleanup of resources, similar to Python's `with`,
#      C#'s `using`, and Java's try-with-resources:
#
#        {
#          using handle = openFile("data.txt");
#          // handle is automatically closed when the block exits
#        }
#
#        {
#          await using db = await connectDB();
#          // db.close() is called asynchronously when block exits
#        }
#
#      Resources implement `Symbol.dispose` (sync) or `Symbol.asyncDispose`
#      (async). When the block exits — normally, via exception, or via
#      return/break — the runtime calls the dispose method automatically.
#
#   4. RegExp duplicate named capture groups — runtime/regex internal
#   5. Set methods (union, intersection, difference, etc.) — runtime only
#   6. Iterator helpers (map, filter, take, etc.) — runtime only
#   7. JSON modules — uses import attributes syntax
#
# Token changes from ES2024:
#   - Added: AT = "@" (decorator prefix)
#   - Added: `using` as a context keyword

# ============================================================================
# Literals
# ============================================================================

HASHBANG = /^#![^\n]*/

NAME = /[a-zA-Z_$][a-zA-Z0-9_$]*/

PRIVATE_NAME = /#[a-zA-Z_$][a-zA-Z0-9_$]*/

# --- Numbers (with ES2021 numeric separators) ---

BIGINT_HEX = /0[xX][0-9a-fA-F]([0-9a-fA-F_]*[0-9a-fA-F])?n/ -> BIGINT
BIGINT_BINARY = /0[bB][01]([01_]*[01])?n/ -> BIGINT
BIGINT_OCTAL = /0[oO][0-7]([0-7_]*[0-7])?n/ -> BIGINT
BIGINT_DECIMAL = /[0-9]([0-9_]*[0-9])?n/ -> BIGINT

BINARY_NUMBER = /0[bB][01]([01_]*[01])?/ -> NUMBER
OCTAL_NUMBER = /0[oO][0-7]([0-7_]*[0-7])?/ -> NUMBER
HEX_NUMBER = /0[xX][0-9a-fA-F]([0-9a-fA-F_]*[0-9a-fA-F])?/ -> NUMBER
FLOAT_NUMBER = /[0-9]([0-9_]*[0-9])?\.[0-9]([0-9_]*[0-9])?([eE][+-]?[0-9]([0-9_]*[0-9])?)?/ -> NUMBER
LEADING_DOT_FLOAT = /\.[0-9]([0-9_]*[0-9])?([eE][+-]?[0-9]([0-9_]*[0-9])?)?/ -> NUMBER
SCI_NUMBER = /[0-9]([0-9_]*[0-9])?[eE][+-]?[0-9]([0-9_]*[0-9])?/ -> NUMBER
INT_NUMBER = /[0-9]([0-9_]*[0-9])?/ -> NUMBER

# --- Strings ---
#
# escapes: none — the grammar lexer strips the surrounding quotes but does
# NOT process backslash escape sequences. The raw interior (e.g. `\x41`)
# is delivered verbatim in tok.value so that whitespace_only.rs's
# emit_quoted_string can decode every ECMAScript escape form (\xNN,
# \uNNNN, \u{N+}, \0, etc.) and re-emit in Closure's canonical form.
# Upstream Closure normalises e.g. "\x41" → "A", "\u{1F600}" → the
# surrogate pair "😀", "\0" → "\x00".

escapes: none

STRING_DQ = /"([^"\\]|\\.)*"/ -> STRING
STRING_SQ = /'([^'\\]|\\.)*'/ -> STRING

# --- Template literals ---

TEMPLATE_HEAD = /`([^`\\$]|\\.|\$[^{])*\$\{/
TEMPLATE_NO_SUB = /`([^`\\$]|\\.|\$[^{])*`/

# --- Regular expressions (with ES2024 `v` flag) ---

REGEX = /\/([^\/\\\n]|\\.)+\/[dgimsuvy]*/

# ============================================================================
# Multi-character operators (unchanged from ES2024)
# ============================================================================

OR_OR_EQUALS             = "||="
AND_AND_EQUALS           = "&&="
NULLISH_COALESCE_EQUALS  = "??="
OPTIONAL_CHAIN           = "?."
NULLISH_COALESCE         = "??"
STAR_STAR_EQUALS         = "**="
STAR_STAR                = "**"
STRICT_EQUALS            = "==="
STRICT_NOT_EQUALS        = "!=="
UNSIGNED_RIGHT_SHIFT_EQUALS = ">>>="
UNSIGNED_RIGHT_SHIFT     = ">>>"
LEFT_SHIFT_EQUALS        = "<<="
RIGHT_SHIFT_EQUALS       = ">>="
EQUALS_EQUALS            = "=="
NOT_EQUALS               = "!="
LESS_EQUALS              = "<="
GREATER_EQUALS           = ">="
PLUS_EQUALS              = "+="
MINUS_EQUALS             = "-="
STAR_EQUALS              = "*="
SLASH_EQUALS             = "/="
PERCENT_EQUALS           = "%="
AMPERSAND_EQUALS         = "&="
PIPE_EQUALS              = "|="
CARET_EQUALS             = "^="
LEFT_SHIFT               = "<<"
RIGHT_SHIFT              = ">>"
AND_AND                  = "&&"
OR_OR                    = "||"
PLUS_PLUS                = "++"
MINUS_MINUS              = "--"
ARROW                    = "=>"
ELLIPSIS                 = "..."

# ============================================================================
# Single-character operators
# ============================================================================

EQUALS       = "="
PLUS         = "+"
MINUS        = "-"
STAR         = "*"
SLASH        = "/"
PERCENT      = "%"
LESS_THAN    = "<"
GREATER_THAN = ">"
BANG         = "!"
AMPERSAND    = "&"
PIPE         = "|"
CARET        = "^"
TILDE        = "~"
QUESTION     = "?"

# --- NEW IN ES2025: Decorator prefix ---
#
# The `@` symbol is used as the decorator prefix. It was previously unused
# in JavaScript syntax (though it appeared in JSDoc comments and was used
# by TypeScript's experimental decorators).
#
# The `@` must be immediately followed by an expression that evaluates to
# a decorator function. Common patterns:
#   @decorator           — simple decorator (identifier)
#   @decorator(args)     — decorator factory (call expression)
#   @mod.decorator       — member expression decorator
#   @mod.decorator(args) — member expression factory

AT = "@"

# ============================================================================
# Delimiters
# ============================================================================

LPAREN    = "("
RPAREN    = ")"
LBRACE    = "{"
RBRACE    = "}"
LBRACKET  = "["
RBRACKET  = "]"
SEMICOLON = ";"
COMMA     = ","
COLON     = ":"
DOT       = "."

# ============================================================================
# Keywords
# ============================================================================

keywords:
  break
  case
  catch
  class
  const
  continue
  debugger
  default
  delete
  do
  else
  export
  extends
  finally
  for
  function
  if
  import
  in
  instanceof
  let
  new
  return
  super
  switch
  this
  throw
  try
  typeof
  var
  void
  while
  with
  yield
  true
  false
  null

# ============================================================================
# Future reserved words
# ============================================================================

reserved:
  enum

# ============================================================================
# Context keywords
# ============================================================================
#
# ES2025 adds `using` as a context keyword for explicit resource management.
# Like `async` and `await`, `using` is NOT a full keyword — it can still be
# used as an identifier in most positions. It only has special meaning in
# declaration contexts:
#
#   using x = getResource();           // resource declaration
#   await using y = await getAsync();  // async resource declaration
#   const using = 42;                  // still valid as an identifier!
#
# The `with` keyword (already reserved since ES1) is reused for import
# attributes — no new keyword needed.

context_keywords:
  as
  async
  await
  from
  of
  get
  set
  static
  using

# ============================================================================
# Token groups
# ============================================================================

group template:
  TEMPLATE_MIDDLE = /\}([^`\\$]|\\.|\$[^{])*\$\{/
  TEMPLATE_TAIL   = /\}([^`\\$]|\\.|\$[^{])*`/

# ============================================================================
# Declarative lexer modes (F10): regex-vs-division disambiguation
# ============================================================================
#
# ECMAScript's lexical grammar is context-dependent: a `/` starts a REGEX
# literal in *expression position* but is the DIVISION operator in *operand
# position*. A context-free lexer cannot tell them apart, so `a/b/c` was
# mis-lexed as `a` + regex `/b/` + `c` (gap-115, a correctness bug).
#
# We model Acorn's `exprAllowed` as two flat modes:
#   - `default` — expression position; `/` lexes as REGEX (REGEX precedes SLASH
#     in the default group, so it wins).
#   - `div`     — operand position; the `div` group overrides SLASH_EQUALS/SLASH
#     so `/` lexes as division. `div` is a `set-mode` target, so it INHERITS the
#     default patterns (its two overrides just take priority) — no duplication.
#
# A program begins in expression position. After a value-producing token the
# next `/` is division; after an operator/opener/statement-keyword it is a
# regex. `++`/`--` deliberately have no rule (Acorn leaves the flag unchanged).
#
# Template-literal substitutions (gap-044, first slice)
# ======================================================
#
# A template literal with a substitution like `hello ${name}` emits:
#
#   TEMPLATE_HEAD  (`hello ${)   — opens the expression
#   <expression tokens>          — e.g. NAME for `name`
#   TEMPLATE_TAIL  (}`)          — closes the expression
#
# The closing `}` is ambiguous because the default/div flat modes inherit
# RBRACE (which also starts with `}`), and RBRACE would win.  The fix is a
# pair of flat modes:
#
#   `template`      — active right after TEMPLATE_HEAD/TEMPLATE_MIDDLE; a
#                     flat mode so it inherits default's patterns (NAME,
#                     NUMBER, …) while placing TEMPLATE_TAIL/MIDDLE own
#                     patterns first so they win when `}` starts the next
#                     token (empty-body case: `${}`).
#
#   `template_div`  — active after a value-producing token inside `${...}`
#                     (mirrors the role of `div` outside templates); owns
#                     SLASH_EQUALS/SLASH overrides AND TEMPLATE_TAIL/MIDDLE
#                     so the closing `}` of e.g. `${name}` is recognised.
#
# Both modes are `set-mode` targets, so they are FLAT (inherit default
# patterns) — no duplication of the full pattern set.
#
# First-slice limitation: works for `${singleExpr}` where the expression
# body contains no nested `{ }` (object literals, blocks).  Operators like
# `+`, `.`, `(` reset the mode back to `default`/`div`, losing the
# template context.  Full brace-depth support is a follow-up (the F10
# transition table can later add a depth guard when the lexer exposes it).
# Closes closurec gap-044 for the common case.

start_mode: default

group div:
  SLASH_EQUALS = "/="
  SLASH        = "/"

group template_div:
  SLASH_EQUALS    = "/="
  SLASH           = "/"
  TEMPLATE_MIDDLE = /\}([^`\\$]|\\.|\$[^{])*\$\{/
  TEMPLATE_TAIL   = /\}([^`\\$]|\\.|\$[^{])*`/

transitions:
  # ── Template substitution entry/exit (gap-044, first slice) ──────────────
  # After a template opener, enter flat `template` mode so TEMPLATE_TAIL/
  # MIDDLE patterns are tried before the inherited RBRACE.
  on TEMPLATE_HEAD   -> set-mode template
  on TEMPLATE_MIDDLE -> set-mode template

  # Inside `${...}`, after a value-producing NAME, switch to `template_div`
  # (like `div` but still carries TEMPLATE_TAIL/MIDDLE as own patterns).
  # The in_mode guard must come BEFORE the general NAME rule below, because
  # first-match-wins would otherwise fire the general rule in template mode.
  on NAME in template      -> set-mode template_div
  on NAME in template_div  -> set-mode template_div

  # Closing the substitution: TEMPLATE_TAIL is value-producing → div.
  on TEMPLATE_TAIL -> set-mode div

  # ── Regex-vs-division (gap-115, gap-119) ─────────────────────────────────
  # Value-producing tokens -> the next `/` is DIVISION. (One rule per line:
  # the transition parser reads each indented line as a complete rule.)
  on (NAME | NUMBER | STRING | REGEX | TEMPLATE_NO_SUB | PRIVATE_NAME | RPAREN | RBRACKET) -> set-mode div
  on KEYWORD="this"  -> set-mode div
  on KEYWORD="super" -> set-mode div
  on KEYWORD="true"  -> set-mode div
  on KEYWORD="false" -> set-mode div
  on KEYWORD="null"  -> set-mode div

  # Operators, openers, separators -> the next `/` is a REGEX.
  on (LPAREN | LBRACKET | LBRACE | COMMA | SEMICOLON | COLON | DOT | EQUALS | ARROW | QUESTION | ELLIPSIS | AT | PLUS | MINUS | STAR | SLASH | PERCENT | STAR_STAR | EQUALS_EQUALS | NOT_EQUALS | STRICT_EQUALS | STRICT_NOT_EQUALS | LESS_THAN | GREATER_THAN | LESS_EQUALS | GREATER_EQUALS | AND_AND | OR_OR | NULLISH_COALESCE | OPTIONAL_CHAIN | BANG | TILDE | AMPERSAND | PIPE | CARET | LEFT_SHIFT | RIGHT_SHIFT | UNSIGNED_RIGHT_SHIFT | PLUS_EQUALS | MINUS_EQUALS | STAR_EQUALS | SLASH_EQUALS | PERCENT_EQUALS | STAR_STAR_EQUALS | AMPERSAND_EQUALS | PIPE_EQUALS | CARET_EQUALS | LEFT_SHIFT_EQUALS | RIGHT_SHIFT_EQUALS | UNSIGNED_RIGHT_SHIFT_EQUALS | AND_AND_EQUALS | OR_OR_EQUALS | NULLISH_COALESCE_EQUALS) -> set-mode default
  on KEYWORD="return"     -> set-mode default
  on KEYWORD="typeof"     -> set-mode default
  on KEYWORD="delete"     -> set-mode default
  on KEYWORD="void"       -> set-mode default
  on KEYWORD="in"         -> set-mode default
  on KEYWORD="instanceof" -> set-mode default
  on KEYWORD="new"        -> set-mode default
  on KEYWORD="do"         -> set-mode default
  on KEYWORD="else"       -> set-mode default
  on KEYWORD="case"       -> set-mode default
  on KEYWORD="yield"      -> set-mode default
  on KEYWORD="throw"      -> set-mode default

# ============================================================================
# Skip patterns
# ============================================================================

skip:
  WHITESPACE    = /[ \t\r\n\v\f]+/
  LINE_COMMENT  = /\/\/[^\n]*/
  BLOCK_COMMENT = /\/\*([^*]|\*[^\/])*\*\//

# ============================================================================
# Error recovery tokens
# ============================================================================

errors:
  BAD_STRING_DQ = /"[^"]*$/
  BAD_STRING_SQ = /'[^']*$/
  BAD_REGEX = /\/([^\/\\\n]|\\.)*$/
  BAD_TEMPLATE = /`([^`\\$]|\\.|\$[^{])*$/
