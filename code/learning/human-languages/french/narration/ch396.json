            },
            {
              "kind": "speech",
              "text": "Mon téléphone fait une mise à jour cette nuit. My phone is doing an update tonight."
            },
            {
              "kind": "speech",
              "text": "Mettre à jour — to update. Plural les mises à jour."
            }
          ]
        },
