          "segments": [
            {
              "kind": "speech",
              "text": "le lendemain — \"the next day, the day after\"."
            },
            {
              "kind": "speech",
              "text": "Le lendemain, il a téléphoné pour s'excuser. The next day, he phoned to apologise."
            },
            {
              "kind": "speech",
              "text": "It looks forward from a day in the past; from today, say demain."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "lendemain grew out of l'endemain, built on demain, which is inherited from Latin dē māne \"from the morning\" (Lewis & Short)."
            }
          ]
        },
