        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: der Halbbruder",
          "segments": [
            {
              "kind": "speech",
              "text": "der Halbbruder — \"half-brother\"."
            },
            {
              "kind": "speech",
              "text": "Mein Halbbruder ist zehn Jahre jünger als ich. My half-brother is ten years younger than me."
            },
            {
              "kind": "speech",
              "text": "Plural: die Halbbrüder. Likewise die Halbschwester."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Halbbruder is built on halb \"half\", inherited from Old High German halb, from Proto-Germanic halbaz (EtymDB), and Bruder \"brother\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
