          "segments": [
            {
              "kind": "speech",
              "text": "die Vollzeit — \"full-time (work)\"."
            },
            {
              "kind": "speech",
              "text": "Mein Vater arbeitet Vollzeit, meine Mutter halbtags. My father works full-time, my mother half-days."
            },
            {
              "kind": "speech",
              "text": "Vollzeit arbeiten — to work full-time. Die Vollzeitstelle — the full-time job."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Vollzeit joins voll \"full\", Old High German foll, Proto-Germanic fullaz (EtymDB), to Zeit \"time\", Proto-Germanic tīdiz (EtymDB)."
            }
          ]
        },
