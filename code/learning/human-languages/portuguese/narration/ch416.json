        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: o painel",
          "segments": [
            {
              "kind": "speech",
              "text": "o painel — \"the board, the panel\"."
            },
            {
              "kind": "speech",
              "text": "O painel da estação mostra as partidas. The station board shows the departures."
            },
            {
              "kind": "speech",
              "text": "O painel solar — the solar panel. O painel of a car is the dashboard."
            }
          ]
        },
