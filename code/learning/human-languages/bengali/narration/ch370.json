        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: খুব",
          "segments": [
            {
              "kind": "speech",
              "text": "খুব — khub — \"very\"."
            },
            {
              "kind": "speech",
              "text": "তুমি এলে আমি খুব খুশি হব। tumi ele āmi khub khushi hôbô. I'll be very happy if you come."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "খুব (khub) is usually traced to Persian khūb, good or fine. In Bengali it became the plain word for 'very'."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
