        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: कक्षा",
          "segments": [
            {
              "kind": "speech",
              "text": "कक्षा — kakṣā — \"a class, a classroom\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "कक्षा (kakṣā) is Sanskrit kakṣā, \"girdle\", taken over whole as a learned loan, a tatsama (CDIAL 2592). Hindi uses it for a classroom, and so for a class; CDIAL does not trace that sense."
            }
          ]
        },
