        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: వయసు",
          "segments": [
            {
              "kind": "speech",
              "text": "వయసు (vayasu) — \"age\"."
            },
            {
              "kind": "speech",
              "text": "You have asked it already, inside నీ వయసెంత?. Now the word stands alone: మీ వయసు (vayasu) ఎంత? — \"what is your age?\", the respectful form."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "వయసు (vayasu) is Sanskrit vayas, \"prime of life, age\", taken over whole as a learned loan, a tatsama, with Telugu's added -u (CDIAL 11305)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "The word you have been using inside a question, taken out."
            }
          ]
        },
