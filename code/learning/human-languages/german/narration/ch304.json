          "segments": [
            {
              "kind": "speech",
              "text": "das Beileid — \"the condolences, sympathy\"."
            },
            {
              "kind": "speech",
              "text": "Wir sprachen der Familie unser Beileid aus. We offered our condolences to the family."
            },
            {
              "kind": "speech",
              "text": "Herzliches Beileid — my sincere condolences."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Beileid joins bei \"with\" and Leid \"sorrow\", an inherited Germanic word whose English cousin is loath (EtymDB): sorrow shared with someone."
            }
          ]
        },
