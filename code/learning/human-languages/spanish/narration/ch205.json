              ],
              "feedback": {
                "correct": "And comimos is past only, unlike hablamos.",
                "incorrect": "Comimos en casa."
              }
            },
            {
              "kind": "activity",
              "scored": true,
              "id": "ES-C55-sintesis-preterito-completo-raw",
              "prompt": "Swap the -ron on tuvieron for -ra. What do you get?",
              "assesses": [
                "ES-GRAMMAR-STRONG-PRETERITE-PLURAL"
              ],
              "responseSeconds": 14,
              "acceptedResponses": [
                "tuviera",
                "it becomes tuviera"
              ],
              "feedback": {
                "correct": "That is the raw material for supposing.",
                "incorrect": "Tuviera — the form the next chapters need."
              }
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What can this tense do now that it could not before? (Talk about other people — tell a story rather than keep a diary.)"
            },
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "And which form is about to be used twice? (The they form.)"
            }
          ]
        }
      ]
