          "segments": [
            {
              "kind": "speech",
              "text": "اندھیرا — andherā — \"darkness\"."
            },
            {
              "kind": "speech",
              "text": "شہر میں اندھیرا تھا۔ shahr meṅ andherā thā. The city was dark."
            },
            {
              "kind": "speech",
              "text": "Masculine."
