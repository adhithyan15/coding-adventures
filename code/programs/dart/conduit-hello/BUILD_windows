# Windows: build conduit-capi and conduit-dart-bridge (Rust), then run the Dart
# tests through dart:ffi.  tools\run-tests.ps1 stages both DLLs in a private
# directory and sets CONDUIT_CAPI_PATH / CONDUIT_DART_BRIDGE_PATH to them.
# Each BUILD line runs in its own cmd shell, so the whole recipe is one line.
# build-tool: deps=dart/conduit,rust/conduit-capi,rust/conduit-dart-bridge
powershell -NoProfile -ExecutionPolicy Bypass -File tools\run-tests.ps1
