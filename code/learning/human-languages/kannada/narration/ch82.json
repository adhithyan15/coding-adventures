        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ಆಯಾಸ",
          "segments": [
            {
              "kind": "speech",
              "text": "ಆಯಾಸ (āyāsa) — \"tiredness\", the heavy feeling at the end of a long day."
            },
            {
              "kind": "speech",
              "text": "ನನಗೆ ಆಯಾಸ ಆಗಿದೆ (nanage āyāsa āgide) — \"I am tired\", literally \"to me tiredness has happened\". The person sits in ನನಗೆ, \"to me\", the same way ನನಗೆ ಹಸಿವು says \"I am hungry\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "A first word for how the body feels at the end of the day."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
