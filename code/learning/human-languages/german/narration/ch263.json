          "segments": [
            {
              "kind": "speech",
              "text": "sobald — \"as soon as\"."
            },
            {
              "kind": "speech",
              "text": "Sobald der Regen aufhörte, spielten die Kinder im Garten. As soon as the rain stopped, the children played in the garden."
            },
            {
              "kind": "speech",
              "text": "The verb goes to the end. For the future the present is enough: Sobald ich Zeit habe, rufe ich an."
            }
          ]
        },
