        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: der Rundfunk",
          "segments": [
            {
              "kind": "speech",
              "text": "der Rundfunk — \"radio, broadcasting\"."
            },
            {
              "kind": "speech",
              "text": "Sein Vater arbeitete viele Jahre beim Rundfunk. His father worked in radio for many years."
            },
            {
              "kind": "speech",
              "text": "No plural; a little formal. In speech people say das Radio."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Rundfunk joins rund \"round\", Middle High German runt (EtymDB), which came through French from Latin rotundus \"round\" (Lewis & Short), and Funk \"radio\", a by-form of Funke \"spark\", from Old High German funcho (EtymDB)."
            }
          ]
        },
        {
