            },
            {
              "kind": "prompt",
              "action": "CONNECT",
              "instruction": "chahâr from kʷetwóres becomes Latin quattuor, English four",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU CONNECT: **chahâr** ← \\**kʷetwóres* → Latin **quattuor**, English **four**]"
            },
            {
              "kind": "prompt",
              "action": "RUN",
              "instruction": "yek, do, se, chahâr",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RUN: **yek, do, se, chahâr**]"
            }
          ]
        },
