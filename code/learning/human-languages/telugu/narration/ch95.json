    {
      "id": "TE-R95-second-pass-asking",
      "sequence": 3660,
      "title": "Asking about the language — a second pass",
      "headword": "(dialogue)",
      "romanization": "",
      "gloss": "second pass over the courtesies of a visit and the questions a learner asks",
      "script": "telugu",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:d84c29a1960465a2",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Think of something near you and ask how to say it in Telugu."
            }
          ]
        },
        {
          "index": 1,
          "type": "grammar",
          "title": "Grammar Lens: two kinds of polite",
          "segments": [
            {
              "kind": "table",
              "headers": [
                "you ask",
                "you answer"
              ],
              "columns": 2,
              "rowCount": 2,
              "utterances": [
                "you ask: మన్నించండి. you answer: పరవాలేదు.",
                "you ask: టీ కావాలా? you answer: అవసరం లేదు."
              ]
            },
            {
              "kind": "speech",
              "text": "An apology is met with \"no bother\"; an offer is refused with \"no need\". Both answers end in లేదు."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
