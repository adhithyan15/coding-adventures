// CollectionActions.dark.msl - dark collection action panel style.

style CollectionActions {
  part collection-actions {
    background : "#111827" ;
    border-color : "#0891b2" ;
    border-width : 1 ;
    padding : 14 ;
  }

  part collection-title {
    color : "#ecfeff" ;
    font-size : 18 ;
    font-weight : 700 ;
    padding-bottom : 10 ;
  }

  part collection-counts {
    padding-bottom : 10 ;
  }

  part media-health-counts {
    padding-bottom : 8 ;
  }

  part note-count {
    background    : "#1e293b" ;
    border-width  : 1 ;
    border-color  : "#334155" ;
    border-radius : 6 ;
    padding       : 8 ;
  }

  part note-type-count {
    background    : "#1e293b" ;
    border-width  : 1 ;
    border-color  : "#334155" ;
    border-radius : 6 ;
    padding       : 8 ;
  }

  part media-count {
    background    : "#1e293b" ;
    border-width  : 1 ;
    border-color  : "#334155" ;
    border-radius : 6 ;
    padding       : 8 ;
  }

  part referenced-media-count {
    background    : "#1e293b" ;
    border-width  : 1 ;
    border-color  : "#334155" ;
    border-radius : 6 ;
    padding       : 8 ;
  }

  part missing-media-count {
    background    : "#1e293b" ;
    border-width  : 1 ;
    border-color  : "#334155" ;
    border-radius : 6 ;
    padding       : 8 ;
  }

  part unused-media-count {
    background    : "#1e293b" ;
    border-width  : 1 ;
    border-color  : "#334155" ;
    border-radius : 6 ;
    padding       : 8 ;
  }

  part note-count-value {
    color : "#67e8f9" ;
    font-size : 22 ;
    font-weight : 700 ;
  }

  part note-type-count-value {
    color : "#a7f3d0" ;
    font-size : 22 ;
    font-weight : 700 ;
  }

  part media-count-value {
    color : "#fde68a" ;
    font-size : 22 ;
    font-weight : 700 ;
  }

  part referenced-media-value {
    color : "#bae6fd" ;
    font-size : 18 ;
    font-weight : 700 ;
  }

  part missing-media-value {
    color : "#f87171" ;
    font-size : 18 ;
    font-weight : 700 ;
  }

  part unused-media-value {
    color : "#fcd34d" ;
    font-size : 18 ;
    font-weight : 700 ;
  }

  part note-count-label {
    color : "#94a3b8" ;
    font-size : 12 ;
  }

  part note-type-count-label {
    color : "#94a3b8" ;
    font-size : 12 ;
  }

  part media-count-label {
    color : "#94a3b8" ;
    font-size : 12 ;
  }

  part referenced-media-label {
    color : "#94a3b8" ;
    font-size : 12 ;
  }

  part missing-media-label {
    color : "#94a3b8" ;
    font-size : 12 ;
  }

  part unused-media-label {
    color : "#94a3b8" ;
    font-size : 12 ;
  }

  part media-missing-list {
    padding-bottom : 4 ;
  }

  part media-unused-list {
    padding-bottom : 8 ;
  }

  part missing-media-item {
    color : "#fecaca" ;
    font-size : 12 ;
    padding : 2 ;
  }

  part unused-media-item {
    color : "#fde68a" ;
    font-size : 12 ;
    padding : 2 ;
  }

  part import-export-actions {
    gap : 8 ;
    padding-bottom : 8 ;
  }

  part note-actions {
    gap : 8 ;
    padding-bottom : 8 ;
  }

  part destructive-actions {
    gap : 8 ;
  }

  part import-button {
    background    : "#2563eb" ;
    border-width  : 1 ;
    border-color  : "#1d4ed8" ;
    border-radius : 6 ;
    color         : "#ecfeff" ;
    font-weight   : 700 ;
    padding       : 8 ;
  }

  part export-button {
    background    : "#334155" ;
    border-width  : 1 ;
    border-color  : "#475569" ;
    border-radius : 6 ;
    color         : "#f8fafc" ;
    font-weight   : 700 ;
    padding       : 8 ;
  }

  part prune-unused-media-button {
    background    : "#334155" ;
    border-width  : 1 ;
    border-color  : "#475569" ;
    border-radius : 6 ;
    color         : "#fffbeb" ;
    font-weight   : 700 ;
    padding       : 8 ;
  }

  part add-note-button {
    background    : "#2563eb" ;
    border-width  : 1 ;
    border-color  : "#1d4ed8" ;
    border-radius : 6 ;
    color         : "#ecfdf5" ;
    font-weight   : 700 ;
    padding       : 8 ;
  }

  part add-note-type-button {
    background    : "#334155" ;
    border-width  : 1 ;
    border-color  : "#475569" ;
    border-radius : 6 ;
    color         : "#ecfdf5" ;
    font-weight   : 700 ;
    padding       : 8 ;
  }

  part delete-note-button {
    background    : "#9f1239" ;
    border-width  : 1 ;
    border-color  : "#881337" ;
    border-radius : 6 ;
    color         : "#fff1f2" ;
    font-weight   : 700 ;
    padding       : 8 ;
  }

  part delete-note-type-button {
    background    : "#9f1239" ;
    border-width  : 1 ;
    border-color  : "#881337" ;
    border-radius : 6 ;
    color         : "#fff1f2" ;
    font-weight   : 700 ;
    padding       : 8 ;
  }
}
