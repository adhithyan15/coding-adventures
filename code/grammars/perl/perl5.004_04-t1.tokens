# Perl 5.004_04-t1 (1997-09-19) tokens: plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: unsupported Perl 5.004_04-t1 syntax is rejected.
# Evidence: https://mirrors.develooper.com/perl/historical-perl/perl-5.004_04-t1.tar.gz
# Archive SHA-256: a159185d580f409b14bd286baca770ef3ca6457c7db851e3663438cb60cb03b0
# Historical toke.c shares the 5.004_04 trial/final tokenizer;
# glob and quote-delimiter changes are outside this subset.
# Unsupported characters, carriage returns, and leading-zero forms remain refused.

PRINT     = "print"
INT       = /0|[1-9][0-9]{0,249}/
PLUS      = "+"
DECREMENT = "--"
MINUS     = "-"
STAR      = "*"
LPAREN    = "("
RPAREN    = ")"
SEMICOLON = ";"

skip:
  WHITESPACE = /[ \t\n]+/
