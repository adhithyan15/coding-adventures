              "action": "SAY",
              "instruction": "la pareja",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *la pareja*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "la pareja y la familia",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *la pareja y la familia*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "mi pareja, encantado",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *mi pareja, encantado*]"
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What does par mean? (Equal.) What is an umpire literally? (Non par --- not equal, so able to decide.) What does pareja say about a couple? (Two of matching weight.)"
            }
          ]
        }
      ]
    },
    {
      "id": "ES-C309-bebe",
      "sequence": 4610,
      "title": "el bebé --- the sound, not the word",
      "headword": "el bebé",
      "romanization": "el bebé",
      "gloss": "the baby --- French bebe, echoic babble, the same kind of word as English baby and babble",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
