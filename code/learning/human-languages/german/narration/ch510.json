            {
              "kind": "speech",
              "text": "der Zuschauer — \"spectator; viewer\"."
            },
            {
              "kind": "speech",
              "text": "Im Stadion waren fünfzigtausend Zuschauer. There were fifty thousand spectators in the stadium."
            },
            {
              "kind": "speech",
              "text": "Plural: die Zuschauer. Also a TV viewer."
            }
          ]
        },
