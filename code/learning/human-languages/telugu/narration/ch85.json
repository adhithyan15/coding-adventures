              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *cali*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "cali, once more",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *cali*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "say ivāḷa caligā undi, then nāku caligā undi",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: say *ivāḷa caligā undi*, then *nāku caligā undi*]"
            },
            {
