        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: die Stirn",
          "segments": [
            {
              "kind": "speech",
              "text": "die Stirn — \"forehead\"."
            },
            {
              "kind": "speech",
              "text": "Das Kind hat Fieber, die Stirn ist ganz heiß. The child has a fever; its forehead is very hot."
            },
            {
              "kind": "speech",
              "text": "Plural: die Stirnen. Die Stirn runzeln — to frown."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Stirn is inherited from Middle High German stirne and Old High German stirna, from Proto-Germanic stirnijō \"forehead\" (EtymDB)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
