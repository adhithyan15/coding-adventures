        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: die Träne",
          "segments": [
            {
              "kind": "speech",
              "text": "die Träne — \"tear (from crying)\"."
            },
            {
              "kind": "speech",
              "text": "Beim Abschied hatte sie Tränen in den Augen. When they said goodbye, she had tears in her eyes."
            },
            {
              "kind": "speech",
              "text": "Plural: die Tränen. In Tränen ausbrechen — to burst into tears."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Träne is inherited from Middle High German træne \"tears\", a form of trahen, from Old High German trahan \"tear\" (EtymDB); it is usually traced to Proto-Germanic trahnuz \"tear\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
