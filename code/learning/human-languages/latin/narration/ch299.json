        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: nārrātiō, nārrātiōnis",
          "segments": [
            {
              "kind": "speech",
              "text": "nārrātiō, nārrātiōnis — \"a narrative, a telling\"."
            },
            {
              "kind": "speech",
              "text": "Nārrātiō senis longa sed iūcunda erat. The old man's story was long but pleasant."
            },
            {
              "kind": "speech",
              "text": "Feminine, 3rd declension, from nārrō (taught). In a Roman speech, the nārrātiō set out the facts. English narration."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "nārrātiō is built on nārrō, \"to tell, to relate\" (EtymDB), which Lewis & Short link with gnārus, \"knowing\": making known. English narration comes from it."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
