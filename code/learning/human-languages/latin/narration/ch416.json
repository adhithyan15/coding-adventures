        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: iūstitia, iūstitiae",
          "segments": [
            {
              "kind": "speech",
              "text": "iūstitia, iūstitiae — \"justice\"."
            },
            {
              "kind": "speech",
              "text": "Iūstitia fundāmentum cīvitātis est. Justice is the foundation of the state."
            },
            {
              "kind": "speech",
              "text": "iūstitia, iūstitiae f., built on iūstus, fair and right. English justice."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "iūstitia is built on iūstus \"righteous, fair\" (EtymDB), which comes from iūs \"right, law\" (Lewis & Short). English justice comes from it through French."
            }
          ]
        },
        {
          "index": 3,
