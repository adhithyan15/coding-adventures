        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: mojarse",
          "segments": [
            {
              "kind": "speech",
              "text": "mojarse — \"to get wet\"."
            },
            {
              "kind": "speech",
              "text": "Me mojé porque no llevaba paraguas. I got wet because I had no umbrella."
            },
            {
              "kind": "speech",
              "text": "Without se, mojar is to wet something."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "mojarse is built on mojar \"to wet\", which is usually traced to Vulgar Latin molliāre \"to soften\", from mollis \"soft\": wet things go soft."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
