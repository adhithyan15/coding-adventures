// DeckStatsPanel.dark.msl - dark deck-stat panel theme.

style DeckStatsPanel {
  part deck-stats-panel {
    background    : "#172033" ;
    border-width  : 1 ;
    border-color  : "#475569" ;
    border-radius : 8 ;
    padding       : 14 ;
  }

  part deck-stats-label {
    color       : "#94a3b8" ;
    font-size   : 11 ;
    font-weight : 700 ;
  }

  part deck-stats-name {
    color          : "#f8fafc" ;
    font-size      : 20 ;
    font-weight    : 800 ;
    padding-bottom : 10 ;
  }

  part deck-list-label {
    color       : "#94a3b8" ;
    font-size   : 11 ;
    font-weight : 700 ;
  }

  part deck-list-rows {
    padding-top    : 4 ;
    padding-bottom : 8 ;
  }

  part deck-option-button {
    flex-grow     : 1 ;
    text-align    : left ;
    background    : "transparent" ;
    border-width  : 0 ;
    border-radius : 6 ;
    color         : "#e2e8f0" ;
    font-size     : 13 ;
    font-weight   : 600 ;
    padding       : 8 ;
  }

  part deck-stats-grid {
    padding : 2 ;
    padding-top : 10 ;
  }

  part deck-stat-total {
    background    : "#1e293b" ;
    border-width  : 1 ;
    border-color  : "#334155" ;
    border-radius : 6 ;
    padding       : 9 ;
  }

  part deck-stat-new {
    background    : "#1e293b" ;
    border-width  : 1 ;
    border-color  : "#334155" ;
    border-radius : 6 ;
    padding       : 9 ;
  }

  part deck-stat-due {
    background    : "#1e293b" ;
    border-width  : 1 ;
    border-color  : "#334155" ;
    border-radius : 6 ;
    padding       : 9 ;
  }

  part deck-stat-learning {
    background    : "#1e293b" ;
    border-width  : 1 ;
    border-color  : "#334155" ;
    border-radius : 6 ;
    padding       : 9 ;
  }

  part deck-stat-hidden {
    background    : "#1e293b" ;
    border-width  : 1 ;
    border-color  : "#334155" ;
    border-radius : 6 ;
    padding       : 9 ;
  }

  part deck-total-value {
    color       : "#f8fafc" ;
    font-size   : 18 ;
    font-weight : 800 ;
  }

  part deck-new-value {
    color       : "#60a5fa" ;
    font-size   : 18 ;
    font-weight : 800 ;
  }

  part deck-due-value {
    color       : "#fbbf24" ;
    font-size   : 18 ;
    font-weight : 800 ;
  }

  part deck-learning-value {
    color       : "#a78bfa" ;
    font-size   : 18 ;
    font-weight : 800 ;
  }

  part deck-hidden-value {
    color       : "#64748b" ;
    font-size   : 18 ;
    font-weight : 800 ;
  }

  part deck-total-label {
    color       : "#94a3b8" ;
    font-size   : 11 ;
    font-weight : 700 ;
  }

  part deck-new-label {
    color       : "#94a3b8" ;
    font-size   : 11 ;
    font-weight : 700 ;
  }

  part deck-due-label {
    color       : "#94a3b8" ;
    font-size   : 11 ;
    font-weight : 700 ;
  }

  part deck-learning-label {
    color       : "#94a3b8" ;
    font-size   : 11 ;
    font-weight : 700 ;
  }

  part deck-hidden-label {
    color       : "#94a3b8" ;
    font-size   : 11 ;
    font-weight : 700 ;
  }

  // A table row.  `align` centres the counts against the name's larger
  // type, and the hairline gives the eye a rule to travel along.
  part deck-list-entry {
    align               : center-vertical ;
    gap                 : 8 ;
    border-bottom-width : 1 ;
    border-bottom-color : "#243146" ;
    border-bottom-style : solid ;
  }

  // The due count is the number that decides whether you open this deck, so it
  // gets the one accent colour on the screen. New is present but quiet.
  part deck-row-due {
    width       : 56 ;
    text-align  : right ;
    color       : "#fbbf24" ;
    font-size   : 12 ;
    font-weight : 700 ;
  }

  part deck-row-new {
    width       : 56 ;
    text-align  : right ;
    color       : "#60a5fa" ;
    font-size   : 12 ;
    font-weight : 700 ;
  }
}
