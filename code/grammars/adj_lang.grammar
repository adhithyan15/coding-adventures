# @version 1

# Adj-Lang parser grammar — compiles the surface DSL into a parse
# tree the adj-lang crate's lowerer translates into a
# `logic-engine` KnowledgeBase.
#
# Notation (from grammar-tools):
#   |     alternation
#   { }   zero or more
#   [ ]   zero or one
#   ( )   grouping
#   "x"   literal keyword match (token IDENT whose value equals x)
#   UPPERCASE = token reference
#   lowercase = rule reference

# ----------------------------------------------------------------
# program — the start symbol.
# ----------------------------------------------------------------

program     = { statement } EOF ;

statement   = prior_decl
            | contributes_decl
            | interacts_decl
            | uncertain_decl
            | observe_decl
            | query_decl
            | let_decl
            | symbol_decl
            | constrain_decl
            | solve_decl
            | check_decl
            | optimize_decl
            ;

# ----------------------------------------------------------------
# Clause kinds — one production per Statement variant in the
# Adj-Lang AST.
# ----------------------------------------------------------------

prior_decl       = "prior" NUMBER "for" term { annotation } ;

contributes_decl = "contributes" NUMBER "from" evidence "to" term { annotation } ;

# Evidence is either a numeric PREDICATE over a valued slot
# (`gross_income >= 14600`) or an ordinary term (`pmh(hypertension)`).
# The predicate alternative is tried first; because both start with an
# IDENT, the parser relies on full backtracking — `predicate` consumes
# the IDENT, fails when it does not find a comparison operator, and the
# alternation falls back to `term`. A predicate-gated contribution
# lowers to a saturating likelihood ratio: "deterministic" is just a
# very large LR over a CPU-evaluated comparison, not a second engine.
evidence  = predicate | term ;

predicate = IDENT ( GE | LE | GT | LT | EQEQ ) NUMBER ;

interacts_decl   = "interacts" NUMBER "when" term "and" term { "and" term } "for" term { annotation } ;

uncertain_decl   = "uncertain" LBRACE term { COMMA term } RBRACE "for" term { annotation } ;

observe_decl     = "observe" term ;

query_decl       = QUESTION term ;

# ----------------------------------------------------------------
# `let <name> = <expr>` — a COMPUTED value (ADJ expansion step 3).
# The model writes only the formula; the engine evaluates it on the
# CPU into a derivation tree (see logic-engine `compute`). A derived
# value is then usable in any predicate exactly like an observed slot.
#
# Standard precedence cascade: `expr` (+, -) is looser than
# `term_expr` (*, /), which is looser than `factor` (atom / paren /
# aggregation). Left-associativity falls out of the `{ }` repetition.
# Aggregations reduce every observation of a slot.
# ----------------------------------------------------------------

let_decl  = "let" IDENT EQUALS expr ;

expr      = term_expr { ( PLUS | MINUS ) term_expr } ;

term_expr = factor { ( STAR | SLASH ) factor } ;

factor    = agg | NUMBER | IDENT | LPAREN expr RPAREN ;

agg       = ( "sum" | "count" | "min" | "max" | "avg" ) LPAREN IDENT RPAREN ;

# ----------------------------------------------------------------
# Constraint sublanguage (ADJ constraints track B1). The model
# extracts the policy's unknowns + constraints; the engine SOLVES
# them (the solver backends are wired in B2). A `constrain`'s
# operands reuse the `let` arithmetic `expr`, so they may reference
# observed slots, earlier `let`s, AND declared symbols.
# ----------------------------------------------------------------

symbol_decl    = "symbol" IDENT COLON term ;

constrain_decl = "constrain" expr relop expr ;

relop          = GE | LE | GT | LT | EQEQ | EQUALS | NE ;

solve_decl     = "solve" "for" LBRACE IDENT { COMMA IDENT } RBRACE ;

check_decl     = "check" ;

# `minimize <expr>` / `maximize <expr>` — a linear-programming objective over
# the declared symbols (ADJ constraints track C2). The solver finds the optimal
# value of the objective subject to the accumulated `constrain` half-planes,
# the achieving assignment, and the binding constraints. Like `solve`/`check`,
# `minimize`/`maximize` are IDENT-matched keyword literals (not lexer keywords).
optimize_decl  = ( "minimize" | "maximize" ) expr ;

# ----------------------------------------------------------------
# Annotations attach a citation / locator / trust tier to the
# preceding clause. The lowerer accepts at most one of each kind
# per statement.
# ----------------------------------------------------------------

annotation = source_annotation
           | locator_annotation
           | trust_annotation
           ;

source_annotation  = "source" STRING ;
locator_annotation = "locator" STRING ;
trust_annotation   = "trust" trust_tier ;

trust_tier = "consensus"
           | "authoritative"
           | "empirical"
           | "inferred"
           | "unattributed"
           ;

# ----------------------------------------------------------------
# term — atom or compound. Compound terms allow one or more
# comma-separated argument terms.
#
# Recursive on the argument side: each argument is itself a term.
# Depth of recursion is bounded by the parser engine's input length
# in practice; the parser crate provides a separate guard for
# adversarial nesting.
# ----------------------------------------------------------------

term = IDENT [ LPAREN ( term | NUMBER ) { COMMA ( term | NUMBER ) } RPAREN ] ;
