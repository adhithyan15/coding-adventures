      "id": "RU-C386-doklad",
      "sequence": 22310,
      "title": "доклад (doklád) — a talk, a paper (given aloud)",
      "headword": "доклад",
      "romanization": "doklád",
      "gloss": "a talk, a paper (given aloud)",
      "script": "cyrillic",
      "modality": "voice",
      "derivedModality": "voice",
