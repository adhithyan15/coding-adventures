        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: طوطی",
          "segments": [
            {
              "kind": "speech",
              "text": "طوطی — tuti — \"a parrot\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "tuti is the word for a parrot, and Hindi totā, \"parrot\", is usually traced to it. Where Persian itself got the word is not settled."
            }
          ]
        },
