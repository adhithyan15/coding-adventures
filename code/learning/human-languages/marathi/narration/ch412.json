        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: दिशा",
          "segments": [
            {
              "kind": "speech",
              "text": "दिशा — diśā — \"a direction\"."
            },
            {
              "kind": "speech",
              "text": "पुणे कोणत्या दिशेला आहे? puṇe koṇatyā diśelā āhe? In which direction is Pune?"
            },
            {
              "kind": "speech",
              "text": "Feminine."
            },
            {
              "kind": "speech",
              "text": "Before an ending दिशा (diśā) becomes दिशे-: दिशेला, दिशेने."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "दिशा (diśā) is a tatsama, taken from Sanskrit diśā, \"direction, quarter of the compass\" (Monier-Williams)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for getting around."
            }
          ]
        },
