        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: கிராமம்",
          "segments": [
            {
              "kind": "speech",
              "text": "கிராமம் (kirāmam) — \"a village\"."
            },
            {
              "kind": "speech",
              "text": "Sanskrit grāma, and Telugu takes it whole: గ్రామం. Tamil does not begin a word on two held-together sounds, so it let a vowel into the middle of the cluster and the word came out ki-rā-mam."
            },
            {
              "kind": "speech",
              "text": "You already have ūr for the place you belong to. ūr is yours — your town, the one you name when somebody asks where you are from. கிராமம் (kirāmam) is the word on the form and on the signboard at the edge of the road."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "Water, high ground, a wet field, a way across it, and the place at the end of the way."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
