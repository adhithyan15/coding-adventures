            {
              "kind": "speech",
              "text": "Before the new one: say the Urdu for strong, then the Urdu for weak."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: جوان",
          "segments": [
            {
              "kind": "speech",
              "text": "جوان — javān — \"young\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "جوان (javān) is usually traced to Persian javān, \"young\". CDIAL also lists a Hindi juwān, \"a youth\", under yuvāna, \"young\", the Indo-Aryan form of the same ancient word (CDIAL 10510)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for this chapter."
