      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new word: what did dadhi mean?"
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: शर्करा",
          "segments": [
            {
              "kind": "speech",
              "text": "शर्करा (śarkarā) — \"sugar\"."
            },
            {
              "kind": "speech",
              "text": "शर्करा (śarkarā) is sugar, and before that it was grit and gravel — then the sweet grit that comes off boiled cane."
            },
            {
              "kind": "speech",
              "text": "This one word is behind every sugar in Europe. It went into Arabic as sukkar, into Latin as saccharum, and from there into Italian zucchero, French sucre, German Zucker and English sugar and saccharine."
            },
            {
              "kind": "speech",
              "text": "Feminine, ending in -आ, like माला and शिला."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Śarkarā first meant gravel or grit, in the Atharvaveda, and only later candied sugar (CDIAL 12337, 12338); CDIAL notes a proposal that the sugar sense came through a Mon-Khmer word. Borrowed through Persian into Arabic sukkar, it reached English as sugar."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "The Sanskrit word inside every European sugar."
            }
          ]
        },
        {
          "index": 4,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
