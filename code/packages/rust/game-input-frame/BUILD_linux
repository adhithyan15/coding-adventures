# BUILD_linux mirrors BUILD and adds a strict runtime-capability execution.
# The build tool selects BUILD_linux for Linux, BUILD_windows for Windows, and
# BUILD for platforms without an override. Keep common steps synchronized.
python3 ../../../specs/fixtures/game-input-frame-v1/validate.py
python3 -m unittest discover -s ../../../specs/fixtures/game-input-frame-v1 -p 'test_*.py'
cargo test -p game-input-frame -- --nocapture
cargo test -p game-input-frame --release -- --nocapture
if cargo tarpaulin --version >/dev/null 2>&1; then cargo tarpaulin --manifest-path Cargo.toml --tests --engine llvm --skip-clean --fail-under 95 --include-files 'game-input-frame/src/*' --out Stdout; fi
cargo run --manifest-path ../ca-capability-analyzer/Cargo.toml -- --dir . --check-module
cargo run --manifest-path ../ca-capability-analyzer/Cargo.toml -- --dir . --verify-cert effect_certificate.json
# RCG_STRICT fails Linux CI if the capability runtime did not actually go LIVE.
RCG_STRICT=1 cargo test -p game-input-frame --test runtime_capability -- --nocapture
