component SpiceWorkbench {
  slot workbench-title : text ;
  slot mode-label : text ;
  slot netlist-label : text ;
  slot netlist-text : text ;
  slot netlist-placeholder : text ;
  slot inspect-label : text ;
  slot run-label : text ;
  slot diagnostics-label : text ;
  slot diagnostics : text ;
  slot diagnostic-rows : list<text> ;
  slot schematic-label : text ;
  slot schematic-title : text ;
  slot schematic-rows : list<text> ;
  slot schematic-palette : list<text> ;
  slot schematic-analysis-label : text ;
  slot schematic-analysis-controls : list<text> ;
  slot schematic-analysis-card-label : text ;
  slot schematic-analysis-card-rows : list<list<text>> ;
  slot selected-schematic-analysis-label : text ;
  slot schematic-analysis-configuration-label : text ;
  slot remove-schematic-analysis-card-label : text ;
  slot schematic-analysis-source-label : text ;
  slot schematic-analysis-source-options : list<text> ;
  slot selected-schematic-analysis-source-label : text ;
  slot schematic-analysis-parameter-one-label : text ;
  slot schematic-analysis-parameter-one-value : text ;
  slot schematic-analysis-parameter-one-disabled : bool ;
  slot schematic-analysis-parameter-two-label : text ;
  slot schematic-analysis-parameter-two-value : text ;
  slot schematic-analysis-parameter-two-disabled : bool ;
  slot schematic-analysis-parameter-three-label : text ;
  slot schematic-analysis-parameter-three-value : text ;
  slot schematic-analysis-parameter-three-disabled : bool ;
  slot schematic-grid-label : text ;
  slot schematic-grid-lines : list<list<number>> ;
  slot schematic-wire-segments : list<list<number>> ;
  slot schematic-terminal-points : list<list<number>> ;
  slot selected-schematic-label : text ;
  slot schematic-properties-label : text ;
  slot selected-schematic-kind-label : text ;
  slot schematic-value-label : text ;
  slot schematic-value : text ;
  slot schematic-value-placeholder : text ;
  slot schematic-value-disabled : bool ;
  slot route-schematic-label : text ;
  slot synchronize-schematic-label : text ;
  slot analysis-label : text ;
  slot analysis-rows : list<list<text>> ;
  slot selected-analysis-label : text ;
  slot result-label : text ;
  slot result-columns : list<text> ;
  slot result-rows : list<list<text>> ;
  slot waveform-label : text ;
  slot waveform-rows : list<text> ;
  slot selected-waveform-label : text ;
  slot waveform-axis-label : text ;
  slot waveform-segments : list<list<number>> ;
  slot raw-result-label : text ;
  slot result-text : text ;

  emit onNetlistChange ( value : text ) ;
  emit onInspect ;
  emit onRun ;
  emit onPlaceSchematicComponent ( kind : text ) ;
  emit onAddSchematicAnalysis ( analysis : text ) ;
  emit onSelectSchematicAnalysis ( analysis : text ) ;
  emit onSelectSchematicAnalysisCard ( index : number ) ;
  emit onRemoveSchematicAnalysisCard ;
  emit onSelectSchematicAnalysisSource ( reference : text ) ;
  emit onSchematicAnalysisParameterOneChange ( value : text ) ;
  emit onSchematicAnalysisParameterTwoChange ( value : text ) ;
  emit onSchematicAnalysisParameterThreeChange ( value : text ) ;
  emit onSelectSchematicComponent ( reference : text ) ;
  emit onSchematicValueChange ( value : text ) ;
  emit onRouteToSchematicComponent ( reference : text ) ;
  emit onSynchronizeSchematic ;
  emit onSelectAnalysis ( index : number ) ;
  emit onSelectWaveform ( index : number ) ;
}
