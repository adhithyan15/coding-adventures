          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "qal'e is borrowed from Arabic qal'a, \"fort, fortress\" (EtymDB), and EtymDB in turn connects the Arabic word with Persian kalât \"fortress\"."
            }
          ]
