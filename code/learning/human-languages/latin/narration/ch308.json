          "segments": [
            {
              "kind": "speech",
              "text": "iūs, iūris — \"law, right; justice\"."
            },
            {
              "kind": "speech",
              "text": "Omnēs cīvēs eadem iūra habēbant. All the citizens had the same rights."
            },
            {
              "kind": "speech",
              "text": "Neuter, 3rd declension. Iūs is law and right as a whole; a lēx is one law. A look-alike iūs means 'broth'."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "iūs is inherited from Proto-Indo-European h₂yéwos, \"law, right\" (EtymDB). English jury, justice and jurist come from its family."
            }
          ]
        },
