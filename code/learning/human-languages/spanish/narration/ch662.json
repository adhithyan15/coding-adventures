          "segments": [
            {
              "kind": "speech",
              "text": "modificar — \"to change, to modify\"."
            },
            {
              "kind": "speech",
              "text": "¿Puedo modificar la fecha de la reserva? Can I change the date of the booking?"
            },
            {
              "kind": "speech",
              "text": "The c becomes qu before e: modifiqué. Formal, common on booking sites."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "modificar is a learned borrowing from Latin modificāre \"to set limits to, to regulate\" (Lewis & Short; EtymDB), built from modus \"measure\" and facere \"to make\"."
            }
          ]
        },
