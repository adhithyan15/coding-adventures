        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: das Gemälde",
          "segments": [
            {
              "kind": "speech",
              "text": "das Gemälde — \"painting\"."
            },
            {
              "kind": "speech",
              "text": "Im Museum hängt ein berühmtes Gemälde aus dem Mittelalter. A famous painting from the Middle Ages hangs in the museum."
            },
            {
              "kind": "speech",
              "text": "Plural: die Gemälde. Built on malen — to paint."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Gemälde is built on malen \"to paint\", from Old High German mālōn \"to mark, to paint\"; EtymDB lists the noun without a source."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
