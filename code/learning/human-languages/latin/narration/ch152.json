            {
              "kind": "speech",
              "text": "Before the new one: say the Latin for ugly, then the Latin for beautiful."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: validus, valida, validum",
          "segments": [
            {
              "kind": "speech",
              "text": "validus, valida, validum — \"strong\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "validus is built on valeō, \"to be strong\" (Lewis & Short), with -idus, the ending of state adjectives. valeō is usually traced to Proto-Indo-European h2welh1-, \"to be strong, to rule\" (EtymDB 2.1)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
