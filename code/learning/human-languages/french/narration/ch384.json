        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: expirer",
          "segments": [
            {
              "kind": "speech",
              "text": "expirer — \"to expire; to breathe out\"."
            },
            {
              "kind": "speech",
              "text": "Mon passeport expire au mois de mai. My passport expires in May."
            },
            {
              "kind": "speech",
              "text": "Of breathing: inspirer, then expirer."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "expirer is a learned borrowing from Latin exspīrāre \"to breathe out, to die away\" (EtymDB; Lewis & Short), built on spīrāre \"to breathe\"."
            }
          ]
        },
        {
          "index": 3,
