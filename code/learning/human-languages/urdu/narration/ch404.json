        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: غسل خانہ",
          "segments": [
            {
              "kind": "speech",
              "text": "غسل خانہ — ghusl khānā — \"a washroom; a bathroom\"."
            },
            {
              "kind": "speech",
              "text": "کمرے کے ساتھ ایک غسل خانہ ہے۔ kamre ke sāth ek ghusl khānā hai. There is a washroom next to the room."
            },
            {
              "kind": "speech",
              "text": "Masculine."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "غسل خانہ (ghusl khānā) is built from ghusl, \"washing\", usually traced to Arabic ghusl, and Persian khāna, \"a house, a room\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for getting around."
