# Python 2.6 (2008-10-01) tokens: py2-int-print lexical slice.
# @version 1
# PARTIAL: lexes only the py2-int-print neighbourhood listed below; see code/grammars/python/README.md.
# source_ref: https://github.com/python/cpython/tree/v2.6
# source_sha: 5927786e61c62bd6b28031f5f9b851411cf1cb00
# evidence: Grammar/Grammar blob 865d44c19d1ffd8bfa901138e4998dee3fe0c24c; Grammar/Tokens blob -;
#   Parser/tokenizer.c blob 1d0a4aa3f23b438dc5c17185bbd973130582f436; Lib/keyword.py blob 8eb2860307e5b4bc4bd05287fbb23ae6ca6bcb11
# basis: reviewed against the tag's own syntax files (LANG84 phase 7c slice 2). Tokens follow tokenizer.c tok_get (decimal, octal 0[0-7]*, hex 0x, 0o and 0b, each with an optional l/L suffix) and PyToken_OneChar/TwoChars/ThreeChars (45 operators), and keyword.py kwlist (31, `print` among them); the grammar follows Grammar/Grammar file_input..print_stmt..atom/trailer/arglist.

# ---------------------------------------------------------------------------
# What this pair lexes, and what it does not, so a reader never has to guess.
#
# Lexed: integers in every spelling this release's tokenizer reads as an int
# or a long (decimal `42`, octal `010`, hex `0x1F`, `0o17` and `0b101`, each
# with an optional `l`/`L` long suffix), names, this release's keywords
# (`print` is one: in Python 2 `print` is a statement, not a function), every
# operator and delimiter its tokenizer knows (including `<>` and the
# backquote, which Python 3 removed), `#` comments, a `\`-newline
# continuation, and the indentation engine's NEWLINE/INDENT/DEDENT (newlines
# inside brackets are suppressed, blank and comment-only lines produce
# nothing).
#
# NOT lexed (a lexer error here; later LANG84 Python slices):
#   strings and unicode literals      'a' "a" u'a' r'a'
#   floats and imaginary numbers      1.5 1e3 .5 2j       (`1.5` lexes as INT DOT INT
#                                                          and fails to parse)
#   tabs before a comment, form feeds
#
# Known narrowings against the release's own tokenizer (each rejects; none
# accepts a program the release would read differently):
#   * A number must not run into a name character: `1if`, `1_`, `0x1Fg` and
#     `0o8` are lexer errors (`\b` closes INT). The release reports `0o8` and
#     `0b2` as errors too, and splits `1if` into `1` and `if`.
#   * `\` must be followed directly by the newline, as CPython requires.
# ---------------------------------------------------------------------------

mode: indentation

skip:
  COMMENT           = /#[^\n]*/
  LINE_CONTINUATION = /\\\n/

# --- integers (tok_get in Parser/tokenizer.c; parsenumber in Python/ast.c) --
# Python 2 spellings, each with an optional `l`/`L` suffix that makes a long:
#
#   decimal  [1-9][0-9]*           1  42  7L
#   octal    0[0-7]*               0  00  010 (= 8)  0777L
#   hex      0[xX][0-9a-fA-F]+     0x1F  0XffL
#   octal    0[oO][0-7]+           0o17  0O17L     (PEP 3127, 2.6)
#   binary   0[bB][01]+            0b101  0B1L     (PEP 3127, 2.6)
#
# A decimal digit after a leading `0` (`08`, `0178`) is the tokenizer's
# ERRORTOKEN, and here a lexer error. There is no `_` separator (that is PEP
# 515, Python 3.6). Which value a spelling denotes is the compiler's job
# (python-iir-compiler int_lower.rs, profile `py2`), which refuses a literal
# above i64.
INT = /(?:0[xX][0-9a-fA-F]+|0[oO][0-7]+|0[bB][01]+|0[0-7]*|[1-9][0-9]*)[lL]?\b/

# --- names -------------------------------------------------------------------
NAME = /[a-zA-Z_][a-zA-Z0-9_]*/

# --- operators and delimiters (45 in this release's tokenizer) --------
# Longest first: the first matching pattern wins.
DOUBLE_STAR_EQUALS  = "**="
LEFT_SHIFT_EQUALS   = "<<="
RIGHT_SHIFT_EQUALS  = ">>="
FLOOR_DIV_EQUALS    = "//="
DOUBLE_STAR         = "**"
FLOOR_DIV           = "//"
LEFT_SHIFT          = "<<"
RIGHT_SHIFT         = ">>"
EQUALS_EQUALS       = "=="
NOT_EQUALS          = "!="
LEGACY_NOT_EQUALS   = "<>"
LESS_EQUALS         = "<="
GREATER_EQUALS      = ">="
PLUS_EQUALS         = "+="
MINUS_EQUALS        = "-="
STAR_EQUALS         = "*="
SLASH_EQUALS        = "/="
PERCENT_EQUALS      = "%="
AMP_EQUALS          = "&="
PIPE_EQUALS         = "|="
CARET_EQUALS        = "^="
PLUS                = "+"
MINUS               = "-"
STAR                = "*"
SLASH               = "/"
PERCENT             = "%"
EQUALS              = "="
LESS_THAN           = "<"
GREATER_THAN        = ">"
AMP                 = "&"
PIPE                = "|"
CARET               = "^"
TILDE               = "~"
BACKTICK            = "`"
AT                  = "@"
LPAREN              = "("
RPAREN              = ")"
LBRACKET            = "["
RBRACKET            = "]"
LBRACE              = "{"
RBRACE              = "}"
COMMA               = ","
COLON               = ":"
SEMICOLON           = ";"
DOT                 = "."

# --- keywords (kwlist of Lib/keyword.py at the tag: 31) ------------------
keywords:
  and
  as
  assert
  break
  class
  continue
  def
  del
  elif
  else
  except
  exec
  finally
  for
  from
  global
  if
  import
  in
  is
  lambda
  not
  or
  pass
  print
  raise
  return
  try
  while
  with
  yield
