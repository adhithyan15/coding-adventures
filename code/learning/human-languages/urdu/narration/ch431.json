          "title": "You'll want to know: ابر",
          "segments": [
            {
              "kind": "speech",
              "text": "ابر — abr — \"a rain cloud; cloud (formal)\"."
            },
            {
              "kind": "speech",
              "text": "آسمان پر ابر ہے۔ āsmān par abr hai. The sky is overcast."
            },
            {
              "kind": "speech",
              "text": "Masculine."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ابر (abr) is usually traced to Persian abr, \"a cloud\"; it is a more formal word than بادل."
            }
          ]
        },
