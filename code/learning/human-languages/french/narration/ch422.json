          "segments": [
            {
              "kind": "speech",
              "text": "la traversée — \"the crossing (by sea)\"."
            },
            {
              "kind": "speech",
              "text": "La traversée dure quatre heures. The crossing takes four hours."
            },
            {
              "kind": "speech",
              "text": "Built on traverser 'to cross'."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "traversée is built on traverser 'to cross', which goes back to Latin trānsversus 'lying across', from vertere 'to turn' (Lewis & Short). EtymDB does not list the noun."
            }
          ]
        },
