            {
              "kind": "speech",
              "text": "Before the new one: say the Marathi for a suburb, then the Marathi for up."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: नक्की",
          "segments": [
            {
              "kind": "speech",
              "text": "नक्की — nakkī — \"certainly, for sure\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "The origin of नक्की (nakkī) is not settled. Neither CDIAL nor DEDR, searched by form and by meaning, has an entry for it."
            }
