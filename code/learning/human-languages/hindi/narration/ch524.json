              "source": "[YOU SAY: *galānā*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "galānā, once more",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *galānā*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "Dāl ko pūrī tarah galāie. — Cook the dal until it is completely soft.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *Dāl ko pūrī tarah galāie.* — Cook the dal until it is completely soft.]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say the Hindi for to sprinkle (a powder), then the Hindi for to grind coarsely, then say galānā again",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say the Hindi for to sprinkle (a powder), then the Hindi for to grind coarsely, then say *galānā* again]"
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
