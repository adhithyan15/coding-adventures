        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: wàipó",
          "segments": [
            {
              "kind": "speech",
              "text": "wàipó — \"grandma on the mother's side\"."
            },
            {
              "kind": "speech",
              "text": "wǒ zài wàipó jiā zhù le yí ge yuè — I stayed at my grandma's for a month."
            },
            {
              "kind": "speech",
              "text": "Its characters come later; for now it is a word for the ear."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "wàipó is built from 外 'outside' and pó 'an old woman', both inherited from Middle Chinese, ngwajH and ba (Guangyun, in Baxter's transcription), which glosses the second 'a name for an old mother'."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for saying how it was."
