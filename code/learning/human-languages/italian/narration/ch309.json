          "index": 1,
          "type": "input",
          "title": "You'll want to know: la giovinezza",
          "segments": [
            {
              "kind": "speech",
              "text": "la giovinezza — \"youth (the time of life)\"."
            },
            {
              "kind": "speech",
              "text": "Nella mia giovinezza ho vissuto al mare. In my youth I lived by the sea."
            },
            {
              "kind": "speech",
              "text": "Built on giovane, ‘young’."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "giovinezza is built on giovine, an old form of giovane \"young\", from Latin iuvenis (Lewis & Short)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
