              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: **se** — three]"
            },
            {
              "kind": "prompt",
              "action": "CONNECT",
              "instruction": "se from tréyes becomes English three, Latin trēs",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
