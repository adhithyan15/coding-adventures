        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: कार्यम्",
          "segments": [
            {
              "kind": "speech",
              "text": "कार्यम् — kāryam — \"work, a task\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "kārya is the gerundive of the root √kṛ \"do, make\" (CDIAL 3078): \"to be done\", and so \"a task, work, business\" (MW). It lives on as Hindi and Bengali kāj \"work\" (CDIAL 3078)."
            }
          ]
        },
        {
