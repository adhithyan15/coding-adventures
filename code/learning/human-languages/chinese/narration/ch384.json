    {
      "id": "ZH-W384-cheng-become",
      "sequence": 29525,
      "title": "成 (chéng) — a bar, a fall, a small turn, then the slanting hook of 我",
      "headword": "成",
      "romanization": "chéng",
      "gloss": "成 — a bar, a long fall, a small turn, the slanting hook, a fall and a dot",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:8851d20082248f53",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — a bar, a fall, a small turn, then the slanting hook of 我",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — a bar, a fall, a small turn, then the slanting hook of 我 and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say chéngwéi — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *chéngwéi* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "我 为."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — wǒ, wéi",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *wǒ*, *wéi*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — a bar, a fall, a small turn, then the slanting hook of 我",
          "segments": [
            {
              "kind": "speech",
              "text": "成 (chéng)."
            },
            {
              "kind": "speech",
              "text": "One shape, six strokes in a fixed order. The order is the thing to hold."
            },
            {
              "kind": "speech",
              "text": "A bar, left to right, from the left edge to past the middle."
            },
            {
              "kind": "speech",
              "text": "A long stroke falling to the left from the left end of the bar down to the foot."
            },
            {
              "kind": "speech",
              "text": "A small turning hook under the bar: a short bar that turns down and hooks to the left."
            },
            {
              "kind": "speech",
              "text": "The long slanting hook, as in 我: from the top, a long stroke down to the lower right that flicks up at the end. Then a short stroke falling to the left across it, and a dot at the upper right."
            },
            {
              "kind": "speech",
              "text": "Six strokes in all."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "成 (chéng), all six, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 成, all six, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many strokes in 成 (chéng)? (Six.) Which stroke flicks up at the end? (The long slanting hook, the fourth.) What comes last? (The dot at the upper right.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 成 (chéng), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
