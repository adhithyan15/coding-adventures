          "segments": [
            {
              "kind": "speech",
              "text": "accuser — \"to accuse\"."
            },
            {
              "kind": "speech",
              "text": "Ils l'accusent d'avoir volé un vélo. They accuse him of stealing a bike."
            },
            {
              "kind": "speech",
              "text": "Accuser quelqu'un de quelque chose."
            }
