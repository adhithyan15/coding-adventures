      "id": "HI-C50-gratitude",
      "sequence": 1600,
      "title": "आभार (ābhār) — gratitude",
      "headword": "आभार",
      "romanization": "ābhār",
      "gloss": "gratitude",
      "script": "devanagari",
      "modality": "voice",
      "derivedModality": "voice",
