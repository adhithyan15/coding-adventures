{
  "name": "wave",
  "version": "0.1.0",
  "description": "Simple harmonic wave model for electromagnetic wave fundamentals",
  "type": "module",
  "main": "dist/wave.js",
  "types": "dist/wave.d.ts",
  "exports": {
    ".": {
      "types": "./dist/wave.d.ts",
      "import": "./dist/wave.js"
    },
    "./src/wave": {
      "types": "./dist/wave.d.ts",
      "import": "./dist/wave.js"
    }
  },
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc",
    "test": "node node_modules/typescript/bin/tsc -p tsconfig.test.json && node --experimental-test-coverage --test-coverage-exclude=../** --test-coverage-exclude=dist-test/tests/** --test-coverage-lines=95 --test dist-test/tests/*.test.js"
  },
  "license": "MIT",
  "author": "Adhithya Rajasekaran",
  "dependencies": {
    "trig": "file:../trig"
  },
  "devDependencies": {
    "@coding-adventures/test-bootstrap": "file:../test-bootstrap",
    "@types/node": "^24.0.0",
    "typescript": "^5.0.0"
  }
}
