          "segments": [
            {
              "kind": "speech",
              "text": "accēdō, accēdere — \"to come near, to approach; to be added\"."
            },
            {
              "kind": "speech",
              "text": "Nāvis ad portum accēdit. The ship comes near the harbour."
            },
            {
              "kind": "speech",
              "text": "accēdō, accēdere, accessī, accessum, with ad and the accusative. English access and accede come from it."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "accēdō is built from ad- 'towards' and cēdō 'to go' (EtymDB; Lewis & Short). English access and accede come from it."
            }
          ]
        },
