              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Malayalam for a pig, then the Malayalam for a lion."
            },
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "speech",
              "text": "Say \"good morning,\" and name the neighbour that uses the same word. (Suprabhātaṁ; Telugu.)"
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: എലി",
          "segments": [
            {
              "kind": "speech",
              "text": "എലി — eli — \"a rat, a mouse\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "എലി (eli) is native Dravidian, one word with Tamil eli, Kannada eli and Telugu eluka (DEDR 833)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
