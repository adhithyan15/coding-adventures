          "segments": [
            {
              "kind": "speech",
              "text": "хостел (khóstel) — \"a hostel\"."
            },
            {
              "kind": "speech",
              "text": "Студенты жили в недорогом хостеле. Studénty zhíli v nedorogóm khóstele. The students stayed in a cheap hostel."
            },
            {
              "kind": "speech",
              "text": "Masculine; the stress is on the first syllable."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "хостел (khóstel) is usually traced to English hostel, which EtymDB traces through Old French to Latin hospitāle, a place for guests. EtymDB does not list the Russian word."
            }
          ]
        },
