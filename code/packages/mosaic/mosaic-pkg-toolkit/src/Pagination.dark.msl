// Pagination.dark.msl — dark-theme styling.

style Pagination {
  part pagination {
    padding : 0 ;
  }
  part pagination-prev {
    padding       : 8 ;
    background    : "#1f2937" ;
    color         : "#60a5fa" ;
    border-width  : 1 ;
    border-color  : "#374151" ;
    font-size     : 14 ;
    border-radius : 0 ;
  }
  part pagination-page {
    padding       : 8 ;
    background    : "#1f2937" ;
    color         : "#60a5fa" ;
    border-width  : 1 ;
    border-color  : "#374151" ;
    font-size     : 14 ;
    border-radius : 0 ;
  }
  part pagination-next {
    padding       : 8 ;
    background    : "#1f2937" ;
    color         : "#60a5fa" ;
    border-width  : 1 ;
    border-color  : "#374151" ;
    font-size     : 14 ;
    border-radius : 0 ;
  }
}
