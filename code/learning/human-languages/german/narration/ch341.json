          "segments": [
            {
              "kind": "speech",
              "text": "allerdings — \"however; certainly\"."
            },
            {
              "kind": "speech",
              "text": "Die Wohnung ist schön. Allerdings ist die Küche sehr klein. The flat is nice. However, the kitchen is very small."
            },
            {
              "kind": "speech",
              "text": "When it opens the sentence, the verb comes right after it: Allerdings ist …. As an answer it means certainly: Allerdings!"
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "allerdings grew out of the genitive aller Dinge \"of all things\", built on Ding \"thing\", from Old High German ding \"assembly\" and Proto-Germanic þingą (EtymDB), with the adverb ending -s."
            }
          ]
        },
