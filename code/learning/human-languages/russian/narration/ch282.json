          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "слух (slukh) is inherited from Proto-Slavic sluxŭ \"hearing\", from PIE ḱlew- \"to hear\" (EtymDB): what people have heard."
            }
          ]
        },
