        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: anstecken",
          "segments": [
            {
              "kind": "speech",
              "text": "anstecken — \"to infect, to pass on (an illness)\"."
            },
            {
              "kind": "speech",
              "text": "Mein Bruder hat mich mit seiner Grippe angesteckt. My brother gave me his flu."
            },
            {
              "kind": "speech",
              "text": "Separable: er steckt mich an. Sich anstecken — to catch something. Also to pin on: eine Brosche anstecken."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "anstecken is built on an \"on\" and stecken \"to put, to stick\", inherited from Old High German steckōn (EtymDB)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
