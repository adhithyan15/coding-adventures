  "lessons": [
    {
      "id": "GU-C148-me-pidhi",
      "sequence": 7800,
      "title": "મેં ચા પીધી — the past that agrees with the thing",
      "headword": "મેં … પીધી",
      "romanization": "mẽ … pīdhī",
      "gloss": "I drank: with a verb that has an object, the doer is marked and the verb agrees with the object",
      "script": "gujarati",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:589604caa11a04c6",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Say I went and she came. Then three old words: પીવું, to drink; ચા, tea; પાણી, water."
            }
          ]
        },
        {
          "index": 1,
          "type": "grammar",
          "title": "Grammar Lens: હું becomes મેં",
          "segments": [
            {
              "kind": "speech",
              "text": "હું ગયો keeps I in its plain form. A verb that does something to something, like drinking tea or eating rice, changes that in the past: the doer is marked, and હું becomes મેં (mẽ)."
            },
            {
              "kind": "speech",
              "text": "મેં ચા પીધી. — mẽ cā pīdhī. — I drank tea."
            },
            {
              "kind": "speech",
              "text": "મેં is the same for a man and a woman. The verb has stopped listening to the drinker."
            }
          ]
        },
        {
          "index": 2,
          "type": "input",
          "title": "You'll want to know: the verb follows the tea",
          "segments": [
            {
              "kind": "speech",
              "text": "પીધી ends in -ી because ચા is feminine. Change the drink and the verb changes with it:"
            },
            {
              "kind": "speech",
              "text": "મેં ચા પીધી. — mẽ cā pīdhī — tea, feminine;"
            },
            {
              "kind": "speech",
              "text": "મેં પાણી પીધું. — mẽ pāṇī pīdhũ — water, neuter;"
            },
            {
              "kind": "speech",
              "text": "મેં દૂધ પીધું. — mẽ dūdh pīdhũ — milk, neuter."
            },
            {
              "kind": "speech",
              "text": "This is the agreement મારી ચા showed you: the ending follows the thing. English has nothing like it, so it is worth saying slowly a few times."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "mẽ cā pīdhī",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *mẽ cā pīdhī*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "mẽ dūdh pīdhũ",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *mẽ dūdh pīdhũ*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "મેં તમારી ચા પીધી! — mẽ tamārī cā pīdhī!, I drank your tea!",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: **મેં તમારી ચા પીધી!** — *mẽ tamārī cā pīdhī!*, I drank your tea!]"
            },
            {
              "kind": "prompt",
              "action": "CONTRAST",
              "instruction": "hũ gayo and mẽ cā pīdhī: which verb follows the doer, and which the drink",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU CONTRAST: *hũ gayo* and *mẽ cā pīdhī*: which verb follows the doer, and which the drink]"
            },
            {
              "kind": "activity",
              "scored": true,
              "spoken": true,
              "id": "GU-C148-me-pidhi-r1",
              "prompt": "Say that you drank water, then that you drank tea.",
              "assesses": [
                "GU-GRAMMAR-C148-ERGATIVE-01",
                "GU-GRAMMAR-C148-OBJECT-AGREE-01"
              ],
              "responseSeconds": 20,
              "acceptedResponses": [
                "mẽ pāṇī pīdhũ; mẽ cā pīdhī",
                "મેં પાણી પીધું. મેં ચા પીધી.",
                "mẽ pāṇī pīdhũ, mẽ cā pīdhī"
              ],
              "feedback": {
                "correct": "mẽ both times; the verb follows the drink.",
                "incorrect": "Start with mẽ, then let the drink choose: pāṇī pīdhũ, cā pīdhī."
              }
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What does હું become before a past verb with an object? (મેં.) What does that verb agree with? (The object: ચા gives પીધી.)"
            }
          ]
        }
      ]
    },
    {
      "id": "GU-C148-tene",
      "sequence": 7810,
      "title": "તેણે, તેમણે — who did it",
      "headword": "મેં · તેં · તેણે · અમે · તમે · તેમણે",
      "romanization": "mẽ · tẽ · teṇe · ame · tame · temṇe",
      "gloss": "who did it: the doer's form for each person in the object past",
      "script": "gujarati",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:4da4b12a345651e7",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Say I drank tea and I drank water, and say why the two verbs end differently."
            }
          ]
        },
        {
          "index": 1,
          "type": "grammar",
          "title": "Grammar Lens: one person",
          "segments": [
            {
              "kind": "table",
              "headers": [
                "who",
                "plain",
                "in the object past"
              ],
              "columns": 3,
              "rowCount": 3,
              "utterances": [
                "who: I. plain: હું. in the object past: મેં.",
                "who: you (familiar). plain: તું. in the object past: તેં.",
                "who: he, she. plain: તે. in the object past: તેણે."
              ]
            },
            {
              "kind": "speech",
              "text": "તેણે ચા પીધી. — teṇe cā pīdhī. — He drank tea. She drank tea."
            },
            {
              "kind": "speech",
              "text": "તેણે is the form CDIAL records for Gujarati under the old Sanskrit stem ta- (CDIAL 5612), the stem behind તે and તેઓ."
            }
          ]
        },
        {
          "index": 2,
          "type": "grammar",
          "title": "Grammar Lens: more than one",
          "segments": [
            {
              "kind": "table",
              "headers": [
                "who",
                "plain",
                "in the object past"
              ],
              "columns": 3,
              "rowCount": 3,
              "utterances": [
                "who: we. plain: અમે. in the object past: અમે.",
                "who: you (respectful). plain: તમે. in the object past: તમે.",
                "who: they. plain: તેઓ. in the object past: તેમણે."
              ]
            },
            {
              "kind": "speech",
              "text": "અમે and તમે do not change at all: અમે ચા પીધી, તમે પાણી પીધું. Only તેઓ moves, to તેમણે, built on the તેમ- of તેમને."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "teṇe pāṇī pīdhũ",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *teṇe pāṇī pīdhũ*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "તમે ચા પીધી? — tame cā pīdhī?, did you drink tea?",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: **તમે ચા પીધી?** — *tame cā pīdhī?*, did you drink tea?]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "તેમણે દૂધ પીધું — temṇe dūdh pīdhũ",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: **તેમણે દૂધ પીધું** — *temṇe dūdh pīdhũ*]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Which two doers keep their plain form? (અમે and તમે.) What does તેઓ become? (તેમણે.)"
            }
          ]
        }
      ]
    },
    {
      "id": "GU-C148-karyun",
      "sequence": 7820,
      "title": "કર્યું — the regular past: stem and -્યું",
      "headword": "કર્યું · આપ્યું · જોયું · કહ્યું",
      "romanization": "karyũ · āpyũ · joyũ · kahyũ",
      "gloss": "the regular object past: the stem, then -yũ",
      "script": "gujarati",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:349200d4cb7e3c18",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Say she drank tea and they drank milk. Then કામ કરવું, to work, to do work."
            }
          ]
        },
        {
          "index": 1,
          "type": "grammar",
          "title": "Grammar Lens: -્યું on the stem",
          "segments": [
            {
              "kind": "speech",
              "text": "Most verbs build this past in one move: take the stem and add -્યું, a virama and then યું, so the stem's last consonant joins the ય."
            },
            {
              "kind": "speech",
              "text": "કર- becomes કર્યું — karyũ — did (the ર rides on top as a small hook);"
            },
            {
              "kind": "speech",
              "text": "આપ- becomes આપ્યું — āpyũ — gave;"
            },
            {
              "kind": "speech",
              "text": "લખ- becomes લખ્યું — lakhyũ — wrote;"
            },
            {
              "kind": "speech",
              "text": "કહ- becomes કહ્યું — kahyũ — said;"
            },
            {
              "kind": "speech",
              "text": "જો- becomes જોયું — joyũ — saw (a stem ending in a vowel takes યું with no virama)."
            },
            {
              "kind": "speech",
              "text": "મેં કામ કર્યું. — mẽ kām karyũ. — I did the work. તેણે પત્ર લખ્યો. — teṇe patra lakhyo. — She wrote a letter. મેં તેને પૈસા આપ્યા. — mẽ tene paisā āpyā. — I gave him the money. તેણે મને પત્ર આપ્યો. — teṇe mane patra āpyo. — She gave me a letter. મેં બે ફોન કર્યા. — mẽ be phon karyā. — I made two phone calls."
            },
            {
              "kind": "speech",
              "text": "The four endings again: -્યો, -ી, -્યું, -્યા. પત્ર is masculine, so લખ્યો; પૈસા is plural, so આપ્યા. In the feminine the ય drops: કરી, આપી, જોઈ."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "mẽ kām karyũ",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *mẽ kām karyũ*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "teṇe patra lakhyo",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *teṇe patra lakhyo*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "mẽ tene paisā āpyā",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *mẽ tene paisā āpyā*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "તેમણે શું કહ્યું? — temṇe śũ kahyũ?, what did they say?",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: **તેમણે શું કહ્યું?** — *temṇe śũ kahyũ?*, what did they say?]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What is added to a stem like કર- to make this past? (-્યું.) Why લખ્યો in she wrote a letter? (પત્ર is masculine.)"
            }
          ]
        }
      ]
    },
    {
      "id": "GU-C148-lidhun",
      "sequence": 7830,
      "title": "લીધું, ખાધું, પીધું — three pasts in -ધું",
      "headword": "લીધું · ખાધું · પીધું",
      "romanization": "līdhũ · khādhũ · pīdhũ",
      "gloss": "the three object pasts in -dhũ: took, ate, drank",
      "script": "gujarati",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:41f8d433128edeb2",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Say I did the work and she wrote a letter. Then લેવું, to take, and ખાવું, to eat."
            }
          ]
        },
        {
          "index": 1,
          "type": "grammar",
          "title": "Grammar Lens: -ધું",
          "segments": [
            {
              "kind": "speech",
              "text": "પીધું has been doing this since the first lesson of the chapter. Three short, common verbs share it: instead of -્યું they take -ધું."
            },
            {
              "kind": "speech",
              "text": "લેવું becomes લીધું — līdhũ — took;"
            },
            {
              "kind": "speech",
              "text": "ખાવું becomes ખાધું — khādhũ — ate;"
            },
            {
              "kind": "speech",
              "text": "પીવું becomes પીધું — pīdhũ — drank."
            },
            {
              "kind": "speech",
              "text": "Their endings are the usual four: ખાધો, ખાધી, ખાધું, ખાધા."
            },
            {
              "kind": "speech",
              "text": "મેં ભાત ખાધો. — mẽ bhāt khādho. — I ate rice. તેણે રોટલી ખાધી. — teṇe roṭlī khādhī. — She ate a roṭlī. મેં ટિકિટ લીધી. — mẽ ṭikiṭ līdhī. — I took a ticket. તેણે ભાત લીધો. — teṇe bhāt līdho. — He took some rice. તેણે દવા લીધી. — teṇe davā līdhī. — He took the medicine."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
