# Perl 5.003_17 (1996-12-27) tokens: plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: this does not lex all Perl 5.003_17 source.
# Evidence: https://github.com/Perl/perl5/blob/perl-5.003_17/toke.c
# The tagged tokenizer changes lex-end extraction cleanup outside this
# plain-decimal subset. Multi-digit leading-zero forms remain refused.

PRINT     = "print"
INT       = /0|[1-9][0-9]*/
PLUS      = "+"
DECREMENT = "--"
MINUS     = "-"
STAR      = "*"
LPAREN    = "("
RPAREN    = ")"
SEMICOLON = ";"

skip:
  WHITESPACE = /[ \t\r\n]+/
