        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: el rasgo",
          "segments": [
            {
              "kind": "speech",
              "text": "el rasgo — \"the trait, the feature\"."
            },
            {
              "kind": "speech",
              "text": "La paciencia es su mejor rasgo. Patience is her best trait."
            },
            {
              "kind": "speech",
              "text": "Los rasgos are also facial features: rasgos finos."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "rasgo is built on rasgar \"to tear\", which is usually traced to Latin resecāre \"to cut off\", from secāre \"to cut\". A rasgo was first a stroke of the pen, then a feature."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
