          "segments": [
            {
              "kind": "speech",
              "text": "سرنخ (sarnakh) — \"a clue, a lead\"."
            },
            {
              "kind": "speech",
              "text": "پلیس هنوز هیچ سرنخی ندارد. Polis hanuz hich sarnakhi nadârad. The police still have no clue."
            },
            {
              "kind": "speech",
              "text": "Literally \"the end of the thread\": sar \"head, end\" + nakh \"thread\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "sarnakh joins sar \"head, end\" and nakh \"thread\", both native Persian: the loose end that leads to the rest. EtymDB lists no entry."
            }
          ]
        },
