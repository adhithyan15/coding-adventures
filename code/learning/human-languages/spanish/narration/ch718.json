        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: guiñar",
          "segments": [
            {
              "kind": "speech",
              "text": "guiñar — \"to wink\"."
            },
            {
              "kind": "speech",
              "text": "Me guiñó un ojo y sonreí. He winked at me and I smiled."
            },
            {
              "kind": "speech",
              "text": "Guiñar un ojo — to wink. Un guiño — a wink."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "For guiñar the origin is not settled; a Germanic source has been suggested, and some see an imitative word, but none is proved."
            }
          ]
        },
        {
