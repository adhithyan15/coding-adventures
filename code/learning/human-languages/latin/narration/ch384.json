          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "candidātus is built on candidus \"shining white\" (EtymDB; Lewis & Short): dressed in white. English candidate comes from it."
            }
          ]
        },
