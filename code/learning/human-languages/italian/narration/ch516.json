          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "violoncello is built on violone \"a large viol\" with -cello, a little ending (EtymDB): a smaller version of the big viol."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
