          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "molo is inherited from Latin mōlēs 'mass, heap, rock' (EtymDB), which could also mean a massive stone structure such as a dam or a pier (Lewis & Short)."
            }
          ]
        },
