        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: sposarsi",
          "segments": [
            {
              "kind": "speech",
              "text": "sposarsi — \"to get married\"."
            },
            {
              "kind": "speech",
              "text": "Ci siamo sposati in un piccolo paese. We got married in a small village."
            },
            {
              "kind": "speech",
              "text": "Sposare qualcuno — to marry someone."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "sposarsi is built on sposo \"bridegroom\", inherited from Latin spōnsus \"one promised\", from spondēre \"to promise solemnly\" (Lewis & Short)."
            }
          ]
        },
        {
