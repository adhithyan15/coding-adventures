          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "scusa is built on scusare \"to excuse\", inherited from Latin excūsāre \"to free from a charge\" (Lewis & Short), built from ex \"out of\" and causa \"a case, a charge\"."
            }
          ]
