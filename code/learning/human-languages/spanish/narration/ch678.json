        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: visitar",
          "segments": [
            {
              "kind": "speech",
              "text": "visitar — \"to visit\"."
            },
            {
              "kind": "speech",
              "text": "Queremos visitar el museo mañana. We want to visit the museum tomorrow."
            },
            {
              "kind": "speech",
              "text": "For people, use a: visitar a mis abuelos."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "visitar comes from Latin vīsitāre \"to see, to go to see\" (Lewis & Short; EtymDB), built on vīsere \"to go and see\", from vidēre \"to see\"."
            }
          ]
        },
        {
