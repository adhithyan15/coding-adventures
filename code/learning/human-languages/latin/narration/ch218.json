        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: passus, passūs",
          "segments": [
            {
              "kind": "speech",
              "text": "passus, passūs — \"a pace\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "passus is built on pandō, \"to spread out, to stretch\" (EtymDB 2.1): a pace as the stretch of the legs. A Roman mile was mīlle passūs, \"a thousand paces\"."
            }
          ]
        },
