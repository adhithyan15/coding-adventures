          "type": "input",
          "title": "You'll want to know: zaubern",
          "segments": [
            {
              "kind": "speech",
              "text": "zaubern — \"to conjure, to do magic\"."
            },
            {
              "kind": "speech",
              "text": "Der Zauberer zauberte eine Blume aus dem Hut. The magician conjured a flower out of the hat."
            },
            {
              "kind": "speech",
              "text": "Regular: zauberte, hat gezaubert."
            }
          ]
        },
