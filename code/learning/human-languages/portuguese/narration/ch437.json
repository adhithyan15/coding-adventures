          "type": "input",
          "title": "You'll want to know: a avenida",
          "segments": [
            {
              "kind": "speech",
              "text": "a avenida — \"the avenue\"."
            },
            {
              "kind": "speech",
              "text": "A avenida principal tem muitas lojas. The main avenue has a lot of shops."
            },
            {
              "kind": "speech",
              "text": "Shortened to Av. in addresses."
