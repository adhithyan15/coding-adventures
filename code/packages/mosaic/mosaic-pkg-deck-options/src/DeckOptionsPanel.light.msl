// DeckOptionsPanel.light.msl - light deck options theme.

style DeckOptionsPanel {
  part deck-options-panel {
    background : "#f8fafc" ;
    border-color : "#b45309" ;
    border-width : 1 ;
    padding : 14 ;
  }

