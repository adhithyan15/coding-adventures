        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: abonar",
          "segments": [
            {
              "kind": "speech",
              "text": "abonar — \"to pay; to credit\"."
            },
            {
              "kind": "speech",
              "text": "Puede abonar la cantidad con tarjeta. You can pay the amount by card."
            },
            {
              "kind": "speech",
              "text": "Formal, on bills and notices. It also means to fertilise."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "abonar is built on bueno, inherited from Latin bonus 'good' (EtymDB): it first meant to make good, then to pay."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
