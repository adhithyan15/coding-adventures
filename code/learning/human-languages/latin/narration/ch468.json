          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: pēnicillus, pēnicillī",
          "segments": [
            {
              "kind": "speech",
              "text": "pēnicillus, pēnicillī — \"a paintbrush, a fine brush\"."
            },
            {
              "kind": "speech",
              "text": "Pictor pēnicillō tenuī flōrēs pingit. The painter paints flowers with a fine brush."
            },
            {
              "kind": "speech",
              "text": "Second declension, masculine: pēnicillus, pēnicillī m. (also pēnicillum n.). English pencil comes from it: the first pencils were fine brushes."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "pēnicillus is a diminutive of pēniculus 'brush' (Lewis & Short), which first meant 'a little tail', since brushes were made of ox-tails and horse-tails. English pencil comes from it through French."
            }
          ]
        },
