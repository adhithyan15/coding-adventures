        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ಜಗಲಿ",
          "segments": [
            {
              "kind": "speech",
              "text": "ಜಗಲಿ — jagali — \"a raised veranda, a front porch\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ಜಗಲಿ (jagali) is native Dravidian, one word with Telugu jagati (DEDR 2279). DEDR lists jagali, \"a raised place, a seat of mud or stone\"."
            }
          ]
        },
