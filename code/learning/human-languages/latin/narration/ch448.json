          "segments": [
            {
              "kind": "speech",
              "text": "raucus, rauca, raucum — \"hoarse; harsh-sounding\"."
            },
            {
              "kind": "speech",
              "text": "Post noctem longam vōx caupōnis rauca est. After a long night the innkeeper's voice is hoarse."
            },
            {
              "kind": "speech",
              "text": "An adjective of three endings. English raucous comes from it."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "raucus is built on rāvis 'hoarseness' with an adjective suffix (EtymDB); Lewis & Short trace it to a root meaning 'to make a loud noise'. English raucous comes from it."
            }
          ]
        },
