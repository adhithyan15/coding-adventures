      "sequence": 17250,
      "title": "भूकंप (bhūkamp) — an earthquake",
      "headword": "भूकंप",
      "romanization": "bhūkamp",
      "gloss": "an earthquake",
      "script": "devanagari",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:297d491493306932",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Marathi for ash, then the Marathi for a fire brigade."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: भूकंप",
          "segments": [
            {
              "kind": "speech",
              "text": "भूकंप — bhūkamp — \"an earthquake\"."
            },
            {
              "kind": "speech",
              "text": "जर भूकंप झाला तर आम्ही मोकळ्या मैदानात जाऊ. jar bhūkamp jhālā tar āmhī mokaḷyā maidānāt jāū. If there is an earthquake, we will go out to open ground."
            },
            {
              "kind": "speech",
              "text": "Masculine."
            },
            {
              "kind": "speech",
              "text": "भूकंप (bhūkamp) होणे, an earthquake happens; जर … झाला तर, if one happens, with the past after जर and the future after तर."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "भूकंप (bhūkamp) is a tatsama, taken from Sanskrit bhūkampa, 'an earthquake' (Monier-Williams): bhū, 'the earth', and kampa, 'a trembling'."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling what happened."
            }
          ]
        },
        {
          "index": 4,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "bhūkamp",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *bhūkamp*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "bhūkamp, once more",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *bhūkamp*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "jar bhūkamp jhālā tar āmhī mokaḷyā maidānāt jāū. — If there is an earthquake, we will go out to open ground.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *jar bhūkamp jhālā tar āmhī mokaḷyā maidānāt jāū.* — If there is an earthquake, we will go out to open ground.]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say the Marathi for ash, then the Marathi for a fire brigade, then say bhūkamp again",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say the Marathi for ash, then the Marathi for a fire brigade, then say *bhūkamp* again]"
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What does भूकंप (bhūkamp) mean? (\"An earthquake\".) Say it once more."
            }
          ]
        }
      ]
    },
