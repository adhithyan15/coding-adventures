          "segments": [
            {
              "kind": "speech",
              "text": "senectūs, senectūtis — \"old age\"."
            },
            {
              "kind": "speech",
              "text": "Avus meus in senectūte in vīllā habitābat. In his old age my grandfather lived at the villa."
            },
            {
              "kind": "speech",
              "text": "Feminine, 3rd declension, from senex (taught). Cicero wrote a whole dialogue in its praise."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "senectūs is built on senex, \"old man\" (Lewis & Short). English senior and senile come from the same family."
            }
          ]
        },
