          "segments": [
            {
              "kind": "speech",
              "text": "guīdìng — \"rule; regulation\"."
            },
            {
              "kind": "speech",
              "text": "zhè shì xuéxiào de guīdìng — That's the school's rule."
            },
            {
              "kind": "speech",
              "text": "Its characters come later; for now it is a word for the ear."
            }
