          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: dēlectō, dēlectāre",
          "segments": [
            {
              "kind": "speech",
              "text": "dēlectō, dēlectāre — \"to delight, charm\"."
            },
            {
              "kind": "speech",
              "text": "Fābulae avī puerōs dēlectant. Grandfather's stories delight the children."
            },
            {
              "kind": "speech",
              "text": "dēlectō, dēlectāre, dēlectāvī, dēlectātum, with the accusative. English delight comes from it through Old French."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "dēlectō is the frequentative of dēliciō \"to allure, entice\" (Lewis & Short), built on dē- and laciō \"to entice\". English delight comes from it through Old French."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
