        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: l'acompte",
          "segments": [
            {
              "kind": "speech",
              "text": "l'acompte — \"the down payment, the part payment\"."
            },
            {
              "kind": "speech",
              "text": "Pour le gîte, nous avons versé un acompte de cent euros. For the cottage we paid a hundred euros up front."
            },
            {
              "kind": "speech",
              "text": "A masculine noun. Verser un acompte — to pay a part in advance."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "acompte comes from à compte 'on account', from compte, built on compter 'to count', which goes back to Latin computāre (Lewis & Short). EtymDB does not list it."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
