        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: nudiustertius",
          "segments": [
            {
              "kind": "speech",
              "text": "nudiustertius — \"the day before yesterday\". It is nunc diēs tertius, \"now (is) the third day\": counting today, yesterday is the second. Nudiustertius epistulam scrīpsī. — \"The day before yesterday I wrote a letter.\""
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "nudiustertius is fused from nunc diēs tertius, \"now (is) the third day\". Latin also said nudiusquārtus, \"three days ago\", on the same pattern."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
