              "source": "[YOU SAY: *sǎomǎ*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "sǎomǎ, once more",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *sǎomǎ*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "kěyǐ sǎomǎ ma — Can I pay by scanning the code?",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *kěyǐ sǎomǎ ma* — Can I pay by scanning the code?]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say the Mandarin for to send electronically, then the Mandarin for to get something sent, then say sǎomǎ again",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say the Mandarin for to send electronically, then the Mandarin for to get something sent, then say *sǎomǎ* again]"
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What does sǎomǎ mean? (\"To scan a code (to pay)\".) Say it once more."
            }
          ]
        }
      ]
