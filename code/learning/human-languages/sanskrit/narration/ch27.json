    {
      "id": "SA-C27-thus",
      "sequence": 1320,
      "title": "एवम् (evam) — thus, so",
      "headword": "एवम्",
      "romanization": "evam",
      "gloss": "thus, so",
      "script": "devanagari",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
