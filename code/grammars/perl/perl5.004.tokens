# Perl 5.004 (1997-05-15) tokens: plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: this does not lex all Perl 5.004 source.
# Evidence: https://github.com/Perl/perl5/blob/perl-5.004/toke.c
# Tagged tokenizer adds the regex /c modifier outside this subset and retains
# the 250-digit decimal bound.
# Unsupported characters, carriage returns and
# leading-zero forms remain refused.

PRINT     = "print"
INT       = /0|[1-9][0-9]{0,249}/
PLUS      = "+"
DECREMENT = "--"
MINUS     = "-"
STAR      = "*"
LPAREN    = "("
RPAREN    = ")"
SEMICOLON = ";"

skip:
  WHITESPACE = /[ \t\n]+/
