          "source_mode": "strict_globs",
          "source_globs": [
            "src/**/*.py"
          ]
        },
        {
          "name": "python/app",
          "rel_path": "code/packages/python/app",
          "source_mode": "strict_globs",
          "source_globs": [
            "src/**/*.py"
          ]
        }
      ],
      "edges": [
        [
          "python/base",
          "python/lib"
        ],
        [
          "python/lib",
          "python/app"
        ]
      ],
      "forced_packages": [],
      "unknown_path_policy": "ignore"
    },
    "changed_paths": [
      "code/packages/python/lib/src/lib.py"
    ]
  },
  "expected": {
    "schema_version": 1,
    "case_id": "diff-selection/transitive-package-change",
    "domain": "diff_selection",
    "outcome": "ok",
    "result": {
