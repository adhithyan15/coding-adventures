        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: das Passwort",
          "segments": [
            {
              "kind": "speech",
              "text": "das Passwort — \"the password\"."
            },
            {
              "kind": "speech",
              "text": "Ich habe mein Passwort schon wieder vergessen. I have forgotten my password yet again."
            },
            {
              "kind": "speech",
              "text": "Plural: die Passwörter. Also das Kennwort."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Passwort was borrowed from English password and fitted to German Wort \"word\", inherited from Proto-Germanic wurdą (EtymDB)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
