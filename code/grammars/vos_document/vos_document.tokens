# Token definitions for the marker skeleton of a generated VOS implementation
# document (VOS02 section 2.3, decision D-GD5).
# @version 1
#
# A generated `code/specs/<impl>.warrant` is Warrant text with seven kinds of
# marker comment line.  This pair of grammar files reads ONLY that skeleton:
# which line is a marker, and in what order the markers come.  Everything that is
# not a marker is a plain LINE, handed to the Warrant tools unread.
#
# There is no skip section worth the name: every byte of a line matters, because
# the digest of a block is taken over its bytes.  The one `skip` entry matches
# nothing (the engine refuses an empty skip group, and without one it would
# silently drop leading blanks, which would hide an indented forged marker).
#
# ORDER OF DEFINITIONS MATTERS: the engine tries them in file order and takes the
# first that matches.  The seven exact markers come first; then FORGED, which
# matches ANY line containing the text `-- vos02:`, so a marker that is not
# exactly right (wrong indent, extra text, unknown name, a marker buried in a
# string or after code) is a token the parser grammar has no place for.

skip:
  NEVER = /[^\s\S]/

GENERATED         = /  -- vos02:generated by vos-link gen-doc; do not edit; contract-package=[a-z][a-z0-9_]{0,31}/
CONTRACT_BEGIN    = /  -- vos02:contract-begin sha256=[0-9a-f]{64}/
CONTRACT_END      = /  -- vos02:contract-end/
IMPL_BEGIN        = /  -- vos02:impl-begin/
IMPL_END          = /  -- vos02:impl-end/
OBLIGATIONS_BEGIN = /  -- vos02:obligations-begin tier=(?:safety|policy|canonical|any) sha256=[0-9a-f]{64}/
OBLIGATIONS_END   = /  -- vos02:obligations-end/

# Anything else that mentions a marker.  Never valid.
FORGED  = /[^\n]*-- vos02:[^\n]*/

NEWLINE = /\n/

# A plain line of text (a blank line is just a NEWLINE).
LINE    = /[^\n]+/
