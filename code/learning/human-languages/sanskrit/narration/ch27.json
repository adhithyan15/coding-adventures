    {
      "id": "SA-C27-true",
      "sequence": 1310,
      "title": "सत्यम् (satyam) — true; the truth",
      "headword": "सत्यम्",
      "romanization": "satyam",
      "gloss": "true; the truth",
      "script": "devanagari",
      "modality": "voice",
