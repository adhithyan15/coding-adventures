          "title": "You'll want to know: la tempête",
          "segments": [
            {
              "kind": "speech",
              "text": "la tempête — \"the storm, the gale\"."
            },
            {
              "kind": "speech",
              "text": "La tempête a fait tomber des arbres sur la route. The storm brought trees down onto the road."
            },
            {
              "kind": "speech",
              "text": "Stronger than an orage: a lot of wind."
            }
          ]
        },
