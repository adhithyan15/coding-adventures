          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Sanskrit for a discussion, then the Sanskrit for a dispute."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: योजना",
          "segments": [
            {
              "kind": "speech",
              "text": "योजना — yojanā — \"a plan, a scheme\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "yojanā is built on the root √yuj, \"to yoke, join\" (MW), the root of yuga and yoga. A plan is an arrangement of parts joined together. MW compares √yuj with Latin iungere, \"to join\", and English yoke."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for this chapter."
            }
          ]
        },
        {
