        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: la trama",
          "segments": [
            {
              "kind": "speech",
              "text": "la trama — \"the plot\"."
            },
            {
              "kind": "speech",
              "text": "La trama de la novela es muy complicada. The plot of the novel is very complicated."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "trama is inherited from Latin trāma 'the weft, the threads woven across' (EtymDB). A plot is the threads of a story woven together."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
