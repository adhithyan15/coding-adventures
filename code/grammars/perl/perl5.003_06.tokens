# Perl 5.003_06 (1996-10-07) tokens: arithmetic-print subset only.
# @version 1
# PARTIAL: this does not lex all Perl 5.003_06 source.
# Evidence: https://github.com/Perl/perl5/blob/9c6be91f691c6d72250718e13acfc7872e72a19f/toke.c
# The official commit introduces the 5.003_06 patch and identifies subversion
# 6 in patchlevel.h. Its toke.c blob matches the later 5.003_07 tag; this pair
# still covers only the listed print and arithmetic forms.

PRINT     = "print"
INT       = /[0-9]+/
PLUS      = "+"
DECREMENT = "--"
MINUS     = "-"
STAR      = "*"
LPAREN    = "("
RPAREN    = ")"
SEMICOLON = ";"

skip:
  WHITESPACE = /[ \t\r\n]+/
