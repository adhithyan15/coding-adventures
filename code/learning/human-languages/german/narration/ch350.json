            },
            {
              "kind": "speech",
              "text": "Before the new one: say the German for qualified, then the German for to master."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: der Arbeitgeber",
          "segments": [
            {
              "kind": "speech",
              "text": "der Arbeitgeber — \"the employer\"."
            },
            {
              "kind": "speech",
              "text": "Mein Arbeitgeber bezahlt mir das Ticket für den Bus. My employer pays for my bus ticket."
            },
            {
              "kind": "speech",
              "text": "Plural: die Arbeitgeber; a woman is die Arbeitgeberin. Literally the work-giver."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Arbeitgeber joins Arbeit \"work\", from Old High German arbeit and Proto-Germanic arbaidiz \"labour, hardship\", to Geber \"giver\", from geben \"to give\" (EtymDB)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
