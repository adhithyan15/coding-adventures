          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "constipado comes from Latin cōnstīpātus \"crowded or pressed closely together\" (EtymDB), from stīpāre \"to pack\": a head packed tight."
            }
          ]
        },
