          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "âtash \"fire\" is inherited from Middle Persian (EtymDB), and bâzi \"play, game\" is native Persian too: fire play."
            }
          ]
        },
