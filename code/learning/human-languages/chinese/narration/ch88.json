        {
          "index": 1,
          "type": "script",
          "title": "Script — a bar, a frame, two small 人",
          "segments": [
            {
              "kind": "speech",
              "text": "两 (liǎng)."
            },
            {
              "kind": "speech",
              "text": "A bar on top, then a frame, then what the frame holds."
            },
            {
              "kind": "speech",
              "text": "The top bar, one stroke, across."
            },
            {
              "kind": "speech",
              "text": "The frame, two strokes: a short vertical on the left, then a horizontal that turns down the right side and hooks to the left."
            },
            {
              "kind": "speech",
              "text": "Two small 人, four strokes, the left one first: each a left-falling stroke and a short stroke falling to the right, rising through the top of the frame."
            },
            {
              "kind": "speech",
              "text": "1 + 2 + 4 = seven."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "两 (liǎng), all seven, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 两, all seven, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many strokes in 两 (liǎng)? (Seven.) What does the frame hold? (Two small 人.) Which comes first, the frame or the two 人? (The frame.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 两 (liǎng), pinned stroke paths and medians."
            }
          ]
        }
      ]
