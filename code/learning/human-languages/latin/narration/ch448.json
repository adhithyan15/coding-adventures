          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "pōtor is built on the root of pōtō 'to drink' with the suffix -tor 'one who' (Lewis & Short). Greek pinō 'to drink' is a cousin of that root."
            }
          ]
        },
