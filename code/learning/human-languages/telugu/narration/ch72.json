      "id": "TE-C72-shop",
      "sequence": 2430,
      "title": "అంగడి (aṅgaḍi) — a shop",
      "headword": "అంగడి",
      "romanization": "aṅgaḍi",
      "gloss": "a shop",
      "script": "telugu",
