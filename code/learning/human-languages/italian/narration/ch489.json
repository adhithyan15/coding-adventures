        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ammalarsi",
          "segments": [
            {
              "kind": "speech",
              "text": "ammalarsi — \"to fall ill\"."
            },
            {
              "kind": "speech",
              "text": "Ogni inverno mi ammalo almeno una volta. Every winter I fall ill at least once."
            },
            {
              "kind": "speech",
              "text": "It takes essere: mi sono ammalato. Built on malato \"ill\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ammalarsi is built on malato \"ill\", usually traced to Latin male habitus \"in poor condition\" (Lewis & Short)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
