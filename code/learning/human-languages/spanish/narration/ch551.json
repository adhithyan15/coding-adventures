          "title": "You'll want to know: la acogida",
          "segments": [
            {
              "kind": "speech",
              "text": "la acogida — \"the welcome, the reception\"."
            },
            {
              "kind": "speech",
              "text": "La acogida en el pueblo fue muy buena. The welcome in the village was very good."
            },
            {
              "kind": "speech",
              "text": "Un centro de acogida is a shelter for refugees or homeless people."
            }
          ]
        },
