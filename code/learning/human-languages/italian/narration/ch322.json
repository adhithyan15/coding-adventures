        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: i fuochi d'artificio",
          "segments": [
            {
              "kind": "speech",
              "text": "i fuochi d'artificio — \"the fireworks\"."
            },
            {
              "kind": "speech",
              "text": "A mezzanotte ci sono i fuochi d'artificio. At midnight there are fireworks."
            },
            {
              "kind": "speech",
              "text": "Artificio — a skilful device."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "fuochi is the plural of fuoco \"fire\", from Latin focus \"hearth\" (Lewis & Short); artificio comes from Latin artificium \"craft, skill\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
