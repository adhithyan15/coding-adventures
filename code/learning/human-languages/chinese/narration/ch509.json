    {
      "id": "ZH-W509-mu-mother",
      "sequence": 38205,
      "title": "母 (mǔ) — a frame, two dots and a long bar",
      "headword": "母",
      "romanization": "mǔ",
      "gloss": "母 — a two-stroke frame, a dot, a long bar, a dot",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:9b4b7efe27bcee26",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — a frame, two dots and a long bar",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — a frame, two dots and a long bar and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say fùmǔ — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *fùmǔ* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "父 女."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — fù, nǚ",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *fù*, *nǚ*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — a frame, two dots and a long bar",
          "segments": [
            {
              "kind": "speech",
              "text": "母 (mǔ)."
            },
            {
              "kind": "speech",
              "text": "The frame, two strokes. One that runs down the left side and turns right along the bottom. Then one that runs along the top, turns down the right side and hooks to the left at the foot."
            },
            {
              "kind": "speech",
              "text": "A dot inside the top half."
            },
            {
              "kind": "speech",
              "text": "A long bar right across the middle, wider than the frame on both sides."
            },
            {
              "kind": "speech",
              "text": "A dot inside the bottom half."
            },
            {
              "kind": "speech",
              "text": "2 + 1 + 1 + 1 = five."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "母 (mǔ), all five, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 母, all five, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many strokes does 母 (mǔ) have? (Five.) How many dots? (Two, one above the long bar and one below.) Which stroke is widest? (The long bar across the middle.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 母 (mǔ), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
