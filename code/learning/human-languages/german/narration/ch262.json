        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: zunächst",
          "segments": [
            {
              "kind": "speech",
              "text": "zunächst — \"at first, initially; for now\"."
            },
            {
              "kind": "speech",
              "text": "Zunächst war alles ruhig. At first everything was quiet."
            },
            {
              "kind": "speech",
              "text": "A little more formal than zuerst. It can also mean 'for now': zunächst bleibe ich zu Hause."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "zunächst is built on zu \"to\" and nächst \"nearest\", the superlative of nah \"near\", which is inherited from Old High German nāh \"close, near\" (EtymDB): the nearest step comes first."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
