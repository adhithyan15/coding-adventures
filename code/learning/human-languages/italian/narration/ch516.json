          "title": "You'll want to know: il violoncello",
          "segments": [
            {
              "kind": "speech",
              "text": "il violoncello — \"cello\"."
            },
            {
              "kind": "speech",
              "text": "Suono il violoncello da dieci anni. I have played the cello for ten years."
            },
            {
              "kind": "speech",
              "text": "Often shortened to il cello."
            }
          ]
        },
