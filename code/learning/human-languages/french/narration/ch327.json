        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: la recette",
          "segments": [
            {
              "kind": "speech",
              "text": "la recette — \"the recipe; the takings\"."
            },
            {
              "kind": "speech",
              "text": "Ma grand-mère m'a donné sa recette de tarte. My grandmother gave me her tart recipe."
            },
            {
              "kind": "speech",
              "text": "In a shop, la recette is the day's takings."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "recette comes from Old French recete, from Latin recepta \"things received\" (EtymDB), from recipere \"to take back, to receive\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
