        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: la timidité",
          "segments": [
            {
              "kind": "speech",
              "text": "la timidité — \"shyness\"."
            },
            {
              "kind": "speech",
              "text": "Avec le temps, il a perdu sa timidité. With time, he lost his shyness."
            },
            {
              "kind": "speech",
              "text": "The adjective timide \"shy\" is the everyday word; la timidité names the quality."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "la timidité is a learned borrowing from Latin timiditās \"fearfulness\" (EtymDB), built on timidus \"fearful\", from timēre \"to fear\" (Lewis & Short)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
