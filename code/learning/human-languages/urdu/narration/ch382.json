        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: انعام",
          "segments": [
            {
              "kind": "speech",
              "text": "انعام — inām — \"a prize; a reward\"."
            },
            {
              "kind": "speech",
              "text": "اگر تم جیتے تو تمہیں انعام ملے گا۔ agar tum jīte to tumheṅ inām mile gā. If you win, you will get a prize."
            },
            {
              "kind": "speech",
              "text": "Masculine."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "انعام (inām) is usually traced, through Persian, to Arabic inʿām, \"a bestowing of favour\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
