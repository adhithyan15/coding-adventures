            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "still, a word that opens a yes-or-no question, at all, surely... not?, when",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: still, a word that opens a yes-or-no question, at all, surely ... not?, when]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "recently, already, last year, once, to spend",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: recently, already, last year, once, to spend]"
            }
          ]
        },
        {
          "index": 2,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Still? (هنوز, hanuz.) A word that opens a yes-or-no question? (آیا, âyâ.) At all? (اصلا, aslan.) Surely... not, in a question? (مگر, magar.) When? (چه وقت, che vaqt.) Recently? (به تازگی, be-tâzegi.) Already? (قبلا, qablan.) Last year? (پارسال, pârsâl.) Once? (یک بار, yek bâr.) To spend? (سپری کردن, separi kardan.)"
            }
          ]
        }
      ]
    },
