        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ਮੇਜ਼",
          "segments": [
            {
              "kind": "speech",
              "text": "ਮੇਜ਼ — mez — \"a table\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ਮੇਜ਼ (mez) is a loan, usually traced to Persian mēz, \"table\". Many take the Persian word from Portuguese mesa, \"table\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
