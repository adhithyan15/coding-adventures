            },
            {
              "kind": "speech",
              "text": "Say it with the ending that fits you."
            },
            {
              "kind": "prompt",
              "action": "HEAR",
              "instruction": "we eat roti every day",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU HEAR: *we eat roti every day*]"
            },
            {
              "kind": "speech",
              "text": "Say ਅਸੀਂ ਰੋਜ਼ ਰੋਟੀ ਖਾਂਦੇ ਹਾਂ।."
            },
            {
              "kind": "prompt",
              "action": "HEAR",
              "instruction": "the garden is not open",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU HEAR: *the garden is not open*]"
            },
            {
              "kind": "speech",
              "text": "Say ਬਾਗ਼ ਖੁੱਲ੍ਹਾ ਨਹੀਂ ਹੈ।."
            },
            {
              "kind": "prompt",
              "action": "HEAR",
              "instruction": "please sit here; don't get up yet",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU HEAR: *please sit here; don't get up yet*]"
            },
            {
              "kind": "speech",
              "text": "Say ਇੱਥੇ ਬੈਠੋ। ਅਜੇ ਨਾ ਉੱਠੋ।."
