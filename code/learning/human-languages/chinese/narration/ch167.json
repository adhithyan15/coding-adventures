    {
      "id": "ZH-W167-shi-matter",
      "sequence": 13485,
      "title": "事 (shì) — a bar, 口, three bars and a long hook",
      "headword": "事",
      "romanization": "shì",
      "gloss": "事 — a bar, 口, three bars, then a long hook through them",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:fa4cdb858351e782",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — a bar, 口, three bars and a long hook",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — a bar, 口, three bars and a long hook and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say méishì — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *méishì* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "口 有."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — kǒu, yǒu",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *kǒu*, *yǒu*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — a bar, 口, three bars and a long hook",
          "segments": [
            {
              "kind": "speech",
              "text": "事 (shì)."
            },
            {
              "kind": "speech",
              "text": "One shape, eight strokes, threaded on a long hook."
            },
            {
              "kind": "speech",
              "text": "A horizontal across the top."
            },
            {
              "kind": "speech",
              "text": "Then a small 口, three strokes, as you write it."
            },
            {
              "kind": "speech",
              "text": "Then three bars: a horizontal that turns down at its right end, a long horizontal across, and a shorter one under it."
            },
            {
              "kind": "speech",
              "text": "Last, a vertical with a hook, from the top bar down through everything: the longest stroke."
            },
            {
              "kind": "speech",
              "text": "1 + 3 + 3 + 1 = eight."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "事 (shì), all eight, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 事, all eight, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many strokes in 事 (shì)? (Eight.) Which piece is second? (A small 口.) Which stroke comes last? (The long vertical with the hook.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 事 (shì), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
