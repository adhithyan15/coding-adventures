        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: la raccomandata",
          "segments": [
            {
              "kind": "speech",
              "text": "la raccomandata — \"the registered letter\"."
            },
            {
              "kind": "speech",
              "text": "Ho spedito una raccomandata con ricevuta di ritorno. I sent a registered letter with a return receipt."
            },
            {
              "kind": "speech",
              "text": "Raccomandare — to recommend, and to register a letter."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "raccomandata is built on raccomandare 'to entrust' (EtymDB), from ri- and comandare, which goes back to Latin commendāre 'to entrust', built on mandāre; the words are inherited."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
