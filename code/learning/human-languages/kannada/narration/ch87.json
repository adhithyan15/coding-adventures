              "instruction": "ēnū illa, once more",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *ēnū illa*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "answer ēnū illa",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: answer *ēnū illa*]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say the Kannada for I didn't understand, then the Kannada for really, then say ēnū illa again",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say the Kannada for I didn't understand, then the Kannada for really, then say *ēnū illa* again]"
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
