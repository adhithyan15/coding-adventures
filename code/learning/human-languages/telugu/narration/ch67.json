        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: గడప",
          "segments": [
            {
              "kind": "speech",
              "text": "గడప (gaḍapa) — \"a threshold\"."
            },
            {
              "kind": "speech",
              "text": "గడప (gaḍapa) is the threshold: the raised strip of stone or wood under the తలుపు that you step over on the way in."
            },
            {
              "kind": "speech",
              "text": "It is the most watched piece of a Telugu house. The ముగ్గు is drawn just outside it, water is thrown across it at ఉదయం, and nobody steps on it if they can help it."
            },
            {
              "kind": "speech",
              "text": "Because it marks in from out, గడప (gaḍapa) also does the work of the word household. Asking whose గడప (gaḍapa) somebody comes from is asking about their family, not about their doorstep."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "Three. The line you cross to be inside."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
