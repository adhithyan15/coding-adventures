          "type": "input",
          "title": "You'll want to know: siegen",
          "segments": [
            {
              "kind": "speech",
              "text": "siegen — \"to win, to be victorious\"."
            },
            {
              "kind": "speech",
              "text": "Unsere Mannschaft hat mit drei zu null gesiegt. Our team won three-nil."
            },
            {
              "kind": "speech",
              "text": "More formal than gewinnen. Der Sieg — victory."
            }
          ]
        },
