          "title": "You'll want to know: congelar",
          "segments": [
            {
              "kind": "speech",
              "text": "congelar — \"to freeze\"."
            },
            {
              "kind": "speech",
              "text": "Si no vas a comerlo hoy, congélalo. If you aren't going to eat it today, freeze it."
            },
            {
              "kind": "speech",
              "text": "Congelado — frozen. Los congelados — frozen food."
            }
          ]
