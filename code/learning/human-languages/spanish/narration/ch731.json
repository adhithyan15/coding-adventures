          "title": "You'll want to know: maduro",
          "segments": [
            {
              "kind": "speech",
              "text": "maduro — \"mature; ripe\"."
            },
            {
              "kind": "speech",
              "text": "Es muy maduro para su edad. He is very mature for his age."
            },
            {
              "kind": "speech",
              "text": "With estar it is ripe fruit: el plátano está maduro."
            }
          ]
