    {
      "id": "ZH-W465-xing-mood",
      "sequence": 35375,
      "title": "兴 (xìng) — three short strokes over a bar, and 八 under it",
      "headword": "兴",
      "romanization": "xìng",
      "gloss": "兴 — three short strokes, a long bar, then 八",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:8524c9ed6f45637d",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — three short strokes over a bar, and 八 under it",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — three short strokes over a bar, and 八 under it and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say sǎoxìng — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *sǎoxìng* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "八 高."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — bā, gāo",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *bā*, *gāo*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — three short strokes over a bar, and 八 under it",
          "segments": [
            {
              "kind": "speech",
              "text": "兴 (xìng)."
            },
            {
              "kind": "speech",
              "text": "Three pieces, top to bottom. Count the pieces, not the strokes."
            },
            {
              "kind": "speech",
              "text": "The top, three strokes. A dot on the left, a second dot in the middle, both falling to the right, then a short stroke on the right falling to the left."
            },
            {
              "kind": "speech",
              "text": "The bar, one stroke. A long bar across, from left to right, wider than everything above it."
            },
            {
              "kind": "speech",
              "text": "The bottom, 八, two strokes. A stroke falling to the left, then a short stroke falling to the right."
            },
            {
              "kind": "speech",
              "text": "3 + 1 + 2 = six."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "兴 (xìng), all six, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 兴, all six, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many pieces does 兴 (xìng) have? (Three: three strokes, one and two.) What is under the bar? (八.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 兴 (xìng), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
