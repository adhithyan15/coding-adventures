        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: el vínculo",
          "segments": [
            {
              "kind": "speech",
              "text": "el vínculo — \"the bond, the link\"."
            },
            {
              "kind": "speech",
              "text": "Tengo un vínculo especial con mi abuela. I have a special bond with my grandmother."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "vínculo is a learned borrowing from Latin vinculum \"bond, link\" (EtymDB), built on vincīre \"to bind\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
