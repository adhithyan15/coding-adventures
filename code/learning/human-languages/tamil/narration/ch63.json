      "id": "TA-C63-request",
      "sequence": 2360,
      "title": "வேண்டுகோள் (vēṇḍukōḷ) — a request",
      "headword": "வேண்டுகோள்",
      "romanization": "vēṇḍukōḷ",
      "gloss": "a request",
      "script": "tamil",
      "modality": "voice",
      "derivedModality": "voice",
