          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "chub-lebâsi is chub, \"wood, stick\" (native, usually traced to Middle Persian čōb), with lebâsi, \"for clothes\". lebâs is borrowed from Arabic libās, \"clothing\" (root l-b-s, Lane)."
            }
          ]
