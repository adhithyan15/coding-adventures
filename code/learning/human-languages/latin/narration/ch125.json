        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: statua, statuae",
          "segments": [
            {
              "kind": "speech",
              "text": "statua, statuae — \"a statue\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "statua is built on statuō, \"to set up\" (Lewis & Short): a thing set up. statuō comes from status, \"a standing\", from stō, \"to stand\"."
            }
          ]
        },
