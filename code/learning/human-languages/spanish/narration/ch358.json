            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "la marca",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *la marca*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "¿de qué marca?",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *¿de qué marca?*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "el color, el tamaño, la forma y la clase",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *el color, el tamaño, la forma y la clase*]"
            }
          ]
        },
        {
          "index": 6,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What was a marka before it was a sign? (A boundary.) And why does a marquis outrank a count? (He held a border.)"
            }
          ]
        }
      ]
    }
  ],
