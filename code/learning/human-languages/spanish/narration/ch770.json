        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: la tintorería",
          "segments": [
            {
              "kind": "speech",
              "text": "la tintorería — \"the dry cleaner's\"."
            },
            {
              "kind": "speech",
              "text": "Llevo el traje a la tintorería porque no se puede lavar. I take the suit to the dry cleaner's because it can't be washed."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "tintorería is built on tintorero 'a dyer', from tinto 'dyed', which comes from Latin tīnctus, the participle of tingere 'to wet, to dye' (Lewis & Short). Dry cleaners were first dyers."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
