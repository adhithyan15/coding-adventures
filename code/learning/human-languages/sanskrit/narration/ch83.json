          "segments": [
            {
              "kind": "speech",
              "text": "छात्रः (chātraḥ) — \"a student\", the everyday word beside शिष्यः."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "The grammarians explain chātra as built on chatra, \"parasol\": the pupil whose habit is to shield his teacher's faults (Apte). That is the traditional account; the origin is not settled."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "Who sits in a school."
            }
          ]
        },
