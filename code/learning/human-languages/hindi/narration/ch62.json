          "segments": [
            {
              "kind": "speech",
              "text": "सूई (sūī) — \"a needle\"."
            },
            {
              "kind": "speech",
              "text": "From Sanskrit सूची (sūcī), 'needle', on सूच् (sūc-), 'to point out, to indicate'. A needle is named for the fact that it points."
            },
            {
              "kind": "speech",
              "text": "The same root gives सूचना, the word on every notice board and news bulletin for 'information' — a thing pointed out to you. A tailor's tool and a public announcement, off one small Sanskrit word about pointing."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "Two."
            }
          ]
        },
