        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: উৎস",
          "segments": [
            {
              "kind": "speech",
              "text": "উৎস — utsô — \"a source; an origin\"."
            },
            {
              "kind": "speech",
              "text": "এই খবরের উৎস কী? ei khôbôrer utsô kī? Where did this news come from?"
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "উৎস (utsô) is Sanskrit utsa, a spring where water rises (Monier-Williams). Bengali uses it for the place anything first flows from, news or money or a river; that wider use is a later extension of the picture."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for giving reasons and opinions."
            }
          ]
