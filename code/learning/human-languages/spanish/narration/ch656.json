        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: el aduanero",
          "segments": [
            {
              "kind": "speech",
              "text": "el aduanero — \"the customs officer\"."
            },
            {
              "kind": "speech",
              "text": "El aduanero abre mi maleta. The customs officer opens my suitcase."
            },
            {
              "kind": "speech",
              "text": "A woman is la aduanera. As an adjective: el control aduanero."
            }
          ]
        },
