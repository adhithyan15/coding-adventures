            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Hindi for one minute, then the Hindi for please wait."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: मतलब",
          "segments": [
            {
              "kind": "speech",
              "text": "मतलब (matlab) — \"meaning\"."
            },
            {
              "kind": "speech",
              "text": "धीरे का मतलब (matlab) क्या है? — \"what does dhīre mean?\". Put any word in front of का मतलब (matlab) क्या है? and it becomes the question that turns any speaker into a teacher."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "मतलब (matlab) is a loan from Arabic maṭlab, \"something sought, an aim\", which reached Hindi through Persian. Its Arabic root is ṭ-l-b (Lane). Hindi uses it for what a word aims at: its meaning."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "Again, louder, one minute, wait, what does it mean."
            }
          ]
        },
        {
          "index": 4,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "matlab",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *matlab*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "matlab, once more",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *matlab*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "ask dhīre kā matlab kyā hai?",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: ask *dhīre kā matlab kyā hai?*]"
