        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ausleihen",
          "segments": [
            {
              "kind": "speech",
              "text": "ausleihen — \"to borrow; to lend\"."
            },
            {
              "kind": "speech",
              "text": "In der Bibliothek habe ich drei Bücher ausgeliehen. I borrowed three books from the library."
            },
            {
              "kind": "speech",
              "text": "Separable: lieh aus, hat ausgeliehen. Sich etwas ausleihen — to borrow; jemandem etwas ausleihen — to lend."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ausleihen is built on aus \"out\" and leihen \"to lend\", inherited from Old High German līhan, from Proto-Germanic līhwaną (EtymDB)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
