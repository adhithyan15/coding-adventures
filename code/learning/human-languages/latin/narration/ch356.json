          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "appōnō is built on pōnō, \"to put\", with ad-, \"to, beside\" (Lewis & Short): to put before someone."
            }
          ]
        },
