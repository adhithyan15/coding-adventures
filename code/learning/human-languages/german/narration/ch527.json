          "title": "You'll want to know: der Trockner",
          "segments": [
            {
              "kind": "speech",
              "text": "der Trockner — \"tumble dryer\"."
            },
            {
              "kind": "speech",
              "text": "Die Handtücher kommen in den Trockner. The towels go in the dryer."
            },
            {
              "kind": "speech",
              "text": "Plural: die Trockner. Built on trocknen — to dry."
            }
