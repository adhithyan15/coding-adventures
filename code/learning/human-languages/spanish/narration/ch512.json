        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: producirse",
          "segments": [
            {
              "kind": "speech",
              "text": "producirse — \"to occur, to take place (of an event)\"."
            },
            {
              "kind": "speech",
              "text": "El accidente se produjo a las seis de la tarde. The accident occurred at six in the evening."
            },
            {
              "kind": "speech",
              "text": "Common in the news. It changes like conducir: se produjo, se produjeron."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "producirse is built on producir 'to produce', a learned borrowing from Latin prōdūcere 'to lead forth, to bring out' (EtymDB), from prō 'forward' and dūcere 'to lead'. An event that occurs is one brought out into the open."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
