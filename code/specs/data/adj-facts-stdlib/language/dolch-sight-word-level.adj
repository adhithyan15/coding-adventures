    row (three, pre_primer)
    row (funny, pre_primer)

    row (he, primer)
    row (was, primer)
    row (that, primer)
    row (she, primer)
    row (on, primer)
    row (they, primer)
    row (but, primer)
    row (at, primer)
    row (with, primer)
    row (all, primer)
    row (there, primer)
    row (out, primer)
    row (be, primer)
    row (have, primer)
    row (am, primer)
    row (do, primer)
    row (did, primer)
    row (what, primer)
    row (so, primer)
    row (get, primer)
    row (like, primer)
    row (this, primer)
    row (will, primer)
    row (yes, primer)
    row (went, primer)
    row (are, primer)
    row (now, primer)
    row (no, primer)
    row (came, primer)
    row (ride, primer)
    row (into, primer)
    row (good, primer)
    row (want, primer)
    row (too, primer)
    row (pretty, primer)
    row (four, primer)
    row (saw, primer)
    row (well, primer)
    row (ran, primer)
    row (brown, primer)
    row (eat, primer)
    row (who, primer)
    row (new, primer)
    row (must, primer)
    row (black, primer)
    row (white, primer)
    row (soon, primer)
    row (our, primer)
    row (ate, primer)
    row (say, primer)
    row (under, primer)
    row (please, primer)

    row (of, first_grade)
    row (his, first_grade)
    row (had, first_grade)
    row (him, first_grade)
    row (her, first_grade)

    row (would, second_grade)
    row (very, second_grade)
    row (your, second_grade)
    row (its, second_grade)
    row (around, second_grade)

    row (if, third_grade)
    row (long, third_grade)
    row (about, third_grade)
    row (got, third_grade)
    row (six, third_grade)
    row (never, third_grade)
    row (seven, third_grade)
    row (eight, third_grade)
    row (today, third_grade)
    row (myself, third_grade)
    row (much, third_grade)
    row (keep, third_grade)
    row (try, third_grade)
    row (start, third_grade)
    row (ten, third_grade)
    row (bring, third_grade)
    row (drink, third_grade)
    row (only, third_grade)
    row (better, third_grade)
    row (hold, third_grade)
    row (warm, third_grade)
    row (full, third_grade)
    row (done, third_grade)
    row (light, third_grade)
    row (pick, third_grade)
    row (hurt, third_grade)
    row (cut, third_grade)
    row (kind, third_grade)
    row (fall, third_grade)
    row (carry, third_grade)
    row (small, third_grade)
    row (own, third_grade)
    row (show, third_grade)
