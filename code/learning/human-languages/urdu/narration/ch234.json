        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "پاپڑ (pāpaṛ) is a tadbhava, a word inherited from Sanskrit and reshaped by sound change. It comes from parpaṭa, \"thin cake of rice or pease-meal\" (CDIAL 7934)."
            }
          ]
        },
