        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: el delantero",
          "segments": [
            {
              "kind": "speech",
              "text": "el delantero — \"the forward, the striker\"."
            },
            {
              "kind": "speech",
              "text": "Nuestro delantero es muy rápido. Our striker is very fast."
            },
            {
              "kind": "speech",
              "text": "As an adjective: la parte delantera — the front."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "delantero is built on delante \"in front\", which comes from Old Spanish denante (EtymDB), from Latin dē, in and ante \"before\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
