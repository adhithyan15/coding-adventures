# Parser grammar for mosstyle — Component Style Language
# @version 1
#
# A .msl file assigns visual properties to the named parts of a component.
# Each `part` block targets one exported part from the companion .mll file.
# Inside a part block, `state` blocks override base properties per interaction
# state (hover, pressed, focused, disabled, selected, editing, error).
#
# Grammar notation:
#   |      alternation
#   { }    repetition (zero or more)
#   [ ]    optional (zero or one)
#   ( )    grouping
# UPPERCASE = token reference, lowercase = rule reference
#
# ============================================================================
# Design decisions
# ============================================================================
#
# 1. style_value covers all literal value types: token references ($color-surface),
#    hash colors (#1e1e1e), dimensions (4px), numbers (0.4), strings ("Inter"),
#    and bare identifiers for keyword values (bold, underline, center, none).
#
# 2. The grammar does not validate property names or token resolution — that
#    is the semantic compiler's responsibility.  The grammar is purely structural.
#
# 3. LL(1): property_decl starts with NAME COLON, state_block starts with
#    KEYWORD NAME LBRACE.  Both KEYWORD and NAME are different token types
#    (KEYWORD = "state" keyword, NAME = everything else), so the parser can
#    always choose the correct branch by looking at the first token.

# ============================================================================
# Top-level structure
# ============================================================================

file = style_def ;

# ============================================================================
# Style definition
# ============================================================================
# style ComponentName { part* }
#
# Example:
#   style Grid {
#     part root { background: #ffffff ; }
#     part cell-grid { border-width: 1px ; border-color: #e0e0e0 ; }
#   }

style_def = KEYWORD NAME LBRACE { part_def } RBRACE ;

# ============================================================================
# Part block
# ============================================================================
# part part-name { part_item* }

part_def = KEYWORD NAME LBRACE { part_item } RBRACE ;

# ============================================================================
# Part items
# ============================================================================
# Each item is either a property declaration or a state block.
# LL(1) disambiguation:
#   - First token KEYWORD ("state") → state_block
#   - First token NAME               → property_decl

part_item = state_block
          | property_decl ;

# ============================================================================
# State blocks
# ============================================================================
# state state-name { property_decl* }
# State names (hover, pressed, focused, …) are NAME tokens in the token
# grammar (not reserved keywords), validated semantically.

state_block = KEYWORD NAME LBRACE { property_decl } RBRACE ;

# ============================================================================
# Property declarations
# ============================================================================
# property-name : value ;

property_decl = NAME COLON style_value SEMICOLON ;

# ============================================================================
# Style values
# ============================================================================
# A style value is one of:
#   TOKEN_REF  — Lattice design-token reference ($color-surface)
#   HASH_COLOR — hex color literal (#1e1e1e)
#   DIMENSION  — number with a unit (4px, 1.5rem, 80ms)
#   NUMBER     — unitless number (0.4, 400, 1)
#   STRING     — quoted string ("Inter", "system-ui")
#   NAME       — keyword value (bold, underline, center, none, start, end)

style_value = TOKEN_REF
            | HASH_COLOR
            | DIMENSION
            | NUMBER
            | STRING
            | NAME ;
