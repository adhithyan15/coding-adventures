{
  "schema_version": 1,
  "id": "plan/replace-existing",
  "domain": "plan",
  "summary": "A second plan write atomically replaces an existing destination on every platform.",
  "platforms": [
    "darwin",
    "linux",
    "windows"
  ],
  "capabilities": [
    "plan_v1_write"
  ],
  "workspace": {
