          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What does शान्तिः (śāntiḥ) mean? (\"peace, stillness\".) Say it once more."
            }
