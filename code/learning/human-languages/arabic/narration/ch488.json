        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: سعادة",
          "segments": [
            {
              "kind": "speech",
              "text": "سعادة — saʿāda — \"happiness\"."
            },
            {
              "kind": "speech",
              "text": "شعرت بسعادة كبيرة في العيد. shaʿartu bi-saʿāda kabīra fī al-ʿīd. I felt great happiness at the feast."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "سعادة (saʿāda) is built on the native Arabic root s-a-d, \"to be lucky, to be happy\" (Lane). Saʿāda is the state of being saʿīd, happy, a word you already know from the same root."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for describing what you lived and felt."
            }
          ]
        },
