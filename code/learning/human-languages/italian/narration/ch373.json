          "title": "You'll want to know: qualora",
          "segments": [
            {
              "kind": "speech",
              "text": "qualora — \"if, in case (formal)\"."
            },
            {
              "kind": "speech",
              "text": "Qualora non foste soddisfatti, vi restituiamo i soldi. Should you not be satisfied, we will give you your money back."
            },
            {
              "kind": "speech",
              "text": "Formal and written, followed by the subjunctive. In speech say se."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "qualora is built from quale \"which\", from Latin quālis, and ora \"hour\", from Latin hōra (Lewis & Short): \"at whatever hour\", and so \"if ever\"."
            }
          ]
        },
