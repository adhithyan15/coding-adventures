            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Latin for to leap for joy, then the Latin for pleasantness."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: trīstitia, trīstitiae",
          "segments": [
            {
              "kind": "speech",
              "text": "trīstitia, trīstitiae — \"sadness\"."
            },
            {
              "kind": "speech",
              "text": "Post mortem patris magna trīstitia domum tenet. After the father's death great sadness fills the house."
            },
            {
              "kind": "speech",
              "text": "Feminine, first declension, from trīstis — sad."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "trīstitia is built on trīstis \"sad, gloomy\" with -itia (Lewis & Short); EtymDB traces trīstis to a Proto-Indo-European form meaning \"in a bad mood\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
