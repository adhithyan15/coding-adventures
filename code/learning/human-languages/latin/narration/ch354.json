          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "torreō is inherited from Proto-Italic torzeō, \"to scorch\" (EtymDB), a cousin of English thirst. English toast and torrid come from it."
            }
          ]
        },
