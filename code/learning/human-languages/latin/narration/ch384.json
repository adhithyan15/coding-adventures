      "id": "LA-C384-suffragium",
      "sequence": 20580,
      "title": "suffrāgium, suffrāgiī — a vote; the right to vote",
      "headword": "suffrāgium, suffrāgiī",
      "romanization": "suffrāgium, suffrāgiī",
      "gloss": "a vote; the right to vote",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
