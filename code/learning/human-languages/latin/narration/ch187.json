            {
              "kind": "speech",
              "text": "Before the new one: say the Latin for a measure, then the Latin for a pound; a pair of scales."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: pāx, pācis",
          "segments": [
            {
              "kind": "speech",
              "text": "pāx, pācis — \"peace\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "pāx is inherited, usually traced to Proto-Indo-European peh2k-, \"to fasten, to fix\" (EtymDB 2.1): peace as a pact fixed between two sides. pacīscō, \"to make a bargain\", is from the same root (Lewis & Short)."
            }
          ]
        },
        {
