          "segments": [
            {
              "kind": "speech",
              "text": "betrügen — \"to cheat, to deceive\"."
            },
            {
              "kind": "speech",
              "text": "Der Verkäufer betrog viele alte Leute. The salesman cheated many old people."
            },
            {
              "kind": "speech",
              "text": "Strong verb: betrog, hat betrogen. Also to be unfaithful: Er betrügt seine Frau."
            }
          ]
        },
