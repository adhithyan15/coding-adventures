warrant percussion_kit
  error PercussionError = INVALID_PARAMETER | OUT_OF_BOUNDS | SAMPLE_RATE_TOO_HIGH | SAMPLE_COUNT_TOO_LARGE | VOICE_NOT_FOUND

  model hit_sample_budget(dur_ms: Int, rate: Int) -> Option<Int> = div(dur_ms * rate, 1000)
  model mode_count_valid(modes: Int) -> Bool = modes <= 32

  op calc_hit_sample_count(dur_ms: Int, rate: Int) -> Option<Int>
  op is_mode_count_safe(modes: Int) -> Bool

  assume platform:
    none
  assume environment:
    none

  labels calc_hit_sample_count:
    dur_ms public
    rate public

  labels is_mode_count_safe:
    modes public

  input calc_hit_sample_count.dur_ms:
    hostile
    ensures no_panic, terminates
  input calc_hit_sample_count.rate:
    hostile
    ensures no_panic, terminates

  input is_mode_count_safe.modes:
    hostile
    ensures no_panic, terminates

  bound calc_hit_sample_count:
    steps <= 64
    heap <= 0
    depth <= 8

  bound is_mode_count_safe:
    steps <= 64
    heap <= 0
    depth <= 8

  example sample_count_1s_44k:
    calc_hit_sample_count(1000, 44100) == Some(44100)
  example sample_count_half_s:
    calc_hit_sample_count(500, 48000) == Some(24000)
