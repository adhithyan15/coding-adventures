{
  "name": "@coding-adventures/javascript-parser",
  "version": "0.2.1",
  "description": "Parses JavaScript source code into ASTs using the grammar-driven parser — a thin wrapper that loads javascript.grammar",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "javascript",
    "parser",
    "ast",
    "grammar-driven",
    "computer-science",
    "education"
  ],
  "author": "Adhithya Rajasekaran",
  "license": "MIT",
  "dependencies": {
    "@coding-adventures/lexer": "file:../lexer",
    "@coding-adventures/grammar-tools": "file:../grammar-tools",
    "@coding-adventures/parser": "file:../parser",
    "@coding-adventures/javascript-lexer": "file:../javascript-lexer",
    "@coding-adventures/directed-graph": "file:../directed-graph"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vitest": "^4.1.0",
    "@vitest/coverage-v8": "^4.1.0",
    "@types/node": "^22.20.1"
  }
}
