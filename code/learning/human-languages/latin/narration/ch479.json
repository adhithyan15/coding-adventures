        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: pōmārium, pōmāriī",
          "segments": [
            {
              "kind": "speech",
              "text": "pōmārium, pōmāriī — \"an orchard\"."
            },
            {
              "kind": "speech",
              "text": "In pōmāriō arborēs plēnae pōmōrum sunt. In the orchard the trees are full of fruit."
            },
            {
              "kind": "speech",
              "text": "Second declension, neuter: pōmārium, pōmāriī n., from pōmum 'fruit'. A pōmārius sells fruit."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "pōmārium is built on pōmum 'fruit' with the suffix -ārium 'place for' (Lewis & Short, under pōmārius)."
            }
          ]
        },
