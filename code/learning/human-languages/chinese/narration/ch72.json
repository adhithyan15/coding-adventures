      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — two sparks around 人",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — two sparks around 人 and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say huǒchē — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *huǒchē* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "人 大."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — rén, dà",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *rén*, *dà*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — two sparks around 人",
          "segments": [
            {
              "kind": "speech",
              "text": "火 (huǒ)."
            },
            {
              "kind": "speech",
              "text": "One piece, four strokes."
            },
            {
              "kind": "speech",
              "text": "A short dot on the left, slanting down to the right."
            },
            {
              "kind": "speech",
              "text": "A short left-falling stroke on the right, falling toward the middle."
            },
            {
              "kind": "speech",
              "text": "人, two strokes: a long left-falling stroke from the top down to the lower left, then a long stroke falling to the right from its middle."
            },
            {
              "kind": "speech",
              "text": "2 + 2 = four."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "火 (huǒ), all four, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 火, all four, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many strokes in 火 (huǒ)? (Four.) Which character you know is its last two strokes? (人.) What comes first? (The dot on the left.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 火 (huǒ), pinned stroke paths and medians."
            }
          ]
        }
