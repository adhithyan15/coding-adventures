          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "lancha came through Portuguese lancha and is usually traced to a Malay word meaning \"swift\"."
            }
          ]
        },
