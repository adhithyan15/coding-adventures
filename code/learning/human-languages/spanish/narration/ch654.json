              "instruction": "despegar, once more",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *despegar*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "a sentence of your own with despegar",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: a sentence of your own with *despegar*]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
