        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: मच्छर",
          "segments": [
            {
              "kind": "speech",
              "text": "मच्छर — macchar — \"a mosquito\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "मच्छर (macchar) is a tadbhava, a word inherited from Sanskrit and reshaped by sound change. It comes from matsara, \"mosquito, fly\" (CDIAL 9757). The Sanskrit word is known only from the old word-lists; CDIAL suggests it was named for its humming."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for this chapter."
