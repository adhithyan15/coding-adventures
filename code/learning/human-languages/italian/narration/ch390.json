        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: legale",
          "segments": [
            {
              "kind": "speech",
              "text": "legale — \"legal, lawful\"."
            },
            {
              "kind": "speech",
              "text": "Se è legale, per me va bene. If it is legal, it is fine by me."
            },
            {
              "kind": "speech",
              "text": "As a noun, il legale is a lawyer: parlane con il tuo legale."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "legale is a learned borrowing from Latin lēgālis \"of the law\" (Lewis & Short), from lēx, lēgis \"law\"; the everyday leale \"loyal\" is the same Latin word, inherited."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
