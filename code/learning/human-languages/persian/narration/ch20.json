    {
      "id": "FA-C20-avval",
      "sequence": 920,
      "title": "اول (avval) — first, and the one ordinal Persian did not build",
      "headword": "اول",
      "romanization": "avval",
      "gloss": "first — an Arabic word standing in front of a Persian series",
      "script": "perso-arabic",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:72fa9a822117cfc8",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Read ۱, ۵ and ۱۰, then say yek."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know first — one word",
          "segments": [
            {
              "kind": "speech",
              "text": "اول — avval — first."
            },
            {
              "kind": "speech",
              "text": "Counting says how many. Ordering says which one, and a floor number, a date on a notice, a chapter heading and a queue all need the second."
            },
            {
              "kind": "speech",
              "text": "Three letters — ا, و, ل — and every one of them was taught in the script chapter, so this is the third word in the book you can write from memory without meeting a new sign."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart — a borrowing at the head of a native series",
          "segments": [
            {
              "kind": "speech",
              "text": "اول (avval) is Arabic, from the root ʾ-w-l. Persian did not build it from yek."
            },
            {
              "kind": "speech",
              "text": "Every other ordinal in the language is built from its own number, as the next lesson shows. So the series opens with a borrowed word and continues with native ones — the same shape English has in first and second, which are not built from one and two either, before third, fourth, fifth fall into line."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "avval — first",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: **avval** — first]"
            },
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "اول (avval) — alef, vâv, lam",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: **اول** — alef, vâv, lam]"
            },
            {
              "kind": "prompt",
              "action": "CONTRAST",
              "instruction": "yek counts, اول (avval) orders",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU CONTRAST: *yek* counts, **اول** orders]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "speech",
              "text": "Sources: Wiktionary: اول (avval); Omniglot, Numbers in Persian."
            },
            {
              "kind": "activity",
              "scored": true,
              "id": "FA-C20-avval-source",
              "prompt": "Is avval built from the Persian word for one?",
              "assesses": [
                "FA-ETYMON-AVVAL"
              ],
              "responseSeconds": 12,
              "acceptedResponses": [
                "no",
                "no, it is arabic",
                "no — it is borrowed from arabic",
                "it is arabic"
              ],
              "feedback": {
                "correct": "Borrowed, like English first.",
                "incorrect": "No. It is an Arabic borrowing; every other ordinal is native."
              }
            }
          ]
        }
      ]
    },
    {
      "id": "FA-C20-dovvom-sevvom",
      "sequence": 930,
      "title": "دوم and سوم — second, third, and one ending",
      "headword": "دوم سوم",
      "romanization": "dovvom sevvom",
      "gloss": "second and third — the ending that turns any number into an order",
      "script": "perso-arabic",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:8364dee838ad86fc",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Say avval, and where it came from. Then say do and se."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know first — two words and a rule",
          "segments": [
            {
              "kind": "speech",
              "text": "دوم — dovvom — second سوم — sevvom — third."
            },
            {
              "kind": "speech",
              "text": "The rule is one ending: ـم, -om, on the cardinal. do + -om becomes dovvom; se + -om becomes sevvom. The consonant doubles at the join, which is the only thing you have to hear."
            },
            {
              "kind": "speech",
              "text": "سوم is written س، و، م — three letters, all yours from the script chapter. That makes it the fourth word in this book you can write unaided, after se, noh and avval, whose written forms the script chapter already gave."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "dovvom — second; sevvom — third",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: **dovvom** — second; **sevvom** — third]"
            },
            {
              "kind": "prompt",
              "action": "SPLIT",
              "instruction": "do + -om, se + -om",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SPLIT: *do* + *-om*, *se* + *-om*]"
            },
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "سوم — sin, vâv, mim",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: **سوم** — sin, vâv, mim]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "speech",
              "text": "Sources: Wiktionary: سوم; Omniglot, Numbers in Persian."
            },
            {
              "kind": "activity",
              "scored": true,
              "id": "FA-C20-dovvom-sevvom-om-rule",
              "prompt": "What ending turns a Persian cardinal into an ordinal?",
              "assesses": [
                "FA-MORPH-ORDINAL-OM"
              ],
              "responseSeconds": 12,
              "acceptedResponses": [
                "-om",
                "om",
                "the suffix -om",
                "ـم, -om"
              ],
              "feedback": {
                "correct": "One ending, and it works on every number but one.",
                "incorrect": "-om, added to the cardinal."
              }
            }
          ]
        }
      ]
    },
    {
      "id": "FA-C20-chaharom",
