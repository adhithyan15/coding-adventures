          "segments": [
            {
              "kind": "speech",
              "text": "ಓಹೋ (ōhō) — \"oh, I see!\", the sound of understanding arriving."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ಓಹೋ (ōhō) is an exclamation: the sound of surprise made into a word, as in many languages. It comes from the sound itself, with no older word behind it."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "The happy opposite of ayyō."
