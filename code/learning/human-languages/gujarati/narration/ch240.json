          "segments": [
            {
              "kind": "speech",
              "text": "છોડ — choḍ — \"plant, shrub\"."
            },
            {
              "kind": "speech",
              "text": "મેં છોડને પાણી આપ્યું. — mẽ choḍne pāṇī āpyũ — \"I gave the plant water.\""
            },
            {
              "kind": "speech",
              "text": "A masculine noun."
