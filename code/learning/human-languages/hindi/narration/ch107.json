          "segments": [
            {
              "kind": "speech",
              "text": "सेहत (sehat) is a loan from Arabic ṣiḥḥa, \"health, soundness\", which reached Hindi through Persian. Its Arabic root is ṣ-ḥ-ḥ (Lane)."
            }
          ]
        },
