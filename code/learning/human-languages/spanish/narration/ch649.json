        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: la moto",
          "segments": [
            {
              "kind": "speech",
              "text": "la moto — \"the motorbike\"."
            },
            {
              "kind": "speech",
              "text": "Voy al trabajo en moto. I go to work by motorbike."
            },
            {
              "kind": "speech",
              "text": "Short for la motocicleta, so it is feminine."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "moto is short for motocicleta, which comes from French motocyclette (EtymDB), built on words for an engine and a cycle."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
