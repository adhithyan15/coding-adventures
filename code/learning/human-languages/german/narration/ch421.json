          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Kabine was borrowed from French cabine, a word linked with English cabin; both are usually traced to Late Latin capanna 'hut'. EtymDB lists the German word without a source, so the line is hedged."
            }
