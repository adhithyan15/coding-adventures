        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: le risque",
          "segments": [
            {
              "kind": "speech",
              "text": "le risque — \"the risk\"."
            },
            {
              "kind": "speech",
              "text": "Il y a un risque de pluie demain. There is a chance of rain tomorrow."
            },
            {
              "kind": "speech",
              "text": "Prendre un risque — to take a risk; the verb is risquer."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "risque comes from Old Italian risco \"danger\" (EtymDB). The further origin is not settled."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
            }
          ]
        },
