          "segments": [
            {
              "kind": "speech",
              "text": "pudet, pudēre — \"it shames, one is ashamed\"."
            },
            {
              "kind": "speech",
              "text": "Mē pudet errōris meī. I am ashamed of my mistake."
            },
            {
              "kind": "speech",
              "text": "Impersonal: pudet, pudēre, puduit. The person in the accusative, the cause in the genitive. Pudor, already known, is shame."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "pudet is the impersonal use of pudeō \"to be ashamed\", and pudor \"shame\" is built on it (Lewis & Short). English impudent comes from the family."
            }
          ]
        },
