{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Forme",
  "version": "0.1.0",
  "identifier": "dev.coding-adventures.forme",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist-ui"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; connect-src ipc: http://ipc.localhost; font-src 'self'; form-action 'none'; frame-ancestors 'none'; frame-src http://127.0.0.1:*; img-src 'self' data:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'"
    },
    "windows": [
      {
        "label": "main",
        "title": "Forme",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "resources": {
      "../dist/worker/forme-product-worker": "forme-product-worker",
      "../dist/worker/forme-sandbox-macos": "forme-sandbox-macos"
    },
    "icon": ["../../bookmarks-extension/icons/icon-128.png"],
    "shortDescription": "Local-first visual authoring with Forme"
  }
}
