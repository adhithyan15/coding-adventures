              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *èr*, *ér*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — 二, then 儿 under it",
          "segments": [
            {
              "kind": "speech",
              "text": "元 (yuán)."
            },
            {
              "kind": "speech",
              "text": "Two characters you own, one above the other."
            },
            {
              "kind": "speech",
              "text": "二, two strokes: the short upper bar, then the longer lower bar."
            },
            {
              "kind": "speech",
              "text": "儿, two strokes, under them: the left-falling stroke, then the vertical that bends right along the foot and hooks up."
            },
            {
              "kind": "speech",
              "text": "2 + 2 = four."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "元 (yuán), all four, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 元, all four, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many strokes in 元 (yuán)? (Four.) Which character is on top? (二.) And under it? (儿.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 元 (yuán), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
