<div class="os-note-body">
    <div data-type="injected-exercise" class="os-embed autogenerated-content" data-injected-from-nickname="CM-C03-M4-Q024" data-injected-from-version="6" data-injected-from-url="https://exercises.openstax.org/api/exercises?q=nickname:CM-C03-M4-Q024" data-tags="lo:stax-cmath:03-04-09 book:stax-cmath assignment-type:reading blooms:1 time:medium context-cnxmod:240c1b83-7a66-46f5-8e87-c2c8bd947e7e book-slug:contemporary-mathematics module-slug:contemporary-mathematics:3-4-rational-numbers" data-is-vocab="false" data-question-count="1" data-is-multipart="False">
