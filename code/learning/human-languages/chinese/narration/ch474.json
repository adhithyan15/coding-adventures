          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Mandarin for to have a tooth pulled, then the Mandarin for to have a tooth filled."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: gēbo",
          "segments": [
            {
              "kind": "speech",
              "text": "gēbo — \"arm\"."
            },
            {
              "kind": "speech",
              "text": "wǒ gōngzuò le shí ge xiǎoshí gēbo hěn téng — I worked for ten hours, and my arms really ache."
            },
            {
              "kind": "speech",
              "text": "Its characters come later; for now it is a word for the ear."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "gēbo is built from gē and bo, both inherited from Middle Chinese, kak and phak (Guangyun, in Baxter's transcription). The dictionary glosses the first as the armpit and the second as dried meat; how the pair came to mean the arm is not settled, and the first tone of gē is irregular."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for saying how it was."
            }
          ]
        },
