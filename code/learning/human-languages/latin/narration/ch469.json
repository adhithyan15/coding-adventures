          "segments": [
            {
              "kind": "speech",
              "text": "follis, follis — \"a pair of bellows; a leather bag\"."
            },
            {
              "kind": "speech",
              "text": "Servus folle ignem auget. The slave makes the fire bigger with the bellows."
            },
            {
              "kind": "speech",
              "text": "Third declension, masculine: follis, follis m. Also a blown-up leather ball and a money bag. English fool comes from it through French, from 'windbag'."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "follis is inherited from PIE bʰolǵʰnis (EtymDB); Lewis & Short compare flō 'to blow'. English fool comes from it through Old French fol, from the sense 'windbag'."
            }
          ]
        },
