% ============================================================================
% prefix-meaning.query.adj — worked recall over the prefix-meaning library.
% ============================================================================
% The shape a learner (or an LLM) produces to ANSWER "what does this
% prefix mean?" (direct) or "which prefix means this?" (reverse) — it
% states no fact of its own — it only `import`s the grounded table and
% asks binding queries.
% ============================================================================

import "prefix-meaning.adj"

? prefix_meaning(un_, $M)            % expect negation_or_absence (direct)
? prefix_meaning($P, doing_again)    % expect re_ (reverse)
? prefix_meaning(inter_, $M)         % expect among_between (direct, new row)
? prefix_meaning($P, happening_before) % expect pre_ (reverse, new row)
? prefix_meaning(over_, $M)          % expect abstain -- a real prefix the same source page also covers, but not one of the six tabled examples
