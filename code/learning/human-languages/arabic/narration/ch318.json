          "segments": [
            {
              "kind": "speech",
              "text": "أثر — athar — \"a trace, a mark; an effect\"."
            },
            {
              "kind": "speech",
              "text": "رأينا أثر قدم في الرمل. raʾaynā athar qadam fī ar-raml. We saw a footprint in the sand."
            },
            {
              "kind": "speech",
              "text": "Plural: آثار, āthār."
            },
            {
              "kind": "speech",
              "text": "The plural الآثار is antiquities: عالم آثار, an archaeologist."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "أثر (athar) is built on the native Arabic root ʾ-th-r (Lane), where athar is a mark or track left behind; athara is also \"to hand down a report\"."
            }
          ]
        },
