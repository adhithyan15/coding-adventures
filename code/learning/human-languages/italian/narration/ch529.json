        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: doppiare",
          "segments": [
            {
              "kind": "speech",
              "text": "doppiare — \"to dub\"."
            },
            {
              "kind": "speech",
              "text": "Quasi tutti i film stranieri sono doppiati. Almost all foreign films are dubbed."
            },
            {
              "kind": "speech",
              "text": "Also to lap another runner, or to sail round a cape."
            }
          ]
        },
