          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "اخراج is usually traced to Arabic ikhrāj \"putting out, sending out\", from the same Arabic family as Persian khârej \"outside\"."
            }
          ]
        },
