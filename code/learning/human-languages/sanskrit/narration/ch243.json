        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: बलवान्",
          "segments": [
            {
              "kind": "speech",
              "text": "बलवान् — balavān — \"mighty, strong\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "balavān is the nominative of balavat, built on bala, \"power, strength\" (CDIAL 9161), with -vat, \"having\" (MW). EtymDB sets bala beside Greek beltiōn, \"better\", and Latin dēbilis, \"weak\". Bala lives on as Hindi bal, \"strength\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
