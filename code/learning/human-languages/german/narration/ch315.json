        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: der Ritter",
          "segments": [
            {
              "kind": "speech",
              "text": "der Ritter — \"the knight\"."
            },
            {
              "kind": "speech",
              "text": "Der Ritter ritt auf einem weißen Pferd. The knight rode a white horse."
            },
            {
              "kind": "speech",
              "text": "Plural: die Ritter. Built on reiten, to ride."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Ritter comes from Middle High German ritter, shaped after Middle Dutch ridder (EtymDB), built on the root of reiten \"to ride\": a rider."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
