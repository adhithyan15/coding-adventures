            "orphan_snapshot": {
              "$ref": "#/$defs/orphan_snapshot"
            },
            "tracked_artifact_snapshot": {
              "$ref": "#/$defs/tracked_artifact_snapshot"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "checks": {
                    "contains": {
                      "const": "tracked_artifact_absence"
                    }
                  }
                },
                "required": [
                  "checks"
                ]
              },
              "then": {
                "required": [
                  "tracked_artifact_snapshot"
                ]
              },
              "else": {
                "not": {
                  "required": [
                    "tracked_artifact_snapshot"
                  ]
                }
              }
            },
            {
              "if": {
                "properties": {
                  "checks": {
                    "contains": {
                      "const": "orphan_crate_coverage"
                    }
                  }
                },
                "required": [
                  "checks"
                ]
              },
              "then": {
                "required": [
                  "orphan_snapshot"
                ]
              },
              "else": {
                "not": {
                  "required": [
                    "orphan_snapshot"
                  ]
                }
              }
            },
            {
              "if": {
                "properties": {
                  "checks": {
                    "contains": {
                      "const": "lua_windows_sibling_parity"
                    }
                  }
                },
                "required": [
                  "checks"
                ]
              },
              "then": {
                "properties": {
                  "packages": {
                    "items": {
                      "type": "object",
                      "required": [
                        "canonical_lua_sibling_installs",
                        "windows_build_file_state",
                        "windows_lua_sibling_installs"
                      ],
                      "properties": {
                        "language": {
                          "const": "lua"
                        }
                      }
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "checks": {
                    "contains": {
                      "const": "identity_uniqueness"
                    }
                  }
                },
                "required": [
                  "checks"
                ]
              },
              "then": {
                "properties": {
                  "packages": {
                    "items": {
                      "required": [
                        "identity_candidates"
                      ]
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "checks": {
                    "contains": {
                      "const": "manifest_uniqueness"
                    }
                  }
                },
                "required": [
                  "checks"
                ]
              },
              "then": {
                "properties": {
                  "packages": {
                    "items": {
                      "required": [
                        "manifest_candidates"
                      ]
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "checks": {
                    "contains": {
                      "const": "path_safety"
                    }
                  }
                },
                "required": [
                  "checks"
                ]
              },
              "then": {
                "properties": {
                  "packages": {
                    "items": {
                      "required": [
                        "validation_paths"
                      ]
                    }
                  }
                }
              }
            }
          ]
