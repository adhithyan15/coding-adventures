        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: le procès",
          "segments": [
            {
              "kind": "speech",
              "text": "le procès — \"the trial\"."
            },
            {
              "kind": "speech",
              "text": "Le procès commence la semaine prochaine. The trial starts next week."
            },
            {
              "kind": "speech",
              "text": "Faire un procès à quelqu'un — to sue someone."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "procès comes from Latin prōcessus \"a going forward, progress\" (EtymDB; Lewis & Short), from prōcēdere \"to go forward\", built on cēdere \"to go\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
