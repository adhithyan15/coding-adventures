// Button.light.msl — default light-theme styling for Button.
//
// The base is the documented primary/md fallback for an omitted slot.
// UI49 states are owned by Button.mil's closed `variant` and `size`
// axes; both active states compose because colors and geometry do not
// overlap.

style Button {
  part button {
    padding       : 8 ;
    border-radius : 4 ;
    font-weight   : 500 ;
    background    : "#0d6efd" ;
    color         : "#ffffff" ;
    border-width  : 1 ;
    border-color  : "#0d6efd" ;
    font-size     : 14 ;

    state primary {
      background   : "#0d6efd" ;
      color        : "#ffffff" ;
      border-color : "#0d6efd" ;
    }
    state secondary {
      background   : "#6c757d" ;
      color        : "#ffffff" ;
      border-color : "#6c757d" ;
    }
    state success {
      background   : "#198754" ;
      color        : "#ffffff" ;
      border-color : "#198754" ;
    }
    state danger {
      background   : "#dc3545" ;
      color        : "#ffffff" ;
      border-color : "#dc3545" ;
    }
    state warning {
      background   : "#ffc107" ;
      color        : "#212529" ;
      border-color : "#ffc107" ;
    }
    state info {
      background   : "#0dcaf0" ;
      color        : "#212529" ;
      border-color : "#0dcaf0" ;
    }
    state light {
      background   : "#f8f9fa" ;
      color        : "#212529" ;
      border-color : "#dee2e6" ;
    }
    state dark {
      background   : "#212529" ;
      color        : "#ffffff" ;
      border-color : "#212529" ;
    }

    // UI57 — `disabled` is a bool slot, so this activates on its truthiness.
    //
    // Every backend already lowers `disabled` to the native control property,
    // but the ones that paint by DEFAULT styling (the DOM's `<button
    // disabled>`) are overridden by the explicit background above, so the
    // control went inert without looking it. Measured on the live component
    // page: the Disabled story rendered pixel-identical to Primary. #14639
    //
    // `opacity` composites the control and its content, so it reads as
    // unavailable whichever variant is active, without restating eight
    // variants x two themes in muted colours.
    state disabled {
      opacity : $opacity-disabled ;
    }

    state sm {
      padding       : 6 ;
      border-radius : 3 ;
      font-size     : 13 ;
    }
    state md {
      padding       : 8 ;
      border-radius : 4 ;
      font-size     : 14 ;
    }
    state lg {
      padding       : 12 ;
      border-radius : 6 ;
      font-size     : 18 ;
    }
  }
}
