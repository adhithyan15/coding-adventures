    {
      "id": "ZH-W76-hui",
      "sequence": 5935,
      "title": "会 (huì) — 人 over two bars and a bend",
      "headword": "会",
      "romanization": "huì",
      "gloss": "会 — 人 over two bars and a bend",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:03e1a9c9a16bdc9b",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — 人 over two bars and a bend",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — 人 over two bars and a bend and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say yíhuìr — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *yíhuìr* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "人 今 去."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — rén, jīn, qù",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *rén*, *jīn*, *qù*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — 人 over two bars and a bend",
          "segments": [
            {
              "kind": "speech",
              "text": "会 (huì)."
            },
            {
              "kind": "speech",
              "text": "Three parts, top to bottom."
            },
            {
              "kind": "speech",
              "text": "人, two strokes, spread wide as a roof, as on 今."
            },
            {
              "kind": "speech",
              "text": "Two horizontals under it, the lower one longer."
            },
            {
              "kind": "speech",
              "text": "A stroke that falls left and turns right along the bottom, then a dot: the same two strokes that end 去."
            },
            {
              "kind": "speech",
              "text": "2 + 2 + 2 = six."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "会 (huì), all six, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 会, all six, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many strokes in 会 (huì)? (Six.) Which character you know is on top? (人.) What comes last? (A dot.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 会 (huì), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
