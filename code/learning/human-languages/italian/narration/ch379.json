        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: il liceo",
          "segments": [
            {
              "kind": "speech",
              "text": "il liceo — \"the upper secondary school (academic)\"."
            },
            {
              "kind": "speech",
              "text": "Mia figlia va al liceo scientifico. My daughter goes to a science high school."
            },
            {
              "kind": "speech",
              "text": "From about fourteen to nineteen. Il liceo classico teaches Latin and Greek."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "liceo is a learned borrowing from Latin lycēum, from Greek lýkeion, the name of a gymnasium with gardens where a great teacher of ancient Greece taught (Lewis & Short)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
