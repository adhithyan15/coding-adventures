          "segments": [
            {
              "kind": "speech",
              "text": "minitor, minitārī — \"to threaten\"."
            },
            {
              "kind": "speech",
              "text": "Latrō mihi gladiō minitābātur. The bandit was threatening me with a sword."
            },
            {
              "kind": "speech",
              "text": "minitor, minitārī, minitātus sum, a deponent, with the dative of the person threatened."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "minitor is a stronger form of minor, \"to threaten\", which is built on minae, \"threats\" (Lewis & Short)."
            }
          ]
        },
