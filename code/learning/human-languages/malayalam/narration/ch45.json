        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: മുത്തച്ഛൻ",
          "segments": [
            {
              "kind": "speech",
              "text": "മുത്തച്ഛൻ (muttacchan) — \"grandfather\"."
            },
            {
              "kind": "speech",
              "text": "Two pieces, both audible: mutta-, 'elder, senior', and acchan, the 'father' from the family lesson. Literally, an elder father. Where Sanskrit would reach for a compound of its own, Malayalam assembles this one out of words the learner already owns."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "The first of four family words. Three follow, and each reuses the ones before."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
