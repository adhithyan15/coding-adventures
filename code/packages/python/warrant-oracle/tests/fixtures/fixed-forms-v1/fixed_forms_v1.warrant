  -- checked arithmetic (Option<T>, consumed by unwrap_or) -----------------------------
  model m_checked_add_u8(a: U8, b: U8) -> U8 = unwrap_or(checked_add(a, b), 0u8)
  model m_checked_sub_u8(a: U8, b: U8) -> U8 = unwrap_or(checked_sub(a, b), 0u8)
  model m_checked_mul_u8(a: U8, b: U8) -> U8 = unwrap_or(checked_mul(a, b), 0u8)
  model m_checked_add_u16(a: U16, b: U16) -> U16 = unwrap_or(checked_add(a, b), 0u16)
  model m_checked_sub_u16(a: U16, b: U16) -> U16 = unwrap_or(checked_sub(a, b), 0u16)
  model m_checked_mul_u16(a: U16, b: U16) -> U16 = unwrap_or(checked_mul(a, b), 0u16)
  model m_checked_add_u32(a: U32, b: U32) -> U32 = unwrap_or(checked_add(a, b), 0u32)
  model m_checked_sub_u32(a: U32, b: U32) -> U32 = unwrap_or(checked_sub(a, b), 0u32)
  model m_checked_mul_u32(a: U32, b: U32) -> U32 = unwrap_or(checked_mul(a, b), 0u32)
  model m_checked_add_u64(a: U64, b: U64) -> U64 = unwrap_or(checked_add(a, b), 0u64)
  model m_checked_sub_u64(a: U64, b: U64) -> U64 = unwrap_or(checked_sub(a, b), 0u64)
  model m_checked_mul_u64(a: U64, b: U64) -> U64 = unwrap_or(checked_mul(a, b), 0u64)
  model m_checked_add_i8(a: I8, b: I8) -> I8 = unwrap_or(checked_add(a, b), 0i8)
  model m_checked_sub_i8(a: I8, b: I8) -> I8 = unwrap_or(checked_sub(a, b), 0i8)
  model m_checked_mul_i8(a: I8, b: I8) -> I8 = unwrap_or(checked_mul(a, b), 0i8)
  model m_checked_add_i16(a: I16, b: I16) -> I16 = unwrap_or(checked_add(a, b), 0i16)
  model m_checked_sub_i16(a: I16, b: I16) -> I16 = unwrap_or(checked_sub(a, b), 0i16)
  model m_checked_mul_i16(a: I16, b: I16) -> I16 = unwrap_or(checked_mul(a, b), 0i16)
  model m_checked_add_i32(a: I32, b: I32) -> I32 = unwrap_or(checked_add(a, b), 0i32)
  model m_checked_sub_i32(a: I32, b: I32) -> I32 = unwrap_or(checked_sub(a, b), 0i32)
  model m_checked_mul_i32(a: I32, b: I32) -> I32 = unwrap_or(checked_mul(a, b), 0i32)
  model m_checked_add_i64(a: I64, b: I64) -> I64 = unwrap_or(checked_add(a, b), 0i64)
  model m_checked_sub_i64(a: I64, b: I64) -> I64 = unwrap_or(checked_sub(a, b), 0i64)
  model m_checked_mul_i64(a: I64, b: I64) -> I64 = unwrap_or(checked_mul(a, b), 0i64)

  -- div / rem: unsigned pairs (Option<U>), Int/Nat pairs (Option<Int>, R7) -------------
  model m_div_u8(a: U8, b: U8) -> U8 = unwrap_or(div(a, b), 0u8)
  model m_rem_u8(a: U8, b: U8) -> U8 = unwrap_or(rem(a, b), 0u8)
  model m_div_u16(a: U16, b: U16) -> U16 = unwrap_or(div(a, b), 0u16)
  model m_rem_u16(a: U16, b: U16) -> U16 = unwrap_or(rem(a, b), 0u16)
  model m_div_u32(a: U32, b: U32) -> U32 = unwrap_or(div(a, b), 0u32)
  model m_rem_u32(a: U32, b: U32) -> U32 = unwrap_or(rem(a, b), 0u32)
  model m_div_u64(a: U64, b: U64) -> U64 = unwrap_or(div(a, b), 0u64)
  model m_rem_u64(a: U64, b: U64) -> U64 = unwrap_or(rem(a, b), 0u64)
  model m_div_nat_nat(a: Nat, b: Nat) -> Int = unwrap_or(div(a, b), 0)
  model m_div_nat_int(a: Nat, b: Int) -> Int = unwrap_or(div(a, b), 0)
  model m_div_int_nat(a: Int, b: Nat) -> Int = unwrap_or(div(a, b), 0)
  model m_div_int_int(a: Int, b: Int) -> Int = unwrap_or(div(a, b), 0)
  model m_rem_nat_nat(a: Nat, b: Nat) -> Int = unwrap_or(rem(a, b), 0)
  model m_rem_nat_int(a: Nat, b: Int) -> Int = unwrap_or(rem(a, b), 0)
  model m_rem_int_nat(a: Int, b: Nat) -> Int = unwrap_or(rem(a, b), 0)
  model m_rem_int_int(a: Int, b: Int) -> Int = unwrap_or(rem(a, b), 0)
  model m_div_literals() -> Int = unwrap_or(div(7, 2), 0)
  model m_rem_nat_literal(a: Nat) -> Int = unwrap_or(rem(a, 3), 0)
  model m_div_literal_left(n: Nat) -> Int = unwrap_or(div(7, n), 0)
  model m_rem_literal_left(n: Int) -> Int = unwrap_or(rem(7, n), 0)

  -- div_trunc / rem_trunc (signed pairs only, toward zero) -----------------------------
  model m_div_trunc_i8(a: I8, b: I8) -> I8 = unwrap_or(div_trunc(a, b), 0i8)
  model m_rem_trunc_i8(a: I8, b: I8) -> I8 = unwrap_or(rem_trunc(a, b), 0i8)
  model m_div_trunc_i16(a: I16, b: I16) -> I16 = unwrap_or(div_trunc(a, b), 0i16)
  model m_rem_trunc_i16(a: I16, b: I16) -> I16 = unwrap_or(rem_trunc(a, b), 0i16)
  model m_div_trunc_i32(a: I32, b: I32) -> I32 = unwrap_or(div_trunc(a, b), 0i32)
  model m_rem_trunc_i32(a: I32, b: I32) -> I32 = unwrap_or(rem_trunc(a, b), 0i32)
  model m_div_trunc_i64(a: I64, b: I64) -> I64 = unwrap_or(div_trunc(a, b), 0i64)
  model m_rem_trunc_i64(a: I64, b: I64) -> I64 = unwrap_or(rem_trunc(a, b), 0i64)

  -- imin / imax (Int and Nat operands) ----------------------------------------------
  model m_imin_nat_nat(a: Nat, b: Nat) -> Int = imin(a, b)
  model m_imin_nat_int(a: Nat, b: Int) -> Int = imin(a, b)
  model m_imin_int_nat(a: Int, b: Nat) -> Int = imin(a, b)
  model m_imin_int_int(a: Int, b: Int) -> Int = imin(a, b)
  model m_imax_nat_nat(a: Nat, b: Nat) -> Int = imax(a, b)
  model m_imax_nat_int(a: Nat, b: Int) -> Int = imax(a, b)
  model m_imax_int_nat(a: Int, b: Nat) -> Int = imax(a, b)
  model m_imax_int_int(a: Int, b: Int) -> Int = imax(a, b)
  model m_imin_literal(n: Nat) -> Int = imin(n, 3)
  model m_imax_literal_left(n: Int) -> Int = imax(3, n)

  -- endian conversions: be_bytes / le_bytes and from_be / from_le -------------------
  model m_be_bytes_u8(a: U8) -> Bytes<1> = be_bytes(a)
  model m_le_bytes_u8(a: U8) -> Bytes<1> = le_bytes(a)
  model m_from_be_u8(b: Bytes<1>) -> U8 = from_be<U8>(b)
  model m_from_le_u8(b: Bytes<1>) -> U8 = from_le<U8>(b)
  model m_be_bytes_u16(a: U16) -> Bytes<2> = be_bytes(a)
  model m_le_bytes_u16(a: U16) -> Bytes<2> = le_bytes(a)
  model m_from_be_u16(b: Bytes<2>) -> U16 = from_be<U16>(b)
  model m_from_le_u16(b: Bytes<2>) -> U16 = from_le<U16>(b)
  model m_be_bytes_u32(a: U32) -> Bytes<4> = be_bytes(a)
  model m_le_bytes_u32(a: U32) -> Bytes<4> = le_bytes(a)
  model m_from_be_u32(b: Bytes<4>) -> U32 = from_be<U32>(b)
  model m_from_le_u32(b: Bytes<4>) -> U32 = from_le<U32>(b)
  model m_be_bytes_u64(a: U64) -> Bytes<8> = be_bytes(a)
  model m_le_bytes_u64(a: U64) -> Bytes<8> = le_bytes(a)
  model m_from_be_u64(b: Bytes<8>) -> U64 = from_be<U64>(b)
  model m_from_le_u64(b: Bytes<8>) -> U64 = from_le<U64>(b)
  model m_be_bytes_i8(a: I8) -> Bytes<1> = be_bytes(a)
  model m_le_bytes_i8(a: I8) -> Bytes<1> = le_bytes(a)
  model m_from_be_i8(b: Bytes<1>) -> I8 = from_be<I8>(b)
  model m_from_le_i8(b: Bytes<1>) -> I8 = from_le<I8>(b)
  model m_be_bytes_i16(a: I16) -> Bytes<2> = be_bytes(a)
  model m_le_bytes_i16(a: I16) -> Bytes<2> = le_bytes(a)
  model m_from_be_i16(b: Bytes<2>) -> I16 = from_be<I16>(b)
  model m_from_le_i16(b: Bytes<2>) -> I16 = from_le<I16>(b)
  model m_be_bytes_i32(a: I32) -> Bytes<4> = be_bytes(a)
  model m_le_bytes_i32(a: I32) -> Bytes<4> = le_bytes(a)
  model m_from_be_i32(b: Bytes<4>) -> I32 = from_be<I32>(b)
  model m_from_le_i32(b: Bytes<4>) -> I32 = from_le<I32>(b)
  model m_be_bytes_i64(a: I64) -> Bytes<8> = be_bytes(a)
  model m_le_bytes_i64(a: I64) -> Bytes<8> = le_bytes(a)
  model m_from_be_i64(b: Bytes<8>) -> I64 = from_be<I64>(b)
  model m_from_le_i64(b: Bytes<8>) -> I64 = from_le<I64>(b)
  model m_from_be_literal() -> U16 = from_be<U16>(b"0102")
  model m_from_le_concat(t: Bytes<1>) -> U32 = from_le<U32>(concat(t, b"000000"))
  model m_from_be_if(c: Bool, t: Bytes<2>) -> U16 = from_be<U16>(if c then t else b"0102")
  model m_round_trip_u32(a: U32) -> U32 = from_be<U32>(be_bytes(a))

  -- at: Bytes and Bytes<N>, a Nat or an Int index -------------------------------------
  model m_at_nat(b: Bytes, i: Nat) -> U8 = unwrap_or(at(b, i), 0u8)
  model m_at_int(b: Bytes, i: Int) -> U8 = unwrap_or(at(b, i), 255u8)
  model m_at_fixed(b: Bytes<4>, i: Nat) -> U8 = unwrap_or(at(b, i), 0u8)
  model m_at_literal_index(b: Bytes) -> U8 = unwrap_or(at(b, 0), 0u8)

  -- compositions: the call closure (R9), nesting, and unwrap_or's default -------------
  model m_mix_u32(a: U32, b: U32) -> U32 = bit_xor(rotl(a, 5), shr(b, 3))
  model m_use_rotl(a: U32) -> U32 = m_rotl_u32(a, 7)
  model m_use_use(a: U32) -> U32 = m_use_rotl(m_mix_u32(a, a))
  model m_pure_core(a: U8) -> U8 = a + 1u8
  model m_to_core(a: U8) -> U8 = m_pure_core(a)
  model m_saturating_sub(a: U8, b: U8) -> U8 = unwrap_or(checked_sub(a, b), 0u8)
  model m_default_from_model(a: U8, b: U8) -> U8 = unwrap_or(div(a, b), m_pure_core(a))
  model m_if_fixed(a: U8) -> U8 = if bit(a, 0) then bit_not(a) else a
  model m_signed_min(a: I8) -> Bool = a == -128i8 or a == min_value<I8>()

  -- subject ops, claims and examples ---------------------------------------------------
  op op_and_u8(a: U8, b: U8) -> U8
  op op_not_u8(a: U8) -> U8
  op op_shl_u8(a: U8, n: Nat | n < 16) -> U8
  op op_pop_u8(a: U8) -> Nat
  op op_and_u16(a: U16, b: U16) -> U16
  op op_not_u16(a: U16) -> U16
  op op_shl_u16(a: U16, n: Nat | n < 32) -> U16
  op op_pop_u16(a: U16) -> Nat
  op op_and_u32(a: U32, b: U32) -> U32
  op op_not_u32(a: U32) -> U32
  op op_shl_u32(a: U32, n: Nat | n < 64) -> U32
  op op_pop_u32(a: U32) -> Nat
  op op_and_u64(a: U64, b: U64) -> U64
  op op_not_u64(a: U64) -> U64
  op op_shl_u64(a: U64, n: Nat | n < 128) -> U64
  op op_pop_u64(a: U64) -> Nat
  op op_and_i8(a: I8, b: I8) -> I8
  op op_not_i8(a: I8) -> I8
  op op_shl_i8(a: I8, n: Nat | n < 16) -> I8
  op op_pop_i8(a: I8) -> Nat
  op op_and_i16(a: I16, b: I16) -> I16
  op op_not_i16(a: I16) -> I16
  op op_shl_i16(a: I16, n: Nat | n < 32) -> I16
  op op_pop_i16(a: I16) -> Nat
  op op_and_i32(a: I32, b: I32) -> I32
  op op_not_i32(a: I32) -> I32
  op op_shl_i32(a: I32, n: Nat | n < 64) -> I32
  op op_pop_i32(a: I32) -> Nat
  op op_and_i64(a: I64, b: I64) -> I64
  op op_not_i64(a: I64) -> I64
  op op_shl_i64(a: I64, n: Nat | n < 128) -> I64
  op op_pop_i64(a: I64) -> Nat
  op op_low_u8(a: U8 | bit_and(a, 128u8) == 0u8) -> U8
  op op_be32(a: U32) -> Bytes<4>
  op op_div_u8(a: U8, b: U8) -> U8
  assume platform:
    none
  assume environment:
    none
  labels op_and_u8:
    a secret
    b secret
  labels op_not_u8:
    a secret
  labels op_shl_u8:
    a secret
    n secret
  labels op_pop_u8:
    a secret
  labels op_and_u16:
    a secret
    b secret
  labels op_not_u16:
    a secret
  labels op_shl_u16:
    a secret
    n secret
  labels op_pop_u16:
    a secret
  labels op_and_u32:
    a secret
    b secret
  labels op_not_u32:
    a secret
  labels op_shl_u32:
    a secret
    n secret
  labels op_pop_u32:
    a secret
  labels op_and_u64:
    a secret
    b secret
  labels op_not_u64:
    a secret
  labels op_shl_u64:
    a secret
    n secret
  labels op_pop_u64:
    a secret
  labels op_and_i8:
    a secret
