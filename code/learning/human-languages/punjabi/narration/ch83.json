            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Punjabi for sweet, then the Punjabi for fat."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ਪਤਲਾ",
          "segments": [
            {
              "kind": "speech",
              "text": "ਪਤਲਾ — patlā — \"thin\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ਪਤਲਾ (patlā) came into Punjabi from Hindi. CDIAL lists Hindi patlā, \"thin, weak\", under Sanskrit pattrala, \"leafy\", and so \"leaf-like, thin\", and marks the Punjabi word as taken from it (CDIAL 7736)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for this chapter."
            }
          ]
        },
        {
