        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: teimoso",
          "segments": [
            {
              "kind": "speech",
              "text": "teimoso — \"stubborn\"."
            },
            {
              "kind": "speech",
              "text": "O meu avô é teimoso e nunca muda de ideias. My grandfather is stubborn and never changes his mind."
            },
            {
              "kind": "speech",
              "text": "Of things too: uma tosse teimosa — a cough that will not go away."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "teimoso is built on teima \"obstinacy\", which is usually traced to Latin thema \"a theme, a topic\", from Greek (EtymDB); the path of meaning is not fully settled."
            }
          ]
        },
        {
          "index": 3,
