    {
      "id": "PA-C216-gae-return",
      "sequence": 11780,
      "title": "Return to a familiar went",
      "headword": "ਉਹ ਗਏ",
      "romanization": "uh gae",
      "gloss": "retrieve the familiar they went by ear",
      "script": "gurmukhi",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:47f04bbeb72163f5",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "prompt",
              "action": "HEAR",
              "instruction": "oh gae",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU HEAR: *oh gae*]"
            },
            {
              "kind": "speech",
              "text": "Say ਉਹ ਗਏ (uh gae), \"they went\". Then to go: ਜਾਣਾ."
            }
          ]
        },
        {
          "index": 1,
          "type": "grammar",
          "title": "Grammar Lens",
          "segments": [
            {
              "kind": "speech",
              "text": "ਗਏ is the went form for a group, or for one person you respect. Today it gets two partners: one for a man, one for a woman. Hold ਉਹ ਰੋਜ਼ ਸਕੂਲ ਜਾਂਦਾ ਹੈ beside it: every day, and once, in the past."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "HEAR",
              "instruction": "they went",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU HEAR: *they went*]"
            },
            {
              "kind": "speech",
              "text": "Say ਉਹ ਗਏ (uh gae)."
            },
            {
              "kind": "prompt",
              "action": "HEAR",
              "instruction": "he goes to school every day",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU HEAR: *he goes to school every day*]"
            },
            {
              "kind": "speech",
              "text": "Say ਉਹ ਰੋਜ਼ ਸਕੂਲ ਜਾਂਦਾ ਹੈ."
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Say they went once more. No new form is needed yet."
            }
          ]
        }
      ]
    },
    {
      "id": "PA-C216-gia-gai",
      "sequence": 11790,
      "title": "ਗਿਆ, ਗਈ — went",
      "headword": "ਗਿਆ · ਗਈ",
      "romanization": "giā · gaī",
      "gloss": "went: the past of ਜਾਣਾ, agreeing with the one who went",
      "script": "gurmukhi",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:71c70bbd92659fc5",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Say they went. Then home and school."
            }
          ]
        },
        {
          "index": 1,
          "type": "grammar",
          "title": "Grammar Lens: one went for each",
          "segments": [
            {
              "kind": "speech",
              "text": "The went form agrees with whoever went: ਗਿਆ for a man or a boy, ਗਈ for a woman or a girl, and the ਗਏ you know for a group."
            },
            {
              "kind": "speech",
              "text": "ਅਮਨ ਘਰ ਗਿਆ। — Aman ghar giā. — Aman went home."
            },
            {
              "kind": "speech",
              "text": "ਕੁੜੀ ਸਕੂਲ ਗਈ। — kuṛī sakūl gaī. — The girl went to school."
            },
            {
              "kind": "speech",
              "text": "ਉਹ ਕਿੱਥੇ ਗਏ? — uh kitthe gae? — Where did they go?"
            },
            {
              "kind": "speech",
              "text": "There is no helper at the end. CDIAL lists Punjabi geā, \"gone\", under Sanskrit gata, \"gone\" (CDIAL 4008)."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "HEAR",
              "instruction": "the boy went to school",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU HEAR: *the boy went to school*]"
            },
            {
              "kind": "speech",
              "text": "Say ਮੁੰਡਾ ਸਕੂਲ ਗਿਆ।."
            },
            {
              "kind": "prompt",
              "action": "HEAR",
              "instruction": "she went home",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU HEAR: *she went home*]"
            },
            {
              "kind": "speech",
              "text": "Say ਉਹ ਘਰ ਗਈ।."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "ਅਮਨ ਘਰ ਗਿਆ।",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: **ਅਮਨ ਘਰ ਗਿਆ।**]"
            },
            {
              "kind": "speech",
              "text": "Give its meaning."
            },
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "copy ਗਿਆ and ਗਈ once",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: copy **ਗਿਆ** and **ਗਈ** once]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Went, for a man? (ਗਿਆ.) For a woman? (ਗਈ.) For a group? (ਗਏ.)"
            }
          ]
        }
      ]
    },
