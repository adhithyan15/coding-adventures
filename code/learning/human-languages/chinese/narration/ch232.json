        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: 出事",
          "segments": [
            {
              "kind": "speech",
              "text": "出事 — chūshì — \"to have an accident; for something to go wrong\"."
            },
            {
              "kind": "speech",
              "text": "前天雪很大这儿出事了 qiántiān xuě hěn dà zhèr chūshì le — The day before yesterday the snow was heavy, and there was an accident here."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "出事 (chūshì) is built from 出 'to come out' and 事 'a matter', both inherited from Middle Chinese, tsyhwit and dzriH (Guangyun, in Baxter's transcription), which glosses the second 'to employ' and 'to set up'; 'a matter' is the everyday sense, not the gloss."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for talking about the past."
            }
          ]
        },
