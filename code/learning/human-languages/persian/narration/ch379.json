        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: استعفا دادن",
          "segments": [
            {
              "kind": "speech",
              "text": "استعفا دادن (este'fâ dâdan) — \"to resign\"."
            },
            {
              "kind": "speech",
              "text": "مدیر شرکت دیروز استعفا داد. modir-e sherkat diruz este'fâ dâd. The company director resigned yesterday."
            },
            {
              "kind": "speech",
              "text": "Este'fâ \"resignation\" + dâdan (stem deh-). Az kâr este'fâ dâdan — to resign from a job."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "استعفا is usually traced to Arabic isti'fā' \"asking to be excused, asking to be let off\"; with dâdan \"to give\" you hand in your resignation."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
