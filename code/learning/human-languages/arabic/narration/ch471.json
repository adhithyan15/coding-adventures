        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: خليج",
          "segments": [
            {
              "kind": "speech",
              "text": "خليج — khalīj — \"a gulf; a bay\"."
            },
            {
              "kind": "speech",
              "text": "سبحنا في خليج صغير. sabaḥnā fī khalīj ṣaghīr. We swam in a small bay."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "خليج (khalīj) is built on the native Arabic root kh-l-j, \"to draw away\" (Lane). A khalīj was a channel drawn off a river, and then an arm of the sea."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for getting around."
