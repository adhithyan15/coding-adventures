          "type": "input",
          "title": "You'll want to know: raisonner",
          "segments": [
            {
              "kind": "speech",
              "text": "raisonner — \"to reason, to think logically\"."
            },
            {
              "kind": "speech",
              "text": "Il raisonne bien, mais il parle trop vite. He reasons well, but he speaks too fast."
            },
            {
              "kind": "speech",
              "text": "From raison. Not to be mixed up with résonner, to resound."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "raisonner is built on raison \"reason\", which is inherited from Latin ratiō, ratiōnis \"a reckoning, reason\" (Lewis & Short)."
            }
          ]
        },
