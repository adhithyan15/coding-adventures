        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "پیاسا (pyāsā) is a tadbhava, a word inherited from Sanskrit and reshaped by sound change. It comes from pipāsaka, \"thirsty\", a form CDIAL reconstructs beside Sanskrit pipāsita (CDIAL 8200)."
            }
          ]
        },
