        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: la peine",
          "segments": [
            {
              "kind": "speech",
              "text": "la peine — \"the sentence, the penalty; sorrow\"."
            },
            {
              "kind": "speech",
              "text": "Il a eu une peine de deux ans de prison. He got a two-year prison sentence."
            },
            {
              "kind": "speech",
              "text": "Avoir de la peine — to be sad. Ce n'est pas la peine — it is not worth it."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "peine is inherited through Old French from Latin poena \"a penalty, punishment\" (Lewis & Short), itself from Greek poinḗ \"a fine\"."
            }
          ]
        },
        {
