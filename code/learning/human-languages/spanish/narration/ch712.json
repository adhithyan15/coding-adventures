        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: la sensación",
          "segments": [
            {
              "kind": "speech",
              "text": "la sensación — \"the sensation, the feeling\"."
            },
            {
              "kind": "speech",
              "text": "Tengo la sensación de que va a llover. I have a feeling it is going to rain."
            },
            {
              "kind": "speech",
              "text": "Tengo la sensación de que... — I have the feeling that..."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "sensación is usually described as a learned borrowing from Medieval Latin sēnsātiō, built on sēnsus \"feeling\", from sentīre \"to feel\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
