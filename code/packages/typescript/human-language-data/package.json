{
  "name": "@coding-adventures/human-language-data",
  "version": "0.3.0",
  "description": "Cross-language concept dataset + validator derived from the Human Languages curriculum (spec HL01)",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "generate:books": "node dist/book-cli.js --write",
    "check:books": "node dist/book-cli.js --check",
    "generate:figures": "node dist/figure-cli.js --write",
    "check:figures": "node dist/figure-cli.js --check",
    "generate:modality": "node dist/modality-cli.js --write",
    "check:modality": "node dist/modality-cli.js --check",
    "generate:narration": "node dist/narration-cli.js --write",
    "check:narration": "node dist/narration-cli.js --check",
    "generate:progress": "node dist/track-progress-cli.js --write",
    "check:progress": "node dist/track-progress-cli.js --check",
    "generate:gentle-snapshots": "node dist/gentle-ramp-snapshot-cli.js --write",
    "check:gentle-snapshots": "node dist/gentle-ramp-snapshot-cli.js --check",
    "generate:level-snapshots": "node dist/level-snapshot-cli.js --write",
    "check:level-snapshots": "node dist/level-snapshot-cli.js --check",
    "generate:assessment-artifacts": "node dist/assessment-artifact-cli.js --write",
    "check:assessment-artifacts": "node dist/assessment-artifact-cli.js --check",
    "shard": "node dist/shard-cli.js --shard",
    "unshard": "node dist/shard-cli.js --unshard",
    "check:shards": "node dist/shard-cli.js --check",
    "shard:docs": "node dist/doc-shard-cli.js --shard",
    "unshard:docs": "node dist/doc-shard-cli.js --unshard",
    "check:doc-shards": "node dist/doc-shard-cli.js --check",
    "generate:script-owner-evidence": "node dist/script-owner-evidence-cli.js --write",
    "check:script-owner-evidence": "node dist/script-owner-evidence-cli.js --check",
    "check:compile": "bash ../../../scripts/check-book-compile.sh",
    "report": "node dist/report-cli.js",
    "report:gentle-ramp": "node dist/gentle-ramp-cli.js",
    "plan": "node dist/plan-cli.js",
    "validate": "vitest run tests/integration.test.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "license": "MIT",
  "author": "Adhithya Rajasekaran",
  "dependencies": {
    "@coding-adventures/paint-instructions": "file:../paint-instructions",
    "@coding-adventures/paint-vm-svg": "file:../paint-vm-svg"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0",
    "@vitest/coverage-v8": "^4.1.0"
  }
}
