// EngramApp.dark.msl - dark app-shell style for the Engram Mosaic app.

style EngramApp {
  part app-shell {
    background  : "#101827" ;
    color       : "#f8fafc" ;
    font-family : "system-ui, sans-serif" ;
    padding     : 24 ;
    gap         : 18 ;
  }

  part app-header {
    align-items     : center ;
    background      : "#0f172a" ;
    border-color    : "#334155" ;
    border-radius   : 8 ;
    border-width    : 1 ;
    flex-wrap       : wrap ;
    gap             : 16 ;
    justify-content : space-between ;
    padding         : 12 ;
  }

  part app-title {
    color          : "#f8fafc" ;
    font-size      : 28 ;
    font-weight    : 700 ;
  }

  part app-nav {
    flex-wrap : wrap ;
    gap       : 8 ;
  }

  part nav-decks-button {
    background    : "#1f2937" ;
    border-color  : "#475569" ;
    border-radius : 6 ;
    border-width  : 1 ;
    color         : "#e5e7eb" ;
    font-weight   : 700 ;
    padding       : 8 ;
  }

  part nav-study-button {
    background    : "#1f2937" ;
    border-color  : "#475569" ;
    border-radius : 6 ;
    border-width  : 1 ;
    color         : "#e5e7eb" ;
    font-weight   : 700 ;
    padding       : 8 ;
  }

  part nav-browse-button {
    background    : "#1f2937" ;
    border-color  : "#475569" ;
    border-radius : 6 ;
    border-width  : 1 ;
    color         : "#e5e7eb" ;
    font-weight   : 700 ;
    padding       : 8 ;
  }

  part nav-add-button {
    background    : "#1f2937" ;
    border-color  : "#475569" ;
    border-radius : 6 ;
    border-width  : 1 ;
    color         : "#e5e7eb" ;
    font-weight   : 700 ;
    padding       : 8 ;
  }

  part nav-stats-button {
    background    : "#1f2937" ;
    border-color  : "#475569" ;
    border-radius : 6 ;
    border-width  : 1 ;
    color         : "#e5e7eb" ;
    font-weight   : 700 ;
    padding       : 8 ;
  }

  part nav-options-button {
    background    : "#1f2937" ;
    border-color  : "#475569" ;
    border-radius : 6 ;
    border-width  : 1 ;
    color         : "#e5e7eb" ;
    font-weight   : 700 ;
    padding       : 8 ;
  }

  part nav-decks-active {
    background    : "#e5e7eb" ;
    border-color  : "#f8fafc" ;
    border-radius : 6 ;
    border-width  : 1 ;
    color         : "#111827" ;
    font-weight   : 800 ;
    padding       : 8 ;
  }

  part nav-study-active {
    background    : "#e5e7eb" ;
    border-color  : "#f8fafc" ;
    border-radius : 6 ;
    border-width  : 1 ;
    color         : "#111827" ;
    font-weight   : 800 ;
    padding       : 8 ;
  }

  part nav-browse-active {
    background    : "#e5e7eb" ;
    border-color  : "#f8fafc" ;
    border-radius : 6 ;
    border-width  : 1 ;
    color         : "#111827" ;
    font-weight   : 800 ;
    padding       : 8 ;
  }

  part nav-add-active {
    background    : "#e5e7eb" ;
    border-color  : "#f8fafc" ;
    border-radius : 6 ;
    border-width  : 1 ;
    color         : "#111827" ;
    font-weight   : 800 ;
    padding       : 8 ;
  }

  part nav-stats-active {
    background    : "#e5e7eb" ;
    border-color  : "#f8fafc" ;
    border-radius : 6 ;
    border-width  : 1 ;
    color         : "#111827" ;
    font-weight   : 800 ;
    padding       : 8 ;
  }

  part nav-options-active {
    background    : "#e5e7eb" ;
    border-color  : "#f8fafc" ;
    border-radius : 6 ;
    border-width  : 1 ;
    color         : "#111827" ;
    font-weight   : 800 ;
    padding       : 8 ;
  }

  part decks-screen {
    gap       : 14 ;
    max-width : "980px" ;
  }

  part study-screen {
    gap       : 14 ;
    max-width : "760px" ;
  }

  part browse-screen {
    max-width : "1100px" ;
  }

  part add-screen {
    max-width : "860px" ;
  }

  part stats-screen {
    max-width : "860px" ;
  }

  part options-screen {
    gap       : 14 ;
    max-width : "960px" ;
  }

  part stats-region {
    padding-bottom : 0 ;
  }

  part deck-options-region {
    padding-bottom : 0 ;
  }

  part review-history-region {
    padding-bottom : 0 ;
  }

  part collection-region {
    padding-bottom : 0 ;
  }

  part browser-region {
    padding-bottom : 0 ;
  }

  part note-editor-region {
    padding-bottom : 0 ;
  }

  part note-type-editor-region {
    padding-bottom : 0 ;
  }

  part review-region {
    padding-top : 16 ;
    padding : 4 ;
  }
}
