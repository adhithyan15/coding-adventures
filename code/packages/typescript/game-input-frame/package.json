{
  "name": "@coding-adventures/game-input-frame",
  "version": "0.1.0",
  "description": "Deterministic caller-ticked logical input-frame reducer (GAME-050)",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc",
    "test": "node node_modules/typescript/bin/tsc -p tsconfig.test.json && node --test dist-test/tests/*.test.js",
    "test:coverage": "node node_modules/typescript/bin/tsc -p tsconfig.test.json && node --experimental-test-coverage --test-coverage-include=dist-test/src/**/*.js --test-coverage-exclude=dist-test/tests/** --test-coverage-lines=95 --test dist-test/tests/*.test.js"
  },
  "license": "MIT",
  "author": "Adhithya Rajasekaran",
  "devDependencies": {
    "@coding-adventures/fuzz": "file:../fuzz",
    "@coding-adventures/test-bootstrap": "file:../test-bootstrap",
    "@types/node": "^24.0.0",
    "typescript": "^5.0.0"
  }
}
