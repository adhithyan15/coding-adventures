              "kind": "speech",
              "text": "expergīscor, expergīscī — \"to wake up\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "expergīscor is built on expergō, \"to wake up\" (Lewis & Short), with -scor, the ending of verbs of becoming; expergō is often explained as ex, \"out\", with pergō, \"to go on\"."
            }
          ]
        },
