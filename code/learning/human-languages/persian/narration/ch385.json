        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: جامعه",
          "segments": [
            {
              "kind": "speech",
              "text": "جامعه (jâme'e) — \"a society, a community\"."
            },
            {
              "kind": "speech",
              "text": "جوانها آینده جامعه هستند. javânhâ âyande-ye jâme'e hastand. Young people are the future of society."
            },
            {
              "kind": "speech",
              "text": "Plural javâme', an Arabic broken plural. Jâme'e-shenâsi — sociology."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "جامعه (jâme'e) comes from Arabic jāmi'a (EtymDB), a word usually explained as what gathers people together; in Persian it is a society."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
