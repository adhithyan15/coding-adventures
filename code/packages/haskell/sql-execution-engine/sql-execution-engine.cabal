cabal-version: 3.0
name:          sql-execution-engine
version:       0.1.0
synopsis:      SELECT execution engine for mini-sqlite data sources
description:   Executes SELECT queries over pluggable Haskell mini-sqlite data sources.
category:      Database
license:       MIT
author:        Adhithya Rajasekaran
maintainer:    Adhithya Rajasekaran
build-type:    Simple
extra-doc-files:
    README.md
    CHANGELOG.md

library
    exposed-modules:  SqlExecutionEngine
    build-depends:    base >=4.14 && <5
                    , containers >=0.6 && <0.9
    hs-source-dirs:   src
    default-language: Haskell2010

test-suite spec
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    other-modules:    SqlExecutionEngineSpec
    hs-source-dirs:   test
    build-depends:    base >=4.14 && <5
                    , containers >=0.6 && <0.9
                    , sql-execution-engine
                    , hspec == 2.*
    default-language: Haskell2010
