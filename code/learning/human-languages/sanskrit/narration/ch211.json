              "instruction": "forgives, blames, praises, accepts, blossoms",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: forgives, blames, praises, accepts, blossoms]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "sinks, bathes, frolics, shuts, opens",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: sinks, bathes, frolics, shuts, opens]"
