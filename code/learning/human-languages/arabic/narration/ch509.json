        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: عدوى",
          "segments": [
            {
              "kind": "speech",
              "text": "عدوى — ʿadwā — \"an infection, contagion\"."
            },
            {
              "kind": "speech",
              "text": "انتقلت العدوى من طفل إلى طفل. intaqalat al-ʿadwā min ṭifl ilā ṭifl. The infection passed from child to child."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "عدوى (ʿadwā) is built on the native Arabic root ʿ-d-w, \"to run, to pass beyond\" (Lane). ʿAdwā is a thing that runs from one person to another."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for describing what you lived and felt."
