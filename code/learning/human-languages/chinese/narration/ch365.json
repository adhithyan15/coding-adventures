            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say kěshì — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *kěshì* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "口 是."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — kǒu, shì",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *kǒu*, *shì*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — a bar, a mouth and a hook",
          "segments": [
            {
              "kind": "speech",
              "text": "可 (kě)."
            },
            {
              "kind": "speech",
              "text": "One piece, five strokes. Count it in three parts."
            },
            {
              "kind": "speech",
              "text": "A long horizontal across the top."
            },
            {
              "kind": "speech",
              "text": "口, three strokes, small, under the bar on the left: a vertical, a horizontal that turns down, and the bottom horizontal."
            },
            {
              "kind": "speech",
              "text": "A long vertical down the right side, from the bar to the foot, hooking up to the left."
            },
            {
              "kind": "speech",
              "text": "1 + 3 + 1 = five."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "可 (kě), all five, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 可, all five, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many strokes in 可 (kě)? (Five.) What is the small box? (口.) What comes last? (The long vertical with its hook.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 可 (kě), pinned stroke paths and medians."
            }
          ]
        }
      ]
