          "segments": [
            {
              "kind": "speech",
              "text": "immerhin — \"after all, still (on the bright side)\"."
            },
            {
              "kind": "speech",
              "text": "Wir haben verloren. Immerhin haben wir ein Tor geschossen. We lost. Still, we scored a goal."
            },
            {
              "kind": "speech",
              "text": "It names the good side of a bad result. The verb comes right after it."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "immerhin joins immer \"always\", from Middle High German immer (EtymDB), to hin \"onward, away\": whatever happens, this much stands."
            }
          ]
        },
        {
