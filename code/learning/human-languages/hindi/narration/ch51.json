      "id": "HI-C51-flower",
      "sequence": 1650,
      "title": "फूल (phūl) — a flower",
      "headword": "फूल",
      "romanization": "phūl",
      "gloss": "a flower",
      "script": "devanagari",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
