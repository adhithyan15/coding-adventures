          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "следователь (slédovatel) is built on следовать \"to follow\", from след \"a track, a trail\" (EtymDB): one who follows the footsteps."
            }
          ]
        },
