              "prompt": "Dar is an -ar verb. Which endings does it take in the past?",
              "assesses": [
                "ES-LEX-DAR",
                "ES-GRAMMAR-DAR-PRETERITE"
              ],
              "responseSeconds": 13,
              "acceptedResponses": [
                "the -er endings",
                "-er endings",
                "those of comer"
              ],
              "feedback": {
                "correct": "It changes families for the preterite alone.",
                "incorrect": "The -er endings, the ones comer takes."
              }
            },
            {
              "kind": "activity",
              "scored": true,
              "id": "ES-C65-di-bare",
              "prompt": "Which two preterite forms of dar carry no written accent, and why?",
              "assesses": [
