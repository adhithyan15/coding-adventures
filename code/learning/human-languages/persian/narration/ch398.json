        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: امکان پذیر",
          "segments": [
            {
              "kind": "speech",
              "text": "امکان پذیر (emkân pazir) — \"possible, feasible\"."
            },
            {
              "kind": "speech",
              "text": "این طرح با این پول امکان پذیر نیست. in tarh bâ in pul emkân pazir nist. This plan is not feasible with this money."
            },
            {
              "kind": "speech",
              "text": "Emkân \"possibility\" + pazir \"accepting\", from paziroftan."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "امکان پذیر (emkân pazir) joins emkân \"possibility\", usually traced to Arabic imkān, to pazir \"accepting\", the present stem of the inherited verb paziroftan (EtymDB traces it to Middle Persian): open to being possible."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
