  model m_try_int_i8(a: Int) -> I8 = unwrap_or(try<I8>(a), 0i8)
  model m_wrap_nat_i8(a: Nat) -> I8 = wrap<I8>(a)
  model m_try_nat_i8(a: Nat) -> I8 = unwrap_or(try<I8>(a), 0i8)
  model m_wrap_u8_i16(a: U8) -> I16 = wrap<I16>(a)
