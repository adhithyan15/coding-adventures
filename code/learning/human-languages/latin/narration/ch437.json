        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: fūnis, fūnis",
          "segments": [
            {
              "kind": "speech",
              "text": "fūnis, fūnis — \"a rope, a cord\"."
            },
            {
              "kind": "speech",
              "text": "Nāvis fūne ad lītus ligātur. The ship is tied to the shore with a rope."
            },
            {
              "kind": "speech",
              "text": "Third declension, usually masculine: fūnis, fūnis m. English funicular, a railway pulled by a rope, comes from it."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "fūnis is inherited and is usually traced to PIE bʰendʰ- 'to bind, to tie' (EtymDB); Lewis & Short also suggest, with a perhaps, the Sanskrit root for binding. English funicular comes from its diminutive fūniculus."
            }
          ]
        },
