              "instruction": "say the Mandarin for a folk song, then the Mandarin for to perform a song (on stage), then say wǔdǎo again",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say the Mandarin for a folk song, then the Mandarin for to perform a song (on stage), then say *wǔdǎo* again]"
            }
          ]
