        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "سابقا (sābiqan) is built on the native Arabic root s-b-q, \"to go before, to outstrip\" (Lane). Sābiqan is the active participle, \"preceding\", with the adverb ending -an."
            }
          ]
        },
