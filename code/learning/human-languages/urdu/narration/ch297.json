          "segments": [
            {
              "kind": "speech",
              "text": "کیمپ — kaimp — \"a relief camp; a camp\"."
            },
            {
              "kind": "speech",
              "text": "شہر کے باہر ایک کیمپ تھا۔ shahr ke bāhar ek kaimp thā. There was a camp outside the city."
            },
