          "title": "You'll want to know: a jardinagem",
          "segments": [
            {
              "kind": "speech",
              "text": "a jardinagem — \"gardening\"."
            },
            {
              "kind": "speech",
              "text": "A jardinagem é o passatempo preferido do meu pai. Gardening is my father's favourite hobby."
            },
            {
              "kind": "speech",
              "text": "Built on o jardim."
            }
          ]
