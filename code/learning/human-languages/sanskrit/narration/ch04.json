              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: \"gacchāmi\" — I go]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "the root and its Chapter-1 cousin (gam; svāgatam, \"well come\")",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: the root and its Chapter-1 cousin (*gam*; *svāgatam*, \"well come\")]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "the English cousin of gam (come)",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: the English cousin of *gam* (**come**)]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How does Sanskrit take leave, and what root is gacchāmi from? (By saying \"I go,\" gacchāmi; the root gam, PIE gʷem-, cousin of English come.)"
            }
          ]
        }
      ]
    },
