            },
            {
              "kind": "speech",
              "text": "Before the new one: say the German for the journalist, then the German for the front page."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: veröffentlichen",
          "segments": [
            {
              "kind": "speech",
              "text": "veröffentlichen — \"to publish\"."
            },
            {
              "kind": "speech",
              "text": "Die Zeitung veröffentlichte das Foto am Montag. The newspaper published the photo on Monday."
            },
            {
              "kind": "speech",
              "text": "Built on öffentlich, already known. Perfekt: hat veröffentlicht."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "veröffentlichen is built on öffentlich \"public\", from offen \"open\", an inherited Germanic word; EtymDB lists no parent for the verb: to make open to all."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
            }
          ]
