              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say the Bengali for a prisoner, then the Bengali for bail, then say *shāsāno* again]"
            }
          ]
        },
        {
          "index": 5,
