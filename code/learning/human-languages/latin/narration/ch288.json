              "instruction": "Decem diēs ibi mānsī.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *Decem diēs ibi mānsī.*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "Rōma maior erat quam putāvī, et laetus eram.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *Rōma maior erat quam putāvī, et laetus eram.*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "Iterum Rōmam vidēre cupiō, et spērō tē venīre.",
              "spoken": true,
