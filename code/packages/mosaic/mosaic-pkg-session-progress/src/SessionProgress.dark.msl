// SessionProgress.dark.msl - dark review-session counter theme.

style SessionProgress {
  part progress-strip {
    background    : "#111827" ;
    border-width  : 1 ;
    border-color  : "#334155" ;
    border-radius : 8 ;
    padding       : 12 ;
  }

  part metric-current {
    background    : "#1e293b" ;
    border-width  : 1 ;
    border-color  : "#334155" ;
    border-radius : 6 ;
    padding       : 10 ;
  }

  part metric-remaining {
    background    : "#1e293b" ;
    border-width  : 1 ;
    border-color  : "#334155" ;
    border-radius : 6 ;
    padding       : 10 ;
  }

  part metric-correct {
    background    : "#1e293b" ;
    border-width  : 1 ;
    border-color  : "#334155" ;
    border-radius : 6 ;
    padding       : 10 ;
  }

  part metric-total {
    background    : "#1e293b" ;
    border-width  : 1 ;
    border-color  : "#334155" ;
    border-radius : 6 ;
    padding       : 10 ;
  }

  part current-label {
    color       : "#94a3b8" ;
    font-size   : 11 ;
    font-weight : 700 ;
  }

  part remaining-label {
    color       : "#94a3b8" ;
    font-size   : 11 ;
    font-weight : 700 ;
  }

  part correct-label {
    color       : "#94a3b8" ;
    font-size   : 11 ;
    font-weight : 700 ;
  }

  part total-label {
    color       : "#94a3b8" ;
    font-size   : 11 ;
    font-weight : 700 ;
  }

  part current-value {
    color       : "#f8fafc" ;
    font-size   : 20 ;
    font-weight : 800 ;
  }

  part remaining-value {
    color       : "#fbbf24" ;
    font-size   : 20 ;
    font-weight : 800 ;
  }

  part correct-value {
    color       : "#4ade80" ;
    font-size   : 20 ;
    font-weight : 800 ;
  }

  part total-value {
    color       : "#94a3b8" ;
    font-size   : 20 ;
    font-weight : 800 ;
  }
}
