              "instruction": "mātra, once more",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *mātra*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "ghar lahān āhe, mātra khūp svaccha āhe. — The house is small; it is very clean, though.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *ghar lahān āhe, mātra khūp svaccha āhe.* — The house is small; it is very clean, though.]"
            },
            {
