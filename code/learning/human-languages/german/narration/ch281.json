        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: einbrechen",
          "segments": [
            {
              "kind": "speech",
              "text": "einbrechen — \"to break in, to burgle\"."
            },
            {
              "kind": "speech",
              "text": "In der Nacht brachen Diebe in das Geschäft ein. At night thieves broke into the shop."
            },
            {
              "kind": "speech",
              "text": "Separable, Perfekt with sein: Jemand ist eingebrochen. Also of ice: Das Eis brach ein."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "einbrechen joins ein \"in\" and brechen \"to break\", from Old High German brehhan, Proto-Germanic brekaną (EtymDB)."
            }
          ]
        },
        {
