warrant vos_sched_any v1
  -- vos02:generated by vos-link gen-doc; do not edit; contract-package=vos_sched_contract
  -- vos02:contract-begin sha256=fd4b88aaa4cab44c03947906aab0d8b97b996351111608de19446ef40b8f673b
  variant Upd = Changed | Unchanged | OutOfRange
  variant Pick = Idle | Run(t: U8)

  -- Abstract state M: the ready set over the thread ids 0..7. Thread t has priority t, so a
  -- larger id wins. Eight Bools: structural equality is set equality (VOS01 section 2.1).
  record Ready(p0: Bool, p1: Bool, p2: Bool, p3: Bool, p4: Bool, p5: Bool, p6: Bool, p7: Bool)
  model ready_of(b0: Bool, b1: Bool, b2: Bool, b3: Bool, b4: Bool, b5: Bool, b6: Bool, b7: Bool) -> Ready = Ready(b0, b1, b2, b3, b4, b5, b6, b7)
  model empty() -> Ready = Ready(false, false, false, false, false, false, false, false)
  model mem(m: Ready, i: U8) -> Bool = (
    (i == 0u8 and m.p0) or (i == 1u8 and m.p1) or (i == 2u8 and m.p2) or (i == 3u8 and m.p3) or
    (i == 4u8 and m.p4) or (i == 5u8 and m.p5) or (i == 6u8 and m.p6) or (i == 7u8 and m.p7))
  model set_at(cur: Bool, i: U8, k: U8, b: Bool) -> Bool = if i == k then b else cur
  model put(m: Ready, i: U8, b: Bool) -> Ready = (
    Ready(set_at(m.p0, i, 0u8, b), set_at(m.p1, i, 1u8, b), set_at(m.p2, i, 2u8, b), set_at(m.p3, i, 3u8, b),
          set_at(m.p4, i, 4u8, b), set_at(m.p5, i, 5u8, b), set_at(m.p6, i, 6u8, b), set_at(m.p7, i, 7u8, b)))
  model subset(a: Ready, b: Ready) -> Bool = (
    (not a.p0 or b.p0) and (not a.p1 or b.p1) and (not a.p2 or b.p2) and (not a.p3 or b.p3) and
    (not a.p4 or b.p4) and (not a.p5 or b.p5) and (not a.p6 or b.p6) and (not a.p7 or b.p7))

  -- inv(M) is total: every one of the 256 states is well formed, so there is nothing to
  -- preserve by accident. It is still written down, and closure is still claimed below, so
  -- a later M with structure (queues, counts) cannot change inv without restating closure.
  model inv(m: Ready) -> Bool = true
  model init_m() -> Ready = empty()

  -- Total abstract operations: every U8 id has a defined answer.
  model abs_insert(m: Ready, t: U8) -> (Upd, Ready) = (
    if t >= 8u8 then (OutOfRange, m)
    else (if mem(m, t) then (Unchanged, m) else (Changed, put(m, t, true))))
  model abs_remove(m: Ready, t: U8) -> (Upd, Ready) = (
    if t >= 8u8 then (OutOfRange, m)
    else (if mem(m, t) then (Changed, put(m, t, false)) else (Unchanged, m)))

  -- dispatch is not a function of M in the safety tier (any ready thread, or Idle, may be
  -- chosen), so M gives it a successor as a function of the CHOICE: the chosen thread leaves.
  model after(m: Ready, o: Pick) -> Ready = (
    match o with Idle -> m | Run(t) -> put(m, t, false))
  model valid_pick(m: Ready, o: Pick) -> Bool = (
    match o with Idle -> true | Run(t) -> t < 8u8 and mem(m, t))
  -- The highest-priority ready thread (the largest id), or Idle for the empty set.
  model top(m: Ready) -> Pick = (
    if m.p7 then Run(7u8) else (if m.p6 then Run(6u8) else (if m.p5 then Run(5u8) else
    (if m.p4 then Run(4u8) else (if m.p3 then Run(3u8) else (if m.p2 then Run(2u8) else
    (if m.p1 then Run(1u8) else (if m.p0 then Run(0u8) else Idle))))))))
  -- A Pick from a byte: 255 is Idle, anything else names a thread (possibly an invalid one).
  -- Lemmas use it to range over every Pick without a variant binder.
  model pick_of(k: U8) -> Pick = if k == 255u8 then Idle else Run(k)

  -- Caller preconditions (VOS01 section 2.8): the id names a thread. Outside it the
  -- operation answers OutOfRange and changes nothing. dispatch has none.
  model pre_insert(m: Ready, t: U8) -> Bool = t < 8u8
  model pre_remove(m: Ready, t: U8) -> Bool = t < 8u8

  -- Safety tier: a RELATION over (state, output, new state). What system theorems may use.
  model safe_dispatch(m: Ready, o: Pick, m2: Ready) -> Bool = valid_pick(m, o) and m2 == after(m, o)
  -- Policy tier: the fixed-priority function. What the hard-RTOS and flight profiles add.
  model policy_dispatch(m: Ready, o: Pick, m2: Ready) -> Bool = o == top(m) and m2 == after(m, o)
  -- vos02:contract-end
  -- vos02:impl-begin
  -- The implementation block of vos-sched-any (VOS-012a): the most-general scheduler.  Impl is
  -- Impl(mask: U8, choice: U8): a bitmap, bit i set when thread i is ready, plus the oracle
  -- register `choice` that alpha_w drops.  dispatch PROPOSES the thread the oracle names,
  -- VALIDATES it against the ready set and DEFAULTS to Idle.  The claims of the `safety` and `any`
  -- obligation blocks are what the evidence runs against it; the `any` claims quantify over Impl
  -- directly (the oracle is a binder), the safety claims over build(M), whose oracle is 0.
  -- Bound operations, no bodies (R3).  The `assume` rows are not here: gen-doc appends them.
  record Impl(mask: U8, choice: U8)
  record AbsW(w: U8)
  record CfgN(v: U8)
  model dec(x: AbsW) -> Ready = (
    Ready(not (bit_and(x.w, 1u8) == 0u8), not (bit_and(x.w, 2u8) == 0u8), not (bit_and(x.w, 4u8) == 0u8),
          not (bit_and(x.w, 8u8) == 0u8), not (bit_and(x.w, 16u8) == 0u8), not (bit_and(x.w, 32u8) == 0u8),
          not (bit_and(x.w, 64u8) == 0u8), not (bit_and(x.w, 128u8) == 0u8)))
  op init() -> Impl
  op insert_out(s: Impl, t: U8) -> Upd
  op insert_img(s: Impl, t: U8) -> Impl
  op remove_out(s: Impl, t: U8) -> Upd
  op remove_img(s: Impl, t: U8) -> Impl
  op dispatch_out(s: Impl) -> Pick
  op dispatch_img(s: Impl) -> Impl
  op alpha_w(s: Impl) -> AbsW
  op cfg_n() -> CfgN

  model b2m(b: Bool, k: Nat) -> U8 = if b then shl(1u8, k) else 0u8
  model build(m: Ready) -> Impl = (
    Impl(bit_or(bit_or(bit_or(bit_or(bit_or(bit_or(bit_or(b2m(m.p0, 0), b2m(m.p1, 1)), b2m(m.p2, 2)), b2m(m.p3, 3)),
           b2m(m.p4, 4)), b2m(m.p5, 5)), b2m(m.p6, 6)), b2m(m.p7, 7)), 0u8))
  model inv_impl(s: Impl) -> Bool = true

  example n_is_eight:
    cfg_n() == CfgN(8u8)
  -- One worked step on a non-zero state.  An example over the zero state would be useless for
  -- a negative control: `field-zero` is inert on a field that is already zero (VOS02 13.4 F4).
  example insert_three_sets_bit_three:
    alpha_w(insert_img(init(), 3u8)) == AbsW(8u8)
  -- The full image, not just its abstraction: `alpha_w` drops `choice`, so
  -- only a direct pin catches `field-flip-last` on `insert_img` at example
  -- level (insert into the zero state sets bit 3, choice carried over).
  example insert_three_image_pins_choice:
    insert_img(init(), 3u8) == Impl(8u8, 0u8)
  -- The oracle at work: threads 6 and 3 ready (72 = 0b0100_1000); oracle 3 runs thread 3, not the top.
  example oracle_names_the_thread:
    dispatch_out(Impl(72u8, 3u8)) == Run(3u8)

  labels insert_out:
    s public
    t public
  labels insert_img:
    s public
    t public
  labels remove_out:
    s public
    t public
  labels remove_img:
    s public
    t public
  labels dispatch_out:
    s public
  labels dispatch_img:
    s public
  labels alpha_w:
    s public

  input insert_out.s:
    hostile
    ensures no_panic, terminates
  input insert_out.t:
    hostile
    ensures no_panic, terminates
  input insert_img.s:
    hostile
    ensures no_panic, terminates
  input insert_img.t:
    hostile
    ensures no_panic, terminates
  input remove_out.s:
    hostile
    ensures no_panic, terminates
  input remove_out.t:
    hostile
    ensures no_panic, terminates
  input remove_img.s:
    hostile
    ensures no_panic, terminates
  input remove_img.t:
    hostile
    ensures no_panic, terminates
  input dispatch_out.s:
    hostile
    ensures no_panic, terminates
  input dispatch_img.s:
    hostile
    ensures no_panic, terminates
  input alpha_w.s:
    hostile
    ensures no_panic, terminates

  -- Bounds.  `steps` rows are the contract ceilings (VOS10 section 7); `heap <= 0` is the contract's
  -- heap ceiling on every operation (the source has no allocator at all, SH1).  The harness's heap
  -- observer counts the export call only, not its own result marshalling (VOS-D063).
  bound init:
    steps <= 80
    heap <= 0
  bound insert_out:
    steps <= 160
    heap <= 0
  bound insert_img:
    steps <= 160
    heap <= 0
  bound remove_out:
    steps <= 160
    heap <= 0
  bound remove_img:
    steps <= 160
    heap <= 0
  bound dispatch_out:
    steps <= 160
    heap <= 0
  bound dispatch_img:
    steps <= 160
    heap <= 0
  bound alpha_w:
    steps <= 160
    heap <= 0
  -- vos02:impl-end
  -- vos02:obligations-begin tier=any sha256=1b6cdcd1670bbfb8656922fe0c7a662fac6ccd913c0aebfdd20b770624a63174
  -- The most-general scheduler (VOS01 section 3). Impl is Impl(mask: U8, choice: U8): a bitmap
  -- plus the oracle register that alpha drops. The oracle is a binder here, so these claims
  -- quantify over Impl directly and not over build(M) (VOS02 section 3.3).
  claim dispatch_sound:
    forall mask: U8, c: U8. (
      safe_dispatch(dec(alpha_w(Impl(mask, c))), dispatch_out(Impl(mask, c)), dec(alpha_w(dispatch_img(Impl(mask, c))))) and
      dispatch_img(Impl(mask, c)).choice == c)
  -- Coverage with a witness: thread t is produced by the oracle value t, Idle by 255. `mem` is false
  -- outside 0..7, so no `t < 8` refinement is needed; a refinement would also make the property
  -- suite unrunnable (the generator's rejection sampler gives up at 3 percent acceptance, VOS-D079).
  claim dispatch_covers_run:
    forall mask: U8, t: U8. (
      mem(dec(alpha_w(Impl(mask, t))), t) => dispatch_out(Impl(mask, t)) == Run(t))
  claim dispatch_covers_idle:
    forall mask: U8. dispatch_out(Impl(mask, 255u8)) == Idle
  -- VOS-039c: insert and remove KEEP THE ORACLE and are INDEPENDENT of it (VOS10 section 9.3).  The safety claims
  -- quantify over build(M), whose oracle is 0, and alpha drops the oracle, so a scheduler whose insert overwrote
  -- `choice`, or whose answer depended on it, passed every claim above.  Each claim below states, for one operation
  -- and every oracle c, three conjuncts: the image keeps the oracle (first, so the claim's subject is the `_img`
  -- operation and it gets a negative control of its own, VOS02 4.4); the image's abstraction is the abstract step
  -- taken from the abstraction of the state, whatever c is; and the answer is the abstract answer.  The thread id is
  -- split three ways to stay inside the 400,000-case budget: _lo is the ids 0..3 (two Bool binders, 256 x 256 x 4
  -- cases), _hi the ids 4..7, and _ids ranges every U8 id over four masks whose two Bool binders switch the bit
  -- patterns 0xA5 and 0x5A on or off (0x00, 0xA5, 0x5A, 0xFF: every bit is set in one mask and clear in another).
  -- Residual (VOS10 section 9.3): the ids 8..255 on the other 252 masks.  There is no `where` refinement, so the
  -- generator's rejection sampler is not involved (VOS-D079).
  claim insert_oracle_lo:
    forall mask: U8, c: U8, t0: Bool, t1: Bool. (
      insert_img(Impl(mask, c), ((if t0 then 1u8 else 0u8) + (if t1 then 2u8 else 0u8))).choice == c and
      dec(alpha_w(insert_img(Impl(mask, c), ((if t0 then 1u8 else 0u8) + (if t1 then 2u8 else 0u8))))) == abs_insert(dec(alpha_w(Impl(mask, c))), ((if t0 then 1u8 else 0u8) + (if t1 then 2u8 else 0u8))).1 and
      insert_out(Impl(mask, c), ((if t0 then 1u8 else 0u8) + (if t1 then 2u8 else 0u8))) == abs_insert(dec(alpha_w(Impl(mask, c))), ((if t0 then 1u8 else 0u8) + (if t1 then 2u8 else 0u8))).0)
  claim insert_oracle_hi:
    forall mask: U8, c: U8, t0: Bool, t1: Bool. (
      insert_img(Impl(mask, c), (((if t0 then 1u8 else 0u8) + (if t1 then 2u8 else 0u8)) + 4u8)).choice == c and
      dec(alpha_w(insert_img(Impl(mask, c), (((if t0 then 1u8 else 0u8) + (if t1 then 2u8 else 0u8)) + 4u8)))) == abs_insert(dec(alpha_w(Impl(mask, c))), (((if t0 then 1u8 else 0u8) + (if t1 then 2u8 else 0u8)) + 4u8)).1 and
      insert_out(Impl(mask, c), (((if t0 then 1u8 else 0u8) + (if t1 then 2u8 else 0u8)) + 4u8)) == abs_insert(dec(alpha_w(Impl(mask, c))), (((if t0 then 1u8 else 0u8) + (if t1 then 2u8 else 0u8)) + 4u8)).0)
  claim insert_oracle_ids:
    forall m0: Bool, m1: Bool, c: U8, t: U8. (
      insert_img(Impl(((if m0 then 165u8 else 0u8) + (if m1 then 90u8 else 0u8)), c), t).choice == c and
      dec(alpha_w(insert_img(Impl(((if m0 then 165u8 else 0u8) + (if m1 then 90u8 else 0u8)), c), t))) == abs_insert(dec(alpha_w(Impl(((if m0 then 165u8 else 0u8) + (if m1 then 90u8 else 0u8)), c))), t).1 and
      insert_out(Impl(((if m0 then 165u8 else 0u8) + (if m1 then 90u8 else 0u8)), c), t) == abs_insert(dec(alpha_w(Impl(((if m0 then 165u8 else 0u8) + (if m1 then 90u8 else 0u8)), c))), t).0)
  claim remove_oracle_lo:
    forall mask: U8, c: U8, t0: Bool, t1: Bool. (
      remove_img(Impl(mask, c), ((if t0 then 1u8 else 0u8) + (if t1 then 2u8 else 0u8))).choice == c and
      dec(alpha_w(remove_img(Impl(mask, c), ((if t0 then 1u8 else 0u8) + (if t1 then 2u8 else 0u8))))) == abs_remove(dec(alpha_w(Impl(mask, c))), ((if t0 then 1u8 else 0u8) + (if t1 then 2u8 else 0u8))).1 and
      remove_out(Impl(mask, c), ((if t0 then 1u8 else 0u8) + (if t1 then 2u8 else 0u8))) == abs_remove(dec(alpha_w(Impl(mask, c))), ((if t0 then 1u8 else 0u8) + (if t1 then 2u8 else 0u8))).0)
  claim remove_oracle_hi:
    forall mask: U8, c: U8, t0: Bool, t1: Bool. (
      remove_img(Impl(mask, c), (((if t0 then 1u8 else 0u8) + (if t1 then 2u8 else 0u8)) + 4u8)).choice == c and
      dec(alpha_w(remove_img(Impl(mask, c), (((if t0 then 1u8 else 0u8) + (if t1 then 2u8 else 0u8)) + 4u8)))) == abs_remove(dec(alpha_w(Impl(mask, c))), (((if t0 then 1u8 else 0u8) + (if t1 then 2u8 else 0u8)) + 4u8)).1 and
      remove_out(Impl(mask, c), (((if t0 then 1u8 else 0u8) + (if t1 then 2u8 else 0u8)) + 4u8)) == abs_remove(dec(alpha_w(Impl(mask, c))), (((if t0 then 1u8 else 0u8) + (if t1 then 2u8 else 0u8)) + 4u8)).0)
  claim remove_oracle_ids:
    forall m0: Bool, m1: Bool, c: U8, t: U8. (
      remove_img(Impl(((if m0 then 165u8 else 0u8) + (if m1 then 90u8 else 0u8)), c), t).choice == c and
      dec(alpha_w(remove_img(Impl(((if m0 then 165u8 else 0u8) + (if m1 then 90u8 else 0u8)), c), t))) == abs_remove(dec(alpha_w(Impl(((if m0 then 165u8 else 0u8) + (if m1 then 90u8 else 0u8)), c))), t).1 and
      remove_out(Impl(((if m0 then 165u8 else 0u8) + (if m1 then 90u8 else 0u8)), c), t) == abs_remove(dec(alpha_w(Impl(((if m0 then 165u8 else 0u8) + (if m1 then 90u8 else 0u8)), c))), t).0)
  -- build_with_oracle: the abstraction of an image is the ready set that built its mask, whatever the oracle.
  claim alpha_build_with_oracle:
    forall b0: Bool, b1: Bool, b2: Bool, b3: Bool, b4: Bool, b5: Bool, b6: Bool, b7: Bool, c: U8. dec(alpha_w(Impl(build(ready_of(b0, b1, b2, b3, b4, b5, b6, b7)).mask, c))) == ready_of(b0, b1, b2, b3, b4, b5, b6, b7)
  -- vos02:obligations-end
  -- vos02:obligations-begin tier=safety sha256=238c31381646b16001784c8533f8b2ed97e83256b48869d716816f01d435b16f
  -- insert and remove are deterministic in both tiers (shape A of VOS01 section 2.3).
  claim insert_safe:
    forall b0: Bool, b1: Bool, b2: Bool, b3: Bool, b4: Bool, b5: Bool, b6: Bool, b7: Bool, t: U8. (
      insert_out(build(ready_of(b0, b1, b2, b3, b4, b5, b6, b7)), t) == abs_insert(ready_of(b0, b1, b2, b3, b4, b5, b6, b7), t).0 and
      dec(alpha_w(insert_img(build(ready_of(b0, b1, b2, b3, b4, b5, b6, b7)), t))) == abs_insert(ready_of(b0, b1, b2, b3, b4, b5, b6, b7), t).1)
  claim remove_safe:
    forall b0: Bool, b1: Bool, b2: Bool, b3: Bool, b4: Bool, b5: Bool, b6: Bool, b7: Bool, t: U8. (
      remove_out(build(ready_of(b0, b1, b2, b3, b4, b5, b6, b7)), t) == abs_remove(ready_of(b0, b1, b2, b3, b4, b5, b6, b7), t).0 and
      dec(alpha_w(remove_img(build(ready_of(b0, b1, b2, b3, b4, b5, b6, b7)), t))) == abs_remove(ready_of(b0, b1, b2, b3, b4, b5, b6, b7), t).1)
  -- dispatch is a relation (shape B): any permitted choice, and the chosen thread leaves.
  claim dispatch_safe:
    forall b0: Bool, b1: Bool, b2: Bool, b3: Bool, b4: Bool, b5: Bool, b6: Bool, b7: Bool. (
      safe_dispatch(ready_of(b0, b1, b2, b3, b4, b5, b6, b7), dispatch_out(build(ready_of(b0, b1, b2, b3, b4, b5, b6, b7))), dec(alpha_w(dispatch_img(build(ready_of(b0, b1, b2, b3, b4, b5, b6, b7)))))))
  -- alpha is onto M (shape C of VOS01 section 2.3): build and alpha agree on every abstract state.
  -- It pins build, alpha and dec for EVERY implementation: a representation-mode scheduler and -any
  -- carry the safety tier but not canonical, and would otherwise have an alpha nothing constrains.
  claim safety_alpha_build:
    forall b0: Bool, b1: Bool, b2: Bool, b3: Bool, b4: Bool, b5: Bool, b6: Bool, b7: Bool. dec(alpha_w(build(ready_of(b0, b1, b2, b3, b4, b5, b6, b7)))) == ready_of(b0, b1, b2, b3, b4, b5, b6, b7)
  -- init starts from the empty ready set, for EVERY implementation (VOS-D081).  The binder is unused
  -- (the same convention as canon_init, F5): the generator needs one.
  claim safety_init:
    forall b: Bool. dec(alpha_w(init())) == empty()
  -- vos02:obligations-end
  assume platform:
    none
  assume environment:
    none
