              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Say you drink tea, to आप: आप चाय पीवो हो।."
            }
          ]
        },
        {
          "index": 1,
          "type": "grammar",
          "title": "Grammar Lens: the voice does it",
          "segments": [
            {
              "kind": "speech",
              "text": "Say the same sentence again and let your voice rise at the end. That is the whole question:"
            },
            {
              "kind": "speech",
              "text": "आप चाय पीवो हो? āp chāy pīvo ho? — Do you drink tea?"
            },
            {
              "kind": "speech",
              "text": "वो बीमार है? vo bīmār hai? — Is he ill?"
            },
            {
              "kind": "speech",
              "text": "Nothing moves and nothing is added. In print, only the end mark changes:? for ।."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
