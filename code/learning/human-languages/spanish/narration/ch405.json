    {
      "id": "ES-C405-foto",
      "sequence": 9070,
      "title": "la foto — the short word keeps the long word's gender",
      "headword": "la foto",
      "romanization": "la foto",
      "gloss": "photo — the everyday shortening of fotografía, still feminine",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:a4a93fd671e401dd",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Say the photograph and the passport. (La fotografía, el pasaporte.)"
            }
          ]
        },
        {
          "index": 1,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "la foto is the everyday short form of la fotografía. It ends in -o, but it remains feminine because the full word is feminine: la foto, never el foto for an ordinary photograph."
            },
            {
              "kind": "speech",
              "text": "The two forms overlap, but the short one is especially natural for a physical photo or an ID picture: una foto y el pasaporte."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
