          "segments": [
            {
              "kind": "speech",
              "text": "memorizzare is built on memoria \"memory\", a learned borrowing from Latin memoria (Lewis & Short), with the verb ending -izzare; the modern word was probably helped along by English memorize."
            }
          ]
