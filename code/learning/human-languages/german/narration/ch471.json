          "segments": [
            {
              "kind": "speech",
              "text": "Mitleid is built on mit \"with\" and Leid \"sorrow\"; EtymDB traces it to Middle High German mitelīden \"to suffer with\". It is usually seen as modelled on Church Latin compassio \"fellow-suffering\" (Lewis & Short)."
            }
          ]
        },
