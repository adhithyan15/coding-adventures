// EngramApp.mil - Engram's Mosaic app/root surface.
//
// Engram is an app, so it owns the product-level interface here. Reusable UI
// building blocks live in component packages and are referenced from the app
// layout instead of being named after the product.

component EngramApp {
  slot app-title : text ;
  slot deck-name : text ;
  slot deck-stats-label : text ;
  slot deck-total-label : text ;
  slot deck-total-value : text ;
  slot deck-new-label : text ;
