        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: نوازنده",
          "segments": [
            {
              "kind": "speech",
              "text": "نوازنده (navâzande) — \"a musician (who plays)\"."
            },
            {
              "kind": "speech",
              "text": "نوازنده جوان در کنسرت ویولن زد. navâzande-ye javân dar konsert viyolon zad. The young musician played the violin at the concert."
            },
            {
              "kind": "speech",
              "text": "navâz- (stem of navâkhtan) + -ande 'one who'. A singer is khânande."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "navâzande is built on native Persian navâz-, the present stem of navâkhtan, 'to play music', with the ending -ande, 'one who'. EtymDB has no entry for it."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
