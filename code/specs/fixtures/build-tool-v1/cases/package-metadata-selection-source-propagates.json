{
  "schema_version": 1,
  "id": "diff-selection/package-metadata-source-propagates",
  "domain": "diff_selection",
  "summary": "A source change propagates even beside metadata in the same package; another package's metadata-only change stays local.",
  "platforms": [
    "darwin",
    "linux",
    "windows"
  ],
  "capabilities": [
    "diff_selection"
  ],
  "workspace": {
    "files": []
  },
  "input": {
    "operation": "diff_selection",
    "options": {
      "packages": [
        {
          "name": "rust/pre",
          "rel_path": "code/packages/rust/pre",
          "source_mode": "package_prefix"
        },
        {
          "name": "rust/meta",
          "rel_path": "code/packages/rust/meta",
          "source_mode": "package_prefix"
        },
        {
          "name": "rust/dep",
          "rel_path": "code/packages/rust/dep",
          "source_mode": "package_prefix"
        },
        {
          "name": "rust/leaf",
          "rel_path": "code/packages/rust/leaf",
          "source_mode": "package_prefix"
        },
        {
          "name": "rust/leaf-user",
          "rel_path": "code/packages/rust/leaf-user",
          "source_mode": "package_prefix"
        }
      ],
      "edges": [
        [
          "rust/pre",
          "rust/meta"
        ],
        [
          "rust/meta",
          "rust/dep"
        ],
        [
          "rust/leaf",
          "rust/leaf-user"
        ]
      ],
      "forced_packages": [],
      "unknown_path_policy": "error",
      "metadata_policy": "package_local"
    },
    "changed_paths": [
      "code/packages/rust/meta/CHANGELOG.md",
      "code/packages/rust/meta/src/lib.rs",
      "code/packages/rust/leaf/CHANGELOG.d/_meta.md"
    ]
  },
  "expected": {
    "schema_version": 1,
    "case_id": "diff-selection/package-metadata-source-propagates",
    "domain": "diff_selection",
    "outcome": "ok",
    "result": {
      "changed_packages": [
        "rust/leaf",
        "rust/meta"
      ],
      "affected_packages": [
        "rust/dep",
        "rust/leaf",
        "rust/meta"
      ],
      "prerequisite_packages": [
        "rust/pre"
      ]
    },
    "diagnostics": []
  },
  "limits": {
    "wall_time_ms": 1000,
    "output_bytes": 1048576,
    "workspace_bytes": 1048576,
    "process_count": 1,
    "memory_mib": 128,
    "cpu_time_ms": 1000
  }
}
