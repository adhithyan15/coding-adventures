          "segments": [
            {
              "kind": "speech",
              "text": "شکست خوردن (shekast khordan) — \"to be defeated, to lose\"."
            },
            {
              "kind": "speech",
              "text": "تیم ما در مسابقه شکست خورد. tim-e mâ dar mosâbeqe shekast khord. Our team was defeated in the match."
            },
            {
              "kind": "speech",
              "text": "Shekast \"defeat\" + khordan \"to eat\" (stem khor-): literally to eat a defeat."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "شکست خوردن (shekast khordan) is native Persian, built from shekast, the past stem of shekastan \"to break\", which EtymDB traces to Middle Persian škastan and PIE skeyd-, and khordan \"to eat\", inherited too."
            }
          ]
        },
