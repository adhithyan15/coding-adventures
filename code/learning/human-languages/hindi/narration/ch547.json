              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *caukannā*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "Jaṅgal meṁ hiran hameśā caukannā rahtā hai. — In the forest a deer is always on the alert.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *Jaṅgal meṁ hiran hameśā caukannā rahtā hai.* — In the forest a deer is always on the alert.]"
