    {
      "id": "ZH-W347-si-think",
      "sequence": 27065,
      "title": "思 (sī) — a box with a cross, over the heart",
      "headword": "思",
      "romanization": "sī",
      "gloss": "思 — a box with a cross, over 心",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:28a47c1f3996376c",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — a box with a cross, over the heart",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — a box with a cross, over the heart and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say yìsi — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *yìsi* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "心 想 意."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — xīn, xiǎng, yì",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *xīn*, *xiǎng*, *yì*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — a box with a cross, over the heart",
          "segments": [
            {
              "kind": "speech",
              "text": "思 (sī)."
            },
            {
              "kind": "speech",
              "text": "Two pieces, top before bottom. Count the pieces, not the strokes."
            },
            {
              "kind": "speech",
              "text": "The top piece, a box with a cross inside, five strokes. A short vertical down the left side. A horizontal along the top that turns down the right side. A short horizontal across the middle. A vertical down the middle. Then the bottom horizontal that closes the box."
            },
            {
              "kind": "speech",
              "text": "The bottom piece, 心, four strokes, wider than the box: the left dot, the long curve along the foot that hooks up, the middle dot, the right dot."
            },
            {
              "kind": "speech",
              "text": "5 + 4 = nine, and the last four your hand already knows."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "思 (sī), all nine, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 思, all nine, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many pieces in 思 (sī)? (Two.) Which comes first, the box or the heart? (The box, on top.) How many strokes in the box? (Five.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 思 (sī), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
