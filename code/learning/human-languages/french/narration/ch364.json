          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "justice comes through Old French from Latin iūstitia \"fairness, justice\" (EtymDB), from iūstus \"right, fair\" (Lewis & Short)."
            }
          ]
        },
