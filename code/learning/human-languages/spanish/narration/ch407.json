    {
      "id": "ES-C407-lado",
      "sequence": 9210,
      "title": "el lado — the side",
      "headword": "el lado",
      "romanization": "el lado",
      "gloss": "side",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:4b962aed8210f7ab",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "A door has a left edge and a right edge. Each edge belongs to un lado, a side."
            }
          ]
        },
        {
          "index": 1,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Lado continues Latin latus, “side.” English lateral is the learned cousin: a lateral movement goes toward one side."
            }
          ]
        },
        {
          "index": 2,
          "type": "grammar",
          "title": "Grammar Lens: al lado de",
          "segments": [
            {
              "kind": "speech",
              "text": "The useful location frame is al lado de, beside or next to: al lado de la puerta. The al is a + el, literally “at the side of.”"
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "el lado",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *el lado*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "al lado",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *al lado*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "al lado de la puerta",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *al lado de la puerta*]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "The side? (El lado.) Beside the door? (Al lado de la puerta.)"
            },
            {
              "kind": "speech",
              "text": "Source: DLE: lado."
            }
          ]
        }
      ]
    },
