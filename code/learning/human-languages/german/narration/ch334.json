          "segments": [
            {
              "kind": "speech",
              "text": "einräumen — \"to concede; to put away (into a cupboard)\"."
            },
            {
              "kind": "speech",
              "text": "Der Trainer räumt ein, dass seine Mannschaft schlecht gespielt hat. The coach concedes that his team played badly."
            },
            {
              "kind": "speech",
              "text": "Separable: er räumt ein, er hat eingeräumt. Literally to give room to something: die Teller in den Schrank einräumen."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "einräumen is built on räumen \"to make room\", inherited from Old High German rūmen and Proto-Germanic rūmijaną (EtymDB), from Raum \"room\": you give the other side some room."
            }
          ]
        },
