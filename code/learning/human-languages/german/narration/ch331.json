          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "überreden is built from über \"over\" and reden \"to talk\", inherited from Middle High German reden and Old High German redōn \"to speak\" (EtymDB): you talk someone over to your side."
            }
          ]
        },
