        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: a bilheteira",
          "segments": [
            {
              "kind": "speech",
              "text": "a bilheteira — \"the ticket office, the box office\"."
            },
            {
              "kind": "speech",
              "text": "A bilheteira da estação abre às seis. The station ticket office opens at six."
            },
            {
              "kind": "speech",
              "text": "In Brazil: a bilheteria. Theatres and stadiums have one too."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "bilheteira is built on bilhete 'ticket' with -eira, a place; bilhete came from French billet 'note', from Old French billette (EtymDB)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
