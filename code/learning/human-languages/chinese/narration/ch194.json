    {
      "id": "ZH-W194-lu-road",
      "sequence": 15315,
      "title": "路 (lù) — the foot piece, then three strokes over 口",
      "headword": "路",
      "romanization": "lù",
      "gloss": "路 — the foot piece on the left, three strokes over 口 on the right",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:5c824fbe52a908ce",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — the foot piece, then three strokes over 口",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — the foot piece, then three strokes over 口 and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say mǎlù — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *mǎlù* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "马 口."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — mǎ, kǒu",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *mǎ*, *kǒu*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — the foot piece, then three strokes over 口",
          "segments": [
            {
              "kind": "speech",
              "text": "路 (lù)."
            },
            {
              "kind": "speech",
              "text": "Two halves, left before right, and each has 口 in it."
            },
            {
              "kind": "speech",
              "text": "The left half, the foot piece, seven strokes. 口 at the top, narrow. Under it a short vertical, a short bar from its middle to the right, a short vertical on the left, and a stroke along the foot that rises to the right."
            },
            {
              "kind": "speech",
              "text": "The right half, six strokes. A short stroke falling to the left. A bar that turns and falls down to the left. A long stroke falling down to the right. Then 口 underneath."
            },
            {
              "kind": "speech",
              "text": "7 + 6 = thirteen."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "路 (lù), all thirteen, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 路, all thirteen, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many strokes in 路 (lù)? (Thirteen.) Where is 口 in the left half? (At the top.) And in the right half? (At the bottom.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 路 (lù), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
