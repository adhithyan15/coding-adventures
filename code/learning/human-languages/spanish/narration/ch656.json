          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "aduanero is built on aduana \"customs\", which comes from Andalusian Arabic ad-dīwān \"the office\", Arabic dīwān (EtymDB)."
            }
          ]
        },
