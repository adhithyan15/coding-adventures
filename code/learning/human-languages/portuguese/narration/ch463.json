        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: a trovoada",
          "segments": [
            {
              "kind": "speech",
              "text": "a trovoada — \"the thunderstorm\"."
            },
            {
              "kind": "speech",
              "text": "Ontem à noite houve uma trovoada forte. Last night there was a heavy thunderstorm."
            },
            {
              "kind": "speech",
              "text": "Built on o trovão."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "trovoada is built on trovão 'thunder'. Trovão is usually traced to Latin tonitrus 'thunder' (Lewis & Short), with its sounds rearranged, but the details are not settled; EtymDB lists Galician trebón as a cousin."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
