{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/adhithyan15/coding-adventures/main/code/specs/schemas/capability-approval.schema.json",
  "title": "Capability Escalation Approval",
  "description": "The canonical signed payload for a security-relevant required_capabilities.json change. Its detached SSHSIG uses the coding-adventures-capabilities namespace.",
  "type": "object",
  "required": [
    "version",
    "type",
    "manifest_path",
    "package",
    "base_ref",
    "base_commit",
    "package_tree",
    "previous_profile_status",
    "new_profile_status",
    "previous_manifest_sha256",
    "new_manifest_sha256",
    "previous_capabilities",
    "new_capabilities",
    "previous_banned_construct_exceptions",
    "new_banned_construct_exceptions",
    "reason",
    "approved_by",
    "approved_at"
  ],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "type": { "type": "string", "const": "capability_escalation" },
    "manifest_path": {
      "type": "string",
      "pattern": "^code/(packages|programs)/[a-z0-9_-]+/[a-z0-9][a-z0-9._-]*/required_capabilities\\.json$",
      "description": "Repository-relative path to the package's capability manifest. The corresponding approval and signature are stored outside this package tree."
    },
    "package": {
      "type": "string",
      "pattern": "^(c|cpp|csharp|dart|elixir|fsharp|go|haskell|java|kotlin|lua|ocaml|perl|python|ruby|rust|starlark|swift|typescript|wasm)/[a-z0-9][a-z0-9_-]*$"
    },
    "base_ref": {
      "type": "string",
      "minLength": 1,
      "description": "The exact pull-request base ref. The verifier obtains trust and the prior manifest from base_commit."
    },
    "base_commit": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "package_tree": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" }
      ],
      "description": "Git tree object ID of the candidate package directory. Null only if the whole package directory is deleted. Approval files are outside this tree."
    },
    "previous_profile_status": {
      "type": "string",
      "enum": ["absent", "valid", "invalid"]
    },
    "new_profile_status": {
      "type": "string",
      "enum": ["valid", "absent"]
    },
    "previous_manifest_sha256": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      ]
    },
    "new_manifest_sha256": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      ]
    },
    "previous_capabilities": {
      "anyOf": [
        {
          "type": "array",
          "items": { "$ref": "required_capabilities.schema.json#/$defs/capability" }
        },
        { "type": "null" }
      ]
    },
    "new_capabilities": {
      "type": "array",
      "items": { "$ref": "required_capabilities.schema.json#/$defs/capability" }
    },
    "previous_banned_construct_exceptions": {
      "anyOf": [
        {
          "type": "array",
          "items": { "$ref": "required_capabilities.schema.json#/$defs/banned_construct_exception" }
        },
        { "type": "null" }
      ]
    },
    "new_banned_construct_exceptions": {
      "type": "array",
      "items": { "$ref": "required_capabilities.schema.json#/$defs/banned_construct_exception" }
    },
    "reason": { "type": "string", "minLength": 10 },
    "approved_by": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S+$",
      "description": "Must equal the principal that verifies the detached SSH signature."
    },
    "approved_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "previous_profile_status": { "const": "absent" } } },
      "then": {
        "properties": {
          "previous_manifest_sha256": { "type": "null" },
          "previous_capabilities": { "type": "array", "maxItems": 0 },
          "previous_banned_construct_exceptions": { "type": "array", "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "previous_profile_status": { "const": "valid" } } },
      "then": {
        "properties": {
          "previous_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "previous_capabilities": { "type": "array" },
          "previous_banned_construct_exceptions": { "type": "array" }
        }
      }
    },
    {
      "if": { "properties": { "previous_profile_status": { "const": "invalid" } } },
      "then": {
        "properties": {
          "previous_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "previous_capabilities": { "type": "null" },
          "previous_banned_construct_exceptions": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "new_profile_status": { "const": "absent" } },
        "required": ["new_profile_status"]
      },
      "then": {
        "properties": {
          "new_manifest_sha256": { "type": "null" },
          "package_tree": { "anyOf": [{ "type": "null" }, { "type": "string" }] },
          "new_capabilities": { "type": "array", "maxItems": 0 },
          "new_banned_construct_exceptions": { "type": "array", "maxItems": 0 }
        }
      }
    },
    {
      "if": {
        "properties": { "new_profile_status": { "const": "valid" } },
        "required": ["new_profile_status"]
      },
      "then": {
        "properties": {
          "new_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "package_tree": { "type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" }
        }
      }
    }
  ]
}
