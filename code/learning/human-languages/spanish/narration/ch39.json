                "vivimos",
                "nosotros vivimos"
              ],
              "feedback": {
                "correct": "Right — -imos, not -emos.",
                "incorrect": "vivimos, with an i."
              }
            },
            {
              "kind": "activity",
              "scored": true,
              "id": "ES-C07-vivimos-contrast",
              "prompt": "What is the only difference between comemos and vivimos?",
              "assesses": [
                "ES-GRAMMAR-ER-PRESENT-1PL",
                "ES-GRAMMAR-IR-PRESENT-1PL"
              ],
              "responseSeconds": 10,
              "acceptedResponses": [
                "one vowel",
                "the vowel",
                "e versus i",
                "one letter"
              ],
              "feedback": {
                "correct": "Yes — each family's own vowel, finally audible.",
                "incorrect": "One vowel: the e of comer, the i of vivir."
              }
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What is \"we live\"? (Vivimos.) Why was the difference invisible in the singular? (The ending was unstressed, so the vowels wore together.) And what makes it audible here? (The stress falls on the ending.)"
            }
          ]
        }
      ]
    }
