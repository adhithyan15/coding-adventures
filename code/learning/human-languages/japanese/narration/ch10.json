          "segments": [
            {
              "kind": "speech",
              "text": "ね — ne."
            },
            {
              "kind": "speech",
              "text": "Two strokes. First a short vertical. Second, cross it from the upper right, hook left, sweep down, and finish with a small loop at the lower right."
            }
          ]
        },
