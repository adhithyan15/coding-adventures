              "instruction": "el bebé y la niña",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *el bebé y la niña*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "el nombre del bebé, por favor",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *el nombre del bebé, por favor*]"
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Where did bebé come from? (French, and before that nowhere --- it is babble.) What does the accent do? (Pulls the stress to the last syllable.) Is bebé masculine for a girl too? (Yes --- the word has a gender, the child need not match.)"
            }
          ]
        }
