        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: la veille",
          "segments": [
            {
              "kind": "speech",
              "text": "la veille — \"the day before, the eve\"."
            },
            {
              "kind": "speech",
              "text": "La veille de son examen, elle n'a pas dormi. The day before her exam, she did not sleep."
            },
            {
              "kind": "speech",
              "text": "La veille au soir — the evening before. The verb veiller means to stay up."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "veille is inherited from Latin vigilia \"wakefulness, a night watch\" (EtymDB), built on vigil \"awake\": the night of waiting before a feast."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
