            },
            {
              "kind": "speech",
              "text": "Say the words for to obtain and to save."
            }
          ]
        },
        {
          "index": 1,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": true,
              "source": "[PAUSE 2s each]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "stale, raw, calm, lazy, hard-working",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: stale, raw, calm, lazy, hard-working]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "honest, brave, timid, foolish, famous",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: honest, brave, timid, foolish, famous]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "safe, dangerous, false, purple, orange",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: safe, dangerous, false, purple, orange]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "grey, golden, to climb, to get down, to arrive",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: grey, golden, to climb, to get down, to arrive]"
            }
          ]
        },
        {
          "index": 2,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Stale? (शिळा, śiḷā.) Raw? (कच्चा, kaccā.) Calm? (शांत, śānt.) Lazy? (आळशी, āḷśī.) Hard-working? (मेहनती, mehantī.) Honest? (प्रामाणिक, prāmāṇik.) Brave? (धाडसी, dhāḍsī.) Timid? (भित्रा, bhitrā.) Foolish? (मूर्ख, mūrkh.) Famous? (प्रसिद्ध, prasiddh.) Safe? (सुरक्षित, surakṣit.) Dangerous? (धोकादायक, dhokādāyak.) False? (खोटे, khoṭe.) Purple? (जांभळा, jāmbhaḷā.) Orange? (नारिंगी, nāriṅgī.) Grey? (करडा, karḍā.) Golden? (सोनेरी, sonerī.) To climb? (चढणे, caḍhṇe.) To get down? (उतरणे, utarṇe.) To arrive? (पोहोचणे, pohocṇe.)"
            }
          ]
        }
      ]
    },
