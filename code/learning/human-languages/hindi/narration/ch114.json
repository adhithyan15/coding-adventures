          "segments": [
            {
              "kind": "speech",
              "text": "बधाई (badhāī) — \"congratulations\"."
            },
            {
              "kind": "speech",
              "text": "बधाई (badhāī) हो! — \"congratulations!\", for an exam passed, a new job, a birth."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "बधाई (badhāī) is a tadbhava, a word inherited from Sanskrit and reshaped by sound change. It comes from vardhāpayati, \"increases, gladdens, congratulates\" (CDIAL 11383). CDIAL glosses the Hindi word \"congratulations on the birth of a child\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "Praise for good news."
            }
          ]
        },
