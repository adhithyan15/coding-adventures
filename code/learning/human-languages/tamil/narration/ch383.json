        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: சாத்தியம்",
          "segments": [
            {
              "kind": "speech",
              "text": "சாத்தியம் — cāttiyam — \"a possibility; possible\"."
            },
            {
              "kind": "speech",
              "text": "இந்த வேலையை ஒரே நாளில் முடிப்பது சாத்தியம் இல்லை. inta vēlaiyai orē nāḷil muṭippatu cāttiyam illai. It is not possible to finish this work in one day."
            },
            {
              "kind": "speech",
              "text": "சாத்தியமான, possible; சாத்தியமில்லை, it is not possible."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "சாத்தியம் (cāttiyam) is borrowed from Sanskrit sādhya, \"to be accomplished; practicable, feasible, attainable\" (Monier-Williams)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for saying what happens if."
            }
          ]
        },
