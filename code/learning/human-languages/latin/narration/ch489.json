        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: laetitia, laetitiae",
          "segments": [
            {
              "kind": "speech",
              "text": "laetitia, laetitiae — \"joy, gladness\"."
            },
            {
              "kind": "speech",
              "text": "Post victōriam magna laetitia in urbe erat. After the victory there was great joy in the city."
            },
            {
              "kind": "speech",
              "text": "Feminine, first declension. Laetitia is lively joy that shows; gaudium is joy felt inside."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "laetitia is built on the adjective laetus \"glad, happy\" with the noun ending -itia (Lewis & Short; EtymDB derives it from laetus)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
