          "segments": [
            {
              "kind": "speech",
              "text": "ärgern — \"to annoy; to be annoyed (sich ärgern)\"."
            },
            {
              "kind": "speech",
              "text": "Ich ärgere mich über den Lärm der Nachbarn. I'm annoyed about the neighbours' noise."
            },
            {
              "kind": "speech",
              "text": "Sich ärgern über + accusative — to be annoyed about. Without sich: Du ärgerst mich! — You're annoying me!"
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ärgern is inherited from Old High German argerōn \"to make worse\" (EtymDB), built on arg \"bad\", from Proto-Germanic argaz."
            }
          ]
        },
