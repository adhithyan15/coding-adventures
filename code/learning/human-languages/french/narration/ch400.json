            },
            {
              "kind": "speech",
              "text": "Après l'échangeur, nous avons pris l'autoroute du sud. After the interchange we took the southbound motorway."
            },
            {
              "kind": "speech",
              "text": "A masculine noun: un échangeur."
            }
          ]
        },
