          "segments": [
            {
              "kind": "speech",
              "text": "با توجه به (bâ tavajjoh be) is literally \"with attention to\": bâ and be are Persian, and tavajjoh \"attention\" is usually traced to Arabic tawajjuh \"turning towards\"."
            }
          ]
        },
