          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "náuseas is a learned borrowing from Latin nausea, from Greek nausía \"seasickness\" (EtymDB), built on naûs \"ship\"."
            }
          ]
        },
