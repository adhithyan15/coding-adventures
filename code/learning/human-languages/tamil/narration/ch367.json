        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ஞானம்",
          "segments": [
            {
              "kind": "speech",
              "text": "ஞானம் — ñāṉam — \"wisdom\"."
            },
            {
              "kind": "speech",
              "text": "அனுபவத்தால் ஞானம் வருகிறது. aṉupavattāl ñāṉam varukiṟatu. Wisdom comes with experience."
            },
            {
              "kind": "speech",
              "text": "A deeper word than அறிவு, knowledge; ஞானி, a sage."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ஞானம் (ñāṉam) is borrowed from Sanskrit jñāna, \"knowledge\" (CDIAL 5281). Tamil writes the cluster jñ with one letter, ஞ, as Pali does with ñāṇa."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for giving reasons and opinions."
