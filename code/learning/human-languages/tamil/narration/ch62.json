        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: உடனே",
          "segments": [
            {
              "kind": "speech",
              "text": "உடனே (uṭaṉē) — \"at once\"."
            },
            {
              "kind": "speech",
              "text": "Tighter than சீக்கிரம் (sīkkiram): not soon but now, with nothing allowed in between. It is the word that answers an instruction you intend to obey."
            },
            {
              "kind": "speech",
              "text": "Say it ending long, on the ே. That final length is doing the work — it is what makes the word press rather than merely inform."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "Four, and the fourth pushes harder than the third."
            }
          ]
        },
