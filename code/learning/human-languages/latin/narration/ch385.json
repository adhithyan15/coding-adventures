          "segments": [
            {
              "kind": "speech",
              "text": "gubernō, gubernāre — \"to steer; to govern\"."
            },
            {
              "kind": "speech",
              "text": "Nauta nāvem gubernat. The sailor steers the ship."
            },
            {
              "kind": "speech",
              "text": "gubernō, gubernāre, gubernāvī, gubernātum. Gubernātor, a helmsman, is already known. English govern comes from it through French."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "gubernō was borrowed from Greek kybernaō \"to steer a ship\" (EtymDB; Lewis & Short). English govern comes from it through French."
            }
          ]
        },
