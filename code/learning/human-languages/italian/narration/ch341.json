        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: il disaccordo",
          "segments": [
            {
              "kind": "speech",
              "text": "il disaccordo — \"the disagreement\"."
            },
            {
              "kind": "speech",
              "text": "Siamo in disaccordo su quasi tutto. We disagree about almost everything."
            },
            {
              "kind": "speech",
              "text": "Essere in disaccordo — to disagree. The opposite is essere d'accordo."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "disaccordo is built from dis- and accordo \"agreement\", which comes from accordare, a verb usually traced to Vulgar Latin accordāre, built on Latin cor, cordis \"heart\" (EtymDB): hearts that do not beat together."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
