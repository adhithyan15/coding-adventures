        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: la dispute",
          "segments": [
            {
              "kind": "speech",
              "text": "la dispute — \"quarrel, argument\"."
            },
            {
              "kind": "speech",
              "text": "Ils ont eu une dispute à propos de l'argent. They had an argument about money."
            },
            {
              "kind": "speech",
              "text": "A real row, not a debate."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "la dispute is built on the verb disputer, from Latin disputāre \"to discuss, to argue\" (EtymDB), built from dis- \"apart\" and putāre \"to reckon\" (Lewis & Short)."
            }
          ]
        },
        {
