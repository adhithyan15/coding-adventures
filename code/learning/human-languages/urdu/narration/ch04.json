      "headword": "کیسے / کیسی",
      "romanization": "kaise / kaisī",
      "gloss": "how — addressing a man / addressing a woman",
      "script": "urdu-nastaliq",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:23c862a272e3546c",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Say kyā “what.” Urdu's next question word begins with the same k family, but its ending changes with the person being addressed."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "The two words",
          "segments": [
            {
              "kind": "table",
              "headers": [
                "Urdu",
                "read",
                "use in the respectful question"
              ],
              "columns": 3,
              "rowCount": 2,
              "utterances": [
                "Urdu: کیسے. read: kaise. use in the respectful question: addressing a man.",
                "Urdu: کیسی. read: kaisī. use in the respectful question: addressing a woman."
              ]
            },
            {
              "kind": "speech",
              "text": "Both begin ک k + ی carrying the ai sound. At the left edge, کیسے ends in broad ے e, while کیسی ends in ی long ī. Read the whole word before isolating the final shape."
            }
          ]
        },
        {
          "index": 2,
          "type": "grammar",
          "title": "Grammar Lens: one agreement contrast",
          "segments": [
            {
              "kind": "speech",
              "text": "English keeps how unchanged. Urdu makes this describing form agree with the person addressed: kaise for a man, kaisī for a woman. Learn only this pair today—not a table of adjective endings. Respectful āp itself remains the same for everyone."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "addressing a man — kaise",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: addressing a man — **kaise**]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "addressing a woman — kaisī",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: addressing a woman — **kaisī**]"
            },
            {
              "kind": "prompt",
              "action": "POINT",
              "instruction": "broad final ے versus long-ī ی",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU POINT: broad final **ے** versus long-*ī* **ی**]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "speech",
              "text": "Which form addresses a man? (Kaise.) A woman? (Kaisī.)"
            },
            {
              "kind": "speech",
              "text": "Source: Basic Urdu: Formal Conversation."
            },
            {
              "kind": "activity",
              "scored": true,
              "id": "UR-C04-kaise-kaisi-woman",
              "prompt": "Type the Urdu 'how' form used when respectfully addressing a woman.",
              "assesses": [
                "UR-GRAMMAR-HOW-GENDER"
