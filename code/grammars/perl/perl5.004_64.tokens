# Perl 5.004_64 (1998-04-03) plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: unsupported Perl 5.004_64 syntax is rejected by this grammar.
# Evidence: https://mirrors.develooper.com/perl/historical-perl/perl-5.004_64.tar.gz
# Archive SHA-256: aae74c445d5035a9af3e6146ca16e07220e50c89c8569b83e4c7ad3080a78df5
# Compared with 5.004_63, perly.y and keywords.h are byte-identical.
# toke.c only changes qualified-name error text before scan_num.
# Retain the source-backed 250-digit bound for the bounded print subset.
# CR remains outside this partial accepted subset, without platform-wide parity claim.
# Unsupported characters and leading-zero forms remain refused.

PRINT     = "print"
INT       = /0|[1-9][0-9]{0,249}/
PLUS      = "+"
DECREMENT = "--"
MINUS     = "-"
STAR      = "*"
LPAREN    = "("
RPAREN    = ")"
SEMICOLON = ";"

skip:
  WHITESPACE = /[ \t\n]+/
