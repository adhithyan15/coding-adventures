// Checkbox.light.msl — default light-theme styling.

style Checkbox {
  part checkbox {
    padding : 4 ;
  }
  part checkbox-box-checked {
    width         : 18 ;
    height        : 18 ;
    border-radius : 3 ;
    background    : "#0d6efd" ;
    color         : "#ffffff" ;
    border-width  : 1 ;
    border-color  : "#0d6efd" ;
    font-size     : 14 ;
    padding       : 0 ;
  }
  part checkbox-box-unchecked {
    width         : 18 ;
    height        : 18 ;
    border-radius : 3 ;
    background    : "#ffffff" ;
    border-width  : 1 ;
    border-color  : "#ced4da" ;
    padding       : 0 ;
  }
  part checkbox-label {
    padding : 4 ;
  }
}
