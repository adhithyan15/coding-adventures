            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Sanskrit for a bull, then the Sanskrit for a buffalo."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: मेषः",
          "segments": [
            {
              "kind": "speech",
              "text": "मेषः — meṣaḥ — \"a sheep\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "meṣa \"a ram, a sheep\" is inherited from Indo-European (EtymDB): Avestan maēša and Persian mīš \"ewe\" are cousins. In astronomy it names Aries, the first sign of the zodiac (MW). Hindi kept it as mes \"ram\" (CDIAL 10334)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for this chapter."
            }
          ]
        },
