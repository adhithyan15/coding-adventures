      "headword": "ആറാം",
      "romanization": "āṟāṁ",
      "gloss": "sixth — six to ten were a separate lesson for counting, and are not one for ordering",
      "script": "malayalam",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
