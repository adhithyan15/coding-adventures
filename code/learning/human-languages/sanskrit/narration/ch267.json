            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "पाठः; परीक्षा — pāṭhaḥ; parīkṣā — lesson; exam",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: **पाठः; परीक्षा** — *pāṭhaḥ; parīkṣā* — lesson; exam]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "समयसारणी; कक्षा — samayasāraṇī; kakṣā — timetable; classroom",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: **समयसारणी; कक्षा** — *samayasāraṇī; kakṣā* — timetable; classroom]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "अंकः — aṅkaḥ — a mark or number",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: **अंकः** — *aṅkaḥ* — a mark or number]"
