        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: arrestare",
          "segments": [
            {
              "kind": "speech",
              "text": "arrestare — \"to arrest\"."
            },
            {
              "kind": "speech",
              "text": "Hanno arrestato due persone. They arrested two people."
            },
            {
              "kind": "speech",
              "text": "In formal Italian also ‘to stop’: arrestare la corsa."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "arrestare is usually traced to Vulgar Latin arrestāre \"to make stop\", built on Latin restāre \"to stay behind\" (Lewis & Short)."
            }
          ]
        },
