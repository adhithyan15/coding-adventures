            {
              "kind": "speech",
              "text": "Before the new one: say the Italian for the street plan, then the Italian for the compass."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: il navigatore",
          "segments": [
            {
              "kind": "speech",
              "text": "il navigatore — \"the satnav; the navigator\"."
            },
            {
              "kind": "speech",
              "text": "Il navigatore dice di girare a sinistra. The satnav says to turn left."
            },
            {
              "kind": "speech",
              "text": "In full il navigatore satellitare; also a seafarer."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "navigatore is a learned borrowing from Latin nāvigātor 'sailor', from nāvigāre 'to sail', built on nāvis 'ship' (Lewis & Short)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
            }
          ]
