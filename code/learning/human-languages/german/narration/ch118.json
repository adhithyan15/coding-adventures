          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Kerze from Middle High German kerze from Old High German kerza (EtymDB 2.1). Its origin is uncertain; one account derives it from Latin charta, \"papyrus\", used as a wick."
            }
          ]
        },
