          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "empresario is built on empresa, which was borrowed from Italian impresa 'undertaking', built on Latin prehendere 'to take hold of' (EtymDB)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
