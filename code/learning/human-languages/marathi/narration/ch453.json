          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Marathi for to panic, then the Marathi for to be stunned."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: तापट",
          "segments": [
            {
              "kind": "speech",
              "text": "तापट — tāpaṭ — \"hot-tempered\"."
            },
            {
              "kind": "speech",
              "text": "आमचे मामा थोडे तापट आहेत. āmce māmā thoḍe tāpaṭ āhet. Our uncle is a bit hot-tempered."
            },
            {
              "kind": "speech",
              "text": "Unchanging. Built on ताप, heat or fever: a temper that heats up fast. Close to रागीट."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "तापट (tāpaṭ) is a Marathi derivation of ताप, \"heat, fever\", which goes back to Sanskrit tāpa, \"heat, glow\" (CDIAL 5767), with the ending -aṭ."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for describing what you lived and felt."
            }
          ]
        },
        {
          "index": 4,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
