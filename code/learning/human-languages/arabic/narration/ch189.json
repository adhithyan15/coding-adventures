            {
              "kind": "speech",
              "text": "Before the new one: say the Arabic for a customer, then the Arabic for a cashier; a money changer."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: محاسب",
          "segments": [
            {
              "kind": "speech",
              "text": "محاسب — muḥāsib — \"an accountant\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "محاسب (muḥāsib) is built on the native Arabic root ḥ-s-b, \"to count, to reckon\" (Lane). Muḥāsib is the Form III participle, \"one who settles accounts\"."
            }
          ]
        },
