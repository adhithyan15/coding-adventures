  "lessons": [
    {
      "id": "ML-C94-innu",
      "sequence": 3330,
      "title": "ഇന്ന് (innŭ) — today",
      "headword": "ഇന്ന്",
      "romanization": "innŭ",
      "gloss": "today — the day you are standing in, and the first of three words that place an event without a calendar",
      "script": "malayalam",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:2eb1e24d51defa0e",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Say day. You have had the word for a day since early on. You have never had a word for this one."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know",
          "segments": [
            {
              "kind": "speech",
              "text": "ഇന്ന് — innŭ — today."
            },
            {
              "kind": "speech",
              "text": "ഇന്ന് ഞാൻ പോകുന്നു. — innŭ ñān pōkunnu — \"Today I go.\""
            },
            {
              "kind": "speech",
              "text": "The word goes in front, before the person and the verb. That is where a time word sits in this language, and you have been putting things there since you learned to say now."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "This is smaller than it looks and it opens more than it looks."
            },
            {
              "kind": "speech",
              "text": "Every sentence you have made so far has floated free of any particular day. You could say that you go, that you went, that you will go — and nothing in the sentence said when. A listener had to guess from the room."
            },
            {
              "kind": "speech",
              "text": "One word ends that. The verb was already carrying the tense; ഇന്ന് (innŭ) gives it a day to sit on."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "innŭ",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *innŭ*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "innŭ ñān pōkunnu",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *innŭ ñān pōkunnu*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "where in the sentence the time word stands",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: where in the sentence the time word stands]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What is today? (ഇന്ന് (innŭ).) Where does it go in the sentence? (In front.)"
            }
          ]
        }
      ]
    },
    {
      "id": "ML-C94-innale",
      "sequence": 3340,
      "title": "ഇന്നലെ (innale) — yesterday",
      "headword": "ഇന്നലെ",
      "romanization": "innale",
      "gloss": "yesterday — the day behind you, built visibly on the word for today",
      "script": "malayalam",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:27639ed1a408c87c",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Say today. Then say I went — the past of the verb you have used most."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know",
          "segments": [
            {
              "kind": "speech",
              "text": "ഇന്നലെ — innale — yesterday."
            },
            {
              "kind": "speech",
              "text": "ഇന്നലെ ഞാൻ പോയി. — innale ñān pōyi — \"Yesterday I went.\""
            },
            {
              "kind": "speech",
              "text": "Put the two words side by side and read the fronts:"
            },
            {
              "kind": "table",
              "headers": [
                "",
                ""
              ],
              "columns": 2,
              "rowCount": 2,
              "utterances": [
                "ഇന്ന് innŭ, today.",
                "ഇന്നലെ innale, yesterday."
              ]
            },
            {
              "kind": "speech",
              "text": "They begin the same way. Yesterday is today with something added on the end — which is the direction this language has been growing words in all along, and here it is doing it to a day."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "You do not have to take it apart to use it, and you should not force a story onto the tail. What is worth seeing is the shared front, because it is what will make the pair easy to keep apart from tomorrow, which begins somewhere else entirely."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "innŭ, then innale",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *innŭ*, then *innale*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "innale ñān pōyi",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *innale ñān pōyi*]"
            },
            {
              "kind": "prompt",
              "action": "LOOK",
              "instruction": "at the two words and find where they stop matching",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU LOOK: at the two words and find where they stop matching]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What is yesterday? (ഇന്നലെ (innale).) What does it share with today? (Its opening.)"
            }
          ]
        }
      ]
    },
    {
      "id": "ML-C94-three-days",
      "sequence": 3350,
      "title": "നാളെ ഞാൻ പോകും (nāḷe ñān pōkuṁ) — tomorrow I will go",
      "headword": "നാളെ ഞാൻ പോകും",
      "romanization": "nāḷe ñān pōkuṁ",
      "gloss": "tomorrow I will go — the third day word walks out of the goodbye it has been locked inside since your first week",
      "script": "malayalam",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:80c14c8660d00d8d",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Say today and yesterday. Then say the goodbye you learned in your first week — the one that promises to see somebody again."
            }
          ]
        },
        {
          "index": 1,
          "type": "grammar",
          "title": "Grammar Lens: a word walks out of a phrase",
          "segments": [
            {
              "kind": "speech",
              "text": "You have owned നാളെ since that goodbye. നാളെ കാണാം — see you tomorrow. Until now it has lived only there, glued to the seeing."
            },
            {
              "kind": "speech",
              "text": "Take it out and stand it in front of a sentence of your own:"
            },
            {
              "kind": "speech",
              "text": "നാളെ ഞാൻ പോകും. — nāḷe ñān pōkuṁ — \"Tomorrow I will go.\""
            },
            {
              "kind": "speech",
              "text": "Nothing had to be learned to do that. The word was in your mouth, the position was the one you gave today two lessons ago, and the verb was already yours. A fixed phrase was holding a word that could stand on its own."
            }
          ]
        },
        {
          "index": 2,
          "type": "grammar",
          "title": "Grammar Lens: three days, three endings, one shape",
          "segments": [
            {
              "kind": "speech",
              "text": "Now put the three together and watch what moves:"
            },
            {
              "kind": "table",
              "headers": [
                "",
                "",
                ""
              ],
              "columns": 3,
              "rowCount": 3,
              "utterances": [
                "ഇന്നലെ ഞാൻ പോയി, innale ñān pōyi, yesterday I went.",
                "ഇന്ന് ഞാൻ പോകുന്നു, innŭ ñān pōkunnu, today I go.",
                "നാളെ ഞാൻ പോകും, nāḷe ñān pōkuṁ, tomorrow I will go."
              ]
            },
            {
              "kind": "speech",
              "text": "The middle of every line is identical. Only two things change, and they change together: the day word at the front, and the ending on the verb at the back."
            },
            {
              "kind": "speech",
              "text": "The day word does not make the tense — the verb was doing that before you had any of these words. What the day word does is say which day, and the two agreeing is what a listener hears as an ordinary sentence."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "innale ñān pōyi",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *innale ñān pōyi*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "innŭ ñān pōkunnu",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *innŭ ñān pōkunnu*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "nāḷe ñān pōkuṁ",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *nāḷe ñān pōkuṁ*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "the three lines again, and name what is the same in all of them",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: the three lines again, and name what is the same in all of them]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "where you first met the word for tomorrow",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: where you first met the word for tomorrow]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Which phrase had been holding tomorrow? (നാളെ കാണാം.) What changes between the three lines? (The day word and the verb ending.) What carries the tense? (The verb.)"
            }
          ]
        }
      ]
    },
    {
      "id": "ML-R94-day-recall",
      "sequence": 3360,
      "title": "(yesterday, today, tomorrow) (mūnnŭ divasaṁ enna ōrmma) — from cold",
      "headword": "(yesterday, today, tomorrow)",
      "romanization": "mūnnŭ divasaṁ enna ōrmma",
      "gloss": "cold retrieval of the three day words and the three verb endings they travel with",
      "script": "malayalam",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:8b2a91fb9449c154",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Close the lessons before this one. Name the day you are standing in, and the one behind it."
            }
          ]
        },
        {
          "index": 1,
          "type": "grammar",
          "title": "Grammar Lens: the three lines",
          "segments": [
            {
              "kind": "table",
              "headers": [
                "",
                ""
              ],
              "columns": 2,
              "rowCount": 3,
              "utterances": [
                "ഇന്നലെ (innale) ഞാൻ പോയി, yesterday I went.",
                "ഇന്ന് (innŭ) ഞാൻ പോകുന്നു, today I go.",
                "നാളെ ഞാൻ പോകും (nāḷe ñān pōkuṁ), tomorrow I will go."
              ]
            },
            {
              "kind": "speech",
              "text": "Read straight down the middle: ഞാൻ three times, unmoved. The front and the back of each line change together, and everything between them holds still."
            },
            {
              "kind": "speech",
              "text": "The verb carries the tense. The day word says which day. Neither is doing the other's work."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "Two of these words were new. The third was already yours and you could not use it."
            },
            {
              "kind": "speech",
              "text": "നാളെ had been sitting inside നാളെ കാണാം since your first week, doing nothing but ending a conversation. A learner who had said that goodbye a hundred times still could not say tomorrow I will go, because the word had never been shown standing anywhere else."
            },
            {
              "kind": "speech",
              "text": "That is worth noticing as a habit and not only as a fact: a phrase you learned whole may be holding a word you can use apart from it. When one of them turns out to detach, you gain a word without learning one."
            },
            {
              "kind": "speech",
              "text": "And with these three, every sentence you own can now be dated. The tenses were built chapters ago and had nowhere to land."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "innale, innŭ, nāḷe — in that order",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *innale*, *innŭ*, *nāḷe* — in that order]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "innale ñān pōyi",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *innale ñān pōyi*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "nāḷe ñān pōkuṁ",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *nāḷe ñān pōkuṁ*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "which of the three words you already had, and where",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: which of the three words you already had, and where]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Yesterday, today, tomorrow? (ഇന്നലെ (innale), ഇന്ന് (innŭ), നാളെ.) Where does a day word stand? (In front.) And what tells you the tense? (The verb ending.)"
            }
          ]
        }
      ]
    }
  ],
