    {
      "id": "ES-C405-fotografia",
      "sequence": 9060,
      "title": "la fotografía — writing with light",
      "headword": "la fotografía",
      "romanization": "la fotografía",
      "gloss": "photograph or photography — literally light-writing through Greek roots",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:b6f88ff75a0f0970",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Say to make or do and the room. (Hacer, la sala.)"
            }
          ]
        },
        {
          "index": 1,
          "type": "pronunciation",
          "title": "Sounds you'll need",
          "segments": [
            {
              "kind": "speech",
              "text": "fo-to-gra-FEE-a: the written accent keeps í and a in separate syllables."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "la fotografía means both “photography” and “a photograph.” Its international parts come from Greek phôs, phōtós, “light,” and graphía, “writing or description.” A photograph is, quite literally, writing with light."
            },
            {
              "kind": "speech",
              "text": "Spanish commonly says hacer fotografías, “to take photographs.” The verb is the familiar hacer: Spanish pictures the activity as making photographs."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "la fotografía",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *la fotografía*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "hacer fotografías",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *hacer fotografías*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "hacer fotografías en la sala",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *hacer fotografías en la sala*]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Say to take photographs. (Hacer fotografías.)"
            },
            {
              "kind": "speech",
              "text": "Sources: DLE: fotografía and DLE: foto-."
            }
          ]
        }
      ]
