        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "fil has made a round trip. Middle Persian had pīl, \"elephant\" (EtymDB), usually traced to Akkadian pīru. Arabic, with no p, took it as fīl (root f-y-l, Lane), and Persian took the Arabic form back."
            }
          ]
        },
