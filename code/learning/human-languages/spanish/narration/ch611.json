        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: la condición",
          "segments": [
            {
              "kind": "speech",
              "text": "la condición — \"the condition\"."
            },
            {
              "kind": "speech",
              "text": "Te ayudo con una condición. I will help you on one condition."
            },
            {
              "kind": "speech",
              "text": "Las condiciones de trabajo — working conditions."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "condición is a learned borrowing from Latin condicio 'agreement, terms', built on condicere 'to agree together', from dicere 'to say' (EtymDB)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
