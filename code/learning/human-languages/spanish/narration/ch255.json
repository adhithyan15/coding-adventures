      "title": "vi — the shortest past in the language",
      "headword": "vi",
      "romanization": "vi",
      "gloss": "I saw — a past so short it needs no accent, and the reason that is a rule rather than an exception",
      "script": "latin",
      "modality": "sight",
      "derivedModality": "sight",
      "modalityReasons": [
        "sight-cue"
      ],
      "sourceHash": "fnv1a64:6b77dff3a5ed160b",
      "notice": {
