    {
      "id": "ZH-W311-jing-alert",
      "sequence": 24095,
      "title": "警 (jǐng) — three pieces: top left, top right and the foot",
      "headword": "警",
      "romanization": "jǐng",
      "gloss": "警 — the grass piece over a wrap and 口, the striking piece, then a dot, three bars and 口",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:56a2ae9f82d9c6ca",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — three pieces: top left, top right and the foot",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — three pieces: top left, top right and the foot and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say jǐngchē — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *jǐngchē* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "花 救."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — huā, jiù",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *huā*, *jiù*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — three pieces: top left, top right and the foot",
          "segments": [
            {
              "kind": "speech",
              "text": "警 (jǐng)."
            },
            {
              "kind": "speech",
              "text": "Three pieces: two side by side on top, one across the foot. Count the pieces, not the strokes."
            },
            {
              "kind": "speech",
              "text": "Top left, eight strokes. The grass piece of 花: a bar and two short verticals. Under it a short sweep to the left and a stroke that runs right, turns down and hooks back. Inside, 口."
            },
            {
              "kind": "speech",
              "text": "Top right, four strokes. The striking piece of 救: a sweep to the left, a bar, a long sweep to the lower left and a long stroke falling to the right."
            },
            {
              "kind": "speech",
              "text": "The foot, seven strokes. A dot. A long bar across, then two shorter bars. Then 口 under them."
            },
            {
              "kind": "speech",
              "text": "8 + 4 + 7 = nineteen."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "警 (jǐng), all nineteen, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 警, all nineteen, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many pieces in 警 (jǐng)? (Three.) Which piece sits across the foot? (A dot, three bars and 口.) Where have you made the top right piece? (In 救 and 故.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 警 (jǐng), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
