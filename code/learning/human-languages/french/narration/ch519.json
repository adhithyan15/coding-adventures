        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: le romancier",
          "segments": [
            {
              "kind": "speech",
              "text": "le romancier — \"novelist\"."
            },
            {
              "kind": "speech",
              "text": "Ce romancier écrit un livre par an. This novelist writes a book a year."
            },
            {
              "kind": "speech",
              "text": "A woman is la romancière."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "le romancier is built on roman \"novel\", from Old French romanz, a story told in the common Romance tongue rather than in Latin."
            }
          ]
        },
        {
