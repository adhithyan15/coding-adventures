          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "vaqt gozarândan is built in Persian on vaqt, 'time', which was borrowed from Arabic waqt (EtymDB), and native gozarândan, 'to make pass', the causative of gozashtan."
            }
          ]
        },
