        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: வருத்தம்",
          "segments": [
            {
              "kind": "speech",
              "text": "வருத்தம் (varuttam) — \"sorrow, regret\"."
            },
            {
              "kind": "speech",
              "text": "One word for both kinds of sorry: sad about something, and sorry for something."
            },
            {
              "kind": "speech",
              "text": "This is the word that finishes an apology in ordinary speech. You already have தவறு (tavaṟu), the mistake, and மன்னிக்கவும் (maṉṉikkavum), which asks formally to be forgiven. வருத்தம் (varuttam) sits between them: it names the feeling rather than making the request, and it is the one you can say to a friend without sounding like a letter."
            },
            {
              "kind": "speech",
              "text": "Its middle is a doubled த்த, the same closing-and-leaning you read in சட்டை and வண்டி."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "Three feelings, and one of them is an apology."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "varuttam",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *varuttam*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "tavaṟu, then varuttam — the mistake, then the feeling about it",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *tavaṟu*, then *varuttam* — the mistake, then the feeling about it]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "maṉṉikkavum, then varuttam, and say which is the formal one",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *maṉṉikkavum*, then *varuttam*, and say which is the formal one]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say payam, then read பயம், then say varuttam",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *payam*, then read **பயம்**, then say *varuttam*]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say suvar, then read ஓடு",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *suvar*, then read **ஓடு**]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Which of the two would you say to a friend — மன்னிக்கவும் or வருத்தம் (varuttam)? (வருத்தம் (varuttam).)"
            }
          ]
        }
      ]
