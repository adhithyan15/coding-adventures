        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: بڑبڑانا",
          "segments": [
            {
              "kind": "speech",
              "text": "بڑبڑانا — baṛbaṛānā — \"to mutter; to grumble\"."
            },
            {
              "kind": "speech",
              "text": "دادا اکیلے بیٹھ کر بڑبڑاتے ہیں۔ dādā akele baiṭh kar baṛbaṛāte haiṅ. My grandfather sits on his own and mutters."
            },
            {
              "kind": "speech",
              "text": "Past (he …): وہ کچھ بڑبڑایا, voh kuchh baṛbaṛāyā."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "بڑبڑانا (baṛbaṛānā) is inherited from baḍabaḍa, \"grumble, mutter\", a form CDIAL reconstructs and treats as an imitation of the sound (CDIAL 9122)."
            }
          ]
        },
