          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: గుంట",
          "segments": [
            {
              "kind": "speech",
              "text": "గుంట — guṇṭa — \"a pit, a pothole\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "గుంట (guṇṭa) is native Dravidian. DEDR 1669 lists guṇṭa, \"pit, pond\", with Tamil kuṇṭu, \"hollow, pit\", and Kannada kuṇṭe, \"pit\". DEDR compares Sanskrit kuṇḍa, \"pit, well\" (CDIAL 3264), which CDIAL takes from Dravidian."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for this chapter."
