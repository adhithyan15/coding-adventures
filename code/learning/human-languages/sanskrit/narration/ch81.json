            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Sanskrit for a tortoise, then the Sanskrit for a frog."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: वृक्षः",
          "segments": [
            {
              "kind": "speech",
              "text": "वृक्षः (vṛkṣaḥ) — \"a tree\", the everyday word beside तरुः."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Vṛkṣa is already in the Rigveda (CDIAL 12067). MW offers three guesses, a root √bṛh \"to grow\", another √bṛh \"to root up\", or √vraśc \"to fell\", so its origin is not settled."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "A second word for tree."
            }
          ]
        },
        {
          "index": 4,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
