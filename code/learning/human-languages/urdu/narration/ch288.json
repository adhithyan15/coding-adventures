        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: چراغ",
          "segments": [
            {
              "kind": "speech",
              "text": "چراغ — chirāgh — \"an oil lamp\"."
            },
            {
              "kind": "speech",
              "text": "رات کو چراغ گر گیا۔ rāt ko chirāgh gir gayā. The lamp fell over in the night."
            },
            {
              "kind": "speech",
              "text": "Masculine."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "چراغ (chirāgh) is usually traced to Persian chirāgh, \"a lamp\". It is the small clay lamp with oil and a wick."
            }
          ]
        },
