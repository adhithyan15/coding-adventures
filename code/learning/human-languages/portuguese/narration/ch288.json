        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: o assalto",
          "segments": [
            {
              "kind": "speech",
              "text": "o assalto — \"the hold-up, the robbery with force\"."
            },
            {
              "kind": "speech",
              "text": "O assalto ao banco durou dez minutos. The bank hold-up lasted ten minutes."
            },
            {
              "kind": "speech",
              "text": "Assalto à mão armada — armed robbery."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "assalto is usually traced to Vulgar Latin adsaltāre \"to jump at\", from Latin saltāre \"to jump, to leap\" (Lewis & Short)."
            }
          ]
        },
        {
