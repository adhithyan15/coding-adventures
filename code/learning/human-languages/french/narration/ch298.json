          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "blessé is the past participle of the verb meaning \"to wound\", which is usually traced to a Frankish word for \"to bruise\"; the origin is not fully settled (EtymDB lists no parent)."
            }
          ]
        },
