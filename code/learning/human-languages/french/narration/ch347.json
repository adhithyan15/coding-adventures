          "segments": [
            {
              "kind": "speech",
              "text": "par conséquent — \"consequently, therefore\"."
            },
            {
              "kind": "speech",
              "text": "Il est malade; par conséquent, il ne vient pas. He is ill; consequently, he is not coming."
            },
            {
              "kind": "speech",
              "text": "Written style; in speech, donc or alors."
            }
          ]
        },
