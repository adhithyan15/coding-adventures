        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: einparken",
          "segments": [
            {
              "kind": "speech",
              "text": "einparken — \"to park (in a space)\"."
            },
            {
              "kind": "speech",
              "text": "Sie parkt das große Auto ohne Probleme ein. She parks the big car without any problems."
            },
            {
              "kind": "speech",
              "text": "Separable: ich parke ein, ich habe eingeparkt. Parken alone is more general."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "einparken is built from ein- 'in' and parken 'to park', which is usually traced to English to park. EtymDB does not list the German verb, so the line is hedged."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
