{
  "cases": [
    {
      "child": "/repo/a/b",
      "expect": {
        "inside": true,
        "same": false
      },
      "flavor": "posix",
      "id": "containment/posix-child",
      "root": "/repo",
      "summary": "a nested child"
    },
    {
      "child": "/repo",
      "expect": {
        "inside": true,
        "same": true
      },
      "flavor": "posix",
