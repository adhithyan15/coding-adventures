            },
            {
              "kind": "speech",
              "text": "Mein Vertrag ist auf ein Jahr befristet. My contract is fixed-term, for one year."
            },
            {
              "kind": "speech",
              "text": "The participle of befristen — to set a time limit. The opposite is unbefristet — permanent."
            }
          ]
        },
