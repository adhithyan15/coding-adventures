        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: die Fassade",
          "segments": [
            {
              "kind": "speech",
              "text": "die Fassade — \"the façade, the front (of a building)\"."
            },
            {
              "kind": "speech",
              "text": "Die Fassade vom Rathaus ist frisch gestrichen. The front of the town hall has been freshly painted."
            },
            {
              "kind": "speech",
              "text": "Plural: die Fassaden. Figurative: Das ist nur Fassade — it is all for show."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Fassade was borrowed from French façade (EtymDB), which came from Italian facciata, built on faccia 'face', from Latin faciēs (Lewis & Short)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
