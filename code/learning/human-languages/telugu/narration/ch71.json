      "id": "TE-C71-uncle",
      "sequence": 2380,
      "title": "మామ (māma) — an uncle; a father-in-law",
      "headword": "మామ",
      "romanization": "māma",
      "gloss": "an uncle; a father-in-law",
      "script": "telugu",
      "modality": "voice",
