        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: vacō, vacāre",
          "segments": [
            {
              "kind": "speech",
              "text": "vacō, vacāre — \"to be free, have time (for)\"."
            },
            {
              "kind": "speech",
              "text": "Hodiē vacō; tēcum ambulāre possum. Today I am free; I can go for a walk with you."
            },
            {
              "kind": "speech",
              "text": "vacō, vacāre, vacāvī, vacātum. To be empty, then to be free for something: vacāre litterīs — to have time for literature. English vacant, vacation."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "vacō is inherited, through Proto-Italic, from a Proto-Indo-European root meaning \"empty\" (EtymDB). English vacant and vacation come from it."
            }
          ]
        },
        {
