            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Marathi for about, then the Marathi for only."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: गंभीर",
          "segments": [
            {
              "kind": "speech",
              "text": "गंभीर — gambhīr — \"serious\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "गंभीर (gambhīr) is Sanskrit gambhīra, \"deep\", taken over whole as a learned loan, a tatsama (CDIAL 4031). CDIAL lists the Marathi word as gãbhīr, \"deep (of water), serious\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
