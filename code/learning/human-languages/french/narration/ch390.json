        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: le budget",
          "segments": [
            {
              "kind": "speech",
              "text": "le budget — \"the budget\"."
            },
            {
              "kind": "speech",
              "text": "Notre budget pour les vacances est de mille euros. Our holiday budget is a thousand euros."
            },
            {
              "kind": "speech",
              "text": "The final t is silent."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "budget was borrowed from English budget (EtymDB), which came from Old French bougette \"a little leather bag\", a small form of bouge \"bag\". bouge goes back to Late Latin bulga \"a leather bag\", a Gaulish word (EtymDB; Lewis & Short)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
            }
          ]
        },
