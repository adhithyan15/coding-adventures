        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: entrevistar",
          "segments": [
            {
              "kind": "speech",
              "text": "entrevistar — \"to interview\"."
            },
            {
              "kind": "speech",
              "text": "A jornalista entrevistou o novo treinador. The journalist interviewed the new coach."
            },
            {
              "kind": "speech",
              "text": "Built on entrevista."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "entrevistar is built on entrevista \"interview\", which is usually said to follow French entrevue (EtymDB has no source for it); vista goes back to Latin vidēre \"to see\" (Lewis & Short)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
