      "title": "comieron",
      "headword": "comieron",
      "romanization": "comieron",
      "gloss": "they ate, they lived — the two families that already share a past, sharing its plural too",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:2cb5ee1a33161f7f",
