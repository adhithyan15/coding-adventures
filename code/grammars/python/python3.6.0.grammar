# Python 3.6.0 (2016-12-23) grammar: py-int-print and py-float-print subsets over the slice's tokens.
# @version 1
# PARTIAL: parses only the py-int-print/py-float-print subsets below; everything else is a parse error.
# source_ref: https://github.com/python/cpython/tree/v3.6.0
# source_sha: 5c4568a05a0a62b5947c55f68f9f2ecfb90a4f12
# evidence: Grammar/Grammar blob b139e9f66c8ce0bd2d3ed585e81ff13b00445395; Grammar/Tokens blob -;
#   Parser/tokenizer.c blob 0fa3aebc0f8d515c2302d8abda760da09101291f; Lib/keyword.py blob 6e1e882a91e7006f5699ca9ac6df8292d8b8457f
# basis: reviewed against the tag's own syntax files (LANG84 phase 7c slice 2). Tokens follow tokenizer.c tok_decimal_tail (PEP 515 `_` separators, new in 3.6) and PyToken_OneChar/TwoChars/ThreeChars (47 operators) and keyword.py kwlist (33, no async/await); the grammar follows Grammar/Grammar file_input..atom_expr/trailer/arglist.

# ---------------------------------------------------------------------------
# py-int-print (LANG84 phase 7a) as this release's grammar admits it. The
# release's own rules, from the tag's grammar file:
#
#   file_input : (NEWLINE | stmt)* ENDMARKER
#   simple_stmt: small_stmt (';' small_stmt)* [';'] NEWLINE
#   arith_expr : term (('+'|'-') term)*          (python.gram: sum)
#   term       : factor (('*'|'@'|'/'|'%'|'//') factor)*
#   factor     : ('+'|'-'|'~') factor | power
#   power      : atom_expr ['**' factor]
#   atom_expr  : [AWAIT] atom trailer*          (python.gram: primary)
#   trailer    : '(' [arglist] ')' | ...
#   arglist    : argument (',' argument)* [',']  (python.gram: args)
#   atom       : '(' [testlist_comp] ')' | NAME | NUMBER | ...
#
# Rule names follow code/grammars/python/python3.12.grammar (LANG84 C8), so a
# later subset adds the levels this one never reaches (or_expr ... shift,
# power, await_expr) without renaming anything. Without them one parenthesis
# costs 8 parser levels instead of about 18.
#
# Narrower than Python on purpose (parse errors here, valid there): every
# statement other than an expression statement, `**`, `~`, `@`, comparisons and
# boolean operators, subscripts and attributes, tuples and `()`, keyword and
# starred arguments, and every compound statement.
# Since LANG84 phase 7c slice 3 an atom may be a FLOAT (py-float-print).
# Admitted here and refused by the compiler (`Unsupported`): `//` and `%` on
# a float, a callee other than `print`, more than one
# argument, a call used as a value, a bare expression statement.
# ---------------------------------------------------------------------------

file        = { NEWLINE | statement } ;
statement   = simple_stmt ;
simple_stmt = small_stmt { SEMICOLON small_stmt } [ SEMICOLON ] NEWLINE ;
small_stmt  = expression ;

expression  = arith ;
arith       = term { ( PLUS | MINUS ) term } ;
term        = factor { ( STAR | SLASH | FLOOR_DIV | PERCENT ) factor } ;
factor      = ( PLUS | MINUS ) factor | primary ;
primary     = atom { suffix } ;
suffix      = LPAREN [ arguments ] RPAREN ;
arguments   = argument { COMMA argument } [ COMMA ] ;
argument    = expression ;
atom        = INT | FLOAT | NAME | paren_expr ;
paren_expr  = LPAREN paren_body RPAREN ;
paren_body  = expression ;
