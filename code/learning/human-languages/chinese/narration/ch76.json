        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:7f4b9472f58f3f8e",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
