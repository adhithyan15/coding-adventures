        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: تكلم",
          "segments": [
            {
              "kind": "speech",
              "text": "تكلم — takallama — \"to speak (he spoke)\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "تكلم (takallama) is built on the native Arabic root k-l-m, \"to speak to; speech\" (Lane). Takallama is Form V, \"to speak\"; the same root gives kalima, \"a word\", and kalām, \"speech\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
