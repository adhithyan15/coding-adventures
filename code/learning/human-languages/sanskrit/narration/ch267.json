          ]
        },
        {
          "index": 1,
          "type": "guided-production",
          "title": "Guided Practice: a fresh prompt",
          "segments": [
            {
              "kind": "speech",
              "text": "No Sanskrit model is shown before you answer."
            },
            {
              "kind": "pause",
              "seconds": 12,
              "perItem": false,
              "source": "[PAUSE 12s]"
            },
            {
              "kind": "speech",
              "text": "Imagine that a teacher points to the timetable in a classroom. Ask when the exam will be and answer that it will be tomorrow. Say what homework you will do and what lesson you will study. Finish by recalling the school, student, teacher, mark, and answer words."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built: boundary",
          "segments": [
            {
              "kind": "speech",
              "text": "You can now complete one small A1 school-day plan with familiar language. This is not complete classroom discourse, school-system, grading, educational rights, or future-paradigm coverage, and it is not evidence of exam readiness, human validation, or learner success."
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Name the four jobs: read the timetable, ask and answer the exam time, state the homework plan, and state the study plan."
            }
          ]
        }
