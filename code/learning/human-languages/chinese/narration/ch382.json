    {
      "id": "ZH-W382-bao-keep",
      "sequence": 29425,
      "title": "保 (bǎo) — the person piece, then 口 over a tree",
      "headword": "保",
      "romanization": "bǎo",
      "gloss": "保 — the person piece, then 口 over a tree",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:e06da75f8187b6e4",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — the person piece, then 口 over a tree",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — the person piece, then 口 over a tree and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say bǎo'ān — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *bǎo'ān* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "你 安."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — nǐ, ān",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *nǐ*, *ān*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — the person piece, then 口 over a tree",
          "segments": [
            {
              "kind": "speech",
              "text": "保 (bǎo)."
            },
            {
              "kind": "speech",
              "text": "Three pieces: the person piece on the left, then 口 over a tree on the right."
            },
            {
              "kind": "speech",
              "text": "The person piece 亻, two strokes, as in 你 and 他."
            },
            {
              "kind": "speech",
              "text": "口, three strokes, high on the right: a short vertical, a stroke that runs right and turns down, then the bar that closes the foot."
            },
            {
              "kind": "speech",
              "text": "The tree under it, four strokes. A long bar. A vertical down through it. A stroke falling to the left from the crossing, then one falling to the right."
            },
            {
              "kind": "speech",
              "text": "2 + 3 + 4 = nine."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "保 (bǎo), all nine, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 保, all nine, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many strokes in 保 (bǎo)? (Nine.) What sits over the tree? (口.) Which piece comes first? (亻, the person piece.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 保 (bǎo), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
