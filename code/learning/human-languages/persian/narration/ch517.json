          "segments": [
            {
              "kind": "speech",
              "text": "تار (târ) — \"a tar (a long-necked lute); a string\"."
            },
            {
              "kind": "speech",
              "text": "پدربزرگم تار میزد. pedarbozorgam târ mizad. My grandfather used to play the tar."
            },
            {
              "kind": "speech",
              "text": "târ also means 'string, thread': the instrument is 'the string'."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "târ is a native Persian word for a string or thread, and the instrument takes its name from it. EtymDB lists it without a source, so its older origin is not settled."
            }
          ]
        },
