        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: überzeugen",
          "segments": [
            {
              "kind": "speech",
              "text": "überzeugen — \"to convince\"."
            },
            {
              "kind": "speech",
              "text": "Der Verkäufer hat mich überzeugt: Ich nehme das blaue Fahrrad. The salesman convinced me: I am taking the blue bike."
            },
            {
              "kind": "speech",
              "text": "Inseparable: er überzeugt, er hat überzeugt. Sich überzeugen — to see for yourself that something is so."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "überzeugen is built on zeugen \"to testify\", from Middle High German ziugen (EtymDB), with über- \"over\". It is usually said to have begun in the law courts, for proving something against a person with witnesses."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
            }
          ]
        },
