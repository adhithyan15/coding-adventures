    {
      "id": "ZH-W58-ji-machine",
      "sequence": 5005,
      "title": "机 (jī) — the tree piece, then jǐ",
      "headword": "机",
      "romanization": "jī",
      "gloss": "机 — the tree piece, then jǐ",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:fd1d020c6a119c0b",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — the tree piece, then jǐ",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — the tree piece, then jǐ and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say shǒujī — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *shǒujī* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "手 想."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — shǒu, xiǎng",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *shǒu*, *xiǎng*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — the tree piece, then jǐ",
          "segments": [
            {
              "kind": "speech",
              "text": "机 (jī)."
            },
            {
              "kind": "speech",
              "text": "Two pieces, left before right. Count the pieces, not the strokes."
            },
            {
              "kind": "speech",
              "text": "The tree piece, four strokes, narrow on the left, as at the top left of 想: a horizontal, a vertical down through it, a left-falling stroke, and a dot."
            },
            {
              "kind": "speech",
              "text": "The right piece, two strokes, read jǐ, as in the word for how many: a left-falling stroke down the left side, then one stroke that runs across the top, turns down, bends right along the bottom and hooks up."
            },
            {
              "kind": "speech",
              "text": "4 + 2 = six."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "机 (jī), all six, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 机, all six, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many pieces in 机 (jī)? (Two — the tree piece, then jǐ.) Which character you know has the same tree piece? (想.) How does the last stroke end? (It runs along the bottom and hooks up.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 机 (jī), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
