        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: profesional",
          "segments": [
            {
              "kind": "speech",
              "text": "profesional — \"professional\"."
            },
            {
              "kind": "speech",
              "text": "Buscamos un equipo profesional. We are looking for a professional team."
            },
            {
              "kind": "speech",
              "text": "It is an adjective and a noun: un profesional is a professional, a person who does the job for a living."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "profesional is built from profesión, \"a profession\", with -al. Profesión is Latin professio, \"a public declaration\" (Lewis & Short), from profiteri, \"to declare openly\": a profession was the work you declared."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for reading notices, forms and messages."
