// ButtonGroup.light.msl — default light-theme styling.

style ButtonGroup {
  part button-group {
    padding : 0 ;
  }
  part button-group-item {
    padding       : 8 ;
    background    : "#ffffff" ;
    color         : "#0d6efd" ;
    border-width  : 1 ;
    border-color  : "#0d6efd" ;
    font-size     : 14 ;
    border-radius : 0 ;
  }
}
