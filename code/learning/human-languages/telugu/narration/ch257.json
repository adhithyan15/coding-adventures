              "action": "SAY",
              "instruction": "Ugadi, Diwali, Dasara, Vinayaka Chavithi, Bathukamma",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: Ugadi, Diwali, Dasara, Vinayaka Chavithi, Bathukamma]"
