{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coding-adventures.dev/schemas/ct-compare-v1.schema.json",
  "title": "CT01 neutral comparison cases v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profile": {
      "const": "ct-compare-v1"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/eq"
          },
          {
            "$ref": "#/$defs/eq_fixed"
          },
          {
            "$ref": "#/$defs/select"
          },
          {
            "$ref": "#/$defs/eq_u64"
          }
        ]
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "maxLength": 80
    },
    "bytes": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{2})*$",
      "maxLength": 8192
    },
    "u64": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "byte_positions",
        "byte_reads",
        "byte_writes",
        "u64_bits"
      ],
      "properties": {
        "byte_positions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "byte_reads": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8192
        },
        "byte_writes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "u64_bits": {
          "enum": [
            0,
            64
          ]
        }
      }
    },
    "equality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "equal"
      ],
      "properties": {
        "equal": {
          "type": "boolean"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_hex",
        "fresh_output"
      ],
      "properties": {
        "output_hex": {
          "$ref": "#/$defs/bytes"
        },
        "fresh_output": {
          "const": true
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error_id"
      ],
      "properties": {
        "error_id": {
          "const": "CT_SELECT_LENGTH_MISMATCH"
        }
      }
    },
    "eq": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "operation",
        "left_hex",
        "right_hex",
        "expected",
        "expected_work"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "operation": {
          "const": "eq"
        },
        "left_hex": {
          "$ref": "#/$defs/bytes"
        },
        "right_hex": {
          "$ref": "#/$defs/bytes"
        },
        "expected": {
          "$ref": "#/$defs/equality"
        },
        "expected_work": {
          "$ref": "#/$defs/work"
        }
      }
    },
    "eq_fixed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "operation",
        "fixed_size_bytes",
        "left_hex",
        "right_hex",
        "expected",
        "expected_work"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "operation": {
          "const": "eq_fixed"
        },
        "fixed_size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "left_hex": {
          "$ref": "#/$defs/bytes"
        },
        "right_hex": {
          "$ref": "#/$defs/bytes"
        },
        "expected": {
          "$ref": "#/$defs/equality"
        },
        "expected_work": {
          "$ref": "#/$defs/work"
        }
      }
    },
    "select": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "operation",
        "left_hex",
        "right_hex",
        "choice",
        "expected",
        "expected_work"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "operation": {
          "const": "select_bytes"
        },
        "left_hex": {
          "$ref": "#/$defs/bytes"
        },
        "right_hex": {
          "$ref": "#/$defs/bytes"
        },
        "choice": {
          "type": "boolean"
        },
        "expected": {
          "oneOf": [
            {
              "$ref": "#/$defs/output"
            },
            {
              "$ref": "#/$defs/error"
            }
          ]
        },
        "expected_work": {
          "$ref": "#/$defs/work"
        }
      }
    },
    "eq_u64": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "operation",
        "left_u64",
        "right_u64",
        "expected",
        "expected_work"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "operation": {
          "const": "eq_u64"
        },
        "left_u64": {
          "$ref": "#/$defs/u64"
        },
        "right_u64": {
          "$ref": "#/$defs/u64"
        },
        "expected": {
          "$ref": "#/$defs/equality"
        },
        "expected_work": {
          "$ref": "#/$defs/work"
        }
      }
    }
  }
}
