          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ambūrō is built on ūrō, \"to burn\", with amb-, \"around\" (EtymDB): to burn round the edges."
            }
          ]
        },
