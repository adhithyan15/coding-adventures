# @version 1
# Mermaid 11.16.1 Gantt core parser grammar.

document = { terminator } HEADER { terminator | statement } EOF ;
terminator = NEWLINE | SEMICOLON ;
statement = ACC_TITLE_STATEMENT | ACC_DESCR_STATEMENT | ACC_DESCR_BLOCK | TITLE_STATEMENT | DATE_FORMAT_STATEMENT | SECTION_STATEMENT | CLICK_STATEMENT | TASK_STATEMENT ;
