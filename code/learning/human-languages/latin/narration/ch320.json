          "title": "You'll want to know: pavor, pavōris",
          "segments": [
            {
              "kind": "speech",
              "text": "pavor, pavōris — \"panic, terror\"."
            },
            {
              "kind": "speech",
              "text": "Pavor omnēs cīvēs cēpit. Panic seized all the citizens."
            },
            {
              "kind": "speech",
              "text": "Masculine, 3rd declension. A sudden fear that shakes the body."
            }
          ]
        },
        {
