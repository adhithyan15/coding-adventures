    {
      "id": "ZH-W60-bai-white",
      "sequence": 5105,
      "title": "白 (bái) — a short fall over 日",
      "headword": "白",
      "romanization": "bái",
      "gloss": "白 — a short fall over 日",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:818f971d867a1c96",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — a short fall over 日",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — a short fall over 日 and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say bái — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *bái* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "日 百."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — rì, bǎi",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *rì*, *bǎi*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — a short fall over 日",
          "segments": [
            {
              "kind": "speech",
              "text": "白 (bái)."
            },
            {
              "kind": "speech",
              "text": "Two pieces, top to bottom."
            },
            {
              "kind": "speech",
              "text": "A short left-falling stroke at the top, from the right down to the left."
            },
            {
              "kind": "speech",
              "text": "日, four strokes, the same four your hand makes in 日: the left side, the top that turns down the right side, the middle bar, and the bar that closes the bottom."
            },
            {
              "kind": "speech",
              "text": "1 + 4 = five."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "白 (bái), all five, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 白, all five, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many strokes in 白 (bái)? (Five.) What comes before 日? (A short fall at the top.) Which number you know has 白 (bái) under its top bar? (百.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 白 (bái), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
