          "segments": [
            {
              "kind": "speech",
              "text": "ōmen, ōminis — \"an omen, a sign\"."
            },
            {
              "kind": "speech",
              "text": "Hoc ōmen bonum esse putāvērunt. They thought that this omen was good."
            },
            {
              "kind": "speech",
              "text": "Neuter, 3rd declension. A chance word or sight that seemed to foretell the future."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ōmen had an old form osmen, says Varro, quoted by Lewis & Short; its earlier origin is not settled. English omen is the same word."
            }
          ]
        },
