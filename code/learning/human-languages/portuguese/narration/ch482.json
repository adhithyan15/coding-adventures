        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: a nuca",
          "segments": [
            {
              "kind": "speech",
              "text": "a nuca — \"nape (of the neck)\"."
            },
            {
              "kind": "speech",
              "text": "O sol queimou-me a nuca. The sun burned the back of my neck."
            },
            {
              "kind": "speech",
              "text": "The back of the neck; the front is a garganta."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "nuca comes from Medieval Latin nucha, which is usually traced to an Arabic word for the spinal marrow."
            }
          ]
        },
        {
