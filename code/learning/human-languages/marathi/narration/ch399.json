      ],
      "sourceHash": "fnv1a64:fd1841c69073228f",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Marathi for a destination, then the Marathi for to set aside."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: चालक",
          "segments": [
            {
              "kind": "speech",
              "text": "चालक — cālak — \"a driver\"."
            },
            {
              "kind": "speech",
              "text": "चालकाने बस हळूहळू थांबवली. cālakāne bas haḷūhaḷū thāmbavlī. The driver brought the bus slowly to a stop."
            },
            {
              "kind": "speech",
              "text": "Masculine."
            },
            {
              "kind": "speech",
              "text": "The agent of a past transitive verb takes -ने: चालकाने बस थांबवली."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "चालक (cālak) is a tatsama formation on cāl-, the causative stem of Sanskrit cal, \"to move\", with the agent ending -aka: the one who makes the vehicle move. The same stem gives cālana, \"causing to move\" (Monier-Williams)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for getting around."
            }
          ]
        },
        {
          "index": 4,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
