    {
      "id": "ZH-W300-si-die",
      "sequence": 23525,
      "title": "死 (sǐ) — a long bar over two small pieces",
      "headword": "死",
      "romanization": "sǐ",
      "gloss": "死 — a long bar, the evening piece of 外, then the right half of 比",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:5b11ec1ff727fd87",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — a long bar over two small pieces",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — a long bar over two small pieces and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say sǐ — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *sǐ* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "外 比 多."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — wài, bǐ, duō",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *wài*, *bǐ*, *duō*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — a long bar over two small pieces",
          "segments": [
            {
              "kind": "speech",
              "text": "死 (sǐ)."
            },
            {
              "kind": "speech",
              "text": "Three pieces: a bar on top, then two side by side under it."
            },
            {
              "kind": "speech",
              "text": "The bar, one stroke, long, across the top."
            },
            {
              "kind": "speech",
              "text": "Under it on the left, three strokes. The evening piece on the left of 外: a short sweep, a bar that turns into a long sweep to the lower left, and a dot."
            },
            {
              "kind": "speech",
              "text": "On the right, two strokes. The right half of 比: a short sweep down to the left, then a vertical that bends right along the foot and hooks up."
            },
            {
              "kind": "speech",
              "text": "1 + 3 + 2 = six."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "死 (sǐ), all six, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 死, all six, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many strokes in 死 (sǐ)? (Six.) What comes first? (The long bar on top.) Where have you made the right piece? (On the right of 比.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 死 (sǐ), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
