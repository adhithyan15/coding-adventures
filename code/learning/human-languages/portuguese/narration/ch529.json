          "title": "You'll want to know: o detergente",
          "segments": [
            {
              "kind": "speech",
              "text": "o detergente — \"detergent, washing powder\"."
            },
            {
              "kind": "speech",
              "text": "Acabou o detergente da máquina. We have run out of washing powder."
            },
            {
              "kind": "speech",
              "text": "Detergente da loiça — washing-up liquid."
            }
          ]
