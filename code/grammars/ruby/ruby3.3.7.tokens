# Ruby 3.3.7 (2025-01-15) tokens: LANG84 R0 and R1b lexical slices.
# @version 1
# PARTIAL: lexes only the R0 and R1b constructs listed below; see code/grammars/ruby/README.md.
# source_ref: https://github.com/ruby/ruby/tree/v3_3_7
# source_sha: be31f993d7fa0219d85f7b3c694d454da4ecc10b
# evidence: parse.y blob baf391e52d2d2c094af2e6b4b236101c4c0f07fc; keywords blob -; defs/keywords blob a1b1f4f60fff880c554c017720298b550ce36529; prism/config.yml blob d3b6b08709c4924dc61ae375fe0030a574e14266
# basis: mechanical copy of ruby3.3.6.tokens; every syntax blob above is
#   identical to release 3.3.6's (LANG84 "Materialized pair per release").

# ---------------------------------------------------------------------------
# R0 and R1b lexical slices (LANG84 phases 3.2 and R1b). What this pair
# lexes, and what it does not, is spelled out here so a reader never has to
# guess.
#
# Lexed: integers (decimal, 0x, 0b, 0o / leading 0 / 0_, 0d, `_` separators),
# floats, identifiers (with `?`/`!` method suffixes), constants, @ivar,
# @@cvar, $gvar ($-w, $~ ..., $& backrefs, $1 nth refs), `:sym` as
# SYMBEG + name, `?c` character literals, keywords, every operator and
# punctuator, `#` comments, `\` line continuation, NEWLINE and `;`.
# R1b: `=begin` ... `=end` embedded documents and a `__END__` line, both
# only at a line start (see "line-start constructs" below).
#
# NOT lexed (later LANG84 slices). These either raise a lexer error or are
# documented divergences:
#   R1a strings '...' "..."                                -> lexer error
#   R2  interpolation, backticks, :"...", char escapes ?\n -> lexer error
#   R3  %w %i %q %r ... percent literals                   -> refused (R1b)
#   R4  regexp /re/                                         -> refused (R1b)
#   R5  heredocs <<ID                                       -> refused (R1b)
#   R6  local-variable-dependent forms (`x ?a :b` with x a local; space-
#       sensitive `foo -1`, `foo (1, 2)`)
#   R7  later per-release literals: 1r, 1i (lexer error), hash labels `a:`
# "Refused (R1b)" means: wherever Ruby might read the token as the opener of
# a multi-line literal, this pair stops with a lexer error instead of
# guessing. The rules are in `transitions:` and the argument is in LANG84's
# R1b plan; they over-refuse `x/2`, `a%b` and `x<<y` written without spaces.
#
# Known divergences from the release's own lexer (each has a test):
#   * `x!=y` / `x!~y` with no space before the operator lexes as FID `x!`.
#     Ruby only folds `!`/`?` into an identifier when `=` does not follow;
#     the regex engine has no lookahead, so this needs a later extension.
#   * `:foo=`, `:@iv`, `:$g`, `:+` (operator / variable symbols) lex as
#     COLON plus the operand, not SYMBEG.
#   * A digit run immediately followed by an identifier character (`1if`,
#     `1r`) is a lexer error (Ruby accepts `1if`).
#   * `foo +1` (space before `+`, none after) lexes as PLUS NUMBER; Ruby
#     folds it into one literal. See the mode table below.
#   * Every newline resets the mode to `beg`. Ruby keeps EXPR_DOT across the
#     newline in `foo.⏎bar` and ignores a newline before a leading `.bar`;
#     `beg` is the stricter reading for every rule here.
# ---------------------------------------------------------------------------

# --- numeric literals (parse.y parse_numeric) -------------------------------
# `\b` closes every number so that `1_`, `1__2`, `0x`, `08`, `1r` and `1i`
# are lexer errors instead of silently splitting into number + identifier.
HEX_INTEGER              = /0[xX][0-9a-fA-F]+(?:_[0-9a-fA-F]+)*\b/
BINARY_INTEGER           = /0[bB][01]+(?:_[01]+)*\b/
DECIMAL_PREFIXED_INTEGER = /0[dD][0-9]+(?:_[0-9]+)*\b/
OCTAL_INTEGER            = /0[oO_]?[0-7]+(?:_[0-7]+)*\b/
FLOAT                    = /(?:0|[1-9][0-9]*(?:_[0-9]+)*)(?:\.[0-9]+(?:_[0-9]+)*(?:[eE][-+]?[0-9]+(?:_[0-9]+)*)?|[eE][-+]?[0-9]+(?:_[0-9]+)*)\b/
NUMBER                   = /(?:0|[1-9][0-9]*(?:_[0-9]+)*)\b/

# --- identifiers (parse.y parse_ident, defs/keywords) -----------------------
# `defined?` is the only keyword spelled with a suffix; BEGIN and END are the
# only upper-case keywords. Both are matched before the general forms.
DEFINED_KEYWORD = /defined\?/ -> KEYWORD
UPPER_KEYWORD   = /(?:BEGIN|END)\b/ -> KEYWORD
FID             = /[A-Za-z_][A-Za-z0-9_]*[?!]/
CONSTANT        = /[A-Z][A-Za-z0-9_]*/
NAME            = /[a-z_][A-Za-z0-9_]*/

# --- variables (parse_atmark, parse_gvar) -----------------------------------
CVAR         = /@@[A-Za-z_][A-Za-z0-9_]*/
IVAR         = /@[A-Za-z_][A-Za-z0-9_]*/
GVAR         = /\$[A-Za-z_][A-Za-z0-9_]*/
GVAR_OPTION  = /\$-[A-Za-z0-9_]/ -> GVAR
NTH_REF      = /\$[1-9][0-9]*/
BACK_REF     = /\$[&`'+]/
GVAR_SPECIAL = /\$[~*$?!@\/\;,.=:<>"0]/ -> GVAR

# --- refused openers (R1b) -------------------------------------------------
# Matched before the operators so they win over `<<` and `=`; each has a
# `-> refuse` rule at the top of `transitions:`.
#
# A heredoc starts with `<<`, an optional `-` or `~`, then a quote or an
# identifier character (parse.y heredoc_identifier; digits and non-ASCII
# letters are identifier characters). `<<=` and `<< x` are not heredocs.
HEREDOC_OPEN = /<<[-~]?(?:[A-Za-z0-9_"'`]|[^\x00-\x7F])/
# `=begin` at a line start whose `=end` the EMBDOC skip pattern could not
# find: Ruby's "embedded document meets end of file".
EMBDOC_UNTERMINATED = /=begin(?:[\t\n\v\f\r \x00\x04\x1a]|$)/ @line_start
# A `?` written straight before a character that opens something under
# the OTHER reading of `?`. Ruby reads `?` as a character literal in
# EXPR_BEG/ARG/FNAME and as a ternary in EXPR_END; our flat modes only
# approximate that state (after `.end`, after a local `x`, after a value in
# a `def` parameter list), so either reading can be the wrong one:
#
# | after `?` | as a character literal | as a ternary `?`            |
# |-----------|------------------------|-----------------------------|
# | `"` `'` `` ` `` | `?"` …          | opens a string / command    |
# | `#`       | `?#`                   | opens a comment             |
# | `?`       | `??`                   | opens a character literal   |
# | `%`       | `?%`                   | opens a `%`-literal         |
# | `/`       | `?/`                   | opens a regexp              |
# | `<`       | `?<`                   | can open a `<<` heredoc     |
#
# Each of those can swallow a line on one side only, so a string, comment,
# literal or heredoc boundary would differ from Ruby's and could hide code
# around a line-start `=begin`/`__END__`. The CHAR classes leave all nine
# out, and this opener refuses them in every mode (R1b security review, F1
# for the first four, F2 for the rest). The characters CHAR still accepts
# open nothing under the ternary reading: `:` is a symbol start (`:"` would
# need a quote, which is a lexer error), `$`/`@` start a variable, and the
# rest are operators or brackets.
QUESTION_OPENER = /\?["'`#?%\/<]/

# --- operators, longest spelling first --------------------------------------
STAR_STAR_EQUALS   = "**="
STAR_STAR          = "**"
STAR_EQUALS        = "*="
STAR               = "*"
NOT_EQUALS         = "!="
NOT_MATCH          = "!~"
BANG               = "!"
CASE_EQUALS        = "==="
EQUALS_EQUALS      = "=="
MATCH              = "=~"
HASH_ROCKET        = "=>"
EQUALS             = "="
SPACESHIP          = "<=>"
LEFT_SHIFT_EQUALS  = "<<="
LEFT_SHIFT         = "<<"
LESS_EQUALS        = "<="
LESS_THAN          = "<"
GREATER_EQUALS     = ">="
RIGHT_SHIFT_EQUALS = ">>="
RIGHT_SHIFT        = ">>"
GREATER_THAN       = ">"
AND_AND_EQUALS     = "&&="
AND_AND            = "&&"
AMPERSAND_EQUALS   = "&="
SAFE_NAVIGATION    = "&."
AMPERSAND          = "&"
OR_OR_EQUALS       = "||="
OR_OR              = "||"
PIPE_EQUALS        = "|="
PIPE               = "|"
PLUS_EQUALS        = "+="
PLUS               = "+"
MINUS_EQUALS       = "-="
LAMBDA             = "->"
MINUS              = "-"
DOT3               = "..."
DOT2               = ".."
DOT                = "."
COLON_COLON        = "::"
COLON              = ":"
SLASH_EQUALS       = "/="
SLASH              = "/"
CARET_EQUALS       = "^="
CARET              = "^"
PERCENT_EQUALS     = "%="
PERCENT            = "%"
TILDE              = "~"
QUESTION           = "?"
COMMA              = ","
SEMICOLON          = ";"
LPAREN             = "("
RPAREN             = ")"
LBRACKET           = "["
RBRACKET           = "]"
LBRACE             = "{"
RBRACE             = "}"

# --- lexer states as F10 flat modes -----------------------------------------
# parse.y decides `?` (ternary vs character literal) and `:` (operator vs
# symbol start) from lex_state. R0 needs three of its states:
#
#   mode      parse.y states it stands for     `?x`      `:x`     `+1`
#   default   EXPR_END*  (after a value)       QUESTION  COLON    PLUS NUMBER
#   beg       EXPR_BEG/MID/DOT/VALUE           CHAR      SYMBEG   NUMBER "+1"
#   arg       EXPR_ARG/CMDARG (after a name)   CHAR      SYMBEG   PLUS NUMBER
#   fname     EXPR_FNAME (after `def`, `:`)    CHAR      SYMBEG   PLUS NUMBER
#
# parse.y folds a `+` into the numeric literal that follows it in EXPR_BEG,
# and in EXPR_ARG only when a space precedes the `+` and none follows
# (`foo +1`). Token adjacency is an E6 concern, so `arg` never folds: `a+1`
# and `a + 1` lex as Ruby lexes them, `foo +1` does not (R6). A `-` is never
# folded (tUMINUS_NUM is its own token).
#
# An identifier leaves the lexer in ARG/CMDARG unless it names a local
# variable (END). Locals are an R6 concern, so identifiers go to `arg`, which
# is what Ripper reports for a name it has not seen assigned.
#
# R1b adds three modes for the head of a `def`, because parse.y's grammar
# (not its lexer) sets EXPR_BEG after the `)` of `def name(params)`, and
# the R1b refusals need `beg` wherever Ruby is in EXPR_BEG:
#
#   mode       where                                   ends on
#   deffname   after `def`, and after `.`/`::` in       the method name
#              `def self.name` (EXPR_FNAME; a newline
#              here is ignored, as in Ruby)
#   defn       after the method name (EXPR_ENDFN)       `(` -> defparams
#   defparams  inside `def name( ... )`                 `)` -> beg
#
# Inside the head `/` `/=` `%` `%=` are always refused, and so are nested
# brackets inside the parameters and a `def (expr).name` singleton, so the
# first `)` always closes the parameter list.
start_mode: beg

group beg:
  CHAR                            = /\?(?:[A-Za-z0-9_]\b|[!$&(-.:;=>@\[\]^{|}~])/
  SYMBEG                          = /:\b/
  PLUS_HEX_INTEGER                = /\+0[xX][0-9a-fA-F]+(?:_[0-9a-fA-F]+)*\b/ -> HEX_INTEGER
  PLUS_BINARY_INTEGER             = /\+0[bB][01]+(?:_[01]+)*\b/ -> BINARY_INTEGER
  PLUS_DECIMAL_PREFIXED_INTEGER   = /\+0[dD][0-9]+(?:_[0-9]+)*\b/ -> DECIMAL_PREFIXED_INTEGER
  PLUS_OCTAL_INTEGER              = /\+0[oO_]?[0-7]+(?:_[0-7]+)*\b/ -> OCTAL_INTEGER
  PLUS_FLOAT                      = /\+(?:0|[1-9][0-9]*(?:_[0-9]+)*)(?:\.[0-9]+(?:_[0-9]+)*(?:[eE][-+]?[0-9]+(?:_[0-9]+)*)?|[eE][-+]?[0-9]+(?:_[0-9]+)*)\b/ -> FLOAT
  PLUS_NUMBER                     = /\+(?:0|[1-9][0-9]*(?:_[0-9]+)*)\b/ -> NUMBER

group arg:
  ARG_CHAR   = /\?(?:[A-Za-z0-9_]\b|[!$&(-.:;=>@\[\]^{|}~])/ -> CHAR
  ARG_SYMBEG = /:\b/ -> SYMBEG

group fname:
  FNAME_CHAR   = /\?(?:[A-Za-z0-9_]\b|[!$&(-.:;=>@\[\]^{|}~])/ -> CHAR
  FNAME_SYMBEG = /:\b/ -> SYMBEG

group deffname:
  DEFFNAME_CHAR   = /\?(?:[A-Za-z0-9_]\b|[!$&(-.:;=>@\[\]^{|}~])/ -> CHAR
  DEFFNAME_SYMBEG = /:\b/ -> SYMBEG

# EXPR_ENDFN reads `?` and `:` as `default` does. A flat mode needs at least
# one definition; this one restates `(`, the token the mode watches for.
group defn:
  DEFN_LPAREN = "(" -> LPAREN

# A parameter default (`a = ?x`, `b = :y`) is read in EXPR_BEG.
group defparams:
  DEFPARAMS_CHAR   = /\?(?:[A-Za-z0-9_]\b|[!$&(-.:;=>@\[\]^{|}~])/ -> CHAR
  DEFPARAMS_SYMBEG = /:\b/ -> SYMBEG

# --- line-start constructs (R1b) --------------------------------------------
# `skip:` patterns are tried before every token and before the built-in
# NEWLINE, so these two are checked at each line start first. Ruby's word
# rule (parse.y word_match_p) is: the word is followed by end of line, end of
# input or one of space \t \v \f \r NUL ^D ^Z. The regex engine has no
# lookahead, so the rule is spelled out as a character class and each
# pattern consumes whole lines:
#
#   EMBDOC    `=begin` line, any lines, `=end` line (each rest-of-line
#             ignored, as Ruby does). The `=end` must start a line. No `=end`
#             means no match, and EMBDOC_UNTERMINATED refuses the input.
#   DATA_END  a line that is exactly `__END__` (parse.y whole_match_p: a
#             trailing `\n` or `\r\n` is allowed, nothing else), then
#             everything up to the end of input, which is data.
#
# A line start is offset 0 or the character after `\n` (E1). That is also
# Ruby's line start, as long as Ruby is not inside a multi-line literal.
# Strings are not lexed (a bare quote or backtick is a lexer error), every
# other literal opener is refused (see `transitions:`), and no CHAR
# spelling contains a character that opens a string, comment, literal or
# heredoc under the other reading of `?` (`"` `'` `` ` `` `#` `?` `%` `/`
# `<`): `?` before one of those is QUESTION_OPENER, which is refused. So
# Ruby never is.
skip:
  EMBDOC            = /=begin(?:[\t\v\f\r \x00\x04\x1a][^\n]*)?\n(?:[^\n]*\n)*?=end(?:[\t\v\f\r \x00\x04\x1a][^\n]*)?(?:\n|$)/ @line_start
  DATA_END          = /__END__(?:\r?\n[\s\S]*)?$/ @line_start
  LINE_CONTINUATION = /\\\r?\n/
  WHITESPACE        = /[ \t\f\v\r]+/
  COMMENT           = /#[^\n]*/

# The first matching rule wins, so the R1b rules come first.
#
# R1b refusals (LANG84 R1b plan, "Fail closed"). A heredoc opener and an
# unterminated `=begin` are always refused. `/` `/=` `%` `%=` open a regexp
# or `%`-literal in Ruby when no whitespace follows in EXPR_ARG (IS_SPCARG)
# or EXPR_FNAME (`%s(`), and always in EXPR_BEG; elsewhere they are
# operators. So they are refused with no whitespace after them in any mode,
# and in every mode that stands for EXPR_BEG or a def head.
transitions:
  on (HEREDOC_OPEN | EMBDOC_UNTERMINATED | QUESTION_OPENER) -> refuse
  on (SLASH | SLASH_EQUALS | PERCENT | PERCENT_EQUALS) if !space_after -> refuse
  on (SLASH | SLASH_EQUALS | PERCENT | PERCENT_EQUALS) in beg -> refuse
  on (SLASH | SLASH_EQUALS | PERCENT | PERCENT_EQUALS) in deffname -> refuse
  on (SLASH | SLASH_EQUALS | PERCENT | PERCENT_EQUALS) in defn -> refuse
  on (SLASH | SLASH_EQUALS | PERCENT | PERCENT_EQUALS) in defparams -> refuse
  # The def head. In `defparams` every token kind the pair can emit has a
  # rule (a test checks this), so nothing but `)` leaves the mode.
  on (LPAREN | LBRACKET | LBRACE) in defparams -> refuse
  on RPAREN in defparams -> set-mode beg
  on (NUMBER | FLOAT | HEX_INTEGER | BINARY_INTEGER | OCTAL_INTEGER | DECIMAL_PREFIXED_INTEGER | CHAR | SYMBEG | NAME | FID | CONSTANT | KEYWORD | IVAR | CVAR | GVAR | NTH_REF | BACK_REF | STAR_STAR_EQUALS | STAR_STAR | STAR_EQUALS | STAR | NOT_EQUALS | NOT_MATCH | BANG | CASE_EQUALS | EQUALS_EQUALS | MATCH | HASH_ROCKET | EQUALS | SPACESHIP | LEFT_SHIFT_EQUALS | LEFT_SHIFT | LESS_EQUALS | LESS_THAN | GREATER_EQUALS | RIGHT_SHIFT_EQUALS | RIGHT_SHIFT | GREATER_THAN | AND_AND_EQUALS | AND_AND | AMPERSAND_EQUALS | SAFE_NAVIGATION | AMPERSAND | OR_OR_EQUALS | OR_OR | PIPE_EQUALS | PIPE | PLUS_EQUALS | PLUS | MINUS_EQUALS | LAMBDA | MINUS | DOT3 | DOT2 | DOT | COLON_COLON | COLON | CARET_EQUALS | CARET | TILDE | QUESTION | COMMA | SEMICOLON | RBRACKET | RBRACE | NEWLINE) in defparams -> set-mode defparams
  on LPAREN in deffname -> refuse
  on NEWLINE in deffname -> set-mode deffname
  on (NAME | FID | CONSTANT | KEYWORD | IVAR | CVAR | GVAR | PLUS | MINUS | STAR | STAR_STAR | EQUALS_EQUALS | CASE_EQUALS | NOT_EQUALS | MATCH | NOT_MATCH | BANG | TILDE | LESS_THAN | LESS_EQUALS | GREATER_THAN | GREATER_EQUALS | SPACESHIP | LEFT_SHIFT | RIGHT_SHIFT | AMPERSAND | PIPE | CARET | LBRACKET) in deffname -> set-mode defn
  on LPAREN in defn -> set-mode defparams
  on (DOT | COLON_COLON) in defn -> set-mode deffname
  on (EQUALS | RBRACKET) in defn -> set-mode defn
  # R0 rules.
  on (NAME | FID | CONSTANT | KEYWORD | IVAR | CVAR | GVAR | NTH_REF | BACK_REF) in fname -> set-mode default
  on KEYWORD="def"          -> set-mode deffname
  on KEYWORD="alias"        -> set-mode fname
  on KEYWORD="undef"        -> set-mode fname
  on KEYWORD="end"          -> set-mode default
  on KEYWORD="self"         -> set-mode default
  on KEYWORD="nil"          -> set-mode default
  on KEYWORD="true"         -> set-mode default
  on KEYWORD="false"        -> set-mode default
  on KEYWORD="redo"         -> set-mode default
  on KEYWORD="retry"        -> set-mode default
  on KEYWORD="__FILE__"     -> set-mode default
  on KEYWORD="__LINE__"     -> set-mode default
  on KEYWORD="__ENCODING__" -> set-mode default
  on KEYWORD="BEGIN"        -> set-mode default
  on KEYWORD="END"          -> set-mode default
  on KEYWORD                -> set-mode beg
  on SYMBEG                 -> set-mode fname
  on (NUMBER | FLOAT | HEX_INTEGER | BINARY_INTEGER | OCTAL_INTEGER | DECIMAL_PREFIXED_INTEGER | CHAR | IVAR | CVAR | GVAR | NTH_REF | BACK_REF | RPAREN | RBRACKET | RBRACE) -> set-mode default
  on (NAME | FID | CONSTANT) -> set-mode arg
  on (STAR_STAR_EQUALS | STAR_STAR | STAR_EQUALS | STAR | NOT_EQUALS | NOT_MATCH | BANG | CASE_EQUALS | EQUALS_EQUALS | MATCH | HASH_ROCKET | EQUALS | SPACESHIP | LEFT_SHIFT_EQUALS | LEFT_SHIFT | LESS_EQUALS | LESS_THAN | GREATER_EQUALS | RIGHT_SHIFT_EQUALS | RIGHT_SHIFT | GREATER_THAN | AND_AND_EQUALS | AND_AND | AMPERSAND_EQUALS | SAFE_NAVIGATION | AMPERSAND | OR_OR_EQUALS | OR_OR | PIPE_EQUALS | PIPE | PLUS_EQUALS | PLUS | MINUS_EQUALS | LAMBDA | MINUS | DOT3 | DOT2 | DOT | COLON_COLON | COLON | SLASH_EQUALS | SLASH | CARET_EQUALS | CARET | PERCENT_EQUALS | PERCENT | TILDE | QUESTION | COMMA | SEMICOLON | LPAREN | LBRACKET | LBRACE) -> set-mode beg
  # Ruby's lexer is in EXPR_BEG after every newline it emits (and stays in a
  # BEG-like state across the ones it ignores, except EXPR_DOT; see the
  # divergences above).
  on NEWLINE                -> set-mode beg

keywords:
  __ENCODING__
  __LINE__
  __FILE__
  alias
  and
  begin
  break
  case
  class
  def
  do
  else
  elsif
  end
  ensure
  false
  for
  if
  in
  module
  next
  nil
  not
  or
  redo
  rescue
  retry
  return
  self
  super
  then
  true
  undef
  unless
  until
  when
  while
  yield
