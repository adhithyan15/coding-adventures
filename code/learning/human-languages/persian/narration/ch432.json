          "segments": [
            {
              "kind": "speech",
              "text": "اضافه بار (ezâfe-bâr) — \"excess baggage\"."
            },
            {
              "kind": "speech",
              "text": "چمدان من سنگین بود و اضافه بار دادم. Chamedân-e man sangin bud va ezâfe-bâr dâdam. My suitcase was heavy and I paid for excess baggage."
            },
            {
              "kind": "speech",
              "text": "ezâfe 'extra' + bâr 'load, luggage'. Ezâfe-bâr dâdan — to pay for excess baggage."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ezâfe-bâr is built from ezâfe 'extra', borrowed from Arabic iḍāfa 'adding, an adjunct' (EtymDB), and native bâr 'load, burden', which EtymDB lists."
            }
          ]
        },
