  "lessons": [
    {
      "id": "ES-C409-terminar",
      "sequence": 9280,
      "title": "terminar — reach the boundary",
      "headword": "terminar",
      "romanization": "terminar",
      "gloss": "to finish, to end",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:3566605934806959",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Recall el trabajo, the work. Now add the action that brings it to its endpoint: terminar, “to finish” or “to end.”"
            }
          ]
        },
        {
          "index": 1,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Latin termināre meant to set a boundary or bring something to an end. Its base was terminus, a boundary. English term, terminal and terminate keep the same boundary picture. Spanish terminar is the everyday verb: terminar el trabajo, finish the work."
            }
          ]
        },
        {
          "index": 2,
          "type": "grammar",
          "title": "Grammar Lens: the regular -ar frame",
          "segments": [
            {
              "kind": "speech",
              "text": "For “I finish,” remove -ar and add -o: termino. After another verb, keep the infinitive: quiero terminar. Hear the difference between a plan and a completed statement: quiero terminar / termino."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "terminar",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *terminar*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "terminar el trabajo",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *terminar el trabajo*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "quiero terminar",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *quiero terminar*]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "To finish? (Terminar.)"
            },
            {
              "kind": "speech",
              "text": "Source: DLE: terminar."
            }
          ]
        }
      ]
    },
    {
      "id": "ES-C409-preparar",
      "sequence": 9290,
      "title": "preparar — make ready beforehand",
      "headword": "preparar",
      "romanization": "preparar",
      "gloss": "to prepare",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:fb6490909a05ce59",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Recall el postre, dessert. Before it is served, someone has to make it ready: preparar un postre, “to prepare a dessert.” You can terminar a task; first you may need to preparar its parts."
            }
          ]
        },
        {
          "index": 1,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Latin praeparāre joined prae, “before,” to parāre, “make ready.” Spanish preparar and English prepare preserve that family almost unchanged. The older verb parar is visible inside, but do not translate the modern compound as “pre-stop”: use the whole word, “prepare.”"
            }
          ]
        },
        {
          "index": 2,
          "type": "grammar",
          "title": "Grammar Lens: prepare a thing or prepare to act",
          "segments": [
            {
              "kind": "speech",
              "text": "Use a noun directly: preparar un postre. Before another action, Spanish can use prepararse para; this lesson keeps the simpler A1 object frame."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "preparar",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *preparar*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "preparar un postre",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *preparar un postre*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "me gusta preparar postres",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *me gusta preparar postres*]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "To prepare? (Preparar.)"
            },
            {
              "kind": "speech",
              "text": "Source: DLE: preparar."
            }
          ]
        }
      ]
