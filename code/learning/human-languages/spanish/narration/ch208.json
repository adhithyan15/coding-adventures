            },
            {
              "kind": "speech",
              "text": "Which form follows si here? (The supposing form — tuviera.) Which follows the comma? (The -ría form.)"
            },
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
