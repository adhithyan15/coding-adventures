          "segments": [
            {
              "kind": "speech",
              "text": "altrimenti is built from altro \"other\" and the adverb ending -mente (EtymDB); altro is inherited from Latin alter \"the other\", and -mente from mēns, mentis \"mind\": \"in another way\"."
            }
