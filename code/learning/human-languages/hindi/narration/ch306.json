              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *akāl*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "akāl kī vajah yah thī ki us sāl bāriś nahīṃ huī. — The reason for the famine was that the rains failed that year.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *akāl kī vajah yah thī ki us sāl bāriś nahīṃ huī.* — The reason for the famine was that the rains failed that year.]"
            },
            {
              "kind": "prompt",
