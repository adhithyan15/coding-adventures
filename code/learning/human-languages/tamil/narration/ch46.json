              "action": "SAY",
              "instruction": "āsiriyar",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *āsiriyar*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "it once more, slowly",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: it once more, slowly]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "āsiriyar, then naṇbar, and hear the same ending on both",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *āsiriyar*, then *naṇbar*, and hear the same ending on both]"
            }
          ]
        },
        {
