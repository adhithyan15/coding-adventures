            },
            {
              "kind": "speech",
              "text": "The past they ending for -er and -ir? (-ieron, for both.)"
            },
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Which families lose the present-past distinction in the we form? (-ar and -ir — only -er keeps it.)"
            }
          ]
        }
