          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Leinwand is inherited from Middle High German līnwāt \"linen\" (EtymDB), built on lein \"flax\" and wāt \"cloth\"; the second part was later reshaped like Wand \"wall\"."
            }
          ]
        },
