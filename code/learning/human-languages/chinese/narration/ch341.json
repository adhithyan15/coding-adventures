    {
      "id": "ZH-W341-bing-cake",
      "sequence": 26205,
      "title": "饼 (bǐng) — the food piece, then two bars and two legs",
      "headword": "饼",
      "romanization": "bǐng",
      "gloss": "饼 — the food piece of 饭, then two dots, two bars and two downstrokes",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:b91aa55afc0c4ad7",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — the food piece, then two bars and two legs",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — the food piece, then two bars and two legs and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say yuèbǐng — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *yuèbǐng* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "饭 月."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — fàn, yuè",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *fàn*, *yuè*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — the food piece, then two bars and two legs",
          "segments": [
            {
              "kind": "speech",
              "text": "饼 (bǐng)."
            },
            {
              "kind": "speech",
              "text": "Two pieces, left before right."
            },
            {
              "kind": "speech",
              "text": "The left piece, the food piece, three strokes, as in 饭: a stroke falling to the left, a short bar that turns down to the left, then a vertical that flicks up to the right."
            },
            {
              "kind": "speech",
              "text": "The right piece, six strokes. Two short strokes on top, the left one a dot, the right one falling to the left. Two bars, the lower one longer. Then a stroke down the left that falls away to the left, and a vertical down the right."
            },
            {
              "kind": "speech",
              "text": "3 + 6 = nine."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "饼 (bǐng), all nine, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 饼, all nine, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many strokes in 饼 (bǐng)? (Nine.) Where have you met the left piece? (On the left of 饭.) How many bars on the right? (Two.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 饼 (bǐng), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
