          "segments": [
            {
              "kind": "speech",
              "text": "clādēs, clādis — \"a defeat, a disaster\"."
            },
            {
              "kind": "speech",
              "text": "Post clādem paucī mīlitēs in castra rediērunt. After the defeat few soldiers returned to the camp."
            },
            {
              "kind": "speech",
              "text": "Feminine, 3rd declension. A heavy defeat with great loss of life."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "clādēs is usually traced to a root meaning \"to beat, to break\": EtymDB gives a Proto-Indo-European root of that sense, and Lewis & Short compare Greek klaō, \"to break\". The details are not settled."
            }
          ]
        },
