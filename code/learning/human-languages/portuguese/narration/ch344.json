          "segments": [
            {
              "kind": "speech",
              "text": "o juízo — \"the judgement; good sense\"."
            },
            {
              "kind": "speech",
              "text": "Ele tem pouco juízo: conduz depressa demais. He has little sense: he drives too fast."
            },
            {
              "kind": "speech",
              "text": "Ter juízo — to be sensible; perder o juízo — to lose your mind."
            }
          ]
        },
