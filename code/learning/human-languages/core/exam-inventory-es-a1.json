{
  "version": 1,
  "language": "spanish",
  "level": "A1",
  "about": "An enumeration of the grammar an A1 candidate is expected to hold, restated in our own words from the structure of the Plan Curricular del Instituto Cervantes, whose grammar inventory is published as a finite checklist in 15 categories with separate A1 and A2 columns. This file is an independent restatement for gating purposes, not a copy: the source is a reference, and the labels here are ours. Where the source lists several closely related items we have merged them into one point, so this file's total is not the source's total.",
  "source": "https://cvc.cervantes.es/ensenanza/biblioteca_ele/plan_curricular/niveles/02_gramatica_inventario_a1-a2.htm",
  "probeSemantics": "A point counts as COVERED when every atom in `probe` is introduced by some lesson in the track. `probe: null` means no atom in the corpus corresponds to this point, which is itself the finding — an unmapped point is uncovered, never skipped.",
  "points": [
    { "id": "A1-N-01", "category": "El sustantivo", "label": "proper nouns: personal names, forms of address, place names", "probe": null, "note": "Forms of address are taught (tu/usted, ch5) but as pronouns, not as the noun class." },
    { "id": "A1-N-02", "category": "El sustantivo", "label": "common nouns naming periods of time", "probe": ["ES-LEX-DIA", "ES-LEX-NOCHE", "ES-LEX-TARDE", "ES-LEX-WEEKDAYS-01", "ES-LEX-MONTHS-01", "ES-LEX-SEASONS-01"] },
    { "id": "A1-N-03", "category": "El sustantivo", "label": "gender: masculine in -o, feminine in -a", "probe": ["ES-GRAMMAR-NOUN-GENDER"] },
    { "id": "A1-N-04", "category": "El sustantivo", "label": "gender by heteronymy (padre/madre)", "probe": ["ES-LEX-PARENTS-01"] },
    { "id": "A1-N-05", "category": "El sustantivo", "label": "number: plural in -s after a vowel, -es after a consonant", "probe": ["ES-GRAMMAR-NOUN-NUMBER", "ES-GRAMMAR-NOUN-PLURAL-ES"] },

    { "id": "A1-ADJ-01", "category": "El adjetivo", "label": "qualifying adjectives in attributive and predicative use", "probe": ["ES-LEX-GRANDE", "ES-GRAMMAR-ADJECTIVE-AFTER-NOUN"] },
    { "id": "A1-ADJ-02", "category": "El adjetivo", "label": "relational adjectives: common gentilics", "probe": ["ES-LEX-ESPANOL"] },
    { "id": "A1-ADJ-03", "category": "El adjetivo", "label": "adjective gender: -o/-a", "probe": ["ES-MORPH-BUENO-BUENA"] },
    { "id": "A1-ADJ-04", "category": "El adjetivo", "label": "adjective number and agreement in the plural", "probe": ["ES-GRAMMAR-AGREEMENT-MASCULINE-PLURAL", "ES-GRAMMAR-AGREEMENT-FEMININE-PLURAL"] },
    { "id": "A1-ADJ-05", "category": "El adjetivo", "label": "position: postnominal, restrictive", "probe": ["ES-GRAMMAR-ADJECTIVE-AFTER-NOUN"] },
    { "id": "A1-ADJ-06", "category": "El adjetivo", "label": "degree: absolute superlative with muy", "probe": null, "note": "muy is not taught anywhere in the track." },

    { "id": "A1-ART-01", "category": "El articulo", "label": "definite article: el, la, los, las", "probe": ["ES-GRAMMAR-DEFINITE-ARTICLES", "ES-GRAMMAR-DEFINITE-PLURAL-MASCULINE", "ES-GRAMMAR-DEFINITE-PLURAL-FEMININE"] },
    { "id": "A1-ART-02", "category": "El articulo", "label": "contractions al and del", "probe": null },
    { "id": "A1-ART-03", "category": "El articulo", "label": "indefinite article: un, una, unos, unas", "probe": null, "note": "Singular un/una are taught at ch3; plural unos/unas are not taught." },
    { "id": "A1-ART-04", "category": "El articulo", "label": "absence of the article: bare nouns", "probe": ["ES-GRAMMAR-BARE-LANGUAGE", "ES-GRAMMAR-BARE-PROFESSION", "ES-GRAMMAR-BARE-PLURAL-NOUN"] },

    { "id": "A1-DEM-01", "category": "Los demostrativos", "label": "forms: este, ese, aquel and their neuters", "probe": null },
    { "id": "A1-DEM-02", "category": "Los demostrativos", "label": "spatial deixis: near, mid, far", "probe": null },
    { "id": "A1-DEM-03", "category": "Los demostrativos", "label": "position: prenominal, incompatible with the article", "probe": null },

    { "id": "A1-POS-01", "category": "Los posesivos", "label": "unstressed possessives, one possessor: mi, tu, su", "probe": ["ES-LEX-POSSESSIVES-MI-TU-SU"] },
    { "id": "A1-POS-02", "category": "Los posesivos", "label": "unstressed possessives, several possessors: nuestro, vuestro", "probe": null, "note": "nuestro is taught at ch69; vuestro is not taught." },
    { "id": "A1-POS-03", "category": "Los posesivos", "label": "distribution: prenominal, cannot stand alone", "probe": ["ES-GRAMMAR-POSSESSIVE-BEFORE-NOUN"] },

    { "id": "A1-Q-01", "category": "Los cuantificadores", "label": "cardinal numerals", "probe": ["ES-LEX-NUMBERS-1-5", "ES-LEX-NUMBERS-6-10", "ES-LEX-NUMBERS-11-15-01", "ES-LEX-NUMBERS-16-19-03", "ES-LEX-VEINTE-06"] },
    { "id": "A1-Q-02", "category": "Los cuantificadores", "label": "ordinal numerals to tenth", "probe": null },
    { "id": "A1-Q-03", "category": "Los cuantificadores", "label": "poco and mucho, with gender and number variation", "probe": null, "note": "Both words are taught (ch6, ch220) but their agreement is not." },
    { "id": "A1-Q-04", "category": "Los cuantificadores", "label": "bastante", "probe": null },

    { "id": "A1-PRON-01", "category": "El pronombre", "label": "subject pronouns: the full paradigm", "probe": ["ES-LEX-TU", "ES-LEX-USTED", "ES-LEX-EL-PRONOUN", "ES-LEX-NOSOTROS", "ES-LEX-VOSOTROS", "ES-LEX-USTEDES"] },
    { "id": "A1-PRON-02", "category": "El pronombre", "label": "unstressed direct-object pronouns", "probe": ["ES-GRAMMAR-DIRECT-OBJECT-LO", "ES-GRAMMAR-DIRECT-OBJECT-LA", "ES-GRAMMAR-DIRECT-OBJECT-PLURAL"] },
    { "id": "A1-PRON-03", "category": "El pronombre", "label": "unstressed indirect-object pronoun with gustar", "probe": ["ES-GRAMMAR-GUSTAR-INVERSION-09", "ES-LEX-ME"] },
    { "id": "A1-PRON-04", "category": "El pronombre", "label": "reflexive se", "probe": ["ES-GRAMMAR-REFLEXIVE-THIRD-PERSON"] },
    { "id": "A1-PRON-05", "category": "El pronombre", "label": "relative que with an overt antecedent", "probe": ["ES-GRAMMAR-RELATIVE-QUE"] },
    { "id": "A1-PRON-06", "category": "El pronombre", "label": "interrogative pronouns: que, quien, cuanto", "probe": null, "note": "que and cuantos are taught; quien is not." },
    { "id": "A1-PRON-07", "category": "El pronombre", "label": "exclamative que with adjectives and adverbs", "probe": null, "note": "The inverted exclamation mark is taught at ch11; the construction is not." },
    { "id": "A1-PRON-08", "category": "El pronombre", "label": "stressed pronouns after a preposition: mi, ti, el", "probe": null },

    { "id": "A1-ADV-01", "category": "El adverbio", "label": "place deictics: aqui, ahi, alli", "probe": null, "note": "aqui is taught at ch12; ahi and alli are not." },
    { "id": "A1-ADV-02", "category": "El adverbio", "label": "time deictics: ahora, hoy, manana", "probe": null, "note": "manana is taught at ch13; ahora and hoy are not." },
    { "id": "A1-ADV-03", "category": "El adverbio", "label": "quantity adverbs: poco, mucho, bastante", "probe": null, "note": "bastante is not taught." },
    { "id": "A1-ADV-04", "category": "El adverbio", "label": "manner adverbs: bien, mal", "probe": null, "note": "bien is taught at ch1; mal is not." },
    { "id": "A1-ADV-05", "category": "El adverbio", "label": "polarity adverbs: si, no", "probe": ["ES-LEX-SI-01", "ES-LEX-NO-01"] },
    { "id": "A1-ADV-06", "category": "El adverbio", "label": "connective adverbs: tambien, tampoco", "probe": ["ES-LEX-TAMBIEN", "ES-LEX-TAMPOCO"] },
    { "id": "A1-ADV-07", "category": "El adverbio", "label": "interrogative adverbs: donde, como", "probe": ["ES-LEX-DONDE", "ES-LEX-COMO"] },
    { "id": "A1-ADV-08", "category": "El adverbio", "label": "por que against porque", "probe": ["ES-LEX-PORQUE-03", "ES-GRAMMAR-PORQUE-THREE-05"] },

    { "id": "A1-V-01", "category": "El verbo", "label": "present indicative: the regular paradigm, all persons", "probe": ["ES-GRAMMAR-PRESENT-INDICATIVE-COMPLETE"] },
    { "id": "A1-V-02", "category": "El verbo", "label": "present indicative: ser, estar, haber, ir", "probe": ["ES-GRAMMAR-SER-PRESENT-COMPLETE", "ES-GRAMMAR-ESTAR-PRESENT-COMPLETE", "ES-LEX-HABER", "ES-GRAMMAR-IR-VERB-PRESENT-3PL"] },
    { "id": "A1-V-03", "category": "El verbo", "label": "present indicative: actual and durative values", "probe": null },
    { "id": "A1-V-04", "category": "El verbo", "label": "imperfect: regular forms and ser, ir, ver", "probe": null, "note": "Only the singular is taught (ch107, ch109); the plural of the imperfect is absent." },
    { "id": "A1-V-05", "category": "El verbo", "label": "imperfect: description and habitual aspect", "probe": ["ES-GRAMMAR-IMPERFECT-ONGOING-HABITUAL", "ES-GRAMMAR-ASPECT-NOT-TIME"] },
    { "id": "A1-V-06", "category": "El verbo", "label": "preterite: the regular paradigm, all persons", "probe": null, "note": "Five of six persons are taught; the vosotros forms are owed (HL-C127)." },
    { "id": "A1-V-07", "category": "El verbo", "label": "preterite: strong stems (tener, hacer, estar)", "probe": ["ES-GRAMMAR-STRONG-PRETERITE-SINGULAR-PATTERN", "ES-GRAMMAR-STRONG-PRETERITE-PLURAL"] },
    { "id": "A1-V-08", "category": "El verbo", "label": "preterite: ser, ir, ver, dar", "probe": null, "note": "ser and ir are taught (ch103, ch203); ver and dar are not." },
    { "id": "A1-V-09", "category": "El verbo", "label": "present perfect: haber plus participle", "probe": ["ES-GRAMMAR-PERFECT-COMPLETE"] },
    { "id": "A1-V-10", "category": "El verbo", "label": "irregular past participles", "probe": ["ES-GRAMMAR-IRREGULAR-PARTICIPLES"] },
    { "id": "A1-V-11", "category": "El verbo", "label": "affirmative imperative, second person, with its irregulars", "probe": ["ES-GRAMMAR-COMMAND-TU-AFFIRMATIVE", "ES-GRAMMAR-COMMAND-IRREGULAR-EIGHT"] },
    { "id": "A1-V-12", "category": "El verbo", "label": "the infinitive as a non-finite form", "probe": ["ES-GRAMMAR-NEAR-FUTURE-IR-A-INFINITIVE"] },
    { "id": "A1-V-13", "category": "El verbo", "label": "the gerund", "probe": null, "note": "The gerund is not taught anywhere in the track." },
    { "id": "A1-V-14", "category": "El verbo", "label": "the regular past participle", "probe": ["ES-GRAMMAR-PAST-PARTICIPLE"] },

    { "id": "A1-SN-01", "category": "El sintagma nominal", "label": "noun-phrase complements: adjective, de-phrase, relative clause", "probe": ["ES-GRAMMAR-ADJECTIVE-AFTER-NOUN", "ES-LEX-DE", "ES-GRAMMAR-RELATIVE-QUE"] },
    { "id": "A1-SN-02", "category": "El sintagma nominal", "label": "agreement inside the noun phrase", "probe": ["ES-GRAMMAR-AGREEMENT-MASCULINE-PLURAL", "ES-GRAMMAR-AGREEMENT-FEMININE-PLURAL"] },
    { "id": "A1-SN-03", "category": "El sintagma nominal", "label": "subject-verb agreement as a stated rule", "probe": null },
    { "id": "A1-SN-04", "category": "El sintagma nominal", "label": "the vocative", "probe": null },

    { "id": "A1-SADJ-01", "category": "El sintagma adjetival", "label": "degree modifiers: muy, poco, bastante", "probe": null, "note": "None of the three is taught as a degree modifier." },

    { "id": "A1-SV-01", "category": "El sintagma verbal", "label": "gustar and its argument structure", "probe": ["ES-GRAMMAR-GUSTAR-INVERSION-09"] },
    { "id": "A1-SV-02", "category": "El sintagma verbal", "label": "copular ser and estar", "probe": ["ES-GRAMMAR-SER-ESTAR-CONTRAST"] },
    { "id": "A1-SV-03", "category": "El sintagma verbal", "label": "the attribute and its agreement", "probe": ["ES-GRAMMAR-SER-IDENTITY", "ES-GRAMMAR-STATE-LOCATION-ESTAR"] },
    { "id": "A1-SV-04", "category": "El sintagma verbal", "label": "direct object: people take the preposition a, things do not", "probe": null, "note": "The personal a is not taught." },
    { "id": "A1-SV-05", "category": "El sintagma verbal", "label": "indirect object, pronominal and prepositional", "probe": ["ES-GRAMMAR-INDIRECT-OBJECT-LE", "ES-GRAMMAR-INDIRECT-OBJECT-PLURAL"] },
    { "id": "A1-SV-06", "category": "El sintagma verbal", "label": "circumstantial complements and word-order flexibility", "probe": null },

    { "id": "A1-OS-01", "category": "La oracion simple", "label": "declaratives, affirmative and negative", "probe": ["ES-GRAMMAR-NO-02"] },
    { "id": "A1-OS-02", "category": "La oracion simple", "label": "yes-or-no questions", "probe": ["ES-SCRIPT-INVERTED-QUESTION"] },
    { "id": "A1-OS-03", "category": "La oracion simple", "label": "questions with an asking word", "probe": ["ES-GRAMMAR-QUESTION-ACCENT", "ES-LEX-DONDE"] },
    { "id": "A1-OS-04", "category": "La oracion simple", "label": "impersonal sentences with haber", "probe": ["ES-LEX-HAY", "ES-GRAMMAR-HAY-NO-AGREEMENT"] },
    { "id": "A1-OS-05", "category": "La oracion simple", "label": "copulative and attributive sentences", "probe": ["ES-GRAMMAR-SER-IDENTITY"] },
    { "id": "A1-OS-06", "category": "La oracion simple", "label": "transitive and intransitive sentences", "probe": ["ES-GRAMMAR-DIRECT-OBJECT-LO"] },

    { "id": "A1-CO-01", "category": "Coordinacion", "label": "copulative coordination with y", "probe": ["ES-LEX-Y"] },
    { "id": "A1-CO-02", "category": "Coordinacion", "label": "negative coordination with ni", "probe": null },
    { "id": "A1-CO-03", "category": "Coordinacion", "label": "disjunctive coordination with o", "probe": null, "note": "o appears in a chapter-5 headword but is never taught as a coordinator." },
    { "id": "A1-CO-04", "category": "Coordinacion", "label": "adversative coordination with pero", "probe": ["ES-LEX-PERO"] },
    { "id": "A1-CO-05", "category": "Coordinacion", "label": "distributive coordination: uno... otro", "probe": null },

    { "id": "A1-SUB-01", "category": "Subordinacion", "label": "infinitive clause as subject", "probe": null },
    { "id": "A1-SUB-02", "category": "Subordinacion", "label": "infinitive clause as direct object", "probe": ["ES-GRAMMAR-WANT-ONE-TWO-SUBJECT-CONTRAST"] },
    { "id": "A1-SUB-03", "category": "Subordinacion", "label": "finite clause as direct object, with creer", "probe": ["ES-LEX-CREER-01", "ES-GRAMMAR-REPORTED-QUE-OBLIGATORY"] },
    { "id": "A1-SUB-04", "category": "Subordinacion", "label": "restrictive relative clause with an expressed antecedent", "probe": ["ES-GRAMMAR-RELATIVE-QUE"] },
    { "id": "A1-SUB-05", "category": "Subordinacion", "label": "que as relative subject and direct object", "probe": ["ES-GRAMMAR-RELATIVE-QUE", "ES-GRAMMAR-RELATIVE-QUE-OBLIGATORY"] },
    { "id": "A1-SUB-06", "category": "Subordinacion", "label": "causal clauses", "probe": ["ES-LEX-PORQUE-03"] },
    { "id": "A1-SUB-07", "category": "Subordinacion", "label": "purpose clauses with para plus infinitive", "probe": ["ES-LEX-PARA", "ES-GRAMMAR-PARA-FORWARD"] },
    { "id": "A1-SUB-08", "category": "Subordinacion", "label": "simultaneity with cuando", "probe": ["ES-LEX-CUANDO"] }
  ]
}
