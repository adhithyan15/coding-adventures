        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: अभियंता",
          "segments": [
            {
              "kind": "speech",
              "text": "अभियंता — abhiyantā — \"an engineer\"."
            },
            {
              "kind": "speech",
              "text": "माझी मावशी अभियंता आहे आणि पूल बांधते. mājhī māvśī abhiyantā āhe āṇi pūl bāndhte. My aunt is an engineer and builds bridges."
            },
            {
              "kind": "speech",
              "text": "Masculine."
            },
            {
              "kind": "speech",
              "text": "One word for a man or a woman."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "अभियंता (abhiyantā) is a modern Marathi coinage built from Sanskrit parts: abhi-, \"towards\", and yantṛ, \"one who guides or restrains\", related to yantra, \"a machine\" (Monier-Williams)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for describing what you lived and felt."
            }
          ]
        },
        {
