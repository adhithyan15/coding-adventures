        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: das Freibad",
          "segments": [
            {
              "kind": "speech",
              "text": "das Freibad — \"open-air pool\"."
            },
            {
              "kind": "speech",
              "text": "Im Sommer gehen wir jeden Tag ins Freibad. In summer we go to the open-air pool every day."
            },
            {
              "kind": "speech",
              "text": "Plural: die Freibäder. An indoor pool is das Hallenbad."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Freibad is built on frei \"free, open\" and Bad \"bath\", inherited from Old High German bad, from Proto-Germanic baþą (EtymDB)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
