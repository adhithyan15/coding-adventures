        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: سر و صدا",
          "segments": [
            {
              "kind": "speech",
              "text": "سر و صدا (sar-o sedâ) — \"noise, a din\"."
            },
            {
              "kind": "speech",
              "text": "اتاق ما شب پر از سر و صدا بود. Otâq-e mâ shab por az sar-o sedâ bud. Our room was full of noise at night."
            },
            {
              "kind": "speech",
              "text": "Sar-o sedâ kardan — to make a racket. Also a fuss: sar-o sedâ-ye ziyâdi kard — it caused a stir."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "sar-o sedâ is a pair of native sar 'head', from Middle Persian sar (EtymDB), and sedâ 'sound', which EtymDB takes from Arabic ṣadā 'echo'."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
            }
          ]
        },
