      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new run of words: what did chūlhā mean, and what did tavā mean?"
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: रस्सी",
          "segments": [
            {
              "kind": "speech",
              "text": "रस्सी (rassī) — \"a rope\"."
            },
            {
              "kind": "speech",
              "text": "From Sanskrit रश्मि (raśmi), which meant a cord or a rein — and also a ray of the sun. One word held both, because a ray was pictured as a thread let down from the sky."
            },
            {
              "kind": "speech",
              "text": "Hindi kept the thread and let the light go: रस्सी (rassī) is plain rope, the kind that draws a bucket up out of the ground. The bright half of रश्मि survives in names and in poetry, so the two halves of the old word now live in different registers."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "The first of five things hands work with."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "rassī",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *rassī*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "it once more, slowly",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: it once more, slowly]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "rassī, then sūraj, and say what the old word held in common",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *rassī*, then *sūraj*, and say what the old word held in common]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What does रस्सी (rassī) mean? (\"a rope\".) Say it once more."
            }
          ]
        }
      ]
    },
