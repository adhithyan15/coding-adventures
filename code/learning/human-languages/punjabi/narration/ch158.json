          "segments": [
            {
              "kind": "speech",
              "text": "Imagine familiar food at a stall. Say only the old Punjabi describing word; the English scenes do not add a Punjabi noun to learn."
            },
            {
              "kind": "speech",
              "text": "Food left too long is stale."
            },
            {
              "kind": "pause",
              "seconds": 4,
              "perItem": false,
              "source": "[PAUSE 4s]"
            },
            {
              "kind": "speech",
              "text": "ਬੇਹਾ (behā)."
            },
            {
              "kind": "speech",
              "text": "Fruit ready to eat is ripe."
            },
            {
              "kind": "pause",
              "seconds": 4,
              "perItem": false,
              "source": "[PAUSE 4s]"
            },
            {
              "kind": "speech",
              "text": "ਪੱਕਾ (pakkā)."
            },
            {
              "kind": "speech",
              "text": "Fruit not yet ripe is unripe."
            },
            {
              "kind": "pause",
              "seconds": 4,
              "perItem": false,
              "source": "[PAUSE 4s]"
            },
            {
              "kind": "speech",
              "text": "ਕੱਚਾ (kaccā)."
            },
            {
              "kind": "speech",
              "text": "The words already carried these meanings when first taught. Pakkā can also mean firm; kaccā can also mean raw. Do not add a new sense from this review."
            }
          ]
        },
