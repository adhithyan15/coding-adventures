// VentureChrome — light native chrome theme.

style VentureChrome {
  part app-shell {
    background : "#f3f0e8" ;
    color : "#211f1b" ;
    font-family : "-apple-system, Segoe UI, system-ui, sans-serif" ;
    gap : 0 ;
  }
  part title-bar {
    background : "#ded8ca" ;
    padding : 8 ;
    gap : 12 ;
    align : center-vertical ;
    border-bottom-width : 1 ;
    border-bottom-color : "#b9b09f" ;
  }
  part brand {
    color : "#6d3d13" ;
    font-size : 15 ;
    font-weight : bold ;
  }
  part page-title {
    color : "#39342d" ;
    font-size : 13 ;
  }
  part toolbar {
    background : "#ece7dc" ;
    padding : 8 ;
    gap : 6 ;
    align : center-vertical ;
    border-bottom-width : 1 ;
    border-bottom-color : "#c8c0b1" ;
  }
  part page-actions {
    background : "#e4ded1" ;
    padding : 8 ;
    gap : 6 ;
    align : center-vertical ;
    border-bottom-width : 1 ;
    border-bottom-color : "#c8c0b1" ;
  }
  part back-button {
    background : "#fffdf8" ; color : "#39342d" ; padding : 7 ; border-radius : 5 ; border-width : 1 ; border-color : "#b9b09f" ;
    state hover { background : "#f7e6c7" ; }
    state pressed { background : "#e8c98f" ; }
    state focused { outline-color : "#9a5b18" ; outline-width : 2 ; }
    state disabled { opacity : 0.45 ; }
  }
  part forward-button {
    background : "#fffdf8" ; color : "#39342d" ; padding : 7 ; border-radius : 5 ; border-width : 1 ; border-color : "#b9b09f" ;
    state hover { background : "#f7e6c7" ; }
    state pressed { background : "#e8c98f" ; }
    state focused { outline-color : "#9a5b18" ; outline-width : 2 ; }
    state disabled { opacity : 0.45 ; }
  }
  part home-button {
    background : "#fffdf8" ; color : "#39342d" ; padding : 7 ; border-radius : 5 ; border-width : 1 ; border-color : "#b9b09f" ;
    state hover { background : "#f7e6c7" ; }
    state pressed { background : "#e8c98f" ; }
    state focused { outline-color : "#9a5b18" ; outline-width : 2 ; }
  }
  part reload-button {
    background : "#fffdf8" ; color : "#39342d" ; padding : 7 ; border-radius : 5 ; border-width : 1 ; border-color : "#b9b09f" ;
    state hover { background : "#f7e6c7" ; }
    state pressed { background : "#e8c98f" ; }
    state focused { outline-color : "#9a5b18" ; outline-width : 2 ; }
    state disabled { opacity : 0.45 ; }
  }
  part bookmark-button {
    background : "#fffdf8" ; color : "#39342d" ; padding : 7 ; border-radius : 5 ; border-width : 1 ; border-color : "#b9b09f" ;
    state hover { background : "#f7e6c7" ; }
    state pressed { background : "#e8c98f" ; }
    state focused { outline-color : "#9a5b18" ; outline-width : 2 ; }
    state disabled { opacity : 0.45 ; }
  }
  part copy-address-button {
    background : "#fffdf8" ; color : "#39342d" ; padding : 7 ; border-radius : 5 ; border-width : 1 ; border-color : "#b9b09f" ;
    state hover { background : "#f7e6c7" ; }
    state pressed { background : "#e8c98f" ; }
    state focused { outline-color : "#9a5b18" ; outline-width : 2 ; }
    state disabled { opacity : 0.45 ; }
  }
  part open-page-button {
    background : "#fffdf8" ; color : "#39342d" ; padding : 7 ; border-radius : 5 ; border-width : 1 ; border-color : "#b9b09f" ;
    state hover { background : "#f7e6c7" ; }
    state pressed { background : "#e8c98f" ; }
    state focused { outline-color : "#9a5b18" ; outline-width : 2 ; }
    state disabled { opacity : 0.45 ; }
  }
  part save-page-button {
    background : "#fffdf8" ; color : "#39342d" ; padding : 7 ; border-radius : 5 ; border-width : 1 ; border-color : "#b9b09f" ;
    state hover { background : "#f7e6c7" ; }
    state pressed { background : "#e8c98f" ; }
    state focused { outline-color : "#9a5b18" ; outline-width : 2 ; }
    state disabled { opacity : 0.45 ; }
  }
  part print-page-button {
    background : "#fffdf8" ; color : "#39342d" ; padding : 7 ; border-radius : 5 ; border-width : 1 ; border-color : "#b9b09f" ;
    state hover { background : "#f7e6c7" ; }
    state pressed { background : "#e8c98f" ; }
    state focused { outline-color : "#9a5b18" ; outline-width : 2 ; }
    state disabled { opacity : 0.45 ; }
  }
  part share-page-button {
    background : "#fffdf8" ; color : "#39342d" ; padding : 7 ; border-radius : 5 ; border-width : 1 ; border-color : "#b9b09f" ;
    state hover { background : "#f7e6c7" ; }
    state pressed { background : "#e8c98f" ; }
    state focused { outline-color : "#9a5b18" ; outline-width : 2 ; }
    state disabled { opacity : 0.45 ; }
  }
  part page-info-button {
    background : "#fffdf8" ; color : "#39342d" ; padding : 7 ; border-radius : 5 ; border-width : 1 ; border-color : "#b9b09f" ;
    state hover { background : "#f7e6c7" ; }
    state pressed { background : "#e8c98f" ; }
    state focused { outline-color : "#9a5b18" ; outline-width : 2 ; }
    state disabled { opacity : 0.45 ; }
  }
  part page-info-panel { background : "#fffaf0" ; color : "#211f1b" ; padding : 10 ; gap : 6 ; border-bottom-width : 1 ; border-bottom-color : "#c8c0b1" ; }
  part page-info-header { gap : 12 ; align : center-vertical ; }
  part page-info-heading { color : "#6d3d13" ; font-size : 14 ; font-weight : bold ; flex-grow : 1 ; }
  part page-info-close-button { background : "#fffdf8" ; color : "#39342d" ; padding : 6 ; border-radius : 5 ; border-width : 1 ; border-color : "#b9b09f" ; }
  part page-info-title-row { gap : 8 ; }
  part page-info-address-row { gap : 8 ; }
  part page-info-requested-row { gap : 8 ; }
  part page-info-status-row { gap : 8 ; }
  part page-info-resources-row { gap : 8 ; }
  part page-info-title-label { color : "#6d6559" ; font-weight : bold ; }
  part page-info-address-label { color : "#6d6559" ; font-weight : bold ; }
  part page-info-requested-label { color : "#6d6559" ; font-weight : bold ; }
  part page-info-status-label { color : "#6d6559" ; font-weight : bold ; }
  part page-info-resources-label { color : "#6d6559" ; font-weight : bold ; }
  part zoom-out-button {
    background : "#fffdf8" ; color : "#39342d" ; padding : 7 ; border-radius : 5 ; border-width : 1 ; border-color : "#b9b09f" ;
    state hover { background : "#f7e6c7" ; } state pressed { background : "#e8c98f" ; } state focused { outline-color : "#9a5b18" ; outline-width : 2 ; } state disabled { opacity : 0.45 ; }
  }
  part zoom-reset-button {
    background : "#fffdf8" ; color : "#39342d" ; padding : 7 ; border-radius : 5 ; border-width : 1 ; border-color : "#b9b09f" ;
    state hover { background : "#f7e6c7" ; } state pressed { background : "#e8c98f" ; } state focused { outline-color : "#9a5b18" ; outline-width : 2 ; } state disabled { opacity : 0.45 ; }
  }
  part zoom-in-button {
    background : "#fffdf8" ; color : "#39342d" ; padding : 7 ; border-radius : 5 ; border-width : 1 ; border-color : "#b9b09f" ;
    state hover { background : "#f7e6c7" ; } state pressed { background : "#e8c98f" ; } state focused { outline-color : "#9a5b18" ; outline-width : 2 ; } state disabled { opacity : 0.45 ; }
  }
  part view-source-button {
    background : "#fffdf8" ; color : "#39342d" ; padding : 7 ; border-radius : 5 ; border-width : 1 ; border-color : "#b9b09f" ;
    state hover { background : "#f7e6c7" ; }
    state pressed { background : "#e8c98f" ; }
    state focused { outline-color : "#9a5b18" ; outline-width : 2 ; }
    state disabled { opacity : 0.45 ; }
  }
  part view-source-panel { background : "#f6f1e7" ; color : "#211f1b" ; padding : 10 ; gap : 7 ; border-bottom-width : 1 ; border-bottom-color : "#c8c0b1" ; }
  part view-source-header { gap : 12 ; align : center-vertical ; }
  part view-source-heading { color : "#6d3d13" ; font-size : 14 ; font-weight : bold ; flex-grow : 1 ; }
  part view-source-close-button { background : "#fffdf8" ; color : "#39342d" ; padding : 6 ; border-radius : 5 ; border-width : 1 ; border-color : "#b9b09f" ; }
  part view-source-title { color : "#39342d" ; font-weight : bold ; }
  part view-source-address { color : "#6d6559" ; font-family : monospace ; font-size : 11 ; }
  part view-source-content { background : "#ffffff" ; color : "#211f1b" ; padding : 10 ; border-width : 1 ; border-color : "#c8c0b1" ; font-family : monospace ; font-size : 11 ; height : 180 ; max-width : 960 ; overflow : auto ; }
  part address-input {
    background : "#ffffff" ; color : "#211f1b" ; padding : 7 ; border-radius : 5 ; border-width : 1 ; border-color : "#aaa08e" ; flex-grow : 1 ;
    state focused { border-color : "#9a5b18" ; outline-color : "#9a5b18" ; outline-width : 1 ; }
  }
  part go-button {
    background : "#9a5b18" ; color : "#ffffff" ; padding : 7 ; border-radius : 5 ; border-width : 1 ; border-color : "#74400e" ;
    state hover { background : "#ad6b24" ; }
    state pressed { background : "#74400e" ; }
    state focused { outline-color : "#56300c" ; outline-width : 2 ; }
    state disabled { opacity : 0.45 ; }
  }
  part find-bar { background : "#f6f1e7" ; padding : 6 ; gap : 6 ; align : center-vertical ; border-bottom-width : 1 ; border-bottom-color : "#c8c0b1" ; }
  part find-input { background : "#ffffff" ; color : "#211f1b" ; padding : 6 ; border-radius : 5 ; border-width : 1 ; border-color : "#aaa08e" ; flex-grow : 1 ; }
  part find-result { color : "#5b554b" ; font-size : 11 ; }
  part find-previous-button { background : "#fffdf8" ; color : "#39342d" ; padding : 6 ; border-radius : 5 ; border-width : 1 ; border-color : "#b9b09f" ; state disabled { opacity : 0.45 ; } }
  part find-next-button { background : "#fffdf8" ; color : "#39342d" ; padding : 6 ; border-radius : 5 ; border-width : 1 ; border-color : "#b9b09f" ; state disabled { opacity : 0.45 ; } }
  part find-close-button { background : "#fffdf8" ; color : "#39342d" ; padding : 6 ; border-radius : 5 ; border-width : 1 ; border-color : "#b9b09f" ; }
  part content-surface {
    background : "#ffffff" ;
    min-height : 480 ;
    flex-grow : 1 ;
  }
  part status-bar {
    background : "#ded8ca" ;
    padding : 6 ;
    border-top-width : 1 ;
    border-top-color : "#b9b09f" ;
  }
  part status-text {
    color : "#5b554b" ;
    font-size : 11 ;
  }
}
