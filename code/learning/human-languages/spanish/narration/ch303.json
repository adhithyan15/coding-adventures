      "title": "¿qué significa? — asking for the meaning, not the word",
      "headword": "¿qué significa?",
      "romanization": "¿qué significa?",
      "gloss": "what does it mean — significar is Latin significare, to make a sign",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:4b77b6c9c7ac93e8",
