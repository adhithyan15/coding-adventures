        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: मुद्दाम",
          "segments": [
            {
              "kind": "speech",
              "text": "मुद्दाम — muddām — \"on purpose\"."
            },
            {
              "kind": "speech",
              "text": "मी मुद्दाम उशिरा आलो नाही. mī muddām uśirā ālo nāhī. I did not come late on purpose."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "मुद्दाम (muddām) is a Marathi adverb for something done deliberately; its origin is not settled."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
