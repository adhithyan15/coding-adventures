# @version 1

document = { terminator } HEADER { terminator | statement } EOF ;
terminator = NEWLINE | SEMICOLON ;
statement = ACC_TITLE_STATEMENT | ACC_DESCR_STATEMENT | ACC_DESCR_BLOCK | TITLE_STATEMENT | DATA_BLOCK | NOTE_BLOCK | GWT_BLOCK | frame_statement ;
frame_statement = FRAME_STATEMENT [ DATA_REFERENCE ] ;
