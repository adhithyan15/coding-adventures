          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "favilla is linked by Lewis & Short with a root meaning \"to shine\", seen in Greek phōs, \"light\"; the link is not certain."
            }
          ]
        },
