          "segments": [
            {
              "kind": "speech",
              "text": "borsa is inherited from Late Latin bursa \"a leather bag\", from Greek býrsa \"a hide\"; studio is a learned borrowing from Latin studium \"zeal, eagerness, study\" (Lewis & Short)."
            }
