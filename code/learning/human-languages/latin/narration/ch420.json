        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: cōnstō, cōnstāre",
          "segments": [
            {
              "kind": "speech",
              "text": "cōnstō, cōnstāre — \"to cost; to stand firm; to be agreed\"."
            },
            {
              "kind": "speech",
              "text": "Haec vīlla magnō cōnstitit. This country house cost a great deal."
            },
            {
              "kind": "speech",
              "text": "cōnstō, cōnstāre, cōnstitī. The price is in the ablative: magnō, at a high price, parvō, cheaply. Cōnstat, it is agreed. English cost comes from it through French."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "cōnstō is built from con- and stō \"to stand\" (EtymDB; Lewis & Short): to stand firm, then to stand at a price. English cost comes from it through French."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
