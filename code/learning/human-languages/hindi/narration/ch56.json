        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: सड़क",
          "segments": [
            {
              "kind": "speech",
              "text": "सड़क (saṛak) — \"a road\"."
            },
            {
              "kind": "speech",
              "text": "सड़क (saṛak) is an everyday word with a disputed history; the derivations offered for it do not agree, and none has become standard."
            },
            {
              "kind": "speech",
              "text": "It sits oddly beside the four words after it in this chapter, which are all traceable. A chapter of five words is a fair sample of a language, and one unsettled origin in five is about the honest rate."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "The first of five places along the way."
            }
          ]
        },
