          "segments": [
            {
              "kind": "speech",
              "text": "il cinghiale — \"the wild boar\"."
            },
            {
              "kind": "speech",
              "text": "Di notte i cinghiali scendono in paese. At night the boars come down into the village."
            },
            {
              "kind": "speech",
              "text": "Common in the hills, and a popular sauce for pasta."
            }
          ]
        },
