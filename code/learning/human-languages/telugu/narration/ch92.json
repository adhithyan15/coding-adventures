          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Telugu for where to, then the Telugu for have you eaten."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: జలుబు",
          "segments": [
            {
              "kind": "speech",
              "text": "జలుబు (jalubu) — \"a cold\", the kind with a runny nose."
            },
            {
              "kind": "speech",
              "text": "నాకు జలుబు (jalubu) చేసింది — \"I have caught a cold\", literally \"a cold has done to me\". Telugu keeps this apart from చలి, the cold of the weather."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "జలుబు (jalubu) is native Dravidian, one word with Tamil caḷi, \"catarrh, mucus\" (DEDR 2409)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "The illness, next to the weather word you already have."
            }
          ]
        },
        {
          "index": 4,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
