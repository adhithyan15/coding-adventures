    {
      "id": "ES-C12-decir",
      "sequence": 1120,
      "title": "decir — saying with the same small person frame",
      "headword": "decir",
      "romanization": "decir",
      "gloss": "to say or tell — with the singular present forms digo, dices, and dice",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
