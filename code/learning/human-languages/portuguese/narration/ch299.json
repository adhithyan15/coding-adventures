        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: o acidente",
          "segments": [
            {
              "kind": "speech",
              "text": "o acidente — \"the accident\"."
            },
            {
              "kind": "speech",
              "text": "Houve um acidente na autoestrada. There was an accident on the motorway."
            },
            {
              "kind": "speech",
              "text": "Ter um acidente — to have an accident; por acidente — by chance."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "acidente is a learned borrowing from Latin accidēns \"happening, chance\" (EtymDB), from accidere \"to fall upon, to happen\", built on cadere \"to fall\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
