# frozen_string_literal: true

require "rake/testtask"

Rake::TestTask.new(:test) do |task|
  task.libs << "lib" << "test"
  task.pattern = "test/test_*.rb"
end

desc "Build, install and execute the real gem in a disposable isolated home"
task :package_smoke do
  ruby "scripts/gem_smoke.rb"
end

task default: [:test, :package_smoke]
