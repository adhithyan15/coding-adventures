      "id": "IT-C401-file",
      "sequence": 22770,
      "title": "il file — the computer file",
      "headword": "il file",
      "romanization": "il file",
      "gloss": "the computer file",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
