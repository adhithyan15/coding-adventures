        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: занавес",
          "segments": [
            {
              "kind": "speech",
              "text": "занавес (zánaves) — \"a stage curtain\"."
            },
            {
              "kind": "speech",
              "text": "Занавес поднялся, и спектакль начался. Zánaves podnyálsya, i spektákl nachalsyá. The curtain went up and the play began."
            },
            {
              "kind": "speech",
              "text": "Masculine. A window curtain is штора or занавеска."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "занавес (zánaves) is derived from навес 'an awning' (EtymDB), built on the root of вешать 'to hang'."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
