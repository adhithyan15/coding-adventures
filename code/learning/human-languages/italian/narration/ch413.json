        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: tamponare",
          "segments": [
            {
              "kind": "speech",
              "text": "tamponare — \"to rear-end, to bump into (the car in front)\"."
            },
            {
              "kind": "speech",
              "text": "Un furgone ci ha tamponato al semaforo. A van ran into the back of us at the lights."
            },
            {
              "kind": "speech",
              "text": "Also to stop a leak or a wound: tamponare una ferita."
            }
          ]
        },
