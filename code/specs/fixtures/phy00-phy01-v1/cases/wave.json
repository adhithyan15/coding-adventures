      "expected": {
        "outcome": "value",
        "value": {"kind": "finite", "decimal": "62.83185307179586"},
        "comparison": {"kind": "absolute", "tolerance": "1e-10"}
      }
    },
    {
      "id": "phy01/evaluate/zero-crossing",
      "operation": "evaluate",
      "summary": "A zero-phase one hertz wave starts at zero.",
      "input": {
        "wave": {
          "amplitude": {"kind": "finite", "decimal": "1"},
          "frequency": {"kind": "finite", "decimal": "1"},
          "phase": {"kind": "finite", "decimal": "0"}
