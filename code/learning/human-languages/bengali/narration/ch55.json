        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: বদলানো",
          "segments": [
            {
              "kind": "speech",
              "text": "বদলানো — bôdlāno — \"to change\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "বদলানো (bôdlāno) is a loan from Arabic badal, \"a substitute, an exchange\", which reached Bengali through Persian. Its Arabic root is b-d-l (Lane)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
