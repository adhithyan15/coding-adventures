        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: здесь",
          "segments": [
            {
              "kind": "speech",
              "text": "здесь (zdes) — \"here\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "здесь (zdes) from Old Russian сьде, with a later -сь: Proto-Slavic sĭde, \"here\", from the old pronoun sĭ, \"this\", the one in сей and сегодня, \"today\", built as где, \"where\", is built from the question word (Vasmer)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for this chapter."
