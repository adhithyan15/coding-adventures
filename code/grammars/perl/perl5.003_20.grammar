# Perl 5.003_20 (1997-01-07) grammar: plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: unsupported Perl 5.003_20 syntax is rejected.
# Evidence: https://github.com/Perl/perl5/blob/perl-5.003_20/perly.y
# Tagged yacc changes named and anonymous subroutine handling outside this
# separate file's arithmetic precedence, parentheses and print subset.

program         = print_statement { print_statement } ;
print_statement = PRINT LPAREN expr RPAREN SEMICOLON ;
expr            = term { ( PLUS | MINUS ) term } ;
term            = unary { STAR unary } ;
unary           = MINUS unary | atom ;
atom            = INT | LPAREN expr RPAREN ;
