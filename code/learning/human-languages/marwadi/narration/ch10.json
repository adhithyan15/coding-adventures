        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know",
          "segments": [
            {
              "kind": "speech",
              "text": "mā̃ — mother."
            },
            {
              "kind": "speech",
              "text": "Listen twice. The vowel is long and the ending is nasal. Say the whole word once; do not spell it yet. Families and the names people use for relatives vary, so this lesson teaches one source-attested everyday label, not one family model."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "speech",
              "text": "Point to the mother cue when you hear mā̃, then say the word once from the meaning alone."
