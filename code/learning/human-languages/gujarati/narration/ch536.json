            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "jo sārũ muhūrt haśe to ame ravivāre navā gharmā̃ jaīśũ. — If there is a good hour, we will move into the new house on Sunday.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *jo sārũ muhūrt haśe to ame ravivāre navā gharmā̃ jaīśũ.* — If there is a good hour, we will move into the new house on Sunday.]"
            },
            {
