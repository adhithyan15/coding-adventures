warrant data_forms v1
  -- Synthetic ir.data document of slice S11a (VER04r Appendix A.2): records, variants, Option, the
  -- four tags some / none / ctor / field, match on every scrutinee with the four data patterns, and the
  -- intermediate use of ir.fixed.  GENERATED by make_data_forms.py; do not edit by hand.
  error DataError = Bad | Worse
  record Point(x: U8, y: U8)
  record Wrapped(p: Point, tag: Bool)
  record Blob(data: Bytes, n: Nat)
  record Slot(o: Option<U8>, t: (Bool,Nat))
  variant Shape = Circle(r: U8) | Rect(w: U8, h: U8) | Dot
  variant Mode = Add | Sub | Neg
  variant Msg = Short | Done(n: Nat, rest: Bytes) | Opt(o: Option<U8>)

  -- pure models: one per form of Appendix A.2 --------------------------------------------------
  model some_u8(a: U8) -> Option<U8> = Some(a)
  model none_u8(u: Bool) -> Option<U8> = None
  model none_bytes(u: Bool) -> Option<Bytes<2>> = None
  model some_lit(u: Bool) -> Option<Nat> = Some(7)
  model some_nested(a: U8) -> Option<Option<U8>> = Some(Some(a))
  model some_none(u: Bool) -> Option<Option<U8>> = Some(None)
  model opt_if(c: Bool, a: U8) -> Option<U8> = if c then Some(a) else None
  model opt_if_rev(c: Bool, a: U8) -> Option<U8> = if c then None else Some(a)
  model opt_bytes(d: Bytes) -> Option<Bytes> = if len(d) == 0 then None else Some(d)
  model opt_fixed_bytes(d: Bytes<2>) -> Option<Bytes<2>> = Some(d)
  model opt_pair(a: Bool) -> Option<(Bool,Nat)> = Some((a, 1))
  model opt_rec(a: U8, b: U8) -> Option<Point> = Some(Point(a, b))
  model res_opt(a: U8) -> Result<Option<U8>,DataError> = if a > 1u8 then Err(DataError.Bad) else Ok(if a == 1u8 then Some(a) else None)
  model res_none(u: Bool) -> Result<Option<U8>,DataError> = Ok(None)
  model opt_eq(a: Option<U8>, b: Option<U8>) -> Bool = a == b
  model opt_ne(a: Option<U8>, b: Option<U8>) -> Bool = a != b
  model opt_is_none(a: Option<U8>) -> Bool = a == None
  model opt_is_some_lit(a: Option<U8>) -> Bool = Some(1u8) == a
  model unwrap_binder(o: Option<U8>) -> U8 = unwrap_or(o, 5u8)
  model inter_add(a: U8, b: U8) -> U8 = unwrap_or(checked_add(a, b), 0u8)
  model inter_at(d: Bytes, i: Nat) -> U8 = unwrap_or(at(d, i), 0u8)
  model inter_div_nat(a: Nat, b: Nat) -> Bool = unwrap_or(div(a, b), 0) == 3
  model prod_eq(a: U8, b: U8) -> Bool = checked_add(a, b) == Some(a)
  model prod_in_ok(a: U8, b: U8) -> Result<Option<U8>,DataError> = Ok(rem(a, b))
  model prod_in_if(c: Bool, d: Bytes, i: Nat) -> U8 = unwrap_or(if c then at(d, i) else None, 0u8)
  model prod_try(a: Nat) -> Option<U8> = try<U8>(a)
  model mk_point(a: U8, b: U8) -> Point = Point(a, b)
  model px(p: Point) -> U8 = p.x
  model py(p: Point) -> U8 = p.y
  model mk_wrapped(a: U8, b: U8, t: Bool) -> Wrapped = Wrapped(Point(a, b), t)
  model wrapped_y(w: Wrapped) -> U8 = w.p.y
  model mk_blob(d: Bytes, n: Nat) -> Blob = Blob(d, n)
  model mk_blob_lit(u: Bool) -> Blob = Blob(b"0102", 3)
  model blob_len(b: Blob) -> Nat = len(b.data)
  model mk_slot(o: Option<U8>, a: Bool) -> Slot = Slot(o, (a, 2))
  model slot_o(s: Slot) -> Option<U8> = s.o
  model slot_t0(s: Slot) -> Bool = s.t.0
  model rec_eq(a: Point, b: Point) -> Bool = a == b
  model rec_ne(a: Wrapped, b: Wrapped) -> Bool = a != b
  model rec_postfix(a: U8, b: U8) -> U8 = mk_point(a, b).y
  model rec_lit_field(a: U8) -> U8 = Point(a, 1u8).x
  model mk_circle(r: U8) -> Shape = Circle(r)
  model mk_rect(w: U8, h: U8) -> Shape = Rect(w, h)
  model mk_dot(u: Bool) -> Shape = Dot
  model mk_done(n: Nat) -> Msg = Done(n, b"")
  model mk_opt_msg(o: Option<U8>) -> Msg = Opt(o)
  model mk_opt_some(a: U8) -> Msg = Opt(Some(a))
  model mk_opt_none(u: Bool) -> Msg = Opt(None)
  model mk_short(u: Bool) -> Msg = Short
  model mk_neg(u: Bool) -> Mode = Neg
  model var_eq(a: Shape, b: Shape) -> Bool = a == b
  model var_ne(a: Shape, b: Shape) -> Bool = a != b
  model var_eq_lit(a: Shape) -> Bool = a == Dot
  model m_opt(o: Option<U8>) -> U8 = match o with Some(x) -> x | None -> 0u8
  model m_opt_wild(o: Option<U8>) -> Bool = match o with Some(_) -> true | None -> false
  model m_opt_wild_arm(o: Option<U8>) -> Bool = match o with None -> false | _ -> true
  model m_opt_nested(o: Option<Option<U8>>) -> Nat = match o with Some(Some(x)) -> 2 | Some(None) -> 1 | None -> 0
  model m_opt_ret_opt(o: Option<U8>) -> Option<U8> = match o with Some(x) -> Some(x) | None -> None
  model m_opt_bind_whole(o: Option<U8>) -> Bool = match o with Some(_) -> true | whole -> whole == o
  model m_opt_on_call(a: U8) -> Nat = match some_u8(a) with Some(_) -> 1 | None -> 0
  model m_opt_literal(u: Bool) -> Nat = match Some(1u8) with Some(_) -> 1 | None -> 0
  model m_opt_tuple(o: Option<(Bool,Nat)>) -> Nat = match o with Some((true, n)) -> n | Some((false, _)) -> 0 | None -> 0
  model m_bool(b: Bool) -> Nat = match b with true -> 1 | false -> 0
  model m_bool_wild(b: Bool) -> Nat = match b with true -> 1 | _ -> 0
  model m_bool_expr(a: U8) -> Nat = match a == 0u8 with true -> 1 | false -> 0
  model m_tuple(t: (Bool,Bool)) -> Bool = match t with (a, b) -> a
  model m_tuple_bool(t: (Bool,Bool)) -> Bool = match t with (true, x) -> x | (false, _) -> false
  model m_tuple_nested(t: ((Bool,Bool),Nat)) -> Nat = match t with ((true, _), n) -> n | ((false, _), _) -> 0
  model m_point(p: Point) -> U8 = match p with Point(x, y) -> x + y
  model m_point_wild(p: Point) -> U8 = match p with Point(_, y) -> y
  model m_wrapped(w: Wrapped) -> U8 = match w with Wrapped(Point(a, _), true) -> a | Wrapped(Point(_, b), false) -> b
  model m_blob(b: Blob) -> Nat = match b with Blob(_, n) -> n
  model m_slot(s: Slot) -> Nat = match s with Slot(Some(_), (true, n)) -> n | Slot(Some(_), (false, _)) -> 1 | Slot(None, _) -> 0
  model m_shape(s: Shape) -> U8 = match s with Circle(r) -> r | Rect(w, h) -> w + h | Dot -> 0u8
  model m_shape_wild(s: Shape) -> Bool = match s with Dot -> true | _ -> false
  model m_mode(o: Mode) -> Nat = match o with Add -> 0 | Sub -> 1 | Neg -> 2
  model m_is_neg(o: Mode) -> Bool = match o with Neg -> true | _ -> false
  model m_msg(m: Msg) -> Nat = match m with Short -> 0 | Done(n, _) -> n | Opt(Some(x)) -> to_nat(x) | Opt(None) -> 0
  model m_msg_bind(m: Msg) -> Msg = match m with Short -> Short | other -> other
  model m_shape_ret_var(s: Shape) -> Shape = match s with Circle(r) -> Rect(r, r) | other -> other
  model m_res_bool(r: Result<Bool,DataError>) -> Nat = match r with Ok(true) -> 1 | Ok(false) -> 0 | Err(_) -> 2
  model m_res_opt(r: Result<Option<U8>,DataError>) -> Nat = match r with Ok(Some(_)) -> 1 | Ok(None) -> 0 | Err(_) -> 2
  model m_res_rec(r: Result<Point,DataError>) -> U8 = match r with Ok(Point(x, _)) -> x | Err(DataError.Bad) -> 0u8 | Err(_) -> 1u8
  model m_res_err_unused(r: Result<Bool,DataError>) -> Nat = match r with Ok(_) -> 1 | Err(e) -> 0
  model m_res_plain(r: Result<Bool,DataError>) -> Bool = match r with Ok(x) -> x | Err(_) -> false
  model m_inner(o: Option<U8>, b: Bool) -> Nat = match o with Some(_) -> (match b with true -> 1 | false -> 2) | None -> 0

  -- subject operations, claims and examples --------------------------------------------------
  op op_some_u8(a: U8) -> Option<U8>
  op op_none_u8(u: Bool) -> Option<U8>
  op op_none_bytes(u: Bool) -> Option<Bytes<2>>
  op op_some_lit(u: Bool) -> Option<Nat>
  op op_some_nested(a: U8) -> Option<Option<U8>>
  op op_some_none(u: Bool) -> Option<Option<U8>>
  op op_opt_if(c: Bool, a: U8) -> Option<U8>
  op op_opt_if_rev(c: Bool, a: U8) -> Option<U8>
  op op_opt_bytes(d: Bytes) -> Option<Bytes>
  op op_opt_fixed_bytes(d: Bytes<2>) -> Option<Bytes<2>>
  op op_opt_pair(a: Bool) -> Option<(Bool,Nat)>
  op op_opt_rec(a: U8, b: U8) -> Option<Point>
  op op_res_opt(a: U8) -> Result<Option<U8>,DataError>
  op op_res_none(u: Bool) -> Result<Option<U8>,DataError>
  op op_opt_eq(a: Option<U8>, b: Option<U8>) -> Bool
  op op_opt_ne(a: Option<U8>, b: Option<U8>) -> Bool
  op op_opt_is_none(a: Option<U8>) -> Bool
  op op_opt_is_some_lit(a: Option<U8>) -> Bool
  op op_unwrap_binder(o: Option<U8>) -> U8
  op op_inter_add(a: U8, b: U8) -> U8
  op op_inter_at(d: Bytes, i: Nat) -> U8
  op op_inter_div_nat(a: Nat, b: Nat) -> Bool
  op op_prod_eq(a: U8, b: U8) -> Bool
  op op_prod_in_ok(a: U8, b: U8) -> Result<Option<U8>,DataError>
  op op_prod_in_if(c: Bool, d: Bytes, i: Nat) -> U8
  op op_prod_try(a: Nat) -> Option<U8>
  op op_mk_point(a: U8, b: U8) -> Point
  op op_px(p: Point) -> U8
  op op_py(p: Point) -> U8
  op op_mk_wrapped(a: U8, b: U8, t: Bool) -> Wrapped
  op op_wrapped_y(w: Wrapped) -> U8
  op op_mk_blob(d: Bytes, n: Nat) -> Blob
  op op_mk_blob_lit(u: Bool) -> Blob
  op op_blob_len(b: Blob) -> Nat
  op op_mk_slot(o: Option<U8>, a: Bool) -> Slot
  op op_slot_o(s: Slot) -> Option<U8>
  op op_slot_t0(s: Slot) -> Bool
  op op_rec_eq(a: Point, b: Point) -> Bool
  op op_rec_ne(a: Wrapped, b: Wrapped) -> Bool
  op op_rec_postfix(a: U8, b: U8) -> U8
  op op_rec_lit_field(a: U8) -> U8
  op op_mk_circle(r: U8) -> Shape
  op op_mk_rect(w: U8, h: U8) -> Shape
  op op_mk_dot(u: Bool) -> Shape
  op op_mk_done(n: Nat) -> Msg
  op op_mk_opt_msg(o: Option<U8>) -> Msg
  op op_mk_opt_some(a: U8) -> Msg
  op op_mk_opt_none(u: Bool) -> Msg
  op op_mk_short(u: Bool) -> Msg
  op op_mk_neg(u: Bool) -> Mode
  op op_var_eq(a: Shape, b: Shape) -> Bool
  op op_var_ne(a: Shape, b: Shape) -> Bool
  op op_var_eq_lit(a: Shape) -> Bool
  op op_m_opt(o: Option<U8>) -> U8
  op op_m_opt_wild(o: Option<U8>) -> Bool
  op op_m_opt_wild_arm(o: Option<U8>) -> Bool
  op op_m_opt_nested(o: Option<Option<U8>>) -> Nat
  op op_m_opt_ret_opt(o: Option<U8>) -> Option<U8>
  op op_m_opt_bind_whole(o: Option<U8>) -> Bool
  op op_m_opt_on_call(a: U8) -> Nat
  op op_m_opt_literal(u: Bool) -> Nat
  op op_m_opt_tuple(o: Option<(Bool,Nat)>) -> Nat
  op op_m_bool(b: Bool) -> Nat
  op op_m_bool_wild(b: Bool) -> Nat
  op op_m_bool_expr(a: U8) -> Nat
  op op_m_tuple(t: (Bool,Bool)) -> Bool
  op op_m_tuple_bool(t: (Bool,Bool)) -> Bool
  op op_m_tuple_nested(t: ((Bool,Bool),Nat)) -> Nat
  op op_m_point(p: Point) -> U8
  op op_m_point_wild(p: Point) -> U8
  op op_m_wrapped(w: Wrapped) -> U8
  op op_m_blob(b: Blob) -> Nat
  op op_m_slot(s: Slot) -> Nat
  op op_m_shape(s: Shape) -> U8
  op op_m_shape_wild(s: Shape) -> Bool
  op op_m_mode(o: Mode) -> Nat
  op op_m_is_neg(o: Mode) -> Bool
  op op_m_msg(m: Msg) -> Nat
  op op_m_msg_bind(m: Msg) -> Msg
  op op_m_shape_ret_var(s: Shape) -> Shape
  op op_m_res_bool(r: Result<Bool,DataError>) -> Nat
  op op_m_res_opt(r: Result<Option<U8>,DataError>) -> Nat
  op op_m_res_rec(r: Result<Point,DataError>) -> U8
  op op_m_res_err_unused(r: Result<Bool,DataError>) -> Nat
  op op_m_res_plain(r: Result<Bool,DataError>) -> Bool
  op op_m_inner(o: Option<U8>, b: Bool) -> Nat
  op op_some_only(o: Option<U8> | match o with Some(_) -> true | None -> false) -> U8
  op op_point_ok(p: Point | p.x < 100u8) -> U8
