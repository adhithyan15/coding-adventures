          "segments": [
            {
              "kind": "speech",
              "text": "પ્રવાસ — pravās — \"trip, tour\"."
            },
            {
              "kind": "speech",
              "text": "અમે ગયા મહિને પ્રવાસે ગયા. — ame gayā mahine pravāse gayā — \"We went on a trip last month.\""
            },
