        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: корреспондент",
          "segments": [
            {
              "kind": "speech",
              "text": "корреспондент (korrespondént) — \"a correspondent\"."
            },
            {
              "kind": "speech",
              "text": "Корреспондент поехал на север. Korrespondént poyékhal na séver. The correspondent went north."
            },
            {
              "kind": "speech",
              "text": "Also журналист. Feminine forms are colloquial, and корреспондент (korrespondént) serves for a woman too."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "корреспондент (korrespondént) is usually traced through German Korrespondent or French correspondant to Medieval Latin correspondēre \"to answer together\"; EtymDB lists no parent."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
