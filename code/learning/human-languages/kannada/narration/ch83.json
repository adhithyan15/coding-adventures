              "instruction": "duḥkha",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *duḥkha*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "duḥkha, once more",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *duḥkha*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "say duḥkha and then santōṣa",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: say *duḥkha* and then *santōṣa*]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say the Kannada for a headache, then the Kannada for rest, then say duḥkha again",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say the Kannada for a headache, then the Kannada for rest, then say *duḥkha* again]"
            }
          ]
        },
        {
          "index": 4,
