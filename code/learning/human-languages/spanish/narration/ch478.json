            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Spanish for to earn, then the Spanish for three hundred."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: el equipaje",
          "segments": [
            {
              "kind": "speech",
              "text": "el equipaje — \"the luggage\"."
            },
            {
              "kind": "speech",
              "text": "El equipaje de mano no puede pesar más de diez kilos. Hand luggage cannot weigh more than ten kilos."
            },
            {
              "kind": "speech",
              "text": "It is singular, like English luggage: mi equipaje."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "equipaje from French équipage, \"a ship's crew and gear\" (EtymDB 2.1), from équiper, \"to fit out a ship\", a word of Germanic origin related to English ship."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for reading notices, forms and messages."
