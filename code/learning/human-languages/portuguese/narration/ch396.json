              "action": "SAY",
              "instruction": "a aplicação",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *a aplicação*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "a aplicação, once more",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *a aplicação*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "a sentence of your own with a aplicação",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: a sentence of your own with *a aplicação*]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say the Portuguese for to go bankrupt, then the Portuguese for in debt, then say a aplicação again",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say the Portuguese for to go bankrupt, then the Portuguese for in debt, then say *a aplicação* again]"
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What does a aplicação mean? (\"The app, the application (software); the use\".) Say it once more."
            }
