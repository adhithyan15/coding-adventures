# Perl 5.003_95 (1997-03-25) tokens: plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: this does not lex all Perl 5.003_95 source.
# Evidence: https://github.com/Perl/perl5/blob/perl-5.003_95/toke.c
# Tagged tokenizer changes command-line -a/-F loop expansion outside this
# subset. Carriage return and leading-zero forms remain refused;
# unsupported Perl syntax is outside this subset.

PRINT     = "print"
INT       = /0|[1-9][0-9]*/
PLUS      = "+"
DECREMENT = "--"
MINUS     = "-"
STAR      = "*"
LPAREN    = "("
RPAREN    = ")"
SEMICOLON = ";"

skip:
  WHITESPACE = /[ \t\n]+/
