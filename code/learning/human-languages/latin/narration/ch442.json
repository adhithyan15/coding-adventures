        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: salum, salī",
          "segments": [
            {
              "kind": "speech",
              "text": "salum, salī — \"the open sea, the swell (of the sea)\"."
            },
            {
              "kind": "speech",
              "text": "Nāvēs extrā portum in salō ad ancorās stant. The ships lie at anchor on the open sea outside the harbour."
            },
            {
              "kind": "speech",
              "text": "Second declension, neuter: salum, salī n. The rolling sea off the coast, where ships ride at anchor."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "salum matches Greek salos 'the rolling swell of the sea' (Lewis & Short), but EtymDB gives no parent, so whether it was borrowed is not settled."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
