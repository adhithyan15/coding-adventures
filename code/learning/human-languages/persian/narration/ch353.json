          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "movarrekh is usually traced to Arabic mu'arrikh, \"historian\", of the same root as ta'rīkh \"history\"; EtymDB lists no entry."
            }
          ]
        },
