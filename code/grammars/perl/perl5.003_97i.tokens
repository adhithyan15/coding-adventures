# Perl 5.003_97i (1997-04-25) tokens: plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: this does not lex all Perl 5.003_97i source.
# Evidence: https://github.com/Perl/perl5/blob/perl-5.003_97i/toke.c
# Tagged tokenizer bounds decimal scanning to 250 digits in a 256-byte token
# buffer. Unsupported characters, carriage returns and
# leading-zero forms remain refused.

PRINT     = "print"
INT       = /0|[1-9][0-9]{0,249}/
PLUS      = "+"
DECREMENT = "--"
MINUS     = "-"
STAR      = "*"
LPAREN    = "("
RPAREN    = ")"
SEMICOLON = ";"

skip:
  WHITESPACE = /[ \t\n]+/
