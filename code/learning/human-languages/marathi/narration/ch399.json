              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *cālak*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "cālakāne bas haḷūhaḷū thāmbavlī. — The driver brought the bus slowly to a stop.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *cālakāne bas haḷūhaḷū thāmbavlī.* — The driver brought the bus slowly to a stop.]"
            },
            {
