      "id": "MR-C531-phalandaj",
      "sequence": 30380,
      "title": "फलंदाज (phalandāj) — a batsman; a batter",
      "headword": "फलंदाज",
      "romanization": "phalandāj",
      "gloss": "a batsman; a batter",
      "script": "devanagari",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:5685ae75484223ec",
      "notice": null,
      "blocks": [
        {
          "index": 0,
