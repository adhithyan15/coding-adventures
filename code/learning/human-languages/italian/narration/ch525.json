        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: il libraio",
          "segments": [
            {
              "kind": "speech",
              "text": "il libraio — \"bookseller\"."
            },
            {
              "kind": "speech",
              "text": "Il libraio mi ha consigliato un romanzo giallo. The bookseller recommended a crime novel to me."
            },
            {
              "kind": "speech",
              "text": "La libreria is the bookshop; la biblioteca is the library."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "libraio is built on libro \"book\", inherited from Latin liber \"the inner bark of a tree, a book\" (Lewis & Short)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
