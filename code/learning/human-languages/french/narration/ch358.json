        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: le syndicat",
          "segments": [
            {
              "kind": "speech",
              "text": "le syndicat — \"the trade union\"."
            },
            {
              "kind": "speech",
              "text": "Mon père travaille pour un syndicat. My father works for a trade union."
            },
            {
              "kind": "speech",
              "text": "Le syndicat d'initiative is an old name for a tourist office."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "syndicat is built from syndic \"representative\" and -at (EtymDB). syndic comes from Late Latin syndicus \"delegate of a body\", from Greek sýndikos \"advocate\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
