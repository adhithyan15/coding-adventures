{
  "name": "@coding-adventures/os-architecture-simulator",
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22.23.5" },
  "main": "src/core.ts",
  "types": "src/core.ts",
  "exports": {
    ".": "./src/core.ts",
    "./profiles": "./src/profiles.ts",
    "./bus": "./src/bus.ts",
    "./cpu": "./src/cpu.ts",
