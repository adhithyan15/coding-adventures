      "input": {
        "wave": {
          "amplitude": {"kind": "finite", "decimal": "1"},
          "frequency": {"kind": "finite", "decimal": "1"},
          "phase": {"kind": "finite", "decimal": "0"}
        },
        "time": {"kind": "finite", "decimal": "0.75"}
      },
      "expected": {
        "outcome": "value",
        "value": {"kind": "finite", "decimal": "-1"},
        "comparison": {"kind": "absolute", "tolerance": "1e-10"}
      }
    },
    {
      "id": "phy01/evaluate/phase-peak",
      "operation": "evaluate",
      "summary": "A pi-over-two phase starts at the positive amplitude.",
      "input": {
        "wave": {
          "amplitude": {"kind": "finite", "decimal": "1"},
