      ],
      "sourceHash": "fnv1a64:2c0ba86fd1f6fae4",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Say “a poem.” (Kāvyam.)"
            }
          ]
        },
        {
          "index": 1,
          "type": "guided-production",
          "title": "Guided Practice: independent round one",
          "segments": [
            {
              "kind": "speech",
              "text": "No Sanskrit model is shown before you answer."
            },
            {
              "kind": "pause",
              "seconds": 12,
              "perItem": false,
              "source": "[PAUSE 12s]"
            },
            {
              "kind": "speech",
              "text": "You are speaking to a shopkeeper at a market. Choose one familiar item. Say that you buy it. Ask the price. The shopkeeper says that the price is twenty rupees. Request the item politely, then close with thanks."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built: check after speaking",
          "segments": [
            {
              "kind": "speech",
              "text": "One complete answer with fruit is अहं फलं क्रीणामि (krīṇāmi)। मूल्यं कियत्? विंशतिः रूप्यकाणि। कृपया मह्यं फलं ददातु। धन्यवादः। Your item may differ; the five jobs must remain."
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Which two new pieces held the old vocabulary together? (The buyer form क्रीणामि (krīṇāmi) and the price-exchange pattern.)"
            }
          ]
        }
      ]
    },
    {
      "id": "SA-C266-market-transaction-retrieval",
      "sequence": 15810,
      "title": "Retrieve the whole market transaction",
      "headword": "(retrieve the whole market transaction)",
      "romanization": "",
      "gloss": "independently choose a setting and complete a second familiar-item transaction",
      "script": "devanagari",
      "modality": "voice",
      "derivedModality": "voice",
