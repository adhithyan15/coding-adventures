% ============================================================================
% contraction — a contraction and the two-word phrase it stands for
% (adj-facts-stdlib, LANGUAGE).
% ============================================================================
% A contraction combines two words into a shorter one, marking the missing
% letters with an apostrophe: "do not" becomes "don't." Recall is a binding
% query:
%
%     ? contraction(dont, $Expansion)
%       % do_not
%
% A native `table` (ADJ-TABLES RS-5): each `row` lowers to a ground relation
% `contraction(word, expansion)` carrying the source citation, so the lookup
% above is the ordinary SLD binding query — the engine returns the expansion
% WITH its source, on the CPU, with zero model calls, and abstains on any
% contraction the source does not expand this way. The query also runs
% BACKWARD — bind an expansion and recall which contraction it names:
%
%     ? contraction($Word, will_not)
%       % wont
%
% DESIGN NOTE — why `word` and `expansion` are apostrophe-free atom labels
% rather than the punctuated spellings: ADJ atom labels cannot contain an
% apostrophe, so this table uses the same short atom-style-label discipline
% `sentence-type.adj`/`part-of-speech.adj` already established for
% punctuation-bearing content — `dont` stands for "don't," and the
% underscore-joined `do_not` stands for the two-word expansion. The `source`
% citation string below still quotes the ORIGINAL punctuated text, so the
% mapping remains independently checkable against the cited page.
%
% Provenance: quoted verbatim from Grammarly's "What Are Contractions in
% Writing? Definition and Examples" article, whose "Negative Contractions"
% table gives each contraction's expansion directly:
%
%     word (this table's atom label)   expansion (atom label)   source pair (verbatim)
%     --------------------------------  ------------------------  ---------------------------------
%     arent                              are_not                   "aren't" = "are not"
%     cant                               can_not                   "can't" = "can not"
%     couldnt                            could_not                 "couldn't" = "could not"
%     didnt                              did_not                   "didn't" = "did not"
%     doesnt                             does_not                  "doesn't" = "does not"
%     dont                               do_not                    "don't" = "do not"
%     hadnt                              had_not                   "hadn't" = "had not"
%     hasnt                              has_not                   "hasn't" = "has not"
%     havent                             have_not                  "haven't" = "have not"
%     isnt                               is_not                    "isn't" = "is not"
%     mustnt                             must_not                  "mustn't" = "must not"
%     shouldnt                           should_not                "shouldn't" = "should not"
%     wasnt                              was_not                   "wasn't" = "was not"
%     werent                             were_not                  "weren't" = "were not"
%     wont                               will_not                  "won't" = "will not"
%     wouldnt                            would_not                 "wouldn't" = "would not"
%
% EXTENDED this cycle from 3 to 16 rows: the original dont/cant/wont rows
% turn out to be exactly THREE members of a larger 16-row "Negative
% Contractions" table on the same already-cited page — every negative
% contraction the source lists, and every row has exactly ONE unambiguous
% expansion (unlike the page's separate "Common Contractions" table, whose
% entries like "he's" -> "he has, he is" are genuinely ambiguous and were
% correctly left out). WebFetch re-verified the full 16-row table across
% two separate passes before writing — both passes returned byte-identical
% rows, and both confirmed every row has a single expansion with no
% comma-separated alternatives. `trust consensus` — Grammarly is a
% reputable, widely-cited grammar-content company, the same tier this
% stdlib already reserves for other non-.gov language sources and the same
% source family already cited by `sentence-type.adj`/`part-of-speech.adj`.
% Note the source's own table expands "can't" to the TWO-word "can not,"
% not the more common single-word spelling "cannot" — this table uses
% exactly what the source states, not a silently "corrected" spelling.
% A contraction that is NOT one of these sixteen — e.g. "he's," a real
% contraction from the page's SEPARATE, genuinely ambiguous "Common
% Contractions" table (it means either "he has" or "he is," and the source
% never disambiguates which) — is deliberately NOT a row, so a recall
% ABSTAINS on it rather than inventing a single expansion the source itself
% does not commit to. (See ../README.md; feedback_nothing_human_authored,
% feedback_adj_only_shipped_artifacts.)
% ============================================================================

table contraction {
    columns word, expansion

    row (arent, are_not)
    row (cant, can_not)
    row (couldnt, could_not)
    row (didnt, did_not)
    row (doesnt, does_not)
    row (dont, do_not)
    row (hadnt, had_not)
    row (hasnt, has_not)
    row (havent, have_not)
    row (isnt, is_not)
    row (mustnt, must_not)
    row (shouldnt, should_not)
    row (wasnt, was_not)
    row (werent, were_not)
    row (wont, will_not)
    row (wouldnt, would_not)

    source "don't = do not"
    locator "https://www.grammarly.com/blog/grammar/contractions/"
    trust consensus
}
