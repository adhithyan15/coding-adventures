        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: بنابراین",
          "segments": [
            {
              "kind": "speech",
              "text": "بنابراین — banâbarin — \"therefore\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "banâbarin is banâ, \"foundation\", with bar, \"on\", and in, \"this\": \"on this basis\". banâ is borrowed from Arabic bināʾ, \"building\" (root b-n-y, Lane); bar and in are native Persian."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for this chapter."
