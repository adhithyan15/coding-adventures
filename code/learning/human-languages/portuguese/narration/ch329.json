        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: o antepassado",
          "segments": [
            {
              "kind": "speech",
              "text": "o antepassado — \"the ancestor\"."
            },
            {
              "kind": "speech",
              "text": "Um antepassado meu viveu nesta casa. An ancestor of mine lived in this house."
            },
            {
              "kind": "speech",
              "text": "Usually plural: os nossos antepassados."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "antepassado joins ante \"before\", from Latin ante (Lewis & Short), and passado \"past\": one who lived before us."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
