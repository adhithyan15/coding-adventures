              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Say continue straight. (Seguir recto.) Which consonant keeps recto apart from resto? (K rather than s.)"
            }
          ]
        }
      ]
    },
