        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: cautiō, cautiōnis",
          "segments": [
            {
              "kind": "speech",
              "text": "cautiō, cautiōnis — \"caution; a guarantee, a bond\"."
            },
            {
              "kind": "speech",
              "text": "Sine cautiōne pecūniam nōn crēdit. He does not lend money without a guarantee."
            },
            {
              "kind": "speech",
              "text": "cautiō, cautiōnis f., from caveō: carefulness, and in law a written security. English caution."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "cautiō is the noun built on caveō \"to beware, to take care\" (EtymDB; Lewis & Short). English caution comes from it."
            }
          ]
        },
