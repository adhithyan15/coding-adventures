        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: aestus, aestūs",
          "segments": [
            {
              "kind": "speech",
              "text": "aestus, aestūs — \"heat, glow; the tide\"."
            },
            {
              "kind": "speech",
              "text": "Propter aestum incendiī nēmō appropinquāre poterat. Because of the heat of the fire nobody could come near."
            },
            {
              "kind": "speech",
              "text": "Masculine, 4th declension. The heat of fire or summer, the surge of the sea, and the tide. Related to aestās (taught)."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "aestus is inherited from a Proto-Indo-European root meaning \"to burn\" (EtymDB), and is a cousin of aestās, \"summer\"."
            }
          ]
        },
        {
