    {
      "id": "JA-W11-small-tsu",
      "sequence": 690,
      "title": "っ (small tsu) — one small held beat",
      "headword": "っ",
      "romanization": "small tsu",
      "gloss": "the small hiragana sign that holds the following consonant",
      "script": "japanese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:81681b9eac0e3432",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Script — the shape"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now — leave the section called Script — the shape until you have stopped, and I will say so again when we reach it."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 12,
              "perItem": false,
              "source": "[PAUSE 12s]"
            },
            {
              "kind": "speech",
              "text": "Say yukkuri and itte kudasai. Hold the silence before each second consonant; do not add a vowel."
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — the shape",
          "segments": [
            {
              "kind": "speech",
              "text": "っ — small tsu — one beat of consonant closure."
            },
            {
              "kind": "speech",
              "text": "It has the same family shape as full-sized つ, but it is smaller and sits lower. Copy only the small form today. In ゆっくり, it holds before k; in いって, it holds before t."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "speech",
              "text": "Trace っ (small tsu) once and copy it once."
            },
            {
              "kind": "speech",
              "text": "Hide it; write the small sign after ten seconds."
            },
            {
              "kind": "speech",
              "text": "Read ゆっくり and いって with one silent beat at っ (small tsu)."
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "speech",
              "text": "Stop after one accurate small form."
            },
            {
              "kind": "speech",
              "text": "Source: Unicode Hiragana chart."
            },
            {
              "kind": "activity",
              "scored": true,
              "id": "JA-W11-small-tsu-write",
              "prompt": "Write the small hiragana sign that holds the following consonant.",
              "assesses": [
                "JA-SCRIPT-SMALL-TSU-01"
              ],
              "responseSeconds": 10,
              "acceptedResponses": [
                "っ",
                "small tsu"
              ],
              "feedback": {
                "correct": "Right: っ marks one held beat before the next consonant.",
                "incorrect": "Write a small, low っ — not the full-sized sign."
              }
            }
          ]
        }
      ]
    },
    {
      "id": "JA-W11-te",
      "sequence": 700,
      "title": "て — close itte",
      "headword": "て",
      "romanization": "te",
      "gloss": "the hiragana sign for the mora te",
      "script": "japanese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:3123dd09b9e307be",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Script — the shape"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now — leave the section called Script — the shape until you have stopped, and I will say so again when we reach it."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 12,
              "perItem": false,
              "source": "[PAUSE 12s]"
            },
            {
              "kind": "speech",
              "text": "Say itte kudasai. Write the small っ (small tsu) that holds before t."
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — the shape",
          "segments": [
            {
              "kind": "speech",
              "text": "て — te."
            },
            {
              "kind": "speech",
              "text": "One continuous stroke: begin across the top, turn back, then sweep down and right. Keep the lower curve open."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "speech",
              "text": "Trace て (te) once."
            },
            {
              "kind": "speech",
              "text": "Copy it once, then retrieve it after ten seconds."
            },
            {
              "kind": "speech",
              "text": "Join the earned ending: い | っ (small tsu) | て (te)."
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "speech",
              "text": "Read いって once without romanization."
            },
            {
              "kind": "speech",
              "text": "Source: Unicode Hiragana chart; stroke order per Hitsujun Shido no Tebiki (Japanese Ministry of Education, 1958)."
            },
            {
              "kind": "activity",
              "scored": true,
              "id": "JA-W11-te-write",
              "prompt": "Write the hiragana sign for te.",
              "assesses": [
                "JA-SCRIPT-TE-01"
              ],
              "responseSeconds": 10,
              "acceptedResponses": [
                "て",
                "hiragana te"
              ],
              "feedback": {
                "correct": "Right: て closes the readable block いって.",
                "incorrect": "Use one turning stroke with an open lower curve: て."
              }
            }
          ]
        }
      ]
    },
    {
