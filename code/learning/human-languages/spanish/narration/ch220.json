  "title": "Tampoco --- The Same Frame, the Other Half",
  "drivablePrefix": 1,
  "sourceHash": "fnv1a64:04c87d7850de7de1",
  "lessons": [
    {
      "id": "ES-C58-tampoco",
      "sequence": 2335,
      "title": "tampoco — the same frame, the other half",
      "headword": "tampoco",
      "romanization": "tampoco",
      "gloss": "neither — the same tan, a different second half, and the word that lets you agree with a no",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:b449e45ff9771482",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Yo también agrees with somebody who said a yes."
            },
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "speech",
              "text": "But what do you say to somebody who said a no? English changes word there too — me too becomes me neither."
            }
          ]
        },
        {
          "index": 1,
          "type": "pronunciation",
          "title": "Sounds you'll need",
          "segments": [
            {
              "kind": "speech",
              "text": "k-hard — the c before o is a plain k. tampoco = tam-PO-ko, with no accent to write, because the stress already falls where Spanish expects it."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart: tampoco",
          "segments": [
            {
              "kind": "speech",
              "text": "tampoco = tan + poco."
            },
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The same tan you met yesterday. The new half is poco, which means little — a small amount of something."
            },
            {
              "kind": "table",
              "headers": [
                "",
                "",
                ""
              ],
              "columns": 3,
              "rowCount": 2,
              "utterances": [
                "también, tan + bien, so well.",
                "tampoco, tan + poco, so little."
              ]
            },
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "One frame, two fillings. You are not learning a second word here so much as turning the first one over."
            }
          ]
        },
        {
          "index": 3,
          "type": "culture-pragmatics",
          "title": "Why it's said this way",
          "segments": [
            {
              "kind": "speech",
              "text": "— No estoy cansado. — Yo tampoco."
            },
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The rule is simple and it is about the other person's sentence, not yours. If what they said was positive, you answer yo también. If it had a no in it, you answer yo tampoco."
            },
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Getting this wrong is one of the most audible mistakes a learner can make, and it is entirely avoidable: listen for the no. If you heard one, use the poco word."
            }
          ]
        },
        {
          "index": 4,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "Yo también, then Yo tampoco",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *Yo también*, then *Yo tampoco*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "No estoy cansado. — Yo tampoco.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *No estoy cansado. — Yo tampoco.*]"
            },
            {
              "kind": "repeat",
              "times": 2,
              "source": "[REPEAT x2]"
            },
            {
              "kind": "activity",
              "scored": true,
              "id": "ES-C58-tampoco-agree",
              "prompt": "Somebody says No estoy cansado. Agree, in two words.",
              "assesses": [
                "ES-LEX-TAMPOCO"
              ],
              "responseSeconds": 12,
              "acceptedResponses": [
                "yo tampoco",
                "yo tampoco!"
              ],
              "feedback": {
                "correct": "Their sentence had a no in it, so yours takes tampoco.",
                "incorrect": "Yo tampoco."
              }
            },
            {
              "kind": "activity",
              "scored": true,
              "id": "ES-C58-tampoco-parts",
              "prompt": "What two words is tampoco made of?",
              "assesses": [
                "ES-ETYMON-TAMPOCO-TAN-POCO"
              ],
              "responseSeconds": 13,
              "acceptedResponses": [
                "tan and poco",
                "tan poco, so little"
              ],
              "feedback": {
                "correct": "So little -- the same frame as tan + bien.",
                "incorrect": "Tan + poco -- so little."
              }
            },
            {
              "kind": "activity",
              "scored": true,
              "id": "ES-C58-tampoco-choose",
              "prompt": "Which word tells you to answer tampoco rather than tambien?",
              "assesses": [
                "ES-LEX-TAMPOCO"
              ],
              "responseSeconds": 12,
              "acceptedResponses": [
                "no",
                "the no in their sentence"
              ],
              "feedback": {
                "correct": "Listen for the no; it decides for you.",
                "incorrect": "The no in what they said."
              }
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Tan + bien is so well. What is tan + poco? (So little — tampoco.)"
            },
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "And what in the other person's sentence decides between the two? (A no.)"
            }
          ]
        }
      ]
    }
  ],
