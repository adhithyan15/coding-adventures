        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: die Diskussion",
          "segments": [
            {
              "kind": "speech",
              "text": "die Diskussion — \"the discussion\"."
            },
            {
              "kind": "speech",
              "text": "Nach dem Film gab es eine lange Diskussion. After the film there was a long discussion."
            },
            {
              "kind": "speech",
              "text": "Plural: die Diskussionen. It goes with the verb diskutieren."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Diskussion was borrowed from Latin discussiō (EtymDB), from discutere \"to strike apart, to scatter\", which later came to mean \"to examine\" (Lewis & Short)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
