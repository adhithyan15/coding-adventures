      ],
      "sourceHash": "fnv1a64:9a8704e84ed82550",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: what did ārōgyaṁ mean?"
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: కూడా",
          "segments": [
            {
              "kind": "speech",
              "text": "కూడా (kūḍā) — \"also\"."
            },
            {
              "kind": "speech",
              "text": "కూడా (kūḍā) goes after the thing it is adding, not before it. నేను కూడా (kūḍā) is \"me too\"; పెరుగు కూడా (kūḍā) is \"the curd as well\"."
            },
            {
              "kind": "speech",
              "text": "English can drop \"also\" almost anywhere in a sentence and let the stress carry the meaning. Telugu puts కూడా (kūḍā) straight after whatever it includes, and that placement does the work the stress would have done."
            },
            {
              "kind": "speech",
              "text": "It is a small word that softens a great deal. Adding కూడా (kūḍā) to an answer turns a flat అవును into agreement with the person who asked."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "The first joining word."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "kūḍā",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *kūḍā*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "it once more, slowly",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: it once more, slowly]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "nēnu kūḍā, then perugu kūḍā, and say what each one adds",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *nēnu kūḍā*, then *perugu kūḍā*, and say what each one adds]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What does కూడా (kūḍā) mean? (\"also\".) Say it once more."
            }
          ]
        }
      ]
    },
    {
      "id": "TE-C64-only",
      "sequence": 2040,
      "title": "మాత్రమే (mātramē) — only",
      "headword": "మాత్రమే",
      "romanization": "mātramē",
      "gloss": "only",
      "script": "telugu",
      "modality": "voice",
