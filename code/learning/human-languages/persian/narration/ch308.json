          "segments": [
            {
              "kind": "speech",
              "text": "گزارش دادن (gozâresh dâdan) — \"to report\"."
            },
            {
              "kind": "speech",
              "text": "راننده تصادف را به پلیس گزارش داد. Rânande tasâdof râ be polis gozâresh dâd. The driver reported the crash to the police."
            },
            {
              "kind": "speech",
              "text": "Present stem dah-: gozâresh midahad. The thing reported takes râ; the person told takes be."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "gozâresh dâdan joins the native noun gozâresh \"a report\" with dâdan \"to give\", which EtymDB takes back to the Indo-European root deh₃-: to give a report."
            }
          ]
        },
