          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "belegen is inherited from Old High German bileggen (EtymDB), built with be- on legen \"to lay\": you lay proof down. EtymDB lists English belay as a cousin."
            }
          ]
