          "index": 1,
          "type": "input",
          "title": "You'll want to know: der Auffahrunfall",
          "segments": [
            {
              "kind": "speech",
              "text": "der Auffahrunfall — \"the rear-end collision\"."
            },
            {
              "kind": "speech",
              "text": "Im Stau gibt es einen kleinen Auffahrunfall. There is a small rear-end collision in the traffic jam."
            },
            {
              "kind": "speech",
              "text": "Plural: die Auffahrunfälle."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Auffahrunfall is built from auffahren 'to drive into the car in front' and Unfall 'accident', inherited from Middle High German unval 'mishap' (EtymDB)."
            }
          ]
        },
        {
