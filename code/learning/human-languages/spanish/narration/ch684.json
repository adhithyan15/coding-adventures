          "index": 1,
          "type": "input",
          "title": "You'll want to know: el forastero",
          "segments": [
            {
              "kind": "speech",
              "text": "el forastero — \"the outsider, the stranger (from out of town)\"."
            },
            {
              "kind": "speech",
              "text": "En el pueblo todos saben quién es forastero. In the village everyone knows who is from out of town."
            },
            {
              "kind": "speech",
              "text": "As an adjective: gente forastera. It is not quite extranjero, a foreigner."
            }
          ]
        },
