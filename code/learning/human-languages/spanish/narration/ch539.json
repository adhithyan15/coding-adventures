          "title": "You'll want to know: la quincena",
          "segments": [
            {
              "kind": "speech",
              "text": "la quincena — \"the fortnight, two weeks\"."
            },
            {
              "kind": "speech",
              "text": "Nos fuimos de vacaciones la primera quincena de agosto. We went on holiday in the first two weeks of August."
            },
            {
              "kind": "speech",
              "text": "Some workers are paid por quincenas, every two weeks."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "quincena is built on quince 'fifteen' (EtymDB), which is inherited from Latin quīndecim 'fifteen', from quīnque 'five' and decem 'ten' (Lewis & Short). A fortnight is counted as fifteen days."
            }
          ]
        },
