        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: reduzieren",
          "segments": [
            {
              "kind": "speech",
              "text": "reduzieren — \"to reduce\"."
            },
            {
              "kind": "speech",
              "text": "Im Januar reduziert das Kaufhaus alle Preise. In January the department store reduces all its prices."
            },
            {
              "kind": "speech",
              "text": "Past participle without ge-: reduziert — reduced, on price tags."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "reduzieren is a learned borrowing from Latin redūcere 'to lead back, to bring back' (Lewis & Short); EtymDB lists the German word."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
