          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "falake is usually traced to Arabic falak 'the turning sphere of the sky, a circle', with the Persian ending -e. EtymDB does not list it."
            }
          ]
        },
