        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: licencier",
          "segments": [
            {
              "kind": "speech",
              "text": "licencier — \"to dismiss, to lay off\"."
            },
            {
              "kind": "speech",
              "text": "L'usine a licencié cinquante ouvriers. The factory laid off fifty workers."
            },
            {
              "kind": "speech",
              "text": "Formal; in speech people also say renvoyer."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "licencier is built on licence \"leave, permission\", from Latin licentia \"freedom, licence\" (Lewis & Short), from licēre \"to be allowed\": first, to give someone leave to go."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
