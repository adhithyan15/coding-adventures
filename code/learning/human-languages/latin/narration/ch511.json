          "segments": [
            {
              "kind": "speech",
              "text": "laedō, laedere — \"to hurt, harm; to offend\"."
            },
            {
              "kind": "speech",
              "text": "Verba tua amīcum laedunt. Your words hurt your friend."
            },
            {
              "kind": "speech",
              "text": "laedō, laedere, laesī, laesum. Of the body and of feelings. English lesion."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "laedō is a native Latin verb; Lewis & Short offers a guess at its root, but the origin is not settled. English lesion comes from its participle laesus, and collide from the compound collīdō."
            }
          ]
        },
