            },
            {
              "kind": "speech",
              "text": "What does పొలం (polaṁ) mean? (\"a field\".) Say it once more."
            }
          ]
        }
      ]
    },
    {
      "id": "TE-C66-paddy",
      "sequence": 2140,
      "title": "వరి (vari) — paddy, rice still in the field",
      "headword": "వరి",
      "romanization": "vari",
      "gloss": "paddy, rice still in the field",
      "script": "telugu",
      "modality": "voice",
      "derivedModality": "voice",
