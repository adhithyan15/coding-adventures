          "segments": [
            {
              "kind": "speech",
              "text": "cancellare comes from Latin cancellāre \"to make like a lattice, to cross out\" (Lewis & Short), from cancellī \"a lattice, bars\": lines drawn across a text. The word cancello \"gate\" shares it."
            }
          ]
        },
