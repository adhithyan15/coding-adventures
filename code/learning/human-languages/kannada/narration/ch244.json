        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ಸರಿಸು",
          "segments": [
            {
              "kind": "speech",
              "text": "ಸರಿಸು — sarisu — \"to move aside, to shift\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ಸರಿಸು (sarisu) is native Dravidian, from sari, \"to move, go to one side\", which DEDR 2360 lists, with -isu, \"to make\"; the entry also has Tamil cari and Telugu jaragu."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
