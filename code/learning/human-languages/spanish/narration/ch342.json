              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *el horario de hoy*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "¿cuál es el horario?",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *¿cuál es el horario?*]"
            }
          ]
        },
        {
          "index": 6,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What does the -ario ending do? (Makes a thing to do with.) And what is a horoscope, word for word? (A reading of the hour.)"
            }
          ]
        }
      ]
