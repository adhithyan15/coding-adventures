              "action": "SAY",
              "instruction": "murgī",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *murgī*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
