    {
      "id": "ZH-W133-sao-sweep",
      "sequence": 10515,
      "title": "扫 (sǎo) — the hand piece, then three bars",
      "headword": "扫",
      "romanization": "sǎo",
      "gloss": "扫 — the hand piece, then a turning bar and two bars",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:b41d1b474c3d47d0",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — the hand piece, then three bars",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — the hand piece, then three bars and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say dǎsǎo — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *dǎsǎo* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "打 手."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — dǎ, shǒu",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *dǎ*, *shǒu*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — the hand piece, then three bars",
          "segments": [
            {
              "kind": "speech",
              "text": "扫 (sǎo)."
            },
            {
              "kind": "speech",
              "text": "Two pieces, left before right."
            },
            {
              "kind": "speech",
              "text": "The hand piece, three strokes, as in 打: a horizontal, a vertical that hooks to the left at its foot, then a stroke that rises to the right across it."
            },
            {
              "kind": "speech",
              "text": "The right piece, three strokes. A horizontal that turns down at its right end, a horizontal across the middle, then a horizontal along the foot, which runs out past the right side."
            },
            {
              "kind": "speech",
              "text": "3 + 3 = six."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "扫 (sǎo), all six, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 扫, all six, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Which piece of 扫 (sǎo) comes from 打? (The hand piece, on the left.) How many strokes on the right? (Three.) Which bar runs out past the side? (The bottom one.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 扫 (sǎo), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
