# Perl 5.003 (1996-06-25) grammar: verified arithmetic-print subset only.
# @version 1
# PARTIAL: unsupported Perl 5.003 syntax is rejected.
# Evidence: https://github.com/Perl/perl5/blob/perl-5.003/perly.y
# The tagged yacc grammar has ADDOP/MULOP precedence, unary minus, and
# parenthesized terms. Only `print` is admitted here.

program         = print_statement { print_statement } ;
print_statement = PRINT LPAREN expr RPAREN SEMICOLON ;
expr            = term { ( PLUS | MINUS ) term } ;
term            = unary { STAR unary } ;
unary           = MINUS unary | atom ;
atom            = INT | LPAREN expr RPAREN ;
