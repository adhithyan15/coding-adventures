          "index": 1,
          "type": "input",
          "title": "You'll want to know: ineptus, inepta, ineptum",
          "segments": [
            {
              "kind": "speech",
              "text": "ineptus, inepta, ineptum — \"silly, foolish; tactless\"."
            },
            {
              "kind": "speech",
              "text": "Fābula inepta est, sed puerī rīdent. The story is silly, but the children laugh."
            },
            {
              "kind": "speech",
              "text": "in- 'not' + aptus 'fitting': someone who says the wrong thing at the wrong time. English inept."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ineptus is built on in- \"not\" and aptus \"fitting\" (Lewis & Short). English inept comes from it."
            }
          ]
        },
