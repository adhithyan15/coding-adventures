              "source": "[YOU SAY: *maiṁ kheltā hūṁ*]"
            },
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "खेल (khel), then add ना to the end of it",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: खेल, then add ना to the end of it]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What does खेलना (khelnā) mean? (\"to play\".) And खेल? (\"a game\".)"
            }
          ]
        }
      ]
