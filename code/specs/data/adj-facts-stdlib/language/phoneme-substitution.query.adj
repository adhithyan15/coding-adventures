% ============================================================================
% phoneme-substitution.query.adj — worked recall over the phoneme-
% substitution library.
% ============================================================================
% The shape a learner (or an LLM) produces to ANSWER "what word do I get if
% I change this sound?" (direct) or "what was the original word and sound?"
% (reverse) — it states no fact of its own — it only `import`s the grounded
% table and asks binding queries.
% ============================================================================

import "phoneme-substitution.adj"

? phoneme_substitution(make, m, b, $New)              % expect bake (direct: change make's /m/ to /b/)
? phoneme_substitution($Orig, $OrigSound, b, bake)     % expect make, m (reverse: what changed into "bake"?)
? phoneme_substitution(cat, c, b, $New)                % expect abstain -- this substitution is not tabled
