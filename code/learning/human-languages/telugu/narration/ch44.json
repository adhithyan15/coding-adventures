          "segments": [
            {
              "kind": "speech",
              "text": "చూడు (cūḍu) — \"look\"."
            },
            {
              "kind": "speech",
              "text": "Also 'to see' and 'to look after', the same three-way stem as its Kannada cousin nōḍu — the languages are close enough that the pattern travels."
            }
          ]
        },
        {
