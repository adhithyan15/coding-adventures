          "segments": [
            {
              "kind": "speech",
              "text": "wenigstens — \"at least\"."
            },
            {
              "kind": "speech",
              "text": "Es hat geregnet, aber wenigstens war es warm. It rained, but at least it was warm."
            },
            {
              "kind": "speech",
              "text": "Close to mindestens, which mostly goes with numbers: mindestens drei Tage."
            }
          ]
        },
