        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: साप",
          "segments": [
            {
              "kind": "speech",
              "text": "साप — sāp — \"a snake\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "साप (sāp) is a tadbhava, a word inherited from Sanskrit and reshaped by sound change. It comes from sarpa, \"snake\" (CDIAL 13271). It is built on sṛp, \"to creep\"."
            }
          ]
        },
