        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: lo spavento",
          "segments": [
            {
              "kind": "speech",
              "text": "lo spavento — \"fright, scare\"."
            },
            {
              "kind": "speech",
              "text": "Che spavento! Credevo di aver perso le chiavi. What a fright! I thought I had lost the keys."
            },
            {
              "kind": "speech",
              "text": "Prendersi uno spavento — to get a fright."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "spavento comes from spaventare \"to frighten\", usually traced to Vulgar Latin expaventāre, built on Latin pavēre \"to be afraid\" (Lewis & Short)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
