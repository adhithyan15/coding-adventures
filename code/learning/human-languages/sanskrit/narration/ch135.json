        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "śikṣate comes from the desiderative of the root √śak \"be able\" (MW): \"wishes to be able\", and so \"learns\". It lives on as Hindi sīkhnā \"to learn\" (CDIAL 12430)."
            }
          ]
        },
