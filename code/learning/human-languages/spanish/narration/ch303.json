      "title": "otra vez — another turn round",
      "headword": "otra vez",
      "romanization": "otra vez",
      "gloss": "again — literally another turn; vez is Latin vicem, a turn taken in rotation",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
