        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: der Erzähler",
          "segments": [
            {
              "kind": "speech",
              "text": "der Erzähler — \"the narrator, the storyteller\"."
            },
            {
              "kind": "speech",
              "text": "Der Erzähler spricht sehr leise. The narrator speaks very quietly."
            },
            {
              "kind": "speech",
              "text": "Plural: die Erzähler. Feminine die Erzählerin."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Erzähler is built on erzählen \"to tell\", from zählen \"to count\", Old High German zellen, Proto-Germanic taljaną (EtymDB): to count out events one by one."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
            }
          ]
        },
