          "segments": [
            {
              "kind": "speech",
              "text": "పదండి (padaṇḍi) — \"let's go\", said to the group you are leaving with."
            },
            {
              "kind": "speech",
              "text": "It carries the respectful -అండి like raṇḍi and āgaṇḍi, so it stays polite even when it hurries people along."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "పదండి (padaṇḍi) carries the polite ending -aṇḍi. The origin of the verb in front of it is uncertain: neither DEDR nor CDIAL records it."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "Take care, come soon, I am going home, farewell, let's go: a whole exit."
            }
          ]
        },
