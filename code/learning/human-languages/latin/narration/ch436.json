          "segments": [
            {
              "kind": "speech",
              "text": "onerārius, onerāria, onerārium — \"for cargo, for carrying loads\"."
            },
            {
              "kind": "speech",
              "text": "Nāvēs onerāriae frūmentum ad urbem vehunt. Cargo ships carry grain to the city."
            },
            {
              "kind": "speech",
              "text": "An adjective of three endings. Nāvis onerāria, a merchant ship, or onerāria on its own; iūmentum onerārium, a pack animal."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "onerārius is built on onus, oneris 'a load' with the suffix -ārius (EtymDB; Lewis & Short). English onerary 'fit for loads' is a rare borrowing of it."
            }
          ]
        },
