              "instruction": "“Tomorrow, I will read” — śvaḥ paṭhiṣyāmi",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: “Tomorrow, I will read” — *śvaḥ paṭhiṣyāmi*]"
            },
            {
