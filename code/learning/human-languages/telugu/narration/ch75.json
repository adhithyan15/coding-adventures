              "action": "SAY",
              "instruction": "ask eppuḍu, then answer it with ivāḷa",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: ask *eppuḍu*, then answer it with *ivāḷa*]"
            },
            {
              "kind": "prompt",
