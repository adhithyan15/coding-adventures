            },
            {
              "kind": "speech",
              "text": "Messōrēs sub sōle ardentī frūmentum metunt. The reapers cut the grain under the burning sun."
            },
            {
              "kind": "speech",
              "text": "Third declension, masculine: messor, messōris m., from metō with the agent ending -or."
            }
          ]
