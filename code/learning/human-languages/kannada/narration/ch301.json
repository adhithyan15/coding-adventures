        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ಗಾಜು",
          "segments": [
            {
              "kind": "speech",
              "text": "ಗಾಜು — gāju — \"glass (the material)\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ಗಾಜು (gāju) is probably a tadbhava of Sanskrit kāca, \"glass\" (CDIAL 3007): k became g and c became j. CDIAL does not list the Kannada word."
            }
          ]
        },
