            {
              "kind": "speech",
              "text": "Before the new one: say the Marathi for behind, then the Marathi for ahead."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: दुकान",
          "segments": [
            {
              "kind": "speech",
              "text": "दुकान — dukān — \"a shop\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "दुकान (dukān) is a loan from Arabic dukkān, \"shop\", which reached Marathi through Persian. Its Arabic root is d-k-n (Lane)."
            }
          ]
        },
        {
