        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "کہنی (kohnī) is a tadbhava, a word inherited from Sanskrit and reshaped by sound change. It comes from kaphoṇi, \"elbow\" (CDIAL 2757). CDIAL prefers a Munda source for the Sanskrit word to a Dravidian one."
            }
          ]
        },
