          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "دیور (devar) is inherited from Sanskrit dēvara, \"husband's younger brother\" (CDIAL 6546)."
            }
          ]
        },
