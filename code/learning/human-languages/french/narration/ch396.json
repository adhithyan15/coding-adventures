              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: say the French for to connect, then the French for to access."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: installer",
          "segments": [
            {
              "kind": "speech",
              "text": "installer — \"to install; to set up\"."
            },
            {
              "kind": "speech",
              "text": "J'ai installé une nouvelle application sur mon téléphone. I installed a new app on my phone."
            },
            {
              "kind": "speech",
              "text": "S'installer — to settle in, to move in."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "installer is usually traced to Medieval Latin installāre \"to put into a stall, to install in office\", built on a Germanic word for a stall; EtymDB lists relatives such as Old English steall \"a standing place\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
            }
          ]
        },
        {
          "index": 4,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
