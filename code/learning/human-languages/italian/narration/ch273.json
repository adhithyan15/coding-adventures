          "segments": [
            {
              "kind": "speech",
              "text": "in seguito — \"later on, afterwards\"."
            },
            {
              "kind": "speech",
              "text": "In seguito ho trovato un lavoro migliore. Later on I found a better job."
            },
            {
              "kind": "speech",
              "text": "In seguito a + a noun means ‘following, as a result of’: in seguito all'incidente."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "seguito is the past participle of seguire \"to follow\", which is inherited from Latin sequī \"to follow\" (Lewis & Short)."
            }
          ]
        },
