        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: jiǎngshù",
          "segments": [
            {
              "kind": "speech",
              "text": "jiǎngshù — \"to tell about; to give an account of\"."
            },
            {
              "kind": "speech",
              "text": "tā gěi wǒmen jiǎngshù le nàge shíqī de shēnghuó — He told us what life was like in that period."
            },
            {
              "kind": "speech",
              "text": "Its characters come later; for now it is a word for the ear."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "jiǎngshù is built from jiǎng and shù, both inherited from Middle Chinese, kaewngX and zywit (Guangyun, in Baxter's transcription), which glosses the first 'to tell' and 'to discuss' and the second 'to set forth in writing'."
            }
          ]
        },
