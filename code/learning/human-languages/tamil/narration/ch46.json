          "segments": [
            {
              "kind": "speech",
              "text": "மருத்துவர் (maruttuvar) — \"a doctor\"."
            },
            {
              "kind": "speech",
              "text": "This one is Tamil's own. It stands on மருந்து (marundu), 'medicine', and takes the same respectful -ar: the person who deals in medicine."
            },
            {
              "kind": "speech",
              "text": "Beside it sits vaittiyar, from Sanskrit vaidya, doing the same work with borrowed material. Where a language has both, it usually has a preference, and modern Tamil leans on maruttuvar — the signboard on the hospital says so."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "Three, and the third one you hope to need rarely."
            }
          ]
        },
        {
