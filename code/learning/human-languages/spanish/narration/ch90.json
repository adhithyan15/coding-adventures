    {
      "id": "ES-C17-condicional",
      "sequence": 1282,
      "title": "hablaría — the whole infinitive meets -ía",
      "headword": "hablaría",
      "romanization": "hablaría",
      "gloss": "the singular conditional of hablar — hablaría, hablarías, hablaría",
      "script": "latin",
