          "segments": [
            {
              "kind": "speech",
              "text": "calculus, calculī — \"a pebble, a counter; a reckoning\"."
            },
            {
              "kind": "speech",
              "text": "Calculīs numerābat. He was counting with pebbles."
            },
            {
              "kind": "speech",
              "text": "calculus, calculī m., a little stone. Calculum pōnere, to reckon. English calculate and calculus."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "calculus is a small form of calx, calcis \"a stone, lime\" (Lewis & Short): a little pebble used for counting. English calculate comes from it."
            }
          ]
        },
