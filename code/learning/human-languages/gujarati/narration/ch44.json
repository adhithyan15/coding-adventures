      "title": "(reading) (ghar · bajār · śāḷā · dukān · pāṇī · pustak) (tame kem chho? hũ majāmā̃ chhũ.) (mārũ nām mīrā chhe. tame kem chho?) — six words off a signboard",
      "headword": "(reading)",
      "romanization": "ghar · bajār · śāḷā · dukān · pāṇī · pustak",
      "gloss": "six words off a signboard — the first time the book asks you to read one rather than to write it",
      "script": "gujarati",
      "modality": "sight",
      "derivedModality": "sight",
      "modalityReasons": [
        "reading-type"
      ],
      "sourceHash": "fnv1a64:16e75c33df917713",
      "notice": {
        "modality": "sight",
        "needs": [
          "your eyes, to read the printed text yourself"
        ],
        "waitUntilStopped": [
          "Reading"
        ],
        "text": "Before we start: this one needs your eyes, so it is not fully a driving lesson. You will want your eyes, to read the printed text yourself. You can listen to everything else now — leave the section called Reading until you have stopped, and I will say so again when we reach it."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "You have written every one of these. Not one is new."
            },
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "speech",
              "text": "What is new is that nobody is going to say them first."
            }
          ]
        },
        {
          "index": 1,
          "type": "comprehension",
          "title": "Reading",
          "segments": [
            {
              "kind": "speech",
              "text": "ઘર બજાર શાળા દુકાન પાણી પુસ્તક."
            },
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "down the list once; do not build each one sign by sign — take in the whole word and let it arrive",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: down the list once; do not build each one sign by sign — take in the whole word and let it arrive]"
            },
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "the list again, and notice which came at once and which you had to assemble",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: the list again, and notice which came at once and which you had to assemble]"
            },
            {
              "kind": "speech",
              "text": "Both are fine. The difference is what practice removes."
            }
          ]
        },
        {
          "index": 2,
          "type": "input",
          "title": "You'll want to know",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Writing gave you the signs in order and all the time you wanted. A signboard gives you one look."
            },
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "These six are the ones you would actually meet painted on something — over a shop, on a school gate, beside a tap."
            },
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "That is why six is enough for one sitting."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "the six words down the list, once, without stopping",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: the six words down the list, once, without stopping]"
            },
            {
              "kind": "repeat",
              "times": 2,
              "source": "[REPEAT x2]"
            },
            {
              "kind": "activity",
              "scored": true,
              "id": "GU-C44-words-shop",
              "prompt": "Which word is over the shop?",
              "assesses": [
                "GU-SKILL-READ-WORDS"
              ],
              "responseSeconds": 12,
              "acceptedResponses": [
                "dukaan",
                "દુકાન",
                "shop"
              ],
              "feedback": {
                "correct": "દુકાન.",
                "incorrect": "દુકાન -- shop."
              }
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "How many of the six were new? (None.)"
            },
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "What was new? (Nobody said them first. You read them.)"
            }
          ]
        }
      ]
    },
    {
