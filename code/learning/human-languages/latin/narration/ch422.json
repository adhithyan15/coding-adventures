          "segments": [
            {
              "kind": "speech",
              "text": "careō, carēre — \"to be without, to lack\"."
            },
            {
              "kind": "speech",
              "text": "Multī cīvēs domō carent. Many citizens have no home."
            },
            {
              "kind": "speech",
              "text": "careō, carēre, caruī + ablative: careō pecūniā, I have no money. Unlike egeō, it says the thing is absent without saying that you need it."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "careō is inherited from Proto-Italic kazēō (EtymDB), from a Proto-Indo-European root meaning \"to cut\": to be cut off from a thing."
            }
          ]
        },
