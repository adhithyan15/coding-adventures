        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: kennenlernen",
          "segments": [
            {
              "kind": "speech",
              "text": "kennenlernen — \"to get to know, to meet\"."
            },
            {
              "kind": "speech",
              "text": "Wir haben uns im Sprachkurs kennengelernt. We met on a language course."
            },
            {
              "kind": "speech",
              "text": "Separable: ich lerne ihn kennen, hat kennengelernt. Also written as two words: kennen lernen."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "kennenlernen is built on kennen \"to know\", inherited from Old High German kennan, from Proto-Germanic kannijaną, and lernen \"to learn\" (EtymDB)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
