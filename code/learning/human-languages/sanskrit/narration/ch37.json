              "instruction": "samyak, then śāntiḥ",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *samyak*, then *śāntiḥ*]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
