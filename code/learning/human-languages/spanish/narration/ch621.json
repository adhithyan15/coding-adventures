        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: impedir",
          "segments": [
            {
              "kind": "speech",
              "text": "impedir — \"to stop, to prevent\"."
            },
            {
              "kind": "speech",
              "text": "La lluvia nos impidió salir. The rain stopped us going out."
            },
            {
              "kind": "speech",
              "text": "Like pedir: impido, impidió."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "impedir is a learned borrowing from Latin impedire 'to hinder, to entangle the feet', built on pes, pedis 'foot' (EtymDB)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
