        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: حمایت کردن",
          "segments": [
            {
              "kind": "speech",
              "text": "حمایت کردن (hemâyat kardan) — \"to support, to back\"."
            },
            {
              "kind": "speech",
              "text": "خانواده ام همیشه از من حمایت میکنند. khânevâde-am hamishe az man hemâyat mikonand. My family always supports me."
            },
            {
              "kind": "speech",
              "text": "az kasi hemâyat kardan; hemâyat 'protection, support' + kardan."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "hemâyat comes from Arabic ḥimāya, 'protection' (EtymDB). kardan, 'to do', is inherited Persian."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
