        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: melden",
          "segments": [
            {
              "kind": "speech",
              "text": "melden — \"to report, to announce; reflexive: to get in touch\"."
            },
            {
              "kind": "speech",
              "text": "Die Zeitung meldete einen großen Unfall. The newspaper reported a big accident."
            },
            {
              "kind": "speech",
              "text": "Reflexive, it means to get in touch: Ich melde mich morgen."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "melden is inherited from Old High German meldōn, which EtymDB traces to Proto-Germanic melþōną \"to make known, to give away\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
