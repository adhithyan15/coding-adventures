        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: चलः",
          "segments": [
            {
              "kind": "speech",
              "text": "चलः — calaḥ — \"moving, unsteady\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "cala is built on the root √cal, \"to move, stir, tremble\" (MW; CDIAL 4713). MW compares Latin celer, \"swift\". The verb calati lives on as Hindi calnā, \"to move, go\" (CDIAL 4715)."
            }
          ]
        },
