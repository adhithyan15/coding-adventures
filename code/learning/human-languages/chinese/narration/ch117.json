        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: dōngbian",
          "segments": [
            {
              "kind": "speech",
              "text": "dōngbian — \"the east; on the east side\"."
            },
            {
              "kind": "speech",
              "text": "chēzhàn zài dōngbian — The station is on the east side."
            },
            {
              "kind": "speech",
              "text": "Its characters come later; for now it is a word for the ear."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "dōngbian is built from dōng 'east' and 边 'side', both inherited from Middle Chinese, tuwng and pen (Guangyun, in Baxter's transcription); the dictionary calls the east the direction of spring, and repeats an old reading of the character as the sun inside a tree."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for asking where things are."
            }
          ]
        },
