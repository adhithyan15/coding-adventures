            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Latin for not yet, then the Latin for at last."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: repente",
          "segments": [
            {
              "kind": "speech",
              "text": "repente — \"suddenly, unexpectedly\"."
            },
            {
              "kind": "speech",
              "text": "Repente magna pluvia cecidit, et omnēs fūgērunt. Suddenly heavy rain fell, and everyone ran away."
            },
            {
              "kind": "speech",
              "text": "The ablative of the old adjective repēns, 'sudden'. Close to subitō (taught), and common in Livy."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "repente is the ablative of repēns, \"sudden\" (Lewis & Short), used as an adverb. Where repēns itself comes from is not settled."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
