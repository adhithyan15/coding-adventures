          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ولیمہ (valīmā) is usually traced, through Persian, to Arabic walīma, \"a wedding feast\"."
            }
          ]
        },
