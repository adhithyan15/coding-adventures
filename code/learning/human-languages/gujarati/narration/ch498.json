              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *vidāy*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "dīkrīnī vidāy vakhte mātā raḍī paḍī. — At her daughter's send-off the mother burst into tears.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *dīkrīnī vidāy vakhte mātā raḍī paḍī.* — At her daughter's send-off the mother burst into tears.]"
