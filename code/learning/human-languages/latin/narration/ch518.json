        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: latus, lateris",
          "segments": [
            {
              "kind": "speech",
              "text": "latus, lateris — \"side, flank\"."
            },
            {
              "kind": "speech",
              "text": "Dolor in latere sinistrō est. The pain is in the left side."
            },
            {
              "kind": "speech",
              "text": "Neuter, third declension. Not the adjective lātus — wide. English lateral."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "latus is a native Latin noun; Lewis & Short compares Greek platus \"broad\", but the origin is not settled. English lateral comes from it."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
