      "sequence": 20460,
      "title": "मात्र (mātra) — however; though",
      "headword": "मात्र",
      "romanization": "mātra",
      "gloss": "however; though",
      "script": "devanagari",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
