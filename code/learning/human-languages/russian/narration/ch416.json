          "segments": [
            {
              "kind": "speech",
              "text": "проводник (provodník) — \"a sleeping-car attendant; a guide\"."
            },
            {
              "kind": "speech",
              "text": "Проводник принёс нам чай. Provodník prinyós nam chay. The attendant brought us tea."
            },
            {
              "kind": "speech",
              "text": "Feminine проводница. The stress moves: проводника (provodniká). Also a conductor of electricity."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "проводник (provodník) is built on проводить 'to lead through' with -ник 'one who'. Водить is inherited from Proto-Slavic voditi 'to lead' (EtymDB)."
            }
          ]
        },
        {
