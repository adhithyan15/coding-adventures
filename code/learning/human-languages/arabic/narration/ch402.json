          "title": "You'll want to know: حتما",
          "segments": [
            {
              "kind": "speech",
              "text": "حتما — ḥatman — \"inevitably\"."
            },
            {
              "kind": "speech",
              "text": "سينجح حتما. sa-yanjaḥu ḥatman. He is bound to succeed."
            }
          ]
        },
