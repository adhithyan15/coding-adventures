              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: until; as long as, till then, so far, right away, late]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "a valley, a zoo, a university, a college, a dwelling",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: a valley, a zoo, a university, a college, a dwelling]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "a tea house, a church, a gurdwara, a graveyard, a minaret",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: a tea house, a church, a gurdwara, a graveyard, a minaret]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "but rather, perhaps, certainly, of course, regret; a pity",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: but rather, perhaps, certainly, of course, regret; a pity]"
            }
          ]
