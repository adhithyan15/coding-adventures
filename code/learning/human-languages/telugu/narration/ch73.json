        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: పులుపు",
          "segments": [
            {
              "kind": "speech",
              "text": "పులుపు (pulupu) — \"sour, sourness\"."
            },
            {
              "kind": "speech",
              "text": "పులుపు (pulupu) is sourness — tamarind, lime, పెరుగు left a day too long."
            },
            {
              "kind": "speech",
              "text": "It is inherited and it is not a complaint. A Telugu meal wants పులుపు (pulupu) in it on purpose; the everyday tamarind stew is built around exactly this taste."
            },
            {
              "kind": "speech",
              "text": "Said of a face it means what it means in English, and it is said most often of children who have just been told no."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "Two: తీపి (tīpi) and పులుపు (pulupu), and a meal wants both of them."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
