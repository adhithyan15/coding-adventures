    {
      "id": "ZH-W267-xiao-laugh",
      "sequence": 20015,
      "title": "笑 (xiào) — two small pieces over a short fall and 大",
      "headword": "笑",
      "romanization": "xiào",
      "gloss": "笑 — two small pieces on top, then a short fall and 大",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:974ff76448c4a45c",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — two small pieces over a short fall and 大",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — two small pieces over a short fall and 大 and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say xiàohua — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *xiàohua* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "大 天."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — dà, tiān",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *dà*, *tiān*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — two small pieces over a short fall and 大",
          "segments": [
            {
              "kind": "speech",
              "text": "笑 (xiào)."
            },
            {
              "kind": "speech",
              "text": "Two pieces, top before bottom."
            },
            {
              "kind": "speech",
              "text": "The top piece, six strokes: two small pieces side by side, each three strokes. A short stroke falling to the left, a short bar to the right from it, then a dot under the bar. Then the same three again on the right."
            },
            {
              "kind": "speech",
              "text": "The bottom piece, four strokes. A short stroke falling to the left across the top. Then 大: a long bar, a stroke falling to the left, and a stroke falling to the right."
            },
            {
              "kind": "speech",
              "text": "6 + 4 = ten."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "笑 (xiào), all ten, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 笑, all ten, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many strokes in 笑 (xiào)? (Ten.) How many small pieces sit on top? (Two, three strokes each.) Which character ends it? (大.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 笑 (xiào), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
