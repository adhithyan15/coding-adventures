          "title": "You'll want to know: diffuser",
          "segments": [
            {
              "kind": "speech",
              "text": "diffuser — \"to broadcast; to spread\"."
            },
            {
              "kind": "speech",
              "text": "La télé a diffusé le match en direct. The TV broadcast the match live."
            },
            {
              "kind": "speech",
              "text": "Also to spread news or a smell: diffuser une information."
