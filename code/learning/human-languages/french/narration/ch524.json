          "segments": [
            {
              "kind": "speech",
              "text": "projeter — \"to screen (a film); to plan; to project\"."
            },
            {
              "kind": "speech",
              "text": "Le cinéma du quartier projette des films en version originale. The local cinema screens films in the original language."
            },
            {
              "kind": "speech",
              "text": "Spelling: je projette, nous projetons. Also to plan: projeter un voyage."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "projeter comes from Old French porjeter \"to throw forward\", built on jeter \"to throw\", which goes back to Latin iactāre, from iacere \"to throw\" (Lewis & Short)."
            }
          ]
        },
