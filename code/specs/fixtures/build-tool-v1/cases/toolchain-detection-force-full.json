{
  "schema_version": 1,
  "id": "toolchain-detection/forced-full",
  "domain": "toolchain_detection",
  "summary": "Forced-full CI mode enables every canonical toolchain without consulting host state.",
  "platforms": ["darwin", "linux", "windows"],
  "capabilities": ["toolchain_detection"],
  "workspace": {"files": []},
  "input": {
    "operation": "toolchain_detection",
    "options": {
      "platform": "windows",
      "force_full": true,
      "packages": [
        {"name": "rust/app", "language": "rust", "build_files": {"BUILD": "# needs-toolchain: python\n"}}
      ],
      "scheduled_packages": null,
      "forced_toolchains": []
    }
  },
  "expected": {
    "schema_version": 1,
    "case_id": "toolchain-detection/forced-full",
    "domain": "toolchain_detection",
    "outcome": "ok",
    "result": {
      "toolchains": {
        "cpp": true,
        "dart": true,
        "dotnet": true,
        "elixir": true,
        "go": true,
        "haskell": true,
        "java": true,
        "kotlin": true,
        "lua": true,
        "ocaml": true,
        "perl": true,
        "python": true,
        "ruby": true,
        "rust": true,
        "swift": true,
        "typescript": true
      }
    },
    "diagnostics": []
  },
  "limits": {"wall_time_ms": 1000, "output_bytes": 1048576, "workspace_bytes": 1048576, "process_count": 1, "memory_mib": 128, "cpu_time_ms": 1000}
}
