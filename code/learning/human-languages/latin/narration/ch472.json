          "segments": [
            {
              "kind": "speech",
              "text": "neō, nēre — \"to spin (thread)\"."
            },
            {
              "kind": "speech",
              "text": "Ancillae vesperī lānam nent. In the evening the maids spin wool."
            },
            {
              "kind": "speech",
              "text": "neō, nēre, nēvī, nētum, second conjugation. Short forms: net 'she spins', nent 'they spin'."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "neō is inherited from Proto-Italic nēō, from PIE (s)neh₁- 'to spin' (EtymDB); Lewis & Short compare Greek neō. English needle is usually counted a distant Germanic cousin."
            }
          ]
        },
