          "segments": [
            {
              "kind": "speech",
              "text": "kōngtiáo — \"air conditioner; air conditioning\"."
            },
            {
              "kind": "speech",
              "text": "jīntiān tài rè le wǒmen kāi kōngtiáo — It's far too hot today: let's put the air conditioner on."
            },
            {
              "kind": "speech",
              "text": "Its characters come later; for now it is a word for the ear."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "kōngtiáo is built from kōng 'empty', here the air, and tiáo 'to adjust': a short name for the machine that adjusts the air. The first is inherited from Middle Chinese khuwng (Guangyun, in Baxter's transcription), glossed 'empty'; the second is listed there as dew, glossed 'to harmonize'."
            }
          ]
        },
