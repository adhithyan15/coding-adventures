          "type": "input",
          "title": "You'll want to know: protestar",
          "segments": [
            {
              "kind": "speech",
              "text": "protestar — \"to protest; to complain\"."
            },
            {
              "kind": "speech",
              "text": "Los vecinos protestan por el ruido. The neighbours are protesting about the noise."
            },
            {
              "kind": "speech",
              "text": "Protestar por or contra something."
            }
          ]
        },
