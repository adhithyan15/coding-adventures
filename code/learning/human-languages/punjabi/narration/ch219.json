            },
            {
              "kind": "speech",
              "text": "Say ਮੈਂ ਕੰਮ ਕੀਤਾ, \"I did the work\"."
            }
          ]
        },
        {
          "index": 1,
          "type": "grammar",
          "title": "Grammar Lens",
          "segments": [
            {
              "kind": "speech",
              "text": "In ਮੈਂ ਕੰਮ ਕੀਤਾ, ਕੀਤਾ agrees with the work, ਕੰਮ, not with the speaker: a woman says it the same way. Hold that next to two verbs that are also done to something: ਪੀਣਾ, ਖਾਣਾ."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
