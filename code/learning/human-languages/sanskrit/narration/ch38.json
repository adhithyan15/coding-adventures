          "segments": [
            {
              "kind": "speech",
              "text": "सिकता (sikatā) — \"sand\"."
            },
            {
              "kind": "speech",
              "text": "सिकता (sikatā) is sand — the grit of a bank, and the bank itself where it piles up."
            },
            {
              "kind": "speech",
              "text": "It has long been tied to sic, \"to pour, to sprinkle\": sand is the stuff that pours."
            },
            {
              "kind": "speech",
              "text": "Set it beside नदी and you have the two halves of a bank — the water, and what the water leaves at its edge."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "What a river puts down at its edge."
            }
          ]
        },
