            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Sanskrit for authority, then the Sanskrit for a question paper."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: सफलता",
          "segments": [
            {
              "kind": "speech",
              "text": "सफलता — saphalatā — \"success\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "saphalatā is built on saphala, \"with fruit, fruitful\" (CDIAL 13166), from sa-, \"with\", and phala, \"fruit\", with -tā, \"-ness\" (MW). Success is bearing fruit. CDIAL 9051 compares phala with Dravidian words for ripe fruit."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for this chapter."
            }
          ]
        },
        {
