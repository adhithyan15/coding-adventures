          "segments": [
            {
              "kind": "speech",
              "text": "a repercussão — \"the repercussion, the knock-on effect\"."
            },
            {
              "kind": "speech",
              "text": "A decisão teve repercussões em todo o país. The decision had repercussions across the whole country."
            },
            {
              "kind": "speech",
              "text": "Mostly plural: as repercussões."
            }
          ]
        },
