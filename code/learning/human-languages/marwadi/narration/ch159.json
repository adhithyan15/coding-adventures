    {
      "id": "MW-C159-gayo",
      "sequence": 9830,
      "title": "गयो, गई, गया — went",
      "headword": "गयो · गई · गया",
      "romanization": "gayo · gaī · gayā",
      "gloss": "went: the past of जाणो, agreeing with whoever went",
      "script": "devanagari",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:e5eece8e5910c26d",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Say I go to the market every day. Then yesterday, काल, and a boy, a girl."
            }
          ]
        },
        {
          "index": 1,
          "type": "grammar",
          "title": "Grammar Lens: one word for the past",
          "segments": [
            {
              "kind": "speech",
              "text": "गयो is the past of जाणो, all on its own: no हूं and no है after it."
            },
            {
              "kind": "speech",
              "text": "हूं काल बाजार गयो। hū̃ kāl bājār gayo. — I went to the market yesterday."
            },
            {
              "kind": "speech",
              "text": "It ends like छोरो, and changes like it, to agree with whoever went: गयो for a man, गई for a woman, गया for more than one."
            },
            {
              "kind": "speech",
              "text": "मां घरै गई। mā̃ gharai gaī. — Mother went home."
            },
            {
              "kind": "speech",
              "text": "सगळा घरै गया। sagḷā gharai gayā. — Everyone went home."
            },
            {
              "kind": "speech",
              "text": "With a past, काल is yesterday. CDIAL lists Old Marwari gayaü, \"gone\" (CDIAL 4008)."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "speech",
              "text": "A woman says हूं काल बाजार गई। (hū̃ kāl bājār gaī.)"
            },
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "राम काल बाजार गयो। — rām kāl bājār gayo. — Ram went to the market yesterday.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: **राम काल बाजार गयो।** — *rām kāl bājār gayo.* — Ram went to the market yesterday.]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "मां घरै गई। — mā̃ gharai gaī. — Mother went home.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: **मां घरै गई।** — *mā̃ gharai gaī.* — Mother went home.]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "वो कोनी गयो। — vo konī gayo. — He didn't go.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: **वो कोनी गयो।** — *vo konī gayo.* — He didn't go.]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "He went? (गयो.) She went, of mother? (गई.) Everyone went? (गया.)"
            },
            {
              "kind": "activity",
              "scored": true,
              "spoken": true,
              "id": "MW-C159-gayo-mother",
              "prompt": "Say that mother went home.",
              "assesses": [
                "MW-GRAMMAR-C159-GAYO-01"
              ],
              "responseSeconds": 12,
              "acceptedResponses": [
                "मां घरै गई।",
                "mā̃ gharai gaī",
                "ma gharai gai"
              ],
              "feedback": {
                "correct": "Right: गई, for a woman.",
                "incorrect": "Mother is a woman, so गई: मां घरै गई."
              }
            }
          ]
        }
      ]
