        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: der Bürgersteig",
          "segments": [
            {
              "kind": "speech",
              "text": "der Bürgersteig — \"the pavement (US: sidewalk)\"."
            },
            {
              "kind": "speech",
              "text": "Die Kinder fahren mit dem Roller auf dem Bürgersteig. The children ride their scooters on the pavement."
            },
            {
              "kind": "speech",
              "text": "Plural: die Bürgersteige. Also der Gehweg; in Switzerland das Trottoir."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Bürgersteig is built from Bürger 'townsman, citizen', from Burg 'castle, town', and Steig 'path', inherited from Old High German stīg (EtymDB)."
            }
          ]
        },
        {
