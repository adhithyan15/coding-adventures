          "title": "You'll want to know: la fierté",
          "segments": [
            {
              "kind": "speech",
              "text": "la fierté — \"pride\"."
            },
            {
              "kind": "speech",
              "text": "Mon père parle de mon travail avec fierté. My father speaks about my work with pride."
            },
            {
              "kind": "speech",
              "text": "Built on fier \"proud\"; a good kind of pride."
            }
