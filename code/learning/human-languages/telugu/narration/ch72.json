      ],
      "sourceHash": "fnv1a64:02dc9508ca9639dc",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: what did alluḍu mean?"
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: అంగడి",
          "segments": [
            {
              "kind": "speech",
              "text": "అంగడి (aṅgaḍi) — \"a shop\"."
            },
            {
              "kind": "speech",
              "text": "అంగడి (aṅgaḍi) is a shop — one counter, one family behind it, and everything a గ్రామం needs on the shelves."
            },
            {
              "kind": "speech",
              "text": "It is inherited, and it is the older and homelier of the two words available. City Telugu will as often reach for a borrowed word for a store, but the అంగడి (aṅgaḍi) is the one at the end of the బాట."
            },
            {
              "kind": "speech",
              "text": "You are known in an అంగడి (aṅgaḍi). Nobody there opens with a price; they open by asking whether your household is well."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One. The place the rest of this chapter happens in."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "aṅgaḍi",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *aṅgaḍi*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "it once more, slowly",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: it once more, slowly]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "aṅgaḍi, then grāmaṁ, and say which one sits inside the other",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *aṅgaḍi*, then *grāmaṁ*, and say which one sits inside the other]"
            },
            {
              "kind": "prompt",
