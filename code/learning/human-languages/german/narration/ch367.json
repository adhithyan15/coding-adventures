          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "womöglich joins wo \"where\" and möglich \"possible\", of the family of mögen and Proto-Germanic maganą \"to be able\" (EtymDB): \"if at all possible\", then \"perhaps even\"."
            }
          ]
        },
