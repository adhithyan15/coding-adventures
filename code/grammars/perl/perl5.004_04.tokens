# Perl 5.004_04 (1997-10-15) tokens: plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: unsupported Perl 5.004_04 syntax is rejected.
# Evidence: https://mirrors.develooper.com/perl/historical-perl/perl-5.004_04.tar.gz
# Archive SHA-256: a33e436a815e7dc16ea539eb566d7e5ac4852f2ed16bbcdf4105c6df748bcef0
# Historical toke.c shares the 5.004_04 trial/final tokenizer;
# glob and quote-delimiter changes are outside this subset.
# Unsupported characters, carriage returns, and leading-zero forms remain refused.

PRINT     = "print"
INT       = /0|[1-9][0-9]{0,249}/
PLUS      = "+"
DECREMENT = "--"
MINUS     = "-"
STAR      = "*"
LPAREN    = "("
RPAREN    = ")"
SEMICOLON = ";"

skip:
  WHITESPACE = /[ \t\n]+/
