        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: आम्रम्",
          "segments": [
            {
              "kind": "speech",
              "text": "आम्रम् (āmram) — \"a mango\", the फलम् of summer."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Āmra is already in the Śatapatha Brāhmaṇa, but its origin is unclear: MW gives no root for it. It lives on as Hindi ām, \"mango\" (CDIAL 1268)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "The summer fruit."
            }
          ]
        },
