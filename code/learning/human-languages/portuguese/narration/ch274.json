        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: outrora",
          "segments": [
            {
              "kind": "speech",
              "text": "outrora — \"formerly, in the old days\"."
            },
            {
              "kind": "speech",
              "text": "Outrora, esta aldeia tinha muitas crianças. In the old days this village had many children."
            },
            {
              "kind": "speech",
              "text": "A literary word; antigamente is the everyday choice."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "outrora fuses outra hora \"another hour, another time\" (EtymDB lists hora), from Latin alter \"other\" and hōra \"hour\" (Lewis & Short)."
            }
          ]
        },
        {
          "index": 3,
