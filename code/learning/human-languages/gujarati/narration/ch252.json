          "segments": [
            {
              "kind": "speech",
              "text": "ફરજ — pharaj — \"duty\"."
            },
            {
              "kind": "speech",
              "text": "આ મારી ફરજ છે. — ā mārī pharaj che — \"This is my duty.\""
