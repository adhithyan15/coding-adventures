    {
      "id": "ZH-W356-cuo-wrong",
      "sequence": 27525,
      "title": "错 (cuò) — the metal piece, then a cross-bar over the sun",
      "headword": "错",
      "romanization": "cuò",
      "gloss": "错 — the metal piece of 钱, then a bar, two verticals and 日",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:8cd0362bb7d33bf3",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — the metal piece, then a cross-bar over the sun",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — the metal piece, then a cross-bar over the sun and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say cuòguò — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *cuòguò* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "钱 日 过."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — qián, rì, guò",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *qián*, *rì*, *guò*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — the metal piece, then a cross-bar over the sun",
          "segments": [
            {
              "kind": "speech",
              "text": "错 (cuò)."
            },
            {
              "kind": "speech",
              "text": "Two pieces, left before right. Count the pieces, not the strokes."
            },
            {
              "kind": "speech",
              "text": "The left piece, the metal piece, five strokes, as in 钱: a long left-falling stroke, a short horizontal, a second horizontal, a third that rises to the right, then a vertical that ends rising to the right."
            },
            {
              "kind": "speech",
              "text": "The right piece, eight strokes: a short horizontal, two short verticals down through it, a long horizontal under them, then 日 rì, four strokes, at the foot."
            },
            {
              "kind": "speech",
              "text": "5 + 8 = thirteen."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "错 (cuò), all thirteen, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 错, all thirteen, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many pieces in 错 (cuò)? (Two.) Which character you know has the same left piece? (钱.) What sits at the foot of the right piece? (日.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 错 (cuò), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
