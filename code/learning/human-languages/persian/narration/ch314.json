          "segments": [
            {
              "kind": "speech",
              "text": "برگزار شدن (bargozâr shodan) — \"to be held\"."
            },
            {
              "kind": "speech",
              "text": "جلسه در سالن بزرگ مدرسه برگزار شد. Jalase dar sâlon-e bozorg-e madrese bargozâr shod. The meeting was held in the big hall of the school."
            },
            {
              "kind": "speech",
              "text": "For organised events. Present bargozâr mishavad."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "bargozâr \"carried out\" joins bar \"up, on\" and the native stem gozâr- \"to set out\"; shodan \"to become\" is inherited Persian. EtymDB lists no entry."
            }
          ]
        },
