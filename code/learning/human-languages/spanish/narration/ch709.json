          "title": "You'll want to know: el aislamiento",
          "segments": [
            {
              "kind": "speech",
              "text": "el aislamiento — \"isolation\"."
            },
            {
              "kind": "speech",
              "text": "Muchas personas mayores viven en aislamiento. Many older people live in isolation."
            },
            {
              "kind": "speech",
              "text": "Aislado — isolated, cut off."
            }
          ]
        },
