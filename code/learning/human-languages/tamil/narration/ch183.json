        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: பொங்கல்",
          "segments": [
            {
              "kind": "speech",
              "text": "பொங்கல் — poṅkal — \"pongal, a rice and lentil dish\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "பொங்கல் (poṅkal) is native Dravidian. DEDR 4469 lists Kannada poṅgu, \"to boil over\" and Telugu poṅgu. It is named for poṅku, \"to boil over\": the pot is let boil over at the festival."
            }
          ]
        },
