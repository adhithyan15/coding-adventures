        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: o costume",
          "segments": [
            {
              "kind": "speech",
              "text": "o costume — \"the custom, the habit\"."
            },
            {
              "kind": "speech",
              "text": "É costume jantar tarde nesta região. It is the custom to eat late in this region."
            },
            {
              "kind": "speech",
              "text": "Como de costume — as usual. Not a party outfit."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "costume comes down from Old Portuguese (EtymDB) and goes back to Latin cōnsuētūdō \"habit, custom\", from cōnsuēscere \"to get used to\" (Lewis & Short)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
