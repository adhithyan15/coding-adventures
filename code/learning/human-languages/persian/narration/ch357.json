          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "varz \"working, toil\" is a native Persian word, also seen in varzesh \"sport\"; dâdan \"to give\" is inherited Persian. EtymDB lists no entry."
            }
          ]
        },
