            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Sanskrit for Wednesday, then the Sanskrit for Thursday."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: शुक्रवासरः",
          "segments": [
            {
              "kind": "speech",
              "text": "शुक्रवासरः (śukravāsaraḥ) — \"Friday\", the day of शुक्र, Venus."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Śukravāsara is built from śukra, \"bright\", from the root √śuc, \"to shine\", the name given to Venus, and vāsara, \"day\"; MW records the compound from inscriptions."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "Venus's day."
            }
          ]
        },
        {
          "index": 4,
          "type": "guided-production",
