        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "is borrowed from English camp. After a flood or an earthquake, people live in a کیمپ (kaimp) for a time."
            }
          ]
        },
