              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *recto*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "recto, resto",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *recto, resto*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "seguir recto por la avenida",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *seguir recto por la avenida*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
