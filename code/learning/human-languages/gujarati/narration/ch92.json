            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Gujarati for an apology, pardon, then the Gujarati for okay, fine."
            },
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "speech",
              "text": "Build the sentence \"I live in Ahmedabad.\" (Hũ Amdāvādmā rahũ chhũ.)"
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: મધરાત",
          "segments": [
            {
              "kind": "speech",
              "text": "મધરાત (madhrāt) — \"midnight\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "મધરાત (madhrāt) is \"mid-night\". Its first part goes back to Sanskrit madhya, \"middle\" (CDIAL 9804), and rāt is a tadbhava of rātrī, \"night\" (CDIAL 10702)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
