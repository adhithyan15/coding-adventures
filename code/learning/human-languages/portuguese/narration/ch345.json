        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: a vantagem",
          "segments": [
            {
              "kind": "speech",
              "text": "a vantagem — \"the advantage\"."
            },
            {
              "kind": "speech",
              "text": "A grande vantagem desta casa é o jardim. The great advantage of this house is the garden."
            },
            {
              "kind": "speech",
              "text": "Tirar vantagem de — to take advantage of."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "vantagem is usually traced to Old French avantage, built on avant \"before\", which EtymDB derives from Late Latin abante \"before, in front\", from ab and ante \"before\" (EtymDB, Lewis & Short); Portuguese dropped the first a-."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
