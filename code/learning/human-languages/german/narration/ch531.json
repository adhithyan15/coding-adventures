        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: aufwärmen",
          "segments": [
            {
              "kind": "speech",
              "text": "aufwärmen — \"to warm up, to reheat\"."
            },
            {
              "kind": "speech",
              "text": "Die Suppe von gestern wärmen wir heute auf. We're reheating yesterday's soup today."
            },
            {
              "kind": "speech",
              "text": "Separable. Also in sport: sich aufwärmen — to warm up."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "aufwärmen is built on auf \"up\" and wärmen \"to warm\", from warm, inherited from Old High German warm, from Proto-Germanic warmaz (EtymDB)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
