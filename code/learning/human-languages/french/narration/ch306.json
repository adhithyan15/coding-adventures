          "segments": [
            {
              "kind": "speech",
              "text": "l'intoxication — \"the poisoning\"."
            },
            {
              "kind": "speech",
              "text": "Toute la famille a eu une intoxication alimentaire. The whole family had food poisoning."
            },
            {
              "kind": "speech",
              "text": "Une intoxication alimentaire — food poisoning. It does not mean being drunk."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "intoxication is built on intoxiquer, from Medieval Latin intoxicāre (EtymDB), built on toxicum \"poison\", a borrowing from Greek toxikón \"poison for arrows\"."
            }
          ]
        },
