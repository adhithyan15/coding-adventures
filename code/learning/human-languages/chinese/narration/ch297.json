    {
      "id": "ZH-W297-gu-old",
      "sequence": 23375,
      "title": "故 (gù) — 十 over 口, then the striking piece",
      "headword": "故",
      "romanization": "gù",
      "gloss": "故 — 十 over 口, then the striking piece of 做",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:05972e2aa6049538",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — 十 over 口, then the striking piece",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — 十 over 口, then the striking piece and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say shìgù — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *shìgù* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "做 十."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — zuò, shí",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *zuò*, *shí*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — 十 over 口, then the striking piece",
          "segments": [
            {
              "kind": "speech",
              "text": "故 (gù)."
            },
            {
              "kind": "speech",
              "text": "Two pieces, left before right. Count the pieces, not the strokes."
            },
            {
              "kind": "speech",
              "text": "The left piece, five strokes. 十: a bar and a vertical through it. Under it 口: a short vertical, a stroke that runs right and turns down, and the bar that closes the foot."
            },
            {
              "kind": "speech",
              "text": "The right piece, four strokes. The striking piece of 做: a sweep down to the left, a bar across to the right, a long sweep down to the lower left, and a long stroke falling to the right across it."
            },
            {
              "kind": "speech",
              "text": "5 + 4 = nine."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "故 (gù), all nine, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 故, all nine, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many pieces in 故 (gù)? (Two.) Which character has the same two pieces on its right? (做.) What is on the left? (十 over 口.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 故 (gù), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
