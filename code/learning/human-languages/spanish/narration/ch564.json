          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "personaje was borrowed from French personnage (EtymDB), built on Latin persōna 'an actor's mask, a role'."
            }
          ]
        },
