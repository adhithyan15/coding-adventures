              "kind": "speech",
              "text": "Masculine."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "فاصلہ (fāslā) is usually traced, through Persian, to Arabic fāṣila, \"an interval, a space between\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
