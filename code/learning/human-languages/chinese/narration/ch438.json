      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Mandarin for to emigrate, then the Mandarin for to open up land for use."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: 北部",
          "segments": [
            {
              "kind": "speech",
              "text": "北部 — běibù — \"northern part\"."
            },
            {
              "kind": "speech",
              "text": "我们坐火车去中国北部 wǒmen zuò huǒchē qù Zhōngguó běibù — We're taking the train up to the north of China."
            },
            {
              "kind": "speech",
              "text": "The new character, in pieces: 部 (bù) — ten strokes in two pieces: on the left five strokes, a dot, a bar, two short strokes and a long bar, over 口 kǒu; on the right the right piece of 那, two strokes. The next lesson puts it in your hand."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "北部 (běibù) is built from 北 'north' and 部 (bù) 'a part', both inherited from Middle Chinese, pok and buX (Guangyun, in Baxter's transcription), which glosses the second as a body of troops; the sense 'a part of a whole' is not given there."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for getting around."
            }
          ]
        },
        {
          "index": 4,
          "type": "guided-production",
