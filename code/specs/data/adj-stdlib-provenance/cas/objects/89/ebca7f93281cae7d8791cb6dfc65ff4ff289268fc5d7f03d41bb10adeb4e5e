<div class="os-problem-container">
  
  
  <div data-type="question-stem">Convert <math alttext="\frac{{48}}{{30}}">
  <mfrac>
    <mrow class="MJX-TeXAtom-ORD">
      <mn>48</mn>
    </mrow>
    <mrow class="MJX-TeXAtom-ORD">
      <mn>30</mn>
    </mrow>
  </mfrac>
</math> into decimal form.</div>
  
