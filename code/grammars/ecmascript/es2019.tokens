# ECMAScript 2019 (ES10) — Lexical Grammar
# @version 1
# @ecmascript_edition 2019
# source_ref: https://github.com/tc39/ecma262/tree/es2019
# source_sha: bc6fd169661d8737d7087bb822ef2a9c7148ac0b
# PARTIAL: the IIR path claims es-number-log only (LANG84 phase 6d; see releases.csv); this lexical pair predates LANG84 and is not yet audited clause by clause against the tagged spec text.
#
# ECMA-262, 10th Edition — June 2019
#
# ES2019 is a modest release focused on developer ergonomics:
#
#   - Optional catch binding: `catch { }` without `(error)` — grammar change
#   - JSON superset: strings can now contain U+2028 and U+2029 — token change
#   - Array.prototype.flat/flatMap — runtime only
#   - Object.fromEntries() — runtime only
#   - String.prototype.trimStart/trimEnd — runtime only
#   - Symbol.prototype.description — runtime only
#   - Well-formed JSON.stringify — runtime only
#   - Function.prototype.toString revision — runtime only
#
# Token changes from ES2018:
#   - STRING patterns updated to allow U+2028 (LINE SEPARATOR) and U+2029
#     (PARAGRAPH SEPARATOR) inside string literals. Previously these were
#     treated as line terminators and caused syntax errors in strings.
#     This change aligns JavaScript strings with JSON, which has always
#     allowed these characters. The motivation: make every valid JSON
#     text also valid JavaScript (the "JSON superset" proposal).

# ============================================================================
# Literals
# ============================================================================

NAME = /[a-zA-Z_$][a-zA-Z0-9_$]*/

# --- Numbers (unchanged from ES2018) ---

BINARY_NUMBER = /0[bB][01]+/ -> NUMBER
OCTAL_NUMBER = /0[oO][0-7]+/ -> NUMBER
HEX_NUMBER = /0[xX][0-9a-fA-F]+/ -> NUMBER
FLOAT_NUMBER = /[0-9]+\.[0-9]*([eE][+-]?[0-9]+)?/ -> NUMBER
LEADING_DOT_FLOAT = /\.[0-9]+([eE][+-]?[0-9]+)?/ -> NUMBER
SCI_NUMBER = /[0-9]+[eE][+-]?[0-9]+/ -> NUMBER
INT_NUMBER = /[0-9]+/ -> NUMBER

# --- Strings ---
#
# CHANGED IN ES2019: U+2028 and U+2029 are now legal inside string literals.
#
# Before ES2019, JavaScript string literals could not contain U+2028 (LINE
# SEPARATOR) or U+2029 (PARAGRAPH SEPARATOR) directly — they were treated
# as line terminators, just like \n and \r. This meant that while JSON could
# contain these characters in strings, JavaScript could not. Copying a JSON
# string into JavaScript source code could produce a syntax error!
#
# ES2019 fixes this by allowing U+2028 and U+2029 in string literals. They
# are still line terminators for purposes of ASI (automatic semicolon
# insertion) and line counting, but the string lexer no longer rejects them.
#
# The regex below uses \u2028 and \u2029 notation. In practice, most regex
# engines would handle this via a Unicode-aware character class. The key
# change is: these characters no longer terminate the string.

STRING_DQ = /"([^"\\]|\\.)*"/ -> STRING
STRING_SQ = /'([^'\\]|\\.)*'/ -> STRING

# --- Template literals (unchanged from ES2018) ---

TEMPLATE_HEAD = /`([^`\\$]|\\.|\$+([^{`\\$]|\\.))*\$*\$\{/
TEMPLATE_NO_SUB = /`([^`\\$]|\\.|\$+([^{`\\$]|\\.))*\$*`/

# --- Regular expressions (unchanged from ES2018) ---

REGEX = /\/([^\/\\\n\r]|\\[^\n\r])+\/[gimsuy]*/

# ============================================================================
# Multi-character operators (unchanged from ES2018)
# ============================================================================

STAR_STAR_EQUALS         = "**="
STAR_STAR                = "**"
STRICT_EQUALS            = "==="
STRICT_NOT_EQUALS        = "!=="
UNSIGNED_RIGHT_SHIFT_EQUALS = ">>>="
UNSIGNED_RIGHT_SHIFT     = ">>>"
LEFT_SHIFT_EQUALS        = "<<="
RIGHT_SHIFT_EQUALS       = ">>="
EQUALS_EQUALS            = "=="
NOT_EQUALS               = "!="
LESS_EQUALS              = "<="
GREATER_EQUALS           = ">="
PLUS_EQUALS              = "+="
MINUS_EQUALS             = "-="
STAR_EQUALS              = "*="
SLASH_EQUALS             = "/="
PERCENT_EQUALS           = "%="
AMPERSAND_EQUALS         = "&="
PIPE_EQUALS              = "|="
CARET_EQUALS             = "^="
LEFT_SHIFT               = "<<"
RIGHT_SHIFT              = ">>"
AND_AND                  = "&&"
OR_OR                    = "||"
PLUS_PLUS                = "++"
MINUS_MINUS              = "--"
ARROW                    = "=>"
ELLIPSIS                 = "..."

# ============================================================================
# Single-character operators
# ============================================================================

EQUALS       = "="
PLUS         = "+"
MINUS        = "-"
STAR         = "*"
SLASH        = "/"
PERCENT      = "%"
LESS_THAN    = "<"
GREATER_THAN = ">"
BANG         = "!"
AMPERSAND    = "&"
PIPE         = "|"
CARET        = "^"
TILDE        = "~"
QUESTION     = "?"

# ============================================================================
# Delimiters
# ============================================================================

LPAREN    = "("
RPAREN    = ")"
LBRACE    = "{"
RBRACE    = "}"
LBRACKET  = "["
RBRACKET  = "]"
SEMICOLON = ";"
COMMA     = ","
COLON     = ":"
DOT       = "."

# ============================================================================
# Keywords
# ============================================================================

keywords:
  break
  case
  catch
  class
  const
  continue
  debugger
  default
  delete
  do
  else
  export
  extends
  finally
  for
  function
  if
  import
  in
  instanceof
  let
  new
  return
  super
  switch
  this
  throw
  try
  typeof
  var
  void
  while
  with
  yield
  true
  false
  null

# ============================================================================
# Future reserved words
# ============================================================================

reserved:
  enum

# ============================================================================
# Context keywords
# ============================================================================

context_keywords:
  as
  async
  await
  from
  of
  get
  set
  static

# ============================================================================
# Token groups
# ============================================================================

group template:
  TEMPLATE_MIDDLE = /\}([^`\\$]|\\.|\$+([^{`\\$]|\\.))*\$*\$\{/
  TEMPLATE_TAIL   = /\}([^`\\$]|\\.|\$+([^{`\\$]|\\.))*\$*`/

# ============================================================================
# Declarative lexer modes (F10): regex-vs-division disambiguation
# ============================================================================
#
# A `/` starts a REGEX literal in expression position but is DIVISION in
# operand position, so `a/b/c` must not lex as `a` + regex `/b/` + `c`.
# This is the same table es2025.tokens carries (see its header comment
# for the full explanation), restricted to the token names and keywords
# this edition defines (LANG84 phase 6a). A program starts in `default`
# (expression position); after a value-producing token the lexer switches
# to `div`, whose two overrides make `/` and `/=` division.
#
# `template` / `template_div` keep `${...}` substitutions working: see
# es2025.tokens for the first-slice limits (no nested braces).

start_mode: default

group div:
  SLASH_EQUALS = "/="
  SLASH        = "/"

group template_div:
  SLASH_EQUALS    = "/="
  SLASH           = "/"
  TEMPLATE_MIDDLE = /\}([^`\\$]|\\.|\$+([^{`\\$]|\\.))*\$*\$\{/
  TEMPLATE_TAIL   = /\}([^`\\$]|\\.|\$+([^{`\\$]|\\.))*\$*`/

transitions:
  # ── Template substitution entry/exit (gap-044, first slice) ──────────────
  # After a template opener, enter flat `template` mode so TEMPLATE_TAIL/
  # MIDDLE patterns are tried before the inherited RBRACE.
  on TEMPLATE_HEAD   -> set-mode template
  on TEMPLATE_MIDDLE -> set-mode template

  # Inside `${...}`, after a value-producing NAME, switch to `template_div`
  # (like `div` but still carries TEMPLATE_TAIL/MIDDLE as own patterns).
  # The in_mode guard must come BEFORE the general NAME rule below, because
  # first-match-wins would otherwise fire the general rule in template mode.
  on NAME in template      -> set-mode template_div
  on NAME in template_div  -> set-mode template_div

  # Closing the substitution: TEMPLATE_TAIL is value-producing → div.
  on TEMPLATE_TAIL -> set-mode div

  # ── Regex-vs-division (gap-115, gap-119) ─────────────────────────────────
  # Value-producing tokens -> the next `/` is DIVISION. (One rule per line:
  # the transition parser reads each indented line as a complete rule.)
  on (NAME | NUMBER | STRING | REGEX | TEMPLATE_NO_SUB | RPAREN | RBRACKET) -> set-mode div
  on KEYWORD="this"  -> set-mode div
  on KEYWORD="super" -> set-mode div
  on KEYWORD="true"  -> set-mode div
  on KEYWORD="false" -> set-mode div
  on KEYWORD="null"  -> set-mode div

  # Operators, openers, separators -> the next `/` is a REGEX.
  on (LPAREN | LBRACKET | LBRACE | COMMA | SEMICOLON | COLON | DOT | EQUALS | ARROW | QUESTION | ELLIPSIS | PLUS | MINUS | STAR | SLASH | PERCENT | STAR_STAR | EQUALS_EQUALS | NOT_EQUALS | STRICT_EQUALS | STRICT_NOT_EQUALS | LESS_THAN | GREATER_THAN | LESS_EQUALS | GREATER_EQUALS | AND_AND | OR_OR | BANG | TILDE | AMPERSAND | PIPE | CARET | LEFT_SHIFT | RIGHT_SHIFT | UNSIGNED_RIGHT_SHIFT | PLUS_EQUALS | MINUS_EQUALS | STAR_EQUALS | SLASH_EQUALS | PERCENT_EQUALS | STAR_STAR_EQUALS | AMPERSAND_EQUALS | PIPE_EQUALS | CARET_EQUALS | LEFT_SHIFT_EQUALS | RIGHT_SHIFT_EQUALS | UNSIGNED_RIGHT_SHIFT_EQUALS) -> set-mode default
  on KEYWORD="return"     -> set-mode default
  on KEYWORD="typeof"     -> set-mode default
  on KEYWORD="delete"     -> set-mode default
  on KEYWORD="void"       -> set-mode default
  on KEYWORD="in"         -> set-mode default
  on KEYWORD="instanceof" -> set-mode default
  on KEYWORD="new"        -> set-mode default
  on KEYWORD="do"         -> set-mode default
  on KEYWORD="else"       -> set-mode default
  on KEYWORD="case"       -> set-mode default
  on KEYWORD="yield"      -> set-mode default
  on KEYWORD="throw"      -> set-mode default

# ============================================================================
# Skip patterns
# ============================================================================

skip:
  WHITESPACE    = /[ \t\r\n\v\f]+/
  LINE_COMMENT  = /\/\/[^\n\r]*/
  BLOCK_COMMENT = /\/\*[^*]*\*+([^\/*][^*]*\*+)*\//

# ============================================================================
# Error recovery tokens
# ============================================================================

errors:
  BAD_STRING_DQ = /"[^"]*$/
  BAD_STRING_SQ = /'[^']*$/
  BAD_REGEX = /\/([^\/\\\n]|\\.)*$/
  BAD_TEMPLATE = /`([^`\\$]|\\.|\$+([^{`\\$]|\\.))*\$*$/
