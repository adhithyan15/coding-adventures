        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: yuányīn",
          "segments": [
            {
              "kind": "speech",
              "text": "yuányīn — \"reason; cause\"."
            },
            {
              "kind": "speech",
              "text": "wǒ bù zhīdào shì shénme yuányīn — I don't know what the reason is."
            },
            {
              "kind": "speech",
              "text": "Its characters come later; for now it is a word for the ear."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "yuányīn is built from yuán and 因 'because', both inherited from Middle Chinese, ngjwon and 'jin (Guangyun, in Baxter's transcription). The dictionary glosses the first 'a broad plain' and the second 'to follow from'; how the first came to mean origin is not settled."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for giving reasons."
