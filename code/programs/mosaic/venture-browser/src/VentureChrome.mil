// VentureChrome — shared browser-chrome interface.
//
// venture-browser-core owns navigation and page rendering. Native hosts project
// that engine state into these slots and translate emitted actions back into
// BrowserNavigation commands.

component VentureChrome {
  slot address             : text ;
  slot page-title          : text ;
  slot status-text         : text ;
  slot back-disabled       : bool ;
  slot forward-disabled    : bool ;
  slot stop-disabled       : bool ;
  slot bookmark-label      : text ;
  slot bookmark-disabled   : bool ;
  slot bookmarks-label     : text ;
  slot bookmarks-disabled  : bool ;
  slot bookmarks-open      : bool ;
  slot bookmarks-position  : text ;
  slot bookmarks-title     : text ;
  slot bookmarks-address   : text ;
  slot bookmarks-previous-disabled : bool ;
  slot bookmarks-next-disabled : bool ;
  slot bookmarks-navigate-disabled : bool ;
  slot copy-address-disabled : bool ;
  slot open-page-disabled   : bool ;
  slot save-page-disabled   : bool ;
  slot print-page-disabled  : bool ;
  slot share-page-disabled  : bool ;
  slot page-info-disabled   : bool ;
  slot page-info-open       : bool ;
  slot page-info-title      : text ;
  slot page-info-address    : text ;
  slot page-info-requested-address : text ;
  slot page-info-status     : text ;
  slot page-info-resources  : text ;
  slot zoom-label           : text ;
  slot zoom-out-disabled    : bool ;
  slot zoom-reset-disabled  : bool ;
  slot zoom-in-disabled     : bool ;
  slot view-source-disabled : bool ;
  slot view-source-open     : bool ;
  slot view-source-title    : text ;
  slot view-source-address  : text ;
  slot view-source-content  : text ;
  slot find-open           : bool ;
  slot find-query          : text ;
  slot find-result-label   : text ;
  slot find-disabled       : bool ;
  slot navigation-disabled : bool ;
  slot content-surface     : node ;

  emit onBack ;
  emit onForward ;
  emit onHome ;
  emit onReload ;
  emit onStop ;
  emit onToggleBookmark ;
  emit onBookmarksOpen ;
  emit onBookmarksPrevious ;
  emit onBookmarksNext ;
  emit onBookmarksNavigate ;
  emit onBookmarksClose ;
  emit onCopyAddress ;
  emit onOpenPageInNewWindow ;
  emit onSavePage ;
  emit onPrintPage ;
  emit onSharePage ;
  emit onPageInfo ;
  emit onPageInfoClose ;
  emit onZoomOut ;
  emit onZoomReset ;
  emit onZoomIn ;
  emit onViewSource ;
  emit onViewSourceCopy ;
  emit onViewSourceClose ;
  emit onFindOpen ;
  emit onFindChange ( value : text ) ;
  emit onFindNext ;
  emit onFindPrevious ;
  emit onFindClose ;
  emit onAddressChange ( value : text ) ;
  emit onNavigate ;
}
