              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *comemos · comimos* — and *vivimos*, which is both]"
            },
            {
              "kind": "repeat",
              "times": 2,
              "source": "[REPEAT x2]"
            },
            {
              "kind": "activity",
