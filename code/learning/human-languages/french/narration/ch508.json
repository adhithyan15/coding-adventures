          "segments": [
            {
              "kind": "speech",
              "text": "le marathon — \"marathon\"."
            },
            {
              "kind": "speech",
              "text": "Mon père a couru son premier marathon à cinquante ans. My father ran his first marathon at fifty."
            },
            {
              "kind": "speech",
              "text": "Also a long, tiring task: un marathon de réunions."
            }
          ]
        },
