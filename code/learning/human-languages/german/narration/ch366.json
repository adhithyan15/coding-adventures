          "segments": [
            {
              "kind": "speech",
              "text": "gegebenenfalls — \"if applicable, should the case arise\"."
            },
            {
              "kind": "speech",
              "text": "Gegebenenfalls rufe ich Sie morgen noch einmal an. If necessary, I will call you again tomorrow."
            },
            {
              "kind": "speech",
              "text": "Written short as ggf., very common on forms. Formal."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "gegebenenfalls grew out of gegebenen Falls \"in the given case\", from gegeben, the participle of geben \"to give\", and Fall \"case\", Old High German val (EtymDB), with the adverb ending -s."
            }
          ]
        },
