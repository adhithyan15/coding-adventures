        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: die Sicherheitskontrolle",
          "segments": [
            {
              "kind": "speech",
              "text": "die Sicherheitskontrolle — \"the security check\"."
            },
            {
              "kind": "speech",
              "text": "An der Sicherheitskontrolle muss er seinen Gürtel ausziehen. At the security check he has to take off his belt."
            },
            {
              "kind": "speech",
              "text": "Plural: die Sicherheitskontrollen."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Sicherheitskontrolle is built from Sicherheit 'safety, security', from sicher, which goes back to Latin sēcūrus (Lewis & Short), and Kontrolle 'check', borrowed from French contrôle (EtymDB)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
