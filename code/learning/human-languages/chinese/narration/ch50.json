        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: shuìjiào",
          "segments": [
            {
              "kind": "speech",
              "text": "shuìjiào — \"to sleep; to go to bed\"."
            },
            {
              "kind": "speech",
              "text": "wǒ qù shuìjiào — I'm off to bed."
            },
            {
              "kind": "speech",
              "text": "Its characters come later; for now it is a word for the ear."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "shuìjiào is built from shuì 'to sleep' and jiào 'sleep', both inherited from Middle Chinese, dzyweH and kaewH (Guangyun, in Baxter's transcription); the dictionary glosses the second with this very pair."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for saying how you are."
