      ],
      "sourceHash": "fnv1a64:7ad2dfb1c3ef37aa",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — 日 above 生",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — 日 above 生 and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say xīngqī — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *xīngqī* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "日 生."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — rì, shēng",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *rì*, *shēng*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — 日 above 生",
          "segments": [
            {
              "kind": "speech",
              "text": "星 (xīng)."
            },
            {
              "kind": "speech",
              "text": "Two pieces you know, top to bottom: 日, then 生."
            },
            {
              "kind": "speech",
              "text": "日, four strokes, short and wide on top."
            },
            {
              "kind": "speech",
              "text": "生, five strokes, as in 学生: a left-falling stroke, a horizontal, a shorter horizontal, the vertical through them, and the long bar at the foot."
            },
            {
              "kind": "speech",
              "text": "4 + 5 = nine."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "星 (xīng), all nine, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 星, all nine, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Which two characters you know make 星 (xīng)? (日 and 生.) Which is on top? (日.) Which stroke of 生 is last? (The long bar at the foot.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 星 (xīng), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
