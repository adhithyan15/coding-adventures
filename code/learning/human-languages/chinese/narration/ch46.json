      ],
      "sourceHash": "fnv1a64:6faf02c522c8e643",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Mandarin for now, then the Mandarin for tomorrow."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: 星期",
          "segments": [
            {
              "kind": "speech",
              "text": "星期 — xīngqī — \"week\"."
            },
            {
              "kind": "speech",
              "text": "一个星期有七天 yí ge xīngqī yǒu qī tiān — There are seven days in a week."
            },
            {
              "kind": "speech",
              "text": "The new character, in pieces: 星 (xīng) — 日 above 生; 期 (qī) — an eight-stroke piece on the left and a moon piece on the right. The next lesson puts it in your hand."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "星期 (xīngqī) is built from 星 (xīng) 'star' and 期 (qī) 'appointed time', both inherited from Middle Chinese, seng and gi (Guangyun, in Baxter's transcription). How the pair came to mean a week is not settled."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for times and partings."
            }
          ]
        },
        {
          "index": 4,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "xīngqī",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *xīngqī*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "xīngqī, once more",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *xīngqī*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "yí ge xīngqī yǒu qī tiān — There are seven days in a week.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *yí ge xīngqī yǒu qī tiān* — There are seven days in a week.]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say the Mandarin for now, then the Mandarin for tomorrow, then say xīngqī again",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say the Mandarin for now, then the Mandarin for tomorrow, then say *xīngqī* again]"
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What does 星期 (xīngqī) mean? (\"Week\".) Say it once more."
            }
          ]
        }
      ]
