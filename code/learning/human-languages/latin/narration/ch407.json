        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: scientia, scientiae",
          "segments": [
            {
              "kind": "speech",
              "text": "scientia, scientiae — \"knowledge, skill\"."
            },
            {
              "kind": "speech",
              "text": "Scientia rērum ūtilis est. Knowledge of things is useful."
            },
            {
              "kind": "speech",
              "text": "scientia, scientiae f., built on sciēns, knowing. English science."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "scientia is built on sciēns \"knowing\" (EtymDB), the participle of sciō \"to know\" (Lewis & Short). English science comes from it through French."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
