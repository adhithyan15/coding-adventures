        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: la burocrazia",
          "segments": [
            {
              "kind": "speech",
              "text": "la burocrazia — \"the bureaucracy, the red tape\"."
            },
            {
              "kind": "speech",
              "text": "Per aprire un negozio c'è troppa burocrazia. To open a shop there is too much red tape."
            },
            {
              "kind": "speech",
              "text": "Stress on -zìa."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "burocrazia was borrowed from French bureaucratie, built from bureau \"desk, office\" and -cratie \"rule of\" (EtymDB), a Greek ending, from krátos \"power\": rule by the desk."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
