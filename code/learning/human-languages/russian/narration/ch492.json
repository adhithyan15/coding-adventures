          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "отчим (ótchim) is built on отец 'father', through the old adjective отчий 'father's'; EtymDB has no entry for отчим (ótchim)."
            }
          ]
        },
