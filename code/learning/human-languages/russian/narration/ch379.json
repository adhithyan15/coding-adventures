          "segments": [
            {
              "kind": "speech",
              "text": "в любом случае (v lyubóm slúchaye) — \"in any case, anyway\"."
            },
            {
              "kind": "speech",
              "text": "В любом случае я тебе позвоню. V lyubóm slúchaye ya tebé pozvonyú. In any case I will call you."
            },
            {
              "kind": "speech",
              "text": "Любой means any. It closes an argument: whatever happens."
            }
          ]
        },
