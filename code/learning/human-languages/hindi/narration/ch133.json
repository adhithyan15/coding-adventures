            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Hindi for a fan, then the Hindi for a watch."
            },
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Say the twelve borrowed months, जनवरी to दिसंबर. An older calendar still runs beside them."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: चश्मा",
          "segments": [
            {
              "kind": "speech",
              "text": "चश्मा — caśmā — \"glasses, spectacles\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "चश्मा (caśmā) is a loan, usually traced to Persian chashma, \"eye; spring; spectacles\"."
            }
          ]
        },
        {
