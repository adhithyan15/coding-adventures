            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "midnight, dawn, the day after tomorrow, a year, a moment",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: midnight, dawn, the day after tomorrow, a year, a moment]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "a season, summer, winter, the monsoon, spring",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: a season, summer, winter, the monsoon, spring]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "autumn, early, every day, a date, right now",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: autumn, early, every day, a date, right now]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "still, immediately, January, February, March",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: still, immediately, January, February, March]"
            }
          ]
        },
        {
          "index": 2,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Midnight? (મધરાત.) Dawn? (પરોઢ.) The day after tomorrow? (પરમદિવસ.) A year? (વરસ.) A moment? (પળ.) A season? (મોસમ.) Summer? (ઉનાળો.) Winter? (શિયાળો.) The monsoon? (ચોમાસું.) Spring? (વસંત.) Autumn? (પાનખર.) Early? (વહેલું.) Every day? (રોજ.) A date? (તારીખ.) Right now? (હમણાં.) Still? (હજી.) Immediately? (તરત.) January? (જાન્યુઆરી.) February? (ફેબ્રુઆરી.) March? (માર્ચ.)"
            }
          ]
        }
      ]
    },
