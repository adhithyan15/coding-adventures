              "instruction": "teṇe roṭlī khādhī",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *teṇe roṭlī khādhī*]"
            },
            {
              "kind": "prompt",
