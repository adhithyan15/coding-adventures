        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: requerir",
          "segments": [
            {
              "kind": "speech",
              "text": "requerir — \"to require, to call for\"."
            },
            {
              "kind": "speech",
              "text": "El puesto requiere experiencia. The post requires experience."
            },
            {
              "kind": "speech",
              "text": "Like sentir: requiere, requirió. Common in job offers and rules."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "requerir is inherited from Latin requirere 'to look for again, to need', built from re and quaerere 'to seek', and it follows querer in its forms (EtymDB)."
            }
          ]
        },
        {
          "index": 3,
