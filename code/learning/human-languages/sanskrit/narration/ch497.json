        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: कन्यादानम्",
          "segments": [
            {
              "kind": "speech",
              "text": "कन्यादानम् — kanyādānam — \"giving away the bride\"."
            },
            {
              "kind": "speech",
              "text": "पिता कन्यादानं करोति। pitā kanyādānaṃ karoti. The father gives away the bride."
            },
            {
              "kind": "speech",
              "text": "A neuter noun."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "कन्यादानम् (kanyādānam) is built from kanyā, \"a girl, a daughter\", and dāna, \"a gift\", from the root √dā of ददाति; MW gives \"giving a girl in marriage\" (MW)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for describing what you lived and felt."
            }
          ]
        },
