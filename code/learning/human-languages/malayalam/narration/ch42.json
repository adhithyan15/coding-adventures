      "sourceHash": "fnv1a64:2a19e2b11a603c59",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "You can already name things. This is how you DESCRIBE them."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: വലിയ",
          "segments": [
            {
              "kind": "speech",
              "text": "വലിയ — valiya — big."
            },
            {
              "kind": "speech",
              "text": "Put it in front of a word you already know and you have said something new. That is all an adjective does in this language."
            },
            {
              "kind": "speech",
              "text": "The last lesson of this chapter gives the one rule that governs every adjective you will ever meet here."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "വലിയ (valiya) is native Dravidian, one word with Tamil val, Kannada bal and Telugu valanu (DEDR 5276). Its first sense is \"strong\": bigness grew out of strength."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "\"വലിയ (valiya)\" three times, picturing something different each time",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: \"വലിയ\" three times, picturing something different each time]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "it once with a word you already know after it",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: it once with a word you already know after it]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say pāl",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *pāl*]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What is valiya? (big.) Where does it go — before the word it describes, or after? (Before.)"
            }
          ]
        }
      ]
    },
