        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: प्रामाणिक",
          "segments": [
            {
              "kind": "speech",
              "text": "प्रामाणिक — prāmāṇik — \"honest\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "प्रामाणिक (prāmāṇik) is Sanskrit prāmāṇika, \"founded on authority\", taken over whole as a learned loan, a tatsama (CDIAL 8949). It is built on pramāṇa, \"measure, proof\"."
            }
          ]
        },
