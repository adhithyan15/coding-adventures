        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: سجن",
          "segments": [
            {
              "kind": "speech",
              "text": "سجن — sajana — \"to imprison, to jail\"."
            },
            {
              "kind": "speech",
              "text": "سجن (sajana) اللص سنتين. sujina al-liṣṣ sanatayn. The thief was jailed for two years."
            },
            {
              "kind": "speech",
              "text": "Present: يسجن, yasjun."
            },
            {
              "kind": "speech",
              "text": "The noun سجن (sajana), sijn, a prison, is spelled the same."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "سجن (sajana) is built on the native Arabic root s-j-n (Lane), \"to shut up, to confine\"; sijn is the place of it."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
