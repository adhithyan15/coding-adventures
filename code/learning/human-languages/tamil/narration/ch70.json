    {
      "id": "TA-W26-read-mesai",
      "sequence": 2810,
      "title": "மேசை (mēsai) — two front-hanging signs in one word",
      "headword": "மேசை",
      "romanization": "mēsai",
      "gloss": "the word for a table on the page — two signs, both hanging in front",
      "script": "tamil",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:f55c34f80ceb30a9",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Script you'll notice: மேசை — two front-hanging signs in one word",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now — leave the sections called Script you'll notice: மேசை — two front-hanging signs in one word and Guided Practice until you have stopped, and I will say so again when we reach it."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the page: you can say mēsai and kaṭṭil. Now read the first one."
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script you'll notice: மேசை — two front-hanging signs in one word",
          "segments": [
            {
              "kind": "speech",
              "text": "மேசை (mēsai) is the first word you have read that carries a front-hanging sign on each of its two letters."
            },
            {
              "kind": "table",
              "headers": [
                "piece",
                "",
                ""
              ],
              "columns": 3,
              "rowCount": 2,
              "utterances": [
                "piece: மே, mē, ம with the ே sign, the one you read twice in மேலே.",
                "piece: சை, sai, ச with the ை sign, the one you read at the end of சட்டை and கடை."
              ]
            },
            {
              "kind": "speech",
              "text": "மே, சை becomes மேசை (mēsai)."
            },
            {
              "kind": "speech",
              "text": "Both signs are drawn to the left of their letter and said after it. So the eye moves left-to-right across four marks while the mouth says only two beats, and the order of the two is not the order they were printed in. Read it slowly once and let that happen on purpose."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "மே — then சை — then மேசை (mēsai)",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: **மே** — then **சை** — then **மேசை**]"
            },
            {
              "kind": "prompt",
              "action": "POINT",
              "instruction": "both signs, and say which side of their letters they sit on",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU POINT: both signs, and say which side of their letters they sit on]"
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "மேலே, then மேசை (mēsai), and find the sign they share",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: **மேலே**, then **மேசை**, and find the sign they share]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say mēsai, then say kaṭṭil, then read மேசை",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *mēsai*, then say *kaṭṭil*, then read **மேசை**]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Read மேசை (mēsai). How many signs does it carry, and are they said before or after their letters? (Two; after.)"
            }
          ]
        }
      ]
    },
