          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "اشاره was borrowed from Arabic ishāra \"a sign, a gesture\" (EtymDB); with the Persian verb kardan it means to refer to something, in a gesture or in words."
            }
          ]
        },
