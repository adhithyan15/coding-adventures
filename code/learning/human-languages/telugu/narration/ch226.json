      "id": "TE-C226-patam",
      "sequence": 10450,
      "title": "పటం (paṭaṁ) — a map, a chart",
      "headword": "పటం",
      "romanization": "paṭaṁ",
      "gloss": "a map, a chart",
      "script": "telugu",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:98d9b11aef3b46ea",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Telugu for a watermelon, then the Telugu for cashew nuts."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: పటం",
          "segments": [
            {
              "kind": "speech",
              "text": "పటం — paṭaṁ — \"a map, a chart\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "పటం (paṭaṁ) is Sanskrit paṭa, \"woven cloth\" (CDIAL 7692), with the Telugu ending -ṁ; a map was once drawn on cloth. CDIAL thinks paṭa probably came from an Austroasiatic language, and less likely from Dravidian."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for this chapter."
            }
          ]
        },
        {
          "index": 4,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "paṭaṁ",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *paṭaṁ*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "paṭaṁ, once more",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *paṭaṁ*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "say paṭaṁ",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: say *paṭaṁ*]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say the Telugu for a watermelon, then the Telugu for cashew nuts, then say paṭaṁ again",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say the Telugu for a watermelon, then the Telugu for cashew nuts, then say *paṭaṁ* again]"
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What does పటం (paṭaṁ) mean? (\"A map, a chart\".) Say it once more."
            }
