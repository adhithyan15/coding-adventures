// ReviewCard.dark.msl - dark review-card theme.

style ReviewCard {
  part review-card {
    background    : "#16213e" ;
    border-width  : 1 ;
    border-color  : "#2a3a5e" ;
    border-radius : 8 ;
    padding       : 24 ;
  }

  part deck-name {
    color       : "#8899aa" ;
    font-size   : 13 ;
    font-weight : 600 ;
  }

  part prompt-panel {
    background    : "#1a1a2e" ;
    border-width  : 1 ;
    border-color  : "#2a3a5e" ;
    border-radius : 8 ;
    padding       : 18 ;
  }

  part prompt-label {
    color          : "#e94560" ;
    font-size      : 11 ;
    font-weight    : 700 ;
    padding-bottom : 8 ;
  }

  part prompt-text {
    color       : "#ffffff" ;
    font-size   : 24 ;
    font-weight : 600 ;
  }

  part type-answer-panel {
    background    : "#111827" ;
    border-width  : 1 ;
    border-color  : "#475569" ;
    border-radius : 8 ;
    padding       : 14 ;
  }

  part type-answer-label {
    color          : "#93c5fd" ;
    font-size      : 11 ;
    font-weight    : 700 ;
    padding-bottom : 8 ;
  }

  part type-answer-input {
    background    : "#020617" ;
    border-width  : 1 ;
    border-color  : "#64748b" ;
    border-radius : 6 ;
    color         : "#f8fafc" ;
    font-size     : 16 ;
    padding       : 10 ;
  }

  part type-answer-comparison-label {
    color          : "#bae6fd" ;
    font-size      : 11 ;
    font-weight    : 700 ;
    padding-top    : 10 ;
    padding-bottom : 4 ;
  }

  part type-answer-comparison-value {
    color       : "#e2e8f0" ;
    font-size   : 14 ;
    font-weight : 500 ;
  }

  part answer-panel {
    background    : "#0f3460" ;
    border-width  : 1 ;
    border-color  : "#e94560" ;
    border-radius : 8 ;
    padding       : 18 ;
  }

  part answer-label {
    color          : "#ffb3c0" ;
    font-size      : 11 ;
    font-weight    : 700 ;
    padding-bottom : 8 ;
  }

  part answer-text {
    color       : "#e0ddd5" ;
    font-size   : 22 ;
    font-weight : 500 ;
  }

  part reveal-button {
    background    : "#e94560" ;
    border-width  : 1 ;
    border-color  : "#943040" ;
    border-radius : 6 ;
    color         : "#ffffff" ;
    font-weight   : 700 ;
    padding       : 10 ;
  }

  part progress-label {
    color     : "#8899aa" ;
    font-size : 12 ;
  }
}
