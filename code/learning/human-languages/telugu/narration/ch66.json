    {
      "id": "TE-C66-harvest",
      "sequence": 2170,
      "title": "పంట (paṇṭa) — a harvest",
      "headword": "పంట",
      "romanization": "paṇṭa",
      "gloss": "a harvest",
      "script": "telugu",
      "modality": "voice",
