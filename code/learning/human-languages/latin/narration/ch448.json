          "segments": [
            {
              "kind": "speech",
              "text": "strepō, strepere — \"to make a noise, to clatter, to roar\"."
            },
            {
              "kind": "speech",
              "text": "In viā plaustra strepunt, et nēmō dormīre potest. In the street the wagons clatter, and nobody can sleep."
            },
            {
              "kind": "speech",
              "text": "strepō, strepere, strepuī, strepitum. Any loud noise: wheels, voices, water."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "The origin of strepō is not settled: Lewis & Short give its senses, to rattle, rumble, roar, but no etymology, and EtymDB gives no parent."
            }
          ]
        },
        {
