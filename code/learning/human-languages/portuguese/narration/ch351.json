          "segments": [
            {
              "kind": "speech",
              "text": "implicar is a learned borrowing from Latin implicāre \"to fold into, to entangle\" (EtymDB, Lewis & Short), built from in and plicāre \"to fold\"; the inherited form of the same Latin verb is empregar."
            }
          ]
        },
