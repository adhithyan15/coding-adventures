        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: حلوہ",
          "segments": [
            {
              "kind": "speech",
              "text": "حلوہ — halvā — \"halwa, a sweet\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "حلوہ (halvā) is a loan from Arabic ḥalwā, \"a sweetmeat\", which reached Urdu through Persian. Its Arabic root is ḥ-l-w (Lane)."
            }
          ]
        },
        {
