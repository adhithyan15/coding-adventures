        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: از حالا",
          "segments": [
            {
              "kind": "speech",
              "text": "از حالا — az hâlâ — \"from now on\". از حالا هر روز ورزش خواهم کرد — az hâlâ har ruz varzesh khâham kard — \"From now on I will exercise every day.\""
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "az hâlâ is \"from now\". az, \"from\", is native: Old Persian had hacā (EtymDB). hâlâ, \"now\", is borrowed from Arabic ḥālan (root ḥ-w-l, Lane)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
