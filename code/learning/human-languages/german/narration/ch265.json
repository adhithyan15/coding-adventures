      "id": "GE-C265-inzwischen",
      "sequence": 14650,
      "title": "inzwischen — meanwhile; by now",
      "headword": "inzwischen",
      "romanization": "inzwischen",
      "gloss": "meanwhile; by now",
      "script": "latin",
