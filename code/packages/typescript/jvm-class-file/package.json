{
  "name": "@coding-adventures/jvm-class-file",
  "version": "0.1.0",
  "description": "Minimal JVM class-file parser and builder for the compiler backend pipeline",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc",
    "test": "node node_modules/typescript/bin/tsc -p tsconfig.test.json && node --test dist-test/tests/jvm-class-file.test.js",
    "test:coverage": "node node_modules/typescript/bin/tsc -p tsconfig.test.json && node --experimental-test-coverage --test-coverage-exclude=dist-test/tests/** --test-coverage-lines=80 --test dist-test/tests/jvm-class-file.test.js"
  },
  "author": "Adhithya Rajasekaran",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  }
}
