        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: o veredicto",
          "segments": [
            {
              "kind": "speech",
              "text": "o veredicto — \"the verdict\"."
            },
            {
              "kind": "speech",
              "text": "O veredicto saiu ao fim da tarde. The verdict came out late in the afternoon."
            },
            {
              "kind": "speech",
              "text": "The decision of a court on the facts."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "veredicto goes back to Latin vērē dictum \"truly said\", from vērus \"true\" and dīcere \"to say\" (Lewis & Short), probably through English verdict."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
