            },
            {
              "kind": "speech",
              "text": "La reunión tuvo lugar en el ayuntamiento. The meeting took place at the town hall."
            },
            {
              "kind": "speech",
              "text": "Used for planned events: La boda tendrá lugar en mayo."
            }
