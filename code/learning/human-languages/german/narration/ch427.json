          "segments": [
            {
              "kind": "speech",
              "text": "die Heizung — \"the heating; the radiator\"."
            },
            {
              "kind": "speech",
              "text": "Im Winter ist die Heizung im Hotel zu schwach. In winter the heating in the hotel is too weak."
            },
            {
              "kind": "speech",
              "text": "Plural: die Heizungen. People often say die Heizung for one radiator too."
            }
          ]
        },
