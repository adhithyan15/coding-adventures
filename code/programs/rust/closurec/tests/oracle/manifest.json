    {
      "id": "closure-flags-file-v1",
      "kind": "flags_file",
      "description": "Run the pinned Closure JAR with one argv element per nonblank, noncomment line in the fixture flags file; capture exit status, stdout, stderr, and declared output files.",
      "executable": "java",
      "working_directory": "{package_root}",
      "argv": [
        "-Duser.language=en",
        "-Duser.country=US",
        "-Duser.timezone=UTC",
        "-Dfile.encoding=UTF-8",
        "-jar",
        "{oracle_jar}",
        "{fixture_flags}"
      ],
      "flags_path": "tests/diff/{fixture}/flags.txt",
      "input_root": "tests/diff/{fixture}/input",
      "matrix": []
    },
    {
      "id": "typed-pipeline-failure-matrix-v1",
      "kind": "matrix",
      "description": "Run the parse-error and destructuring probes at SIMPLE and ADVANCED with NO_TRANSPILE; capture status, stdout, and stderr.",
      "executable": "java",
      "working_directory": "{package_root}",
      "argv": [
        "-Duser.language=en",
        "-Duser.country=US",
        "-Duser.timezone=UTC",
        "-Dfile.encoding=UTF-8",
        "-jar",
        "{oracle_jar}",
        "--compilation_level",
        "{compilation_level}",
        "--language_out",
        "NO_TRANSPILE",
        "--js",
        "{fixture_input}"
      ],
      "flags_path": null,
      "input_root": null,
      "matrix": [
        {
          "id": "advanced-destructuring",
          "variables": {
            "compilation_level": "ADVANCED",
            "fixture_input": "tests/diff/typed-pipeline-failure/input/destructuring.js"
          }
        },
        {
          "id": "advanced-malformed",
          "variables": {
            "compilation_level": "ADVANCED",
            "fixture_input": "tests/diff/typed-pipeline-failure/input/malformed.js"
          }
        },
        {
          "id": "simple-destructuring",
          "variables": {
            "compilation_level": "SIMPLE",
            "fixture_input": "tests/diff/typed-pipeline-failure/input/destructuring.js"
          }
