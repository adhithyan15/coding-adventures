          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What does ఇవాళ (ivāḷa) mean? (\"today\".) Say it once more."
            }
          ]
        }
      ]
    },
