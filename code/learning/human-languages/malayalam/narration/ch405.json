              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *vādikkuka*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "vādikkuka, once more",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *vādikkuka*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "avaḷ putiya niyamattinŭ etire vādiccu. — She argued against the new law.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *avaḷ putiya niyamattinŭ etire vādiccu.* — She argued against the new law.]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say the Malayalam for a principal, then the Malayalam for tuition, then say vādikkuka again",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say the Malayalam for a principal, then the Malayalam for tuition, then say *vādikkuka* again]"
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What does വാദിക്കുക (vādikkuka) mean? (\"To plead a case; to argue\".) Say it once more."
            }
          ]
        }
      ]
    },
