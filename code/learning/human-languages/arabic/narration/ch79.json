        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: بقرة",
          "segments": [
            {
              "kind": "speech",
              "text": "بقرة — baqara — \"a cow\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "بقرة (baqara) is built on the native Arabic root b-q-r, \"to slit, to split\" (Lane). Baqara is one head of baqar, \"cattle\", which Lane lists under this root."
            }
          ]
        },
        {
          "index": 3,
