        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: festejar",
          "segments": [
            {
              "kind": "speech",
              "text": "festejar — \"to celebrate (with a party)\"."
            },
            {
              "kind": "speech",
              "text": "Festejámos o aniversário dela num restaurante. We celebrated her birthday in a restaurant."
            },
            {
              "kind": "speech",
              "text": "Livelier than celebrar: music, food, friends."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "festejar is built on festa \"a party\", from Latin fēsta \"feast days\" (Lewis & Short); EtymDB lists it beside Occitan festejar and French festoyer."
            }
          ]
        },
        {
          "index": 3,
