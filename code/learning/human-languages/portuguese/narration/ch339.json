        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: o acordo",
          "segments": [
            {
              "kind": "speech",
              "text": "o acordo — \"the agreement, the deal\"."
            },
            {
              "kind": "speech",
              "text": "Depois de duas horas, chegámos a um acordo. After two hours, we reached an agreement."
            },
            {
              "kind": "speech",
              "text": "Estar de acordo — to agree; de acordo! — agreed, OK."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "acordo is built on the verb acordar in its old sense \"to agree\", usually traced to Vulgar Latin accordāre, a formation on Latin cor, cordis \"heart\" (Lewis & Short): hearts that beat together."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
