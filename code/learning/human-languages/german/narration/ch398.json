          "segments": [
            {
              "kind": "speech",
              "text": "abbiegen is built from ab 'off, away' and biegen 'to bend', which is inherited through Middle and Old High German (biegen, biogan) from Proto-Germanic beuganą (EtymDB). English bow 'to bend' is a cousin."
            }
          ]
        },
