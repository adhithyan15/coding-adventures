          "title": "You'll want to know: le citoyen",
          "segments": [
            {
              "kind": "speech",
              "text": "le citoyen — \"the citizen\"."
            },
            {
              "kind": "speech",
              "text": "Chaque citoyen a le droit de voter. Every citizen has the right to vote."
            },
            {
              "kind": "speech",
              "text": "Feminine citoyenne."
            }
          ]
        },
