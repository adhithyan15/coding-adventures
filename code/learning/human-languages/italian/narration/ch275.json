        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: accadere",
          "segments": [
            {
              "kind": "speech",
              "text": "accadere — \"to happen\"."
            },
            {
              "kind": "speech",
              "text": "È accaduto tutto in pochi secondi. It all happened in a few seconds."
            },
            {
              "kind": "speech",
              "text": "Takes essere: è accaduto. A little more formal than succedere."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "accadere is usually traced to Vulgar Latin accadĕre, a remake of Latin accidere \"to fall upon, to happen\", from ad and cadere \"to fall\" (Lewis & Short)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
