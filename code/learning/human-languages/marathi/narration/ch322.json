        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: पुरस्कार",
          "segments": [
            {
              "kind": "speech",
              "text": "पुरस्कार — puraskār — \"an award\"."
            },
            {
              "kind": "speech",
              "text": "तिला तिच्या कामासाठी मोठा पुरस्कार मिळाला. tilā ticyā kāmāsāṭhī moṭhā puraskār miḷālā. She received a big award for her work."
            },
            {
              "kind": "speech",
              "text": "Masculine."
            },
            {
              "kind": "speech",
              "text": "पुरस्कार (puraskār) मिळणे, to receive an award, with the receiver in -ला: तिला. The letter ञ hides inside ज्ञ: ज्ञान, knowledge."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "पुरस्कार (puraskār) is a tatsama, taken from Sanskrit puraskāra, 'placing in front; honouring' (Monier-Williams)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling what happened."
            }
          ]
        },
