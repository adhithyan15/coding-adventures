# Perl 5.003_07 (1996-10-10) tokens: verified arithmetic-print subset only.
# @version 1
# PARTIAL: this does not lex all Perl 5.003_07 source.
# Evidence: https://github.com/Perl/perl5/blob/perl-5.003_07/perly.y
# Evidence: https://github.com/Perl/perl5/blob/perl-5.003_07/toke.c
# The tagged yacc grammar matches 5.003_05. Tokenizer changes include line
# buffering and sort handling outside this limited arithmetic-print subset.

PRINT     = "print"
INT       = /[0-9]+/
PLUS      = "+"
DECREMENT = "--"
MINUS     = "-"
STAR      = "*"
LPAREN    = "("
RPAREN    = ")"
SEMICOLON = ";"

skip:
  WHITESPACE = /[ \t\r\n]+/
