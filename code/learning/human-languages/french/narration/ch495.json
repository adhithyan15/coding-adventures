          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "brouiller goes back to Old French brouiller, from Vulgar Latin brodiculāre \"to jumble together\" (EtymDB), which is usually traced to a Germanic word for broth."
            }
          ]
        },
