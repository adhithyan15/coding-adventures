        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: die Tribüne",
          "segments": [
            {
              "kind": "speech",
              "text": "die Tribüne — \"stand, grandstand\"."
            },
            {
              "kind": "speech",
              "text": "Wir saßen auf der Tribüne direkt hinter dem Tor. We sat in the stand right behind the goal."
            },
            {
              "kind": "speech",
              "text": "Plural: die Tribünen."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Tribüne came from French tribune, from Italian tribuna (EtymDB), which is usually traced to Latin tribūnal, the raised platform of the magistrates (Lewis & Short)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
