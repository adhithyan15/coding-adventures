        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Script — the shape"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now — leave the section called Script — the shape until you have stopped, and I will say so again when we reach it."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 10,
              "perItem": false,
              "source": "[PAUSE 10s]"
            },
            {
              "kind": "speech",
              "text": "Write known う and み (mi), then say mo | o."
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — the shape",
          "segments": [
            {
              "kind": "speech",
              "text": "も — mo."
            },
            {
              "kind": "speech",
              "text": "Three strokes. Draw the central curve first, from the upper left down and around. Then add the upper short horizontal and the lower short horizontal. Both bars cross the central stroke."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "speech",
              "text": "Copy も (mo) once."
            },
            {
              "kind": "speech",
              "text": "Hide it for ten seconds and write it again."
            },
            {
              "kind": "speech",
              "text": "Add known う: もう (mō). Read mo | o."
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "speech",
              "text": "Cover the model and write もう (mō) once."
            },
            {
              "kind": "speech",
              "text": "Source: Unicode Hiragana chart; stroke order per Hitsujun Shido no Tebiki (Japanese Ministry of Education, 1958)."
            },
            {
              "kind": "activity",
              "scored": true,
              "id": "JA-W09-mo-order",
              "prompt": "In も (mo), what comes first: the long curve or the two short bars?",
              "assesses": [
                "JA-SCRIPT-MO-01"
              ],
              "responseSeconds": 8,
              "acceptedResponses": [
                "the long curve",
                "curve",
                "long curve first",
                "the curve"
              ],
              "feedback": {
                "correct": "Right: curve first, then the upper and lower bars.",
                "incorrect": "Write the long curve first; add the two short bars after it."
              }
