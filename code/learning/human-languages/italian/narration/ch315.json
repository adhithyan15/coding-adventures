        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: celebrare",
          "segments": [
            {
              "kind": "speech",
              "text": "celebrare — \"to celebrate formally; to hold (a ceremony)\"."
            },
            {
              "kind": "speech",
              "text": "Abbiamo celebrato i cento anni della scuola. We celebrated the school's hundredth anniversary."
            },
            {
              "kind": "speech",
              "text": "More formal than festeggiare."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "celebrare is a learned borrowing from Latin celebrāre \"to frequent; to honour with a crowd\" (Lewis & Short), from celeber \"crowded\"."
            }
          ]
        },
        {
