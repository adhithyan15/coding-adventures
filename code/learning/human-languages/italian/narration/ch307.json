        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: la nascita",
          "segments": [
            {
              "kind": "speech",
              "text": "la nascita — \"the birth\"."
            },
            {
              "kind": "speech",
              "text": "La nascita di mia figlia è stata il giorno più bello della mia vita. My daughter's birth was the best day of my life."
            },
            {
              "kind": "speech",
              "text": "La data di nascita — the date of birth."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "nascita is built on nascere \"to be born\", which is inherited from Latin nāscī (Lewis & Short)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
