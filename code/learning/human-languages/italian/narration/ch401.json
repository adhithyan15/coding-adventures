          "segments": [
            {
              "kind": "speech",
              "text": "cancellare — \"to delete, to rub out; to cancel\"."
            },
            {
              "kind": "speech",
              "text": "Se cancelli la foto, non la trovi più. If you delete the photo, you will not find it again."
            },
            {
              "kind": "speech",
              "text": "Also to cancel: il volo è stato cancellato."
            }
          ]
        },
