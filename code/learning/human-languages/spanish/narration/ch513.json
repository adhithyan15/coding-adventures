          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "publicar is a learned borrowing from Latin pūblicāre 'to make public' (EtymDB), built on pūblicus 'of the people'. English publish comes from the same verb through French."
            }
          ]
        },
