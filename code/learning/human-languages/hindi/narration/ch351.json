        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: अधिकार",
          "segments": [
            {
              "kind": "speech",
              "text": "अधिकार — adhikār — \"a right\"."
            },
            {
              "kind": "speech",
              "text": "हर बच्चे को पढ़ने का अधिकार है। har bacce ko paṛhne kā adhikār hai. Every child has the right to study."
            },
            {
              "kind": "speech",
              "text": "Masculine."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "अधिकार (adhikār) is a tatsama, borrowed from Sanskrit adhikāra, \"authority, jurisdiction\" (Monier-Williams). Hindi has narrowed it to a right that someone holds."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for giving reasons and opinions."
