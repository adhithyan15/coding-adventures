          "segments": [
            {
              "kind": "speech",
              "text": "kerm is a native Persian word, inherited rather than borrowed; it is usually traced to Middle Persian kirm, \"worm\". EtymDB takes it back to an Indo-European word for \"worm\", the word behind Sanskrit kṛmi. (It also lists French crème, a different word.)"
            }
