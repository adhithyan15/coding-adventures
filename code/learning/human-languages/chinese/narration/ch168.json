        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: zhēng",
          "segments": [
            {
              "kind": "speech",
              "text": "zhēng — \"to steam (food)\"."
            },
            {
              "kind": "speech",
              "text": "māma zài zhēng bāozi — Mum is steaming buns."
            },
            {
              "kind": "speech",
              "text": "Its characters come later; for now it is a word for the ear."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "zhēng is inherited from Middle Chinese tsying (Guangyun, in Baxter's transcription). Under this character the dictionary gives 'fine firewood'; written another way, the same syllable is glossed 'the breath of a fire rising', which is the steaming."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
