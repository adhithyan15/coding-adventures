        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: el delito",
          "segments": [
            {
              "kind": "speech",
              "text": "el delito — \"the offence, the crime\"."
            },
            {
              "kind": "speech",
              "text": "Robar es un delito. Stealing is a crime."
            },
            {
              "kind": "speech",
              "text": "Cometer un delito — to commit an offence."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "delito is a learned borrowing from Latin dēlictum 'a fault, a misdeed' (EtymDB), from dēlinquere 'to fall short, to do wrong' (Lewis & Short)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
