        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: шина",
          "segments": [
            {
              "kind": "speech",
              "text": "шина (shína) — \"a tyre\"."
            },
            {
              "kind": "speech",
              "text": "Передняя шина совсем старая. Perédnyaya shína sovsém stáraya. The front tyre is quite old."
            },
            {
              "kind": "speech",
              "text": "Feminine. In everyday speech people also say колесо — a wheel."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "шина (shína) was borrowed from German Schiene 'a rail, a strip' (EtymDB), from Old High German skina; the word probably named the iron band round a cartwheel before the rubber tyre."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
