    {
      "id": "ZH-W161-mi-rice",
      "sequence": 13155,
      "title": "米 (mǐ) — a cross with two strokes above and two below",
      "headword": "米",
      "romanization": "mǐ",
      "gloss": "米 — a cross, two short strokes above it, two legs below",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:5f7019dcc6fde548",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — a cross with two strokes above and two below",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — a cross with two strokes above and two below and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say dàmǐ — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *dàmǐ* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "来 大."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — lái, dà",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *lái*, *dà*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — a cross with two strokes above and two below",
          "segments": [
            {
              "kind": "speech",
              "text": "米 (mǐ)."
            },
            {
              "kind": "speech",
              "text": "One piece, six strokes, built round a cross."
            },
            {
              "kind": "speech",
              "text": "Two short strokes first, slanting in toward the middle: a dot from the upper left, then a short stroke from the upper right falling to the left."
            },
            {
              "kind": "speech",
              "text": "The cross. A long horizontal, then a vertical down through its middle."
            },
            {
              "kind": "speech",
              "text": "The legs, from the crossing. A stroke falling to the lower left, then one falling to the lower right."
            },
            {
              "kind": "speech",
              "text": "2 + 2 + 2 = six."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "米 (mǐ), all six, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 米, all six, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many strokes in 米 (mǐ)? (Six.) Which two come first? (The two short strokes above the cross.) Which come last? (The two legs, left, then right.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 米 (mǐ), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
