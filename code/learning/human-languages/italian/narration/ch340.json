          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "tesi is a learned borrowing from Latin thesis \"a proposition\" (Lewis & Short), which came from Greek thésis \"a setting down\", from the verb tithénai \"to put\"."
            }
          ]
        },
