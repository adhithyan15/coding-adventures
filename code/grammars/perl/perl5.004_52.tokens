# Perl 5.004_52 (1997-10-15) plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: unsupported Perl 5.004_52 syntax is rejected.
# Evidence: https://mirrors.develooper.com/perl/historical-perl/perl-5.004_52.tar.gz
# Archive SHA-256: f5edcffd4bf28db7bad95562470e37d57da65503822abb77de049b4d18cddd09
# Its comment-stripped scan_num matches 5.004_51, retaining the 250-digit bound.
# Other toke.c changes do not widen this bounded subset.
# Unsupported characters, carriage returns, and leading-zero forms remain refused.

PRINT     = "print"
INT       = /0|[1-9][0-9]{0,249}/
PLUS      = "+"
DECREMENT = "--"
MINUS     = "-"
STAR      = "*"
LPAREN    = "("
RPAREN    = ")"
SEMICOLON = ";"

skip:
  WHITESPACE = /[ \t\n]+/
