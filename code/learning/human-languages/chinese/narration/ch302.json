    {
      "id": "ZH-W302-huo-alive",
      "sequence": 23635,
      "title": "活 (huó) — the water piece, 千, then 口",
      "headword": "活",
      "romanization": "huó",
      "gloss": "活 — the water piece, then 千 over 口",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:b548e3138c636cca",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — the water piece, 千, then 口",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — the water piece, 千, then 口 and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say huó — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *huó* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "洗 千."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — xǐ, qiān",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *xǐ*, *qiān*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — the water piece, 千, then 口",
          "segments": [
            {
              "kind": "speech",
              "text": "活 (huó)."
            },
            {
              "kind": "speech",
              "text": "Three pieces: the water piece on the left, then 千 over 口 on the right."
            },
            {
              "kind": "speech",
              "text": "The water piece, three strokes. As on the left of 洗: two dots, then a stroke rising to the right."
            },
            {
              "kind": "speech",
              "text": "千, three strokes. A short sweep down to the left, a bar across, and a vertical down through the bar."
            },
            {
              "kind": "speech",
              "text": "口, three strokes, under 千: a short vertical, a stroke that runs right and turns down, and the bar that closes the foot."
            },
            {
              "kind": "speech",
              "text": "3 + 3 + 3 = nine."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "活 (huó), all nine, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 活, all nine, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many pieces in 活 (huó)? (Three.) What is on the left? (The water piece, as in 洗.) What is under 千? (口.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 活 (huó), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
