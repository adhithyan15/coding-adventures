  claim c_and_u8:
    forall a: U8, b: U8. op_and_u8(a, b) == bit_and(a, b)
  claim c_not_u8:
    forall a: U8. op_not_u8(a) == bit_xor(a, max_value<U8>()) or op_not_u8(a) == bit_not(a)
  claim c_shl_u8:
    forall a: U8, n: Nat | n < 16. op_shl_u8(a, n) == shl(a, n)
  claim c_pop_u8:
    forall a: U8. op_pop_u8(a) == popcount(a)
  claim c_pop_bound_u8:
    forall a: U8. op_pop_u8(a) <= 8
  claim c_and_u16:
    forall a: U16, b: U16. op_and_u16(a, b) == bit_and(a, b)
  claim c_not_u16:
    forall a: U16. op_not_u16(a) == bit_xor(a, max_value<U16>()) or op_not_u16(a) == bit_not(a)
  claim c_shl_u16:
    forall a: U16, n: Nat | n < 32. op_shl_u16(a, n) == shl(a, n)
  claim c_pop_u16:
    forall a: U16. op_pop_u16(a) == popcount(a)
  claim c_pop_bound_u16:
    forall a: U16. op_pop_u16(a) <= 16
  claim c_and_u32:
    forall a: U32, b: U32. op_and_u32(a, b) == bit_and(a, b)
  claim c_not_u32:
    forall a: U32. op_not_u32(a) == bit_xor(a, max_value<U32>()) or op_not_u32(a) == bit_not(a)
  claim c_shl_u32:
    forall a: U32, n: Nat | n < 64. op_shl_u32(a, n) == shl(a, n)
  claim c_pop_u32:
    forall a: U32. op_pop_u32(a) == popcount(a)
  claim c_pop_bound_u32:
    forall a: U32. op_pop_u32(a) <= 32
  claim c_and_u64:
    forall a: U64, b: U64. op_and_u64(a, b) == bit_and(a, b)
  claim c_not_u64:
    forall a: U64. op_not_u64(a) == bit_xor(a, max_value<U64>()) or op_not_u64(a) == bit_not(a)
  claim c_shl_u64:
    forall a: U64, n: Nat | n < 128. op_shl_u64(a, n) == shl(a, n)
  claim c_pop_u64:
    forall a: U64. op_pop_u64(a) == popcount(a)
  claim c_pop_bound_u64:
    forall a: U64. op_pop_u64(a) <= 64
  claim c_and_i8:
    forall a: I8, b: I8. op_and_i8(a, b) == bit_and(a, b)
  claim c_not_i8:
    forall a: I8. op_not_i8(a) == bit_xor(a, max_value<I8>()) or op_not_i8(a) == bit_not(a)
  claim c_shl_i8:
    forall a: I8, n: Nat | n < 16. op_shl_i8(a, n) == shl(a, n)
  claim c_pop_i8:
    forall a: I8. op_pop_i8(a) == popcount(a)
  claim c_pop_bound_i8:
    forall a: I8. op_pop_i8(a) <= 8
  claim c_and_i16:
    forall a: I16, b: I16. op_and_i16(a, b) == bit_and(a, b)
  claim c_not_i16:
    forall a: I16. op_not_i16(a) == bit_xor(a, max_value<I16>()) or op_not_i16(a) == bit_not(a)
  claim c_shl_i16:
    forall a: I16, n: Nat | n < 32. op_shl_i16(a, n) == shl(a, n)
  claim c_pop_i16:
    forall a: I16. op_pop_i16(a) == popcount(a)
  claim c_pop_bound_i16:
    forall a: I16. op_pop_i16(a) <= 16
  claim c_and_i32:
    forall a: I32, b: I32. op_and_i32(a, b) == bit_and(a, b)
  claim c_not_i32:
    forall a: I32. op_not_i32(a) == bit_xor(a, max_value<I32>()) or op_not_i32(a) == bit_not(a)
  claim c_shl_i32:
    forall a: I32, n: Nat | n < 64. op_shl_i32(a, n) == shl(a, n)
  claim c_pop_i32:
    forall a: I32. op_pop_i32(a) == popcount(a)
  claim c_pop_bound_i32:
    forall a: I32. op_pop_i32(a) <= 32
  claim c_and_i64:
    forall a: I64, b: I64. op_and_i64(a, b) == bit_and(a, b)
  claim c_not_i64:
    forall a: I64. op_not_i64(a) == bit_xor(a, max_value<I64>()) or op_not_i64(a) == bit_not(a)
  claim c_shl_i64:
    forall a: I64, n: Nat | n < 128. op_shl_i64(a, n) == shl(a, n)
  claim c_pop_i64:
    forall a: I64. op_pop_i64(a) == popcount(a)
  claim c_pop_bound_i64:
    forall a: I64. op_pop_i64(a) <= 64
  claim c_low_u8:
    forall a: U8 | bit_and(a, 128u8) == 0u8. op_low_u8(a) == m_to_core(a)
  claim c_be32:
    forall a: U32. op_be32(a) == be_bytes(a)
  claim c_be32_round_trip:
    forall a: U32. from_be<U32>(op_be32(a)) == a
  claim c_div_u8:
    forall a: U8, b: U8 | b != 0u8. op_div_u8(a, b) == unwrap_or(div(a, b), 0u8)
  claim c_closure_only:
    forall a: U32. op_not_u32(a) == m_use_use(a)
  claim c_core_only:
    forall a: U8. op_not_u8(a) == m_pure_core(a)

  example e_rotl:
    op_not_u8(1u8) == rotl(128u8, 9)
  example e_widen:
    op_pop_u16(3u16) == to_nat(widen<U16>(2u8))
  example e_max:
    op_not_i8(0i8) == max_value<I8>()
  example e_core:
    op_not_u8(1u8) == 254u8
  example e_unwrap:
    op_div_u8(7u8, 2u8) == unwrap_or(div(7u8, 2u8), 0u8)

