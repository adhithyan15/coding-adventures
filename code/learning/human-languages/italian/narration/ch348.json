        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: il vantaggio",
          "segments": [
            {
              "kind": "speech",
              "text": "il vantaggio — \"the advantage\"."
            },
            {
              "kind": "speech",
              "text": "Abitare in centro ha molti vantaggi. Living in the centre has many advantages."
            },
            {
              "kind": "speech",
              "text": "Essere in vantaggio — to be ahead, in a match too."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "vantaggio is usually traced to Old French avantage, built on avant \"before, ahead\", from Late Latin abante, made from ab and ante \"before\" (Lewis & Short): being a step ahead."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
