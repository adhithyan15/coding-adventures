// RecordList.light.msl — light-theme styling.
//
// Only properties every native backend lowers (the toolkit's native gate
// allows no style drops). Text parts carry colour and size only: a Qt Text
// part cannot paint a background, border or padding (#15276), so the row's
// chrome lives on its Column, and the title button is drawn flat inside it.

style RecordList {
  part record-list {
    gap : 4 ;
  }
  part record-list-heading {
    color     : "#6c757d" ;
    font-size : 12 ;
  }
  part record-list-row {
    padding       : 12 ;
    gap           : 4 ;
    background    : "#ffffff" ;
    border-width  : 1 ;
    border-color  : "#dee2e6" ;
    border-radius : 4 ;
  }
  part record-list-line {
    gap : 8 ;
  }
  part record-list-title {
    padding       : 0 ;
    background    : "transparent" ;
    color         : "#212529" ;
    border-width  : 0 ;
    font-size     : 14 ;
    border-radius : 0 ;
  }
  part record-list-meta {
    color     : "#6c757d" ;
    font-size : 12 ;
  }
  part record-list-badge {
    color     : "#b45309" ;
    font-size : 12 ;
  }
  part record-list-subtitle {
    color     : "#6c757d" ;
    font-size : 13 ;
  }
  part record-list-row-selected {
    padding       : 12 ;
    gap           : 4 ;
    background    : "#e7f1ff" ;
    border-width  : 1 ;
    border-color  : "#9ec5fe" ;
    border-radius : 4 ;
  }
  part record-list-line-selected {
    gap : 8 ;
  }
  part record-list-title-selected {
    padding       : 0 ;
    background    : "transparent" ;
    color         : "#084298" ;
    border-width  : 0 ;
    font-size     : 14 ;
    border-radius : 0 ;
  }
  part record-list-meta-selected {
    color     : "#6c757d" ;
    font-size : 12 ;
  }
  part record-list-badge-selected {
    color     : "#b45309" ;
    font-size : 12 ;
  }
  part record-list-subtitle-selected {
    color     : "#6c757d" ;
    font-size : 13 ;
  }
}
