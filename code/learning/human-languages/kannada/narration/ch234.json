            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "a line, a money box, a suitcase, a hoe, a sickle",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: a line, a money box, a suitcase, a hoe, a sickle]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "a colleague, a meeting, an interview, a clerk, an officer",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: a colleague, a meeting, an interview, a clerk, an officer]"
            }
          ]
        },
        {
          "index": 2,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "A line? (ಗೆರೆ, gere.) A money box? (ಹುಂಡಿ, huṇḍi.) A suitcase? (ಸೂಟ್ಕೇಸ್, sūṭkēs.) A hoe? (ಗುದ್ದಲಿ, guddali.) A sickle? (ಕುಡುಗೋಲು, kuḍugōlu.) A colleague? (ಸಹೋದ್ಯೋಗಿ, sahōdyōgi.) A meeting? (ಸಭೆ, sabhe.) An interview? (ಸಂದರ್ಶನ, sandarśana.) A clerk? (ಗುಮಾಸ್ತ, gumāsta.) An officer? (ಅಧಿಕಾರಿ, adhikāri.)"
            }
          ]
        }
      ]
    },
