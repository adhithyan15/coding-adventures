# Perl 5.003_28 (1997-02-21) grammar: plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: unsupported Perl 5.003_28 syntax is rejected.
# Evidence: https://github.com/Perl/perl5/blob/perl-5.003_28/perly.y
# Tagged yacc only changes a comment from 5.003_27; this file retains only
# arithmetic precedence, parentheses and print subset.

program         = print_statement { print_statement } ;
print_statement = PRINT LPAREN expr RPAREN SEMICOLON ;
expr            = term { ( PLUS | MINUS ) term } ;
term            = unary { STAR unary } ;
unary           = MINUS unary | atom ;
atom            = INT | LPAREN expr RPAREN ;
