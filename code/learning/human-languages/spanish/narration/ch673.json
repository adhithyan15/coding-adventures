          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "acortar is built on corto \"short\", which is inherited from Latin curtus \"shortened, incomplete\" (EtymDB); EtymDB also links it with cortar \"to cut\", from the same Latin word."
            }
          ]
        },
