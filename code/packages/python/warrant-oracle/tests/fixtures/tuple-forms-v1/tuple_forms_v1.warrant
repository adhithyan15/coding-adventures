  op op_lit8(a: Bool, b: Bool, c: Bool, d: Bool, e: Bool, f: Bool, g: Bool, h: Bool) -> (Bool,Bool,Bool,Bool,Bool,Bool,Bool,Bool)
  op op_nested(a: Bool, b: Bool, c: Bool) -> ((Bool,Bool),Bool)
  op op_deep(a: Bool) -> (((Bool,Nat),Bool),Bytes<0>)
