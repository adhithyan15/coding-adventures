        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: vagor, vagārī",
          "segments": [
            {
              "kind": "speech",
              "text": "vagor, vagārī — \"to wander about, to roam\"."
            },
            {
              "kind": "speech",
              "text": "Canis sine dominō per viās oppidī vagātur. A dog without a master roams the streets of the town."
            },
            {
              "kind": "speech",
              "text": "Deponent: vagor, vagārī, vagātus sum. English vagabond comes from vagābundus, built on it."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "vagor is built on the adjective vagus 'wandering, roving' (EtymDB; Lewis & Short). English vague comes from vagus, and vagabond from vagābundus, built on the verb."
            }
          ]
        },
