    {
      "id": "ZH-W39-he-drink",
      "sequence": 3415,
      "title": "喝 (hē) — a mouth, a sun and a wrap",
      "headword": "喝",
      "romanization": "hē",
      "gloss": "喝 — a mouth, a sun, and a wrap",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:af1d8c78ff66a3b8",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — a mouth, a sun and a wrap",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — a mouth, a sun and a wrap and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say hē — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *hē* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "口 日 吃."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — kǒu, rì, chī",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *kǒu*, *rì*, *chī*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — a mouth, a sun and a wrap",
          "segments": [
            {
              "kind": "speech",
              "text": "喝 (hē)."
            },
            {
              "kind": "speech",
              "text": "Three pieces: 口 on the left, then 日, then the wrap under it. Do not count to twelve; count three."
            },
            {
              "kind": "speech",
              "text": "口, three strokes, small, as in 吃."
            },
            {
              "kind": "speech",
              "text": "日, four strokes, short and wide, at the top right."
            },
            {
              "kind": "speech",
              "text": "The wrap, five strokes. A short left-falling stroke. A horizontal that turns down and hooks, making a roof. Inside it, a small left-falling stroke and a dot. Then a corner stroke, down and along, closing them in."
            },
            {
              "kind": "speech",
              "text": "3 + 4 + 5 = twelve, and the first seven are two shapes you know."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "喝 (hē), all twelve, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 喝, all twelve, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many pieces in 喝 (hē)? (Three — 口, 日, and the wrap.) How many strokes before the wrap starts? (Seven.) What goes inside the wrap? (A small left-falling stroke and a dot.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 喝 (hē), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
