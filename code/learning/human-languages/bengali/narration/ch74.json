        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: দামি",
          "segments": [
            {
              "kind": "speech",
              "text": "দামি — dāmi — \"expensive\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "দামি (dāmi) is dām, \"price\", with the ending -i. CDIAL lists Bengali dām under Sanskrit dramma, \"a coin\", which it traces to Greek drakhmē through Middle Persian (CDIAL 6622)."
            }
          ]
        },
        {
