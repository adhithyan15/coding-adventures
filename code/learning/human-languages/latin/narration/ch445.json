        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: dēverticulum, dēverticulī",
          "segments": [
            {
              "kind": "speech",
              "text": "dēverticulum, dēverticulī — \"a roadside inn, a lodging; a side road\"."
            },
            {
              "kind": "speech",
              "text": "Nox venit, itaque viātōrēs in dēverticulum intrant. Night is coming, so the travellers go into a roadside inn."
            },
            {
              "kind": "speech",
              "text": "Second declension, neuter: dēverticulum, dēverticulī n. A place you turn off the road for: first a side road, then the inn at its end."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "dēverticulum is built on dēvertō 'to turn aside' with the suffix -culum 'place for' (EtymDB; Lewis & Short): a place you turn aside to. dēvertō comes from vertō 'to turn'."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
