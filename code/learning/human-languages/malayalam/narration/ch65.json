          "segments": [
            {
              "kind": "speech",
              "text": "മര്യാദ (maryāda) — \"good manners\"."
            },
            {
              "kind": "speech",
              "text": "Sanskrit maryādā, whose first sense was a boundary mark set at the edge of a field, and whose second is the bounds of proper conduct."
            },
            {
              "kind": "speech",
              "text": "Kerala keeps both senses live in one word. To have മര്യാദ (maryāda) is to know where the edges are and to stop at them without being asked."
            },
            {
              "kind": "speech",
              "text": "Beside bahumānaṁ, respect, which is something a person shows another, this is something a person keeps for themselves."
            }
          ]
        },
