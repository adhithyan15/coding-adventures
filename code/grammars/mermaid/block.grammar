# @version 1
# Mermaid 11.16.1 block diagram core parser grammar.

document = { NEWLINE } HEADER body EOF ;
body = { NEWLINE | STATEMENT_LINE | ARROW_NODE_LINE | DEFAULT_CLASSDEF_LINE | INLINE_LABELED_NODE_CONNECTION_LINE | TILDE_NODE_CONNECTION_LINE | INLINE_NODE_CONNECTION_LINE | COMPACT_MARKED_CONNECTION_LINE | MARKED_CONNECTION_LINE | BIDIRECTIONAL_CONNECTION_LINE | DOTTED_CONNECTION_LINE | THICK_CONNECTION_LINE | group } ;
group = ( HEADER | GROUP_START ) body GROUP_END ;
