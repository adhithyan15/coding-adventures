            {
              "kind": "speech",
              "text": "Before the new one: say the Latin for hollow, vain, then the Latin for heavy, serious."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: nōtus, nōta, nōtum",
          "segments": [
            {
              "kind": "speech",
              "text": "nōtus, nōta, nōtum — \"known, famous\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "nōtus is the past participle of nōscō, \"to get to know\" (Lewis & Short): known. nōscō, older gnōscō, is usually traced to Proto-Indo-European gneh3-, \"to know\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
