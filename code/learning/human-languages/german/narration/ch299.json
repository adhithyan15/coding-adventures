            },
            {
              "kind": "speech",
              "text": "Before the new one: say the German for the bridegroom, then the German for the bride and groom."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: die Ehe",
          "segments": [
            {
              "kind": "speech",
              "text": "die Ehe — \"the marriage\"."
            },
            {
              "kind": "speech",
              "text": "Ihre Ehe hielt fünfzig Jahre. Their marriage lasted fifty years."
            },
            {
              "kind": "speech",
              "text": "Plural: die Ehen. The adjective is verheiratet."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Ehe goes back to Middle High German ē (EtymDB), usually traced to Old High German ēwa \"law, eternity\": marriage as a lasting bond."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
            }
