          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "bonobús is built from bono \"voucher\", from Latin bonus \"good\", and bus, short for autobús, from Latin omnibus \"for all\"."
            }
          ]
        },
