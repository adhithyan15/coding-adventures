    "@coding-adventures/forme-stage": "file:../forme-stage",
    "tsx": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.0"
