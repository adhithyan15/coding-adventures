        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: effectus, effectūs",
          "segments": [
            {
              "kind": "speech",
              "text": "effectus, effectūs — \"a result, an effect; performance\"."
            },
            {
              "kind": "speech",
              "text": "Effectus cōnsiliī bonus fuit. The result of the plan was good."
            },
            {
              "kind": "speech",
              "text": "effectus, effectūs m., built on efficiō. English effect."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "effectus is the noun built on efficiō \"to bring about\" (EtymDB; Lewis & Short). English effect comes from it."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
