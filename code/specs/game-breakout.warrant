-- GAME14 -- Game Breakout: Deterministic Arcade Breakout State Machine & PaintVM Renderer
--
-- Warrant document for game-breakout (VER04j and VER04m: state=explicit).
-- Formal verification contract for pure deterministic Breakout simulation.

warrant game_breakout v1
  error BreakoutError = InvalidConfig | NonFiniteState | StateOutOfBounds | NegativeDimension | CollisionError | ClockError | PaintError | AudioError

  model Unit = Bool
  variant PaddleMove = Hold | Left | Right

  record BreakoutConfig(arena_width: F64, arena_height: F64, paddle_width: F64, paddle_height: F64, paddle_speed: F64, paddle_bottom_inset: F64, ball_radius: F64, ball_initial_speed: F64, ball_max_speed: F64, ball_speed_increment: F64, max_deflection_angle_rad: F64, brick_rows: U32, brick_cols: U32, initial_lives: U32, fixed_dt_seconds: F64)

  record BreakoutPoint(x: F64, y: F64)

  record BrickSlot(row: U8, col: U8, hits_remaining: U8, max_hits: U8, points: U32)

  record BreakoutState(config: BreakoutConfig, paddle_x: F64, ball_pos: BreakoutPoint, ball_vel: BreakoutPoint, ball_attached: Bool, active_bricks: U32, score: U32, lives: U32, level: U32, combo_counter: U32, prng_seed: U64, game_over: Bool)

  record BreakoutInput(movement: PaddleMove, launch: Bool)

  record BreakoutFrameEvents(paddle_hit: Bool, wall_bounce: Bool, brick_hit_row: Option<U8>, life_lost: Bool, level_cleared: Bool, game_over: Bool, points_scored: U32, combo_count: U32)

  op default_config() -> BreakoutConfig
  op validate_config(config: BreakoutConfig) -> Result<Unit, BreakoutError>
  op new_game(config: BreakoutConfig, seed: U64) -> Result<BreakoutState, BreakoutError>
  op validate_state(state: BreakoutState) -> Result<Unit, BreakoutError>
  op prng_next(state: U64) -> U64

  assume platform:
    contract.trig.pure_software
  assume environment:
    none

  labels default_config:
    none
  labels validate_config:
    config public
  labels new_game:
    config public
    seed public
  labels validate_state:
    state public
  labels prng_next:
    state public

  input validate_config.config:
    hostile
    ensures no_panic, terminates

  input new_game.config:
    hostile
    ensures no_panic, terminates
  input new_game.seed:
    hostile
    ensures no_panic, terminates

  input validate_state.state:
    hostile
    ensures no_panic, terminates

  input prng_next.state:
    hostile
    ensures no_panic, terminates

  bound default_config:
    steps <= 32
    heap <= 0

  bound validate_config:
    steps <= 64
    heap <= 0

  bound new_game:
    steps <= 128
    heap <= 0

  bound validate_state:
    steps <= 128
    heap <= 0

  bound prng_next:
    steps <= 16
    heap <= 0

  claim default_config_valid:
    validate_config(default_config()) == Ok(true)

  claim new_game_from_default_valid:
    forall s: U64. match new_game(default_config(), s) with Ok(st) -> validate_state(st) == Ok(true) | Err(_) -> false
