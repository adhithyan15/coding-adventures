  "lessons": [
    {
      "id": "MW-C151-ar-together",
      "sequence": 9430,
      "title": "अर (ar) — put two familiar things together",
      "headword": "अर",
      "romanization": "ar",
      "gloss": "and; the linking particle between two familiar things",
      "script": "devanagari",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:c0da8faa0824c4ee",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Say कुत्तो (kutto, a dog). Then say बिल्ली (billī, a cat). Keep the two words separate for one more breath."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: अर",
          "segments": [
            {
              "kind": "speech",
              "text": "अर — ar — and, joining this thing with that thing."
            },
            {
              "kind": "speech",
              "text": "The Government of India's Linguistic Survey of India — Rajasthan, Part I records Marwari अर (ar) as the particle that links words or groups of words. Its own example joins a dog and a cat. This lesson keeps the book's already-taught word बिल्ली for cat."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "The official survey attests the Marwari form and its “and / or” use, but does not derive it. Its origin remains unknown in the source used for this lesson."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "Put अर (ar) between the two things:"
            },
            {
              "kind": "speech",
              "text": "कुत्तो अर बिल्ली — kutto ar billī — a dog and a cat."
            },
            {
              "kind": "speech",
              "text": "Nothing changes on either noun. The small joining word does the new work."
            }
          ]
        },
        {
          "index": 4,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "कुत्तो अर (ar) बिल्ली",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: **कुत्तो अर बिल्ली**]"
            },
            {
              "kind": "prompt",
              "action": "SWITCH",
              "instruction": "cat first — बिल्ली अर (ar) कुत्तो",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SWITCH: cat first — **बिल्ली अर कुत्तो**]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say only the joining word — अर (ar)",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say only the joining word — **अर**]"
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Say कुत्तो अर बिल्ली once without looking. What is the one new piece? (अर, ar, and.)"
            },
            {
              "kind": "speech",
              "text": "Source: Government of India, Linguistic Survey of India — Rajasthan, Part I, section 4.5, “Conjunctive particle”, pp. 125–126."
            },
            {
              "kind": "activity",
              "scored": true,
              "spoken": true,
              "id": "MW-C151-ar-together-link",
              "prompt": "Join kutto and billi with the new Marwadi word for and.",
              "assesses": [
                "MW-CONJ-AR-01",
                "MW-GRAMMAR-COORDINATE-AND-01"
              ],
              "responseSeconds": 10,
              "acceptedResponses": [
                "कुत्तो अर बिल्ली",
                "kutto ar billi"
              ],
              "feedback": {
                "correct": "Right: अर links the two familiar nouns.",
                "incorrect": "Put अर between them: कुत्तो अर बिल्ली."
              }
            }
          ]
        }
      ]
    },
    {
      "id": "MW-C151-ar-choice",
      "sequence": 9440,
      "title": "चाय अर पाणी? (chāy ar pāṇī?) — offer two familiar choices",
      "headword": "चाय अर पाणी?",
      "romanization": "chāy ar pāṇī?",
      "gloss": "tea or water; a small offered choice",
      "script": "devanagari",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:d582f3000df0e13f",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Say चाय (chāy, tea), then पाणी (pāṇī, water). Join them once with अर (ar) as “tea and water”."
            }
          ]
        },
        {
          "index": 1,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "The official survey gives अर (ar) both “and” and “or” value. When somebody offers two alternatives with a question contour, the same small word carries the choice:"
            },
            {
              "kind": "speech",
              "text": "चाय अर पाणी? — chāy ar pāṇī? — Tea or water?"
            },
            {
              "kind": "speech",
              "text": "The setting and the rising question do the separating. Do not import a Hindi connector to make the choice look more familiar."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The phrase, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "This lesson adds a new use, not a new connector. The official survey attests अर (ar) with “and / or” value but does not derive it; its deeper origin remains unknown in that source."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "ASK",
              "instruction": "चाय अर पाणी? (chāy ar pāṇī?)",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU ASK: **चाय अर पाणी?**]"
            },
            {
              "kind": "prompt",
              "action": "ANSWER",
              "instruction": "पाणी।",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU ANSWER: **पाणी।**]"
            },
            {
              "kind": "prompt",
              "action": "ASK",
              "instruction": "reverse the alternatives — पाणी अर (ar) चाय?",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU ASK: reverse the alternatives — **पाणी अर चाय?**]"
            },
            {
              "kind": "prompt",
              "action": "ANSWER",
              "instruction": "चाय।",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU ANSWER: **चाय।**]"
            },
            {
              "kind": "speech",
              "text": "One short item is enough for the answer. This lesson teaches how to hand over a real choice; it does not yet teach “I prefer”."
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Offer tea or water. Answer with one item. This closes a tiny two-turn choice, not a general preference statement."
            },
            {
              "kind": "speech",
              "text": "Source: Government of India, Linguistic Survey of India — Rajasthan, Part I, section 4.5, “Conjunctive particle”, pp. 125–126."
            },
            {
              "kind": "activity",
              "scored": true,
              "spoken": true,
              "id": "MW-C151-ar-choice-offer",
              "prompt": "Offer the choice tea or water in Marwadi.",
              "assesses": [
                "MW-GRAMMAR-ALTERNATIVE-CHOICE-01",
                "MW-FUNCTION-ASK-PREFERENCE-ALTERNATIVES-01"
              ],
              "responseSeconds": 10,
              "acceptedResponses": [
                "चाय अर पाणी?",
                "chay ar pani",
                "chāy ar pāṇī"
              ],
              "feedback": {
                "correct": "Right: the two alternatives and question contour give अर its choice value.",
                "incorrect": "Offer the two familiar items as चाय अर पाणी?"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "MW-C151-pan-contrast",
      "sequence": 9450,
      "title": "पण (paṇ) — set one statement against another",
      "headword": "पण",
      "romanization": "paṇ",
      "gloss": "but, yet; a contrast between two short statements",
      "script": "devanagari",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:e452ea012f776db2",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Say चाय गरम है। Tea is hot. Then say पाणी ठंडो है। Water is cold. Keep both short statements intact."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: पण",
          "segments": [
            {
              "kind": "speech",
              "text": "पण — paṇ — but, yet."
            },
            {
              "kind": "speech",
              "text": "The Government of India's survey records Marwari पण (paṇ) as the particle for “yet/but”. A Marwari dictionary independently prints the same Devanagari form and labels it a conjunction meaning “but”."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "The two sources attest the Marwari form and meaning but do not give an etymology. Its origin remains unknown in the sources used for this lesson."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "Keep the two familiar statements and put पण (paṇ) at their turning point:"
            },
            {
              "kind": "speech",
              "text": "चाय गरम है, पण पाणी ठंडो है। chāy garam hai, paṇ pāṇī ṭhaṇḍo hai. Tea is hot, but water is cold."
            },
            {
              "kind": "speech",
              "text": "The first statement stays true. पण (paṇ) tells the listener that the second one pulls in a different direction."
            }
          ]
        },
        {
          "index": 4,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "चाय गरम है",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: **चाय गरम है**]"
            },
            {
              "kind": "prompt",
              "action": "ADD",
              "instruction": "पण (paṇ) पाणी ठंडो है",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU ADD: **पण पाणी ठंडो है**]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "the whole contrast once, keeping पण (paṇ) in the middle",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: the whole contrast once, keeping **पण** in the middle]"
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What single word marks the turn? (पण, paṇ, but/yet.) Say the whole contrast once more."
            },
            {
              "kind": "speech",
              "text": "Sources: Government of India, Linguistic Survey of India — Rajasthan, Part I, section 4.5, pp. 125–126; Marwari–Urdu–English Dictionary, entry पण (paṇ)."
            },
            {
              "kind": "activity",
              "scored": true,
              "spoken": true,
              "id": "MW-C151-pan-contrast-turn",
              "prompt": "Join 'tea is hot' and 'water is cold' as a contrast.",
              "assesses": [
                "MW-CONJ-PAN-01",
                "MW-GRAMMAR-ADVERSATIVE-PAN-01"
              ],
              "responseSeconds": 12,
              "acceptedResponses": [
                "चाय गरम है, पण पाणी ठंडो है।",
                "chay garam hai pan pani thando hai",
                "chāy garam hai paṇ pāṇī ṭhaṇḍo hai"
              ],
              "feedback": {
                "correct": "Right: पण turns from the first statement to the contrast.",
                "incorrect": "Keep both statements and place पण between them."
              }
            }
          ]
        }
      ]
    },
    {
      "id": "MW-C151-kyunkai-reason",
      "sequence": 9460,
      "title": "क्यूंकै — give one short reason",
      "headword": "बाटी गरम है क्यूंकै तवो गरम है।",
      "romanization": "bāṭī garam hai kyū̃kai tavo garam hai.",
      "gloss": "the bati is hot because the griddle is hot; one statement and one reason",
      "script": "devanagari",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:b522be5dcc3730e1",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Bring back क्यूंकै (kyū̃kai, because), बाटी (bāṭī), तवो (tavo, a griddle), and गरम है (garam hai, is hot)."
            }
          ]
        },
        {
          "index": 1,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Chapter 117 takes क्यूंकै apart as kyū̃ plus kai. CDIAL lists Old Marwari kyu under Sanskrit kim “what” (CDIAL 3164); the origin of the second part remains not settled. This lesson reuses that word and adds only the two-clause reason frame."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "Chapter 117 taught the word क्यूंकै. A word meaning “because” is not yet a reason. Put one complete familiar statement before it and another after it:"
            },
            {
              "kind": "speech",
              "text": "बाटी गरम है क्यूंकै तवो गरम है। bāṭī garam hai kyū̃kai tavo garam hai. The bati is hot because the griddle is hot."
            },
            {
              "kind": "speech",
              "text": "The first part says what is so. The second gives one reason. Both small statements keep है at their ends."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "बाटी गरम है",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: **बाटी गरम है**]"
            },
            {
              "kind": "prompt",
              "action": "ADD",
              "instruction": "क्यूंकै तवो गरम है",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU ADD: **क्यूंकै तवो गरम है**]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "the complete reason line once",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: the complete reason line once]"
            },
            {
              "kind": "speech",
              "text": "Now retrieve the chapter in four small moves:"
            },
            {
              "kind": "speech",
              "text": "join कुत्तो and बिल्ली with अर (ar);"
            },
            {
              "kind": "speech",
              "text": "offer चाय अर पाणी? (chāy ar pāṇī?) and answer with one;"
            },
            {
              "kind": "speech",
              "text": "contrast hot tea with cold water using पण (paṇ); and."
            },
            {
              "kind": "speech",
              "text": "give the bati-and-griddle reason using क्यूंकै."
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Say the whole reason once without looking. This is one small curriculum frame against a partial inventory: it is not an A1 mock, not A1 readiness, not an attainment claim, and not human validation."
            },
            {
              "kind": "speech",
              "text": "Source for क्यूंकै: the existing chapter-117 Marwadi lesson and its cited dictionary/CDIAL trail. No new lexical source is claimed here."
            },
            {
              "kind": "activity",
              "scored": true,
              "spoken": true,
              "id": "MW-C151-kyunkai-reason-frame",
              "prompt": "Say that the bati is hot because the griddle is hot.",
              "assesses": [
                "MW-LEX-C117-WHY117-05",
                "MW-GRAMMAR-CAUSAL-KYUNKAI-01"
              ],
              "responseSeconds": 14,
              "acceptedResponses": [
                "बाटी गरम है क्यूंकै तवो गरम है।",
                "bati garam hai kyunkai tavo garam hai",
                "bāṭī garam hai kyū̃kai tavo garam hai"
              ],
              "feedback": {
                "correct": "Right: क्यूंकै links the statement to its reason.",
                "incorrect": "Say the first statement, then क्यूंकै, then the griddle reason."
              }
            }
          ]
        }
      ]
    }
  ],
