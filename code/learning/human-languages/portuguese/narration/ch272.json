        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: durar",
          "segments": [
            {
              "kind": "speech",
              "text": "durar — \"to last\"."
            },
            {
              "kind": "speech",
              "text": "A viagem durou cinco horas. The journey lasted five hours."
            },
            {
              "kind": "speech",
              "text": "Durar muito — to last a long time; durar pouco — not to last long."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "durar is inherited from Latin dūrāre \"to harden, to hold out, to last\" (Lewis & Short), built on dūrus \"hard\"."
            }
          ]
        },
        {
