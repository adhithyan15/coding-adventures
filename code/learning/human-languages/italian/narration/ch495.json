        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: adottare",
          "segments": [
            {
              "kind": "speech",
              "text": "adottare — \"to adopt\"."
            },
            {
              "kind": "speech",
              "text": "Hanno adottato una bambina di due anni. They adopted a two-year-old girl."
            },
            {
              "kind": "speech",
              "text": "Also for ideas: adottare un metodo."
            }
          ]
