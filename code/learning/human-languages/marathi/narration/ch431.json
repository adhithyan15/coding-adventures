              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *bighāḍ*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "bighāḍ, once more",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *bighāḍ*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "iñjināt bighāḍ jhālyāmuḷe gāḍī thāmblī. — The train stopped because of a fault in the engine.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *iñjināt bighāḍ jhālyāmuḷe gāḍī thāmblī.* — The train stopped because of a fault in the engine.]"
            },
            {
              "kind": "prompt",
