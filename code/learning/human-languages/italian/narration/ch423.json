        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: la crociera",
          "segments": [
            {
              "kind": "speech",
              "text": "la crociera — \"the cruise\"."
            },
            {
              "kind": "speech",
              "text": "I miei genitori vanno in crociera. My parents are going on a cruise."
            },
            {
              "kind": "speech",
              "text": "La velocità di crociera — cruising speed."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "crociera is built on croce 'cross', which is inherited from Latin crux (Lewis & Short): first a ship crossing back and forth over a stretch of sea."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
