        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: anschließend",
          "segments": [
            {
              "kind": "speech",
              "text": "anschließend — \"afterwards, subsequently\"."
            },
            {
              "kind": "speech",
              "text": "Wir waren im Kino, und anschließend haben wir gegessen. We were at the cinema, and afterwards we ate."
            },
            {
              "kind": "speech",
              "text": "At the start of a clause the verb comes second: Anschließend gingen wir nach Hause."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "anschließend is the present participle of anschließen \"to join on\", built on schließen \"to close\", which is inherited from Old High German sliozan \"to close, to lock\" (EtymDB): what is joined on next."
            }
          ]
        },
        {
