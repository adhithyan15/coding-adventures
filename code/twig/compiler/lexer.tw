; Generated by grammar-tools from twig.tokens — DO NOT EDIT
;
; Twig lexer: converts a source string into a flat list of Token records.
; Regenerate with:
;   grammar-tools compile-tokens-twig twig.tokens -o lexer.tw

(module compiler/lexer
  (typed lenient)
  (export lex-source)
  (import compiler/span compiler/token))

; ─── Character predicates (derived from token patterns) ──────────────────────────

(define (lex-digit? c)
  ; INTEGER pattern: /[0-9]/ — ASCII 48 ('0') through 57 ('9')
  (and (>= c 48) (<= c 57)))

(define (lex-whitespace? c)
  ; WHITESPACE skip: /[ \t\r\n]+/ — 32=space 9=tab 13=cr 10=newline
  (or (= c 32) (= c 9) (= c 13) (= c 10)))

(define (lex-name-start? c)
  ; NAME pattern first-char class: /[A-Za-z+\-*/=<>!?_$]/
  (or (and (>= c 65) (<= c 90))    ; A–Z
      (and (>= c 97) (<= c 122))   ; a–z
      (= c 43)                      ; +
      (= c 45)                      ; - (also ARROW first char; ARROW checked first)
      (= c 42)                      ; *
      (= c 47)                      ; /
      (= c 61)                      ; =
      (= c 60)                      ; <
      (= c 62)                      ; >
      (= c 33)                      ; !
      (= c 63)                      ; ?
      (= c 95)                      ; _
      (= c 36)))                    ; $

(define (lex-name-continue? c)
  ; NAME continuation class: name-start chars plus digits
  (or (lex-name-start? c) (lex-digit? c)))

; ─── Scan helpers — advance pos, return (cons new-pos lexeme) ────────────────────

(define (lex-scan-name src pos len start)
  ; NAME pattern: advance while lex-name-continue?
  (if (>= pos len)
      (cons pos (substring src start pos))
      (if (lex-name-continue? (char->integer (string-ref src pos)))
          (lex-scan-name src (+ pos 1) len start)
          (cons pos (substring src start pos)))))

(define (lex-scan-digits src pos len start)
  ; INTEGER pattern: /[0-9]+/ continuation after the leading digit or '-'
  (if (>= pos len)
      (cons pos (substring src start pos))
      (if (lex-digit? (char->integer (string-ref src pos)))
          (lex-scan-digits src (+ pos 1) len start)
          (cons pos (substring src start pos)))))

(define (lex-scan-string src pos len start)
  ; STRING pattern: /"([^"\\]|\\.)*"/
  ; Called after consuming the opening '"'.  Returns (cons pos-after-close-quote content).
  ; 34='"'  92='\\'
  (if (>= pos len)
      (cons pos (substring src start pos))
      (let* ((c (char->integer (string-ref src pos))))
        (if (= c 34)
            (cons (+ pos 1) (substring src start pos))
            (if (and (= c 92) (< (+ pos 1) len))
                (lex-scan-string src (+ pos 2) len start)
                (lex-scan-string src (+ pos 1) len start))))))

(define (lex-skip-whitespace src pos len)
  ; WHITESPACE skip: advance past spaces/tabs/crs/newlines
  (if (>= pos len)
      pos
      (if (lex-whitespace? (char->integer (string-ref src pos)))
          (lex-skip-whitespace src (+ pos 1) len)
          pos)))

(define (lex-skip-comment src pos len)
  ; COMMENT skip: advance from after ';' to end of line
  ; 10 = '\n'
  (if (>= pos len)
      pos
      (if (= (char->integer (string-ref src pos)) 10)
          (+ pos 1)
          (lex-skip-comment src (+ pos 1) len))))

; ─── Main lex loop ─────────────────────────────────────────────────────────────

(define (lex-emit src next-pos len acc tok)
  (lex-loop src next-pos len (cons tok acc)))

(define (lex-loop src pos len acc)
  (if (>= pos len)
      (reverse (cons (Token (TkEOF) "" (make-span 0 pos pos)) acc))
      (let* ((c (char->integer (string-ref src pos))))
        (lex-dispatch-0 src pos len acc c))))

; ─── Token dispatch chain (grammar-file order) ─────────────────────────────────
; One function per token or token group.  Each tests one condition;
; on no-match it tails into the next function (lex-dispatch-N+1).

; LPAREN = "("
(define (lex-dispatch-0 src pos len acc c)
  (if (= c 40)  ; '('
      (lex-emit src (+ pos 1) len acc
                (Token (TkLParen) "(" (make-span 0 pos (+ pos 1))))
      (lex-dispatch-1 src pos len acc c)))

; RPAREN = ")"
(define (lex-dispatch-1 src pos len acc c)
  (if (= c 41)  ; ')'
      (lex-emit src (+ pos 1) len acc
                (Token (TkRParen) ")" (make-span 0 pos (+ pos 1))))
      (lex-dispatch-2 src pos len acc c)))

; QUOTE = "'"
(define (lex-dispatch-2 src pos len acc c)
  (if (= c 39)  ; '\''
      (lex-emit src (+ pos 1) len acc
                (Token (TkQuote) "'" (make-span 0 pos (+ pos 1))))
      (lex-dispatch-3 src pos len acc c)))

; COLON = ":"
(define (lex-dispatch-3 src pos len acc c)
  (if (= c 58)  ; ':'
      (lex-emit src (+ pos 1) len acc
                (Token (TkColon) ":" (make-span 0 pos (+ pos 1))))
      (lex-dispatch-4 src pos len acc c)))

; ARROW = "->"
(define (lex-dispatch-4 src pos len acc c)
  (if (and (= c 45)  ; '-'
           (< (+ pos 1) len)
           (= (char->integer (string-ref src (+ pos 1))) 62))  ; '>'
      (lex-emit src (+ pos 2) len acc
                (Token (TkIdentifier) "->" (make-span 0 pos (+ pos 2))))
      (lex-dispatch-5 src pos len acc c)))

; BOOL_TRUE = "#t"
(define (lex-dispatch-5 src pos len acc c)
  (if (and (= c 35)  ; '#'
           (< (+ pos 1) len)
           (= (char->integer (string-ref src (+ pos 1))) 116))  ; 't'
      (lex-emit src (+ pos 2) len acc
                (Token (TkBoolean) "#t" (make-span 0 pos (+ pos 2))))
      (lex-dispatch-6 src pos len acc c)))

; BOOL_FALSE = "#f"
(define (lex-dispatch-6 src pos len acc c)
  (if (and (= c 35)  ; '#'
           (< (+ pos 1) len)
           (= (char->integer (string-ref src (+ pos 1))) 102))  ; 'f'
      (lex-emit src (+ pos 2) len acc
                (Token (TkBoolean) "#f" (make-span 0 pos (+ pos 2))))
      (lex-dispatch-7 src pos len acc c)))

; STRING = /"([^"\\]|\\.)*"/
(define (lex-dispatch-7 src pos len acc c)
  ; 34 = '"'
  (if (= c 34)
      (let* ((r   (lex-scan-string src (+ pos 1) len (+ pos 1)))
             (ep  (car r))
             (lex (cdr r)))
        (lex-emit src ep len acc
                  (Token (TkString) lex (make-span 0 pos ep))))
      (lex-dispatch-8 src pos len acc c)))

; INTEGER = /-?[0-9]+/
(define (lex-dispatch-8 src pos len acc c)
  ; INTEGER = /-?[0-9]+/
  ; Positive integer: first char is a digit.
  (if (lex-digit? c)
      (let* ((r   (lex-scan-digits src (+ pos 1) len pos))
             (ep  (car r))
             (lex (cdr r)))
        (lex-emit src ep len acc
                  (Token (TkInteger) lex (make-span 0 pos ep))))
  ; Negative integer: '-' followed by a digit.
  (if (and (= c 45)  ; '-'
           (< (+ pos 1) len)
           (lex-digit? (char->integer (string-ref src (+ pos 1)))))
      (let* ((r   (lex-scan-digits src (+ pos 2) len pos))
             (ep  (car r))
             (lex (cdr r)))
        (lex-emit src ep len acc
                  (Token (TkInteger) lex (make-span 0 pos ep))))
  (lex-dispatch-9 src pos len acc c))))

; NAME = /[A-Za-z+\-*/=<>!?_$][A-Za-z+\-*/=<>!?_$0-9]*/
(define (lex-dispatch-9 src pos len acc c)
  ; NAME = /[A-Za-z+\-*/=<>!?_$][A-Za-z+\-*/=<>!?_$0-9]*/
  (if (lex-name-start? c)
      (let* ((r   (lex-scan-name src (+ pos 1) len pos))
             (ep  (car r))
             (lex (cdr r)))
        (lex-emit src ep len acc
                  (Token (TkIdentifier) lex (make-span 0 pos ep))))
      (lex-dispatch-10 src pos len acc c)))

; WHITESPACE skip (from skip: section)
(define (lex-dispatch-10 src pos len acc c)
  (if (lex-whitespace? c)
      (lex-loop src (lex-skip-whitespace src pos len) len acc)
      (lex-dispatch-11 src pos len acc c)))

; COMMENT skip (from skip: section)
(define (lex-dispatch-11 src pos len acc c)
  (if (= c 59)  ; ';'
      (lex-loop src (lex-skip-comment src (+ pos 1) len) len acc)
      (lex-unknown src pos len acc c)))

; Unrecognized character: skip byte and continue.
(define (lex-unknown src pos len acc c)
  (lex-loop src (+ pos 1) len acc))

; ─── Public API ─────────────────────────────────────────────────────────────────

(define (lex-source src)
  (lex-loop src 0 (string-length src) (list)))
