        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: kěyǐ",
          "segments": [
            {
              "kind": "speech",
              "text": "kěyǐ — \"may; can (with permission)\"."
            },
            {
              "kind": "speech",
              "text": "wǒ kěyǐ zuò zhèr ma — May I sit here?"
            },
            {
              "kind": "speech",
              "text": "Two dips in a row: spoken, the first one rises, kéyǐ. It is written kěyǐ."
            },
            {
              "kind": "speech",
              "text": "Its characters come later; for now it is a word for the ear."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "kěyǐ is built from kě 'may' and yǐ 'to use', both inherited from Middle Chinese, khaX and yiX (Guangyun, in Baxter's transcription), glossed 'to permit' and 'to use'."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "会 (huì) learned, 能 (néng) able or allowed, kěyǐ permitted. Asking whether you may, kěyǐ is the polite one; the answer is kěyǐ, or bù kěyǐ."
            }
          ]
        },
        {
          "index": 4,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "kěyǐ — and hear it as kéyǐ",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *kěyǐ* — and hear it as *kéyǐ*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "kěyǐ, once more",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *kěyǐ*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "wǒ kěyǐ zuò zhèr ma — May I sit here?",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *wǒ kěyǐ zuò zhèr ma* — May I sit here?]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "kěyǐ — yes, you may",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *kěyǐ* — yes, you may]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say gōngrén, then kěyǐ again",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *gōngrén*, then *kěyǐ* again]"
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What does kěyǐ ask? (Whether you may.) How is it said? (kéyǐ, the first dip rising.)"
            }
          ]
        }
      ]
    },
