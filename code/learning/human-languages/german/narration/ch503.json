          "type": "input",
          "title": "You'll want to know: gärtnern",
          "segments": [
            {
              "kind": "speech",
              "text": "gärtnern — \"to garden\"."
            },
            {
              "kind": "speech",
              "text": "In ihrer Freizeit gärtnert meine Mutter gern. In her free time my mother likes gardening."
            },
            {
              "kind": "speech",
              "text": "Built on der Gärtner — gardener."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "gärtnern is built on Gärtner \"gardener\", from Garten, which is inherited from Old High German garto \"garden, enclosure\", from Proto-Germanic gardô (EtymDB)."
            }
          ]
        },
        {
