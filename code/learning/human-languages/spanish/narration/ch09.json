  "lessons": [
    {
      "id": "ES-C04-como-estas-register",
      "sequence": 320,
      "title": "¿cómo está usted? / ¿cómo estás? — choose the register",
      "headword": "¿cómo está usted? / ¿cómo estás?",
      "romanization": "¿cómo está usted? / ¿cómo estás?",
      "gloss": "formal and informal how-are-you questions differ in the verb ending and presence of usted",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:d8508297735e4090",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "You can already ask a stranger ¿Cómo está usted? Now change only the relationship: ask the same question of a friend."
            }
          ]
        },
        {
          "index": 1,
          "type": "grammar",
          "title": "Grammar Lens: one question, two relationships",
          "segments": [
            {
              "kind": "table",
              "headers": [
                "register",
                "question"
              ],
              "columns": 2,
              "rowCount": 2,
              "utterances": [
                "register: formal (stranger, elder, customer). question: ¿Cómo está usted?",
                "register: informal (friend, peer, child). question: ¿Cómo estás?"
              ]
            },
            {
              "kind": "speech",
              "text": "The formal version uses the third-person ending está plus usted. The informal version uses second-person estás and normally omits tú. This is the same relationship contrast you drilled with se llama / te llamas."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "to a doctor you just met — \"¿Cómo está usted?\"",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: to a doctor you just met — \"¿Cómo está usted?\"]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "to your cousin — \"¿Cómo estás?\"",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: to your cousin — \"¿Cómo estás?\"]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "swap back and forth — \"está usted / estás\"",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: swap back and forth — \"está usted / estás\"]"
            },
            {
              "kind": "repeat",
              "times": 2,
              "source": "[REPEAT x2]"
            },
            {
              "kind": "speech",
              "text": "Ask both versions until the ending swap is automatic."
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Which version fits a stranger? (¿Cómo está usted?) Which fits a friend? (¿Cómo estás?) What two things change? (The verb ending and the pronoun.)"
            }
          ]
        }
      ]
    },
    {
      "id": "ES-C04-regular",
      "sequence": 330,
      "title": "regular / más o menos — the honest \"so-so\"",
      "headword": "regular",
      "romanization": "regular",
      "gloss": "so-so / not great (also \"más o menos\")",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:06db72f7494a384f",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "You asked ¿cómo estás? Now you can answer three ways: great, middling, or a wave of the hand. You already have bien (\"well\"). Today, the middling answers — because nobody is bien every day."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know first",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Recall bien — \"well.\" Root? (Latin bene, \"well\" — same as benefit, benevolent.) So estoy bien = \"I'm well.\" Now the answer for when you're not quite bien."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart — two answers",
          "segments": [
            {
              "kind": "speech",
              "text": "regular — as an answer to \"how are you?\", it means \"so-so, average, not great.\" (A famous false-friend trap: it does not mean English \"regular / normal / usual\" here.) From Latin rēgula, a straight rod a builder used to check a line — the ruler. So regular is \"on the rule, on the average line\" becomes middling."
            },
            {
              "kind": "speech",
              "text": "That rēgula rod is everywhere in English: rule, ruler, regulate, regular, regiment, and even rail (a straight rod). All the same straight stick."
            },
            {
              "kind": "speech",
              "text": "más o menos — \"more or less,\" the shrug-answer:"
            },
            {
              "kind": "speech",
              "text": "más = \"more,\" from Latin magis (\"more\") — cousin of major, master, maximum."
            },
            {
              "kind": "speech",
              "text": "menos = \"less,\" from Latin minus — the very word English borrowed for minus, minor, minimum, minuscule."
            },
            {
              "kind": "speech",
              "text": "So más o menos is literally \"more or less\" — the exact phrase, root for root, that English uses for the same shrug."
            }
          ]
        },
        {
          "index": 3,
          "type": "grammar",
          "title": "Grammar Lens: a small answer set",
          "segments": [
            {
              "kind": "speech",
              "text": "You now have a scale to answer ¿cómo estás?:"
            },
            {
              "kind": "table",
              "headers": [
                "answer",
                "sense"
              ],
              "columns": 2,
              "rowCount": 3,
              "utterances": [
                "(muy) bien means (very) well.",
                "regular means so-so.",
                "más o menos means more or less / meh."
              ]
            }
          ]
        },
        {
          "index": 4,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "\"regular\" — reh-goo-LAR, soft tap on both r's",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: \"regular\" — *reh-goo-LAR*, soft tap on both *r*'s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "\"más o menos\" — a little shrug in the voice",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: \"más o menos\" — a little shrug in the voice]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "answer \"¿cómo estás?\" three ways — bien / regular / más o menos",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: answer \"¿cómo estás?\" three ways — bien / regular / más o menos]"
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "As an answer, does regular mean \"normal\" or \"so-so\"? (So-so — the false-friend trap.) What straight-rod Latin word is it from, and what English \"rod\" words share it? (rēgula becomes rule, ruler, regulate, rail.) Next: put the whole exchange together."
            }
          ]
        }
      ]
    },
    {
      "id": "ES-C04-y",
      "sequence": 340,
      "title": "y / ¿y tú? — pass the question back",
      "headword": "y / ¿y tú?",
      "romanization": "y / ¿y tú?",
      "gloss": "and / and you? — a tiny connector that hands the conversation back",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:99ed610d3f2f4d2e",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "You can ask how someone is and answer. One tiny connector turns that exchange around so the other person gets a turn too."
            }
          ]
        },
        {
          "index": 1,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Y means and and sounds like Spanish i: ee. It continues Latin et, also “and.” English borrowed that Latin word intact inside et cetera, literally “and the rest.”"
            }
          ]
        },
        {
          "index": 2,
          "type": "grammar",
          "title": "Grammar Lens: the shortest return question",
          "segments": [
            {
              "kind": "speech",
              "text": "Put y before a person you already know:"
            },
            {
              "kind": "speech",
              "text": "¿Y tú? — And you? (informal)."
            },
            {
              "kind": "speech",
              "text": "¿Y usted? — And you? (formal)."
            },
            {
              "kind": "speech",
              "text": "Nothing else needs repeating. The little question hands the previous topic back to the other person."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "“Bien. ¿Y tú?” to a friend",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: “Bien. ¿Y tú?” to a friend]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "“Regular. ¿Y usted?” to a stranger",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: “Regular. ¿Y usted?” to a stranger]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "“y” — one clear ee sound",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: “y” — one clear *ee* sound]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What does y mean? (And.) How do you hand a question back to a friend? (¿Y tú?) To a stranger? (¿Y usted?) Which Latin word survives inside English et cetera? (Et, “and.”)"
            }
          ]
        }
      ]
    },
    {
      "id": "ES-C04-repaso-estar",
      "sequence": 345,
      "title": "Asking how someone is — putting it together",
      "headword": "(practice)",
      "romanization": "(practice)",
      "gloss": "Asking how someone is — putting the chapter together",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:02e945b368e8351f",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Now the question, its answer, and the register choice inside it. Nothing new in this lesson — only what you already have."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "The exchange",
          "segments": [
            {
              "kind": "speech",
              "text": "— ¿Cómo está usted? — Bien, gracias. ¿Y usted? — Regular."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "You can ask how someone is, formally or not, answer honestly, and hand the question back."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
