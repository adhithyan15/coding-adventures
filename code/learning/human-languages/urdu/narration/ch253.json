        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: چھپکلی",
          "segments": [
            {
              "kind": "speech",
              "text": "چھپکلی — chhipkalī — \"a lizard\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "CDIAL lists Hindi chipkalī, \"lizard\", under Sanskrit śepyā, for which it reconstructs a sense \"tail\" (CDIAL 12607). How the word came to name the lizard is not explained."
            }
          ]
        },
        {
