          "stimulusLength": {"unit": "words", "minimum": 220, "maximum": 280, "approximate": false},
          "responseLength": {"unit": "items", "minimum": 1, "maximum": 1, "approximate": false},
          "interaction": "individual", "replayCount": 0,
          "scoring": {"maxRawPoints": 25, "criteria": ["purpose recognition", "explicit-detail recognition", "tone recognition"]},
          "aids": {"allowed": ["marking on the question paper", "one unscored example"], "forbidden": ["romanization", "dictionary", "translator"], "notPublished": []},
          "notPublished": [], "sourceIds": ["ca-hl16-assessment-policy", "ca-hl18-task-shapes", "ca-bengali-assessment"]
