          "type": "input",
          "title": "You'll want to know: el músico",
          "segments": [
            {
              "kind": "speech",
              "text": "el músico — \"the musician\"."
            },
            {
              "kind": "speech",
              "text": "Mi vecino es músico de jazz. My neighbour is a jazz musician."
            },
            {
              "kind": "speech",
              "text": "La música is music and also a woman musician."
            }
          ]
        },
