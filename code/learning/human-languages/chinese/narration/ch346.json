        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: kǎolǜ",
          "segments": [
            {
              "kind": "speech",
              "text": "kǎolǜ — \"to think something over; to consider\"."
            },
            {
              "kind": "speech",
              "text": "wǒ zài kǎolǜ qù bu qù Zhōngguó — I'm thinking over whether to go to China."
            },
            {
              "kind": "speech",
              "text": "Its characters come later; for now it is a word for the ear."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "kǎolǜ is built from kǎo and lǜ, both inherited from Middle Chinese, khawX and ljoH (Guangyun, in Baxter's transcription), which glosses the first 'to check' and 'to complete', and the second 'to think'."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for giving reasons."
