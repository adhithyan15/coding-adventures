        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: l'insomnie",
          "segments": [
            {
              "kind": "speech",
              "text": "l'insomnie — \"insomnia, sleeplessness\"."
            },
            {
              "kind": "speech",
              "text": "Quand je suis stressé, je souffre d'insomnie. When I am stressed, I suffer from insomnia."
            },
            {
              "kind": "speech",
              "text": "Feminine. Often plural: avoir des insomnies."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "l'insomnie is a learned borrowing from Latin insomnia \"sleeplessness\" (EtymDB), built on somnus \"sleep\" (Lewis & Short)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
