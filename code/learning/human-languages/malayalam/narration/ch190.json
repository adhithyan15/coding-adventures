        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: പകർത്തുക",
          "segments": [
            {
              "kind": "speech",
              "text": "പകർത്തുക — pakarttuka — \"to copy\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "പകർത്തുക (pakarttuka) is native Dravidian, from the verb \"to change place, be exchanged\": a copy moves a text to a new page; DEDR 3803 lists the root with Tamil pakar."
            }
          ]
        },
