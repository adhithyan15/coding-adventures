          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "dictātor is built on dictō, \"to say often, to order\" (Lewis & Short), from dīcō, \"to say\". English dictator is the same word."
            }
          ]
        },
