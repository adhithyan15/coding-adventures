              "responseSeconds": 8,
              "source": "[YOU SAY: which of the two borrowings would mislead somebody who trusted English]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
