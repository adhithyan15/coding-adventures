          "segments": [
            {
              "kind": "speech",
              "text": "следователь (slédovatel) — \"an investigator, a detective\"."
            },
            {
              "kind": "speech",
              "text": "Следователь долго говорил со свидетелем. Slédovatel dólgo govoríl so svidételem. The investigator talked with the witness for a long time."
            },
            {
              "kind": "speech",
              "text": "Genitive следователя."
            }
          ]
        },
