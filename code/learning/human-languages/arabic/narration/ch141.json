          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Arabic for a heel, then the Arabic for a lip."
            },
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "speech",
              "text": "Say Sunday, Thursday, Friday and Saturday. (Al-aḥad, al-khamīs, al-jumʿa, as-sabt.)"
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: لسان",
          "segments": [
            {
              "kind": "speech",
              "text": "لسان — lisān — \"a tongue\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "لسان (lisān) is built on the native Arabic root l-s-n, \"the tongue\" (Lane). Hebrew lashon, \"tongue\", is its cousin."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
