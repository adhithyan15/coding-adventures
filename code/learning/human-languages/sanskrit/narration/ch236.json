          "type": "input",
          "title": "You'll want to know: शिशुः",
          "segments": [
            {
              "kind": "speech",
              "text": "शिशुः — śiśuḥ — \"a baby, an infant\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "śiśu is a Rigvedic word for \"the young of an animal, a child\" (CDIAL 12476). MW derives it from √śū, \"to swell\", that is, to grow. It lives on as Hindi sisu, \"infant\"."
            }
          ]
        },
