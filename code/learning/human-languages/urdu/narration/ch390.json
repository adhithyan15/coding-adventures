          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: آمد",
          "segments": [
            {
              "kind": "speech",
              "text": "آمد — āmad — \"an arrival\"."
            },
            {
              "kind": "speech",
              "text": "گاڑی کی آمد شام کو ہے۔ gāṛī kī āmad shām ko hai. The train gets in this evening."
            },
            {
              "kind": "speech",
              "text": "Feminine."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "آمد (āmad) is usually traced to Persian āmad, \"a coming\", from the verb for \"to come\"; station boards list arrivals under it."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
