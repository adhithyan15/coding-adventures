% ============================================================================
% capitalization-rule.query.adj — worked recall over the
% capitalization-rule library.
% ============================================================================
% The shape a learner (or an LLM) produces to ANSWER "what does this
% capitalization rule require?" (direct) or "which rule requires this?"
% (reverse) — it states no fact of its own — it only `import`s the
% grounded table and asks binding queries.
% ============================================================================

import "capitalization-rule.adj"

? capitalization_rule(pronoun_i, $D)                 % expect capitalized_anywhere_in_sentence (direct)
? capitalization_rule($R, capitalize_first_letter)   % expect first_word_of_sentence (reverse)
? capitalization_rule(quotation, $D)                 % expect abstain -- a real capitalization rule the source covers, but not one of the three tabled here
