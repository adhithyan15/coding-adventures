          "segments": [
            {
              "kind": "speech",
              "text": "بالفعل — bi-l-fiʿl — \"already; indeed\". With the past: أكلت بالفعل — akaltu bi-l-fiʿl — \"I have already eaten.\""
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "بالفعل (bi-l-fiʿl) is built from bi-, \"by, in\", the article al-, and fiʿl, \"a deed\", from the root f-ʿ-l, \"to do\" (Lane): \"in deed\", hence \"already, indeed\"."
            }
          ]
        },
