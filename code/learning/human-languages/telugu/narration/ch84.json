              "instruction": "jvaraṁ, once more",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *jvaraṁ*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "say nāku jvaraṁ vaccindi, I have a fever",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: say *nāku jvaraṁ vaccindi*, I have a fever]"
            },
