    {
      "id": "ZH-W166-cha-tea",
      "sequence": 13425,
      "title": "茶 (chá) — grass, a roof, a small tree",
      "headword": "茶",
      "romanization": "chá",
      "gloss": "茶 — the grass piece, 人, then a small tree at the foot",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:307f2948a85bfc88",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — grass, a roof, a small tree",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — grass, a roof, a small tree and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say xiàwǔchá — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *xiàwǔchá* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "菜 人."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — cài, rén",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *cài*, *rén*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — grass, a roof, a small tree",
          "segments": [
            {
              "kind": "speech",
              "text": "茶 (chá)."
            },
            {
              "kind": "speech",
              "text": "Three pieces, top to bottom. Count the pieces, not the strokes."
            },
            {
              "kind": "speech",
              "text": "The grass piece, three strokes, as in 菜: a horizontal, then two short verticals through it."
            },
            {
              "kind": "speech",
              "text": "Then 人, two strokes, spread wide like a roof."
            },
            {
              "kind": "speech",
              "text": "At the foot, four strokes: a horizontal, a vertical with a hook, then a short stroke falling to the left and a dot falling to the right, one on each side."
            },
            {
              "kind": "speech",
              "text": "3 + 2 + 4 = nine."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "茶 (chá), all nine, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 茶, all nine, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many strokes in 茶 (chá)? (Nine.) What sits on top? (The grass piece of 菜.) What comes under it? (人, spread like a roof.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 茶 (chá), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
