    {
      "id": "ZH-W40-mai",
      "sequence": 3465,
      "title": "买 (mǎi) — a lid, two dots, and a cut-down 大",
      "headword": "买",
      "romanization": "mǎi",
      "gloss": "买 — a lid, two dots, and 大 cut short",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:efcfecc6ac8f40a2",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — a lid, two dots, and a cut-down 大",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — a lid, two dots, and a cut-down 大 and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say mǎi — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *mǎi* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "大 水."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — dà, shuǐ",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *dà*, *shuǐ*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — a lid, two dots, and a cut-down 大",
          "segments": [
            {
              "kind": "speech",
              "text": "买 (mǎi)."
            },
            {
              "kind": "speech",
              "text": "Two pieces, top before bottom."
            },
            {
              "kind": "speech",
              "text": "The top piece, three strokes. A horizontal that hooks down at its right end, like a lid. Then two dots under it, one above the other."
            },
            {
              "kind": "speech",
              "text": "The bottom piece, three strokes. A long horizontal, a left-falling stroke through it, and a dot on the right. It is 大 with its last stroke cut down to a dot."
            },
            {
              "kind": "speech",
              "text": "3 + 3 = six."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "买 (mǎi), all six, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 买, all six, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many pieces in 买 (mǎi)? (Two — the lid with its dots, then the cut-down 大.) What is under the lid? (Two dots.) What is the last stroke? (A dot, where 大 has a long fall.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 买 (mǎi), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
