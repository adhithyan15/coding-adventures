      "headword": "आप चाय पीवो हो?",
      "romanization": "āp chāy pīvo ho?",
      "gloss": "a yes-or-no question: the statement, said rising",
      "script": "devanagari",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:0f1ed4c83575db73",
      "notice": null,
      "blocks": [
