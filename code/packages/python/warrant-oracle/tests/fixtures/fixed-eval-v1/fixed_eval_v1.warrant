  -- claims: one reference claim per model -----------------------------------------------------
  claim c_bin_u8:
    forall a: U8, b: U8. op_bin_u8(a, b) == bin_u8(a, b)
  claim c_div_u8:
    forall a: U8, b: U8. op_div_u8(a, b) == div_u8(a, b)
  claim c_un_u8:
    forall a: U8. op_un_u8(a) == un_u8(a)
  claim c_sh_u8:
    forall a: U8, n: Nat. op_sh_u8(a, n) == (shl(a, n), shr(a, n), rotl(a, n), rotr(a, n), bit(a, n))
  claim c_wrap_u8:
    forall a: U8. op_wrap_u8(a) == wrap_u8(a)
  claim c_try_u8:
    forall a: U8. op_try_u8(a) == try_u8(a)
  claim c_widen_u8:
    forall a: U8. op_widen_u8(a) == widen_u8(a)
  claim c_rt_u8:
    forall a: U8. op_rt_u8(a) == rt_u8(a)
  claim c_fb_u8:
    forall b: Bytes<1>. op_fb_u8(b) == fb_u8(b)
  claim c_bin_u16:
    forall a: U16, b: U16. op_bin_u16(a, b) == bin_u16(a, b)
  claim c_div_u16:
    forall a: U16, b: U16. op_div_u16(a, b) == div_u16(a, b)
  claim c_un_u16:
    forall a: U16. op_un_u16(a) == un_u16(a)
  claim c_sh_u16:
    forall a: U16, n: Nat. op_sh_u16(a, n) == (shl(a, n), shr(a, n), rotl(a, n), rotr(a, n), bit(a, n))
  claim c_wrap_u16:
    forall a: U16. op_wrap_u16(a) == wrap_u16(a)
  claim c_try_u16:
    forall a: U16. op_try_u16(a) == try_u16(a)
  claim c_widen_u16:
    forall a: U16. op_widen_u16(a) == widen_u16(a)
  claim c_rt_u16:
    forall a: U16. op_rt_u16(a) == rt_u16(a)
  claim c_fb_u16:
    forall b: Bytes<2>. op_fb_u16(b) == fb_u16(b)
  claim c_bin_u32:
    forall a: U32, b: U32. op_bin_u32(a, b) == bin_u32(a, b)
  claim c_div_u32:
    forall a: U32, b: U32. op_div_u32(a, b) == div_u32(a, b)
  claim c_un_u32:
    forall a: U32. op_un_u32(a) == un_u32(a)
  claim c_sh_u32:
    forall a: U32, n: Nat. op_sh_u32(a, n) == (shl(a, n), shr(a, n), rotl(a, n), rotr(a, n), bit(a, n))
  claim c_wrap_u32:
