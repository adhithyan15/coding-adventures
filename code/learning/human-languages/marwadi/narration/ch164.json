              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *tā̃ī*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "आथण ५ सूं ८ तांई — āthaṇ pāṅch sū̃ āṭh tā̃ī — in the evening, from five until eight",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: **आथण ५ सूं ८ तांई** — *āthaṇ pāṅch sū̃ āṭh tā̃ī* — in the evening, from five until eight]"
