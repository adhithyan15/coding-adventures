            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Persian for a sheep, then the Persian for a bird."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: موش",
          "segments": [
            {
              "kind": "speech",
              "text": "موش — mush — \"a mouse\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "mush is a native Persian word, inherited rather than borrowed; it is usually traced to Middle Persian mūš, \"mouse\". English mouse and Latin mūs are the same Indo-European word."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
