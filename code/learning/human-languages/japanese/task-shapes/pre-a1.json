  "administration": {
    "writtenMinutes": 20,
    "speakingMinutes": 5,
    "speakingGroupMaximum": 1,
    "speakingPreparationMinutes": 1,
    "deliveryModes": ["paper", "recorded-audio", "live-interlocutor"]
