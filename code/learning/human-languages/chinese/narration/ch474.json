    {
      "id": "ZH-W474-li-strength",
      "sequence": 35835,
      "title": "力 (lì) — a turn with a hook, then a falling stroke",
      "headword": "力",
      "romanization": "lì",
      "gloss": "力 — a turn with a hook, then a long falling stroke",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:54b7e76df110bcd4",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — a turn with a hook, then a falling stroke",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — a turn with a hook, then a falling stroke and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say lìqi — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *lìqi* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "男 气."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — nán, qì",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *nán*, *qì*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — a turn with a hook, then a falling stroke",
          "segments": [
            {
              "kind": "speech",
              "text": "力 (lì)."
            },
            {
              "kind": "speech",
              "text": "One piece of two strokes."
            },
            {
              "kind": "speech",
              "text": "The first stroke. It runs right, turns down, and at the foot hooks back to the left."
            },
            {
              "kind": "speech",
              "text": "The second stroke. A long stroke falling to the left, from above the first stroke, down through it to the bottom left."
            },
            {
              "kind": "speech",
              "text": "1 + 1 = two."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "力 (lì), all two, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 力, all two, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many strokes does 力 (lì) have? (Two.) Where have you written it before? (At the foot of 男.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 力 (lì), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
