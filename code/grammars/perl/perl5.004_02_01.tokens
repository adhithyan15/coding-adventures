# Perl 5.004_02_01 (1997-08-12) tokens: plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: this does not lex all Perl 5.004_02_01 source.
# Evidence: https://mirrors.develooper.com/perl/historical-perl/perl-5.004_02_01.tar.gz
# Historical perly.y and toke.c match 5.004_02; retain the 250-digit decimal bound.
# Unsupported characters, carriage returns and
# leading-zero forms remain refused.

PRINT     = "print"
INT       = /0|[1-9][0-9]{0,249}/
PLUS      = "+"
DECREMENT = "--"
MINUS     = "-"
STAR      = "*"
LPAREN    = "("
RPAREN    = ")"
SEMICOLON = ";"

skip:
  WHITESPACE = /[ \t\n]+/
