              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "\"You\" — respect made the same way as Tamil, Kannada, and French."
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "The letters in this word",
          "segments": [
            {
              "kind": "speech",
              "text": "(Skim if you read Telugu.) నువ్వు (nuvvu); మీరు (mīru) = మీ (mī)."
            },
            {
              "kind": "speech",
              "text": "రు (ru)."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "నువ్వు (nuvvu, familiar \"you\") traces to Proto-Dravidian nīn — the same native root as Tamil nī and Kannada nīnu. మీరు (mīru) is the respectful/plural \"you.\""
            }
          ]
        },
        {
          "index": 3,
          "type": "grammar",
          "title": "Grammar Lens: respect by the plural",
          "segments": [
            {
              "kind": "speech",
              "text": "nuvvu (familiar) vs. mīru (respectful, and literally plural) — the same politeness-by-plural as Tamil nīṅgaḷ, Kannada nīvu, and French vous. For a first meeting, mīru."
            }
          ]
        },
        {
          "index": 4,
          "type": "pronunciation",
          "title": "Sounds you'll need",
          "segments": [
            {
              "kind": "speech",
              "text": "నువ్వు (nuvvu); మీరు (m=i ru, మీ m=i + రు ru)."
            }
          ]
        },
        {
          "index": 5,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "\"nuvvu\" (familiar), \"mīru\" (respectful)",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: \"nuvvu\" (familiar), \"mīru\" (respectful)]"
            }
          ]
        },
        {
          "index": 6,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
