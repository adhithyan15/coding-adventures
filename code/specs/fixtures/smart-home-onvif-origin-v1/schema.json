{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coding-adventures.dev/specs/fixtures/smart-home-onvif-origin-v1/schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract", "cases"],
  "properties": {
    "schema_version": { "const": 1 },
    "contract": { "const": "smart-home-onvif-origin-v1" },
    "cases": {
      "type": "array",
      "minItems": 12,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "operation", "input", "expected"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
        "operation": {
          "enum": [
            "discovery",
            "soap_origin",
            "derived_origin",
            "http_status",
            "size_policy"
          ]
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "probe_message_id": { "type": "string", "maxLength": 256 },
            "relates_to": { "type": "string", "maxLength": 256 },
            "sender_ip": { "type": "string", "maxLength": 64 },
            "url": { "type": "string", "maxLength": 2048 },
            "approved_url": { "type": "string", "maxLength": 2048 },
            "resolved_addresses": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": { "type": "string", "maxLength": 64 }
            },
            "allow_loopback_http": { "type": "boolean" },
            "status": { "type": "integer", "minimum": 100, "maximum": 599 }
            ,
            "field": { "enum": ["url", "credential", "request"] },
            "observed_bytes": { "type": "integer", "minimum": 0, "maximum": 1000000 }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["accepted", "code"],
          "properties": {
            "accepted": { "type": "boolean" },
            "code": {
              "enum": [
                "ok",
                "relates_to_mismatch",
                "source_mismatch",
                "insecure_transport",
                "userinfo_forbidden",
                "fragment_forbidden",
                "unreviewed_origin",
                "unsafe_address",
                "dns_rebinding",
                "redirect_forbidden",
                "size_limit"
              ]
            },
            "confidence": { "enum": ["candidate"] },
            "pinned_address": { "type": "string", "maxLength": 64 }
          }
        }
      }
    }
  }
}
