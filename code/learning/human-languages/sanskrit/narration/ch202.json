              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: a deer, a leopard, a rhinoceros, a nest, an egg]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "a sentence, a language, grammar, mathematics, science",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: a sentence, a language, grammar, mathematics, science]"
            }
          ]
        },
        {
