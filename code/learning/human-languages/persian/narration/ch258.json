        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: جستجو کردن",
          "segments": [
            {
              "kind": "speech",
              "text": "جستجو کردن — jostoju kardan — \"to search\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "jostoju kardan pairs jostoju, \"search\", with kardan. jostoju is jost, \"sought\", with o, \"and\", and ju, \"seeking\", both from jostan, \"to seek\". All are native Persian. kardan, \"to do\", is an inherited verb, from Middle Persian kardan (EtymDB)."
            }
          ]
        },
        {
