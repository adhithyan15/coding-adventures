        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: fuga, fugae",
          "segments": [
            {
              "kind": "speech",
              "text": "fuga, fugae — \"flight, running away\"."
            },
            {
              "kind": "speech",
              "text": "Hostēs sē in fugam dedērunt. The enemy took to flight."
            },
            {
              "kind": "speech",
              "text": "Feminine, from fugiō (taught). In fugam dare: to put to flight."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "fuga belongs with fugiō, \"to flee\" (Lewis & Short), and matches Greek phygē, \"flight\". English fugitive comes from the same family."
            }
          ]
        },
        {
