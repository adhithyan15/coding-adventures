    {
      "id": "ZH-W450-te-special",
      "sequence": 34045,
      "title": "特 (tè) — the cow piece, then two pieces stacked",
      "headword": "特",
      "romanization": "tè",
      "gloss": "特 — the cow piece, then the earth piece over the right piece of 对",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:a78474a98e126c0a",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — the cow piece, then two pieces stacked",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — the cow piece, then two pieces stacked and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say tèdiǎn — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *tèdiǎn* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "对 地."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — duì, dì",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *duì*, *dì*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — the cow piece, then two pieces stacked",
          "segments": [
            {
              "kind": "speech",
              "text": "特 (tè)."
            },
            {
              "kind": "speech",
              "text": "Two pieces, left before right. Count the pieces, not the strokes."
            },
            {
              "kind": "speech",
              "text": "The left piece, the cow piece, four strokes. A short stroke falling to the left. A bar. A long vertical down through the bar. Then a stroke that rises to the right."
            },
            {
              "kind": "speech",
              "text": "The right piece, six strokes, in two parts. On top, the earth piece of 地 with its last bar long: a short bar, a vertical, and a long bar under them. Under it, the right piece of 对: a bar, a vertical with a hook, and a dot."
            },
            {
              "kind": "speech",
              "text": "4 + 6 = ten."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "特 (tè), all ten, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 特, all ten, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many strokes in 特 (tè)? (Ten.) What is the last stroke of the left piece? (A stroke that rises to the right.) What sits at the foot of the right piece? (The right piece of 对.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 特 (tè), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
