        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: die Hypothese",
          "segments": [
            {
              "kind": "speech",
              "text": "die Hypothese — \"the hypothesis\"."
            },
            {
              "kind": "speech",
              "text": "Die Forscherin will ihre Hypothese mit einem Experiment prüfen. The researcher wants to test her hypothesis with an experiment."
            },
            {
              "kind": "speech",
              "text": "Plural: die Hypothesen. The stress is on the third syllable: hy-po-THE-se."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Hypothese is a learned borrowing from Late Latin hypothesis, from Greek hypóthesis \"a base, the basis of an argument\" (EtymDB), built from hypó \"under\" and thésis \"a setting down\": what you put underneath."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
            }
          ]
        },
