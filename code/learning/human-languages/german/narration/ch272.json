            },
            {
              "kind": "speech",
              "text": "Before the new one: say the German for the headline, then the German for the article."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: die Sendung",
          "segments": [
            {
              "kind": "speech",
              "text": "die Sendung — \"the broadcast, the programme; the consignment\"."
            },
            {
              "kind": "speech",
              "text": "Die Sendung beginnt um acht Uhr. The programme begins at eight."
            },
            {
              "kind": "speech",
              "text": "Plural: die Sendungen. At the post office, a Sendung is a parcel or letter on its way."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Sendung is built on senden \"to send\", a cousin of English send from Proto-Germanic sandijaną \"to cause to go\" (EtymDB)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
            }
          ]
        },
