        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: empêcher",
          "segments": [
            {
              "kind": "speech",
              "text": "empêcher — \"to prevent, to stop (from)\"."
            },
            {
              "kind": "speech",
              "text": "Le bruit m'empêche de dormir. The noise stops me from sleeping."
            },
            {
              "kind": "speech",
              "text": "Empêcher quelqu'un de faire quelque chose. Il n'empêche que — all the same."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "empêcher is inherited through Old French empeechier from Late Latin impedicāre \"to fetter, to hinder\" (EtymDB), built on pedica \"a fetter for the foot\" (Lewis & Short)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
