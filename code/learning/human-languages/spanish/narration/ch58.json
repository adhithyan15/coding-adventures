            {
              "kind": "activity",
              "scored": true,
              "id": "ES-C09-sintesis-describir-both",
              "prompt": "Say: the house is big, but I am tired.",
              "assesses": [
                "ES-GRAMMAR-STATE-LOCATION-ESTAR",
                "ES-LEX-GRANDE"
              ],
              "responseSeconds": 18,
              "acceptedResponses": [
                "la casa es grande pero estoy cansado",
                "la casa es grande pero estoy cansada"
              ],
              "feedback": {
                "correct": "Ser for the house, estar for you.",
                "incorrect": "La casa es grande, pero estoy cansado."
              }
            },
            {
              "kind": "activity",
              "scored": true,
              "id": "ES-C09-sintesis-describir-shift",
              "prompt": "A woman says she is tired. Which word changes?",
              "assesses": [
                "ES-MORPH-BUENO-BUENA"
              ],
              "responseSeconds": 12,
              "acceptedResponses": [
                "cansada",
                "cansado becomes cansada"
              ],
              "feedback": {
                "correct": "The -o did the work.",
                "incorrect": "Cansada — because it ends in -o."
              }
            },
            {
              "kind": "activity",
              "scored": true,
              "id": "ES-C09-sintesis-describir-order",
              "prompt": "Put the words in Spanish order: grande / casa / una.",
              "assesses": [
                "ES-GRAMMAR-ADJECTIVE-AFTER-NOUN"
              ],
              "responseSeconds": 12,
              "acceptedResponses": [
                "una casa grande",
