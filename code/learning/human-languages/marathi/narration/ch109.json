            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Marathi for pink, then the Marathi for young."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: म्हातारा",
          "segments": [
            {
              "kind": "speech",
              "text": "म्हातारा — mhātārā — \"old (people)\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "म्हातारा (mhātārā) is a tadbhava of Sanskrit mahattara, \"greater\", which also meant \"chief, village eldest\" (CDIAL 9932). CDIAL lists Marathi mahātārā, \"old\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
