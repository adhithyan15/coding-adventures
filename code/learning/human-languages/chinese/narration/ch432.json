        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: 少",
          "segments": [
            {
              "kind": "speech",
              "text": "少 — shǎo — \"few; not much\"."
            },
            {
              "kind": "speech",
              "text": "今年这家酒店的客人很少 jīnnián zhè jiā jiǔdiàn de kèrén hěn shǎo — This hotel has had very few guests this year."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "少 (shǎo) is inherited from Middle Chinese syewX (Guangyun, in Baxter's transcription), glossed 'not many'. The dictionary lists a second reading, syewH, glossed 'young': the shào of 少年."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for getting around."
