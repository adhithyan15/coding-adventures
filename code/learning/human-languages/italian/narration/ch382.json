        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ripassare",
          "segments": [
            {
              "kind": "speech",
              "text": "ripassare — \"to revise, to go over (again)\"."
            },
            {
              "kind": "speech",
              "text": "Stasera ripassiamo la storia per l'esame. Tonight we are going over history for the exam."
            },
            {
              "kind": "speech",
              "text": "It also means to come by again: ripassa domani."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ripassare is built from ri- \"again\" and passare \"to pass\", a verb inherited from Vulgar Latin passāre, built on Latin passus \"a step\" (Lewis & Short)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
