              "kind": "speech",
              "text": "Feminine."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "फ़िक्र (fikr) is usually traced to Arabic fikr, \"thought, reflection\", which reached Hindi through Persian; in Hindi the thought became a worry."
            }
          ]
        },
