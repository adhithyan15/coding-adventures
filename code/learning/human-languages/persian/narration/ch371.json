          "segments": [
            {
              "kind": "speech",
              "text": "از این رو (az in ru) — \"hence, for this reason\"."
            },
            {
              "kind": "speech",
              "text": "قیمتها بالا رفت، از این رو مردم کمتر خرید کردند. qeymathâ bâlâ raft, az in ru mardom kamtar kharid kardand. Prices went up; hence people bought less."
            },
            {
              "kind": "speech",
              "text": "Formal, mostly written. Az \"from\" + in \"this\" + ru \"face, side\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "از این رو (az in ru) is native Persian, literally \"from this face\": az \"from\" (EtymDB traces it to Old Persian), in \"this\" and ru \"face, side\"."
            }
          ]
        },
