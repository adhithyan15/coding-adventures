            {
              "kind": "speech",
              "text": "Before the new one: say the Arabic for near, then the Arabic for inside."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: خارج",
          "segments": [
            {
              "kind": "speech",
              "text": "خارج — khārij — \"outside\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "خارج (khārij) is built on the native Arabic root kh-r-j, \"to go out\" (Lane). Khārij is the active participle, \"going out\", hence \"outside\"."
            }
          ]
        },
        {
