          "segments": [
            {
              "kind": "speech",
              "text": "seitdem — \"since then; since (joining two clauses)\"."
            },
            {
              "kind": "speech",
              "text": "Seitdem sie ein Auto hat, fährt sie nicht mehr mit dem Bus. Since she has had a car, she no longer goes by bus."
            },
            {
              "kind": "speech",
              "text": "Two uses: an adverb, with the verb second (Seitdem ist er glücklich), and a conjunction, with the verb at the end. The present covers something still true."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "seitdem joins seit \"since\" and dem \"that\". Seit comes from Middle High German sīt (EtymDB), usually traced to Old High German sīd \"later, since\", a cousin of English since."
            }
          ]
        },
