-- PARKED DRAFT: this document is NOT valid Warrant today.
--
-- It uses F64, which Warrant does not implement yet (checker error W0202,
-- UnboundType("F64")).  It also had a syntax error (a `labels default_config:`
-- block whose body was a bare `none`; default_config() takes no inputs, so the
-- block should simply be deleted).  It is parked as a .draft so the repo-wide
-- test in warrant-grammar (tests/v0_compat.rs, which globs *.warrant only)
-- skips it.  Parked until VER04p floats (backlog WX-FL1) land.  When they do,
-- rename it back to game-pong.warrant, delete that labels block, and make it parse and
-- pass check_warrant.
--
-- GAME13 -- Game Pong: Deterministic 2-Player Arcade State Machine & PaintVM Renderer
--
-- Warrant document for game-pong (VER04j and VER04m: state=explicit).
-- Formal verification contract for pure deterministic Pong simulation.

warrant game_pong v1
  error PongError = InvalidConfig | NonFiniteState | StateOutOfBounds | NegativeDimension | CollisionError | ClockError | PaintError | AudioError

  model Unit = Bool
  variant PaddleSide = Left | Right
  variant PaddleAction = Hold | Up | Down
  variant PaddleControl = Manual(action: PaddleAction) | Ai

  record PongConfig(court_width: F64, court_height: F64, paddle_width: F64, paddle_height: F64, paddle_speed: F64, paddle_inset: F64, ball_radius: F64, ball_initial_speed: F64, ball_max_speed: F64, ball_speed_increment: F64, max_deflection_angle_rad: F64, winning_score: U32, serve_countdown_ticks: U32, fixed_dt_seconds: F64)

  record PongPoint(x: F64, y: F64)

  record PongState(config: PongConfig, left_paddle_y: F64, right_paddle_y: F64, ball_pos: PongPoint, ball_vel: PongPoint, left_score: U32, right_score: U32, rally_counter: U32, serve_countdown: U32, serve_towards_right: Bool, prng_seed: U64, game_over: Bool)

  record PongInput(left: PaddleControl, right: PaddleControl)

  record ScoreEvent(scorer: PaddleSide, left_score: U32, right_score: U32)
  record PongFrameEvents(paddle_hit: Option<PaddleSide>, wall_bounce: Bool, score_event: Option<ScoreEvent>, game_over: Bool, rally_count: U32)

  op default_config() -> PongConfig
  op validate_config(config: PongConfig) -> Result<Unit, PongError>
  op new_game(config: PongConfig, seed: U64) -> Result<PongState, PongError>
  op validate_state(state: PongState) -> Result<Unit, PongError>
  op prng_next(state: U64) -> U64

  assume platform:
    contract.trig.pure_software
  assume environment:
    none

  labels default_config:
    none
  labels validate_config:
    config public
  labels new_game:
    config public
    seed public
  labels validate_state:
    state public
  labels prng_next:
    state public

  input validate_config.config:
    hostile
    ensures no_panic, terminates

  input new_game.config:
    hostile
    ensures no_panic, terminates
  input new_game.seed:
    hostile
    ensures no_panic, terminates

  input validate_state.state:
    hostile
    ensures no_panic, terminates

  input prng_next.state:
    hostile
    ensures no_panic, terminates

  bound default_config:
    steps <= 32
    heap <= 0

  bound validate_config:
    steps <= 64
    heap <= 0

  bound new_game:
    steps <= 64
    heap <= 0

  bound validate_state:
    steps <= 64
    heap <= 0

  bound prng_next:
    steps <= 16
    heap <= 0

  claim default_config_valid:
    validate_config(default_config()) == Ok(true)

  claim new_game_from_default_valid:
    forall s: U64. match new_game(default_config(), s) with Ok(st) -> validate_state(st) == Ok(true) | Err(_) -> false
