        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: o berço",
          "segments": [
            {
              "kind": "speech",
              "text": "o berço — \"the cot, the cradle\"."
            },
            {
              "kind": "speech",
              "text": "Pedimos um berço para o bebé. We asked for a cot for the baby."
            },
            {
              "kind": "speech",
              "text": "Nascer em berço de ouro — to be born with a silver spoon in your mouth."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "berço comes from Vulgar Latin berciolum 'cradle' (EtymDB), probably from a Gaulish word; the details are not settled."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
