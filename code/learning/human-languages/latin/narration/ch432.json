          "segments": [
            {
              "kind": "speech",
              "text": "dēsiliō, dēsilīre — \"to jump down, to leap down\"."
            },
            {
              "kind": "speech",
              "text": "Ad portam eques ex equō dēsilit. At the gate the rider jumps down from his horse."
            },
            {
              "kind": "speech",
              "text": "dēsiliō, dēsilīre, dēsiluī, dēsultum, with ex or dē. English desultory comes from dēsultor, a circus rider who leapt from horse to horse."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "dēsiliō is built from dē- 'down' and saliō 'to leap, to jump' (EtymDB; Lewis & Short). English desultory comes from dēsultōrius, built on its participle."
            }
          ]
        },
