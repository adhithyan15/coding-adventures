        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: बदहज़मी",
          "segments": [
            {
              "kind": "speech",
              "text": "बदहज़मी — badhazmī — \"indigestion\"."
            },
            {
              "kind": "speech",
              "text": "ज़्यादा मिठाई खाकर अरुण को बदहज़मी हो गई। zyādā miṭhāī khākar Aruṇ ko badhazmī ho gaī. Arun got indigestion from eating too many sweets."
            },
            {
              "kind": "speech",
              "text": "Feminine."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "बदहज़मी (badhazmī) is usually traced to Persian bad-hazmī, \"indigestion\", which joins Persian bad, \"bad\", to Arabic haḍm, \"digestion\", said hazm in Persian."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for describing what you lived and felt."
            }
          ]
        },
