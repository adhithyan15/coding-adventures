    {
      "id": "ZH-W371-sui-though",
      "sequence": 28305,
      "title": "虽 (suī) — a mouth over an insect",
      "headword": "虽",
      "romanization": "suī",
      "gloss": "虽 — 口 over an insect piece",
      "script": "chinese",
      "modality": "pen",
