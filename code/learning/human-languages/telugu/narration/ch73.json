            },
            {
              "kind": "speech",
              "text": "Before the new one: what did bēraṁ mean?"
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: తీపి",
          "segments": [
            {
              "kind": "speech",
              "text": "తీపి (tīpi) — \"sweet, sweetness\"."
            },
            {
              "kind": "speech",
              "text": "తీపి (tīpi) is sweetness — the taste, and the quality of anything that has it."
            },
            {
              "kind": "speech",
              "text": "It is inherited. చక్కెర gives it in a kitchen and a పండు gives it on a చెట్టు, and a person described as తీపి (tīpi) is being called good company."
            },
            {
              "kind": "speech",
              "text": "Telugu counts its tastes rather than gesturing at them, and తీపి (tīpi) is the one every count opens with."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One. The taste every count opens with."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "tīpi",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *tīpi*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "it once more, slowly",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: it once more, slowly]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "tīpi, then cakkera, and say which one is the taste",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *tīpi*, then *cakkera*, and say which one is the taste]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What does తీపి (tīpi) mean? (\"sweet, sweetness\".) Say it once more."
            }
          ]
        }
      ]
    },
