          "segments": [
            {
              "kind": "speech",
              "text": "zǐsè — \"purple\"."
            },
            {
              "kind": "speech",
              "text": "wǒ xǐhuan zǐsè — I like purple."
            },
            {
              "kind": "speech",
              "text": "Its characters come later; for now it is a word for the ear."
            }
          ]
        },
