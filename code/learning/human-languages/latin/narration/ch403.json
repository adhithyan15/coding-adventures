          "type": "input",
          "title": "You'll want to know: doctus, docta, doctum",
          "segments": [
            {
              "kind": "speech",
              "text": "doctus, docta, doctum — \"learned, skilled\"."
            },
            {
              "kind": "speech",
              "text": "Vir doctus et prūdēns est. He is a learned and wise man."
            },
            {
              "kind": "speech",
              "text": "doctus, docta, doctum, the participle of doceō: taught."
            }
          ]
        },
