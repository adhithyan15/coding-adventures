            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "ñān niṅṅaḷōṭŭ viyōjikkunnu. — I disagree with you.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *ñān niṅṅaḷōṭŭ viyōjikkunnu.* — I disagree with you.]"
