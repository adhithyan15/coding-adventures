        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know first — one word",
          "segments": [
            {
              "kind": "speech",
              "text": "دو — do — two."
            },
            {
              "kind": "speech",
              "text": "Two letters. The second is و, the hard-working letter from the script chapter that can be v, u or o; here it is o, and the word tells you so."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart — the same word as English two",
          "segments": [
            {
              "kind": "speech",
              "text": "دو continues Middle Persian dō, from Proto-Iranian duwā, from Indo-European dwoh, \"two.\" English two, Latin duo, Greek dýo and Sanskrit dvá are the same word."
            },
            {
              "kind": "speech",
              "text": "Say do and two one after the other. Nothing has to be learned there; it has to be recognised."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
