          "segments": [
            {
              "kind": "speech",
              "text": "брак (brak) — \"marriage; a defect\"."
            },
            {
              "kind": "speech",
              "text": "Их брак длится уже тридцать лет. Ikh brak dlítsya uzhé trídtsat let. Their marriage has lasted thirty years."
            },
            {
              "kind": "speech",
              "text": "Masculine. A second word брак (brak) means faulty goods: бракованный — defective."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "брак (brak) 'marriage' was borrowed from Church Slavonic brakъ, the shape with -ра- beside Proto-Slavic borkъ (EtymDB)."
            }
          ]
        },
