          "segments": [
            {
              "kind": "speech",
              "text": "कैवणो — kaivṇo — \"to say\"."
            },
            {
              "kind": "speech",
              "text": "वो साची बात कैवै है। vo sāchī bāt kaivai hai. He tells the truth."
            },
            {
              "kind": "speech",
              "text": "Past (I …): म्हैं एक सबद कोनी कैयो, mhaĩ ek sabad konī kaiyo."
            }
          ]
        },
        {
