      "id": "AR-C331-shayyada",
      "sequence": 18940,
      "title": "شيد (shayyada) — to erect, to build up",
      "headword": "شيد",
      "romanization": "shayyada",
      "gloss": "to erect, to build up",
      "script": "arabic",
      "modality": "voice",
      "derivedModality": "voice",
