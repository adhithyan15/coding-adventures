        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: der Geldautomat",
          "segments": [
            {
              "kind": "speech",
              "text": "der Geldautomat — \"the cash machine, the ATM\"."
            },
            {
              "kind": "speech",
              "text": "Der Geldautomat ist direkt neben dem Supermarkt. The cash machine is right next to the supermarket."
            },
            {
              "kind": "speech",
              "text": "Plural: die Geldautomaten. In Austria: der Bankomat."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Geldautomat is built from Geld 'money' and Automat 'machine' (EtymDB), which goes back to Greek autómatos 'acting by itself'."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
