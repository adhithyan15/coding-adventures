              "kind": "speech",
              "text": "bromista — \"joker; fond of jokes\"."
            },
            {
              "kind": "speech",
              "text": "Mi tío es muy bromista. My uncle loves a joke."
            },
            {
              "kind": "speech",
              "text": "Same form for men and women: es una bromista."
            }
          ]
        },
