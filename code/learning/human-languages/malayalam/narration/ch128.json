              "action": "SAY",
              "instruction": "vīṭŭ, once more",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *vīṭŭ*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "say enṟe vīṭŭ",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: say *enṟe vīṭŭ*]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say the Malayalam for a holiday, then the Malayalam for I'll call, then say vīṭŭ again",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say the Malayalam for a holiday, then the Malayalam for I'll call, then say *vīṭŭ* again]"
            }
          ]
        },
        {
          "index": 5,
