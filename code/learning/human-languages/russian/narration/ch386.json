          "segments": [
            {
              "kind": "speech",
              "text": "реферат (referát) — \"an essay, a summary paper\"."
            },
            {
              "kind": "speech",
              "text": "Студенты пишут реферат по литературе. Studénty píshut referát po literatúre. The students are writing an essay on literature."
            },
            {
              "kind": "speech",
              "text": "Masculine. A short paper that sums up what sources say."
            }
          ]
        },
