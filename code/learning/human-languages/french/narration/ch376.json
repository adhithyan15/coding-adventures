          "segments": [
            {
              "kind": "speech",
              "text": "inscrire — \"to enrol, to register (mostly reflexive, s'inscrire); to write down\"."
            },
            {
              "kind": "speech",
              "text": "Je me suis inscrit à un cours d'anglais. I enrolled in an English course."
            },
            {
              "kind": "speech",
              "text": "S'inscrire à — to sign up for. Conjugated like écrire: je m'inscris."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "inscrire is a learned borrowing from Latin īnscrībere \"to write on, to inscribe\" (EtymDB; Lewis & Short), reshaped on écrire; it is built on scrībere \"to write\"."
            }
          ]
        },
