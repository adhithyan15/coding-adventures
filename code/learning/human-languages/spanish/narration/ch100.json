      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "You know present tengo, tienes, tiene. Its completed past changes the stem to tuv- and uses tuve, tuviste, tuvo. Unlike comí and comió, none of these three forms carries a written accent."
            }
          ]
        },
        {
          "index": 1,
          "type": "grammar",
          "title": "Grammar Lens: one strong singular pattern",
          "segments": [
            {
              "kind": "table",
              "headers": [
                "person",
                "present",
                "completed past"
              ],
              "columns": 3,
              "rowCount": 3,
              "utterances": [
                "person: yo. present: tengo. completed past: tuve.",
                "person: tú. present: tienes. completed past: tuviste.",
                "person: él / ella / usted. present: tiene. completed past: tuvo."
              ]
            },
            {
              "kind": "speech",
              "text": "The strong stem tuv- takes -e, -iste, -o. Say tuve, tuviste, tuvo. Stress remains in the stem, so normal spelling needs no accent mark. Reuse known café:"
            },
            {
              "kind": "speech",
              "text": "Tuve café. — “I had coffee.”"
            },
            {
              "kind": "speech",
              "text": "¿Tuviste café? — “Did you have coffee?”"
            },
            {
              "kind": "speech",
              "text": "Tuvo café. — “He, she, or you-formal had coffee.”"
            },
            {
              "kind": "speech",
              "text": "“Strong” describes the stem-stressed historical pattern. It does not mean that the meaning is forceful. Plural endings wait."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The stem, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Tener continues Latin tenēre. Its past also belongs to an older strong history associated with Latin tenuī. Spanish sound change and analogy reshaped that material into the tuv- family. Tenuī becomes tuve is therefore a historical relationship, not a promise that every letter passed across intact."
            }
          ]
        },
