              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *sālai*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "pātai, then sālai — and say which one you drive down",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *pātai*, then *sālai* — and say which one you drive down]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "read வண்டி (vaṇḍi), then say rayil, then say sālai",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: read **வண்டி**, then say *rayil*, then say *sālai*]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What is the difference between a பாதை and a சாலை (sālai)? (One is walked; one is driven.)"
            }
          ]
        }
      ]
    },
    {
      "id": "TA-C69-station",
      "sequence": 2780,
      "title": "நிலையம் (nilaiyam) — a station",
      "headword": "நிலையம்",
      "romanization": "nilaiyam",
      "gloss": "a station",
      "script": "tamil",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
