<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>CodingAdventures.DocumentAstToHtml.FSharp</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>CodingAdventures.DocumentAstToHtml.FSharp</PackageId>
    <Version>0.1.0</Version>
    <Authors>Adhithya Rajasekaran</Authors>
    <Description>Bounded, deterministic HTML rendering for the F# document AST</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/adhithyan15/coding-adventures</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>fsharp;html;document;ast;renderer;commonmark</PackageTags>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../document-ast/CodingAdventures.DocumentAst.fsproj" />
    <Compile Include="DocumentAstToHtml.fs" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
