            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Latin for a conspiracy, then the Latin for a traitor."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: iūdex, iūdicis",
          "segments": [
            {
              "kind": "speech",
              "text": "iūdex, iūdicis — \"a judge; a juror\"."
            },
            {
              "kind": "speech",
              "text": "Iūdex testēs diū audīvit. The judge listened to the witnesses for a long time."
            },
            {
              "kind": "speech",
              "text": "Masculine (also feminine), 3rd declension. In big trials many iūdicēs sat together as a jury."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "iūdex joins iūs, \"law, right\", and the root of dīcō, \"to say\" (EtymDB): the one who speaks the law. English judge comes from it through French."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
