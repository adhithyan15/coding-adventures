    {
      "id": "ZH-W170-bei-cup",
      "sequence": 13635,
      "title": "杯 (bēi) — a tree piece, then 不",
      "headword": "杯",
      "romanization": "bēi",
      "gloss": "杯 — the tree piece of 机, then 不",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:c6485f827eb8151a",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — a tree piece, then 不",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — a tree piece, then 不 and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say chábēi — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *chábēi* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "不 机."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — bù, jī",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *bù*, *jī*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — a tree piece, then 不",
          "segments": [
            {
              "kind": "speech",
              "text": "杯 (bēi)."
            },
            {
              "kind": "speech",
              "text": "Two pieces, left before right. Count the pieces, not the strokes."
            },
            {
              "kind": "speech",
              "text": "The left piece, four strokes: the tree piece, as on the left of 机. A horizontal. A vertical down through it. A stroke falling to the lower left from the crossing. Then a dot to the lower right, where 本 has a long stroke."
            },
            {
              "kind": "speech",
              "text": "The right piece, 不, four strokes, as you write it: a horizontal, a stroke falling to the left, a vertical, and a dot."
            },
            {
              "kind": "speech",
              "text": "4 + 4 = eight."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "杯 (bēi), all eight, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 杯, all eight, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many strokes in 杯 (bēi)? (Eight.) What is the right-hand piece? (不.) How does the tree piece end? (With a dot, not a long stroke.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 杯 (bēi), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
