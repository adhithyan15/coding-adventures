          "segments": [
            {
              "kind": "speech",
              "text": "accoster — \"to come alongside, to dock; to approach (someone)\"."
            },
            {
              "kind": "speech",
              "text": "Le bateau accoste au port vers midi. The boat docks in the harbour around noon."
            },
            {
              "kind": "speech",
              "text": "Accoster quelqu'un — to go up to someone in the street."
            }
          ]
        },
