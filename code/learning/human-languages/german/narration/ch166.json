          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Grund from Old High German grunt from Proto-Germanic grunduz — inherited, the same word as English ground. (EtymDB 2.1) A reason is the ground something stands on."
            }
