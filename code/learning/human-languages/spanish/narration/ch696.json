        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: el termómetro",
          "segments": [
            {
              "kind": "speech",
              "text": "el termómetro — \"the thermometer\"."
            },
            {
              "kind": "speech",
              "text": "El termómetro marca treinta grados. The thermometer shows thirty degrees."
            },
            {
              "kind": "speech",
              "text": "Treinta grados a la sombra — thirty degrees in the shade."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "termómetro came from French thermomètre, a word made from Greek thermós \"hot\" and métron \"measure\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
