          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "befristet is the participle of befristen, built on Frist \"time limit\", inherited from Middle High German vrist, Old High German frist and Proto-Germanic fristiz (EtymDB)."
            }
          ]
        },
