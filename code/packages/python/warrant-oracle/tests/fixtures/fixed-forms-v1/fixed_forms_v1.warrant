  model m_try_u32_i16(a: U32) -> I16 = unwrap_or(try<I16>(a), 0i16)
  model m_wrap_u64_i16(a: U64) -> I16 = wrap<I16>(a)
  model m_try_u64_i16(a: U64) -> I16 = unwrap_or(try<I16>(a), 0i16)
  model m_wrap_i8_i16(a: I8) -> I16 = wrap<I16>(a)
