              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *avdhi*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "jo tame ā avdhimā̃ arjī nahī̃ karo to tame ā tak gumāvśo. — If you don't apply within this time limit, you will lose this chance.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *jo tame ā avdhimā̃ arjī nahī̃ karo to tame ā tak gumāvśo.* — If you don't apply within this time limit, you will lose this chance.]"
