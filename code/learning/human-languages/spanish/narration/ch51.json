            },
            {
              "kind": "speech",
              "text": "What word does English need here that Spanish leaves out? (a.)"
            },
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Now say what you are, out loud, even if it is not profesor yet."
