        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: নাপিত",
          "segments": [
            {
              "kind": "speech",
              "text": "নাপিত — nāpit — \"a barber\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "নাপিত (nāpit) is Sanskrit nāpita, \"barber\", taken over whole as a learned loan, a tatsama (CDIAL 13792). The word inherited from it is nāu, which CDIAL lists."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
