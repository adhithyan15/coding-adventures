          "segments": [
            {
              "kind": "speech",
              "text": "rēmigō, rēmigāre — \"to row\"."
            },
            {
              "kind": "speech",
              "text": "Ventus nūllus est; itaque nautae rēmigant. There is no wind; so the sailors row."
            },
            {
              "kind": "speech",
              "text": "A first-conjugation verb: rēmigō, rēmigāre; the perfect is rare. The rower is rēmex, rēmigis."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "rēmigō is built from rēmus 'oar' and agō 'to drive' (EtymDB; Lewis & Short): to drive the oars."
            }
          ]
        },
