          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "latrunculus is a diminutive of latrō \"robber, hired soldier\" (Lewis & Short): the pieces of the game were little soldiers."
            }
          ]
        },
