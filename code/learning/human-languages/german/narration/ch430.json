          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Kakerlake probably came into German through Dutch kakkerlak, a word sailors brought back from overseas. EtymDB lists it without a source, and the deeper origin is not settled."
            }
          ]
        },
