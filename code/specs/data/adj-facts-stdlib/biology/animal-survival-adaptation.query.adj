% ============================================================================
% animal-survival-adaptation.query.adj — worked recall over the
% animal-survival-adaptation library.
% ============================================================================
% The shape a learner (or an LLM) produces to ANSWER "what adaptation is
% this animal known for?" (direct) or "which animal is known for this
% adaptation?" (reverse) — it states no fact of its own — it only
% `import`s the grounded table and asks binding queries.
% ============================================================================

import "animal-survival-adaptation.adj"

? animal_survival_adaptation(bats, $A)        % expect echolocation (direct)
? animal_survival_adaptation($X, insulation)  % expect polar_bear (reverse)
? animal_survival_adaptation(chameleon, $A)   % expect abstain -- chameleon is a real animal but not one of the three tabled here
