          "segments": [
            {
              "kind": "speech",
              "text": "પથારી — pathārī — \"bedding, bed\"."
            },
            {
              "kind": "speech",
              "text": "મારી પથારી તૈયાર છે. — mārī pathārī taiyār che — \"My bed is ready.\""
            }
