          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "terreō is inherited from a Proto-Indo-European root meaning \"to tremble, to frighten\" (EtymDB). English terrify and terror come from its family."
            }
          ]
        },
