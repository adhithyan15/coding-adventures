          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: जाहीर करणे",
          "segments": [
            {
              "kind": "speech",
              "text": "जाहीर करणे — jāhīr karṇe — \"to announce\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "जाहीर is a loan, usually traced through Persian to Arabic ẓāhir, \"evident, manifest\", whose root is ẓ-h-r (Lane). करणे comes from Sanskrit karoti, \"does\" (CDIAL 2814)."
            }
          ]
        },
        {
