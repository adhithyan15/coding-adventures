        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: der Wetterbericht",
          "segments": [
            {
              "kind": "speech",
              "text": "der Wetterbericht — \"the weather report, the forecast\"."
            },
            {
              "kind": "speech",
              "text": "Laut Wetterbericht regnet es morgen den ganzen Tag. According to the weather report it will rain all day tomorrow."
            },
            {
              "kind": "speech",
              "text": "Plural: die Wetterberichte."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Wetterbericht is built from Wetter 'weather', an inherited word and a cousin of English weather (EtymDB), and Bericht 'report', from Middle High German beriht (EtymDB)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
