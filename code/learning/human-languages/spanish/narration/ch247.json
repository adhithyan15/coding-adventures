                "twice",
                "two: con at the front and cum at the back"
              ],
              "feedback": {
                "correct": "Once at each end, fifteen centuries apart.",
                "incorrect": "Twice -- con on the front, the old cum on the end."
              }
            },
            {
              "kind": "activity",
              "scored": true,
              "id": "ES-C64-conmigo-third",
              "prompt": "And with him?",
              "assesses": [
