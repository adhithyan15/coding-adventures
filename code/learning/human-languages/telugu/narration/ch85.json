            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Telugu for thirst, then the Telugu for rest."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: చలి",
          "segments": [
            {
              "kind": "speech",
              "text": "చలి (cali) — \"cold, the cold\"."
            },
            {
              "kind": "speech",
              "text": "ఇవాళ చలిగా ఉంది — \"it is cold today\". నాకు చలిగా ఉంది — \"I feel cold\"."
            },
            {
              "kind": "speech",
              "text": "The same frame again: with నాకు it is your body, without it it is the day."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "The first word that works for both the weather and the body."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
