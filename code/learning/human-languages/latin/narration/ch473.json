          "segments": [
            {
              "kind": "speech",
              "text": "casa, casae — \"a cottage, a small house\"."
            },
            {
              "kind": "speech",
              "text": "Pastor in casā parvā prope silvam habitat. The shepherd lives in a small cottage near the wood."
            },
            {
              "kind": "speech",
              "text": "First declension, feminine: casa, casae f. In Italian and Spanish it became the everyday word for 'house'."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "The origin of casa is not settled: Lewis & Short link it with a root meaning 'to cover', but EtymDB gives no parent. It became casa 'house' in Italian, Spanish and Portuguese."
            }
          ]
        },
