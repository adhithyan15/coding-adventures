        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: qíngtiān",
          "segments": [
            {
              "kind": "speech",
              "text": "qíngtiān — \"sunny day; fine weather\"."
            },
            {
              "kind": "speech",
              "text": "jīntiān shì qíngtiān wǒ xiǎng chūmén — It's a sunny day, so I feel like going out."
            },
            {
              "kind": "speech",
              "text": "Its characters come later; for now it is a word for the ear."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "qíngtiān is built from qíng 'clear' and 天 'sky', both inherited from Middle Chinese, dzjeng and then (Guangyun, in Baxter's transcription); the dictionary glosses the first 'the sky clearing'."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for giving reasons."
