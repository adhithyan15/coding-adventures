{
  "name": "@coding-adventures/sir-runtime-exceptions",
  "version": "0.2.0",
  "description": "Exception runtime for Semantic-IR-emitted TypeScript/JavaScript — SIR exception base class, raise helper, and rescue-clause class matching",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc",
    "test": "node node_modules/typescript/bin/tsc -p tsconfig.test.json && node --test dist-test/tests/exceptions.test.js",
    "test:coverage": "node node_modules/typescript/bin/tsc -p tsconfig.test.json && node --experimental-test-coverage --test-coverage-exclude=dist-test/tests/** --test-coverage-lines=80 --test dist-test/tests/exceptions.test.js"
  },
  "keywords": [
    "sir",
    "semantic-ir",
    "runtime",
    "exceptions",
    "compiler",
    "cross-language",
    "education"
  ],
  "author": "Adhithya Rajasekaran",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  }
}
