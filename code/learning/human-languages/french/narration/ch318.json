          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "feu is inherited from Latin focus \"hearth\" (EtymDB), and artifice is a learned borrowing from Latin artificium \"craft, skill\", from ars and facere (Lewis & Short)."
            }
          ]
        },
