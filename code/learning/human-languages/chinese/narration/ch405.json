    {
      "id": "ZH-W405-ru-enter",
      "sequence": 31165,
      "title": "入 (rù) — two strokes, the right one on top",
      "headword": "入",
      "romanization": "rù",
      "gloss": "入 — a short stroke falling left, then a long one falling right",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:250b337fb9b94860",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — two strokes, the right one on top",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — two strokes, the right one on top and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say jìnrù — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *jìnrù* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "人 进."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — rén, jìn",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *rén*, *jìn*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — two strokes, the right one on top",
          "segments": [
            {
              "kind": "speech",
              "text": "入 (rù)."
            },
            {
              "kind": "speech",
              "text": "One piece, two strokes."
            },
            {
              "kind": "speech",
              "text": "First, a short stroke falling to the left, from the middle down to the lower left."
            },
            {
              "kind": "speech",
              "text": "Then a long stroke falling to the right. It starts higher, above the top of the first, and sweeps down to the lower right."
            },
            {
              "kind": "speech",
              "text": "In 人 the left stroke is the long one and the right stroke leans on it; in 入 (rù) it is the other way round."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "入 (rù), all two, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 入, all two, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many strokes in 入 (rù)? (Two.) Which one starts higher? (The second, falling to the right.) How is it unlike 人? (In 入 (rù) the right stroke is the long one.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 入 (rù), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
