          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: mereor, merērī",
          "segments": [
            {
              "kind": "speech",
              "text": "mereor, merērī — \"to deserve, to earn\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "mereor is the deponent twin of mereō, \"to earn, to deserve\" (Lewis & Short). It is usually traced to Proto-Indo-European smer-, \"to get a share\"; Greek meiromai, \"to receive one's share\", is a cousin."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
