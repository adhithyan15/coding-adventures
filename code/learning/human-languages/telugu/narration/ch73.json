      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: what did kāraṁ mean?"
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: వగరు",
          "segments": [
            {
              "kind": "speech",
              "text": "వగరు (vagaru) — \"astringent\"."
            },
            {
              "kind": "speech",
              "text": "వగరు (vagaru) is astringency — the dry, puckering taste of an unripe పండు, of raw banana, of టీ left to stand."
            },
            {
              "kind": "speech",
              "text": "English has no everyday word for it and Telugu has had one for as long as it has been written down. Once you can name it you begin noticing it, which is most of what a word is for."
            },
            {
              "kind": "speech",
              "text": "With ఉప్పు, which you already have, that is the full set a Telugu cook thinks in: తీపి (tīpi), పులుపు (pulupu), చేదు (cēdu), కారం (kāraṁ), వగరు (vagaru) and salt. A meal carrying all of them is finished, and so is the visit — వెళ్ళొస్తాను."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "Five: తీపి (tīpi), పులుపు (pulupu), చేదు (cēdu), కారం (kāraṁ), వగరు (vagaru). The tastes a Telugu meal is built from, and the last of them names what nothing else does."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "vagaru",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *vagaru*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "it once more, slowly",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: it once more, slowly]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "all five in order, then take your leave with veḷḷostānu",
