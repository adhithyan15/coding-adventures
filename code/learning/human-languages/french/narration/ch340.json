          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "fiable is built on se fier \"to trust\" (EtymDB), which is usually traced to a Vulgar Latin fīdāre, formed on Latin fīdere \"to trust\" (Lewis & Short)."
            }
          ]
        },
