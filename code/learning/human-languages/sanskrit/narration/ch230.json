              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *saphalatā*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "say saphalatā",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: say *saphalatā*]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say the Sanskrit for authority, then the Sanskrit for a question paper, then say saphalatā again",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say the Sanskrit for authority, then the Sanskrit for a question paper, then say *saphalatā* again]"
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What does सफलता (saphalatā) mean? (\"Success\".) Say it once more."
            }
