      "root": "/repo",
      "summary": "the root is inside itself"
    },
    {
      "child": "/repo/",
      "expect": {
        "inside": true,
        "same": true
      },
      "flavor": "posix",
      "id": "containment/posix-child-trailing-slash",
      "root": "/repo",
      "summary": "the root with a trailing slash"
    },
    {
      "child": "/repo/x",
      "expect": {
        "inside": true,
        "same": false
      },
      "flavor": "posix",
      "id": "containment/posix-root-trailing-slash",
      "root": "/repo/",
      "summary": "a root written with a trailing slash"
    },
    {
      "child": "/repo2",
      "expect": {
        "inside": false,
        "same": false
      },
      "flavor": "posix",
      "id": "containment/posix-sibling-prefix",
      "root": "/repo",
      "summary": "/repo2 shares a string prefix but is not inside /repo"
    },
    {
      "child": "/repo-evil/x",
      "expect": {
        "inside": false,
        "same": false
      },
      "flavor": "posix",
      "id": "containment/posix-sibling-prefix-deep",
      "root": "/repo",
      "summary": "/repo-evil/x shares a string prefix"
    },
    {
      "child": "/repo",
      "expect": {
        "inside": false,
        "same": false
      },
      "flavor": "posix",
      "id": "containment/posix-parent",
      "root": "/repo/sub",
      "summary": "the parent directory"
    },
    {
      "child": "/repo/..",
