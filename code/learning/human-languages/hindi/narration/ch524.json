      "title": "गलाना (galānā) — to cook soft; to soften",
      "headword": "गलाना",
      "romanization": "galānā",
      "gloss": "to cook soft; to soften",
      "script": "devanagari",
      "modality": "voice",
      "derivedModality": "voice",
