        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: மரியாதை",
          "segments": [
            {
              "kind": "speech",
              "text": "மரியாதை (mariyādai) — \"respect\"."
            },
            {
              "kind": "speech",
              "text": "Sanskrit maryādā, which started life as a boundary mark — the line at the edge of a field. Respect, in that picture, is knowing where the line runs and not stepping over it."
            },
            {
              "kind": "speech",
              "text": "Tamil shows it in its endings as much as in its words. You have been doing it since nīṅgaḷ, where the ending meant for many is aimed at one person on purpose: mariyādai built out of shape rather than out of vocabulary."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "Two: what you feel, and what you show."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
