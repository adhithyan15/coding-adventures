          "segments": [
            {
              "kind": "speech",
              "text": "बदमाश (badmāś) is usually traced to Persian bad, \"bad\", and maʿāš, \"a livelihood\", a word Persian took from Arabic: someone who lives by bad means. Said fondly to a child, it means a little rascal."
            }
          ]
        },
