          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "sobald joins so and bald \"soon\". Bald is inherited and is a cousin of English bold (EtymDB), from an older sense \"bold, quick\"."
            }
          ]
        },
