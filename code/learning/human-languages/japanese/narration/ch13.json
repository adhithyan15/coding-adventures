    {
      "id": "JA-W13-tsu",
      "sequence": 1010,
      "title": "つ (tsu) — one full-size curve",
      "headword": "つ",
      "romanization": "tsu",
      "gloss": "the full-size hiragana sign for the mora tsu",
      "script": "japanese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "writing-block",
        "script-block"
      ],
      "sourceHash": "fnv1a64:3e3f54c8f202bda8",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Script — notice and trace"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now — leave the section called Script — notice and trace until you have stopped, and I will say so again when we reach it."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 35,
              "perItem": false,
              "source": "[PAUSE 35s]"
            },
            {
              "kind": "speech",
              "text": "Write ありがとう, name its older arigatashi family, and point to the dakuten. Then write small っ and retrieve one word from the body map."
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — notice and trace",
          "segments": [
            {
              "kind": "speech",
              "text": "つ — tsu."
            },
            {
              "kind": "speech",
              "text": "This is the full-size sign. Trace its one stroke: begin at the upper left, sweep right, turn downward, and finish toward the lower left."
            }
          ]
        },
        {
          "index": 2,
          "type": "writing",
          "title": "Writing — copy, then recall",
          "segments": [
            {
              "kind": "speech",
              "text": "Copy つ (tsu) once. Hide it for ten seconds, write it once, then place つ (tsu) beside small っ and check that the full-size sign is clearly larger."
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "speech",
              "text": "Read it once: tsu."
            },
            {
              "kind": "speech",
              "text": "Source: Unicode Hiragana chart; stroke order per Hitsujun Shido no Tebiki (Japanese Ministry of Education, 1958)."
            },
            {
              "kind": "activity",
              "scored": true,
              "id": "JA-W13-tsu-write",
              "prompt": "Write the full-size hiragana sign for tsu.",
              "assesses": [
                "JA-SCRIPT-TSU-01"
              ],
              "responseSeconds": 10,
              "acceptedResponses": [
                "つ"
              ],
              "feedback": {
                "correct": "Right: full-size つ carries the mora tsu.",
                "incorrect": "Use one full-size curving stroke: つ."
              }
            }
          ]
        }
      ]
    },
