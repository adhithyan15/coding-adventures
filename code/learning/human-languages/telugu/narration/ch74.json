        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: మరియు",
          "segments": [
            {
              "kind": "speech",
              "text": "మరియు (mariyu) — \"and\"."
            },
            {
              "kind": "speech",
              "text": "Telugu's everyday speech often joins two things by simply saying them one after the other, or by hanging a small -ఉ on the end of each. మరియు (mariyu) is the written, spoken-carefully form, and it is the one a list on a page will use."
            },
            {
              "kind": "speech",
              "text": "Put it between two nouns you already have: నీళ్ళు మరియు (mariyu) పాలు — \"water and milk\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "The first way you have had to put two things in one sentence."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
