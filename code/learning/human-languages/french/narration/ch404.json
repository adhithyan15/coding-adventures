        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: la crevaison",
          "segments": [
            {
              "kind": "speech",
              "text": "la crevaison — \"the puncture, the flat tyre\"."
            },
            {
              "kind": "speech",
              "text": "Nous avons eu une crevaison sur la petite route. We had a puncture on the little road."
            },
            {
              "kind": "speech",
              "text": "Réparer une crevaison — to mend a puncture."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "crevaison is built on crever 'to burst' with the ending -aison (EtymDB). Crever is inherited from Latin crepāre 'to crack, to burst'."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
