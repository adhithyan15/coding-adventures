            },
            {
              "kind": "speech",
              "text": "qǐngwèn cèsuǒ zài nǎr — Excuse me, where's the toilet?"
            },
            {
              "kind": "speech",
              "text": "Its characters come later; for now it is a word for the ear."
            }
