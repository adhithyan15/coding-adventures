            },
            {
              "kind": "speech",
              "text": "Die Bestätigung für das Hotel kommt per E-Mail. The confirmation for the hotel comes by email."
            },
            {
              "kind": "speech",
              "text": "Plural: die Bestätigungen. From bestätigen — to confirm."
            }
          ]
