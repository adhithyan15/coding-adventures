        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: हथौड़ा",
          "segments": [
            {
              "kind": "speech",
              "text": "हथौड़ा — hathauṛā — \"a hammer\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "हथौड़ा (hathauṛā) is a tadbhava, a word inherited and reshaped by sound change. It comes from hastakūṭa, \"hand hammer\", a form CDIAL reconstructs from its descendants (CDIAL 14028). It is built from hasta, \"hand\", and kūṭa, \"hammer\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
