          "segments": [
            {
              "kind": "speech",
              "text": "آتش گرفتن (âtash gereftan) — \"to catch fire\"."
            },
            {
              "kind": "speech",
              "text": "آشپزخانه ناگهان آتش گرفت. Âshpazkhâne nâgahân âtash gereft. The kitchen suddenly caught fire."
            },
            {
              "kind": "speech",
              "text": "Present âtash migirad. Âtash zadan is \"to set on fire\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "âtash \"fire\" is inherited from Middle Persian (EtymDB); gereftan \"to take\" is inherited too, from the Old Persian root grab- \"to seize\"."
            }
          ]
        },
