            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Marathi for ninth, then the Marathi for tenth."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: हात",
          "segments": [
            {
              "kind": "speech",
              "text": "हात — hāt — \"a hand\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "हात (hāt) is a tadbhava, a word inherited from Sanskrit and reshaped by sound change. It comes from hasta, \"hand\" (CDIAL 14024). CDIAL glosses the Marathi word \"hand, arm, cubit\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for this chapter."
