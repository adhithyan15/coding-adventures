    {
      "id": "PA-C222-ki-nahin-future",
      "sequence": 12210,
      "title": "ਕੀ ਤੁਸੀਂ ਕੱਲ੍ਹ ਕੰਮ ਕਰੋਗੇ? (kī tusīṁ kallh kamm karoge?) — will you work tomorrow?",
      "headword": "ਕੀ ਤੁਸੀਂ ਕੱਲ੍ਹ ਕੰਮ ਕਰੋਗੇ?",
      "romanization": "kī tusīṁ kallh kamm karoge?",
      "gloss": "will you work tomorrow? asking and saying no in the future",
      "script": "gurmukhi",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:5a0db1d3aa0b5dcd",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Say what will you do tomorrow? Then are you a traveller?"
            }
          ]
        },
        {
          "index": 1,
          "type": "grammar",
          "title": "Grammar Lens: ਕੀ and ਨਹੀਂ with the future",
          "segments": [
            {
              "kind": "speech",
              "text": "Nothing moves. ਕੀ goes in front to ask yes or no; ਨਹੀਂ goes before the verb to say no:"
            },
            {
              "kind": "speech",
              "text": "ਕੀ ਤੁਸੀਂ ਕੱਲ੍ਹ ਕੰਮ ਕਰੋਗੇ? — kī tusīṁ kallh kamm karoge? — Will you work tomorrow?"
            },
            {
              "kind": "speech",
              "text": "ਨਹੀਂ ਜੀ, ਮੈਂ ਕੱਲ੍ਹ ਕੰਮ ਨਹੀਂ ਕਰਾਂਗੀ। — nahīṁ jī, maiṁ kallh kamm nahīṁ karāṅgī. — No, I won't work tomorrow."
            },
            {
              "kind": "speech",
              "text": "ਕੀ ਅਮਨ ਕੱਲ੍ਹ ਆਵੇਗਾ? — kī Aman kallh āvegā? — Will Aman come tomorrow?"
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "HEAR",
              "instruction": "will she go to school tomorrow?",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU HEAR: *will she go to school tomorrow?*]"
            },
            {
              "kind": "speech",
              "text": "Say ਕੀ ਉਹ ਕੱਲ੍ਹ ਸਕੂਲ ਜਾਵੇਗੀ?"
            },
            {
              "kind": "prompt",
              "action": "HEAR",
              "instruction": "no, she won't go",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU HEAR: *no, she won't go*]"
            },
            {
              "kind": "speech",
              "text": "Say ਨਹੀਂ ਜੀ, ਉਹ ਨਹੀਂ ਜਾਵੇਗੀ।."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "ਕੀ ਅਮਨ ਕੱਲ੍ਹ ਆਵੇਗਾ?",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: **ਕੀ ਅਮਨ ਕੱਲ੍ਹ ਆਵੇਗਾ?**]"
            },
            {
              "kind": "speech",
              "text": "Give its meaning."
            },
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "copy ਨਹੀਂ ਕਰਾਂਗਾ once",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: copy **ਨਹੀਂ ਕਰਾਂਗਾ** once]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
