            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Persian for an envelope, then the Persian for a pencil sharpener."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: خط کش",
          "segments": [
            {
              "kind": "speech",
              "text": "خط کش — khatkesh — \"a ruler\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "khatkesh is khat, \"line\", with -kesh, \"drawing\" (from keshidan, \"to draw\"): the line-drawer. khat is borrowed from Arabic ḫaṭṭ, \"line, writing\" (root ḫ-ṭ-ṭ, Lane); kesh is native Persian."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for this chapter."
