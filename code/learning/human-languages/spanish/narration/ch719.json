          "segments": [
            {
              "kind": "speech",
              "text": "angustia is a learned borrowing from Latin angustia \"narrowness, difficulty, distress\" (EtymDB), built on angustus \"narrow\": distress is a tightness in the chest."
            }
          ]
        },
