              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: at the door, tell your host to take care and to come soon]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "take your leave formally, then hurry your group along",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
