              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: it once more, slowly]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "all five in order — kūṭutal, kuṟavŭ, kuṟaccŭ, vēṇṭa, pōruṁ",
