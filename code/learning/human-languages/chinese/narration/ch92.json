      "sourceHash": "fnv1a64:59da42ceaa32356c",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — the right half of 他",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — the right half of 他 and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say yě — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *yě* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "他 他们."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — tā, tāmen",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *tā*, *tāmen*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — the right half of 他",
          "segments": [
            {
              "kind": "speech",
              "text": "也 (yě)."
            },
            {
              "kind": "speech",
              "text": "One piece, and your hand already knows it: the right half of 他, stroke for stroke."
            },
            {
              "kind": "speech",
              "text": "A hooked turn: a horizontal that rises a little, turns down the right side and hooks to the left."
            },
            {
              "kind": "speech",
              "text": "A short vertical from above it, down through it."
            },
            {
              "kind": "speech",
              "text": "The long bend: down the left from above the horizontal, along the foot to the right, and a hook up at the end."
            },
            {
              "kind": "speech",
              "text": "Three strokes."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "也 (yě), all three, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 也, all three, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many strokes in 也 (yě)? (Three.) Where have you written them before? (On the right of 他.) Which stroke ends with a hook up? (The last, the long bend.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 也 (yě), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
