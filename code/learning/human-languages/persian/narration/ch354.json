        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: کشف کردن",
          "segments": [
            {
              "kind": "speech",
              "text": "کشف کردن (kashf kardan) — \"to discover\"."
            },
            {
              "kind": "speech",
              "text": "دانشمندان یک شهر قدیمی را زیر زمین کشف کردند. Dâneshmandân yek shahr-e qadimi râ zir-e zamin kashf kardand. Scientists discovered an old city underground."
            },
            {
              "kind": "speech",
              "text": "Present kashf mikonad. Kashf alone is \"a discovery\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "kashf is borrowed from Arabic kashf, \"an unveiling, an uncovering\" (EtymDB). kardan \"to do\" is inherited Persian."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
            }
          ]
        },
