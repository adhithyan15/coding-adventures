          "title": "You'll want to know: assus, assa, assum",
          "segments": [
            {
              "kind": "speech",
              "text": "assus, assa, assum — \"roasted\"."
            },
            {
              "kind": "speech",
              "text": "Carō assa iūcunda erat. The roast meat was delicious."
            },
            {
              "kind": "speech",
              "text": "Assus is roasted, ēlixus boiled: Horace and Celsus set the two side by side."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "assus is inherited (EtymDB); Lewis & Short connect it with āreō, \"to be dry\", and ārdeō, \"to burn\"."
            }
          ]
        },
