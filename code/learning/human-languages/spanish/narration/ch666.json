        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: el saco de dormir",
          "segments": [
            {
              "kind": "speech",
              "text": "el saco de dormir — \"the sleeping bag\"."
            },
            {
              "kind": "speech",
              "text": "Hace frío, lleva un buen saco de dormir. It is cold, take a good sleeping bag."
            },
            {
              "kind": "speech",
              "text": "In Latin America also la bolsa de dormir."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "saco is inherited from Latin saccus \"a sack, a bag\" (Lewis & Short; EtymDB), and dormir from Latin dormīre \"to sleep\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
