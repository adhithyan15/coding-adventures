        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: einverstanden",
          "segments": [
            {
              "kind": "speech",
              "text": "einverstanden — \"agreed, in agreement\"."
            },
            {
              "kind": "speech",
              "text": "Meine Eltern sind einverstanden: Ich darf am Samstag zur Party gehen. My parents agree: I am allowed to go to the party on Saturday."
            },
            {
              "kind": "speech",
              "text": "Mit etwas einverstanden sein — to agree to something. On its own, Einverstanden! means OK, agreed."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "einverstanden is the old participle of sich einverstehen \"to reach an understanding\", built on verstehen \"to understand\", from Old High German firstān and Proto-Germanic frastāną (EtymDB), and so on stehen \"to stand\". EtymDB lists the parts, not the compound."
            }
          ]
        },
        {
