              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "speech",
              "text": "Say the four seasons, then the one that shapes Kerala most. (Maḻakkālaṁ, the rains.)"
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: കോണി",
          "segments": [
