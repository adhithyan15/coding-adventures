        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: पिदधाति",
          "segments": [
            {
              "kind": "speech",
              "text": "पिदधाति — pidadhāti — \"covers, closes\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "pidadhāti is built on pi-, a shortened form of api, \"upon\", and dadhāti, \"puts\", from the root √dhā (MW). To put something upon a thing is to cover or close it; the Veda still says api-dhā. MW compares √dhā with English do."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for this chapter."
