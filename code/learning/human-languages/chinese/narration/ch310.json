        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: huáiyí",
          "segments": [
            {
              "kind": "speech",
              "text": "huáiyí — \"to suspect; to doubt\"."
            },
            {
              "kind": "speech",
              "text": "jǐngchá huáiyí tā shì xiǎotōu — The police suspect he's the thief."
            },
            {
              "kind": "speech",
              "text": "Its characters come later; for now it is a word for the ear."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "huáiyí is built from huái 'to hold close' and yí 'to doubt', both inherited from Middle Chinese, hweaj and ngi (Guangyun, in Baxter's transcription), which glosses the first 'to embrace' and 'to think of' and the second 'unsure' and 'to suspect': to hold a doubt."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling what happened."
