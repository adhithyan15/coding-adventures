  "lessons": [
    {
      "id": "PA-C224-message-return",
      "sequence": 12280,
      "title": "Return to a message and a time",
      "headword": "ਸੁਨੇਹਾ · ਨੌਂ ਵਜੇ",
      "romanization": "sunehā · nauṁ vaje",
      "gloss": "retrieve a message and a clock time by ear",
      "script": "gurmukhi",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:2e431b5c43963542",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "prompt",
              "action": "HEAR",
              "instruction": "sunehā",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU HEAR: *sunehā*]"
            },
            {
              "kind": "speech",
              "text": "Say ਸੁਨੇਹਾ, \"a message\". Then at nine: ਨੌਂ ਵਜੇ."
            }
          ]
        },
        {
          "index": 1,
          "type": "grammar",
          "title": "Grammar Lens",
          "segments": [
            {
              "kind": "speech",
              "text": "A message from a friend often says three things: what happened, what did not, and what will happen when. You can say all three now. Listen for ਕੱਲ੍ਹ: the verb tells you whether it is yesterday or tomorrow."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "HEAR",
              "instruction": "a message",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU HEAR: *a message*]"
            },
            {
              "kind": "speech",
              "text": "Say ਸੁਨੇਹਾ."
            },
            {
              "kind": "prompt",
              "action": "HEAR",
              "instruction": "at eight",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU HEAR: *at eight*]"
            },
            {
              "kind": "speech",
              "text": "Say ਅੱਠ ਵਜੇ."
            },
            {
              "kind": "prompt",
              "action": "HEAR",
              "instruction": "I went to the market yesterday",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU HEAR: *I went to the market yesterday*]"
            },
            {
              "kind": "speech",
              "text": "Say it with the ending that fits you."
            },
            {
              "kind": "prompt",
              "action": "HEAR",
              "instruction": "we will go tomorrow",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU HEAR: *we will go tomorrow*]"
            },
            {
              "kind": "speech",
              "text": "Say ਅਸੀਂ ਕੱਲ੍ਹ ਜਾਵਾਂਗੇ."
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "ਕੱਲ੍ਹ with ਗਿਆ? (Yesterday.) With ਜਾਵਾਂਗੇ? (Tomorrow.)"
            }
          ]
        }
      ]
    },
    {
      "id": "PA-C224-message",
      "sequence": 12290,
      "title": "A message about tomorrow",
      "headword": "(reading)",
      "romanization": "kall maiṁ bāzār giā.",
      "gloss": "a short message from a friend, read for what happened and what will happen when",
      "script": "gurmukhi",
      "modality": "sight",
      "derivedModality": "sight",
      "modalityReasons": [
        "reading-type"
      ],
      "sourceHash": "fnv1a64:cc0262ee0b242493",
      "notice": {
        "modality": "sight",
        "needs": [
          "your eyes, to read the printed text yourself"
        ],
        "waitUntilStopped": [
          "Reading"
        ],
        "text": "Before we start: this one needs your eyes, so it is not a driving lesson. You will want your eyes, to read the printed text yourself. The questions are about what you read, so save the whole lesson for when you have stopped."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Say a message. Then Aman."
            },
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "speech",
              "text": "Aman sends you a message. Read it for one thing first: what time you have to be at the station."
            }
          ]
        },
        {
          "index": 1,
          "type": "comprehension",
          "title": "Reading",
          "segments": [
            {
              "kind": "speech",
              "text": "ਸਤਿ ਸ੍ਰੀ ਅਕਾਲ ਜੀ! ਮੈਂ ਅਮਨ ਹਾਂ। ਕੱਲ੍ਹ ਮੈਂ ਬਾਜ਼ਾਰ ਗਿਆ। ਮੈਂ ਇੱਕ ਕਿਤਾਬ ਖ਼ਰੀਦੀ, ਪਰ ਮੈਂ ਚਾਹ ਨਹੀਂ ਪੀਤੀ। ਕੱਲ੍ਹ ਸਵੇਰੇ ਅਸੀਂ ਰੇਲ ਨਾਲ ਜਾਵਾਂਗੇ। ਰੇਲ ਨੌਂ ਵਜੇ ਆਵੇਗੀ। ਮੈਂ ਅੱਠ ਵਜੇ ਸਟੇਸ਼ਨ ਜਾਵਾਂਗਾ। ਟਿਕਟ ਨਾ ਭੁੱਲੋ! ਸ਼ਾਇਦ ਮੇਰਾ ਭਰਾ ਆਵੇਗਾ। ਫਿਰ ਮਿਲਾਂਗੇ।."
            },
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "the message once, straight through, without translating",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: the message once, straight through, without translating]"
            },
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "it a second time, and find every line with a clock time",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: it a second time, and find every line with a clock time]"
            }
          ]
        },
        {
          "index": 2,
          "type": "input",
          "title": "You'll want to know",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "ਕੱਲ੍ਹ comes twice: with ਗਿਆ it is yesterday, with ਜਾਵਾਂਗੇ tomorrow. ਟਿਕਟ ਨਾ ਭੁੱਲੋ! is a request built like ਨਾ ਉੱਠੋ, on ਭੁੱਲਣਾ, \"to forget\". The last line but one is the only one that is not sure."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": true,
              "source": "[PAUSE 2s each]"
            },
            {
              "kind": "prompt",
              "action": "ANSWER",
              "instruction": "what did Aman buy yesterday? (A book: ਮੈਂ ਇੱਕ ਕਿਤਾਬ ਖ਼ਰੀਦੀ।)",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU ANSWER: what did Aman buy yesterday? (A book: **ਮੈਂ ਇੱਕ ਕਿਤਾਬ ਖ਼ਰੀਦੀ।**)]"
            },
            {
              "kind": "prompt",
              "action": "ANSWER",
              "instruction": "what did he not do? (He didn't drink tea.)",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU ANSWER: what did he not do? (He didn't drink tea.)]"
            },
            {
              "kind": "prompt",
              "action": "ANSWER",
              "instruction": "when will the train come? (At nine: ਨੌਂ ਵਜੇ.)",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU ANSWER: when will the train come? (At nine: **ਨੌਂ ਵਜੇ**.)]"
            },
            {
              "kind": "prompt",
              "action": "ANSWER",
              "instruction": "who will perhaps come? (His brother.)",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU ANSWER: who will perhaps come? (His brother.)]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "When will Aman be at the station? (At eight.) What must you not forget? (The ticket.)"
            }
          ]
        }
      ]
    },
    {
      "id": "PA-C224-message-questions",
      "sequence": 12300,
      "title": "The message, by ear",
      "headword": "ਰੇਲ ਕਦੋਂ ਆਵੇਗੀ?",
      "romanization": "rel kadoṁ āvegī?",
      "gloss": "answer questions about the message by ear",
      "script": "gurmukhi",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:70280465ce119719",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Hold Aman's message in mind: yesterday, and tomorrow."
            }
          ]
        },
        {
          "index": 1,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": true,
              "source": "[PAUSE 2s each]"
            },
            {
              "kind": "prompt",
              "action": "HEAR",
              "instruction": "Aman kall kitthe giā?",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU HEAR: *Aman kall kitthe giā?*]"
            },
            {
              "kind": "speech",
              "text": "Answer: ਉਹ ਬਾਜ਼ਾਰ ਗਿਆ।."
            },
            {
              "kind": "prompt",
              "action": "HEAR",
              "instruction": "kī Aman ne chāh pītī?",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU HEAR: *kī Aman ne chāh pītī?*]"
            },
            {
              "kind": "speech",
              "text": "Answer: ਨਹੀਂ ਜੀ, ਉਸ ਨੇ ਚਾਹ ਨਹੀਂ ਪੀਤੀ।."
            },
            {
              "kind": "prompt",
              "action": "HEAR",
              "instruction": "rel kadoṁ āvegī?",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU HEAR: *rel kadoṁ āvegī?*]"
            },
            {
              "kind": "speech",
              "text": "Answer: ਰੇਲ ਨੌਂ ਵਜੇ ਆਵੇਗੀ।."
            },
            {
              "kind": "prompt",
              "action": "HEAR",
              "instruction": "Aman kinne vaje saṭeshan jāvegā?",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU HEAR: *Aman kinne vaje saṭeshan jāvegā?*]"
            },
            {
              "kind": "speech",
              "text": "Answer: ਅੱਠ ਵਜੇ।."
            }
          ]
        },
        {
          "index": 2,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Tell the message back in three lines: what Aman did, what he didn't, and what will happen tomorrow."
            }
          ]
        }
      ]
    },
    {
      "id": "PA-R224-first-pass-saying-no-and-asking",
