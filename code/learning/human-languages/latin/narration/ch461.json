          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: thermopōlium, thermopōliī",
          "segments": [
            {
              "kind": "speech",
              "text": "thermopōlium, thermopōliī — \"a hot-drinks bar, a tavern selling warm drinks\"."
            },
            {
              "kind": "speech",
              "text": "Fabrī in thermopōliō vīnum calidum bibunt. The workmen drink warm wine in the hot-drinks bar."
            },
            {
              "kind": "speech",
              "text": "Second declension, neuter: thermopōlium, thermopōliī n. A word of comedy; such bars, with jars set in the counter, line the streets of excavated towns."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "thermopōlium comes from Greek, built from thermos 'hot' and pōleō 'to sell' (Lewis & Short give the sense, a place where warm drinks were sold). EtymDB does not list it."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
