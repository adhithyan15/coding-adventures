% ============================================================================
% coag-edges — the coagulation / bleeding-disorder knowledge-graph (MYCIN-2026 REL-13).
% ============================================================================
% A FIFTH recall domain — coagulation (hematology). "Which factor is deficient in
% hemophilia B?" becomes the binding query  ? factor_deficiency(hemophilia_b, $Factor).
% Three relations query one disorder three ways: deficient factor, inheritance pattern,
% and the screening test it prolongs (intrinsic VIII/IX/XI → aPTT; extrinsic VII → PT;
% vWD → bleeding time).
%
% GENERATED by recall/coag_edge_ground.py from recall/coag-edge-grounding.json
% (the spider's byte-provenanced output). Do not hand-edit — re-ground and regenerate.
% A grounded edge carries its byte-quote as `source` + `trust authoritative` (+ URL as
% `locator`); an ungrounded edge stays `trust consensus`, tagged `% [FLAG: <status>]`,
% so the authored-debt is visible and drives to zero. (See feedback_nothing_human_authored.)
% ============================================================================

dictionary coag_vocab {
    define disorder    : entity   surface "bleeding disorder", "coagulopathy"
    define factor      : entity   surface "clotting factor", "coagulation factor"
    define pattern     : entity   surface "inheritance pattern"
    define test        : entity   surface "screening test", "coagulation assay"

    define factor_deficiency : relation from disorder to factor
    define coag_inheritance  : relation from disorder to pattern
    define prolonged_test    : relation from disorder to test
}

rulebook coag_facts {
    use coag_vocab

    % --- Hemophilia A (factor VIII deficiency) ---------------------------
    relate factor_deficiency(hemophilia_a, factor_viii)
        source "Hemophilia A and B result from factor VIII and factor IX protein deficiency or dysfunction, respectively, and are characterized by prolonged and excessive bleeding after minor trauma or sometimes even spontaneously."
        locator "https://www.ncbi.nlm.nih.gov/books/NBK551607/"
        trust authoritative
    relate coag_inheritance(hemophilia_a, x_linked_recessive)
        source "An X-linked, recessive hemorrhagic trait or gene induces Hemophilia A."
        locator "https://www.ncbi.nlm.nih.gov/books/NBK470265/"
        trust authoritative
    relate prolonged_test(hemophilia_a, aptt)
        source "Hemophiliacs have an elevated aPTT and a normal PT/INR, as well as normal bleeding time and platelet count."
        locator "https://www.ncbi.nlm.nih.gov/books/NBK541050/"
        trust authoritative

    % --- Hemophilia B (Christmas disease, factor IX deficiency) ----------
    relate factor_deficiency(hemophilia_b, factor_ix)
        source "Hemophilia B, also known as Christmas disease, is the second most prevalent form of hemophilia. A defect in the F9 gene causes hemophilia B, leading to inadequate production of factor IX."
        locator "https://www.ncbi.nlm.nih.gov/books/NBK560792/"
        trust authoritative
    relate coag_inheritance(hemophilia_b, x_linked_recessive)
        source "Hemophilia B primarily follows an X-linked recessive pattern of inheritance."
        locator "https://www.ncbi.nlm.nih.gov/books/NBK560792/"
        trust authoritative
    relate prolonged_test(hemophilia_b, aptt)
        source "Patients with hemophilia B will exhibit a prolonged aPTT, a normal PT, and normal platelet levels, indicating an intrinsic pathway disruption."
        locator "https://www.ncbi.nlm.nih.gov/books/NBK560792/"
        trust authoritative

    % --- Von Willebrand disease ------------------------------------------
    relate factor_deficiency(von_willebrand_disease, von_willebrand_factor)
        source "Von Willebrand disease is a bleeding disorder caused by the qualitative or quantitative deficiency of the pro-von Willebrand factor."
        locator "https://www.ncbi.nlm.nih.gov/books/NBK459222/"
        trust authoritative
    relate coag_inheritance(von_willebrand_disease, autosomal_dominant)
        source "Type 1: This is an autosomal dominant disease (AD, incomplete penetrance approximately 60%) and is caused by a partial quantitative deficiency of von Willebrand factor."
        locator "https://www.ncbi.nlm.nih.gov/books/NBK459222/"
        trust authoritative
    relate prolonged_test(von_willebrand_disease, bleeding_time)
        source "Lab findings include decreased vWF, normal platelet count, increased bleeding time, normal prothrombin time, and normal or decreased factor VIII corresponding with normal or increased partial thromboplastin time, depending on which domain is affected."
        locator "https://www.ncbi.nlm.nih.gov/books/NBK559062/"
        trust authoritative

    % --- Factor VII deficiency -------------------------------------------
    relate factor_deficiency(factor_vii_deficiency, factor_vii)
        source "Factor VII deficiency is a deficiency of coagulation factor VII of the extrinsic pathway."
        trust consensus   % [FLAG: direction_only]
    relate coag_inheritance(factor_vii_deficiency, autosomal_recessive)
        source "Inherited Factor VII deficiency is the most common among rare autosomal recessive bleeding disorders."
        locator "https://pmc.ncbi.nlm.nih.gov/articles/PMC5406770/"
        trust authoritative
    relate prolonged_test(factor_vii_deficiency, pt)
        source "Inherited deficiency of factor VII is a rare bleeding disorder characterized by a prolonged PT and a normal aPTT."
        locator "https://www.ncbi.nlm.nih.gov/books/NBK265/"
        trust authoritative

    % --- Hemophilia C (factor XI deficiency) -----------------------------
    relate factor_deficiency(hemophilia_c, factor_xi)
        source "There is hemophilia C as well, which occurs due to deficiency of clotting factor XI but is rare."
        locator "https://www.ncbi.nlm.nih.gov/books/NBK551607/"
        trust authoritative
    relate coag_inheritance(hemophilia_c, autosomal_recessive)
        source "Hereditary FXI deficiency (also known as hemophilia C) was first described as a hemophilia-like syndrome by Rosenthal et al. ... It is inherited as an autosomal recessive trait that may arise because of a wide range of mutations, including missense, nonsense, splice-site, insertion, and deletion mutations, within the F11 gene."
        locator "https://pmc.ncbi.nlm.nih.gov/articles/PMC3190010/"
        trust authoritative
    relate prolonged_test(hemophilia_c, aptt)
        source "Factor XI deficiency may prolong the aPTT, though a normal aPTT does not exclude mild deficiency and can result in false negative results. Typically, the aPTT becomes prolonged when the factor XI level is significantly reduced to the range of < 15%."
        locator "https://pmc.ncbi.nlm.nih.gov/articles/PMC7153668/"
        trust authoritative
}
