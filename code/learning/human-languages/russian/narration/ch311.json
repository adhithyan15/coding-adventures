      "id": "RU-C311-prazdnovat",
      "sequence": 18450,
      "title": "праздновать (prázdnovat) — to celebrate",
      "headword": "праздновать",
      "romanization": "prázdnovat",
      "gloss": "to celebrate",
      "script": "cyrillic",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
