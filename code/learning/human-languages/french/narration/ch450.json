          "title": "You'll want to know: le caissier",
          "segments": [
            {
              "kind": "speech",
              "text": "le caissier — \"the cashier\"."
            },
            {
              "kind": "speech",
              "text": "Le caissier m'a rendu la monnaie. The cashier gave me my change."
            },
            {
              "kind": "speech",
              "text": "Feminine la caissière."
