    {
      "id": "ZH-W269-xian-first",
      "sequence": 20095,
      "title": "先 (xiān) — a cross and a long bar, over 儿",
      "headword": "先",
      "romanization": "xiān",
      "gloss": "先 — a short fall, a bar, a vertical and a long bar, over 儿",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:63fd1ec0f2a3bb13",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — a cross and a long bar, over 儿",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — a cross and a long bar, over 儿 and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say xiān — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *xiān* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "儿 生."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — ér, shēng",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *ér*, *shēng*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — a cross and a long bar, over 儿",
          "segments": [
            {
              "kind": "speech",
              "text": "先 (xiān)."
            },
            {
              "kind": "speech",
              "text": "Two pieces, top before bottom."
            },
            {
              "kind": "speech",
              "text": "The top piece, four strokes. A short stroke falling to the left. A short bar to the right of it. A vertical down through the bar. Then a long bar across, wider than everything above it."
            },
            {
              "kind": "speech",
              "text": "The bottom piece, 儿, two strokes, as on its own: a stroke falling to the left, then a vertical that bends to the right along the foot and hooks up."
            },
            {
              "kind": "speech",
              "text": "4 + 2 = six."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "先 (xiān), all six, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 先, all six, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many strokes in 先 (xiān)? (Six.) What sits at the foot? (儿.) Which bar is longer? (The second, across the middle.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 先 (xiān), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
