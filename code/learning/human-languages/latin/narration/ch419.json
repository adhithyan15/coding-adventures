        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: persolvō, persolvere",
          "segments": [
            {
              "kind": "speech",
              "text": "persolvō, persolvere — \"to pay in full\"."
            },
            {
              "kind": "speech",
              "text": "Tandem omne aes aliēnum persolvit. At last he paid off his whole debt."
            },
            {
              "kind": "speech",
              "text": "persolvō, persolvere, persolvī, persolūtum, per- through + solvō: to loosen the whole debt."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "persolvō is built from per- \"through, completely\" and solvō \"to loosen, to pay\" (Lewis & Short)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
