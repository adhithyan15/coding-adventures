        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: برتقال",
          "segments": [
            {
              "kind": "speech",
              "text": "برتقال — burtuqāl — \"oranges\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "برتقال (burtuqāl) is named after Portugal, whose traders are usually said to have brought the sweet orange from the east; EtymDB takes the Arabic from Greek portokali, and Turkish has portakal. It has no Arabic root."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
