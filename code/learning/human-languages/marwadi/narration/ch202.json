          "segments": [
            {
              "kind": "speech",
              "text": "मुड़णो — muṛṇo — \"to turn\"."
            },
            {
              "kind": "speech",
              "text": "आप मोड़ माथै मुड़ो। āp moṛ māthai muṛo. Turn at the bend."
            },
            {
              "kind": "speech",
              "text": "Past (he …): वो मुड़्यो, vo muṛyo."
            }
