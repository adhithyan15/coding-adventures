    {
      "id": "marshal-closures",
      "source_kind": "implementation",
      "source": "let encode value = Marshal.to_string value [Marshal.Closures]\n",
      "expected_capabilities": [],
      "expected_banned": ["Marshal.Closures"]
    },
    {
      "id": "remaining-authority-actions",
      "source_kind": "implementation",
      "source": "let server socket address = Unix.bind socket address; Unix.listen socket 4\nlet child () = Unix.fork ()\nlet export key value = Unix.putenv key value\nlet wait () = Unix.sleep 1\n",
      "expected_capabilities": ["env:write:*", "net:listen:*", "proc:fork:*", "time:sleep:*"],
      "expected_banned": []
