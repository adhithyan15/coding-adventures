    {
      "id": "ZH-W224-hua-flower",
      "sequence": 17315,
      "title": "花 (huā) — the grass piece over the person piece and two more strokes",
      "headword": "花",
      "romanization": "huā",
      "gloss": "花 — the grass piece, the person piece, then a short fall and a hooked bend",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:439b1f6692ef091d",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — the grass piece over the person piece and two more strokes",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — the grass piece over the person piece and two more strokes and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say kāihuā — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *kāihuā* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "菜 比."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — cài, bǐ",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *cài*, *bǐ*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — the grass piece over the person piece and two more strokes",
          "segments": [
            {
              "kind": "speech",
              "text": "花 (huā)."
            },
            {
              "kind": "speech",
              "text": "Three pieces: one on top, two side by side under it. Count the pieces, not the strokes."
            },
            {
              "kind": "speech",
              "text": "The grass piece, three strokes, as in 菜 and 茶: a bar across, then two short verticals through it."
            },
            {
              "kind": "speech",
              "text": "The person piece, 亻, two strokes, as in 你: a stroke falling to the left, then a vertical."
            },
            {
              "kind": "speech",
              "text": "The right piece, two strokes, like the right half of 比: a short stroke falling to the left, then a vertical that bends right along the foot and flicks up."
            },
            {
              "kind": "speech",
              "text": "3 + 2 + 2 = seven."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "花 (huā), all seven, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 花, all seven, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many strokes in 花 (huā)? (Seven.) What is on top? (The grass piece of 菜.) Which piece comes next? (亻, the person piece.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 花 (huā), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
