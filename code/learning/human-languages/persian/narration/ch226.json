        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: کود دادن",
          "segments": [
            {
              "kind": "speech",
              "text": "کود دادن — kud dâdan — \"to fertilise\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "kud dâdan is \"to give manure\": kud, \"manure, heap\", is a native word (EtymDB). dâdan, \"to give\", is an inherited verb; EtymDB takes it back to the Indo-European root deh₃-, \"to give\"."
            }
          ]
        },
        {
