  "lessons": [
    {
      "id": "ES-C67-uno-otro",
      "sequence": 2550,
      "title": "uno... otro — splitting a pair",
      "headword": "uno... otro",
      "romanization": "uno... otro",
      "gloss": "one... the other — a way of splitting a pair across two halves of a sentence, using a word you have carried since chapter three",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:dc6eabc7797d4ff1",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Un libro — one book. Unos libros — some books."
            },
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "speech",
              "text": "Now: two books, and you want to say something different about each."
            }
          ]
        },
        {
          "index": 1,
          "type": "etymology",
          "title": "The word, taken apart: otro",
          "segments": [
            {
              "kind": "speech",
              "text": "Otro — the other. Latin alter, which did not mean any other: it meant the other of two, the second of a pair."
            },
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "English keeps that sense in alternative and alternate — one, then the other, back and forth."
            },
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "And it takes no article. Otro libro, never un otro libro."
            }
          ]
        },
        {
          "index": 2,
          "type": "grammar",
          "title": "Grammar Lens: one at each end",
          "segments": [
            {
              "kind": "speech",
              "text": "Uno es grande, otro es bueno. — One is big, the other is good."
            },
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The pattern splits a pair across the two halves of the sentence: uno takes the first, otro takes the second. Neither needs a noun after it, because the noun was already named or is obvious."
            },
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "It agrees, like everything else: una... otra for two feminine things, unos... otros for two groups."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "Uno es grande, otro es pequeño",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *Uno es grande, otro es pequeño*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "una... otra, unos... otros",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *una... otra*, *unos... otros*]"
            },
            {
              "kind": "repeat",
              "times": 2,
              "source": "[REPEAT x2]"
            },
            {
              "kind": "activity",
              "scored": true,
              "id": "ES-C67-uno-otro-split",
              "prompt": "Two books. Say: one is big, the other is good.",
              "assesses": [
                "ES-GRAMMAR-DISTRIBUTIVE-UNO-OTRO"
              ],
              "responseSeconds": 16,
              "acceptedResponses": [
                "uno es grande otro es bueno",
                "uno es grande, otro es bueno"
              ],
              "feedback": {
                "correct": "One at each end of the sentence.",
                "incorrect": "Uno es grande, otro es bueno."
              }
            },
            {
              "kind": "activity",
              "scored": true,
              "id": "ES-C67-uno-otro-article",
              "prompt": "Is un otro libro correct?",
              "assesses": [
                "ES-LEX-OTRO"
              ],
              "responseSeconds": 12,
              "acceptedResponses": [
                "no",
                "no, otro takes no article"
              ],
              "feedback": {
                "correct": "Just otro libro.",
                "incorrect": "No -- otro never takes un."
              }
            },
            {
              "kind": "activity",
              "scored": true,
              "id": "ES-C67-uno-otro-latin",
              "prompt": "Did Latin alter mean any other, or the other of two?",
              "assesses": [
                "ES-ETYMON-OTRO-ALTER"
              ],
              "responseSeconds": 14,
              "acceptedResponses": [
                "the other of two",
                "the second of a pair"
              ],
              "feedback": {
                "correct": "Which is why it fits this pattern.",
                "incorrect": "The other of two -- as in alternate."
              }
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "What goes at the first half, and what at the second? (Uno, then otro.)"
            },
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "And does otro take an article? (No.)"
            }
          ]
        }
      ]
    }
