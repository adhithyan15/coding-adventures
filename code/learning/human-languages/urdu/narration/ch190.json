        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: وادی",
          "segments": [
            {
              "kind": "speech",
              "text": "وادی — vādī — \"a valley\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "وادی (vādī) is a loan from Arabic wādī, \"a valley, a river bed\", which reached Urdu through Persian. Its Arabic root is w-d-y (Lane)."
            }
          ]
        },
        {
