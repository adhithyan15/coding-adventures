          "segments": [
            {
              "kind": "speech",
              "text": "das Viertel — \"the neighbourhood, the quarter (of a town); a quarter\"."
            },
            {
              "kind": "speech",
              "text": "Sie wohnt in einem ruhigen Viertel am Rand der Stadt. She lives in a quiet neighbourhood on the edge of town."
            },
            {
              "kind": "speech",
              "text": "Same form in the plural. Also a quarter: ein Viertel nach drei."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Viertel is built on vier 'four' and first meant a fourth part, then a part of a town. Both are inherited Germanic words."
            }
          ]
        },
