# Perl 5.004_65 (1998-05-15) plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: unsupported Perl 5.004_65 syntax is rejected by this grammar.
# Evidence: https://mirrors.develooper.com/perl/historical-perl/perl-5.004_65.tar.gz
# Archive SHA-256: aa774928afb0b0b2402c397d1e171523e5d3be4f8e022f1a42093274d78b1b72
# Compared with 5.004_64, perly.y and keywords.h are byte-identical.
# toke.c changes only scan_const and pattern flag handling outside this subset.
# Retain the source-backed 250-digit bound for the bounded print subset.
# CR remains outside this partial accepted subset, without platform-wide parity claim.
# Unsupported characters and leading-zero forms remain refused.

PRINT     = "print"
INT       = /0|[1-9][0-9]{0,249}/
PLUS      = "+"
DECREMENT = "--"
MINUS     = "-"
STAR      = "*"
LPAREN    = "("
RPAREN    = ")"
SEMICOLON = ";"

skip:
  WHITESPACE = /[ \t\n]+/
