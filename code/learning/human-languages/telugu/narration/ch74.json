          "segments": [
            {
              "kind": "speech",
              "text": "ఎందుకు (enduku) — \"why?\"."
            },
            {
              "kind": "speech",
              "text": "Another word off the ఎ- question row you already know: ఎక్కడ \"where\", ఎవరు \"who\", and now ఎందుకు (enduku) \"why\". The row keeps its shape and you keep getting the words free."
            },
            {
              "kind": "speech",
              "text": "It goes where its answer goes, not at the front: మీరు ఎందుకు (enduku) వెళ్తారు? — \"why do you go?\""
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "The question the next word answers."
