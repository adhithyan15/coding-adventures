{
  "tests": [
    {
      "description": "simple start and end tag in data state",
      "input": "<b>Hello</b>",
      "output": [
        [
          "StartTag",
          "b",
          {}
        ],
        [
          "Character",
          "Hello"
        ],
        [
          "EndTag",
          "b"
        ]
      ]
    },
    {
      "description": "comment token surrounded by characters",
      "input": "Before<!--note-->After",
      "output": [
        [
          "Character",
          "Before"
        ],
        [
          "Comment",
          "note"
        ],
        [
          "Character",
          "After"
        ]
      ]
    },
    {
      "description": "explicit data state fixture still normalizes",
      "initialStates": [
        "Data state"
      ],
      "input": "<em>Hi</em>",
      "output": [
        [
          "StartTag",
          "em",
          {}
        ],
        [
          "Character",
          "Hi"
        ],
        [
          "EndTag",
          "em"
        ]
      ]
    },
    {
      "description": "doctype plus single attribute start tag",
      "input": "<!DOCTYPE html><p class=test>Hi</p>",
      "output": [
        [
          "DOCTYPE",
          "html",
          null,
          null,
          true
        ],
        [
          "StartTag",
          "p",
          {
            "class": "test"
          }
        ],
        [
          "Character",
          "Hi"
        ],
        [
          "EndTag",
          "p"
        ]
      ]
    },
    {
      "description": "doctype missing name force quirks",
      "input": "<!DOCTYPE>",
      "output": [
        [
          "DOCTYPE",
          null,
          null,
          null,
          false
        ]
      ],
      "errors": [
        {
          "code": "missing-doctype-name",
          "line": 1,
          "col": 10
        }
      ]
    },
    {
      "description": "doctype name eof force quirks",
      "input": "<!DOCTYPE html",
      "output": [
        [
          "DOCTYPE",
          "html",
          null,
          null,
          false
        ]
      ],
      "errors": [
        {
          "code": "eof-in-doctype",
          "line": 1,
          "col": 15
        }
      ]
    },
    {
      "description": "truncated doctype opener recovers as bogus comment at EOF",
      "input": "<!DOC",
      "output": [
        [
          "Comment",
          "DOC"
        ]
      ],
      "errors": [
        {
          "code": "incorrectly-opened-comment",
          "line": 1,
          "col": 3
        }
      ]
    },
    {
      "description": "invalid doctype opener recovers as bogus comment",
      "input": "<!DOX>",
      "output": [
        [
          "Comment",
          "DOX"
        ]
      ],
      "errors": [
        {
          "code": "incorrectly-opened-comment",
          "line": 1,
          "col": 3
        }
      ]
    },
    {
      "description": "doctype public identifier",
      "input": "<!DOCTYPE html PUBLIC \"-//IETF//DTD HTML//EN\">",
      "output": [
        [
          "DOCTYPE",
          "html",
          "-//IETF//DTD HTML//EN",
          null,
          true
        ]
      ]
    },
    {
      "description": "doctype public and system identifiers",
      "input": "<!DOCTYPE html PUBLIC '-//W3C//DTD HTML 4.01//EN' \"about:legacy-compat\">",
      "output": [
        [
          "DOCTYPE",
          "html",
          "-//W3C//DTD HTML 4.01//EN",
          "about:legacy-compat",
          true
        ]
      ]
    },
