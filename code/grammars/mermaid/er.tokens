# @version 1
#
# Mermaid 11.16.1 entity-relationship token grammar.
# Derived from packages/mermaid/src/diagrams/er/parser/erDiagram.jison.

skip:
  WHITESPACE        = /[ \t]+/
  COMMENT           = /%%[^\r\n]*/

NEWLINE             = /\r?\n/
HEADER              = /(?i:erDiagram)/
ACC_DESCR_BLOCK     = /(?i:accDescr)[ \t]*\{[^}]*\}/
ACC_TITLE           = /(?i:accTitle)[ \t]*:[^#\r\n;]*/
ACC_DESCR           = /(?i:accDescr)[ \t]*:[^#\r\n;]*/
DIRECTION_KW        = /(?i:direction)/
TITLE_KW            = /(?i:title)/
CLASSDEF_KW         = /(?i:classDef)/
CLASS_KW            = /(?i:class)/
STYLE_KW            = /(?i:style)/
DIRECTION           = /(?i:TB|BT|LR|RL)/
STYLE_SEPARATOR     = ":::"
LBRACE              = "{"
RBRACE              = "}"
LBRACKET            = "["
RBRACKET            = "]"
COMMA               = ","
COLON               = ":"
QUESTION            = "?"
ENTITY_STRING       = /"[^"%\r\n\x0B\x08\\]+"/
STRING              = /"([^"\\]|\\.)*"/
ESCAPED_ATTRIBUTE   = /`[^`\r\n]+`/
COMMA_ATTRIBUTE_TYPE = /[\p{L}_*][\p{L}\p{N}_.~*-]*\([^()\r\n]*,[^()\r\n]*\)/
ATTRIBUTE_SUFFIX    = /\([^()\r\n]*\)/
ZERO_OR_ONE         = /(?i:\|o|o\||zero[ \t]+or[ \t]+one|one[ \t]+or[ \t]+zero)/
ZERO_OR_MORE        = /(?i:o\{|\}o|0\+|many\(0\)|zero[ \t]+or[ \t]+(?:more|many)|many)/
ONE_OR_MORE         = /(?i:\|\{|\}\||1\+|many\(1\)|one[ \t]+or[ \t]+(?:more|many))/
ONLY_ONE            = /(?i:\|\||only[ \t]+one|one)/
MD_PARENT           = "u"
NON_IDENTIFYING     = /(?i:\.\.|\.\-|-\.|optionally[ \t]+to)/
IDENTIFYING         = /(?i:--|to)/
ATTRIBUTE_KEY       = /(?i:PK|FK|UK)/
NUMBER              = /[0-9]+(?:\.[0-9]+)?/
IDENTIFIER          = /[\p{L}_*][\p{L}\p{N}_.()*~-]*/
STYLE_VALUE         = /#[0-9A-Fa-f]+|[0-9]+%|;|-/
