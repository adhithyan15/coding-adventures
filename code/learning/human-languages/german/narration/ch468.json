          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "aufregen is built on auf \"up\" and regen \"to stir, to move\", which goes back to Middle High German regen \"to excite, to move\" (EtymDB)."
            }
          ]
        },
