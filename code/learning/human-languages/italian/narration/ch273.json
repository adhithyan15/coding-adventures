        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: dapprima",
          "segments": [
            {
              "kind": "speech",
              "text": "dapprima — \"at first, initially\"."
            },
            {
              "kind": "speech",
              "text": "Dapprima non ho capito niente, poi ho riso. At first I did not understand anything, then I laughed."
            },
            {
              "kind": "speech",
              "text": "A careful, written word; in speech people often say all'inizio."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "dapprima is built from da \"from\" and prima \"first, before\", which goes back to Latin prīmus \"first\" (Lewis & Short)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
