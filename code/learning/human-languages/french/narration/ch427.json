        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: la climatisation",
          "segments": [
            {
              "kind": "speech",
              "text": "la climatisation — \"the air conditioning\"."
            },
            {
              "kind": "speech",
              "text": "La climatisation fait trop de bruit la nuit. The air conditioning makes too much noise at night."
            },
            {
              "kind": "speech",
              "text": "In speech, la clim. Climatisé — air-conditioned."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "climatisation is built on climat 'climate', from Latin clima, a learned word from Greek klíma 'slope, region' (Lewis & Short). EtymDB lists it without a source."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
