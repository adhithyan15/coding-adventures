        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ಯಜಮಾನ (yajamāna) is Sanskrit yajamāna, \"the one who pays for a sacrifice\", taken over whole. The patron who paid became the master of the house."
            }
          ]
        },
