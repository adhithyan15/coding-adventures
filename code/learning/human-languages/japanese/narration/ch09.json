    },
    {
      "id": "JA-C09-ichido",
      "sequence": 540,
      "title": "いちど (ichido) — one time, all known signs",
      "headword": "いちど",
      "romanization": "ichido",
      "gloss": "one time; once",
      "script": "japanese",
      "modality": "voice",
      "derivedModality": "voice",
