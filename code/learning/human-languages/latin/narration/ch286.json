            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "Quid accidit? — Sarcinam āmīsī!",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *Quid accidit? — Sarcinam āmīsī!*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "the whole journey in four lines: a scene, then three events",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: the whole journey in four lines: a scene, then three events]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Say \"I pay the fare\". (Naulum solvō.) Say \"I have lost my pack\". (Sarcinam āmīsī.) Ask \"what happened?\" (Quid accidit?) Say \"I am making a journey\". (Iter faciō.)"
            }
          ]
        }
