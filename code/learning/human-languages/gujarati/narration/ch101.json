          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: અમુક",
          "segments": [
            {
              "kind": "speech",
              "text": "અમુક (amuk) — \"some, certain\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "અમુક (amuk) is Sanskrit amuka, \"such and such person\", taken over whole as a learned loan, a tatsama (CDIAL 568)."
            }
          ]
        },
        {
