{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coding-adventures.dev/specs/fixtures/websocket-core-v1/schema.json",
  "title": "Portable WebSocket core conformance cases",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract", "cases"],
  "properties": {
    "schema_version": { "const": 1 },
    "contract": { "const": "websocket-core-v1" },
    "cases": {
      "type": "array",
      "minItems": 25,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "hex": {
      "type": "string",
      "maxLength": 2097152,
      "pattern": "^(?:[0-9a-f]{2})*$"
    },
    "role": { "enum": ["client", "server"] },
    "opcode": {
      "enum": ["continuation", "text", "binary", "close", "ping", "pong"]
    },
    "errorCode": {
      "enum": [
        "incomplete_handshake",
        "handshake_too_large",
        "invalid_handshake",
        "header_injection",
        "invalid_base64",
        "reserved_bits",
        "invalid_opcode",
        "mask_direction",
        "non_canonical_length",
        "frame_too_large",
        "invalid_control_frame",
        "invalid_close_frame",
        "invalid_utf8",
        "invalid_fragmentation",
        "message_too_large",
        "closed_session"
      ]
    },
    "errorExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error", "diagnostic"],
      "properties": {
        "error": { "$ref": "#/$defs/errorCode" },
        "diagnostic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^websocket: [a-z0-9 -]+$"
        },
        "error_at": { "type": "integer", "minimum": 0, "maximum": 63 }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fin", "opcode", "payload_hex"],
      "properties": {
        "fin": { "type": "boolean" },
        "opcode": { "$ref": "#/$defs/opcode" },
        "payload_hex": { "$ref": "#/$defs/hex" }
      }
    },
    "event": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "text"],
          "properties": {
            "kind": { "const": "text" },
            "text": { "type": "string", "maxLength": 1048576 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "payload_hex"],
          "properties": {
            "kind": { "enum": ["binary", "ping", "pong"] },
            "payload_hex": { "$ref": "#/$defs/hex" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "code", "reason"],
          "properties": {
            "kind": { "const": "close" },
            "code": {
              "oneOf": [
                { "type": "integer", "minimum": 1000, "maximum": 4999 },
                { "type": "null" }
              ]
            },
            "reason": { "type": "string", "maxLength": 123 }
          }
        }
      ]
    },
    "acceptCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "operation", "input", "expected"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "operation": { "const": "derive_accept" },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["key"],
          "properties": { "key": { "type": "string", "maxLength": 128 } }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["accept"],
          "properties": {
            "accept": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        }
      }
    },
    "clientRequestCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "operation", "input", "expected"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "operation": { "const": "build_client_request" },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host", "target", "nonce_hex"],
          "properties": {
            "host": { "type": "string", "maxLength": 16384 },
            "target": { "type": "string", "maxLength": 16384 },
            "nonce_hex": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            }
          }
        },
        "expected": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["request", "expected_accept"],
              "properties": {
                "request": { "type": "string", "minLength": 1, "maxLength": 16384 },
                "expected_accept": { "type": "string", "minLength": 1, "maxLength": 128 }
              }
            },
            { "$ref": "#/$defs/errorExpectation" }
          ]
        }
      }
    },
    "clientResponseCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "operation", "input", "expected"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "operation": { "const": "validate_client_response" },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["response", "tail_hex", "expected_accept"],
          "properties": {
            "response": { "type": "string", "maxLength": 16384 },
            "tail_hex": { "$ref": "#/$defs/hex" },
            "expected_accept": { "type": "string", "maxLength": 128 }
          }
        },
        "expected": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["consumed"],
              "properties": {
                "consumed": { "type": "integer", "minimum": 1, "maximum": 16384 }
              }
            },
            { "$ref": "#/$defs/errorExpectation" }
          ]
        }
      }
    },
    "serverRequestCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "operation", "input", "expected"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "operation": { "const": "accept_server_request" },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["request", "tail_hex"],
          "properties": {
            "request": { "type": "string", "maxLength": 16384 },
            "tail_hex": { "$ref": "#/$defs/hex" }
          }
        },
        "expected": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["consumed", "response"],
              "properties": {
                "consumed": { "type": "integer", "minimum": 1, "maximum": 16384 },
                "response": { "type": "string", "minLength": 1, "maxLength": 16384 }
              }
            },
            { "$ref": "#/$defs/errorExpectation" }
          ]
        }
      }
    },
    "encodeCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "operation", "input", "expected"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "operation": { "const": "encode_frame" },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "frame", "mask_key_hex"],
          "properties": {
            "role": { "$ref": "#/$defs/role" },
            "frame": { "$ref": "#/$defs/frame" },
            "mask_key_hex": {
              "oneOf": [
                { "type": "string", "pattern": "^[0-9a-f]{8}$" },
                { "type": "null" }
              ]
            }
          }
        },
        "expected": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["wire_hex"],
              "properties": { "wire_hex": { "$ref": "#/$defs/hex" } }
            },
            { "$ref": "#/$defs/errorExpectation" }
          ]
        }
      }
    },
    "decodeCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "operation", "input", "expected"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "operation": { "const": "decode_frames" },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "max_frame_payload", "chunks_hex"],
          "properties": {
            "role": { "$ref": "#/$defs/role" },
            "max_frame_payload": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1048576
            },
            "chunks_hex": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1024,
              "items": { "$ref": "#/$defs/hex" }
            }
          }
        },
        "expected": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["frames", "buffered_len"],
              "properties": {
                "frames": {
                  "type": "array",
                  "maxItems": 128,
                  "items": { "$ref": "#/$defs/frame" }
                },
                "buffered_len": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1048576
                }
              }
            },
            { "$ref": "#/$defs/errorExpectation" }
          ]
        }
      }
    },
    "assembleCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "operation", "input", "expected"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "operation": { "const": "assemble_messages" },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_message_payload", "frames"],
          "properties": {
            "max_message_payload": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1048576
            },
            "frames": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": { "$ref": "#/$defs/frame" }
            }
          }
        },
        "expected": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["events", "replies", "fragmented", "closed"],
              "properties": {
                "events": {
                  "type": "array",
                  "maxItems": 64,
                  "items": { "$ref": "#/$defs/event" }
                },
                "replies": {
                  "type": "array",
                  "maxItems": 64,
                  "items": {
                    "oneOf": [
                      { "$ref": "#/$defs/frame" },
                      { "type": "null" }
                    ]
                  }
                },
                "fragmented": { "type": "boolean" },
                "closed": { "type": "boolean" }
              }
            },
            { "$ref": "#/$defs/errorExpectation" }
          ]
        }
      }
    },
    "case": {
      "oneOf": [
        { "$ref": "#/$defs/acceptCase" },
        { "$ref": "#/$defs/clientRequestCase" },
        { "$ref": "#/$defs/clientResponseCase" },
        { "$ref": "#/$defs/serverRequestCase" },
        { "$ref": "#/$defs/encodeCase" },
        { "$ref": "#/$defs/decodeCase" },
        { "$ref": "#/$defs/assembleCase" }
      ]
    }
  }
}
