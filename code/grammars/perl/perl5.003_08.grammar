# Perl 5.003_08 (1996-11-19) grammar: plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: unsupported Perl 5.003_08 syntax is rejected.
# Evidence: https://github.com/Perl/perl5/blob/perl-5.003_08/perly.y
# The tagged yacc grammar adds lexical `my` scope and block forms, outside
# this narrow release pair. It retains arithmetic operator precedence,
# unary minus, and parenthesized terms used below.

program         = print_statement { print_statement } ;
print_statement = PRINT LPAREN expr RPAREN SEMICOLON ;
expr            = term { ( PLUS | MINUS ) term } ;
term            = unary { STAR unary } ;
unary           = MINUS unary | atom ;
atom            = INT | LPAREN expr RPAREN ;
