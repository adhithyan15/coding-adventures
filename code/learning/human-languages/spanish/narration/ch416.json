      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Recall the months and quedarse, to stay. The hotel dates in this chapter fall in mayo, May."
            }
          ]
        },
        {
          "index": 1,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Spanish mayo continues Latin Maius, the Roman month associated with Maia. English May preserves the same name. Keep it separate from mayor, “bigger” or “older”: their similar spelling does not make them the same word."
            }
          ]
        },
        {
          "index": 2,
          "type": "grammar",
          "title": "Grammar Lens: dates use de",
          "segments": [
            {
              "kind": "speech",
              "text": "Spanish links a day to its month with de: el quince de mayo, the fifteenth of May. A range uses del... al...: del quince al dieciocho de mayo. The month name stays lowercase."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
