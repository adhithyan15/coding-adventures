        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: a queixa",
          "segments": [
            {
              "kind": "speech",
              "text": "a queixa — \"the complaint (to the police); the grievance\"."
            },
            {
              "kind": "speech",
              "text": "Ela apresentou queixa na polícia. She reported it to the police."
            },
            {
              "kind": "speech",
              "text": "Apresentar queixa — to report something to the police, to file a complaint."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "queixa is built on queixar \"to complain\", usually traced to Vulgar Latin quassiāre, from Latin quassāre \"to shake\", on quatere (Lewis & Short); Spanish queja is a cousin (EtymDB)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
