    {
      "id": "ZH-W328-chuan-pass",
      "sequence": 25525,
      "title": "传 (chuán) — the person piece, then two bars and a turning sweep",
      "headword": "传",
      "romanization": "chuán",
      "gloss": "传 — the person piece, then two bars, a turning sweep and a dot",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:ddfc3219e1762f4d",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — the person piece, then two bars and a turning sweep",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — the person piece, then two bars and a turning sweep and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say chuánshuō — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *chuánshuō* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "代 说."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — dài, shuō",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *dài*, *shuō*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — the person piece, then two bars and a turning sweep",
          "segments": [
            {
              "kind": "speech",
              "text": "传 (chuán)."
            },
            {
              "kind": "speech",
              "text": "Two pieces, left before right."
            },
            {
              "kind": "speech",
              "text": "The left piece, 亻, two strokes, as in 代."
            },
            {
              "kind": "speech",
              "text": "The right piece, four strokes. A short bar, then a longer bar under it. Then one stroke that starts above the bars, runs down through them, turns right, and sweeps down to the left. Last, a dot at the foot."
            },
            {
              "kind": "speech",
              "text": "2 + 4 = six."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "传 (chuán), all six, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 传, all six, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many strokes in 传 (chuán)? (Six.) What is the left piece? (亻.) What comes last? (A dot at the foot.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 传 (chuán), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
