              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *viḷāsa*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "viḷāsa, once more",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *viḷāsa*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "ask nimma viḷāsa ēnu?",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: ask *nimma viḷāsa ēnu?*]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say the Kannada for the neighbours, then the Kannada for uncle, then say viḷāsa again",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say the Kannada for the neighbours, then the Kannada for uncle, then say *viḷāsa* again]"
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What does ವಿಳಾಸ (viḷāsa) mean? (\"Address\".) Say it once more."
            }
          ]
        }
      ]
    },
