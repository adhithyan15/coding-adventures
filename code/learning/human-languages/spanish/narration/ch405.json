    {
      "id": "ES-C405-permitir",
      "sequence": 9080,
      "title": "permitir — let something pass through",
      "headword": "permitir",
      "romanization": "permitir",
      "gloss": "to permit or allow — from Latin permittere, to let through",
      "script": "latin",
      "modality": "voice",
