    {
      "id": "ZH-W306-jing-pass",
      "sequence": 23835,
      "title": "经 (jīng) — the silk piece, then a fork over 工",
      "headword": "经",
      "romanization": "jīng",
      "gloss": "经 — the silk piece of 给, then a fork over 工",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:33c2953e74bd93b5",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — the silk piece, then a fork over 工",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — the silk piece, then a fork over 工 and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say jīngguò — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *jīngguò* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "给 工."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — gěi, gōng",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *gěi*, *gōng*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — the silk piece, then a fork over 工",
          "segments": [
            {
              "kind": "speech",
              "text": "经 (jīng)."
            },
            {
              "kind": "speech",
              "text": "Three pieces: the silk piece on the left; on the right a fork over 工. Count the pieces, not the strokes."
            },
            {
              "kind": "speech",
              "text": "The silk piece, three strokes. As on the left of 给: two strokes that each drop to the left and turn to the right, then a stroke rising to the right."
            },
            {
              "kind": "speech",
              "text": "The fork, two strokes. A bar that turns into a sweep down to the lower left, then a short stroke falling to the right."
            },
            {
              "kind": "speech",
              "text": "工, three strokes: a short bar, a vertical, and a long bar across the foot."
            },
            {
              "kind": "speech",
              "text": "3 + 2 + 3 = eight."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "经 (jīng), all eight, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 经, all eight, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many pieces in 经 (jīng)? (Three.) Where have you made the left piece? (On the left of 给.) What sits at the foot of the right side? (工.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 经 (jīng), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
