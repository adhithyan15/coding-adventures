      "title": "आयो, आई, आया — came",
      "headword": "आयो · आई · आया",
      "romanization": "āyo · āī · āyā",
      "gloss": "came: the past of आवणो, agreeing with whoever came",
      "script": "devanagari",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:cb4957a09228082d",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Say everyone went home. Then to come, आवणो, and he comes every day."
            }
          ]
        },
        {
          "index": 1,
          "type": "grammar",
          "title": "Grammar Lens: the past of आवणो",
          "segments": [
            {
              "kind": "speech",
              "text": "आयो, आई and आया do for आवणो what गयो, गई and गया do for जाणो:"
            },
            {
              "kind": "speech",
              "text": "राम काल आयो। rām kāl āyo. — Ram came yesterday."
            },
            {
              "kind": "speech",
              "text": "मां दिनूगै आई। mā̃ dinūgai āī. — Mother came early in the morning."
            },
            {
              "kind": "speech",
              "text": "सगळा आथण आया। sagḷā āthaṇ āyā. — Everyone came in the evening."
            },
            {
              "kind": "speech",
              "text": "CDIAL lists Old Marwari āīyo, \"he came\" (CDIAL 1045)."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
