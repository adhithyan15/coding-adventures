    {
      "id": "ZH-W189-hao-number",
      "sequence": 15055,
      "title": "号 (hào) — 口 on top, then a bar and a hook",
      "headword": "号",
      "romanization": "hào",
      "gloss": "号 — 口, then a long bar and a turning hook",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:44412d91c631e3f6",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — 口 on top, then a bar and a hook",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — 口 on top, then a bar and a hook and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say hào — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *hào* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "月 口."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — yuè, kǒu",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *yuè*, *kǒu*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — 口 on top, then a bar and a hook",
          "segments": [
            {
              "kind": "speech",
              "text": "号 (hào)."
            },
            {
              "kind": "speech",
              "text": "Two pieces, top before bottom."
            },
            {
              "kind": "speech",
              "text": "The top piece, 口, three strokes, the same three as in 叫 and 吃: a short vertical, a stroke that runs right and turns down, then the bar that closes the foot."
            },
            {
              "kind": "speech",
              "text": "The bottom piece, two strokes. A long bar across the middle, wider than 口. Then, from under the bar, a short stroke down that turns right, turns down again and hooks to the left at its foot."
            },
            {
              "kind": "speech",
              "text": "3 + 2 = five."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "号 (hào), all five, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 号, all five, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many strokes in 号 (hào)? (Five.) Which piece comes first? (口, on top.) Where does the last stroke hook? (To the left, at its foot.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 号 (hào), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
