              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "Quaesō, dīc mihi: quā viā ad nāvem?",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *Quaesō, dīc mihi: quā viā ad nāvem?*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "the answer — Rēctā viā ī; deinde ad dextram.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: the answer — *Rēctā viā ī; deinde ad dextram.*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "Naulum solvō; deinde in nāvem ascendō.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
