    {
      "id": "TE-C56-box",
      "sequence": 1670,
      "title": "పెట్టె (peṭṭe) — a box",
      "headword": "పెట్టె",
      "romanization": "peṭṭe",
      "gloss": "a box",
      "script": "telugu",
      "modality": "voice",
