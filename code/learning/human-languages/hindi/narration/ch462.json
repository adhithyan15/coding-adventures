        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Hindi for to blush, then the Hindi for brazen."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: अभिमान",
          "segments": [
            {
              "kind": "speech",
              "text": "अभिमान — abhimān — \"self-esteem; pride\"."
            },
            {
              "kind": "speech",
              "text": "अरुण को अपने काम पर अभिमान है। Aruṇ ko apne kām par abhimān hai. Arun takes pride in his work."
            },
            {
              "kind": "speech",
              "text": "Masculine."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "अभिमान (abhimān) is a tatsama, borrowed from Sanskrit abhimāna, \"a high opinion of oneself, pride\" (Monier-Williams). It can be honest pride or vanity: the sentence decides."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for describing what you lived and felt."
            }
          ]
        },
        {
          "index": 4,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
