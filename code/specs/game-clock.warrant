-- GC01 -- Game Clock: Deterministic Integer-Nanosecond Fixed-Timestep Accumulator & Frame Pacer (GAME10).
--
-- Warrant document for game-clock (VER04j and VER04m: state=explicit).
-- Formal verification contract for the pure deterministic game loop clock.

warrant game_clock v1
  error ClockError = ZeroFixedTimestep | InvalidMaxFrameSteps | InvalidMaxFrameDelta | CorruptedStateInvariant | TimestampOverflow

  model Unit = Bool

  record GameClockConfig(fixed_dt_ns: U64, max_frame_steps: U32, max_frame_delta_ns: U64)

  record GameClockState(tick_count: U64, frame_count: U64, elapsed_sim_ns: U64, elapsed_wall_ns: U64, accumulator_ns: U64, fixed_dt_ns: U64, max_frame_steps: U32, max_frame_delta_ns: U64, total_dropped_ns: U64, spiral_clamped_frames: U64)

  record ClockStepResult(state: GameClockState, steps_to_run: U32, alpha_milli: U32, alpha_q16: U32, spiral_of_death_clamped: Bool, dropped_ns: U64)

  op new_clock(config: GameClockConfig) -> Result<GameClockState, ClockError>
  op validate_state(state: GameClockState) -> Result<Unit, ClockError>
  op advance_frame(state: GameClockState, raw_frame_delta_ns: U64) -> Result<ClockStepResult, ClockError>

  assume platform:
    none
  assume environment:
    none

  labels new_clock:
    config public
  labels validate_state:
    state public
  labels advance_frame:
    state public
    raw_frame_delta_ns public

  input new_clock.config:
    hostile
    ensures no_panic, terminates

  input validate_state.state:
    hostile
    ensures no_panic, terminates

  input advance_frame.state:
    hostile
    ensures no_panic, terminates
  input advance_frame.raw_frame_delta_ns:
    hostile
    ensures no_panic, terminates

  bound new_clock:
    steps <= 32
    heap <= 0

  bound validate_state:
    steps <= 32
    heap <= 0

  bound advance_frame:
    steps <= 64
    heap <= 0

  -- State Invariant (VER04m)
  model state_inv(s: GameClockState) -> Bool = s.fixed_dt_ns > 0u64 and s.fixed_dt_ns <= 10000000000u64 and s.max_frame_steps > 0u32 and s.max_frame_steps <= 1024u32 and s.max_frame_delta_ns >= s.fixed_dt_ns and s.max_frame_delta_ns <= 10000000000u64 and s.accumulator_ns < s.fixed_dt_ns

  claim new_clock_satisfies_invariant:
    forall c: GameClockConfig. match new_clock(c) with Ok(s) -> state_inv(s) | Err(_) -> true

  claim advance_frame_bounds_steps:
    forall s: GameClockState, dt: U64. match advance_frame(s, dt) with Ok(r) -> r.steps_to_run <= s.max_frame_steps and state_inv(r.state) and r.alpha_milli < 1000u32 | Err(_) -> true

  claim advance_frame_preserves_invariant:
    forall s: GameClockState, dt: U64. if state_inv(s) then (match advance_frame(s, dt) with Ok(r) -> state_inv(r.state) | Err(_) -> true) else true
