        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: a motorizada",
          "segments": [
            {
              "kind": "speech",
              "text": "a motorizada — \"the moped\"."
            },
            {
              "kind": "speech",
              "text": "O meu avô ia para o trabalho de motorizada. My grandfather used to go to work by moped."
            },
            {
              "kind": "speech",
              "text": "A mota is a bigger motorbike. In Brazil: a mobilete."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "motorizada is built on motor 'engine', a learned borrowing from Latin mōtor 'mover', from movēre 'to move' (Lewis & Short)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
