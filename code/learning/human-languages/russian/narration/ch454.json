        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: распродажа",
          "segments": [
            {
              "kind": "speech",
              "text": "распродажа (rasprodázha) — \"a sale (clearance)\"."
            },
            {
              "kind": "speech",
              "text": "В январе во всех магазинах распродажа. V yanvaré vo vsekh magazínakh rasprodázha. In January there is a sale in all the shops."
            },
            {
              "kind": "speech",
              "text": "Feminine. На распродаже — in the sale."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "распродажа (rasprodázha) is built from рас- 'off, all over' and продажа 'a sale', from продать 'to sell', on дать 'to give'. EtymDB lists продажа without a deeper source."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
