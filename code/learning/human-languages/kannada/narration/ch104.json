          "segments": [
            {
              "kind": "speech",
              "text": "ವ್ಯಾಪಾರ (vyāpāra) — \"business, trade\"."
            },
            {
              "kind": "speech",
              "text": "ನನ್ನದು ವ್ಯಾಪಾರ (nannadu vyāpāra) — \"mine is business\", an answer to ನಿಮ್ಮ ಉದ್ಯೋಗ ಏನು?"
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ವ್ಯಾಪಾರ (vyāpāra) is Sanskrit vyāpāra, \"occupation, business\", taken over whole as a learned loan, a tatsama (CDIAL 12205)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One answer to what do you do."
            }
          ]
        },
        {
