# Perl 5.004_05-MT9 (1999-04-26) plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: unsupported Perl 5.004_05-MT9 syntax is rejected.
# Evidence: https://mirrors.develooper.com/perl/historical-perl/perl-5.004_05-MT9.tar.gz
# Archive SHA-256: 29ab6b9332ee4021c0736fafd6340e19f6da6c24c4054208e7c4fa7e943296e9
# Its perly.y and toke.c match the MT6 source blobs.
# scan_num matches 5.004_04-m4, including its 250-digit decimal bound.
# Unsupported characters, carriage returns, and leading-zero forms remain refused.

PRINT     = "print"
INT       = /0|[1-9][0-9]{0,249}/
PLUS      = "+"
DECREMENT = "--"
MINUS     = "-"
STAR      = "*"
LPAREN    = "("
RPAREN    = ")"
SEMICOLON = ";"

skip:
  WHITESPACE = /[ \t\n]+/
