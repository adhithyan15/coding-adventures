          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "échapper comes from Old French eschaper (EtymDB), usually traced to Vulgar Latin excappāre \"to slip out of one's cloak\", built on cappa \"a cloak\"."
            }
          ]
        },
