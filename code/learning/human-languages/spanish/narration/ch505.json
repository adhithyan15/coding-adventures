        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: la educación",
          "segments": [
            {
              "kind": "speech",
              "text": "la educación — \"education; manners\"."
            },
            {
              "kind": "speech",
              "text": "La educación es gratuita. Education is free."
            },
            {
              "kind": "speech",
              "text": "Tener buena educación — to have good manners."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "educación from Latin educatio, \"a bringing up\" (EtymDB 2.1), from educare, \"to rear\" — a learned word. Manners are part of a good upbringing."
            }
          ]
        },
        {
          "index": 3,
