{
  "name": "@coding-adventures/wasm-opcodes",
  "version": "0.1.0",
  "description": "Complete WASM 1.0 opcode table with metadata (name, immediates, stack effects, category)",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc",
    "test": "node node_modules/typescript/bin/tsc -p tsconfig.test.json && node --test dist-test/tests/wasm-opcodes.test.js",
    "test:coverage": "node node_modules/typescript/bin/tsc -p tsconfig.test.json && node --experimental-test-coverage --test-coverage-lines=80 --test dist-test/tests/wasm-opcodes.test.js"
  },
  "author": "Adhithya Rajasekaran",
  "license": "MIT",
  "dependencies": {
    "@coding-adventures/wasm-types": "file:../wasm-types"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.0.0"
  }
}
