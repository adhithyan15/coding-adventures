          "segments": [
            {
              "kind": "speech",
              "text": "o mergulho — \"dive; (quick) swim\"."
            },
            {
              "kind": "speech",
              "text": "Demos um mergulho no mar antes do almoço. We had a quick swim in the sea before lunch."
            },
            {
              "kind": "speech",
              "text": "Dar um mergulho — to have a dip."
            }
