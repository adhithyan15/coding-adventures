# Perl 5.003_10 (1996-11-29) tokens: plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: this does not lex all Perl 5.003_10 source.
# Evidence: https://github.com/Perl/perl5/blob/perl-5.003_10/toke.c
# The tagged tokenizer changes sigil spacing and some built-in/identifier
# decisions outside this bounded subset. Leading-zero multi-digit literals
# remain refused rather than assigned invented decimal semantics.

PRINT     = "print"
INT       = /0|[1-9][0-9]*/
PLUS      = "+"
DECREMENT = "--"
MINUS     = "-"
STAR      = "*"
LPAREN    = "("
RPAREN    = ")"
SEMICOLON = ";"

skip:
  WHITESPACE = /[ \t\r\n]+/
