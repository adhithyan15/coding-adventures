        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: verlieben",
          "segments": [
            {
              "kind": "speech",
              "text": "verlieben — \"to fall in love (sich verlieben)\"."
            },
            {
              "kind": "speech",
              "text": "Im Sommer hat sie sich in ihren Tanzlehrer verliebt. In the summer she fell in love with her dance teacher."
            },
            {
              "kind": "speech",
              "text": "Reflexive: sich verlieben in + accusative. Verliebt sein — to be in love."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "verlieben is built on ver- and lieben \"to love\" (EtymDB lists both), a Germanic verb related to lieb \"dear\", from Proto-Germanic leubaz."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
