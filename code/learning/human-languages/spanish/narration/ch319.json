              "instruction": "all five — algo, alguien, nadie, otro, poco",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: all five — *algo*, *alguien*, *nadie*, *otro*, *poco*]"
