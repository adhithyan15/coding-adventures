        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: congregarse",
          "segments": [
            {
              "kind": "speech",
              "text": "congregarse — \"to gather, to assemble\"."
            },
            {
              "kind": "speech",
              "text": "Cientos de personas se congregaron en la plaza. Hundreds of people gathered in the square."
            },
            {
              "kind": "speech",
              "text": "It takes gu before e: se congreguen. Common in the news."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "congregarse is a learned borrowing from Latin congregāre 'to gather into a flock, to assemble' (Lewis & Short), built on grex, gregis 'a flock'."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
