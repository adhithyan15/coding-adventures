  model m_wrap_i16_i32(a: I16) -> I32 = wrap<I32>(a)
  model m_try_i16_i32(a: I16) -> I32 = unwrap_or(try<I32>(a), 0i32)
  model m_wrap_i32_i32(a: I32) -> I32 = wrap<I32>(a)
