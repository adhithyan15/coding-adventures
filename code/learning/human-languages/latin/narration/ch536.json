        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: blandus, blanda, blandum",
          "segments": [
            {
              "kind": "speech",
              "text": "blandus, blanda, blandum — \"coaxing, flattering; charming\"."
            },
            {
              "kind": "speech",
              "text": "Fēlēs blanda ad dominam venit. The coaxing cat comes to her mistress."
            },
            {
              "kind": "speech",
              "text": "Soft and winning words, true or false. English bland, whose meaning has drifted."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "blandus is a native Latin adjective; Lewis & Short suggests a link with mollis \"soft\" and English mild, but the origin is not settled. English bland comes from it."
            }
          ]
        },
        {
          "index": 3,
