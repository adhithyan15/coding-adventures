      "id": "TE-C530-viyyankudu",
      "sequence": 26840,
      "title": "వియ్యంకుడు (viyyaṅkuḍu) — a co-father-in-law; one's child's father-in-law",
      "headword": "వియ్యంకుడు",
      "romanization": "viyyaṅkuḍu",
      "gloss": "a co-father-in-law; one's child's father-in-law",
      "script": "telugu",
      "modality": "voice",
      "derivedModality": "voice",
