          "index": 1,
          "type": "input",
          "title": "You'll want to know: سبب",
          "segments": [
            {
              "kind": "speech",
              "text": "سبب — sabab — \"a cause\"."
            },
            {
              "kind": "speech",
              "text": "اس حادثے کا سبب کیا تھا؟ is hādse kā sabab kyā thā? What was the cause of this accident?"
            },
            {
              "kind": "speech",
              "text": "Masculine."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "سبب (sabab) is usually traced, through Persian, to Arabic sabab, \"a cause, a means\"."
            }
          ]
        },
