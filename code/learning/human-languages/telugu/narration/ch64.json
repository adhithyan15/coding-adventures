    {
      "id": "TE-C64-also",
      "sequence": 2030,
      "title": "కూడా (kūḍā) — also",
      "headword": "కూడా",
      "romanization": "kūḍā",
      "gloss": "also",
      "script": "telugu",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
