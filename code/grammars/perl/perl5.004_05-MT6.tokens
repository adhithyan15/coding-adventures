# Perl 5.004_05-MT6 (1998-10-09) plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: unsupported Perl 5.004_05-MT6 syntax is rejected.
# Evidence: https://mirrors.develooper.com/perl/historical-perl/perl-5.004_05-MT6.tar.gz
# Archive SHA-256: 34a6a5e8ddaa5cf800729e5319ba65fba66b57697612507ed42e368576e34d9f
# MT6 adjusts filter cleanup and format-line CR handling outside this subset.
# scan_num matches 5.004_04-m4, including its 250-digit decimal bound.
# Unsupported characters, carriage returns, and leading-zero forms remain refused.

PRINT     = "print"
INT       = /0|[1-9][0-9]{0,249}/
PLUS      = "+"
DECREMENT = "--"
MINUS     = "-"
STAR      = "*"
LPAREN    = "("
RPAREN    = ")"
SEMICOLON = ";"

skip:
  WHITESPACE = /[ \t\n]+/
