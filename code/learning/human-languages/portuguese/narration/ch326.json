          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "lenda comes down from Old Portuguese leenda (EtymDB), from Medieval Latin legenda \"things to be read\", from legere \"to read\"."
            }
          ]
        },
        {
