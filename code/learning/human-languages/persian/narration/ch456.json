          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "simkârt was borrowed from English SIM card. It is spelled like native sim 'wire', which EtymDB traces to Middle Persian, and kârt 'card', from French carte."
            }
          ]
        },
