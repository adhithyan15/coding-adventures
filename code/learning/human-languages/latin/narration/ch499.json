          "segments": [
            {
              "kind": "speech",
              "text": "voluptās, voluptātis — \"pleasure, enjoyment\"."
            },
            {
              "kind": "speech",
              "text": "Sapiēns nōn voluptātem, sed virtūtem quaerit. The wise man seeks not pleasure but virtue."
            },
            {
              "kind": "speech",
              "text": "Feminine, third declension. Pleasure of every kind, of the senses and of the mind. English voluptuous."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "voluptās is built on the old adverb volup \"pleasantly\" (EtymDB), heard in the phrase volup est \"it is a pleasure\"; Lewis & Short compares Greek elpo \"to hope\" instead. English voluptuous comes from it."
            }
          ]
        },
