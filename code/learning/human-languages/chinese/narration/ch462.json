              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Mandarin for treasured, then the Mandarin for to look forward to."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: jīngxǐ",
          "segments": [
            {
              "kind": "speech",
              "text": "jīngxǐ — \"pleasant surprise\"."
            },
            {
              "kind": "speech",
              "text": "zhè shì wǒ jīnnián zuì dà de jīngxǐ — This is the biggest surprise I've had all year."
            },
            {
              "kind": "speech",
              "text": "Its characters come later; for now it is a word for the ear."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "jīngxǐ is built from jīng 'to startle' and 喜 'joy', both inherited from Middle Chinese, kjaeng and xiX (Guangyun, in Baxter's transcription), which glosses the first 'fear' and, after an older book, a startled horse, and the second 'joy'."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for saying how it was."
            }
          ]
        },
