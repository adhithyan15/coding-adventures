          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: gnārus, gnāra, gnārum",
          "segments": [
            {
              "kind": "speech",
              "text": "gnārus, gnāra, gnārum — \"knowing, familiar with, expert in\"."
            },
            {
              "kind": "speech",
              "text": "Pastor regiōnis gnārus est et viam scit. The shepherd knows the region well and knows the way."
            },
            {
              "kind": "speech",
              "text": "An adjective of three endings, with a genitive: locōrum gnārus, who knows the places. The opposite is ignārus."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "gnārus is inherited and comes from the same root as (g)nōscō 'to get to know' and nārrō 'to tell' (Lewis & Short), from PIE ǵneh₃- 'to know'. English know is a distant cousin."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
