          "segments": [
            {
              "kind": "speech",
              "text": "Verband is built on verbinden \"to bind up, to bandage\", from binden \"to bind\", inherited from Old High German bintan, from Proto-Germanic bindaną (EtymDB)."
            }
          ]
        },
