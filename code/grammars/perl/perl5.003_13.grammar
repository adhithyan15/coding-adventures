# Perl 5.003_13 (1996-12-20) grammar: plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: unsupported Perl 5.003_13 syntax is rejected.
# Evidence: https://github.com/Perl/perl5/blob/perl-5.003_13/perly.y
# The tagged yacc is unchanged from 5.003_12; this separate file remains
# deliberately limited to arithmetic precedence, parentheses and print.

program         = print_statement { print_statement } ;
print_statement = PRINT LPAREN expr RPAREN SEMICOLON ;
expr            = term { ( PLUS | MINUS ) term } ;
term            = unary { STAR unary } ;
unary           = MINUS unary | atom ;
atom            = INT | LPAREN expr RPAREN ;
