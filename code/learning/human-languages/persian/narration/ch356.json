          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "charkh \"wheel\" is inherited: EtymDB traces it through Middle Persian to the Indo-European word for a wheel, kʷékʷlos. kardan \"to do\" is inherited too."
            }
          ]
        },
