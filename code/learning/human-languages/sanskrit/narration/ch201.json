      "id": "SA-C201-yojana",
      "sequence": 11370,
      "title": "योजना (yojanā) — a plan, a scheme",
      "headword": "योजना",
      "romanization": "yojanā",
      "gloss": "a plan, a scheme",
      "script": "devanagari",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:715478bf731aff6f",
      "notice": null,
      "blocks": [
        {
          "index": 0,
