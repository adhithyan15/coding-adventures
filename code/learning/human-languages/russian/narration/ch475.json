        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: восторг",
          "segments": [
            {
              "kind": "speech",
              "text": "восторг (vostórg) — \"delight, rapture\"."
            },
            {
              "kind": "speech",
              "text": "Дети были в восторге от цирка. Déti býli v vostórge ot tsírka. The children were delighted with the circus."
            },
            {
              "kind": "speech",
              "text": "Masculine. Быть в восторге от + genitive — to be thrilled with."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "восторг (vostórg) is built on вос- 'up' and a root usually linked to the one in исторгнуть 'to tear out', so rapture is being carried away; EtymDB has no entry, so the link is not settled."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
