            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Arabic for a car, then the Arabic for a bus."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: قطار",
          "segments": [
            {
              "kind": "speech",
              "text": "قطار — qiṭār — \"a train\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "قطار (qiṭār) is filed under the native Arabic root q-ṭ-r, \"to drip, to fall in drops\" (Lane). Lane's qiṭār is a string of camels led one behind another; the train is the modern sense."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for this chapter."
