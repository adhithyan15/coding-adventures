EE5D\U0001EE5F\U0001EE61\U0001EE62\U0001EE64\U0001EE67-\U0001EE6A\U0001EE6C-\U0001EE72\U0001EE74-\U0001EE77\U0001EE79-\U0001EE7C\U0001EE7E\U0001EE80-\U0001EE89\U0001EE8B-\U0001EE9B\U0001EEA1-\U0001EEA3\U0001EEA5-\U0001EEA9\U0001EEAB-\U0001EEBB\U0001FBF0-\U0001FBF9\U00020000-\U0002A6DF\U0002A700-\U0002B81D\U0002B820-\U0002CEAD\U0002CEB0-\U0002EBE0\U0002EBF0-\U0002EE5D\U0002F800-\U0002FA1D\U00030000-\U0003134A\U00031350-\U00033479\U000E0100-\U000E01EF]*)?/
# PUNCTUATION. One character is one token: the grammar composes
# `>>`, `->`, `::` and the rest from adjacent tokens with F11
# adjacency predicates, exactly `proc_macro`'s Joint and Alone.
SEMI = ";"
COMMA = ","
DOT = "."
LPAREN = "("
RPAREN = ")"
LBRACE = "{"
RBRACE = "}"
LBRACKET = "["
RBRACKET = "]"
AT = "@"
POUND = "#"
TILDE = "~"
QUESTION = "?"
COLON = ":"
DOLLAR = "$"
EQ = "="
BANG = "!"
LT = "<"
GT = ">"
MINUS = "-"
AMP = "&"
PIPE = "|"
PLUS = "+"
STAR = "*"
CARET = "^"
PERCENT = "%"
SLASH = "/"

keywords:
  # Used and reserved words, one list: every one is valid inside a token tree,
  # so none is a lexer error (RS01 section 4.2, case 12). Only NAME is promoted;
  # a RAW_IDENT such as `r#match` is not.
  Self
  as
  async
  await
  break
  const
  continue
  crate
  dyn
  else
  enum
  extern
  false
  fn
  for
  if
  impl
  in
  let
  loop
  match
  mod
  move
  mut
  pub
  ref
  return
  self
  static
  struct
  super
  trait
  true
  type
  unsafe
  use
  where
  while
  abstract
  become
  box
  do
  final
  macro
  override
  priv
  try
  typeof
  unsized
  virtual
  yield

soft_keywords:
  # Words that mean something only in some positions. The lexer ignores
  # them (they stay NAME); the parser decides. `dyn` is one only in 2015.
  auto
  default
  macro_rules
  raw
  safe
  union

# Inside a plain block comment. These patterns are EXCLUSIVE (the
# group is a nested region), so `//` here is text, not a comment.
# `/*` nests, `*/` closes; `transitions:` push and pop the group.
group bc:
  BC_OPEN_NESTED = "/*" -> BC_OPEN
  BC_CLOSE = "*/"
  BC_TEXT = /[^*\/]+|\*|\//

# Inside a doc block comment (`/** */`, `/*! */`). Same text, but a
# nested `/*` here is REFUSED (RS01 divergence RD4): the doc
# comment's tokens are kept for the grammar, and a refusal is the
# conservative answer until the nested scanner of RS01 X1 exists.
group doc_bc:
  BC_OPEN_IN_DOC = "/*" -> BC_OPEN
  BC_CLOSE_IN_DOC = "*/" -> BC_CLOSE
  BC_TEXT_IN_DOC = /[^*\/]+|\*|\// -> BC_TEXT

# TUPLE INDEX. Right after a lone `.`, digits are an integer, so
# `x.0.1` is INT 0, DOT, INT 1 (the view `rustc`'s parser reaches by
# splitting the float `0.1`). A flat mode: it inherits every default
# pattern, and its own pattern wins.
group after_dot:
  TUPLE_INDEX = /[0-9]+/ -> INT_LIT

# After `..` (or more dots) the default patterns apply, so `0..1.5`
# ends in the float `1.5`. This mode exists only to say "not a field
# access"; it adds no pattern.
group after_dots:
  # A pattern that matches nothing: grammar-tools rejects an
  # empty group, and this mode needs no pattern of its own.
  NEVER = /[^\s\S]/

transitions:
  # First matching rule wins. A refused token stops the lexer with an error.
  # Block comments: an opener pushes the group that lexes the comment's text,
  # so the stack depth IS the nesting depth; `*/` pops it.
  on (FRONTMATTER | RAW_BAD | STR_BAD | BYTE_BAD | LIFETIME_PREFIX | RESERVED_PREFIX | BASED_FLOAT_BAD | FLOAT_BAD_EXP) -> refuse
  on (INNER_BC_OPEN | OUTER_BC_OPEN) -> push doc_bc
  on BC_OPEN in doc_bc -> refuse
  on BC_OPEN -> push bc
  on BC_CLOSE -> pop
  on RAW_IDENT="r#crate" -> refuse
  on RAW_IDENT="r#self" -> refuse
  on RAW_IDENT="r#super" -> refuse
  on RAW_IDENT="r#Self" -> refuse
  on RAW_IDENT="r#_" -> refuse
  on DOT in default -> set-mode after_dot
  on DOT in after_dot -> set-mode after_dots
  on DOT in after_dots -> set-mode after_dots
  on (OUTER_DOC | INNER_DOC | RAW_STR_LIT | RAW_BYTE_STR_LIT | RAW_C_STR_LIT | RAW_IDENT | BYTE_STR_LIT | C_STR_LIT | STR_LIT | BYTE_LIT | CHAR_LIT | RAW_LIFETIME | LIFETIME | NAME | FLOAT_LIT | INT_LIT | SEMI | COMMA | LPAREN | RPAREN | LBRACE | RBRACE | LBRACKET | RBRACKET | AT | POUND | TILDE | QUESTION | COLON | DOLLAR | EQ | BANG | LT | GT | MINUS | AMP | PIPE | PLUS | STAR | CARET | PERCENT | SLASH | NEVER | KEYWORD) in after_dot -> set-mode default
  on (OUTER_DOC | INNER_DOC | RAW_STR_LIT | RAW_BYTE_STR_LIT | RAW_C_STR_LIT | RAW_IDENT | BYTE_STR_LIT | C_STR_LIT | STR_LIT | BYTE_LIT | CHAR_LIT | RAW_LIFETIME | LIFETIME | NAME | FLOAT_LIT | INT_LIT | SEMI | COMMA | LPAREN | RPAREN | LBRACE | RBRACE | LBRACKET | RBRACKET | AT | POUND | TILDE | QUESTION | COLON | DOLLAR | EQ | BANG | LT | GT | MINUS | AMP | PIPE | PLUS | STAR | CARET | PERCENT | SLASH | NEVER | KEYWORD) in after_dots -> set-mode default
