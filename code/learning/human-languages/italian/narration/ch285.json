        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: la dichiarazione",
          "segments": [
            {
              "kind": "speech",
              "text": "la dichiarazione — \"the statement, the declaration\"."
            },
            {
              "kind": "speech",
              "text": "Il sindaco ha fatto una breve dichiarazione. The mayor made a short statement."
            },
            {
              "kind": "speech",
              "text": "Fare una dichiarazione — to make a statement."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "dichiarazione is built on dichiarare \"to declare\", inherited from Latin dēclārāre \"to make clear\" (EtymDB), from clārus \"clear\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
