          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "égout is built on égoutter 'to let drip, to drain' (EtymDB), from goutte 'drop', which goes back to Latin gutta."
            }
          ]
        },
