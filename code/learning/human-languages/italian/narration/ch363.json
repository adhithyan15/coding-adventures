        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: il cittadino",
          "segments": [
            {
              "kind": "speech",
              "text": "il cittadino — \"the citizen\"."
            },
            {
              "kind": "speech",
              "text": "Ogni cittadino può votare a diciotto anni. Every citizen can vote at eighteen."
            },
            {
              "kind": "speech",
              "text": "As an adjective it means of the city: il traffico cittadino."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "cittadino is built on città, older cittade, inherited from Latin cīvitās, cīvitātis \"citizenship, the body of citizens, a city\" (EtymDB)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
