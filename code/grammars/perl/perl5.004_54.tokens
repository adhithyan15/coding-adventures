# Perl 5.004_54 (1997-11-14) plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: unsupported Perl 5.004_54 syntax is rejected.
# Evidence: https://mirrors.develooper.com/perl/historical-perl/perl-5.004_54.tar.gz
# Archive SHA-256: 77f8b07832e8e99f53d9c18be133d7d63e4417f4370a2bf25a82ca6102a84c8d
# Its scan_num body matches 5.004_53 byte for byte, retaining the 250-digit bound.
# Thread-magical and interpolation changes do not widen this subset.
# Unsupported characters, carriage returns, and leading-zero forms remain refused.

PRINT     = "print"
INT       = /0|[1-9][0-9]{0,249}/
PLUS      = "+"
DECREMENT = "--"
MINUS     = "-"
STAR      = "*"
LPAREN    = "("
RPAREN    = ")"
SEMICOLON = ";"

skip:
  WHITESPACE = /[ \t\n]+/
