              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The line goes on past five, so the chapter opens by retrieving where it stopped."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say añcāṁ — R1",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *añcāṁ* — **R1**]"
            },
            {
              "kind": "prompt",
