    {
      "id": "KA-C47-leg",
      "sequence": 1190,
      "title": "ಕಾಲು (kālu) — leg, foot",
      "headword": "ಕಾಲು",
      "romanization": "kālu",
      "gloss": "leg, foot",
      "script": "kannada",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
