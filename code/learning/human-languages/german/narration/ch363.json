        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: der Umweltschutz",
          "segments": [
            {
              "kind": "speech",
              "text": "der Umweltschutz — \"environmental protection\"."
            },
            {
              "kind": "speech",
              "text": "Für den Umweltschutz fahren wir mit dem Fahrrad zur Arbeit. We cycle to work to protect the environment."
            },
            {
              "kind": "speech",
              "text": "No plural. Built from die Umwelt — the environment — and der Schutz — protection."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Umweltschutz joins Umwelt \"environment\", from um \"around\" and Welt \"world\", Middle High German welt (EtymDB), to Schutz \"protection\", Middle High German schuz (EtymDB). Umwelt is usually said to render Danish omverden \"the world around\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
            }
          ]
        },
