          "title": "You'll want to know: o metro",
          "segments": [
            {
              "kind": "speech",
              "text": "o metro — \"the underground\". In Brazil, o metrô."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "metro from French métro (EtymDB 2.1) — borrowed. It is short for métropolitain, built from Greek mētēr, \"mother\", and polis, \"city\"."
            }
          ]
        },
