        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: die Zutat",
          "segments": [
            {
              "kind": "speech",
              "text": "die Zutat — \"the ingredient\"."
            },
            {
              "kind": "speech",
              "text": "Für den Kuchen braucht man nur fünf Zutaten. For the cake you only need five ingredients."
            },
            {
              "kind": "speech",
              "text": "Plural: die Zutaten."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Zutat is built on zutun \"to add\", from tun \"to do, to put\", Old High German tuon (EtymDB): what is put in."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
