              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *patrakār*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "Mīrā patrakār bannā cāhtī hai. — Mira wants to become a journalist.",
              "spoken": true,
              "scored": false,
