      "paths": [
        "code/fixtures/chief-of-staff-channel/**",
        "code/scripts/validate_d18p_channel_conformance.py",
        "code/scripts/tests/test_d18p_channel_conformance.py",
        "code/packages/rust/Cargo.toml",
        "code/packages/rust/Cargo.lock"
      ]
