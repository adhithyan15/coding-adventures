        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: la sinceridad",
          "segments": [
            {
              "kind": "speech",
              "text": "la sinceridad — \"sincerity, frankness\"."
            },
            {
              "kind": "speech",
              "text": "Te lo digo con toda sinceridad. I am telling you in all honesty."
            },
            {
              "kind": "speech",
              "text": "Con sinceridad — honestly, frankly."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "sinceridad is usually described as a learned borrowing from Latin sinceritās \"purity, soundness\", built on sincērus \"genuine\", the source of sincero (EtymDB)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
