        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: der Gips",
          "segments": [
            {
              "kind": "speech",
              "text": "der Gips — \"plaster cast; plaster\"."
            },
            {
              "kind": "speech",
              "text": "Mein Arm war sechs Wochen im Gips. My arm was in plaster for six weeks."
            },
            {
              "kind": "speech",
              "text": "Einen Gips bekommen — to get a cast. Plural, rare: die Gipse."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Gips comes from Middle High German gips, from Latin gypsum, which was borrowed from Greek gýpsos \"gypsum\" (EtymDB)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
