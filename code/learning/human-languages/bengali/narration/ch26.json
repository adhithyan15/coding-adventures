          "index": 2,
          "type": "writing",
          "title": "Writing — from sound",
          "segments": [
            {
              "kind": "speech",
              "text": "Cover every model. Write I from the sound alone."
            },
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "আমি (āmi)",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: আমি]"
            }
