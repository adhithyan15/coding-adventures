              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Arabic for to play, then the Arabic for to buy."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: باع",
          "segments": [
            {
              "kind": "speech",
              "text": "باع — bāʿa — \"to sell (he sold)\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "باع (bāʿa) is built on the native Arabic root b-y-ʿ, \"to sell; to buy\" (Lane). Lane notes bāʿa could mean both \"to sell\" and \"to buy\"; selling won."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for this chapter."
            }
          ]
        },
