layout ScaledText { Column [root] { Text (content: "Default", font-size: slot: text-size) Text [title] (content: "Typography", a11y-role: heading, font-size: slot: text-size) HostButton [action] (label: "Action", font-size: slot: text-size) HostInput [field] (placeholder: "A number or formula", font-size: slot: text-size) HostTable [grid] (font-size: slot: text-size) { HostTableBody { Row { Box { Text (content: "Inherited") HostInput (value: "Editor") } } } } } }