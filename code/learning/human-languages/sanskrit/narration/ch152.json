            {
              "kind": "speech",
              "text": "Before the new one: say the Sanskrit for jealousy, then the Sanskrit for pride."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: कालः",
          "segments": [
            {
              "kind": "speech",
              "text": "कालः — kālaḥ — \"a period, time\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "kāla \"time\" is old, in the Atharvaveda, and MW derives it from the root √kal \"calculate, count\". CDIAL 3084 keeps it apart from kāla \"black\" (CDIAL 3083), and it lives on as Hindi kāl \"time, fate\" (CDIAL 3084)."
            }
          ]
        },
        {
