          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Schach came through Medieval Latin scaccus from Arabic, which took it from Persian shāh \"king\" (EtymDB): the game is named after its key piece."
            }
          ]
        },
