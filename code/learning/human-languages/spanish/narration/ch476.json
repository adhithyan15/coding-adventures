              "kind": "speech",
              "text": "comprender — \"to understand\"."
            },
            {
              "kind": "speech",
              "text": "No comprendo la pregunta. I do not understand the question."
            },
            {
              "kind": "speech",
              "text": "A close twin of entender, slightly more formal."
            }
          ]
        },
