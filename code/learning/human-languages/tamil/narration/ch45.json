      "id": "TA-C45-eye",
      "sequence": 1460,
      "title": "கண் (kaṇ) — an eye",
      "headword": "கண்",
      "romanization": "kaṇ",
      "gloss": "an eye",
      "script": "tamil",
      "modality": "voice",
      "derivedModality": "voice",
