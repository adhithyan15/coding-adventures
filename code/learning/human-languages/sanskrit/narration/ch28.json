        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: यात्रा",
          "segments": [
            {
              "kind": "speech",
              "text": "यात्रा (yātrā) — \"a journey\"."
            },
            {
              "kind": "speech",
              "text": "यात्रा (yātrā) is a journey — a going, and by long custom a going somewhere holy. Modern Indian languages kept it whole: a yatra is a pilgrimage."
            },
            {
              "kind": "speech",
              "text": "It comes from a root yā, \"to go\", which is not the root behind गच्छति. Sanskrit keeps several going-verbs apart, and this one leans toward setting out and travelling rather than the plain act of moving. Feminine, ending in -आ, like माता and नारी."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "A second going-root, and a noun made from it."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "yātrā",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *yātrā*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "it once more, slowly",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: it once more, slowly]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "gacchati, then yātrā, and say which one sounds like setting out",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *gacchati*, then *yātrā*, and say which one sounds like setting out]"
            },
