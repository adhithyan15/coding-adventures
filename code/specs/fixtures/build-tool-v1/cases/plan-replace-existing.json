          "python": false
        }
      },
      "plan": {
        "schema_version": 1,
        "diff_base": "origin/main",
        "force": true,
        "affected_packages": null,
        "packages": [
          {
            "name": "python/demo",
            "rel_path": "code/packages/python/demo",
            "language": "python",
            "build_commands": [
              "python -m pytest"
            ]
          }
        ],
        "dependency_edges": [],
        "languages_needed": {
          "python": true
        }
      }
    },
    "arguments": [],
    "environment": {},
    "changed_paths": []
  },
  "expected": {
    "schema_version": 1,
