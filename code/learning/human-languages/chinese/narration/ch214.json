        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: wèntí",
          "segments": [
            {
              "kind": "speech",
              "text": "wèntí — \"question; problem\"."
            },
            {
              "kind": "speech",
              "text": "wǒ yǒu yí ge wèntí — I've got a question."
            },
            {
              "kind": "speech",
              "text": "Its characters come later; for now it is a word for the ear."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "wèntí is built from 问 'to ask' and tí 'a heading', both inherited from Middle Chinese, mjunH and dej (Guangyun, in Baxter's transcription), which glosses the second 'the forehead' and 'the title of a book'."
            }
          ]
        },
        {
