        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "природа (priróda) is при- with род, \"birth, kin\": what one is born with, then nature itself. It copies Greek phýsis and Latin nātūra, both \"birth, nature\"."
            }
          ]
        },
