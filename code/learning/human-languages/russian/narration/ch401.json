          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Russian for to break into, then the Russian for a virus."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: приложение",
          "segments": [
            {
              "kind": "speech",
              "text": "приложение (prilozhéniye) — \"an app; an attachment; a supplement\"."
            },
            {
              "kind": "speech",
              "text": "Я скачал новое приложение. Ya skachál nóvoye prilozhéniye. I downloaded a new app."
            },
            {
              "kind": "speech",
              "text": "Neuter. An app on a phone, an attachment to a letter, or a supplement to a magazine."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "приложение (prilozhéniye) is built on приложить \"to put to, to attach\", from при- \"to\" and ложить \"to lay\": something laid alongside. An app is the newest sense."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
            }
          ]
        },
