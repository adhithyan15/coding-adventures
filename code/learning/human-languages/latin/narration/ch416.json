          "segments": [
            {
              "kind": "speech",
              "text": "coerceō, coercēre — \"to restrain, to keep in check\"."
            },
            {
              "kind": "speech",
              "text": "Cōnsul sēditiōsōs coercuit. The consul restrained the rebels."
            },
            {
              "kind": "speech",
              "text": "coerceō, coercēre, coercuī, coercitum, co- + arceō, to shut in. English coerce."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "coerceō is built from co- \"together\" and arceō \"to shut in, to keep off\" (Lewis & Short): to hem in on all sides. English coerce comes from it."
            }
          ]
        },
