# Perl 5.004_52 (1997-10-15) plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: unsupported Perl 5.004_52 syntax is rejected.
# Evidence: https://mirrors.develooper.com/perl/historical-perl/perl-5.004_52.tar.gz
# Archive SHA-256: f5edcffd4bf28db7bad95562470e37d57da65503822abb77de049b4d18cddd09
# Its perly.y matches 5.004_51; only arithmetic precedence, grouping,
# and print are represented here.

program         = print_statement { print_statement } ;
print_statement = PRINT LPAREN expr RPAREN SEMICOLON ;
expr            = term { ( PLUS | MINUS ) term } ;
term            = unary { STAR unary } ;
unary           = MINUS unary | atom ;
atom            = INT | LPAREN expr RPAREN ;
