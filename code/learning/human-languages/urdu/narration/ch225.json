          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "لفافہ (lifāfā) is a loan from Arabic lifāfa, \"a wrapper\", which reached Urdu through Persian. Its Arabic root is l-f-f (Lane)."
            }
          ]
        },
