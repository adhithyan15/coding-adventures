            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Persian for grapes, then the Persian for an orange."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: لیمو",
          "segments": [
            {
              "kind": "speech",
              "text": "لیمو — limu — \"a lemon\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "limu belongs to a word that travelled with the lemon trade; it is usually traced to an Indian source like Hindi nīmbū, \"lime\", and English lemon comes from the same word by way of Arabic laymūn. The details are not settled."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
