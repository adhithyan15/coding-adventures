        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: o coro",
          "segments": [
            {
              "kind": "speech",
              "text": "o coro — \"choir; chorus\"."
            },
            {
              "kind": "speech",
              "text": "Canto num coro há dez anos. I have sung in a choir for ten years."
            },
            {
              "kind": "speech",
              "text": "Em coro — all together."
            }
          ]
        },
