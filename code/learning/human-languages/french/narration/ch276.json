        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: l'époque",
          "segments": [
            {
              "kind": "speech",
              "text": "l'époque — \"the time, the era, the period\"."
            },
            {
              "kind": "speech",
              "text": "À l'époque, on n'avait pas de téléphone portable. Back then, people did not have mobile phones."
            },
            {
              "kind": "speech",
              "text": "À l'époque — back then; à cette époque-là — at that time."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "époque is a learned borrowing from Greek epokhḗ \"a halt, a fixed point in time\", which reached French through Medieval Latin (EtymDB lists the French word without a parent)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
