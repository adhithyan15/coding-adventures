        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: काम",
          "segments": [
            {
              "kind": "speech",
              "text": "काम — kām — \"work\"."
            },
            {
              "kind": "speech",
              "text": "हूं रोज घणो काम करूं हूं। hū̃ roj ghaṇo kām karū̃ hū̃. I do a lot of work every day."
            },
            {
              "kind": "speech",
              "text": "A masculine noun."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "काम (kām) is inherited from Sanskrit karman, \"act, work\"; CDIAL lists Marwari kām (CDIAL 2892). With करणो it is to work: काम करो."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for saying what you do."
