        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: a lua de mel",
          "segments": [
            {
              "kind": "speech",
              "text": "a lua de mel — \"the honeymoon\"."
            },
            {
              "kind": "speech",
              "text": "Passaram a lua de mel numa ilha. They spent their honeymoon on an island."
            },
            {
              "kind": "speech",
              "text": "Written without hyphens since the 1990 spelling reform."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "lua de mel joins lua \"moon\", from Latin lūna, and mel \"honey\", from Latin mel (EtymDB): the sweet first month."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
