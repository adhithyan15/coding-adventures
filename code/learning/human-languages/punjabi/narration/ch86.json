            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Punjabi for morning, then the Punjabi for a week."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ਮਹੀਨਾ",
          "segments": [
            {
              "kind": "speech",
              "text": "ਮਹੀਨਾ — mahīnā — \"a month\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ਮਹੀਨਾ (mahīnā) is a loan, usually traced to Persian māhīna, \"monthly\". It is built on Persian māh, \"moon, month\"."
            }
          ]
        },
        {
