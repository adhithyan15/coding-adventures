        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: होडी",
          "segments": [
            {
              "kind": "speech",
              "text": "होडी — hoḍī — \"a boat\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "होडी (hoḍī) is a tadbhava of Sanskrit hoḍa, \"raft, boat\", a word from the old word-lists (CDIAL 14174). CDIAL takes it from Dravidian, comparing Kannada ōḍa."
            }
          ]
        },
