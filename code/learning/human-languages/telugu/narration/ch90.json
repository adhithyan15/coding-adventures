          "segments": [
            {
              "kind": "speech",
              "text": "సెలవు (selavu) — \"leave\", both a holiday and permission to go."
            },
            {
              "kind": "speech",
              "text": "ఇవాళ సెలవు (selavu) — \"today is a holiday\". At a formal parting, సెలవు (selavu) alone asks leave to go, the way English once said \"by your leave\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "సెలవు (selavu) is native Dravidian. DEDR 2781 lists selavu, \"order, leave, permission, expense\", under cellu, \"to pass, be current\", with Tamil cel, \"to go, pass\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "A holiday, and the most formal way out of a room."
            }
          ]
        },
