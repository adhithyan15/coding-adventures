        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: l'orchestra",
          "segments": [
            {
              "kind": "speech",
              "text": "l'orchestra — \"orchestra\"."
            },
            {
              "kind": "speech",
              "text": "L'orchestra della città suona ogni venerdì. The city orchestra plays every Friday."
            },
            {
              "kind": "speech",
              "text": "Il direttore d'orchestra — the conductor."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "orchestra is a learned borrowing, through Latin, from Greek orkhḗstra \"the dancing floor of a theatre\" (EtymDB), from orkheîsthai \"to dance\"."
            }
          ]
        },
        {
