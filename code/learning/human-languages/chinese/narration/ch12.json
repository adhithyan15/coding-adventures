      "sourceHash": "fnv1a64:136bd98127c8fdb4",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Script — the shape"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now — leave the section called Script — the shape until you have stopped, and I will say so again when we reach it."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 12,
              "perItem": false,
              "source": "[PAUSE 12s]"
            },
            {
              "kind": "speech",
              "text": "Say son, then write 人 (rén)."
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — the shape",
          "segments": [
            {
              "kind": "speech",
              "text": "儿 (ér)."
            },
            {
              "kind": "speech",
              "text": "Two strokes. First a short fall down-left. Then start high on the right, descend, bend right along the floor, and hook upward without lifting. Unlike 人 (rén), the two strokes do not meet at the top."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "speech",
              "text": "Trace 儿 (ér) once. Copy it once. Point to the bend that keeps it apart from 人 (rén)."
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 儿 (ér), pinned stroke paths and medians."
            },
            {
              "kind": "activity",
              "scored": true,
              "id": "ZH-W12-er-write",
              "prompt": "Write the first character of érzi.",
              "assesses": [
                "ZH-SCRIPT-ER-CHAR-01"
              ],
              "responseSeconds": 10,
              "acceptedResponses": [
                "儿",
                "儿 ér"
              ],
              "feedback": {
                "correct": "Right: 儿, with the right stroke bending and hooking.",
                "incorrect": "First fall left; second descend, bend right, and hook."
              }
            }
          ]
        }
      ]
    },
