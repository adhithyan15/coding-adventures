          "type": "input",
          "title": "You'll want to know: fiable",
          "segments": [
            {
              "kind": "speech",
              "text": "fiable — \"reliable\"."
            },
            {
              "kind": "speech",
              "text": "Cette voiture est vieille, mais très fiable. This car is old, but very reliable."
            },
            {
              "kind": "speech",
              "text": "For people and things: une source fiable."
            }
          ]
