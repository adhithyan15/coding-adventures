            {
              "kind": "speech",
              "text": "Before the new one: say the Latin for travel money, then the Latin for to set out on."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: profectiō, profectiōnis",
          "segments": [
            {
              "kind": "speech",
              "text": "profectiō, profectiōnis — \"a departure, a setting out\"."
            },
            {
              "kind": "speech",
              "text": "Ante profectiōnem mercātor sarcinās parat. Before the departure the merchant gets his baggage ready."
            },
            {
              "kind": "speech",
              "text": "Third declension, feminine: profectiō, profectiōnis f., the noun of proficīscor 'to set out'."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "profectiō is built on proficīscor 'to set out' (Lewis & Short), through its participle profectus. EtymDB does not list it."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
