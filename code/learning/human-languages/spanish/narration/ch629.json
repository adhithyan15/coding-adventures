        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: la ganancia",
          "segments": [
            {
              "kind": "speech",
              "text": "la ganancia — \"the gain, the profit\"."
            },
            {
              "kind": "speech",
              "text": "La tienda tuvo ganancias este año. The shop made a profit this year."
            },
            {
              "kind": "speech",
              "text": "Often plural: las ganancias."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ganancia is built on ganar 'to earn, to win', which was probably borrowed from Gothic ganan 'to covet' (EtymDB)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
