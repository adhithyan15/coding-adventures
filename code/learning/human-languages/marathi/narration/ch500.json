              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *saṅgopan*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "saṅgopan, once more",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *saṅgopan*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "ājīne mājhaṁ saṅgopan kelaṁ. — My grandmother brought me up.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *ājīne mājhaṁ saṅgopan kelaṁ.* — My grandmother brought me up.]"
            },
            {
              "kind": "prompt",
