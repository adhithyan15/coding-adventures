style SpiceWorkbench {
  part workbench { background : "#151b24" ; color : "#e6edf3" ; padding : 16 ; gap : 12 ; }
  part workbench-header { align : center-vertical ; }
  part workbench-title { width : 100% ; font-size : 20 ; font-weight : bold ; color : "#f0f6fc" ; }
  part workbench-mode { background : "#223047" ; color : "#8cc8ff" ; border-radius : 4 ; padding : 5 ; }
  part deck-editor { gap : 6 ; }
  part schematic { gap : 6 ; }
  part schematic-label { font-size : 12 ; font-weight : bold ; color : "#9fb3c8" ; }
  part schematic-title { color : "#f0f6fc" ; font-weight : bold ; }
  part schematic-palette { gap : 6 ; }
  part schematic-palette-item { background : "#163743" ; color : "#a5f3fc" ; border-width : 1 ; border-color : "#2c7180" ; border-radius : 3 ; padding : 6 ; }
  part schematic-analysis-label { font-size : 12 ; font-weight : bold ; color : "#9fb3c8" ; }
  part schematic-analysis-controls { gap : 6 ; }
  part schematic-analysis-control { background : "#362d4e" ; color : "#ddd6fe" ; border-width : 1 ; border-color : "#7c5cbf" ; border-radius : 3 ; padding : 6 ; }
  part schematic-analysis-card-label { font-size : 12 ; font-weight : bold ; color : "#9fb3c8" ; }
  part schematic-analysis-cards { gap : 6 ; }
  part schematic-analysis-card { background : "#312e81" ; color : "#ddd6fe" ; border-width : 1 ; border-color : "#818cf8" ; border-radius : 3 ; padding : 6 ; }
  part selected-schematic-analysis { color : "#c4b5fd" ; font-weight : bold ; }
  part schematic-analysis-configuration { gap : 4 ; }
  part schematic-analysis-configuration-label { font-size : 12 ; font-weight : bold ; color : "#9fb3c8" ; }
  part remove-schematic-analysis-card { background : "#4c1d2d" ; color : "#fecdd3" ; border-width : 1 ; border-color : "#be123c" ; border-radius : 3 ; padding : 6 ; }
  part schematic-analysis-source-label { font-size : 12 ; color : "#9fb3c8" ; }
  part schematic-analysis-source-options { gap : 6 ; }
  part schematic-analysis-source-option { background : "#312e81" ; color : "#ddd6fe" ; border-width : 1 ; border-color : "#818cf8" ; border-radius : 3 ; padding : 6 ; }
  part selected-schematic-analysis-source { color : "#c4b5fd" ; font-family : "monospace" ; }
  part schematic-analysis-parameter-one-label { font-size : 12 ; color : "#9fb3c8" ; }
  part schematic-analysis-parameter-two-label { font-size : 12 ; color : "#9fb3c8" ; }
  part schematic-analysis-parameter-three-label { font-size : 12 ; color : "#9fb3c8" ; }
  part schematic-analysis-parameter-one-input { background : "#0d1117" ; color : "#d2e7ff" ; border-width : 1 ; border-color : "#33465c" ; border-radius : 3 ; padding : 6 ; font-family : "monospace" ; }
  part schematic-analysis-parameter-two-input { background : "#0d1117" ; color : "#d2e7ff" ; border-width : 1 ; border-color : "#33465c" ; border-radius : 3 ; padding : 6 ; font-family : "monospace" ; }
  part schematic-analysis-parameter-three-input { background : "#0d1117" ; color : "#d2e7ff" ; border-width : 1 ; border-color : "#33465c" ; border-radius : 3 ; padding : 6 ; font-family : "monospace" ; }
  part schematic-grid-label { font-size : 12 ; font-weight : bold ; color : "#9fb3c8" ; }
  part schematic-grid { width : 360 ; min-height : 240 ; background : "#0d1117" ; border-width : 1 ; border-color : "#33465c" ; }
  part schematic-grid-line { border-color : "#263545" ; border-width : 1 ; }
  part schematic-wire-segment { border-color : "#5eead4" ; border-width : 2 ; }
  part schematic-terminal { background : "#fbbf24" ; border-color : "#fef3c7" ; border-width : 1 ; }
  part schematic-components { gap : 6 ; }
  part schematic-component { background : "#202a36" ; color : "#d2e7ff" ; border-width : 1 ; border-color : "#33465c" ; border-radius : 3 ; padding : 6 ; }
  part selected-schematic { color : "#8cc8ff" ; font-weight : bold ; }
  part schematic-properties { gap : 4 ; }
  part schematic-properties-label { font-size : 12 ; font-weight : bold ; color : "#9fb3c8" ; }
  part selected-schematic-kind { color : "#d2e7ff" ; }
  part schematic-value-label { font-size : 12 ; color : "#9fb3c8" ; }
  part schematic-value-input { background : "#0d1117" ; color : "#d2e7ff" ; border-width : 1 ; border-color : "#33465c" ; border-radius : 3 ; padding : 6 ; font-family : "monospace" ; }
  part route-schematic { font-size : 12 ; font-weight : bold ; color : "#9fb3c8" ; }
  part schematic-route-targets { gap : 6 ; }
  part schematic-route-target { background : "#123b3a" ; color : "#99f6e4" ; border-width : 1 ; border-color : "#2c827c" ; border-radius : 3 ; padding : 6 ; }
  part synchronize-schematic { background : "#4a3520" ; color : "#fde68a" ; border-width : 1 ; border-color : "#a66b24" ; border-radius : 4 ; padding : 8 ; }
  part netlist-label { font-size : 12 ; font-weight : bold ; color : "#9fb3c8" ; }
  part diagnostics-label { font-size : 12 ; font-weight : bold ; color : "#9fb3c8" ; }
  part analysis-label { font-size : 12 ; font-weight : bold ; color : "#9fb3c8" ; }
  part result-label { font-size : 12 ; font-weight : bold ; color : "#9fb3c8" ; }
  part netlist-input { min-height : 240 ; background : "#0d1117" ; color : "#d2e7ff" ; border-width : 1 ; border-color : "#33465c" ; border-radius : 4 ; padding : 10 ; font-family : "monospace" ; }
  part workbench-actions { gap : 8 ; }
  part inspect-button { background : "#283a51" ; color : "#d2e7ff" ; border-width : 1 ; border-color : "#476786" ; border-radius : 4 ; padding : 8 ; }
  part run-button { background : "#1f6f4a" ; color : "#e9fff3" ; border-width : 1 ; border-color : "#3fa36f" ; border-radius : 4 ; padding : 8 ; }
  part diagnostics { color : "#c7d7e8" ; }
  part diagnostic-row { color : "#ffb4a8" ; font-family : "monospace" ; }
  part workbench-body { gap : 14 ; }
  part analyses { width : "30%" ; gap : 6 ; }
  part analysis-option { background : "#202a36" ; color : "#d2e7ff" ; border-width : 1 ; border-color : "#33465c" ; border-radius : 3 ; padding : 7 ; }
  part selected-analysis { color : "#8cc8ff" ; font-weight : bold ; }
  part results { width : "70%" ; gap : 6 ; }
  part result-table { background : "#0d1117" ; border-width : 1 ; border-color : "#33465c" ; }
  part result-header { background : "#202a36" ; color : "#d2e7ff" ; font-weight : bold ; padding : 6 ; }
  part result-cell { color : "#b9d8f5" ; padding : 6 ; font-family : "monospace" ; }
  part waveforms { gap : 6 ; }
  part waveform-label { font-size : 12 ; font-weight : bold ; color : "#9fb3c8" ; }
  part waveform-options { gap : 6 ; }
  part waveform-option { background : "#202a36" ; color : "#d2e7ff" ; border-width : 1 ; border-color : "#33465c" ; border-radius : 3 ; padding : 6 ; }
  part selected-waveform { color : "#5eead4" ; font-weight : bold ; }
  part waveform-axis { color : "#9fb3c8" ; font-size : 12 ; }
  part waveform-plot { width : 360 ; min-height : 220 ; background : "#0d1117" ; border-width : 1 ; border-color : "#33465c" ; }
  part waveform-axis-x { border-color : "#64748b" ; border-width : 1 ; }
  part waveform-axis-y { border-color : "#64748b" ; border-width : 1 ; }
  part waveform-segment { border-color : "#5eead4" ; border-width : 2 ; }
  part raw-result-label { font-size : 12 ; font-weight : bold ; color : "#9fb3c8" ; }
  part result-output { min-height : 160 ; background : "#0d1117" ; color : "#b9d8f5" ; border-width : 1 ; border-color : "#33465c" ; border-radius : 4 ; padding : 10 ; font-family : "monospace" ; white-space : "pre-wrap" ; }
}
