        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: el surtidor",
          "segments": [
            {
              "kind": "speech",
              "text": "el surtidor — \"the petrol pump; the jet (of a fountain)\"."
            },
            {
              "kind": "speech",
              "text": "Pare junto al surtidor número tres. Stop next to pump number three."
            },
            {
              "kind": "speech",
              "text": "At a petrol station each pump is un surtidor."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "surtidor is built on surtir \"to supply; to spout\". The origin of surtir is not settled."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
