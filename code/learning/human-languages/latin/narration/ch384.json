          "segments": [
            {
              "kind": "speech",
              "text": "ēligō, ēligere — \"to pick out, to choose\"."
            },
            {
              "kind": "speech",
              "text": "Ex multīs hunc ēlēgimus. Out of many we chose this one."
            },
            {
              "kind": "speech",
              "text": "ēligō, ēligere, ēlēgī, ēlēctum: ē + legō, to pick. English elect and election."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ēligō is built from ē \"out\" and legō \"to pick, to gather\" (EtymDB; Lewis & Short). English elect comes from its participle ēlēctus."
            }
          ]
        },
