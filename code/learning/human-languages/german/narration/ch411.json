        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: der Fahrkartenautomat",
          "segments": [
            {
              "kind": "speech",
              "text": "der Fahrkartenautomat — \"the ticket machine\"."
            },
            {
              "kind": "speech",
              "text": "Der Fahrkartenautomat nimmt auch Kreditkarten. The ticket machine also takes credit cards."
            },
            {
              "kind": "speech",
              "text": "Plural: die Fahrkartenautomaten; weak noun: den Fahrkartenautomaten."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Fahrkartenautomat is built from Fahrkarte 'ticket', from fahren and Karte 'card' (from Latin charta, Lewis & Short), and Automat 'machine', which goes back to Greek autómatos 'acting by itself' (EtymDB)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
