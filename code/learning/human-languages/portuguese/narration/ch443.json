          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "esquadra was borrowed from Italian squadra 'square, team', which goes back to Vulgar Latin exquadrāre 'to make square', on quadrus 'square' (Lewis & Short)."
            }
          ]
        },
