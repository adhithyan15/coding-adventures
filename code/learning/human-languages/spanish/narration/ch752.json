        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: el ajedrez",
          "segments": [
            {
              "kind": "speech",
              "text": "el ajedrez — \"chess\"."
            },
            {
              "kind": "speech",
              "text": "Juego al ajedrez con mi abuelo. I play chess with my grandfather."
            },
            {
              "kind": "speech",
              "text": "Jugar al ajedrez (in Latin America also jugar ajedrez)."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ajedrez was borrowed from Andalusian Arabic aš-šaṭranj (EtymDB), which came from Persian and, further back, from Sanskrit caturaṅga \"the four-limbed army\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
