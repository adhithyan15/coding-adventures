              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *kharo*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "kharo, once more",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *kharo*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "thāro javāb kharo hai. — Your answer is correct.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *thāro javāb kharo hai.* — Your answer is correct.]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say the Marwadi for to smash, then the Marwadi for to get cross, then say kharo again",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say the Marwadi for to smash, then the Marwadi for to get cross, then say *kharo* again]"
            }
          ]
        },
        {
          "index": 5,
