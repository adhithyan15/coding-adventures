    {
      "id": "MR-C37-kon",
      "sequence": 1510,
      "title": "कोण (koṇ) — who",
      "headword": "कोण",
      "romanization": "koṇ",
      "gloss": "who — the asking word for a person, and the third member of a family you have already met twice",
      "script": "devanagari",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:c9630912aa7d8d55",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "You own one asking word: काय (kāy), what. It asks about a thing. Nothing you own yet asks about a person."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: कोण",
          "segments": [
            {
              "kind": "speech",
              "text": "कोण — koṇ — who."
            },
            {
              "kind": "speech",
              "text": "तो कोण आहे? — to koṇ āhe? — who is that?"
            },
            {
              "kind": "speech",
              "text": "कोण (koṇ) asks for a person the way काय asks for a thing. Both begin with क, and that is not luck: Marathi builds its asking words on one inherited stem. काय, कसा, कोण (koṇ) — the क- family. Meet a new word starting with क in a question and you can guess its job before you know its meaning."
            },
            {
              "kind": "speech",
              "text": "कोण (koṇ) comes down from Sanskrit कः (kaḥ, \"who\"), by way of the older Marathi कवण. English who and Latin quis grew from the same Indo-European stem, which is why the family feels oddly familiar."
            },
            {
              "kind": "speech",
              "text": "Point it at somebody you have already named: मीरा कोण आहे? — Mīrā koṇ āhe? — who is Mira?"
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "koṇ — who",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *koṇ* — who]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "mitra koṇ āhe? — who is the friend?",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *mitra koṇ āhe?* — who is the friend?]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "which letter every Marathi asking word so far begins with — क",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: which letter every Marathi asking word so far begins with — **क**]"
            },
            {
              "kind": "activity",
              "scored": true,
              "id": "MR-C37-kon-r1",
              "prompt": "Ask who your friend is.",
              "assesses": [
                "MR-QUESTION-KON"
              ],
              "responseSeconds": 20,
              "acceptedResponses": [
                "mitra koṇ āhe?",
                "मित्र कोण आहे?",
                "mitra kon aahe?"
              ],
              "feedback": {
                "correct": "A person asked for by name of job.",
                "incorrect": "Put koṇ where the answer will go, then āhe."
              }
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Which word asks for a thing, and which for a person? (काय; कोण (koṇ).) What do they share? (The क- stem.)"
            },
            {
              "kind": "speech",
              "text": "Sources: Wiktionary: कोण (koṇ)."
            }
          ]
        }
      ]
    },
    {
      "id": "MR-C37-kiti",
      "sequence": 1520,
      "title": "किती (kitī) — how many",
      "headword": "किती",
      "romanization": "kitī",
      "gloss": "how many, how much — the question the numbers one to five were waiting for",
      "script": "devanagari",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:b096a1e6a62b8d5f",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "You can count एक दोन तीन चार पाच. You met कोण (koṇ) one lesson ago. Neither of them lets you ask somebody for a number."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: किती",
          "segments": [
            {
              "kind": "speech",
              "text": "किती — kitī — how many, how much."
            },
            {
              "kind": "speech",
              "text": "तुम्हाला किती भाऊ आहेत? — tumhālā kitī bhāū āhet? — how many brothers do you have?"
            },
            {
              "kind": "speech",
              "text": "Another क- word, and the answer to it is always a number. That is what makes it worth spending a lesson on so early: five numbers with no question to trigger them are five words nobody asks you for."
            },
            {
              "kind": "speech",
              "text": "किती (kitī) is Sanskrit कति (kati, \"how many\") barely changed. Latin quot and English how many carry the same ancient stem."
            },
            {
              "kind": "speech",
              "text": "It also does duty for how much of something uncountable — Marathi does not split the two the way English does."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "kitī — how many",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *kitī* — how many]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "kitī bhāū? — how many brothers?",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *kitī bhāū?* — how many brothers?]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say dusrā — the other one — then answer kitī? with don",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *dusrā* — the other one — then answer *kitī?* with *don*]"
            },
            {
              "kind": "activity",
              "scored": true,
              "id": "MR-C37-kiti-r1",
              "prompt": "Ask how many sisters, then answer with two.",
              "assesses": [
                "MR-QUESTION-KITI",
                "MR-LEX-NUMBERS-ONE-TO-FIVE"
              ],
              "responseSeconds": 22,
              "acceptedResponses": [
                "kitī bahīṇ? — don",
                "किती बहीण? दोन",
                "kiti bahin don"
              ],
              "feedback": {
                "correct": "A question whose answer is a number.",
                "incorrect": "kitī first, then the thing, then answer with a numeral."
              }
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What kind of answer does किती (kitī) always want? (A number.) And कोण (koṇ)? (A person.)"
            },
            {
              "kind": "speech",
              "text": "Sources: Wiktionary: किती (kitī)."
            }
          ]
        }
      ]
    },
