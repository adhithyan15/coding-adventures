              "instruction": "it once more, slowly",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: it once more, slowly]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "āśīrvādaḥ, then agniḥ",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *āśīrvādaḥ*, then *agniḥ*]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
