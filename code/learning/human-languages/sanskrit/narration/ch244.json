        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: उचितः",
          "segments": [
            {
              "kind": "speech",
              "text": "उचितः — ucitaḥ — \"proper, fitting\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ucita comes from the root √uc as its past participle; MW glosses the root \"to take pleasure in, be accustomed, be suitable\". What one is accustomed to is customary, and what is customary is proper."
            }
          ]
        },
        {
