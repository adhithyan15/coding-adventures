        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: आचार्यः",
          "segments": [
            {
              "kind": "speech",
              "text": "आचार्यः — ācāryaḥ — \"a preceptor, a teacher\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ācārya is built on ācāra, \"conduct, the rules of behaviour\", from ā- with the root √car, \"to move, behave\" (MW; CDIAL 1072). MW explains it as \"one who knows or teaches the rules\". Tamil āciriyar, \"teacher\", was borrowed from it."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
