      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Marathi for to groan, then the Marathi for to moan in pain."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: अपचन",
          "segments": [
            {
              "kind": "speech",
              "text": "अपचन — apcan — \"indigestion\"."
            },
            {
              "kind": "speech",
              "text": "तेलकट खाल्ल्याने मला अपचन झालं. telkaṭ khāllyāne malā apcan jhālaṁ. I got indigestion from eating oily food."
            },
            {
              "kind": "speech",
              "text": "Neuter."
            },
            {
              "kind": "speech",
              "text": "अ-, not, + पचन, digestion. अपचन (apcan) होणे, with the dative."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "अपचन (apcan) is built from Sanskrit a-, \"not\", and pacana, \"cooking, maturing\" (Monier-Williams): a learned word for food not digested."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for describing what you lived and felt."
            }
          ]
        },
        {
          "index": 4,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
