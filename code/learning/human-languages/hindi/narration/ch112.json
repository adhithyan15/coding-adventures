          "segments": [
            {
              "kind": "speech",
              "text": "पक्का (pakkā) — \"sure, certain\", and of a thing, \"firm, ripe\"."
            },
            {
              "kind": "speech",
              "text": "पक्का (pakkā)? — \"for sure?\". पक्का (pakkā)! — \"definitely!\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "पक्का (pakkā) goes back to Sanskrit pakva, \"cooked, ripe\" (CDIAL 7621). CDIAL marks the Hindi form as taken over from Punjabi; \"firm, sure\" grew out of \"ripe, mature\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
