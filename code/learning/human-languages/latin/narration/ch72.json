        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: amita, amitae",
          "segments": [
            {
              "kind": "speech",
              "text": "amita, amitae — \"an aunt (father's sister)\". English aunt comes from it."
            }
          ]
        },
