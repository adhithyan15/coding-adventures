        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: tout d'abord",
          "segments": [
            {
              "kind": "speech",
              "text": "tout d'abord — \"first of all, to begin with\"."
            },
            {
              "kind": "speech",
              "text": "Tout d'abord, nous avons pris un café. First of all, we had a coffee."
            },
            {
              "kind": "speech",
              "text": "A little stronger than d'abord alone; it opens a list or a story."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "tout d'abord joins tout \"all\", inherited from Latin tōtus \"whole\" (Lewis & Short), and d'abord \"at first\", which is built on abord \"approach\", from aborder \"to come alongside\", itself built on bord \"edge, side of a ship\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
            }
          ]
        },
