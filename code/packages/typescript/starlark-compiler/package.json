{
  "name": "@coding-adventures/starlark-compiler",
  "version": "0.1.0",
  "description": "Starlark compiler opcode metadata and operator mappings",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc",
    "test": "node node_modules/typescript/bin/tsc -p tsconfig.test.json && node --test dist-test/tests/index.test.js",
    "test:coverage": "node node_modules/typescript/bin/tsc -p tsconfig.test.json && node --experimental-test-coverage --test-coverage-exclude=dist-test/tests/** --test-coverage-lines=80 --test dist-test/tests/index.test.js"
  },
  "license": "MIT",
  "author": "Adhithya Rajasekaran",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  }
}
