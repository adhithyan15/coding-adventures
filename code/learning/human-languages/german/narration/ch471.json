          "segments": [
            {
              "kind": "speech",
              "text": "Trost is inherited from Old High German trōst \"consolation\", from Proto-Germanic traustą (EtymDB), built on an adjective meaning \"firm, strong\"; English trust is a cousin."
            }
          ]
        },
