          "segments": [
            {
              "kind": "speech",
              "text": "ಊಟ ಆಯ್ತಾ? (ūṭa āytā?) — \"have you eaten?\", literally \"has the meal happened?\". In the south this is a greeting as much as a question."
            }
          ]
        },
