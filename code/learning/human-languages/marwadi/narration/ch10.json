        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "speech",
              "text": "Say mā̃ once, then stop."
            },
            {
              "kind": "speech",
              "text": "Sources: Marwari Pathshala, Lesson 4 and Society for Endangered Languages, Marwari Swadesh list."
            },
            {
              "kind": "activity",
              "scored": true,
              "id": "MW-C08-hear-maa-meaning",
              "prompt": "You hear mā̃. Which close-family meaning did this lesson teach?",
              "assesses": [
                "MW-LEX-MAA-01"
              ],
              "responseSeconds": 8,
              "acceptedResponses": [
                "mother",
                "मां"
              ],
              "feedback": {
                "correct": "Right: mā̃ means mother here.",
                "incorrect": "Return to the one sound-and-meaning pair: mā̃ — mother."
              }
            }
          ]
        }
      ]
    },
