{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/adhithyan15/coding-adventures/main/code/specs/fixtures/ocaml-capability-analyzer-v1/cases.schema.json",
  "title": "OCaml capability analyzer behavior cases",
  "type": "object",
  "required": ["$schema", "version", "cases"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://raw.githubusercontent.com/adhithyan15/coding-adventures/main/code/specs/fixtures/ocaml-capability-analyzer-v1/cases.schema.json"
    },
    "version": { "type": "integer", "const": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": ["id", "source_kind", "source", "expected_capabilities", "expected_banned"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "source_kind": { "enum": ["implementation", "interface"] },
        "source": { "type": "string", "minLength": 1 },
        "expected_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(fs|net|proc|env|ffi|time|stdin|stdout):[a-z]+:\\*$" }
        },
        "expected_banned": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
