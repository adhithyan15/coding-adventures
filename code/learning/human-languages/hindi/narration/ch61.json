              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *chammach*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "it once more, slowly",
              "spoken": true,
