          "segments": [
            {
              "kind": "speech",
              "text": "l'ostello — \"the hostel\"."
            },
            {
              "kind": "speech",
              "text": "L'ostello costa poco ed è pulito. The hostel is cheap and clean."
            },
            {
              "kind": "speech",
              "text": "L'ostello della gioventù — youth hostel."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ostello was borrowed from Old French ostel 'shelter', which is inherited from Late Latin hospitāle 'guesthouse', built on hospes 'guest, host' (EtymDB)."
            }
          ]
        },
        {
