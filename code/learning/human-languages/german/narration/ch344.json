        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: beeinflussen",
          "segments": [
            {
              "kind": "speech",
              "text": "beeinflussen — \"to influence\"."
            },
            {
              "kind": "speech",
              "text": "Das Wetter beeinflusst meine Laune. The weather influences my mood."
            },
            {
              "kind": "speech",
              "text": "Inseparable: es beeinflusst, es hat beeinflusst. It takes a direct object."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "beeinflussen is built on Einfluss \"influence\", literally an \"inflow\", from ein \"in\" and Fluss \"flow, river\". Einfluss is usually explained as a rendering of Latin influxus \"a flowing in\"; EtymDB has no history for it."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
