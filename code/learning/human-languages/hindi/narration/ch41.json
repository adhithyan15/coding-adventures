    {
      "id": "HI-C41-adjective-system",
      "sequence": 1220,
      "title": "before the noun, and it AGREES — five words, one rule",
      "headword": "before the noun, and it AGREES",
      "romanization": "before the noun, and it AGREES",
      "gloss": "the one pattern behind all six words in this chapter",
      "script": "devanagari",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:054917d5b70c7944",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Say the five words from this chapter out loud, then say each one in front of a noun you already know."
            }
          ]
        },
        {
          "index": 1,
          "type": "grammar",
          "title": "Grammar lens: where an adjective goes",
          "segments": [
            {
              "kind": "speech",
              "text": "You did not learn five separate words. You learned where an adjective goes, and five words that go there."
            },
            {
              "kind": "table",
              "headers": [
                "meaning",
                "word"
              ],
              "columns": 2,
              "rowCount": 3,
              "utterances": [
                "meaning: big. word: बड़ा baṛā.",
                "meaning: small. word: छोटा choṭā.",
                "meaning: good. word: अच्छा acchā."
              ]
            },
            {
              "kind": "speech",
              "text": "Hindi is the one that changes: बड़ा (baṛā) for a masculine noun, बड़ी for a feminine one."
            },
            {
              "kind": "speech",
              "text": "This is worth more than the five words are. Every noun you already know — your name, the house, the water, the day — can now take any of them in front, and every adjective you meet from here goes in the same place."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "each of the five in front of a noun you already know",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: each of the five in front of a noun you already know]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "two of them with the same noun, one after the other",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: two of them with the same noun, one after the other]"
            },
            {
              "kind": "prompt",
              "action": "NOTICE",
              "instruction": "whether the adjective changed shape when the noun did",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU NOTICE: whether the adjective changed shape when the noun did]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Where does an adjective go in this language? (In front of the noun.) Does it change shape to match the noun? (and it AGREES.)"
            }
          ]
        }
      ]
    }
