      "id": "AR-C544-ud",
      "sequence": 30070,
      "title": "عود (ʿūd) — an oud, a lute",
      "headword": "عود",
      "romanization": "ʿūd",
      "gloss": "an oud, a lute",
      "script": "arabic",
      "modality": "voice",
      "derivedModality": "voice",
