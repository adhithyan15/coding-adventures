{
  "name": "@coding-adventures/irc-framing",
  "version": "0.1.0",
  "description": "Stateful TCP byte-stream to IRC line framer — assembles CRLF-terminated lines from raw socket bytes",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc",
    "test": "node node_modules/typescript/bin/tsc -p tsconfig.test.json && node --test dist-test/tests/irc_framing.test.js",
    "test:coverage": "node node_modules/typescript/bin/tsc -p tsconfig.test.json && node --experimental-test-coverage --test-coverage-lines=80 --test dist-test/tests/irc_framing.test.js"
  },
  "keywords": [
    "irc",
    "framing",
    "tcp",
    "buffer",
    "rfc1459",
    "computer-science",
    "education"
  ],
  "author": "Adhithya Rajasekaran",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.0.0"
  }
}
