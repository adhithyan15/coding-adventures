      "id": "TA-C228-tattaccu-cey",
      "sequence": 12330,
      "title": "தட்டச்சு செய் (taṭṭaccu cey) — to type",
      "headword": "தட்டச்சு செய்",
      "romanization": "taṭṭaccu cey",
      "gloss": "to type",
      "script": "tamil",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
