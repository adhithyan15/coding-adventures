          "segments": [
            {
              "kind": "speech",
              "text": "die Quelle — \"the source; the spring\"."
            },
            {
              "kind": "speech",
              "text": "Der Journalist nannte seine Quelle nicht. The journalist did not name his source."
            },
            {
              "kind": "speech",
              "text": "Plural: die Quellen. The first sense is a spring of water."
            }
          ]
        },
