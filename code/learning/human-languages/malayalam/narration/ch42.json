    {
      "id": "ML-C42-adjective-system",
      "sequence": 1060,
      "title": "before the noun, unchanged — five words, one rule",
      "headword": "before the noun, unchanged",
      "romanization": "before the noun, unchanged",
      "gloss": "the one pattern behind all six words in this chapter",
      "script": "malayalam",
      "modality": "voice",
      "derivedModality": "voice",
