            {
              "kind": "speech",
              "text": "Which tense goes on each side of a real condition? (Present, both.)"
            },
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "And what separates if from yes? (One accent — and a pointing particle, two thousand years ago.)"
            }
          ]
