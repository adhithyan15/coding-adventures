            },
            {
              "kind": "speech",
              "text": "Say the words for to fall and to live."
            }
          ]
        },
        {
          "index": 1,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": true,
              "source": "[PAUSE 2s each]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "clever, lazy, calm, busy, expensive",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: clever, lazy, calm, busy, expensive]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "cheap, wrong, complete, to run, to walk",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: cheap, wrong, complete, to run, to walk]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "to get up, to sleep, to wake up, to bathe, to wash",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: to get up, to sleep, to wake up, to bathe, to wash]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "to cook, to give, to bring, to call, to cry",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: to cook, to give, to bring, to call, to cry]"
            }
          ]
        },
        {
          "index": 2,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Clever? (ബുദ്ധിയുള്ള, buddhiyuḷḷa.) Lazy? (മടിയുള്ള, maṭiyuḷḷa.) Calm? (ശാന്തമായ, śāntamāya.) Busy? (തിരക്കുള്ള, tirakkuḷḷa.) Expensive? (വിലകൂടിയ, vilakūṭiya.) Cheap? (വിലകുറഞ്ഞ, vilakuṟañña.) Wrong? (തെറ്റായ, teṟṟāya.) Complete? (പൂർണ്ണമായ, pūrṇamāya.) To run? (ഓടുക, ōṭuka.) To walk? (നടക്കുക, naṭakkuka.) To get up? (എഴുന്നേൽക്കുക, eḻunnēlkkuka.) To sleep? (ഉറങ്ങുക, uṟaṅṅuka.) To wake up? (ഉണരുക, uṇaruka.) To bathe? (കുളിക്കുക, kuḷikkuka.) To wash? (കഴുകുക, kaḻukuka.) To cook? (വേവിക്കുക, vēvikkuka.) To give? (കൊടുക്കുക, koṭukkuka.) To bring? (കൊണ്ടുവരുക, koṇṭuvaruka.) To call? (വിളിക്കുക, viḷikkuka.) To cry? (കരയുക, karayuka.)"
            }
          ]
        }
      ]
    },
