    {
      "id": "PA-W14-timed-repair-return",
      "sequence": 8770,
      "title": "A later correction stays on another page",
      "headword": "ਨਾਂ: ਅਮਨ",
      "romanization": "nāṁ: aman",
      "gloss": "a short unscored return to keeping a later repair separate",
      "script": "gurmukhi",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type"
      ],
      "sourceHash": "fnv1a64:3252e0c8855e1a64",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on"
        ],
        "waitUntilStopped": [],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on. You can listen to all of it now and come back to the parts that need looking at once you have stopped."
      },
      "blocks": [
        {
          "index": -1,
          "type": "unknown",
          "title": "",
          "segments": [
            {
              "kind": "speech",
              "text": "The earlier timed form remains the first-attempt evidence. This little return practises only one known line and its later repair; it is not another scored form or a complete A1 mock."
            }
          ]
        },
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "speech",
              "text": "Cover the earlier answer."
            },
            {
              "kind": "pause",
              "seconds": 4,
              "perItem": false,
              "source": "[PAUSE 4s]"
            },
            {
              "kind": "speech",
              "text": "Read the familiar label ਨਾਂ and remember the A, ਕ card value. No new card or person is being introduced."
            }
          ]
        },
        {
          "index": 1,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "speech",
              "text": "Set a 45-second practice clock. Write the one known line in Gurmukhi, then stop when the clock ends:"
            },
            {
              "kind": "speech",
              "text": "ਨਾਂ (A, ਕ): ______."
            },
            {
              "kind": "speech",
              "text": "After stopping, check ਨਾਂ: ਅਮਨ (nāṁ: aman). If the value or spelling slipped, write one corrected line on a second page. Keep the first practice line and the earlier timed form visible and unchanged. Say which is the later correction; it cannot replace either first attempt."
            }
          ]
        },
        {
          "index": 2,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "speech",
              "text": "Cover the check."
            },
            {
              "kind": "pause",
              "seconds": 4,
              "perItem": false,
              "source": "[PAUSE 4s]"
            },
            {
              "kind": "speech",
              "text": "Recall the order: first attempt, stop, inspect, then repair separately. The repair helps learning but never raises the first attempt's score."
            }
          ]
        }
      ]
    },
    {
