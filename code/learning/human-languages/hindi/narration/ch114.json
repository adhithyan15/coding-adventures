          "segments": [
            {
              "kind": "speech",
              "text": "शुभकामनाएँ (śubhkāmnāẽ) — \"good wishes\"."
            },
            {
              "kind": "speech",
              "text": "It opens on the शुभ of शुभ रात्रि, \"auspicious\". आपको शुभकामनाएँ (śubhkāmnāẽ) — \"good wishes to you\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "शुभकामनाएँ (śubhkāmnāẽ) is two Sanskrit words taken over whole, tatsamas: śubha, \"auspicious, good\", and kāmanā, \"a wish\", with the Hindi plural ending."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "Wishes for what is coming, beside congratulations for what is done."
            }
          ]
        },
