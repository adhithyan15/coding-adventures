          "segments": [
            {
              "kind": "speech",
              "text": "misereor, miserērī — \"to pity, feel sorry for\"."
            },
            {
              "kind": "speech",
              "text": "Miserēmur puerōrum, quī nūllōs parentēs habent. We pity the children who have no parents."
            },
            {
              "kind": "speech",
              "text": "Deponent: misereor, miserērī, miseritus sum, with the genitive: tuī misereor — I pity you."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "misereor is built on miser \"wretched, pitiable\" (Lewis & Short). English misery comes from miseria, from the same adjective."
            }
          ]
        },
