    {
      "id": "ZH-W129-chao-noisy",
      "sequence": 10325,
      "title": "吵 (chǎo) — 口, then 少",
      "headword": "吵",
      "romanization": "chǎo",
      "gloss": "吵 — 口, then 少",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:d1b7b6c5f464d8be",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — 口, then 少",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — 口, then 少 and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say chǎo — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *chǎo* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "口 少."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — kǒu, shǎo",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *kǒu*, *shǎo*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — 口, then 少",
          "segments": [
            {
              "kind": "speech",
              "text": "吵 (chǎo)."
            },
            {
              "kind": "speech",
              "text": "Two pieces, left before right, and both are old friends."
            },
            {
              "kind": "speech",
              "text": "口, three strokes, small and narrow on the left: the left side, the top that turns down the right side, and the bar that closes the bottom."
            },
            {
              "kind": "speech",
              "text": "少, four strokes, on the right: the vertical down the middle, the short stroke on its left, the dot on its right, then the long left-falling stroke that sweeps under them."
            },
            {
              "kind": "speech",
              "text": "3 + 4 = seven."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "吵 (chǎo), all seven, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 吵, all seven, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What are the two pieces of 吵 (chǎo)? (口 and 少.) Which side is narrow? (The left, 口.) What does the last stroke do? (It sweeps down to the left under 少.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 吵 (chǎo), pinned stroke paths and medians."
            }
          ]
        }
      ]
