        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ನಾಟಕ",
          "segments": [
            {
              "kind": "speech",
              "text": "ನಾಟಕ — nāṭaka — \"a stage play; a drama\"."
            },
            {
              "kind": "speech",
              "text": "ಶಾಲೆಯ ನಾಟಕದಲ್ಲಿ ನಾನು ರಾಜನ ಪಾತ್ರ ಮಾಡಿದೆ. śāleya nāṭakadalli nānu rājana pātra māḍide. I played the king's part in the school play."
            },
            {
              "kind": "speech",
              "text": "ನಾಟಕ (nāṭaka) ಆಡು, to stage a play."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ನಾಟಕ (nāṭaka) is borrowed from Sanskrit nāṭaka, \"a dancer, an actor\", and later a drama (CDIAL 7045), built on naṭa, \"an actor\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for describing what you lived and felt."
            }
          ]
        },
