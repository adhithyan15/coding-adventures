          "type": "input",
          "title": "You'll want to know: a exceção",
          "segments": [
            {
              "kind": "speech",
              "text": "a exceção — \"the exception\"."
            },
            {
              "kind": "speech",
              "text": "Todos pagam, sem exceção. Everyone pays, without exception."
            },
            {
              "kind": "speech",
              "text": "AO90 exceção; older excepção. Abrir uma exceção — to make an exception."
            }
          ]
        },
