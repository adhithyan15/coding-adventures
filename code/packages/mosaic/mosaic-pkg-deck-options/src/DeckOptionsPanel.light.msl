  }

  part fsrs-filter-options {
    padding-bottom : 10 ;
  }

  part leech-options {
    padding-bottom : 10 ;
  }

  part sibling-bury-options {
    padding-bottom : 4 ;
  }

  part learning-steps-field {
    padding : 6 ;
  }

  part relearning-steps-field {
    padding : 6 ;
  }

  part new-cards-field {
    padding : 6 ;
  }

  part reviews-field {
    padding : 6 ;
  }

