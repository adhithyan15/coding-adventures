              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *apcan*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "telkaṭ khāllyāne malā apcan jhālaṁ. — I got indigestion from eating oily food.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *telkaṭ khāllyāne malā apcan jhālaṁ.* — I got indigestion from eating oily food.]"
