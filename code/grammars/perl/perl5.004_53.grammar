# Perl 5.004_53 (1997-10-16) plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: unsupported Perl 5.004_53 syntax is rejected.
# Evidence: https://mirrors.develooper.com/perl/historical-perl/perl-5.004_53.tar.gz
# Archive SHA-256: 6c8cc39262bc4134be38db1782d6a745bd45b1b6d605084f76c43eeaa3584c7e
# Its perly.y changes loop actions outside this arithmetic-print subset.
# Only arithmetic precedence, grouping, and print are represented here.

program         = print_statement { print_statement } ;
print_statement = PRINT LPAREN expr RPAREN SEMICOLON ;
expr            = term { ( PLUS | MINUS ) term } ;
term            = unary { STAR unary } ;
unary           = MINUS unary | atom ;
atom            = INT | LPAREN expr RPAREN ;
