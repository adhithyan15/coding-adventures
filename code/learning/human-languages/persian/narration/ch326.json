          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "hush \"consciousness, mind\" is inherited: EtymDB takes it back through Middle Persian to an Indo-European word for \"ear\". bi \"without\" and shodan \"to become\" are native too."
            }
          ]
