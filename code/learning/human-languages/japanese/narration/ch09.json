          "segments": [
            {
              "kind": "speech",
              "text": "もう — mō — again; one more."
            },
            {
              "kind": "speech",
              "text": "Two morae: mo | o. The macron in mō hides the second beat, but the Japanese spelling shows it with final う. In other settings this adverb can mean “already” or “more.” A request for repetition selects “again.”"
            }
          ]
        },
