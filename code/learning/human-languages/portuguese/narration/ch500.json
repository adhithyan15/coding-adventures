        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: a costura",
          "segments": [
            {
              "kind": "speech",
              "text": "a costura — \"sewing; seam\"."
            },
            {
              "kind": "speech",
              "text": "A minha avó aprendeu costura com a mãe. My grandmother learned sewing from her mother."
            },
            {
              "kind": "speech",
              "text": "Also a seam: a costura rasgou."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "costura is usually traced to Vulgar Latin cōnsūtūra, built on Latin cōnsuere \"to sew together\" (Lewis & Short), from suere \"to sew\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
