        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Ask āp kaise haiṅ? You know the respectful “you are” ending haiṅ. Your answer needs the first-person pair “I... am.”"
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know first — the frame",
          "segments": [
            {
              "kind": "speech",
              "text": "میں... ہوں — maiṅ... hūṅ — I am..."
            },
            {
              "kind": "speech",
              "text": "میں maiṅ means “I.” Final ں marks a nasal ending. ہوں hūṅ means “am” and carries long ū with و, followed again by nasal ں. Leave a space for the state word that comes next."
            }
          ]
        },
        {
          "index": 2,
          "type": "grammar",
          "title": "Grammar Lens: the verb closes the frame",
          "segments": [
            {
              "kind": "speech",
              "text": "Urdu puts the copula at the end:"
            },
            {
              "kind": "speech",
              "text": "maiṅ + [state] + hūṅ — I + [state] + am."
            },
            {
              "kind": "speech",
              "text": "Learn only this first-person frame. You do not need the full copula chart to answer one wellbeing question. Notice the useful contrast: respectful āp... haiṅ, but first-person maiṅ... hūṅ."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "maiṅ — I",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: **maiṅ** — I]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "hūṅ — am",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: **hūṅ** — am]"
            },
            {
              "kind": "prompt",
              "action": "FRAME",
              "instruction": "maiṅ... hūṅ, leaving the middle open",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU FRAME: **maiṅ ... hūṅ**, leaving the middle open]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "speech",
              "text": "Which word opens the answer? (Maiṅ.) Which copula closes it? (Hūṅ.)"
            },
            {
              "kind": "speech",
              "text": "Source: Basic Urdu: Personal Pronouns with “To Be”."
            },
            {
              "kind": "activity",
              "scored": true,
              "id": "UR-C04-main-hun-frame",
