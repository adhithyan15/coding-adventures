        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: el hogar",
          "segments": [
            {
              "kind": "speech",
              "text": "el hogar — \"the home\"."
            },
            {
              "kind": "speech",
              "text": "Productos para el hogar. Products for the home."
            },
            {
              "kind": "speech",
              "text": "A warmer word than la casa; shop signs use it."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "hogar from Old Spanish fogar (EtymDB 2.1), from spoken Latin focaris, built on focus, \"a hearth\" — inherited: f- became h-. A home was named for its fire."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
