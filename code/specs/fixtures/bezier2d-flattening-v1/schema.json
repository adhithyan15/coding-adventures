{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "G2D02 conservative flattening cases v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "absolute_tolerance", "max_depth", "max_subdivisions", "cases"],
  "properties": {
    "version": {"const": 1},
    "absolute_tolerance": {"const": 1e-12},
    "max_depth": {"const": 32},
    "max_subdivisions": {"const": 65535},
    "cases": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "point": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": -1000000, "maximum": 1000000}},
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "degree", "control_points", "tolerance", "expected_disposition"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}(?![\\s\\S])"},
        "degree": {"enum": [2, 3]},
        "control_points": {"type": "array", "items": {"$ref": "#/$defs/point"}},
        "tolerance": {"type": "number", "minimum": -1000000, "maximum": 1000000},
        "expected_disposition": {"enum": ["chord", "subdivide", "invalid-tolerance"]},
        "expected_termination": {"const": "budget-error"},
        "witness_t": {"type": "number", "minimum": 0, "maximum": 1},
        "expected_witness": {"$ref": "#/$defs/point"},
        "expected_witness_distance": {"type": "number", "minimum": 0, "maximum": 1000000}
      },
      "allOf": [
        {"if": {"properties": {"degree": {"const": 2}}}, "then": {"properties": {"control_points": {"minItems": 3, "maxItems": 3}}}, "else": {"properties": {"control_points": {"minItems": 4, "maxItems": 4}}}},
        {"if": {"required": ["expected_termination"]},
         "then": {"properties": {"degree": {"const": 2}, "control_points": {"const": [[0, 0], [0.5, 1], [1, 0]]}, "expected_disposition": {"const": "subdivide"}, "tolerance": {"exclusiveMaximum": 5.206251464550825e-11}}}},
        {"if": {"properties": {"expected_disposition": {"const": "invalid-tolerance"}}},
         "then": {"properties": {"tolerance": {"maximum": 0}}, "not": {"anyOf": [{"required": ["witness_t"]}, {"required": ["expected_witness"]}, {"required": ["expected_witness_distance"]}]}},
         "else": {"required": ["witness_t", "expected_witness", "expected_witness_distance"], "properties": {"tolerance": {"exclusiveMinimum": 0}}}}
      ]
    }
  }
}
