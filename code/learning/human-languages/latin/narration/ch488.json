            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Latin for to blow through, then the Latin for clear weather."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: brūma, brūmae",
          "segments": [
            {
              "kind": "speech",
              "text": "brūma, brūmae — \"midwinter, the winter solstice, the shortest day\"."
            },
            {
              "kind": "speech",
              "text": "Brūmā diēs brevissimus est et nox longissima. At midwinter the day is shortest and the night longest."
            },
            {
              "kind": "speech",
              "text": "First declension, feminine: brūma, brūmae f. Shortened from brevissima (diēs), the shortest day. English brumal 'wintry' comes from it."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "brūma comes from brevima, an old form of brevissima 'shortest', as in brevissima diēs 'the shortest day' (EtymDB; Lewis & Short); it is built on brevis 'short'."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
