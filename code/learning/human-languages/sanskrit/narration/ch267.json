    {
      "id": "SA-C267-complete-school-plan",
      "sequence": 15850,
      "title": "Join the pieces into one school-day plan",
      "headword": "(complete one school-day plan)",
      "romanization": "",
      "gloss": "join school vocabulary, one timetable turn, and two study plans",
      "script": "devanagari",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:7f28f615b29eaf61",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Say “a fort,” then “I will do.” (Durgam; kariṣyāmi.)"
            }
          ]
        },
        {
          "index": 1,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "speech",
              "text": "First name the setting and its useful records: विद्यालयः, school; कक्षा, classroom; समयसारणी, timetable; अंकः, mark; उत्तरम्, answer. Name the people: छात्रः, student; अध्यापकः, teacher."
            },
            {
              "kind": "speech",
              "text": "Then say the working plan:"
            },
            {
              "kind": "speech",
              "text": "परीक्षा कदा भविष्यति? — When will the exam be?"
            },
            {
              "kind": "speech",
              "text": "श्वः परीक्षा भविष्यति। — The exam will be tomorrow."
            },
            {
              "kind": "speech",
              "text": "गृहकार्यं करिष्यामि। — I will do the homework."
            },
            {
              "kind": "speech",
              "text": "पाठं पठिष्यामि। — I will study the lesson."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "The nouns were already yours. Now a timetable question, answer, and two plans hold them together without adding a new paradigm."
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Say the question, the answer, the homework plan, and the study plan."
            }
          ]
        }
      ]
    },
    {
