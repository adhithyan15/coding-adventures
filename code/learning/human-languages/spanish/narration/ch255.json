            },
            {
              "kind": "speech",
              "text": "Which endings does dar take in the past? (The -er ones, though it is an -ar verb.)"
            },
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "And what does dar mean? (To give.)"
            }
          ]
        }
