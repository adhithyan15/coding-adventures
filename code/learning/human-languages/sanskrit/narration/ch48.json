            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "talam, then siṁhaḥ",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *talam*, then *siṁhaḥ*]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
