          "segments": [
            {
              "kind": "speech",
              "text": "دوار — duwār — \"dizziness\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "دوار (duwār) is built on the native Arabic root d-w-r, \"to turn round\" (Lane). Duwār has the fuʿāl shape of illness words: the head turning round."
            }
          ]
        },
