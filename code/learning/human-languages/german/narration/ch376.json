          "segments": [
            {
              "kind": "speech",
              "text": "auswendig — \"by heart\"."
            },
            {
              "kind": "speech",
              "text": "Die Kinder lernen das Lied auswendig. The children are learning the song by heart."
            },
            {
              "kind": "speech",
              "text": "Auswendig lernen — to learn by heart; auswendig können — to know by heart."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "auswendig is built from aus \"out\" and wenden \"to turn\", Old High German wenten (EtymDB), and first meant \"on the outside\": you can say the text without looking into the book."
            }
          ]
        },
