          "segments": [
            {
              "kind": "speech",
              "text": "der Würfel — \"dice; cube\"."
            },
            {
              "kind": "speech",
              "text": "Wer mit dem Würfel eine Sechs wirft, darf anfangen. Whoever throws a six with the dice gets to start."
            },
            {
              "kind": "speech",
              "text": "Plural: die Würfel. Also a cube: der Eiswürfel — an ice cube. The verb is würfeln — to throw dice."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Würfel is inherited from Middle High German würfel and Old High German wurfil, from Proto-Germanic wurpilaz \"die\" (EtymDB), built on the verb that is today werfen \"to throw\"."
            }
          ]
        },
