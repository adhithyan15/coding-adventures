# Perl 5.004_01_03 (1997-08-05) grammar: plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: unsupported Perl 5.004_01_03 syntax is rejected.
# Evidence: https://mirrors.develooper.com/perl/historical-perl/perl-5.004_01_03.tar.gz
# Archived perly.y matches 5.004_01_02; this separate file
# retains only arithmetic precedence, parentheses and print subset.

program         = print_statement { print_statement } ;
print_statement = PRINT LPAREN expr RPAREN SEMICOLON ;
expr            = term { ( PLUS | MINUS ) term } ;
term            = unary { STAR unary } ;
unary           = MINUS unary | atom ;
atom            = INT | LPAREN expr RPAREN ;
