        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "respetar is built on respeto, \"respect\", from Latin respectus, \"a looking back, regard\", from respicere, \"to look back\" — semi-learned: its -ct- was simplified to -t-, not turned into the -ch- of words worn down in speech."
            }
          ]
        },
        {
