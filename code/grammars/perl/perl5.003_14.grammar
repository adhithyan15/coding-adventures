# Perl 5.003_14 (1996-12-23) grammar: plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: unsupported Perl 5.003_14 syntax is rejected.
# Evidence: https://github.com/Perl/perl5/blob/perl-5.003_14/perly.y
# The tagged yacc removes deprecated if/while block forms outside this
# arithmetic precedence, parentheses and print subset.

program         = print_statement { print_statement } ;
print_statement = PRINT LPAREN expr RPAREN SEMICOLON ;
expr            = term { ( PLUS | MINUS ) term } ;
term            = unary { STAR unary } ;
unary           = MINUS unary | atom ;
atom            = INT | LPAREN expr RPAREN ;
