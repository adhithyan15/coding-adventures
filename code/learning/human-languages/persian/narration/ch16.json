              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RUN: **yek, do, se**]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Which two numbers can this book write so far? (سه (se) and, later, نه.)"
            },
            {
              "kind": "speech",
              "text": "Sources: Wiktionary: سه (se); Omniglot, Numbers in Persian."
            },
            {
