        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "What do you start from? (The they past.) What do you swap? (-ron for -ra.)"
            },
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "How many verbs change their stem? (None — the breaking already happened somewhere else.) And what does move? (The accent, in the nosotros form.)"
            }
          ]
        }
      ]
