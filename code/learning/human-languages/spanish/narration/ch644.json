          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "volante is built on volar \"to fly\", inherited from Latin volāre; as an adjective it means \"flying\" (EtymDB), and it came to name parts that turn or move freely."
            }
          ]
        },
