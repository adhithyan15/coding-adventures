        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: भद्दा",
          "segments": [
            {
              "kind": "speech",
              "text": "भद्दा — bhaddā — \"ugly, clumsy\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "भद्दा (bhaddā) is a tadbhava, a word inherited from Sanskrit and reshaped by sound change. It comes from bhadra, \"fortunate, delightful\" (CDIAL 9377). Its sense turned round: CDIAL glosses the Hindi word \"stupid, clumsy\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
