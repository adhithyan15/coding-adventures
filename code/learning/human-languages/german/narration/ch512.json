        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: der Schlitten",
          "segments": [
            {
              "kind": "speech",
              "text": "der Schlitten — \"sledge, sled\"."
            },
            {
              "kind": "speech",
              "text": "Die Kinder fahren mit dem Schlitten den Hügel hinunter. The children sledge down the hill."
            },
            {
              "kind": "speech",
              "text": "Plural: die Schlitten. Schlitten fahren — to go sledging."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Schlitten is inherited from Middle High German slite and Old High German slito \"sled\", from Proto-Germanic slidô (EtymDB); English sled is a cousin."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
