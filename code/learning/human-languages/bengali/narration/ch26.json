      "title": "ঁ ((chôndrobindu)), from above the line",
      "headword": "ঁ",
      "romanization": "(chôndrobindu)",
      "gloss": "the moon-and-dot, retrieved from above the head-line",
      "script": "bengali",
      "modality": "pen",
