          "title": "You'll want to know: le réseau",
          "segments": [
            {
              "kind": "speech",
              "text": "le réseau — \"the network\"."
            },
            {
              "kind": "speech",
              "text": "Il n'y a pas de réseau en montagne. There is no signal in the mountains."
            },
            {
              "kind": "speech",
              "text": "Les réseaux sociaux — social media."
            }
          ]
        },
