                "ES-GRAMMAR-VER-PRETERITE"
              ],
              "responseSeconds": 15,
              "acceptedResponses": [
                "di and dio, because they are one syllable",
                "di and dio",
                "di, dio -- one syllable each"
              ],
              "feedback": {
                "correct": "The same reason vi and vio go bare.",
                "incorrect": "Di and dio -- one syllable, so there is no beat to correct."
              }
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
