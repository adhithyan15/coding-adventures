          "segments": [
            {
              "kind": "speech",
              "text": "ચિત્ર — citra — \"picture, painting\"."
            },
            {
              "kind": "speech",
              "text": "બાળકે સુંદર ચિત્ર બનાવ્યું. — bāḷake sundar citra banāvyũ — \"The child made a beautiful picture.\""
            }
