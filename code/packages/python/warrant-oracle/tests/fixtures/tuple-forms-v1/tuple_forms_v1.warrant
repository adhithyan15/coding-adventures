  op op_proj0(t: (Bool,Nat)) -> Bool
  op op_proj1(t: (Bool,Nat)) -> Nat
  op op_proj_chain(t: ((Bool,Nat),Bool)) -> Nat
  op op_proj_last8(t: (Bool,Bool,Bool,Bool,Bool,Bool,Bool,Bool)) -> Bool
  op op_proj_postfix(a: Bool, n: Nat) -> Nat
  op op_proj_literal() -> U8
  op op_swap(t: (Bool,Bool)) -> (Bool,Bool)
  op op_tup_eq(a: (Bool,Bool), b: (Bool,Bool)) -> Bool
  op op_tup_ne(a: (Bool,Bool), b: (Bool,Bool)) -> Bool
  op op_tup_eq_lit(a: (Bool,Nat)) -> Bool
  op op_k(a: Bool, b: Bool) -> Result<(Bool,Bool),TupleError>
  op op_dec(a: Bool, n: Nat) -> Result<(Bool,Nat),TupleError>
  op op_m_ok_wild(r: Result<(Bool,Bool),TupleError>) -> Bool
  op op_m_ok_bind(r: Result<Bool,TupleError>) -> Bool
  op op_m_ok_tuple(r: Result<(Bool,Bool),TupleError>) -> Bool
  op op_m_ok_tuple_wild(r: Result<(Bool,Bool),TupleError>) -> Bool
  op op_m_ok_nested(r: Result<((Bool,Bool),Bool),TupleError>) -> Bool
  op op_m_err_cases(r: Result<Bool,TupleError>) -> Nat
  op op_m_err_any_last(r: Result<Bool,TupleError>) -> Nat
  op op_m_bind_whole(r: Result<Bool,TupleError>) -> Bool
  op op_m_wild_arm(r: Result<Bool,TupleError>) -> Nat
  op op_m_returns_tuple(r: Result<(Bool,Bool),TupleError>) -> (Bool,Bool)
  op op_m_returns_result(r: Result<(Bool,Bool),TupleError>) -> Result<(Bool,Bool),TupleError>
  op op_m_nested_match(r: Result<Result<Bool,TupleError>,TupleError>) -> Nat
  op op_m_inner_match(r: Result<Bool,TupleError>, s: Result<Bool,TupleError>) -> Bool
  op op_m_on_call(a: Bool, b: Bool) -> Bool
  op op_m_arith_arm(r: Result<U8,TupleError>) -> U8
  op op_mixed(a: U8, n: Nat | n < 2, d: Bytes<0>, f: Bool) -> (U8,Nat,Bytes<0>,Bool)
  op op_zero(d: Bytes<0>) -> Result<(Bool,Nat),TupleError>
  op op_flip(r: Result<(Bool,Bool),TupleError>) -> Result<(Bool,Bool),TupleError>
  op op_inc(a: U8) -> U8
  op op_small(a: U8 | a < 100u8) -> U8
  op op_bytes(d: Bytes<2>) -> Result<Bytes<2>,TupleError>
  op op_bits(d: Bytes<2>) -> Bytes<2>
  op op_u8(a: U8) -> U8
