      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new word: what did evam mean?"
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: इदानीम्",
          "segments": [
            {
              "kind": "speech",
              "text": "इदानीम् (idānīm) — \"now\"."
            },
            {
              "kind": "speech",
              "text": "इदानीम् (idānīm) is now. It belongs with सदा, अद्य and ह्यः — always, today, yesterday — and it is the sharpest of them: not this day, this moment."
            },
            {
              "kind": "speech",
              "text": "It is built on the near-pointing stem you met with एतत्, \"this one\". The pointing system runs a- / t- / k-, and इदानीम् (idānīm) is the near end of it applied to time rather than to place: this-time. गच्छामि इदानीम् (idānīm) — \"I am going now\" — is a way to take your leave that reuses the verb you learned for exactly that purpose."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "A time word built out of the pointing system, and a way to leave."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "idānīm",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *idānīm*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "it once more, slowly",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: it once more, slowly]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "idānīm, then gacchāmi idānīm as one phrase",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *idānīm*, then *gacchāmi idānīm* as one phrase]"
            },
            {
