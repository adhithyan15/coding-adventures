# Perl 5.004_01-t2 (1997-06-11) tokens: plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: this does not lex all Perl 5.004_01-t2 source.
# Evidence: https://mirrors.develooper.com/perl/historical-perl/perl-5.004_01-t2.tar.gz
# Archived toke.c is byte-identical to the final 5.004_01 tag and retains
# its 250-digit decimal bound.
# Unsupported characters, carriage returns and
# leading-zero forms remain refused.

PRINT     = "print"
INT       = /0|[1-9][0-9]{0,249}/
PLUS      = "+"
DECREMENT = "--"
MINUS     = "-"
STAR      = "*"
LPAREN    = "("
RPAREN    = ")"
SEMICOLON = ";"

skip:
  WHITESPACE = /[ \t\n]+/
