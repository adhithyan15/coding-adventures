# Perl 5.003_98 (1997-04-30) grammar: plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: unsupported Perl 5.003_98 syntax is rejected.
# Evidence: https://github.com/Perl/perl5/blob/perl-5.003_98/perly.y
# Tagged yacc adds arrow-call forms outside this subset; this separate file
# retains only arithmetic precedence, parentheses and print subset.

program         = print_statement { print_statement } ;
print_statement = PRINT LPAREN expr RPAREN SEMICOLON ;
expr            = term { ( PLUS | MINUS ) term } ;
term            = unary { STAR unary } ;
unary           = MINUS unary | atom ;
atom            = INT | LPAREN expr RPAREN ;
