          "segments": [
            {
              "kind": "speech",
              "text": "பயம் (payam) — \"fear\"."
            },
            {
              "kind": "speech",
              "text": "Fear."
            },
            {
              "kind": "speech",
              "text": "Three letters and not one vowel sign anywhere: ப, ய, and ம with a புள்ளி. Every letter is carrying its own built-in a, which is the plainest a Tamil word can possibly be written."
            },
            {
              "kind": "speech",
              "text": "It ends in the same ம் as கோபம் (kōpam), which is not a coincidence — Tamil keeps a whole shelf of feeling-nouns with that ending."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "Two, and both of them end the same way."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
