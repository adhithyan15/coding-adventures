// EngramApp.dark.msl - dark app-shell style for the Engram Mosaic app.

style EngramApp {
  part app-shell {
    background : "#101827" ;
    padding    : 24 ;
  }

  part app-title {
    color          : "#f8fafc" ;
    font-size      : 28 ;
    font-weight    : 700 ;
    padding-bottom : 14 ;
  }

  part stats-region {
    padding-bottom : 14 ;
  }

  part deck-options-region {
    padding-bottom : 14 ;
  }

  part review-history-region {
    padding-bottom : 14 ;
  }

  part collection-region {
    padding-bottom : 14 ;
  }

  part browser-region {
    padding-bottom : 14 ;
  }

  part note-editor-region {
    padding-bottom : 14 ;
  }

  part review-region {
    padding-top : 16 ;
    padding : 4 ;
  }
}
