      "live-interlocutor"
    ]
  },
  "passRule": {
    "maximumPoints": 400,
    "passPoints": 240,
    "requiresEverySectionAttempted": true,
    "independentSkillThresholds": {
      "reading": 0.6,
      "listening": 0.6,
      "writing": 0.6,
      "speaking": 0.6
    },
