            },
            {
              "kind": "speech",
              "text": "Before the new one: what did bāṭa mean?"
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: చాప",
          "segments": [
            {
              "kind": "speech",
              "text": "చాప (cāpa) — \"a mat\"."
            },
            {
              "kind": "speech",
              "text": "A చాప (cāpa) is woven from palm leaf or reed, rolled up against a wall by day and unrolled to sit or sleep on."
            },
            {
              "kind": "speech",
              "text": "It belongs beside the కుర్చీ you already have. Where the chair is a borrowed thing with a borrowed name, the చాప (cāpa) is old and the word is inherited, and a house that has both will often put the చాప (cāpa) down for the people who are comfortable on the floor and keep the కుర్చీ for the guest who is not."
            },
            {
              "kind": "speech",
              "text": "Offering somebody a చాప (cāpa) is an invitation to stay a while. It is a slower gesture than pointing at a chair."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "The first thing a floor gets."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "cāpa",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *cāpa*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "it once more, slowly",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: it once more, slowly]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "cāpa, then kurcī, and say which of the two gets rolled up",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *cāpa*, then *kurcī*, and say which of the two gets rolled up]"
            }
          ]
        },
        {
          "index": 4,
