      "id": "ML-C177-arum",
      "sequence": 7620,
      "title": "ആരും (āruṁ) — nobody (with a negative verb)",
      "headword": "ആരും",
      "romanization": "āruṁ",
      "gloss": "nobody (with a negative verb)",
      "script": "malayalam",
      "modality": "voice",
      "derivedModality": "voice",
