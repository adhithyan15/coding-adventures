          "segments": [
            {
              "kind": "speech",
              "text": "bāsium, bāsiī — \"a loving kiss\"."
            },
            {
              "kind": "speech",
              "text": "Fīliola patrī bāsia mīlle dat. The little girl gives her father a thousand kisses."
            },
            {
              "kind": "speech",
              "text": "Neuter, second declension. A warm word of love poetry. Spanish beso and Italian bacio come from it."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "bāsium is a word of uncertain origin; Lewis & Short compares English buss, and EtymDB gives a Proto-Indo-European root bu-, but it is not settled. Spanish beso and Italian bacio come from it."
            }
          ]
        },
        {
