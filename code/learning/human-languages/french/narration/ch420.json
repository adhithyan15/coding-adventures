        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: l'escale",
          "segments": [
            {
              "kind": "speech",
              "text": "l'escale — \"the stopover, the port of call\"."
            },
            {
              "kind": "speech",
              "text": "Nous avons fait une escale de trois heures. We had a three-hour stopover."
            },
            {
              "kind": "speech",
              "text": "A feminine noun. Un vol sans escale — a non-stop flight."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "escale was borrowed from Italian scala 'landing stage', from Latin scāla 'ladder, steps' (EtymDB): the steps where a ship let people off."
            }
          ]
        },
