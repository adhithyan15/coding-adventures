        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: la convivenza",
          "segments": [
            {
              "kind": "speech",
              "text": "la convivenza — \"the living together, the coexistence\"."
            },
            {
              "kind": "speech",
              "text": "La convivenza con i vicini non è sempre facile. Living alongside the neighbours is not always easy."
            },
            {
              "kind": "speech",
              "text": "It also means a couple living together without being married."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "convivenza is built on convivere \"to live together\", from Latin convīvere \"to live with\" (Lewis & Short), built on vīvere \"to live\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
