            {
              "kind": "speech",
              "text": "A feminine noun."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ખસ (khas) goes back to Sanskrit khasa, \"itch, scab\", which CDIAL thinks probably came from Dravidian; CDIAL lists the Gujarati word (CDIAL 3854)."
            }
          ]
        },
