        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: سینی",
          "segments": [
            {
              "kind": "speech",
              "text": "سینی — sini — \"a tray\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "sini is borrowed from Arabic ṣīnī, \"Chinese\" (EtymDB): trays of Chinese porcelain are usually said to have given the word its sense."
            }
          ]
        },
