            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Sanskrit for a mouse, then the Sanskrit for a cat."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: काकः",
          "segments": [
            {
              "kind": "speech",
              "text": "काकः (kākaḥ) — \"a crow\", a black विहगः. Say it and hear its call."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Kāka is an imitation of the crow's call (MW, CDIAL 2993). It lives on as Hindi kauā, \"crow\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "The bird that names itself."
            }
          ]
        },
        {
          "index": 4,
          "type": "guided-production",
