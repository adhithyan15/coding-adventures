            },
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "copy ਖਾਂਦਾ once",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: copy **ਖਾਂਦਾ** once]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
