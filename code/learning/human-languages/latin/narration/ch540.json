          "segments": [
            {
              "kind": "speech",
              "text": "turbō belongs with turba \"commotion\" and the verb turbō \"to disturb\" (Lewis & Short; EtymDB): a thing in whirling motion. English turbine comes from it."
            }
          ]
        },
