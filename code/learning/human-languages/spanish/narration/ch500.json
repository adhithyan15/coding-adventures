          "title": "You'll want to know: respetar",
          "segments": [
            {
              "kind": "speech",
              "text": "respetar — \"to respect\"."
            },
            {
              "kind": "speech",
              "text": "Respeta el horario de descanso. Respect the quiet hours."
            },
            {
              "kind": "speech",
              "text": "The verb behind el respeto."
