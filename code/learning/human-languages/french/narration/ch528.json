        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: balayer",
          "segments": [
            {
              "kind": "speech",
              "text": "balayer — \"to sweep\"."
            },
            {
              "kind": "speech",
              "text": "Tous les soirs, il balaie la cuisine. Every evening he sweeps the kitchen."
            },
            {
              "kind": "speech",
              "text": "Je balaie or je balaye; both are correct."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "balayer is built on balai \"broom\" (EtymDB), a word of Celtic origin, first the name of the broom plant."
            }
          ]
        },
        {
