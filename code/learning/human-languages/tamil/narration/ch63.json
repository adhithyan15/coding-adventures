        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:f7d04850f5336b7b",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: what did uṭaṉē mean, and what did mutalil mean?"
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: வேண்டுகோள்",
          "segments": [
            {
              "kind": "speech",
              "text": "வேண்டுகோள் (vēṇḍukōḷ) — \"a request\"."
            },
            {
              "kind": "speech",
              "text": "A request as a thing you make and hand over, rather than the asking itself. It stands beside வேண்டும், which you already have, and you can hear that word at the front of it."
            },
            {
              "kind": "speech",
              "text": "Kannada ವಿನಂತಿ (vinanti) and Telugu మనవి (manavi) both went their own way. A வேண்டுகோள் (vēṇḍukōḷ) is what தயவுசெய்து is put in front of when the asking has to be formal."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "The first of five."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "vēṇḍukōḷ",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *vēṇḍukōḷ*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "it once more, slowly",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: it once more, slowly]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "vēṇḍukōḷ, then tayavu seytu, and say which one dresses the other",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *vēṇḍukōḷ*, then *tayavu seytu*, and say which one dresses the other]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What does வேண்டுகோள் (vēṇḍukōḷ) mean? (\"a request\".) Say it once more."
            }
          ]
        }
      ]
    },
