          "segments": [
            {
              "kind": "speech",
              "text": "l'écureuil — \"the squirrel\"."
            },
            {
              "kind": "speech",
              "text": "Un écureuil monte dans l'arbre avec une noisette. A squirrel runs up the tree with a hazelnut."
            },
            {
              "kind": "speech",
              "text": "A masculine noun. The ending sounds like euil."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "écureuil comes from Middle French escureul (EtymDB), from Vulgar Latin scūriolus, a small Latin sciūrus, from Greek skíouros 'shadow-tail'."
            }
          ]
        },
        {
