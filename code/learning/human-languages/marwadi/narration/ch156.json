      "title": "बाजार सूं (sū̃) — from",
      "headword": "सूं",
      "romanization": "sū̃",
      "gloss": "from, after a place",
      "script": "devanagari",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:2ab13172bb9256b2",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Say the shop is in the market. Then he comes every day, and the question word where, कठै."
            }
          ]
        },
        {
          "index": 1,
          "type": "grammar",
          "title": "Grammar Lens: सूं",
          "segments": [
            {
              "kind": "speech",
              "text": "सूं (sū̃) after a place says where someone comes from:"
            },
            {
              "kind": "speech",
              "text": "वो बाजार सूं आवै है। vo bājār sū̃ āvai hai. — He comes from the market."
            },
            {
              "kind": "speech",
              "text": "हूं दुकान सूं आऊं हूं। hū̃ dukān sū̃ āū̃ hū̃. — I come from the shop."
            },
            {
              "kind": "speech",
              "text": "Old Marwari wrote it -su: talā-su, \"from below\" (CDIAL 5731)."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "speech",
              "text": "Ask with कठै in front of it:"
            },
            {
              "kind": "speech",
              "text": "आप कठै सूं आवो हो? āp kaṭhai sū̃ āvo ho? — Where do you come from?"
            },
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "आप कठै सूं आवो हो? — āp kaṭhai sū̃ āvo ho? — Where do you come from?",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: **आप कठै सूं आवो हो?** — *āp kaṭhai sū̃ āvo ho?* — Where do you come from?]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "हूं बाजार सूं आऊं हूं। — hū̃ bājār sū̃ āū̃ hū̃. — I come from the market.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: **हूं बाजार सूं आऊं हूं।** — *hū̃ bājār sū̃ āū̃ hū̃.* — I come from the market.]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "From the market? (बाजार सूं (sū̃).) Where from? (कठै सूं (sū̃).)"
            },
            {
              "kind": "activity",
              "scored": true,
              "spoken": true,
              "id": "MW-C156-su-where-from",
              "prompt": "Ask politely: where do you come from?",
              "assesses": [
                "MW-GRAMMAR-C156-POSTP-SU-01"
              ],
              "responseSeconds": 15,
              "acceptedResponses": [
                "आप कठै सूं आवो हो?",
                "āp kaṭhai sū̃ āvo ho?",
                "aap kathai su avo ho"
              ],
              "feedback": {
                "correct": "Right: कठै सूं, where from.",
                "incorrect": "Put सूं after कठै: आप कठै सूं आवो हो?"
              }
            }
          ]
        }
      ]
    },
