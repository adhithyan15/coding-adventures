            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "ajji mommaganannu muddisidaru. — Grandmother cuddled her grandson.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *ajji mommaganannu muddisidaru.* — Grandmother cuddled her grandson.]"
            },
            {
