          "segments": [
            {
              "kind": "speech",
              "text": "лишать (lishát) — \"to deprive of, to take away\"."
            },
            {
              "kind": "speech",
              "text": "Боль лишает его сна. Bol lisháyet yegó sna. The pain keeps him from sleeping."
            },
            {
              "kind": "speech",
              "text": "Imperfective; perfective лишить. Лишать кого чего: the thing taken goes in the genitive."
            }
          ]
        },
