            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Urdu for to mix; to introduce, then the Urdu for to join."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: خرچ کرنا",
          "segments": [
            {
              "kind": "speech",
              "text": "خرچ کرنا — kharch karnā — \"to spend\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The phrase, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "خرچ کرنا (kharch karnā) joins kharch, \"spending\", and karnā, \"to do\". kharch is Arabic kharj, \"a going out; expenditure\", which reached Urdu through Persian (Lane, root kh-r-j); karnā comes from Sanskrit karoti, \"does\" (CDIAL 2814)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for this chapter."
            }
          ]
        },
