        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: zusammenstoßen",
          "segments": [
            {
              "kind": "speech",
              "text": "zusammenstoßen — \"to collide\"."
            },
            {
              "kind": "speech",
              "text": "Zwei Autos stießen an der Kreuzung zusammen. Two cars collided at the crossroads."
            },
            {
              "kind": "speech",
              "text": "Separable, Perfekt with sein: Sie sind zusammengestoßen."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "zusammenstoßen joins zusammen \"together\" and stoßen \"to push, to bump\", from Old High German stōzan, Proto-Germanic stautaną (EtymDB)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
