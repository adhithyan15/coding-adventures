    {
      "id": "SA-C48-goose",
      "sequence": 2370,
      "title": "हंसः (haṁsaḥ) — a goose",
      "headword": "हंसः",
      "romanization": "haṁsaḥ",
      "gloss": "a goose",
      "script": "devanagari",
      "modality": "voice",
