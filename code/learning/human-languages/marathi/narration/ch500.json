          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Marathi for to crawl, then the Marathi for to give to drink."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: संगोपन",
          "segments": [
            {
              "kind": "speech",
              "text": "संगोपन — saṅgopan — \"upbringing\"."
            },
            {
              "kind": "speech",
              "text": "आजीने माझं संगोपन केलं. ājīne mājhaṁ saṅgopan kelaṁ. My grandmother brought me up."
            },
            {
              "kind": "speech",
              "text": "Neuter."
            },
            {
              "kind": "speech",
              "text": "संगोपन (saṅgopan) करणे, to bring up."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "संगोपन (saṅgopan) is a tatsama, taken from Sanskrit saṃgopana, \"hiding or guarding well\" (Monier-Williams); in Marathi it is the guarding of a child as it grows."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for describing what you lived and felt."
            }
          ]
        },
        {
          "index": 4,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
