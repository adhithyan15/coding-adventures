      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Say ਕੱਢਣਾ (kaḍḍhṇā), \"to take out\", the verb from the previous lesson."
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script you'll notice: ਢ",
          "segments": [
            {
              "kind": "speech",
              "text": "ਕ + ੱ + ਢ (ḍha) + ਣ + ਾ becomes ਕੱਢਣਾ (kaḍḍhṇā)."
            },
            {
              "kind": "speech",
              "text": "ਢ — ḍha — a Gurmukhi consonant."
            },
            {
              "kind": "speech",
              "text": "Keep ਢ (ḍha) in view. It is the third piece of ਕੱਢਣਾ (kaḍḍhṇā), after the doubling sign ੱ. It belongs to the same row as ਡ, which you know."
            },
            {
              "kind": "speech",
              "text": "No stroke order is taught here: the track does not yet have a verified source for one."
            }
          ]
        },
        {
          "index": 2,
          "type": "writing",
          "title": "Writing: copy what you can see",
          "segments": [
            {
              "kind": "speech",
              "text": "Keep ਢ in front of you. Trace its printed shape once with a finger, then copy it once with a pencil while the model stays visible. Say ḍha when you finish."
            },
            {
              "kind": "speech",
              "text": "This is observe-and-copy with the model visible, not writing from memory."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
