        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: سپاه",
          "segments": [
            {
              "kind": "speech",
              "text": "سپاه (sepâh) — \"an army\"."
            },
            {
              "kind": "speech",
              "text": "سپاه (sepâh) شب به شهر رسید. Sepâh shab be shahr resid. The army reached the city at night."
            },
            {
              "kind": "speech",
              "text": "Literary and military; lashkar is a synonym."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "sepâh is a native Persian word that EtymDB glosses \"army\" without a parent; it is usually traced to Middle Persian spāh."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
