          "type": "input",
          "title": "You'll want to know: असली",
          "segments": [
            {
              "kind": "speech",
              "text": "असली — aslī — \"real, genuine\"."
            },
            {
              "kind": "speech",
              "text": "यह असली चाँदी है। yah aslī cā̃dī hai. This is real silver."
