            {
              "kind": "speech",
              "text": "Before the new one: say the Punjabi for an orange, then the Punjabi for a lemon."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ਨਾਸ਼ਤਾ",
          "segments": [
            {
              "kind": "speech",
              "text": "ਨਾਸ਼ਤਾ — nāshtā — \"breakfast\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ਨਾਸ਼ਤਾ (nāshtā) is a loan, usually traced to Persian nāshtā, \"not having eaten\". The meal is named for the fast it ends."
            }
          ]
        },
        {
