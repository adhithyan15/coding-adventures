              "instruction": "kuśalaḥ, once more",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *kuśalaḥ*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "say kuśalaḥ",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: say *kuśalaḥ*]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say the Sanskrit for blunt, then the Sanskrit for valuable, then say kuśalaḥ again",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say the Sanskrit for blunt, then the Sanskrit for valuable, then say *kuśalaḥ* again]"
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What does कुशलः (kuśalaḥ) mean? (\"Able, well\".) Say it once more."
