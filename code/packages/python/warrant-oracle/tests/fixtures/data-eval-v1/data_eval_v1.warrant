    heap <= 0
    depth <= 8
  bound op_var_ne:
    steps <= 64
    heap <= 0
    depth <= 8
  bound op_var_eq_lit:
    steps <= 64
    heap <= 0
    depth <= 8
  bound op_m_opt:
    steps <= 64
    heap <= 0
    depth <= 8
  bound op_m_opt_wild_arm:
    steps <= 64
    heap <= 0
    depth <= 8
  bound op_m_opt_nested:
    steps <= 64
    heap <= 0
    depth <= 8
  bound op_m_opt_tuple:
    steps <= 64
    heap <= 0
    depth <= 8
  bound op_m_bool:
    steps <= 64
    heap <= 0
    depth <= 8
  bound op_m_tuple_bool:
    steps <= 64
    heap <= 0
    depth <= 8
  bound op_m_point:
    steps <= 64
    heap <= 0
    depth <= 8
