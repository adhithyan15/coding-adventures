    {
      "id": "ZH-W127-xie-few",
      "sequence": 10205,
      "title": "些 (xiē) — two small pieces over 二",
      "headword": "些",
      "romanization": "xiē",
      "gloss": "些 — two small pieces side by side, over 二",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:b90f47d3049215d5",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — two small pieces over 二",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — two small pieces over 二 and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say zhèxiē — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *zhèxiē* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "这 二."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — zhè, èr",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *zhè*, *èr*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — two small pieces over 二",
          "segments": [
            {
              "kind": "speech",
              "text": "些 (xiē)."
            },
            {
              "kind": "speech",
              "text": "Three pieces: two side by side on top, then 二 underneath."
            },
            {
              "kind": "speech",
              "text": "The top left piece, four strokes. A short vertical, a short horizontal from its middle to the right, a shorter vertical to the left of the first, then a stroke along the foot that rises to the right."
            },
            {
              "kind": "speech",
              "text": "The top right piece, two strokes. A short left-falling stroke, then a vertical that bends to the right along the bottom and hooks up."
            },
            {
              "kind": "speech",
              "text": "二, two strokes: the short bar, then the long one beneath it."
            },
            {
              "kind": "speech",
              "text": "4 + 2 + 2 = eight."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "些 (xiē), all eight, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 些, all eight, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many pieces in 些 (xiē)? (Three.) Which character you know sits at the bottom? (二.) How does the sixth stroke end? (It bends right along the bottom and hooks up.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 些 (xiē), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
