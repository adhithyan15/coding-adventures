      "id": "TE-C90-care",
      "sequence": 3340,
      "title": "జాగ్రత్త (jāgratta) — care, caution",
      "headword": "జాగ్రత్త",
      "romanization": "jāgratta",
      "gloss": "care, caution",
      "script": "telugu",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:32a651f672cec8cf",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Telugu for a wedding, then the Telugu for an address."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: జాగ్రత్త",
          "segments": [
            {
              "kind": "speech",
              "text": "జాగ్రత్త (jāgratta) — \"care, caution\"."
            },
            {
              "kind": "speech",
              "text": "జాగ్రత్తగా వెళ్ళండి — \"go carefully\", what a host says at the door, where English says \"take care\". The -గా is the ending that makes a manner."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "జాగ్రత్త (jāgratta) comes from Sanskrit jāgrat, \"waking, wakefulness\" (CDIAL 5174), reshaped to Telugu sounds: a tadbhava. Caution is staying awake."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "The kindest thing to say to someone leaving."
            }
          ]
        },
        {
          "index": 4,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "jāgratta",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *jāgratta*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "jāgratta, once more",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *jāgratta*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "say jāgrattagā veḷḷaṇḍi",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: say *jāgrattagā veḷḷaṇḍi*]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say the Telugu for a wedding, then the Telugu for an address, then say jāgratta again",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say the Telugu for a wedding, then the Telugu for an address, then say *jāgratta* again]"
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What does జాగ్రత్త (jāgratta) mean? (\"Care, caution\".) Say it once more."
            }
          ]
        }
      ]
    },
