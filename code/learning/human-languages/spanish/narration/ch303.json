    {
      "id": "ES-C303-ayuda",
      "sequence": 4270,
      "title": "la ayuda — the word that stands beside you",
      "headword": "la ayuda",
      "romanization": "la ayuda",
      "gloss": "help — Latin adiutare, to bring strength toward someone; the same root gives English aid",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
