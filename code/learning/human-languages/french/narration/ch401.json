          "segments": [
            {
              "kind": "speech",
              "text": "caler — \"to stall (an engine); to wedge\"."
            },
            {
              "kind": "speech",
              "text": "Au feu rouge, j'ai calé deux fois. At the red light I stalled twice."
            },
            {
              "kind": "speech",
              "text": "Je cale also means I give up, I cannot eat any more."
            }
          ]
        },
