        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: iūmentum, iūmentī",
          "segments": [
            {
              "kind": "speech",
              "text": "iūmentum, iūmentī — \"a beast of burden, a draught animal\"."
            },
            {
              "kind": "speech",
              "text": "Iūmenta sarcinās mercātōrum per montēs portant. Pack animals carry the merchants' bags over the mountains."
            },
            {
              "kind": "speech",
              "text": "Second declension, neuter: iūmentum, iūmentī n. Any animal that pulls or carries: horse, mule, ass or ox."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "iūmentum is usually traced to iungō 'to yoke' (Lewis & Short, from an older iugimentum): an animal put under the yoke. EtymDB lists it without a parent, so the line is hedged."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
