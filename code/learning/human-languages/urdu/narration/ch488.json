          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "بیاہنا (byāhnā) is inherited from Sanskrit vivāhayati, \"leads away (a bride), marries\" (CDIAL 11923)."
            }
