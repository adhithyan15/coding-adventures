        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: سحب",
          "segments": [
            {
              "kind": "speech",
              "text": "سحب — saḥaba — \"to pull; to withdraw (money)\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "سحب (saḥaba) is built on the native Arabic root s-ḥ-b, \"to drag, to draw along\" (Lane). Saḥaba is the plain verb, \"he pulled\"."
            }
          ]
        },
        {
