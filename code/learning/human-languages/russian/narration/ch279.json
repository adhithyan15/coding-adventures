        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: известие",
          "segments": [
            {
              "kind": "speech",
              "text": "известие (izvéstiye) — \"a piece of news, a report\"."
            },
            {
              "kind": "speech",
              "text": "Мы получили известие о его приезде. My poluchíli izvéstiye o yevó priyézde. We received news of his arrival."
            },
            {
              "kind": "speech",
              "text": "More formal than новость. Neuter; plural известия."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "известие (izvéstiye) is built on весть \"news, tidings\", from the old Slavic root of ведать \"to know\", which goes back to PIE weyd- \"to see, to know\" (EtymDB lists известие (izvéstiye) \"news\" with no parent)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
