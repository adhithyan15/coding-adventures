            },
            {
              "kind": "speech",
              "text": "Before the new one: say the French for the tourniquet, then the French for the stretcher."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: l'alerte",
          "segments": [
            {
              "kind": "speech",
              "text": "l'alerte — \"the alert, the alarm\"."
            },
            {
              "kind": "speech",
              "text": "L'alerte a été donnée à trois heures du matin. The alarm was raised at three in the morning."
            },
            {
              "kind": "speech",
              "text": "Donner l'alerte — to raise the alarm; une alerte à la bombe — a bomb scare."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "alerte is usually traced to Italian all'erta \"on the lookout, on the height\" (EtymDB lists the French word without a parent)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
            }
          ]
        },
