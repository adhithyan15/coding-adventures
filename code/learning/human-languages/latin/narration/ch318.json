          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "flagrō is inherited from Proto-Italic flagros, \"burning\" (EtymDB), of the same family as flamma, \"flame\". English flagrant comes from it."
            }
          ]
        },
