        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: صرخ",
          "segments": [
            {
              "kind": "speech",
              "text": "صرخ — ṣarakha — \"to shout, to scream\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "صرخ (ṣarakha) is built on the native Arabic root ṣ-r-kh, \"to cry out\" (Lane). Ṣarakha is the plain verb, \"he cried out\"."
            }
          ]
        },
