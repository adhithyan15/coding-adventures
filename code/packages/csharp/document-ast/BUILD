# Build first with the same filter used by the test so a clean project-reference
# graph contains the instrumented production assembly before --no-build runs.
mkdir -p .dotnet/tmp .artifacts && HOME="$PWD/.dotnet" TMPDIR="$PWD/.dotnet/tmp" DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1 DOTNET_CLI_HOME="$PWD/.dotnet" dotnet build tests/CodingAdventures.DocumentAst.Tests/CodingAdventures.DocumentAst.Tests.csproj --disable-build-servers --artifacts-path .artifacts /p:CollectCoverage=true "/p:Include=[CodingAdventures.DocumentAst]*" && HOME="$PWD/.dotnet" TMPDIR="$PWD/.dotnet/tmp" DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1 DOTNET_CLI_HOME="$PWD/.dotnet" dotnet test tests/CodingAdventures.DocumentAst.Tests/CodingAdventures.DocumentAst.Tests.csproj --no-build --disable-build-servers --artifacts-path .artifacts /p:CollectCoverage=true /p:Threshold=95 /p:ThresholdType=line "/p:Include=[CodingAdventures.DocumentAst]*"
