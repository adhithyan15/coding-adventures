          "title": "You'll want to know: acampar",
          "segments": [
            {
              "kind": "speech",
              "text": "acampar — \"to camp\"."
            },
            {
              "kind": "speech",
              "text": "Acampámos perto de um lago. We camped near a lake."
            },
            {
              "kind": "speech",
              "text": "Acampar in the wild is not allowed everywhere."
