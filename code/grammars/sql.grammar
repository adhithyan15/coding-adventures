# Parser grammar for SQL (ANSI SQL subset)
# @version 2
#
# UPPERCASE identifiers reference token types from sql.tokens.
# Quoted strings match keyword values (normalized to uppercase by the lexer
# because sql.tokens uses @case_insensitive true).
#
# Entry point: program

program           = statement { ";" statement } [ ";" ] ;

statement         = query_stmt | insert_stmt | replace_stmt | update_stmt
                  | delete_stmt | create_table_stmt | drop_table_stmt
                  | alter_table_stmt
                  | create_index_stmt | drop_index_stmt
                  | create_view_stmt | drop_view_stmt
                  | create_trigger_stmt | drop_trigger_stmt
                  | begin_stmt | commit_stmt | rollback_to_stmt | rollback_stmt
                  | savepoint_stmt | release_stmt
                  | attach_stmt | detach_stmt ;

# ATTACH DATABASE — accept the syntax for ORM/migration compatibility.
# Mini-sqlite has no multi-database support; ATTACH and DETACH are no-ops.
# The DATABASE keyword is optional in SQLite ("ATTACH 'file' AS x" also works).
attach_stmt       = "ATTACH" [ "DATABASE" ] expr "AS" NAME ;
detach_stmt       = "DETACH" [ "DATABASE" ] NAME ;

# ── QUERY (SELECT + set operations) ──────────────────────────────────────────
#
# A query_stmt wraps a bare select_stmt and allows zero-or-more set-operation
# tails (UNION / INTERSECT / EXCEPT).  The adapter checks whether any tails
# are present to decide whether to emit a SetOpStmt or a plain SelectStmt.
#
# Precedence note: SQL standard gives INTERSECT higher precedence than
# UNION/EXCEPT.  For the educational subset we treat all three as left-
# associative equals; ANSI-compliant precedence can be added later.

# A query_stmt is either (a) the usual SELECT-plus-set-op-tails form, or
# (b) a bare VALUES list.  SQLite accepts ``VALUES (1,2), (3,4)`` as a
# standalone query and inside any context that takes a query_stmt
# (derived tables, CTE bodies, set-op operands).  We model VALUES as a
# parallel branch here so it plugs into all those slots without each
# call site having to special-case the keyword.
#
# The two branches are mutually exclusive: a real SELECT always starts
# with SELECT or WITH, while VALUES starts with the eponymous keyword,
# so the parser can pick deterministically (no backtracking pain).
query_stmt        = [ with_clause ] ( values_stmt | select_stmt ) { set_op_clause } ;
# VALUES list: one or more parenthesised tuples of expressions,
# comma-separated.  SQLite names the output columns ``column1``,
# ``column2``, … (1-indexed) when no explicit alias list is given.  The
# adapter desugars the VALUES into a left-deep UNION-ALL chain of
# single-row SELECTs so downstream layers (planner, codegen, VM) see
# only constructs they already handle.
values_stmt       = "VALUES" row_value { "," row_value } ;
with_clause       = "WITH" [ "RECURSIVE" ] cte_def { "," cte_def } ;
# The optional [NOT] MATERIALIZED hint (SQLite 3.35+) tells the planner
# whether to materialise the CTE result set.  Mini-sqlite has no
# cost-based optimizer, so the hint is parsed and silently ignored;
# applications using it for portability with real SQLite still parse.
cte_def           = NAME [ "(" NAME { "," NAME } ")" ] "AS"
                    [ [ "NOT" ] "MATERIALIZED" ]
                    "(" query_stmt ")" ;
set_op_clause     = ( "UNION" | "INTERSECT" | "EXCEPT" ) [ "ALL" ]
                    ( values_stmt | select_stmt ) ;

# ── SELECT ───────────────────────────────────────────────────────────────────

select_stmt       = "SELECT" [ "DISTINCT" | "ALL" ] select_list
                    [ "FROM" table_ref { join_clause } ]
                    [ where_clause ] [ group_clause ] [ having_clause ]
                    [ window_clause ] [ order_clause ] [ limit_clause ] ;

select_list       = STAR | select_item { "," select_item } ;
select_item       = expr [ "AS" NAME ] ;

# table_ref: try derived-table form first (starts with "(") then plain name.
# PEG backtracking ensures "(SELECT ...)" matches the first branch and
# "users" or "users AS u" or "users u" (alias without AS) matches the
# second branch.  The derived-table alias is optional in SQLite (matching
# standard SQL): both ``(SELECT …) AS t``, ``(SELECT …) t``, and bare
# ``(SELECT …)`` are accepted.  When no alias is given, the outer query
# may still reference columns by their unqualified names.
# NAME never matches SQL keywords, so WHERE, JOIN, ON etc. are never eaten.
#
# An optional ``index_hint`` may follow the table name (not derived
# tables — SQLite only allows the hint on base tables).  Two forms:
#
#   * ``INDEXED BY <index-name>`` — force the planner to use the named
#     index.  Errors at plan time if the index doesn't exist on the
#     table.
#   * ``NOT INDEXED`` — instruct the planner to use a full table scan
#     and ignore any matching indexes.
#
# Both forms are SQLite-only query hints; standard SQL ignores them.
table_ref         = "(" query_stmt ")" [ [ "AS" ] NAME ]
                  | table_name [ "AS" NAME | NAME ] [ index_hint ] ;
table_name        = NAME [ "." NAME ] ;
index_hint        = "INDEXED" "BY" NAME | "NOT" "INDEXED" ;

# join_clause covers two forms:
#   1. Explicit JOIN:  [ join_type ] "JOIN" table_ref [ "ON" expr | "USING" (...) ]
#   2. Comma join:     "," table_ref
# The comma form is an implicit CROSS JOIN — semantically equivalent to
# CROSS JOIN with no ON condition.  Both forms produce a join_clause node
# so the adapter can handle them uniformly.
join_clause       = ( [ join_type ] "JOIN" table_ref [ "ON" expr | "USING" "(" NAME { "," NAME } ")" ] )
                  | ( "," table_ref ) ;
join_type         = "CROSS" | "INNER" | "NATURAL"
                  | ( "LEFT" [ "OUTER" ] )
                  | ( "RIGHT" [ "OUTER" ] ) | ( "FULL" [ "OUTER" ] ) ;

where_clause      = "WHERE" expr ;
group_clause      = "GROUP" "BY" column_ref { "," column_ref } ;
having_clause     = "HAVING" expr ;
order_clause      = "ORDER" "BY" order_item { "," order_item } ;
# order_item: expr followed by optional ``COLLATE name`` clause,
# optional direction (ASC|DESC), and optional null-placement clause
# (NULLS FIRST | NULLS LAST).
#
# The collation name (``BINARY`` / ``NOCASE`` / ``RTRIM`` in standard
# SQLite, plus any user-registered ones) is a comparison transform
# applied to each value before the sort comparator runs.  The
# adapter stores the name on ``SortKey.collation`` and the VM
# normalises values accordingly when building the sort key.
#
# The null-placement clause is SQLite 3.30+ syntax; mini-sqlite
# honours it via the planner's ``SortKey.nulls_first`` field.
# Omitting it falls back to SQLite's defaults (NULLs first for ASC,
# NULLs last for DESC).
#
# ``FIRST`` and ``LAST`` are intentionally NOT in the keyword list —
# they are extremely common as column names (``first_name``,
# ``last``).  The grammar accepts a generic NAME after NULLS; the
# adapter validates it is one of those two literal tokens
# (case-insensitive).
order_item        = expr [ "COLLATE" NAME ] [ "ASC" | "DESC" ]
                    [ "NULLS" NAME ] ;
limit_clause      = "LIMIT" signed_number
                    [ "OFFSET" signed_number
                    | "," signed_number ] ;
# ``signed_number`` is an optional ``-`` prefix followed by a NUMBER
# token.  SQLite documents a *negative* LIMIT as "no limit"
# (unbounded), useful for ``LIMIT -1 OFFSET N`` to mean "skip N rows
# and return the rest".  The lexer emits the sign as a separate
# MINUS token, so the grammar reads it explicitly here.
#
# The trailing ``, signed_number`` alternative is SQLite's
# MySQL-compatible shorthand: ``LIMIT m, n`` means ``LIMIT n OFFSET
# m`` — the FIRST number is the offset and the SECOND is the count
# (note the reversed argument order vs the ``OFFSET`` form).  This
# syntax exists for compatibility with MySQL queries and is the only
# place in the language where the count/offset ordering swaps.
signed_number     = [ "-" ] NUMBER ;

# ── INSERT / UPDATE / DELETE ─────────────────────────────────────────────────
#
# INSERT ... SELECT is handled by making insert_body an alternative:
#   "VALUES" row_value ...   — classic VALUES insert
#   query_stmt               — INSERT INTO t SELECT ...
#
# Conflict resolution (SQLite extension):
#   INSERT OR REPLACE INTO t ...   — delete conflicting rows, then insert
#   INSERT OR IGNORE INTO t ...    — silently skip on constraint violation
#   INSERT OR ABORT INTO t ...     — raise error and abort transaction (default)
#   INSERT OR FAIL INTO t ...      — raise error, keep prior inserts
#   INSERT OR ROLLBACK INTO t ...  — raise error and roll back transaction
#
# conflict_clause captures the "OR <action>" part; the planner propagates
# the action string into the Insert plan node for the VM to act on.
#
# REPLACE INTO t ... is SQLite shorthand for INSERT OR REPLACE INTO t ...;
# it is represented as a separate replace_stmt rule so the PEG parser does
# not need to backtrack from a failed INSERT attempt to try REPLACE.

conflict_clause   = "OR" ( "REPLACE" | "IGNORE" | "ABORT" | "FAIL" | "ROLLBACK" ) ;

insert_stmt       = "INSERT" [ conflict_clause ] "INTO" NAME
                    [ "(" NAME { "," NAME } ")" ]
                    insert_body
                    [ upsert_clause ]
                    [ returning_clause ] ;

# ON CONFLICT upsert clause (SQLite 3.24+):
#   ON CONFLICT (col {, col}) DO NOTHING
#   ON CONFLICT (col {, col}) DO UPDATE SET col = expr {, col = expr}
#   ON CONFLICT DO NOTHING  (no target = any unique constraint)
#   ON CONFLICT DO UPDATE SET ...
#
# EXCLUDED is a pseudo-table alias for the would-be-inserted row values.
# It parses as a regular column_ref (table="EXCLUDED", col=NAME) because
# EXCLUDED is a keyword-that-looks-like-a-name; the adapter rewrites
# Column(table="EXCLUDED", col=c) → ExcludedColumn(col=c).

upsert_clause     = "ON" "CONFLICT"
                    [ "(" NAME { "," NAME } ")" ]
                    ( "DO" "NOTHING"
                    | "DO" "UPDATE" "SET" upsert_assignment { "," upsert_assignment }
                      [ where_clause ] ) ;

upsert_assignment = NAME "=" expr ;
replace_stmt      = "REPLACE" "INTO" NAME
                    [ "(" NAME { "," NAME } ")" ]
                    insert_body
                    [ returning_clause ] ;
insert_body       = "VALUES" row_value { "," row_value }
                  | "DEFAULT" "VALUES"
                  | query_stmt ;
# ``DEFAULT VALUES`` (SQLite-only): insert a single row consisting
# entirely of column defaults.  Equivalent to omitting every column
# value — useful when the table has an INTEGER PRIMARY KEY plus all
# other columns have DEFAULT clauses (or are NULLable).
row_value         = "(" expr { "," expr } ")" ;
# row_value_list is used by row-value comparisons: (a,b) IN ((x,y),(p,q))
row_value_list    = row_value { "," row_value } ;

update_stmt       = "UPDATE" NAME "SET" assignment { "," assignment }
                    [ where_clause ] [ returning_clause ] ;
assignment        = NAME "=" expr ;

delete_stmt       = "DELETE" "FROM" NAME [ where_clause ] [ returning_clause ] ;

returning_clause  = "RETURNING" returning_item { "," returning_item } ;
# RETURNING accepts ``*`` (shorthand for every column of the target
# table, in declaration order) as well as ordinary expressions —
# matches SQLite's RETURNING grammar.
returning_item    = "*" | expr ;

# ── CREATE TABLE / DROP TABLE ─────────────────────────────────────────────────

create_table_stmt = "CREATE" "TABLE" [ "IF" "NOT" "EXISTS" ] NAME
                    "(" col_def { "," col_def } ")"
                    [ table_options ] ;
# Trailing table options (SQLite 3.8.2+ / 3.37+ extensions):
#   WITHOUT ROWID — store rows in the primary-key B-tree instead of a
#                   rowid table.  Mini-sqlite accepts and ignores.
#   STRICT        — enforce strict typing per column.  Mini-sqlite accepts
#                   and ignores; type affinity remains lenient.
# Multiple options may be comma-separated.
table_options     = table_option { "," table_option } ;
table_option      = "STRICT" | "WITHOUT" NAME ;
# Note: in `WITHOUT NAME`, the NAME is expected to be "rowid" (case-
# insensitive).  We don't model ROWID as a keyword because it is widely
# used as a column name in SQLite (`SELECT rowid FROM t`); making it a
# keyword would break those queries.
col_def           = NAME col_type { col_constraint } ;
# col_type accepts simple names (INTEGER, TEXT) and parameterised types
# (VARCHAR(8), DECIMAL(10,2)) — the length/precision arguments are parsed
# but ignored; the engine uses SQLite's type-affinity rules internally.
col_type          = NAME [ "(" NUMBER { "," NUMBER } ")" ] ;
col_constraint    = ( "NOT" "NULL" ) | "NULL" | ( "PRIMARY" "KEY" [ "AUTOINCREMENT" ] )
                  | "UNIQUE" | ( "DEFAULT" primary )
                  | ( "CHECK" "(" expr ")" )
                  | ( "COLLATE" NAME )
                  | ( "REFERENCES" NAME [ "(" NAME ")" ] ) ;
# AUTOINCREMENT (SQLite-only): only valid immediately after PRIMARY KEY on
# an INTEGER column.  The engine recognises the keyword and sets
# ``ColumnDef.autoincrement = True``; behaviour is "rowids monotonically
# increase, never reuse a deleted id" — already true in our in-memory
# backend because _next_rowid is never decremented.

drop_table_stmt   = "DROP" "TABLE" [ "IF" "EXISTS" ] NAME ;

# ALTER TABLE — four forms, matching SQLite:
#   ALTER TABLE t ADD [COLUMN] col_def       (forever)
#   ALTER TABLE t RENAME TO new_name         (forever)
#   ALTER TABLE t RENAME [COLUMN] old TO new (SQLite 3.25+)
#   ALTER TABLE t DROP [COLUMN] col_name     (SQLite 3.35+)
#
# The COLUMN keyword is optional everywhere (matches SQLite behaviour).
alter_table_stmt  = "ALTER" "TABLE" NAME (
                      "ADD" [ "COLUMN" ] col_def
                    | "RENAME" "TO" NAME
                    | "RENAME" [ "COLUMN" ] NAME "TO" NAME
                    | "DROP" [ "COLUMN" ] NAME
                    ) ;

# ── CREATE INDEX / DROP INDEX ─────────────────────────────────────────────────
#
# CREATE [UNIQUE] INDEX [IF NOT EXISTS] name ON table (col1, col2, ...)
# DROP INDEX [IF EXISTS] name
#
# The UNIQUE flag is stored but not enforced in v2 (reserved for v3).

create_index_stmt = "CREATE" [ "UNIQUE" ] "INDEX" [ "IF" "NOT" "EXISTS" ] NAME
                    "ON" NAME "(" index_col { "," index_col } ")"
                    [ where_clause ] ;
# index_col: a column name (or arbitrary expression) with an optional
# COLLATE clause and sort direction (ASC or DESC).
#
# Expression form (SQLite "indexed expression"):
#   CREATE INDEX idx ON t(LOWER(name))
#   CREATE INDEX idx ON t(name COLLATE NOCASE, age DESC)
# Mini-sqlite parses these without using the expression for actual indexing —
# the index becomes a no-op for lookups that involve the expression.  This
# unlocks ORM/migration code that creates such indexes without affecting
# correctness (only performance).
#
# The direction hint and COLLATE name are accepted for SQLite compatibility
# but ignored by the backend (B-tree indexes are bidirectional at query time;
# only BINARY collation is implemented).
index_col         = expr [ "COLLATE" NAME ] [ "ASC" | "DESC" ] ;

drop_index_stmt   = "DROP" "INDEX" [ "IF" "EXISTS" ] NAME ;

# ── CREATE VIEW / DROP VIEW ───────────────────────────────────────────────────
#
# Views are named, persistent queries that expand to their defining SELECT
# when referenced in FROM / JOIN.  The body is any full query_stmt (WITH,
# UNION, etc. are allowed).

create_view_stmt  = "CREATE" "VIEW" [ "IF" "NOT" "EXISTS" ] NAME "AS" query_stmt ;

drop_view_stmt    = "DROP" "VIEW" [ "IF" "EXISTS" ] NAME ;

# ── TRANSACTIONS ──────────────────────────────────────────────────────────────
#
# Optional TRANSACTION keyword mirrors SQLite's accepted syntax.

begin_stmt        = "BEGIN"    [ "TRANSACTION" ] ;
commit_stmt       = "COMMIT"   [ "TRANSACTION" ] ;
rollback_stmt     = "ROLLBACK" [ "TRANSACTION" ] ;

# ── SAVEPOINTS ────────────────────────────────────────────────────────────────
#
# SAVEPOINT / RELEASE / ROLLBACK TO let a transaction be partially rolled back
# to a named point without discarding all outstanding changes.
#
# rollback_to_stmt uses "ROLLBACK" "TO" (no TRANSACTION) to distinguish it from
# rollback_stmt. rollback_to_stmt must appear BEFORE rollback_stmt in the
# statement alternation so the PEG parser tries it first.
#
# SQLite-compatible syntax:
#   SAVEPOINT name
#   RELEASE [SAVEPOINT] name
#   ROLLBACK TO [SAVEPOINT] name

savepoint_stmt    = "SAVEPOINT" NAME ;
release_stmt      = "RELEASE" [ "SAVEPOINT" ] NAME ;
rollback_to_stmt  = "ROLLBACK" "TO" [ "SAVEPOINT" ] NAME ;

# ── Expressions ───────────────────────────────────────────────────────────────

expr              = or_expr ;
or_expr           = and_expr { "OR" and_expr } ;
and_expr          = not_expr { "AND" not_expr } ;
not_expr          = "NOT" not_expr | comparison ;
# ``collated`` wraps a ``bitwise`` expression with an optional
# ``COLLATE name`` postfix.  SQLite places COLLATE one level higher
# than every binary operator except unary prefix (-, ~, +): so
# ``x * y COLLATE z`` is ``(x * y) COLLATE z`` (multiplicative binds
# tighter than COLLATE — bitwise is inside multiplicative inside
# collated), and ``x COLLATE y = z`` is ``(x COLLATE y) = z``
# (COLLATE binds tighter than the comparison operators).
#
# Comparisons (and BETWEEN/IN/LIKE/GLOB/IS …) use ``collated`` as
# their operand grammar so the postfix is accepted on either side
# of any comparison.  The COLLATE clause is also accepted in ORDER
# BY items separately (see ``order_item``).
collated          = bitwise [ "COLLATE" NAME ] ;
# Row-value comparisons: (a,b) = (c,d), (a,b) IN ((x,y),...).
# These three alternatives must precede the scalar ``collated [...]`` form
# so the PEG parser tries row_value first when it sees "(".  The NOT IN
# alternative comes before IN so "NOT" is not left unconsumed.
comparison        = row_value cmp_op row_value
                  | row_value "NOT" "IN" "(" row_value_list ")"
                  | row_value "IN" "(" row_value_list ")"
                  | collated [ cmp_op collated
                  | "BETWEEN" collated "AND" collated
                  | "NOT" "BETWEEN" collated "AND" collated
                  | "IN" "(" [ in_expr ] ")"
                  | "NOT" "IN" "(" [ in_expr ] ")"
                  | "LIKE" collated [ "ESCAPE" collated ]
                  | "NOT" "LIKE" collated [ "ESCAPE" collated ]
                  | "GLOB" collated
                  | "NOT" "GLOB" collated
                  | "IS" "NULL"
                  | "IS" "NOT" "NULL"
                  | "IS" "DISTINCT" "FROM" collated
                  | "IS" "NOT" "DISTINCT" "FROM" collated
                  | "IS" "NOT" collated
                  | "IS" collated ] ;
# The last two alternatives implement SQLite's NULL-safe equality
# operator.  ``x IS y`` is equivalent to ``x IS NOT DISTINCT FROM y``
# (NULLs compare equal to each other, never to anything else); ``x IS
# NOT y`` is the negation.  Order matters in this PEG grammar: the
# more specific ``IS NULL`` / ``IS NOT NULL`` / ``IS [NOT] DISTINCT
# FROM`` alternatives must precede the general ``IS [NOT] collated``
# forms so they get the first shot at matching their keyword tails.

# in_expr: a subquery takes priority (starts with SELECT); otherwise a
# comma-separated value list is used.
in_expr           = query_stmt | value_list ;

cmp_op            = "=" | NOT_EQUALS | "<" | ">" | "<=" | ">=" ;
# SQLite operator-precedence ladder (lowest to highest as you read down):
#
#   OR
#   AND
#   NOT
#   comparison / IN / LIKE / IS …    ← consumes the ``bitwise`` group below
#   bitwise:   & | << >>             ← new layer, between additive and cmp
#   additive:  + - || -> ->>
#   multiplicative: * / %
#   unary:     - ~ +
#   primary
#
# (Reference: https://sqlite.org/lang_expr.html#operators )
bitwise           = additive { ( "&" | "|" | "<<" | ">>" ) additive } ;
additive          = multiplicative { ( "+" | "-" | "||" | JSON_ARROW | JSON_ARROW_TEXT ) multiplicative } ;
multiplicative    = unary { ( STAR | "/" | "%" ) unary } ;
# Unary prefix operators.  ``+`` is the no-op identity (``+5`` ≡ ``5``)
# — matches SQLite, which documents it as "a valid no-op".  ``-`` is
# arithmetic negation; ``~`` is bitwise NOT (coerces to int64).  All
# three share the same precedence level so ``-+5`` parses as ``-(+5)``
# and ``++5`` parses as ``+(+5)``.
unary             = ( "-" | "~" | "+" ) unary | primary ;

# primary: order matters for PEG backtracking.
#   1. Simple literals
#   2. CASE expression (starts with "CASE" keyword)
#   3. CAST expression — "CAST" "(" expr "AS" NAME ")" — must come before
#      function_call because CAST is now a keyword; function_call uses NAME
#      which never matches keywords.
#   4. Window function call — NAME "(" … ")" "OVER" "(" … )" — tried BEFORE
#      plain function_call because both start with NAME "(" but only the window
#      form has the trailing OVER keyword; PEG will backtrack to function_call
#      if OVER is absent.
#   5. Function call (NAME "(" — checked before bare column_ref)
#   6. EXISTS subquery — starts with KEYWORD "EXISTS", unambiguous
#   7. Scalar subquery "(SELECT ...)" — tried before plain "(" expr ")"
#      because query_stmt starts with "SELECT" which is a KEYWORD, not valid
#      as a plain expression; backtrack if the first token inside "(" is not
#      "SELECT".
#   8. Bare column reference NAME [. NAME]
#   9. Parenthesised expression "(" expr ")"
primary           = NUMBER | STRING | BLOB | "NULL" | "TRUE" | "FALSE"
                  | case_expr
                  | cast_expr
                  | window_func_call
                  | function_call
                  | "EXISTS" "(" query_stmt ")"
                  | "(" query_stmt ")"
                  | column_ref
                  | "(" expr ")" ;

column_ref        = NAME [ "." NAME ] ;
# function_call accepts:
#   NAME or "REPLACE"  — REPLACE() is a keyword that is also a scalar function
#   (STAR | "DISTINCT" value_list | [value_list])
#     COUNT(*)           — star form
#     COUNT(DISTINCT x)  — DISTINCT aggregate
#     f(x, y, …)        — regular args (value_list is optional for zero-arg calls)
#
# Optional trailing FILTER clause (SQL:2003 / SQLite extension):
#   COUNT(*) FILTER (WHERE active = 1)
#   SUM(salary) FILTER (WHERE dept = 'eng')
# The FILTER expression is a boolean predicate evaluated per row before the
# aggregate accumulator is updated.  Rows for which the predicate is false (or
# NULL) are silently skipped, as if they had not been scanned.
function_call     = (NAME | "REPLACE") "(" ( STAR | "DISTINCT" value_list | [ value_list ] ) ")" [ filter_clause ] ;

# filter_clause = FILTER "(" WHERE expr ")"
# Attached to an aggregate function call to restrict which rows are accumulated.
filter_clause     = "FILTER" "(" "WHERE" expr ")" ;

# cast_expr: CAST(expr AS type_name)
# CAST is a keyword so it cannot appear in function_call (which uses NAME).
# type_name is a single NAME token (e.g. INTEGER, TEXT, REAL, BLOB, NUMERIC).
# The AS inside CAST is consumed here, not treated as a column alias.
cast_expr         = "CAST" "(" expr "AS" NAME ")" ;

# ── WINDOW FUNCTIONS ──────────────────────────────────────────────────────────
#
# Window (analytic) functions compute a value across a set of rows related to
# the current row — the "window" — without collapsing rows the way GROUP BY
# does.  Every window function call carries an OVER clause that defines the
# window frame: an optional PARTITION BY partitions rows into independent
# groups and an optional ORDER BY orders rows within each partition.
#
# Supported functions:
#   ROW_NUMBER()          — sequential integer rank within partition (1-based)
#   RANK()                — rank with gaps for ties
#   DENSE_RANK()          — rank without gaps
#   SUM(expr) / COUNT(expr) / COUNT(*) / AVG(expr) / MIN(expr) / MAX(expr)
#               — running aggregate over the full partition
#   FIRST_VALUE(expr)     — first value in the ordered partition
#   LAST_VALUE(expr)      — last value in the ordered partition
#
# Grammar:
#   window_func_call  — the full call site (function name + args + OVER spec)
#   window_spec       — the parenthesised window frame definition
#   partition_clause  — PARTITION BY expr { , expr }  (optional)
#   order_clause      — ORDER BY order_item { , order_item }  (already defined)
#
# window_func_call is tried before plain function_call in the primary rule;
# PEG backtracking ensures NAME "(" without a following OVER falls through to
# function_call.

window_func_call  = NAME "(" ( STAR | [ value_list ] ) ")" "OVER" ( "(" window_spec ")" | window_name_ref ) ;
window_name_ref   = NAME ;
window_spec       = [ partition_clause ] [ order_clause ] [ frame_clause ] ;
window_clause     = "WINDOW" NAME "AS" "(" window_spec ")" { "," NAME "AS" "(" window_spec ")" } ;
partition_clause  = "PARTITION" "BY" expr { "," expr } ;
value_list        = expr { "," expr } ;

# Window frame clause:  ROWS|RANGE|GROUPS  BETWEEN start AND end
#                    or ROWS|RANGE|GROUPS  start
#
# frame_unit selects the frame mode:
#   ROWS    — physical row positions
#   RANGE   — logical (peer-group) positions (SQLite default for ORDER BY)
#   GROUPS  — peer-group count positions
#
# frame_bound describes one endpoint:
#   UNBOUNDED PRECEDING  — start of the partition
#   CURRENT ROW          — the current row (or its peer group in RANGE mode)
#   expr PRECEDING       — n rows/peers before the current row
#   expr FOLLOWING       — n rows/peers after the current row
#   UNBOUNDED FOLLOWING  — end of the partition
#
# In the BETWEEN … AND … form:
#   BETWEEN <start> AND <end>
# In the shorthand form:
#   frame_unit frame_bound      (end is implicitly CURRENT ROW)

frame_clause  = frame_unit "BETWEEN" frame_bound "AND" frame_bound
              | frame_unit frame_bound ;
frame_unit    = "ROWS" | "RANGE" | "GROUPS" ;
frame_bound   = "UNBOUNDED" "PRECEDING"
              | "UNBOUNDED" "FOLLOWING"
              | "CURRENT" "ROW"
              | expr "PRECEDING"
              | expr "FOLLOWING" ;

# ── CREATE TRIGGER / DROP TRIGGER ────────────────────────────────────────────
#
# Triggers fire automatically when a DML event (INSERT, UPDATE, DELETE) occurs
# on the named table.  Two timings are supported: BEFORE (before the DML write)
# and AFTER (after the write).
#
# Grammar::
#
#   create_trigger_stmt =
#     "CREATE" "TRIGGER" NAME
#     ( "BEFORE" | "AFTER" ) ( "INSERT" | "UPDATE" | "DELETE" ) "ON" NAME
#     "FOR" "EACH" "ROW"
#     "BEGIN" trigger_body_stmt ";" { trigger_body_stmt ";" } "END" ;
#
#   trigger_body_stmt = insert_stmt | update_stmt | delete_stmt | query_stmt ;
#
# NEW and OLD pseudo-tables are referenced as ordinary NAME.NAME column
# references inside the body — they are not keywords, just contextual names.
# The executor injects single-row "NEW" and "OLD" tables at fire time.

create_trigger_stmt = "CREATE" "TRIGGER" NAME
                      ( "BEFORE" | "AFTER" ) ( "INSERT" | "UPDATE" | "DELETE" ) "ON" NAME
                      "FOR" "EACH" "ROW"
                      "BEGIN" trigger_body_stmt ";" { trigger_body_stmt ";" } "END" ;

trigger_body_stmt   = insert_stmt | replace_stmt | update_stmt | delete_stmt | query_stmt ;

drop_trigger_stmt   = "DROP" "TRIGGER" [ "IF" "EXISTS" ] NAME ;

# ── CASE expression ───────────────────────────────────────────────────────────
#
# Two forms of CASE, unified under one rule:
#
#   Searched CASE:  CASE WHEN c1 THEN v1 [WHEN c2 THEN v2 ...] [ELSE e] END
#   Simple CASE:    CASE x WHEN v1 THEN r1 [WHEN v2 THEN r2 ...] [ELSE e] END
#
# The optional `case_operand` captures the simple-CASE operand.  When the
# token immediately after CASE is WHEN, the optional `[ case_operand ]`
# returns nothing (expr cannot start with the WHEN keyword) and we fall
# straight into the `case_when` list.  The adapter converts simple CASE into
# equality comparisons so the planner only ever sees searched CASE.

case_expr         = "CASE" [ case_operand ] case_when { case_when } [ "ELSE" expr ] "END" ;
case_operand      = expr ;
case_when         = "WHEN" expr "THEN" expr ;
