        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "قرار (qarār) is built on the native Arabic root q-r-r, \"to settle, to be still\" (Lane). Qarār is a settling, hence a settled decision."
            }
          ]
        },
