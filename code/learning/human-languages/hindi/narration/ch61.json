      "id": "HI-C61-vessel",
      "sequence": 2260,
      "title": "बर्तन (bartan) — a cooking vessel",
      "headword": "बर्तन",
      "romanization": "bartan",
      "gloss": "a cooking vessel",
      "script": "devanagari",
      "modality": "voice",
      "derivedModality": "voice",
