        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ਦੌਲਤ",
          "segments": [
            {
              "kind": "speech",
              "text": "ਦੌਲਤ — daulat — \"wealth\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ਦੌਲਤ (daulat) is a loan from Arabic dawla, \"a turn of fortune; wealth; the state\", which reached Punjabi through Persian. Its Arabic root is d-w-l (Lane)."
            }
          ]
        },
