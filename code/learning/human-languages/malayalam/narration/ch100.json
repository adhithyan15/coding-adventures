        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What is a sari? (സാരി (sāri).) സാരി (sāri) ends in ഇ — what slides in before ആണ്? (യ — സാരിയാണ്.) And മുണ്ട് (muṇṭŭ)? (Nothing — മുണ്ടാണ്.)"
            }
          ]
        }
