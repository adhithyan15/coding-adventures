        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: शंखः",
          "segments": [
            {
              "kind": "speech",
              "text": "शंखः — śaṅkhaḥ — \"a conch\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "śaṅkha \"a conch-shell\" is old, in the Atharvaveda, and is inherited from Indo-European: MW sets it beside Greek konchē and Latin concha \"shell\", and EtymDB agrees. It lives on as Hindi saṅkh \"conch\" (CDIAL 12263)."
            }
          ]
        },
        {
