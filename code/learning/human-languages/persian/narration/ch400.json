        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: دانشکده",
          "segments": [
            {
              "kind": "speech",
              "text": "دانشکده (dâneshkade) — \"a faculty, a college\"."
            },
            {
              "kind": "speech",
              "text": "دانشکده پزشکی نزدیک بیمارستان است. dâneshkade-ye pezeshki nazdik-e bimârestân ast. The medical faculty is near the hospital."
            },
            {
              "kind": "speech",
              "text": "Dânesh \"knowledge\" + kade \"house\". A university has several dâneshkade."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "دانشکده (dâneshkade) is a native Persian compound built from dânesh \"knowledge\", from dânestan \"to know\", + kade \"house, dwelling\". A faculty is a house of knowledge."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
