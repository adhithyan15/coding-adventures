        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ఉక్కు (ukku) is native Dravidian. DEDR 661 lists ukku, \"steel\", with Malayalam urukku, \"fused metal, steel\", under the word for \"to melt\"."
            }
          ]
        },
