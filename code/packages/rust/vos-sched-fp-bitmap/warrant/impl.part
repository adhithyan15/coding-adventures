  -- The implementation block of vos-sched-fp-bitmap (VOS-011): a one-byte bitmap, bit i set
  -- when thread i is ready.  Bound operations, no bodies (R3); the behaviour is what the
  -- source does, and the claims of the contract's obligation blocks are what the evidence
  -- runs against it.  alpha_w reads the mask as the abstract set; build is its inverse.
  -- The `assume` rows are not here: gen-doc appends them.
  record Impl(mask: U8)
  record AbsW(w: U8)
  record CfgN(v: U8)
  model dec(x: AbsW) -> Ready = (
    Ready(not (bit_and(x.w, 1u8) == 0u8), not (bit_and(x.w, 2u8) == 0u8), not (bit_and(x.w, 4u8) == 0u8),
          not (bit_and(x.w, 8u8) == 0u8), not (bit_and(x.w, 16u8) == 0u8), not (bit_and(x.w, 32u8) == 0u8),
          not (bit_and(x.w, 64u8) == 0u8), not (bit_and(x.w, 128u8) == 0u8)))
  op init() -> Impl
  op insert_out(s: Impl, t: U8) -> Upd
  op insert_img(s: Impl, t: U8) -> Impl
  op remove_out(s: Impl, t: U8) -> Upd
  op remove_img(s: Impl, t: U8) -> Impl
  op dispatch_out(s: Impl) -> Pick
  op dispatch_img(s: Impl) -> Impl
  op alpha_w(s: Impl) -> AbsW
  op cfg_n() -> CfgN

  model b2m(b: Bool, k: Nat) -> U8 = if b then shl(1u8, k) else 0u8
  model build(m: Ready) -> Impl = (
    Impl(bit_or(bit_or(bit_or(bit_or(bit_or(bit_or(bit_or(b2m(m.p0, 0), b2m(m.p1, 1)), b2m(m.p2, 2)), b2m(m.p3, 3)),
           b2m(m.p4, 4)), b2m(m.p5, 5)), b2m(m.p6, 6)), b2m(m.p7, 7))))
  model inv_impl(s: Impl) -> Bool = true

  example n_is_eight:
    cfg_n() == CfgN(8u8)
  -- One worked step on a non-zero state.  An example over the zero state would be useless for
  -- a negative control: `field-zero` is inert on a field that is already zero (VOS02 13.4 F4).
  example insert_three_sets_bit_three:
    alpha_w(insert_img(init(), 3u8)) == AbsW(8u8)

  labels insert_out:
    s public
    t public
  labels insert_img:
    s public
    t public
  labels remove_out:
    s public
    t public
  labels remove_img:
    s public
    t public
  labels dispatch_out:
    s public
  labels dispatch_img:
    s public
  labels alpha_w:
    s public

  input insert_out.s:
    hostile
    ensures no_panic, terminates
  input insert_out.t:
    hostile
    ensures no_panic, terminates
  input insert_img.s:
    hostile
    ensures no_panic, terminates
  input insert_img.t:
    hostile
    ensures no_panic, terminates
  input remove_out.s:
    hostile
    ensures no_panic, terminates
  input remove_out.t:
    hostile
    ensures no_panic, terminates
  input remove_img.s:
    hostile
    ensures no_panic, terminates
  input remove_img.t:
    hostile
    ensures no_panic, terminates
  input dispatch_out.s:
    hostile
    ensures no_panic, terminates
  input dispatch_img.s:
    hostile
    ensures no_panic, terminates
  input alpha_w.s:
    hostile
    ensures no_panic, terminates

  -- Bounds.  `steps` rows are the contract ceilings (VOS10 section 7).  The `heap <= 0` row is
  -- declared only for the two operations whose answer is a payload-free variant: the evidence
  -- harness observes the WHOLE adapter call, including the `vec!` it allocates to build a
  -- record or a payload-carrying variant as a Warrant value (64 bytes), so a `heap <= 0` row on
  -- init, insert_img, remove_img, dispatch_out, dispatch_img or alpha_w is falsified by the
  -- harness itself, not by the source (VOS-D063).  The source has no allocator at all (SH1).
  bound init:
    steps <= 80
  bound insert_out:
    steps <= 160
    heap <= 0
  bound insert_img:
    steps <= 160
  bound remove_out:
    steps <= 160
    heap <= 0
  bound remove_img:
    steps <= 160
  bound dispatch_out:
    steps <= 160
  bound dispatch_img:
    steps <= 160
  bound alpha_w:
    steps <= 160
