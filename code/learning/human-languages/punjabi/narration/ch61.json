          "index": 1,
          "type": "input",
          "title": "You'll want to know: ਗਿਣਨਾ",
          "segments": [
            {
              "kind": "speech",
              "text": "ਗਿਣਨਾ — giṇnā — \"to count\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ਗਿਣਨਾ (giṇnā) is a tadbhava, a word inherited from Sanskrit and reshaped by sound change. It comes from gaṇayati, \"counts\" (CDIAL 3993)."
            }
          ]
        },
