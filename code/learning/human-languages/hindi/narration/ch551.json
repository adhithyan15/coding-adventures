        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: मंज़ूर",
          "segments": [
            {
              "kind": "speech",
              "text": "मंज़ूर — manzūr — \"approved; accepted\"."
            },
            {
              "kind": "speech",
              "text": "मालिक को मेरी छुट्टी मंज़ूर है। Mālik ko merī chuṭṭī manzūr hai. The owner has approved my leave."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "मंज़ूर (manzūr) is usually traced to Arabic manẓūr, \"seen, looked upon\", through Persian. Persian and Hindi use it for something approved."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for saying what happens if."
