        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ध्यान रखिए",
          "segments": [
            {
              "kind": "speech",
              "text": "ध्यान रखिए (dhyān rakhie) — \"take care\", literally \"keep attention\"."
            },
            {
              "kind": "speech",
              "text": "अपना ध्यान रखिए (dhyān rakhie) — \"take care of yourself\", the kindest goodbye."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ध्यान रखिए (dhyān rakhie) is \"keep attention\". dhyān is Sanskrit dhyāna, \"meditation\", a tatsama (CDIAL 6889), and rakhnā, \"to keep\", comes from rakṣati, \"guards\" (CDIAL 10547)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "The kindest thing to say at the door."
            }
          ]
        },
        {
          "index": 4,
          "type": "guided-production",
