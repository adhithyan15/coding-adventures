          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "var \"up, on\" is an old native Persian word, and âmadan \"to come\" is inherited Persian: to come up."
            }
          ]
        },
