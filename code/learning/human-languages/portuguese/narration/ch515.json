            {
              "kind": "speech",
              "text": "Before the new one: say the Portuguese for judo, then the Portuguese for fencing."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: o balneário",
          "segments": [
            {
              "kind": "speech",
              "text": "o balneário — \"changing room\"."
            },
            {
              "kind": "speech",
              "text": "Depois do jogo, os jogadores tomam banho no balneário. After the match, the players shower in the changing room."
            },
            {
              "kind": "speech",
              "text": "In Brazil: o vestiário."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "balneário is a learned word built on Latin balneārius \"of a bath\" (Lewis & Short), from balneum \"a bath\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
