              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "A familiar person is speaking while you need silence. Ask politely: “Please be quiet.”"
            }
          ]
        },
        {
