            {
              "kind": "speech",
              "text": "Before the new one: say the Punjabi for a grandmother, then the Punjabi for a husband."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ਪਤਨੀ",
          "segments": [
            {
              "kind": "speech",
              "text": "ਪਤਨੀ — patnī — \"a wife\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ਪਤਨੀ (patnī) is Sanskrit patnī, \"mistress, wife\", taken over whole as a learned loan, a tatsama (CDIAL 7742)."
            }
          ]
        },
        {
