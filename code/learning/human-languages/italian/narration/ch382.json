          "segments": [
            {
              "kind": "speech",
              "text": "l'interrogazione — \"the oral test (at school); the questioning\"."
            },
            {
              "kind": "speech",
              "text": "Se domani c'è l'interrogazione di storia, stasera studio. If there is an oral history test tomorrow, I will study tonight."
            },
            {
              "kind": "speech",
              "text": "At school the teacher questions one pupil aloud in front of the class: essere interrogato."
            }
          ]
        },
