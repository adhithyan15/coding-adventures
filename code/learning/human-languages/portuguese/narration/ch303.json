            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Portuguese for to collapse, then the Portuguese for the rubble."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: a inundação",
          "segments": [
            {
              "kind": "speech",
              "text": "a inundação — \"the flood\"."
            },
            {
              "kind": "speech",
              "text": "A inundação cobriu as ruas do centro. The flood covered the streets of the centre."
            },
            {
              "kind": "speech",
              "text": "When a river overflows people also say a cheia."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "inundação is a learned borrowing from Latin inundātiō \"a flooding\" (EtymDB), built on unda \"a wave\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
