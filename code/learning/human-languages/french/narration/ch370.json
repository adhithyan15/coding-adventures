          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "adapter is a learned borrowing from Latin adaptāre \"to fit to\" (EtymDB), built from ad \"to\" and aptāre \"to fit\", from aptus \"fitted\" (Lewis & Short)."
            }
          ]
        },
