          "title": "You'll want to know: l'adolescence",
          "segments": [
            {
              "kind": "speech",
              "text": "l'adolescence — \"adolescence, the teenage years\"."
            },
            {
              "kind": "speech",
              "text": "Son adolescence a été difficile. His teenage years were difficult."
            },
            {
              "kind": "speech",
              "text": "Feminine: une adolescence heureuse."
            }
