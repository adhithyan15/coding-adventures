# Perl 5.004_04-t3 (1997-10-10) tokens: plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: unsupported Perl 5.004_04-t3 syntax is rejected.
# Evidence: https://mirrors.develooper.com/perl/historical-perl/perl-5.004_04-t3.tar.gz
# Archive SHA-256: 3337caa03309b6f772dedde87b40600c04911e795cf64c9efa6949a9c2cae744
# Historical toke.c shares the 5.004_04 trial/final tokenizer;
# glob and quote-delimiter changes are outside this subset.
# Unsupported characters, carriage returns, and leading-zero forms remain refused.

PRINT     = "print"
INT       = /0|[1-9][0-9]{0,249}/
PLUS      = "+"
DECREMENT = "--"
MINUS     = "-"
STAR      = "*"
LPAREN    = "("
RPAREN    = ")"
SEMICOLON = ";"

skip:
  WHITESPACE = /[ \t\n]+/
