          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Abendessen is Abend + the word for \"a meal\", which is the verb \"to eat\" from Old High German ezzan from Proto-Germanic etaną, English eat. (EtymDB 2.1)."
            }
          ]
        },
