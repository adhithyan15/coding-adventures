  -- A round-robin scheduler as ground models (the representation tier's witness, VOS02 2.7): the
  -- mask of ready threads plus a rotation pointer `ptr` that alpha forgets.  dispatch scans from
  -- the pointer upward (wrapping at 8), returns the first ready thread and leaves the pointer one
  -- past it.  The history code is the pointer, so rep(m, h) = Impl(<mask of m>, h) and hist(s) = s.ptr.
  record Impl(mask: U8, ptr: U8)
  record AbsW(w: U8)
  record CfgN(v: U8)
  model dec(x: AbsW) -> Ready = (
    Ready(not (bit_and(x.w, 1u8) == 0u8), not (bit_and(x.w, 2u8) == 0u8), not (bit_and(x.w, 4u8) == 0u8),
          not (bit_and(x.w, 8u8) == 0u8), not (bit_and(x.w, 16u8) == 0u8), not (bit_and(x.w, 32u8) == 0u8),
          not (bit_and(x.w, 64u8) == 0u8), not (bit_and(x.w, 128u8) == 0u8)))
  model b2m(b: Bool, k: Nat) -> U8 = if b then shl(1u8, k) else 0u8
  model mask_of(m: Ready) -> U8 = (
    bit_or(bit_or(bit_or(bit_or(bit_or(bit_or(bit_or(b2m(m.p0, 0), b2m(m.p1, 1)), b2m(m.p2, 2)), b2m(m.p3, 3)),
           b2m(m.p4, 4)), b2m(m.p5, 5)), b2m(m.p6, 6)), b2m(m.p7, 7)))
  model build(m: Ready) -> Impl = Impl(mask_of(m), 0u8)
  model rep(m: Ready, h: U8) -> Impl = Impl(mask_of(m), h)
  model hist(s: Impl) -> U8 = s.ptr
  model inv_impl(s: Impl) -> Bool = s.ptr < 8u8
  model cfg_n() -> CfgN = CfgN(8u8)
  model init() -> Impl = Impl(0u8, 0u8)
  model has(s: Impl, t: U8) -> Bool = not (bit_and(s.mask, shl(1u8, to_nat(t))) == 0u8)
  model has_bit(mask: U8, i: U8) -> Bool = not (bit_and(mask, shl(1u8, to_nat(bit_and(i, 7u8)))) == 0u8)
  model rr_pick(mask: U8, p: U8) -> Pick = (
    if has_bit(mask, p) then Run(bit_and(p, 7u8)) else
    (if has_bit(mask, p + 1u8) then Run(bit_and(p + 1u8, 7u8)) else
    (if has_bit(mask, p + 2u8) then Run(bit_and(p + 2u8, 7u8)) else
    (if has_bit(mask, p + 3u8) then Run(bit_and(p + 3u8, 7u8)) else
    (if has_bit(mask, p + 4u8) then Run(bit_and(p + 4u8, 7u8)) else
    (if has_bit(mask, p + 5u8) then Run(bit_and(p + 5u8, 7u8)) else
    (if has_bit(mask, p + 6u8) then Run(bit_and(p + 6u8, 7u8)) else
    (if has_bit(mask, p + 7u8) then Run(bit_and(p + 7u8, 7u8)) else Idle))))))))
  model rr_next(mask: U8, p: U8) -> Impl = (
    match rr_pick(mask, p) with
      Idle -> Impl(mask, p)
    | Run(t) -> Impl(bit_and(mask, bit_not(shl(1u8, to_nat(t)))), bit_and(t + 1u8, 7u8)))
  model insert_out(s: Impl, t: U8) -> Upd = (
    if t >= 8u8 then OutOfRange else (if has(s, t) then Unchanged else Changed))
  model insert_img(s: Impl, t: U8) -> Impl = (
    if t >= 8u8 then s else Impl(bit_or(s.mask, shl(1u8, to_nat(t))), s.ptr))
  model remove_out(s: Impl, t: U8) -> Upd = (
    if t >= 8u8 then OutOfRange else (if has(s, t) then Changed else Unchanged))
  model remove_img(s: Impl, t: U8) -> Impl = (
    if t >= 8u8 then s else Impl(bit_and(s.mask, bit_not(shl(1u8, to_nat(t)))), s.ptr))
  model dispatch_out(s: Impl) -> Pick = rr_pick(s.mask, s.ptr)
  model dispatch_img(s: Impl) -> Impl = rr_next(s.mask, s.ptr)
  model alpha_w(s: Impl) -> AbsW = AbsW(s.mask)
