              "instruction": "mānējar putiya jōli enne ēlppiccu. — The manager entrusted the new work to me.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *mānējar putiya jōli enne ēlppiccu.* — The manager entrusted the new work to me.]"
