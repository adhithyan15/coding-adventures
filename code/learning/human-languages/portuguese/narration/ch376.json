        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: a faculdade",
          "segments": [
            {
              "kind": "speech",
              "text": "a faculdade — \"the faculty (of a university); the ability\"."
            },
            {
              "kind": "speech",
              "text": "Ele estuda na faculdade de medicina. He studies at the faculty of medicine."
            },
            {
              "kind": "speech",
              "text": "In Portugal people often say a faculdade for university."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "faculdade is a learned borrowing from Latin facultās \"capability, power, means\" (Lewis & Short), built on facul, facilis \"easy, doable\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
