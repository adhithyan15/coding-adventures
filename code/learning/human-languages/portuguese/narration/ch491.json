        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: namorar",
          "segments": [
            {
              "kind": "speech",
              "text": "namorar — \"to date, to go out with\"."
            },
            {
              "kind": "speech",
              "text": "A minha prima namora com um colega da faculdade. My cousin is going out with a classmate from university."
            },
            {
              "kind": "speech",
              "text": "In Portugal namorar com alguém; in Brazil namorar alguém."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "namorar is usually explained as a shortening of Old Portuguese enamorar \"to make fall in love\", built on amor \"love\", from Latin amor (Lewis & Short)."
            }
          ]
        },
        {
