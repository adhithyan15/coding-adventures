        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: la mostra",
          "segments": [
            {
              "kind": "speech",
              "text": "la mostra — \"exhibition, show\"."
            },
            {
              "kind": "speech",
              "text": "Domenica andiamo a vedere una mostra di fotografia. On Sunday we are going to see a photography exhibition."
            },
            {
              "kind": "speech",
              "text": "The same form is a verb: mi mostra la casa — he shows me the house."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "mostra is built on mostrare \"to show\", inherited from Latin mōnstrāre \"to point out\" (EtymDB)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
