          "segments": [
            {
              "kind": "speech",
              "text": "épreuve is formed on éprouver \"to test, to feel\" (EtymDB), built from é- and prouver, which is inherited from Latin probāre \"to test, to examine\" (Lewis & Short)."
            }
          ]
        },
