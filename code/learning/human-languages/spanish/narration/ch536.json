        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: mientras tanto",
          "segments": [
            {
              "kind": "speech",
              "text": "mientras tanto — \"meanwhile, in the meantime\"."
            },
            {
              "kind": "speech",
              "text": "Mientras tanto, su hermano llamó a la ambulancia. Meanwhile, his brother called the ambulance."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "mientras tanto is built on mientras 'while', which is usually traced to Latin dum interim 'while meanwhile', and tanto, which comes from Latin tantum 'so much' (Lewis & Short)."
            }
          ]
        },
        {
