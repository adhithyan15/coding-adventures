# @version 1
# Mermaid 11.16.1 sequence diagram token grammar.
# Derived from packages/mermaid/src/diagrams/sequence/parser/sequenceDiagram.jison.

skip:
  WHITESPACE            = /[ \t]+/
  COMMENT               = /%%[^\r\n]*/

NEWLINE                  = /\r?\n/
HEADER                   = "sequenceDiagram"
BIDIRECTIONAL_SOLID      = "<<->>"
BIDIRECTIONAL_DOTTED     = "<<-->>"
DOTTED_FILLED_TOP        = /\-\-\|\\/
DOTTED_FILLED_BOTTOM     = /\-\-\|\//
DOTTED_STICK_TOP         = /\-\-\\\\/
DOTTED_STICK_BOTTOM      = /\-\-\/\//
DOTTED_REVERSE_FILLED_TOP = /\/\|\-\-/
DOTTED_REVERSE_FILLED_BOTTOM = /\\\|\-\-/
DOTTED_REVERSE_STICK_TOP = /\/\/\-\-/
DOTTED_REVERSE_STICK_BOTTOM = /\\\\\-\-/
SOLID_FILLED_TOP         = /\-\|\\/
SOLID_FILLED_BOTTOM      = /\-\|\//
SOLID_STICK_TOP          = /\-\\\\/
SOLID_STICK_BOTTOM       = /\-\/\//
SOLID_REVERSE_FILLED_TOP = /\/\|\-/
SOLID_REVERSE_FILLED_BOTTOM = /\\\|\-/
SOLID_REVERSE_STICK_TOP  = /\/\/\-/
SOLID_REVERSE_STICK_BOTTOM = /\\\\\-/
DOTTED_FILLED_ARROW      = "-->>"
DOTTED_OPEN_ARROW        = "-->"
DOTTED_CROSS_ARROW       = "--x"
DOTTED_POINT_ARROW       = "--)"
SOLID_FILLED_ARROW       = "->>"
SOLID_OPEN_ARROW         = "->"
SOLID_CROSS_ARROW        = "-x"
SOLID_POINT_ARROW        = "-)"
COLON                    = ":"
COLOR                    = /rgba?\([^\)\r\n]*\)/
CONFIG                   = /@\{[^\}\r\n]*\}/
COMMA                    = ","
PLUS                     = "+"
MINUS                    = "-"
IDENTIFIER               = /[A-Za-z0-9_.$]+/
WORD                     = /[^ \t\r\n:,+-@]+/

keywords:
  participant
  actor
  create
  destroy
  box
  as
  activate
  deactivate
  note
  left
  right
  of
  over
  title
  autonumber
  off
  loop
  rect
  opt
  alt
  else
  par
  par_over
  and
  critical
  option
  break
  end
