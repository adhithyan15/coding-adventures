        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ऊपर (ūpar) is a tadbhava, a word inherited and reshaped by sound change. It comes from uppari, \"above\", a form CDIAL reconstructs from its descendants (CDIAL 2333). It is Sanskrit upari, \"above\", with its consonant doubled for emphasis."
            }
          ]
        },
