            },
            {
              "kind": "speech",
              "text": "I drank tea? (ਮੈਂ ਚਾਹ ਪੀਤੀ.) I drank milk? (ਮੈਂ ਦੁੱਧ ਪੀਤਾ.)"
            }
          ]
        }
