        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: caveō, cavēre",
          "segments": [
            {
              "kind": "speech",
              "text": "caveō, cavēre — \"to beware, to be on one's guard\"."
            },
            {
              "kind": "speech",
              "text": "In mūrō scrīptum erat: CAVĒ CANEM. On the wall was written: BEWARE OF THE DOG."
            },
            {
              "kind": "speech",
              "text": "caveō, cavēre, cāvī, cautum. Cavēre + accusative, to beware of; cavē nē + subjunctive, take care not to. English caution and caveat, let him beware."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "caveō is inherited from Proto-Italic kawēō (EtymDB), from a root meaning \"to watch, to heed\". English caution and caveat come from it."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
