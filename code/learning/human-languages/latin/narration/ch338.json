        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: legiō, legiōnis",
          "segments": [
            {
              "kind": "speech",
              "text": "legiō, legiōnis — \"a legion\"."
            },
            {
              "kind": "speech",
              "text": "Decima legiō fortissima erat. The tenth legion was the bravest."
            },
            {
              "kind": "speech",
              "text": "Feminine, 3rd declension, from legō, 'to choose': a picked levy, about five thousand men. English legion."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "legiō is built on legō, \"to gather, to choose\" (Lewis & Short): a body of chosen soldiers. English legion comes from it through French."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
