      ],
      "sourceHash": "fnv1a64:092c9e01de7a06e5",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Russian for a widow, then the Russian for an heir."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: юбилей",
          "segments": [
            {
              "kind": "speech",
              "text": "юбилей (yubiléy) — \"a jubilee, a big round birthday or anniversary\"."
            },
            {
              "kind": "speech",
              "text": "У дедушки скоро юбилей, семьдесят лет. U dédushki skóro yubiléy, sémdesyat let. Grandpa soon has a big birthday: seventy."
            },
            {
              "kind": "speech",
              "text": "A round number: fifty, sixty, seventy years."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "юбилей (yubiléy) was borrowed from German Jubiläum (EtymDB), which comes from Late Latin iūbilaeus \"the jubilee year\", which is usually traced to a Hebrew word for the ram's horn that announced it."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
