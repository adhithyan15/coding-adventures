        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: la protesta",
          "segments": [
            {
              "kind": "speech",
              "text": "la protesta — \"the protest\"."
            },
            {
              "kind": "speech",
              "text": "La protesta degli studenti è durata tre giorni. The students' protest lasted three days."
            },
            {
              "kind": "speech",
              "text": "Per protesta — as a protest."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "protesta is built on protestare, a learned borrowing from Latin prōtestārī \"to declare in public\" (Lewis & Short), built on testis \"a witness\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
