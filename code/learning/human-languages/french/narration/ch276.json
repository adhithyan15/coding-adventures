          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "décennie is a learned borrowing from Latin decennium \"a period of ten years\" (EtymDB), from decem \"ten\" and annus \"year\"."
            }
          ]
        },
