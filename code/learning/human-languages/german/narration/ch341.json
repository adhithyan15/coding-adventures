        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: obwohl",
          "segments": [
            {
              "kind": "speech",
              "text": "obwohl — \"although\"."
            },
            {
              "kind": "speech",
              "text": "Wir gehen spazieren, obwohl es regnet. We are going for a walk although it is raining."
            },
            {
              "kind": "speech",
              "text": "Obwohl sends the verb to the end, like weil: …, obwohl es regnet. Trotzdem says the same thing from the other side: Es regnet. Trotzdem gehen wir spazieren."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "obwohl joins ob \"if, whether\" and wohl \"well\", inherited from Old High German wola and Proto-Germanic wela (EtymDB): \"even if it may well be so\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
