              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "nilaiyam",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *nilaiyam*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "vāṉilai, then nilaiyam, and name the piece they share",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *vāṉilai*, then *nilaiyam*, and name the piece they share]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "all five — vaṇḍi, pērundu, rayil, sālai, nilaiyam",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: all five — *vaṇḍi*, *pērundu*, *rayil*, *sālai*, *nilaiyam*]"
