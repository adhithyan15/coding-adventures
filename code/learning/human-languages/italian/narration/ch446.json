        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: le mura",
          "segments": [
            {
              "kind": "speech",
              "text": "le mura — \"the walls (of a town)\"."
            },
            {
              "kind": "speech",
              "text": "Possiamo camminare sulle mura della città. We can walk on the city walls."
            },
            {
              "kind": "speech",
              "text": "Il muro is a wall; the old plural le mura means the walls round a town."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "mura is the old plural of muro 'wall', which is inherited from Latin mūrus (EtymDB)."
            }
          ]
        },
        {
