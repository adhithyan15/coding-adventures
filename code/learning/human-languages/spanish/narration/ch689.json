          "type": "input",
          "title": "You'll want to know: la cascada",
          "segments": [
            {
              "kind": "speech",
              "text": "la cascada — \"the waterfall\"."
            },
            {
              "kind": "speech",
              "text": "Caminamos hasta la cascada. We walked to the waterfall."
            },
            {
              "kind": "speech",
              "text": "A very big one is una catarata."
