        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: તબક્કો",
          "segments": [
            {
              "kind": "speech",
              "text": "તબક્કો — tabakko — \"a stage (of a process)\"."
            },
            {
              "kind": "speech",
              "text": "જો પહેલો તબક્કો સારો જશે તો આપણે બીજો તબક્કો શરૂ કરીશું. jo pahelo tabakko sāro jaśe to āpaṇe bījo tabakko śarū karīśũ. If the first stage goes well, we will start the second stage."
            },
            {
              "kind": "speech",
              "text": "A masculine noun."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "તબક્કો (tabakko) is usually traced to Arabic ṭabaqa, \"a layer, a stage\", through Persian."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for saying what happens if."
            }
          ]
        },
