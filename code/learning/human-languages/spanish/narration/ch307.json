              "instruction": "el tío",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *el tío*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "el tío y el abuelo",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *el tío y el abuelo*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "el tío, señor",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *el tío, señor*]"
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Where does tío come from? (Greek theîos.) Where does English uncle come from? (Latin avunculus --- the abuelo root.) What is the accent on the í doing? (Splitting two beats, holding the stress.)"
            }
          ]
        }
      ]
