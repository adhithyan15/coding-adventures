        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "దంచు (dañcu) is native Dravidian. DEDR 77 lists dañcu, \"to pound, clean grain in a mortar\", with Tamil aṭu, \"to pound (as rice)\"."
            }
          ]
        },
