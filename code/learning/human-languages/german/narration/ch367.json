        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: eventuell",
          "segments": [
            {
              "kind": "speech",
              "text": "eventuell — \"possibly (not eventually); perhaps\"."
            },
            {
              "kind": "speech",
              "text": "Eventuell komme ich später, ich weiß es noch nicht. I may possibly come later; I do not know yet."
            },
            {
              "kind": "speech",
              "text": "A false friend: eventuell means possibly, not eventually. Eventually is irgendwann."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "eventuell was borrowed from French éventuel \"possible\", a learned formation on Latin ēventus \"an outcome, an event\", from ēvenīre \"to come out, to happen\" (Lewis & Short)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
