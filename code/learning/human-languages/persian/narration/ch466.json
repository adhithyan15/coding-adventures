        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: گله",
          "segments": [
            {
              "kind": "speech",
              "text": "گله (galle) — \"a flock, a herd\"."
            },
            {
              "kind": "speech",
              "text": "یک گله گوسفند از جاده رد شد. Yek galle gusfand az jâdde rad shod. A flock of sheep crossed the road."
            },
            {
              "kind": "speech",
              "text": "Do not mix it up with gele 'a complaint', written the same way."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "galle 'herd' is a native word whose older form is not settled. EtymDB lists only its look-alike gele 'complaint'."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
