          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "vāticinor is built on vātēs, \"seer\" (Lewis & Short), with a second part from canō, \"to sing\": to sing as a seer."
            }
          ]
        },
