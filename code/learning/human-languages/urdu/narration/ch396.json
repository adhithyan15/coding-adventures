          "segments": [
            {
              "kind": "speech",
              "text": "شاہراہ — shāhrāh — \"a highway; a main road\"."
            },
            {
              "kind": "speech",
              "text": "شاہراہ پر ٹرک تیز چلتے ہیں۔ shāhrāh par ṭrak tez chalte haiṅ. Lorries drive fast on the highway."
            },
            {
              "kind": "speech",
              "text": "Feminine."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "شاہراہ (shāhrāh) is built from Persian shāh, \"a king\", and rāh, \"a road\" (راہ): it is usually traced to Persian shāhrāh, \"the king's road\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for getting around."
