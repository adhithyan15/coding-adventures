          "segments": [
            {
              "kind": "speech",
              "text": "faciēs, faciēī — \"appearance, shape; face\"."
            },
            {
              "kind": "speech",
              "text": "Puer faciem in aquā lavat. The boy washes his face in the water."
            },
            {
              "kind": "speech",
              "text": "Feminine, fifth declension. The shape and look of a face, or of anything; vultus is the face as it shows feeling. English face."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "faciēs is usually traced to the root of faciō \"to make\" (EtymDB): the make of a thing, its shape; Lewis & Short links it with fax \"torch\" instead. English face and surface come from it."
            }
          ]
        },
