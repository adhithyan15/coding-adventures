          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "contanto que is built from com \"with\", tanto \"so much\", inherited from Latin tantum \"so much\" (Lewis & Short), and que: \"with so much as\"."
            }
          ]
        },
