        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: le coureur",
          "segments": [
            {
              "kind": "speech",
              "text": "le coureur — \"runner; rider (in a race)\"."
            },
            {
              "kind": "speech",
              "text": "Le coureur a battu son propre record. The runner beat his own record."
            },
            {
              "kind": "speech",
              "text": "A woman is la coureuse. Also a cyclist in a race: un coureur cycliste."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "le coureur is built on courir \"to run\", inherited from Latin currere \"to run\" (Lewis & Short)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
