              "instruction": "its literal meaning (\"having gone, I come\" becomes \"I'll come back\")",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: its literal meaning (\"having gone, I come\" → \"I'll come back\")]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "the warm reply — hōgi banni",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: the warm reply — *hōgi banni*]"
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
