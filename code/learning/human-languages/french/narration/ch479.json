        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: blesser",
          "segments": [
            {
              "kind": "speech",
              "text": "blesser — \"to injure, to hurt; (se blesser) to hurt oneself\"."
            },
            {
              "kind": "speech",
              "text": "Il s'est blessé au pied en jouant au foot. He hurt his foot playing football."
            },
            {
              "kind": "speech",
              "text": "Often reflexive: se blesser à la main. Also to hurt feelings: ses mots m'ont blessé."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "blesser comes from Old French blecier \"to injure\" (EtymDB), from Frankish blētjan \"to bruise\", a Germanic word."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
