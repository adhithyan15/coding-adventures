        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: die Landstraße",
          "segments": [
            {
              "kind": "speech",
              "text": "die Landstraße — \"the country road, the main road (outside towns)\"."
            },
            {
              "kind": "speech",
              "text": "Wir fahren lieber auf der Landstraße als auf der Autobahn. We prefer to drive on the country road rather than on the motorway."
            },
            {
              "kind": "speech",
              "text": "Plural: die Landstraßen. Slower than the Autobahn, often with villages on the way."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Landstraße is a compound of Land 'land, open country', inherited from Proto-Germanic landą (EtymDB), and Straße 'street', an early borrowing from Latin (via) strāta 'paved road' (Lewis & Short) that reached Middle High German as strāze (EtymDB)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
            }
          ]
        },
