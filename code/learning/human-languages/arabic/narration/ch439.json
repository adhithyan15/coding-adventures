          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "منظر (manẓar) is built on the native Arabic root n-ẓ-r, \"to look\" (Lane). The pattern mafʿal makes it the thing looked at."
            }
          ]
        },
