    {
      "id": "ZH-W473-ya-tooth",
      "sequence": 35785,
      "title": "牙 (yá) — four strokes, each one different",
      "headword": "牙",
      "romanization": "yá",
      "gloss": "牙 — four strokes: a bar, a turn, a hook and a falling stroke",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:15a168d6ba7b4939",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — four strokes, each one different",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — four strokes, each one different and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say yáyī — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *yáyī* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "医 口."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — yī, kǒu",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *yī*, *kǒu*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — four strokes, each one different",
          "segments": [
            {
              "kind": "speech",
              "text": "牙 (yá)."
            },
            {
              "kind": "speech",
              "text": "One piece of four strokes. Count them as you go."
            },
            {
              "kind": "speech",
              "text": "The first two. A short bar along the top, from left to right. Then under it on the left a short stroke down that turns and runs right, longer than the bar."
            },
            {
              "kind": "speech",
              "text": "The last two. A vertical from the top bar down through the second stroke, hooking to the left at the foot. Then a long stroke falling to the left, from the middle down to the bottom left."
            },
            {
              "kind": "speech",
              "text": "2 + 2 = four."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "牙 (yá), all four, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 牙, all four, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many strokes does 牙 (yá) have? (Four.) Which comes last? (The long stroke falling to the left.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 牙 (yá), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
