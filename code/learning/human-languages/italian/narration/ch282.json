        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: la cronaca",
          "segments": [
            {
              "kind": "speech",
              "text": "la cronaca — \"the news pages, the local news; the chronicle\"."
            },
            {
              "kind": "speech",
              "text": "Leggo sempre la cronaca della mia città. I always read the local news for my town."
            },
            {
              "kind": "speech",
              "text": "La cronaca nera is crime news; la cronaca rosa is celebrity gossip."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "cronaca is inherited from Latin chronica \"a chronicle\" (EtymDB), from Greek khronikós \"of time\", built on khrónos \"time\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
