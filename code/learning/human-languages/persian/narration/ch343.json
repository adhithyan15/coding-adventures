      "id": "FA-C343-barande-shodan",
      "sequence": 17500,
      "title": "برنده شدن (barande shodan) — to win",
      "headword": "برنده شدن",
      "romanization": "barande shodan",
      "gloss": "to win",
      "script": "perso-arabic",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:90743063f856b75d",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Persian for a parade, then the Persian for joy."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: برنده شدن",
          "segments": [
            {
              "kind": "speech",
              "text": "برنده شدن (barande shodan) — \"to win\"."
            },
            {
              "kind": "speech",
              "text": "تیم ما در مسابقه برنده شد. Tim-e mâ dar mosâbeqe barande shod. Our team won the match."
            },
            {
              "kind": "speech",
              "text": "barande \"a winner\", from bordan \"to carry off, to win\". Present barande mishavad."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "barande \"a winner\" is built on bar-, the present stem of the native verb bordan \"to carry off, to win\", with -ande \"one who\"; shodan \"to become\" is inherited too."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
            }
          ]
        },
