          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "interrogazione is a learned borrowing from Latin interrogātiō \"a questioning, an examination\" (EtymDB), from interrogāre \"to question\", built from inter \"between\" and rogāre \"to ask\"."
            }
          ]
        },
