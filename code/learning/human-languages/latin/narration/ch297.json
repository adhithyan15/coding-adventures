          "segments": [
            {
              "kind": "speech",
              "text": "fīniō, fīnīre — \"to finish; to set limits\"."
            },
            {
              "kind": "speech",
              "text": "Hōrā nōnā labōrem fīnīvimus. We finished the work at the ninth hour."
            },
            {
              "kind": "speech",
              "text": "fīniō, fīnīre, fīnīvī, fīnītum. From fīnis (taught): first 'to mark a boundary', then 'to end'. English finish, finite."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "fīniō is built on fīnis, \"end, boundary\" (EtymDB): to set an end. English finish comes from it through French, and finite from its participle."
            }
          ]
        },
        {
