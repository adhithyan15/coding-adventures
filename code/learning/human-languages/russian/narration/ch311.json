      ],
      "sourceHash": "fnv1a64:e6dcd97c9fdc4ce6",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Russian for a christening, then the Russian for to christen."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: праздновать",
          "segments": [
            {
              "kind": "speech",
              "text": "праздновать (prázdnovat) — \"to celebrate\"."
            },
            {
              "kind": "speech",
              "text": "Мы праздновали день рождения до поздней ночи. My prázdnovali den rozhdéniya do pózdney nóchi. We celebrated the birthday until late at night."
            },
            {
              "kind": "speech",
              "text": "Imperfective; the perfective is отпраздновать (otprázdnovat). Present праздную."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "праздновать (prázdnovat) is built on праздник \"a holiday\" (EtymDB), from праздный \"idle\", the Church Slavonic shape of native порожний \"empty\": a day free of work."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
            }
          ]
        },
