          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: luòyè",
          "segments": [
            {
              "kind": "speech",
              "text": "luòyè — \"fallen leaves\"."
            },
            {
              "kind": "speech",
              "text": "qiūtiān gōngyuán lǐ dōu shì luòyè — In autumn the park is full of fallen leaves."
            },
            {
              "kind": "speech",
              "text": "Its characters come later; for now it is a word for the ear."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "luòyè is built from luò 'to fall' and yè 'a leaf', both inherited from Middle Chinese, lak and yep (Guangyun, in Baxter's transcription). The dictionary says the first is the word for what trees do when their leaves come down, and glosses the second 'branches and leaves'."
            }
          ]
        },
