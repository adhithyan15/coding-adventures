        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: suādeō, suādēre",
          "segments": [
            {
              "kind": "speech",
              "text": "suādeō, suādēre — \"to advise, to urge\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "suādeō is inherited, usually traced to Proto-Indo-European sweh2d-, \"sweet\" (EtymDB 2.1): to advise was to make a thing sweet to someone. suāvis, \"sweet\", and English sweet are cousins (Lewis & Short)."
            }
          ]
        },
