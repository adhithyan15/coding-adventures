            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "seguir recto al aparcamiento y después a la playa",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *seguir recto al aparcamiento y después a la playa*]"
            }
          ]
        },
        {
          "index": 6,
