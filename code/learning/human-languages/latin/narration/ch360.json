            {
              "kind": "speech",
              "text": "perspicuus, perspicua, perspicuum — \"clear, transparent; evident\"."
            },
            {
              "kind": "speech",
              "text": "Haec ratiō perspicua est omnibus. This reasoning is clear to everyone."
            },
            {
              "kind": "speech",
              "text": "perspicuus, perspicua, perspicuum. Water or glass you see through, and an argument you see through to the end. English perspicuous."
            }
          ]
        },
