# Perl 5.003_11 (1996-12-06) tokens: plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: this does not lex all Perl 5.003_11 source.
# Evidence: https://github.com/Perl/perl5/blob/perl-5.003_11/toke.c
# The tagged tokenizer changes sigil, pattern and numeric-locale handling
# outside the listed subset. Multi-digit leading-zero forms remain refused.

PRINT     = "print"
INT       = /0|[1-9][0-9]*/
PLUS      = "+"
DECREMENT = "--"
MINUS     = "-"
STAR      = "*"
LPAREN    = "("
RPAREN    = ")"
SEMICOLON = ";"

skip:
  WHITESPACE = /[ \t\r\n]+/
