              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *kasrat*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "kasrat, once more",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *kasrat*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "Aruṇ roz subah ādhā ghaṇṭā kasrat kartā hai. — Arun exercises for half an hour every morning.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *Aruṇ roz subah ādhā ghaṇṭā kasrat kartā hai.* — Arun exercises for half an hour every morning.]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say the Hindi for to warm (a sore part), then the Hindi for to cover someone (with a blanket), then say kasrat again",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say the Hindi for to warm (a sore part), then the Hindi for to cover someone (with a blanket), then say *kasrat* again]"
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
