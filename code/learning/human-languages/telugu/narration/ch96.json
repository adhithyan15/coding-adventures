      "id": "TE-C96-surname",
      "sequence": 3680,
      "title": "ఇంటిపేరు (iṇṭipēru) — a surname, the family name",
      "headword": "ఇంటిపేరు",
      "romanization": "iṇṭipēru",
      "gloss": "a surname, the family name",
      "script": "telugu",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:72bfea0f8a029e85",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Telugu for please show me, then the Telugu for I could not hear it."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ఇంటిపేరు",
          "segments": [
            {
              "kind": "speech",
              "text": "ఇంటిపేరు (iṇṭipēru) — \"a surname\", literally \"the house name\"."
            },
            {
              "kind": "speech",
              "text": "It is ఇంటి, \"of the house\", and పేరు, \"name\". In Telugu the house name comes FIRST, before the given name, so a form that asks for a first name is asking the wrong question."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ఇంటిపేరు (iṇṭipēru) is native Dravidian: iṇṭi, \"of the house\" (DEDR 494), and pēru, \"name\" (DEDR 4410)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "The family name, and where it goes."
            }
          ]
        },
        {
          "index": 4,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "iṇṭipēru",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *iṇṭipēru*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "iṇṭipēru, once more",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *iṇṭipēru*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "say nā iṇṭipēru..., then your given name",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: say *nā iṇṭipēru ...*, then your given name]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say the Telugu for please show me, then the Telugu for I could not hear it, then say iṇṭipēru again",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say the Telugu for please show me, then the Telugu for I could not hear it, then say *iṇṭipēru* again]"
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What does ఇంటిపేరు (iṇṭipēru) mean? (\"A surname, the family name\".) Say it once more."
            }
          ]
        }
      ]
    },
