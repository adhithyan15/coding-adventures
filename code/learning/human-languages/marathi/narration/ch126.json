        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "तारीख (tārīkh) is a loan from Arabic tārīkh, \"a dating, a date\", which reached Marathi through Persian. Its Arabic root is ʾ-r-kh (Lane)."
            }
          ]
        },
