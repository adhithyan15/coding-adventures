          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Hindi for to look for, then the Hindi for to wear."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: बुलाना",
          "segments": [
            {
              "kind": "speech",
              "text": "बुलाना — bulānā — \"to call\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "बुलाना (bulānā) is the causing form of बोलना, \"to speak\": to call someone is to make them speak back. CDIAL lists both under a reconstructed boll-, \"speak\" (CDIAL 9321)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for this chapter."
            }
          ]
        },
        {
          "index": 4,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
