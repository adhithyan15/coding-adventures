      "expected": {
        "output": { "hex": "68656c6c6f2068656c6c6f2068656c6c6f" },
        "bytes_consumed": 10
      }
    },
    {
      "id": "zip-raw-v1-inflate-exact-output-cap",
      "operation": "inflate",
      "input_hex": "cb48cdc9c957c8409000",
