              "kind": "speech",
              "text": "cupiditās, cupiditātis — \"a desire, eagerness\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "cupiditās is built on cupidus, \"eager, desirous\" (Lewis & Short), from cupiō, \"to desire\", with -itās, an ending for a quality."
            }
          ]
        },
