# @version 1
# Mermaid 11.16.1 block diagram core parser grammar.

document = { NEWLINE } HEADER body EOF ;
body = { NEWLINE | STATEMENT_LINE | ARROW_NODE_LINE | MARKED_CONNECTION_LINE | BIDIRECTIONAL_CONNECTION_LINE | DOTTED_CONNECTION_LINE | THICK_CONNECTION_LINE | group } ;
group = ( HEADER | GROUP_START ) body GROUP_END ;
