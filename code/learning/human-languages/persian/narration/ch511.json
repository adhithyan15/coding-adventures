          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "châdor is inherited: EtymDB traces it to Middle Persian čādur, 'sheet, veil' (EtymDB). A tent is a sheet you pitch, and zadan, 'to strike', is inherited too."
            }
          ]
