            },
            {
              "kind": "speech",
              "text": "Before the new one: say the German for the widow, then the German for to inherit."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: die Feier",
          "segments": [
            {
              "kind": "speech",
              "text": "die Feier — \"the celebration, the party\"."
            },
            {
              "kind": "speech",
              "text": "Die Feier ging bis Mitternacht. The celebration went on until midnight."
            },
            {
              "kind": "speech",
              "text": "Plural: die Feiern. The verb is feiern."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Feier comes from Middle High German vire, Old High German fīra, which came from Latin fēriae \"holidays, feast days\" (EtymDB)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
