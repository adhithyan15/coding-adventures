        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: l'annulation",
          "segments": [
            {
              "kind": "speech",
              "text": "l'annulation — \"the cancellation\"."
            },
            {
              "kind": "speech",
              "text": "Après l'annulation, la compagnie nous a donné une chambre. After the cancellation the airline gave us a room."
            },
            {
              "kind": "speech",
              "text": "A feminine noun."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "annulation is built on annuler 'to cancel', a learned borrowing from Late Latin annullāre 'to make nothing', from nullus 'none' (Lewis & Short)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
