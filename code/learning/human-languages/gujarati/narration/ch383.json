        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: પ્રયત્ન",
          "segments": [
            {
              "kind": "speech",
              "text": "પ્રયત્ન — prayatna — \"an attempt\"."
            },
            {
              "kind": "speech",
              "text": "જો પહેલા પ્રયત્નમાં તમે હારશો તો ફરી પ્રયત્ન કરો. jo pahelā prayatnamā̃ tame hārśo to pharī prayatna karo. If you lose at the first attempt, try again."
            },
            {
              "kind": "speech",
              "text": "A masculine noun."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "પ્રયત્ન (prayatna) is a tatsama, borrowed from Sanskrit prayatna, \"persevering effort, exertion\" (Monier-Williams)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for saying what happens if."
            }
          ]
        },
