        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: रिमझिम",
          "segments": [
            {
              "kind": "speech",
              "text": "रिमझिम — rimjhim — \"a drizzle\"."
            },
            {
              "kind": "speech",
              "text": "सकाळपासून रिमझिम चालू आहे. sakāḷpāsūn rimjhim cālū āhe. It has been drizzling since morning."
            },
            {
              "kind": "speech",
              "text": "Feminine."
            },
            {
              "kind": "speech",
              "text": "Also an adverb: रिमझिम (rimjhim) पाऊस, gentle rain."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "रिमझिम (rimjhim) is an echo word that imitates light, steady rain; its origin is not settled."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for getting around."
