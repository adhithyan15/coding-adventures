        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "teneō is inherited from Proto-Italic tenēō, \"to hold\" (EtymDB 2.1), usually traced to Proto-Indo-European ten-, \"to stretch\" (Lewis & Short compare Greek teinō, \"to stretch\"). English tenant comes from it."
            }
          ]
        },
