          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new word: what did śayyā mean?"
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: अपि",
          "segments": [
            {
              "kind": "speech",
              "text": "अपि (api) — \"also, too\"."
            },
            {
              "kind": "speech",
              "text": "अपि adds what you have just said to what came before. Put it after a word and you have piled that word on top: dugdham api, \"milk as well\"."
            },
            {
              "kind": "speech",
              "text": "Greek epi- is the same small word, and it fronts epidemic, epilogue, epicentre and epitaph. Latin ob is a cousin too. It is short, it never changes shape, and it does a great deal of work."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "A small word that adds one thing to another."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
