        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: مرگ",
          "segments": [
            {
              "kind": "speech",
              "text": "مرگ (marg) — \"death\"."
            },
            {
              "kind": "speech",
              "text": "بعد از مرگ پدرش به شهر برگشت. Ba'd az marg-e pedarash be shahr bargasht. After his father's death he went back to the city."
            },
            {
              "kind": "speech",
              "text": "Plain and strong; in polite speech people say dargozasht or fowt."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "marg is a native Persian word, usually traced to Middle Persian marg, \"death\"; EtymDB lists it without a parent."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
