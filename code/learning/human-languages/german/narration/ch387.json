        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: der Kontostand",
          "segments": [
            {
              "kind": "speech",
              "text": "der Kontostand — \"the bank balance\"."
            },
            {
              "kind": "speech",
              "text": "Jeden Morgen schaut sie auf ihren Kontostand. Every morning she checks her bank balance."
            },
            {
              "kind": "speech",
              "text": "Plural: die Kontostände."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Kontostand joins Konto \"account\", borrowed from Italian conto \"reckoning\" (EtymDB), to Stand \"state, standing\", from the family of stehen \"to stand\": where your account stands."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
