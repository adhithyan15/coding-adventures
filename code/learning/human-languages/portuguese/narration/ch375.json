        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: a escola secundária",
          "segments": [
            {
              "kind": "speech",
              "text": "a escola secundária — \"the secondary school\"."
            },
            {
              "kind": "speech",
              "text": "A minha irmã anda na escola secundária. My sister goes to secondary school."
            },
            {
              "kind": "speech",
              "text": "In Portugal, years 10 to 12; in speech a secundária."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "escola is inherited from Latin schola \"leisure given to learning, a school\" (Lewis & Short), from Greek skholḗ, and secundária comes from Latin secundārius \"of the second rank\", on secundus \"following\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
