        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: കുറച്ച്",
          "segments": [
            {
              "kind": "speech",
              "text": "കുറച്ച് (kuṟaccŭ) — \"a little, a few\"."
            },
            {
              "kind": "speech",
              "text": "The same root as the word before it, turned a different way: from കുറ-, \"to be little\", but landing on a quantity rather than on a lack."
            },
            {
              "kind": "speech",
              "text": "The difference matters at a table. കുറവ് (kuṟavŭ) complains that there is not enough; കുറച്ച് (kuṟaccŭ) politely asks for a small amount. One is a verdict and the other is a request, and they are one syllable apart."
            },
            {
              "kind": "speech",
              "text": "Malayalam gets a great deal out of a single root by varying the tail on it, and this pair is a clean example — the same three sounds at the front, two different jobs at the back."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "Three, and the last two share a root."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "kuṟaccŭ",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *kuṟaccŭ*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "it once more, slowly",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: it once more, slowly]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "kuṟavŭ, then kuṟaccŭ, and say which of the two you would use asking for rice",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *kuṟavŭ*, then *kuṟaccŭ*, and say which of the two you would use asking for rice]"
            }
