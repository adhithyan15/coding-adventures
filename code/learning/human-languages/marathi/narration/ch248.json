              "instruction": "say saṇ",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: say *saṇ*]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say the Marathi for education, then the Marathi for a feeling, then say saṇ again",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say the Marathi for education, then the Marathi for a feeling, then say *saṇ* again]"
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What does सण (saṇ) mean? (\"A festival\".) Say it once more."
            }
