# Perl 5.003_97e (1997-04-15) tokens: plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: this does not lex all Perl 5.003_97e source.
# Evidence: https://github.com/Perl/perl5/blob/perl-5.003_97e/toke.c
# Tagged tokenizer adds sysseek dispatch and keyword recognition outside this
# subset. Unsupported characters, carriage returns and
# leading-zero forms remain refused.

PRINT     = "print"
INT       = /0|[1-9][0-9]*/
PLUS      = "+"
DECREMENT = "--"
MINUS     = "-"
STAR      = "*"
LPAREN    = "("
RPAREN    = ")"
SEMICOLON = ";"

skip:
  WHITESPACE = /[ \t\n]+/
