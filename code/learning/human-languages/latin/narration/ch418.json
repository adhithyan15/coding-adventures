            },
            {
              "kind": "speech",
              "text": "Pecūniam fēnore dabat. He lent money at interest."
            },
            {
              "kind": "speech",
              "text": "fēnus, fēnoris n., also spelled faenus: the yield of money, as a field yields a crop."
            }
          ]
        },
