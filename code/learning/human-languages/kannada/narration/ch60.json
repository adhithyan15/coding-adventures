    {
      "id": "KA-C60-bird",
      "sequence": 1880,
      "title": "ಹಕ್ಕಿ (hakki) — a bird",
      "headword": "ಹಕ್ಕಿ",
      "romanization": "hakki",
      "gloss": "a bird",
