# @version 2
# @case_insensitive true
# Mermaid 11.16.1 sequence diagram token grammar.
# Derived from packages/mermaid/src/diagrams/sequence/parser/sequenceDiagram.jison.

case_sensitive: false

skip:
  WHITESPACE            = /[ \t]+/
  COMMENT               = /%%[^\r\n]*/

NEWLINE                  = /\r?\n/
ENTITY                   = /#(?:[0-9]+|[A-Za-z][A-Za-z0-9]+);/
HASH_COMMENT             = /#[^\r\n]*/
LINE_BREAK               = /<br[ \t]*\/?>/
WRAP_DIRECTIVE           = /(?:no)?wrap:/
SEMICOLON                = ";"
HEADER                   = "sequenceDiagram"
ACC_DESCR_BLOCK          = /accDescr[ \t]*\{[^\}]*\}/
BIDIRECTIONAL_SOLID      = "<<->>"
BIDIRECTIONAL_DOTTED     = "<<-->>"
DOTTED_FILLED_TOP        = /\-\-\|\\/
DOTTED_FILLED_BOTTOM     = /\-\-\|\//
DOTTED_STICK_TOP         = /\-\-\\\\/
DOTTED_STICK_BOTTOM      = /\-\-\/\//
DOTTED_REVERSE_FILLED_TOP = /\/\|\-\-/
DOTTED_REVERSE_FILLED_BOTTOM = /\\\|\-\-/
DOTTED_REVERSE_STICK_TOP = /\/\/\-\-/
DOTTED_REVERSE_STICK_BOTTOM = /\\\\\-\-/
SOLID_FILLED_TOP         = /\-\|\\/
SOLID_FILLED_BOTTOM      = /\-\|\//
SOLID_STICK_TOP          = /\-\\\\/
SOLID_STICK_BOTTOM       = /\-\/\//
SOLID_REVERSE_FILLED_TOP = /\/\|\-/
SOLID_REVERSE_FILLED_BOTTOM = /\\\|\-/
SOLID_REVERSE_STICK_TOP  = /\/\/\-/
SOLID_REVERSE_STICK_BOTTOM = /\\\\\-/
DOTTED_FILLED_ARROW      = "-->>"
DOTTED_OPEN_ARROW        = "-->"
DOTTED_CROSS_ARROW       = "--x"
DOTTED_POINT_ARROW       = "--)"
SOLID_FILLED_ARROW       = "->>"
SOLID_OPEN_ARROW         = "->"
SOLID_CROSS_ARROW        = "-x"
SOLID_POINT_ARROW        = "-)"
CENTRAL                  = "()"
COLON                    = ":"
COLOR                    = /(?:rgba?|hsla?)\([^\)\r\n]*\)/
CONFIG                   = /@\{[^\}\r\n]*\}/
JSON_OBJECT              = /\{[^\r\n]*\}/
URL                      = /https?:\/\/[^ \t\r\n]+/
COMMA                    = ","
AT                       = "@"
PLUS                     = "+"
MINUS                    = "-"
EQUAL                    = "="
QUESTION                 = "?"
EXCLAMATION              = "!"
NUMBER                   = /(?:[0-9]+(?:\.[0-9]{1,2})?|\.[0-9]{1,2})/
IDENTIFIER               = /[A-Za-z0-9_.$]+/
ANGLE_TEXT               = /[<>]+/
WORD                     = /[^ \t\r\n:,=+!?-@;]+/

keywords:
  participant
  actor
  create
  destroy
  link
  links
  properties
  details
  accTitle
  accDescr
  box
  as
  activate
  deactivate
  note
  left
  right
  of
  over
  title
  autonumber
  off
  loop
  rect
  opt
  alt
  else
  par
  par_over
  and
  critical
  option
  break
  end
