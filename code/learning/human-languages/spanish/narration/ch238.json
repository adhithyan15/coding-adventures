  "lessons": [
    {
      "id": "ES-C62-estoy-hablando",
      "sequence": 2425,
      "title": "estoy hablando — the payoff",
      "headword": "estoy hablando",
      "romanization": "estoy hablando",
      "gloss": "I am speaking — estar plus the gerund, and the one place Spanish is fussier than English about what \"right now\" means",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:57e90c1436beb2ae",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Estar, all the way through: estoy, estás, está, estamos, están."
            },
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "speech",
              "text": "And one gerund. Put them side by side."
            }
          ]
        },
        {
          "index": 1,
          "type": "grammar",
          "title": "Grammar Lens: standing in the middle of doing",
          "segments": [
            {
              "kind": "speech",
              "text": "Estoy hablando. — I am speaking, right now."
            },
            {
              "kind": "table",
              "headers": [
                "",
                ""
              ],
              "columns": 2,
              "rowCount": 3,
              "utterances": [
                "Estoy comiendo., I'm eating.",
                "Está trabajando., he's working.",
                "Estamos estudiando., we're studying."
              ]
            },
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Only estar changes. The gerund sits there, the same shape for everybody, which is why the whole construction costs you one verb you already knew and one ending."
            }
          ]
        },
        {
          "index": 2,
          "type": "culture-pragmatics",
          "title": "Why it's said this way",
          "segments": [
            {
              "kind": "speech",
              "text": "It had to be estar rather than ser, and you already know why. Estar is the verb for how something temporarily stands. An action caught mid-stride is as temporary as things get."
            },
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Now the difference from English, and it is worth having straight. English uses I'm + -ing for the future all the time: I'm eating with her tomorrow. Spanish will not."
            },
            {
              "kind": "speech",
              "text": "Estoy comiendo — I am eating, at this moment, food in hand."
            },
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "For tomorrow, Spanish reaches for the form you learned at chapter 49: voy a comer. So the two languages look identical here and are not: the Spanish progressive means now, and only now."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "Estoy hablando, Estoy comiendo",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *Estoy hablando*, *Estoy comiendo*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "Estoy comiendo for now, then Voy a comer for tomorrow",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *Estoy comiendo* for now, then *Voy a comer* for tomorrow]"
            },
            {
              "kind": "repeat",
              "times": 2,
              "source": "[REPEAT x2]"
            },
            {
              "kind": "activity",
              "scored": true,
              "id": "ES-C62-estoy-hablando-say",
              "prompt": "Say: I am eating.",
              "assesses": [
                "ES-GRAMMAR-PROGRESSIVE-ESTAR-GERUND"
              ],
              "responseSeconds": 12,
