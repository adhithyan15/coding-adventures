        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: stattdessen",
          "segments": [
            {
              "kind": "speech",
              "text": "stattdessen — \"instead\"."
            },
            {
              "kind": "speech",
              "text": "Der Film war ausverkauft. Stattdessen sind wir essen gegangen. The film was sold out. Instead, we went out to eat."
            },
            {
              "kind": "speech",
              "text": "The verb comes right after it: stattdessen sind wir …."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "stattdessen joins statt \"instead of\", from Statt \"place\", Old High German stat, to dessen \"of that\": in the place of that. EtymDB has no entry for the compound."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
