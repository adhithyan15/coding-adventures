          "index": 1,
          "type": "input",
          "title": "You'll want to know: qiāomén",
          "segments": [
            {
              "kind": "speech",
              "text": "qiāomén — \"to knock at the door\"."
            },
            {
              "kind": "speech",
              "text": "zuótiān wǎnshang yǒu rén qiāomén — Somebody knocked at the door last night."
            },
            {
              "kind": "speech",
              "text": "Its characters come later; for now it is a word for the ear."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "qiāomén is built from qiāo 'to strike' and 门 'door', both inherited from Middle Chinese, khaew and mwon (Guangyun, in Baxter's transcription)."
            }
          ]
        },
