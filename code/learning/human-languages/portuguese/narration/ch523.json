        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: o capítulo",
          "segments": [
            {
              "kind": "speech",
              "text": "o capítulo — \"chapter\"."
            },
            {
              "kind": "speech",
              "text": "Leio um capítulo antes de dormir. I read a chapter before I go to sleep."
            },
            {
              "kind": "speech",
              "text": "Also an episode of a soap: o último capítulo."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "capítulo is a learned borrowing from Late Latin capitulum \"a chapter\" (EtymDB), a little \"head\" of text, from caput \"head\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
