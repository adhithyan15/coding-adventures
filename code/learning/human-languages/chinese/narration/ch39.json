        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: 喝",
          "segments": [
            {
              "kind": "speech",
              "text": "喝 — hē — \"to drink\"."
            },
            {
              "kind": "speech",
              "text": "你喝什么 nǐ hē shénme — What would you like to drink?"
            },
            {
              "kind": "speech",
              "text": "The new character, in pieces: 喝 (hē) — 口 on the left; on the right 日 on top of a wrap with a small shape inside it. The next lesson puts it in your hand."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "喝 (hē) is an old character: the Guangyun records it as xat (Guangyun, in Baxter's transcription), glossed 'to shout at'. The sense 'to drink' is not given there, so how it came to mean drink is not settled."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for everyday answers."
