// EmptyState.dark.msl — dark-theme styling. Same shape as the light theme.

style EmptyState {
  part empty-state {
    padding       : 24 ;
    gap           : 8 ;
    background    : "#111827" ;
    border-width  : 1 ;
    border-color  : "#374151" ;
    border-radius : 0 ;
  }
  part empty-state-title {
    color     : "#f9fafb" ;
    font-size : 16 ;
  }
  part empty-state-message {
    color     : "#9ca3af" ;
    font-size : 14 ;
  }
  part empty-state-action {
    padding       : 8 ;
    background    : "#1d4ed8" ;
    color         : "#ffffff" ;
    border-width  : 1 ;
    border-color  : "#60a5fa" ;
    font-size     : 14 ;
    border-radius : 0 ;
  }
}
