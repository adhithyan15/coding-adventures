<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk"         Version="17.12.0" />
    <PackageReference Include="xunit"                          Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio"      Version="2.8.2" />
    <PackageReference Include="coverlet.collector"             Version="6.0.2" />
    <PackageReference Include="coverlet.msbuild"               Version="6.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../CodingAdventures.Conduit.fsproj" />
    <Compile Include="ConduitTests.fs" />
  </ItemGroup>

  <!-- Serialize test collections: several test classes bind real HTTP servers
       (ServerLifecycleTests) alongside the E2E fixture. Running those collections
       concurrently put multiple conduit-capi servers + reactor threads under CPU
       contention in one process, which flaked the E2E requests (~40% of cold
       runs). Serial collections make the suite deterministic. -->
  <ItemGroup>
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
