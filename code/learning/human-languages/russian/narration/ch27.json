  "lessons": [
    {
      "id": "RU-C27-words",
      "sequence": 1340,
      "title": "(reading) (voda, khleb, chai, kofe, sup, syr) (privet! menya zovut Anna.) (privet, spasibo, pozhaluysta, izvinite, medlenno, pomogite) — six words off a board",
      "headword": "(reading)",
      "romanization": "voda, khleb, chai, kofe, sup, syr",
      "gloss": "six words off a menu board — every letter in them is one you can already write",
      "script": "cyrillic",
      "modality": "sight",
      "derivedModality": "sight",
      "modalityReasons": [
        "sight-cue"
      ],
      "sourceHash": "fnv1a64:8a1432417f51a7cd",
      "notice": {
        "modality": "sight",
        "needs": [
          "your eyes, because the lesson points at something written down"
        ],
        "waitUntilStopped": [],
        "text": "Before we start: this one needs your eyes, so it is not fully a driving lesson. You will want your eyes, because the lesson points at something written down. You can listen to all of it now and come back to the parts that need looking at once you have stopped."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "You have written every letter in every one of these. Not one word is new."
            },
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "speech",
              "text": "What is new is that nobody says them before you read them."
            }
          ]
        },
        {
          "index": 1,
          "type": "comprehension",
          "title": "Reading",
          "segments": [
            {
              "kind": "speech",
              "text": "вода хлеб чай кофе суп сыр."
            },
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Read down the list once. Do not spell each one out — look at the whole word and let it arrive."
            },
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Again, and notice which came at once and which you had to spell. Both are fine. The difference is what practice removes."
            }
          ]
        },
        {
          "index": 2,
          "type": "input",
          "title": "You'll want to know",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "These six would be on a board over a counter, and they are the six you would want first."
            },
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Two of them are traps of exactly the kind this book warned you about. суп and сыр look like cyn and cbip to an eye trained on English, and they are sup and syr."
            },
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "That is the whole reason to read a word cold rather than after hearing it. Heard first, you never test whether the letters actually reached you."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "the six words down the list, once, without stopping",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: the six words down the list, once, without stopping]"
            },
            {
              "kind": "repeat",
              "times": 2,
              "source": "[REPEAT x2]"
            },
            {
              "kind": "activity",
              "scored": true,
              "id": "RU-C27-words-cheese",
              "prompt": "Which word is cheese?",
              "assesses": [
                "RU-SKILL-READ-WORDS"
              ],
              "responseSeconds": 12,
              "acceptedResponses": [
                "syr",
                "сыр",
                "cheese"
              ],
              "feedback": {
                "correct": "сыр.",
                "incorrect": "сыр -- cheese."
              }
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "How many of the six were new? (None.)"
            },
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Which two look most like English and are not? (суп and сыр.)"
            }
          ]
        }
      ]
    },
    {
      "id": "RU-C27-notices",
      "sequence": 1350,
      "title": "(reading) (voda, khleb, chai, kofe, sup, syr) (privet! menya zovut Anna.) (privet, spasibo, pozhaluysta, izvinite, medlenno, pomogite) — three to open, three to rescue",
      "headword": "(reading)",
      "romanization": "privet, spasibo, pozhaluysta, izvinite, medlenno, pomogite",
      "gloss": "six lines you would say to a stranger — read this time, not heard",
      "script": "cyrillic",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:f448ffd52146c230",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The last lesson gave you six things on a board. These are six things you would say."
            },
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "speech",
              "text": "Nothing here is new. What is new is meeting them in writing."
            }
          ]
        },
        {
          "index": 1,
          "type": "comprehension",
          "title": "Reading",
          "segments": [
            {
              "kind": "speech",
              "text": "привет спасибо пожалуйста извините медленно помогите."
            },
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Read down once, without stopping."
            },
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Again — and notice the list turns over halfway. The first three open a conversation. The last three rescue one."
            }
          ]
        },
        {
          "index": 2,
          "type": "input",
          "title": "You'll want to know",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "пожалуйста is the longest word on the list and the one you will read most often. It is worth recognising by shape rather than by spelling it out, because it does two jobs: please, and you're welcome."
            },
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "помогите and извините end the same way, and both are requests you make to somebody you have not met. That shared ending is the one piece of grammar visible on this page."
            },
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Six lines, and half of them exist for the moment something goes wrong."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "the six lines, once, in order, without stopping",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: the six lines, once, in order, without stopping]"
            },
            {
              "kind": "repeat",
              "times": 2,
              "source": "[REPEAT x2]"
            },
            {
              "kind": "activity",
              "scored": true,
              "id": "RU-C27-notices-slow",
              "prompt": "Which line asks for it slower?",
              "assesses": [
                "RU-SKILL-READ-NOTICES"
              ],
              "responseSeconds": 13,
              "acceptedResponses": [
                "medlenno",
                "медленно",
                "slowly"
              ],
              "feedback": {
                "correct": "медленно.",
                "incorrect": "медленно -- slowly."
              }
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "How many of the six were new? (None.)"
            },
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Where does the list turn over? (After пожалуйста — three to open, three to rescue.)"
            }
          ]
        }
      ]
    },
    {
      "id": "RU-C27-pervoe-chtenie",
      "sequence": 1360,
      "title": "(reading) (voda, khleb, chai, kofe, sup, syr) (privet! menya zovut Anna.) (privet, spasibo, pozhaluysta, izvinite, medlenno, pomogite) — the first passage",
      "headword": "(reading)",
      "romanization": "privet! menya zovut Anna.",
      "gloss": "the first passage — a whole introduction read straight through, and not one new word in it",
      "script": "cyrillic",
      "modality": "sight",
      "derivedModality": "sight",
      "modalityReasons": [
        "sight-cue"
      ],
      "sourceHash": "fnv1a64:b73d23aee3c7fa22",
      "notice": {
        "modality": "sight",
        "needs": [
          "your eyes, because the lesson points at something written down"
        ],
        "waitUntilStopped": [],
        "text": "Before we start: this one needs your eyes, so it is not fully a driving lesson. You will want your eyes, because the lesson points at something written down. You can listen to all of it now and come back to the parts that need looking at once you have stopped."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Six words, then six lines. Now the whole thing at once."
            },
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "speech",
              "text": "Not one word in it is new."
            }
          ]
        },
        {
          "index": 1,
          "type": "comprehension",
          "title": "Reading",
          "segments": [
            {
              "kind": "speech",
              "text": "Привет! Меня зовут Анна. Сестра и мама. Папа тоже. Я читаю. Я хочу читать. Вода, хлеб и чай. Кофе или чай? Я не знаю. Спасибо. До свидания."
            },
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Read it through once without stopping. Do not translate as you go."
            },
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Again — and this time notice that two lines differ by one word, and that the one word changes when the reading happens."
            }
          ]
        },
        {
          "index": 2,
          "type": "input",
          "title": "You'll want to know",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Я читаю is now. Я хочу читать is not yet. Russian marks that difference by changing the ending of the verb in the first and leaving it whole in the second, which is the opposite of what an English speaker expects."
            },
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Look at и and или as well. One letter apart on the page, and the difference between a list and a choice. Read quickly, that is the easiest mistake on this page to make."
            },
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "This is the first whole passage the book has asked you to hold at once, and it works because every line was paid for."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "the passage aloud, once, without stopping",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: the passage aloud, once, without stopping]"
            },
            {
              "kind": "repeat",
              "times": 2,
              "source": "[REPEAT x2]"
            },
            {
              "kind": "activity",
              "scored": true,
              "id": "RU-C27-pervoe-chtenie-name",
              "prompt": "What is her name?",
              "assesses": [
                "RU-SKILL-CONNECTED-READING"
              ],
              "responseSeconds": 13,
              "acceptedResponses": [
                "anna",
                "анна"
              ],
              "feedback": {
                "correct": "Анна.",
                "incorrect": "Анна -- Меня зовут Анна."
              }
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "How many words in that passage were new? (None.)"
            },
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Which two words are one letter apart and mean different things? (и and или.)"
            }
          ]
        }
      ]
    }
  ],
  "findings": []
}
