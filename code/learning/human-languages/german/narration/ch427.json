          "index": 1,
          "type": "input",
          "title": "You'll want to know: die Klimaanlage",
          "segments": [
            {
              "kind": "speech",
              "text": "die Klimaanlage — \"the air conditioning\"."
            },
            {
              "kind": "speech",
              "text": "Die Klimaanlage im Zimmer macht viel Lärm. The air conditioning in the room makes a lot of noise."
            },
            {
              "kind": "speech",
              "text": "Plural: die Klimaanlagen. Short: die Klima."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Klimaanlage is built from Klima 'climate', from Latin clima, from Greek klíma 'slope, region' (EtymDB), and Anlage 'installation', from anlegen 'to lay out' (EtymDB)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
