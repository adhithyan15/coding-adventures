# Perl 5.003_01 (1996-07-31) tokens: verified arithmetic-print subset only.
# @version 1
# PARTIAL: this does not lex all Perl 5.003_01 source.
# Evidence: https://github.com/Perl/perl5/blob/perl-5.003_01/perly.y
# Evidence: https://github.com/Perl/perl5/blob/perl-5.003_01/toke.c
# This release's tokenizer differs from 5.003 and still maps `print` to
# KEY_print, emits ADDOP/MULOP, and distinguishes PREDEC/POSTDEC.

PRINT     = "print"
INT       = /[0-9]+/
PLUS      = "+"
DECREMENT = "--"
MINUS     = "-"
STAR      = "*"
LPAREN    = "("
RPAREN    = ")"
SEMICOLON = ";"

skip:
  WHITESPACE = /[ \t\r\n]+/
