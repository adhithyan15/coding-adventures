        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Arabic for lettuce, then the Arabic for an aubergine."
            },
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "speech",
              "text": "Say \"dog\" and \"cat.\" (Kalb, like Hebrew kelev; qiṭṭ, compared with Latin cattus.)"
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ملفوف",
          "segments": [
            {
              "kind": "speech",
              "text": "ملفوف — malfūf — \"a cabbage\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ملفوف (malfūf) is built on the native Arabic root l-f-f, \"to wrap, to roll up\" (Lane). Malfūf is the passive participle, \"wrapped\", for the cabbage's folded leaves."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for this chapter."
            }
          ]
        },
        {
