        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: die Zuneigung",
          "segments": [
            {
              "kind": "speech",
              "text": "die Zuneigung — \"affection\"."
            },
            {
              "kind": "speech",
              "text": "Zwischen den beiden wuchs langsam eine tiefe Zuneigung. A deep affection slowly grew between the two."
            },
            {
              "kind": "speech",
              "text": "No plural in this sense. Built on sich zuneigen — to lean towards."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Zuneigung is built on zu \"towards\" and neigen \"to lean, to bow\", inherited from Middle High German and Old High German neigen (EtymDB): leaning towards someone."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
