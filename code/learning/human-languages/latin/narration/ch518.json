          "segments": [
            {
              "kind": "speech",
              "text": "coxa, coxae — \"hip\"."
            },
            {
              "kind": "speech",
              "text": "Senex in coxā dolōrem sentit. The old man feels pain in his hip."
            },
            {
              "kind": "speech",
              "text": "Feminine, first declension. French cuisse and Italian coscia — thigh — come from it."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "coxa is inherited from a Proto-Indo-European word for \"hip, joint\", and Old Irish cos \"foot, leg\" is a cousin (EtymDB). French cuisse \"thigh\" comes from it."
            }
          ]
        },
        {
