            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "pāṇyāsāṭhī gāvāt moṭhaṁ āndolan jhālaṁ. — There was a big agitation in the village for water.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *pāṇyāsāṭhī gāvāt moṭhaṁ āndolan jhālaṁ.* — There was a big agitation in the village for water.]"
