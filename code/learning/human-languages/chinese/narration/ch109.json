    {
      "id": "ZH-W109-wang-net",
      "sequence": 8515,
      "title": "网 (wǎng) — the frame of 两, and two crosses",
      "headword": "网",
      "romanization": "wǎng",
      "gloss": "网 — the frame of 两, and two crosses",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:7a72ba0938a444d8",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — the frame of 两, and two crosses",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — the frame of 两, and two crosses and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say shàngwǎng — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *shàngwǎng* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "两 上."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — liǎng, shàng",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *liǎng*, *shàng*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — the frame of 两, and two crosses",
          "segments": [
            {
              "kind": "speech",
              "text": "网 (wǎng)."
            },
            {
              "kind": "speech",
              "text": "The frame, two strokes, as in 两: a vertical down the left, then a stroke across the top that turns down the right side and hooks."
            },
            {
              "kind": "speech",
              "text": "Two small crosses inside, two strokes each, left before right: a left-falling stroke, then a dot across it."
            },
            {
              "kind": "speech",
              "text": "2 + 2 + 2 = six."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "网 (wǎng), all six, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 网, all six, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many strokes in 网 (wǎng)? (Six.) Where have you written its frame? (In 两.) What is inside? (Two small crosses, left one first.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 网 (wǎng), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
