        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: o raciocínio",
          "segments": [
            {
              "kind": "speech",
              "text": "o raciocínio — \"the reasoning, the train of thought\"."
            },
            {
              "kind": "speech",
              "text": "O teu raciocínio está certo, mas a conta está errada. Your reasoning is right, but the sum is wrong."
            },
            {
              "kind": "speech",
              "text": "Raciocinar — to reason."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "raciocínio is a learned borrowing from Latin ratiōcinium \"a reckoning, a computation\" (EtymDB, Lewis & Short), built on ratiō \"reckoning, reason\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
