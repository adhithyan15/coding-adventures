              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *abhimān*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "Aruṇ ko apne kām par abhimān hai. — Arun takes pride in his work.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *Aruṇ ko apne kām par abhimān hai.* — Arun takes pride in his work.]"
