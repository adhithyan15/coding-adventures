      "gloss": "to cry",
      "script": "tamil",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:0632927790921f43",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: what did siri mean, and what did payam mean?"
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: அழு",
          "segments": [
            {
              "kind": "speech",
              "text": "அழு (aḻu) — \"to cry\"."
            },
            {
              "kind": "speech",
              "text": "To cry — the mirror of the verb before it, and just as short."
            },
            {
              "kind": "speech",
              "text": "It opens on அ, the free-standing letter, because the word begins with that vowel: the same pattern you saw when ஓ opened ஓடு. And in the middle is ழ again, the third time you have met it after தமிழ் and கழுவு."
            },
