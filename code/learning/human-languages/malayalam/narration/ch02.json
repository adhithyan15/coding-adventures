              "kind": "prompt",
              "action": "SAY",
              "instruction": "\"ninṟe pēru entāṇŭ?\"",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: \"ninṟe pēru entāṇŭ?\"]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "hear the copula inside — entŭ + āṇŭ becomes entāṇŭ",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: hear the copula inside — *entŭ* + *āṇŭ* → *entāṇŭ*]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What two words fuse into എന്താണ്, and how does this differ from the Tamil question? (entŭ \"what\" + āṇŭ \"is\"; Tamil's question has no verb, Malayalam's carries the copula.)"
            }
          ]
        }
      ]
