              "kind": "prompt",
              "action": "HEAR",
              "instruction": "I did the work",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU HEAR: *I did the work*]"
            },
            {
              "kind": "speech",
              "text": "Say ਮੈਂ ਕੰਮ ਕੀਤਾ."
            },
            {
              "kind": "prompt",
              "action": "HEAR",
              "instruction": "to drink",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU HEAR: *to drink*]"
