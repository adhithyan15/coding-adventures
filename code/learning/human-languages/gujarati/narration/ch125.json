        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ભમર",
          "segments": [
            {
              "kind": "speech",
              "text": "ભમર (bhamar) — \"an eyebrow\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ભમર (bhamar) is a tadbhava. CDIAL lists it, as bhammar, under Sanskrit bhrū, \"eyebrow\" (CDIAL 9688). Its -m- is not fully explained; CDIAL thinks it scarcely comes from the verb bhram, \"to whirl\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
