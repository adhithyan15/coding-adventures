          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "assenza is a learned borrowing from Latin absentia \"absence\" (EtymDB), from absēns \"absent\", built on abesse \"to be away\", from ab and esse \"to be\"."
            }
          ]
        },
