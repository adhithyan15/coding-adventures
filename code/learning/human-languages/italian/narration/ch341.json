          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "contraddire comes from Latin contrādīcere \"to speak against\" (EtymDB), built from contrā \"against\" and dīcere \"to say\"; Italian reshaped it on dire."
            }
          ]
        },
