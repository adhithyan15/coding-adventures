        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ōlim",
          "segments": [
            {
              "kind": "speech",
              "text": "ōlim — \"once, long ago; one day\". It points to a time far off, usually long past: Ōlim Rōma parva erat. — \"Long ago Rome was small.\" erat is \"was\", from sum."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ōlim is built on ollus, \"that\", the archaic form of ille (Lewis & Short), with -im, an ending for a point in time: \"at that time\"."
            }
          ]
        },
