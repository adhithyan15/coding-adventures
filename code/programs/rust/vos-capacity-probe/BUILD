# VOS-028b (VOS30 section 9.3): the probe's unit and integration tests, then the QUICK tier only.
# SAT is slow in a debug build, so every cargo line here is --release.
cargo test --release -- --nocapture
# The quick tier: the smallest knob of every experiment, five seeds each, one child process per
# row.  It asserts verdicts and SAT controls, never timings, and fails on any row that is unknown,
# killed, oom, crashed or refused (the E1 N = 11 row must be refused with W0706, and the B1 row
# must report collapsed).
cargo run --release -q -- run --tier quick --out target/quick-results.json
# The committed results file: schema and guard rules on every row, then every quick-tier row is
# re-run and its digest, verdict, control and conflict count compared.  The full tier is a
# recorded offline run (`run --tier full`), regenerated by a reviewer, never run by BUILD.
cargo run --release -q -- check ../../../specs/data/vos30-capacity-results.json
# The generated table in the VOS30 spec must equal what `table` writes now, and section 8.5's
# stated decision must be the one the rows give.
cargo run --release -q -- table --check
# The fixture's generated harness the probe includes must still be what its generator writes.
cargo run -q --manifest-path ../../../packages/rust/Cargo.toml -p coding_adventures_warrant_grammar --example gen_evidence -- --check vos-probe-ready
