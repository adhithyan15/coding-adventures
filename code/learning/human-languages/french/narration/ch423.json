        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: la croisière",
          "segments": [
            {
              "kind": "speech",
              "text": "la croisière — \"the cruise\"."
            },
            {
              "kind": "speech",
              "text": "Mes grands-parents ont fait une croisière sur le fleuve. My grandparents went on a river cruise."
            },
            {
              "kind": "speech",
              "text": "Une vitesse de croisière — cruising speed."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "croisière is built on croiser 'to cross, to sail to and fro', from croix 'cross', which is inherited from Latin crux (Lewis & Short)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
