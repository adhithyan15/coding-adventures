          "segments": [
            {
              "kind": "speech",
              "text": "پوزش خواستن — puzesh khâstan — \"to apologise\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "puzesh khâstan is \"to ask for pardon\": puzesh, \"apology\", with khâstan, \"to ask for\". puzesh is native, but its older form is not settled. khâstan, \"to ask for\", is an inherited verb, from Middle Persian xwāstan (EtymDB)."
            }
          ]
        },
