        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: la serie",
          "segments": [
            {
              "kind": "speech",
              "text": "la serie — \"series\"."
            },
            {
              "kind": "speech",
              "text": "Stiamo guardando una serie poliziesca. We are watching a detective series."
            },
            {
              "kind": "speech",
              "text": "The same form in the plural: le serie. Una serie TV."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "serie is a learned borrowing from Latin seriēs \"a row, a chain\" (Lewis & Short), from serere \"to join\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
