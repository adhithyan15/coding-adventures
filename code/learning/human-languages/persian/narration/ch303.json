        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ابتدا",
          "segments": [
            {
              "kind": "speech",
              "text": "ابتدا (ebtedâ) — \"at first, at the start\"."
            },
            {
              "kind": "speech",
              "text": "ابتدا (ebtedâ) همه ساکت بودند. Ebtedâ hame sâket budand. At first everyone was quiet."
            },
            {
              "kind": "speech",
              "text": "Formal; in speech avval. Also a noun: dar ebtedâ-ye râh \"at the start of the road\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ebtedâ is borrowed from Arabic ibtidā', \"a beginning\" (EtymDB lists the Arabic source)."
            }
          ]
        },
