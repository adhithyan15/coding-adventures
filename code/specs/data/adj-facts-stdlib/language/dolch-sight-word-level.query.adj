% ============================================================================
% dolch-sight-word-level.query.adj — worked recall over the
% dolch-sight-word-level library.
% ============================================================================
% The shape a learner (or an LLM) produces to ANSWER "which Dolch reading
% level is this sight word taught at?" (direct) or "which words are taught
% at this Dolch level?" (reverse, many-answer) — it states no fact of its
% own — it only `import`s the grounded table and asks binding queries.
% ============================================================================

import "dolch-sight-word-level.adj"

? dolch_sight_word_level(the, $Level)          % expect pre_primer (direct)
? dolch_sight_word_level(funny, $Level)        % expect pre_primer (direct, the 40th/last Pre-Primer word -- confirms that completed level)
? dolch_sight_word_level($W, pre_primer)       % expect all 40 Pre-Primer words (reverse, many-answer -- a completed level)
? dolch_sight_word_level(laugh, $Level)        % expect third_grade (direct, the 41st/last Third Grade word -- confirms that completed level)
? dolch_sight_word_level($W, third_grade)      % expect all 41 Third Grade words (reverse, many-answer -- a completed level)
? dolch_sight_word_level(please, $Level)       % expect primer (direct, the 52nd/last Primer word -- confirms that completed level)
? dolch_sight_word_level($W, primer)           % expect all 52 Primer words (reverse, many-answer -- a completed level)
? dolch_sight_word_level(would, $Level)        % expect second_grade (direct)
? dolch_sight_word_level(thank, $Level)        % expect first_grade (direct, the 41st/last First Grade word -- confirms this round's completed level, and that the reserved-keyword-shaped `from`/`when` collision resolved cleanly)
? dolch_sight_word_level($W, first_grade)      % expect all 41 First Grade words (reverse, many-answer -- this round's completed level)
? dolch_sight_word_level(many, $Level)         % expect second_grade (direct, the 46th/last Second Grade word -- confirms this round's completed level, and that the apostrophe-bearing "don't" atom (shipped as `dont`) resolved cleanly)
? dolch_sight_word_level($W, second_grade)     % expect all 46 Second Grade words (reverse, many-answer -- this round's completed level)
? dolch_sight_word_level(elephant, $Level)     % expect abstain -- not a Dolch word at all (the only remaining abstention case now that all 220 words are shipped)
