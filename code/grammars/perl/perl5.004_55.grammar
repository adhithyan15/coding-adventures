# Perl 5.004_55 (1997-11-25) plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: unsupported Perl 5.004_55 syntax is rejected.
# Evidence: https://mirrors.develooper.com/perl/historical-perl/perl-5.004_55.tar.gz
# Archive SHA-256: 1eb2d7a6f70e7501fe62d8838a6e575f446e12e60cf1f6ad6d6ebeeaa6ed700b
# Its perly.y BEGIN/END/INIT subname action changes outside this subset.
# Only arithmetic precedence, grouping, and print are represented here.

program         = print_statement { print_statement } ;
print_statement = PRINT LPAREN expr RPAREN SEMICOLON ;
expr            = term { ( PLUS | MINUS ) term } ;
term            = unary { STAR unary } ;
unary           = MINUS unary | atom ;
atom            = INT | LPAREN expr RPAREN ;
