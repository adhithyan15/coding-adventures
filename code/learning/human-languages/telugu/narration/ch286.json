        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Vāyidā, \"postponement\", the first word of వాయిదా వేయు (vāyidā vēyu), is a loan from Arabic waʿda, \"promise, appointed time\", which came through Persian and Hindustani. Vēyu, \"to put, place\", is native (DEDR 5549)."
            }
          ]
        },
