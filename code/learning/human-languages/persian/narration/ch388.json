          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "مصرف (masraf) was borrowed from Arabic maṣraf (EtymDB), a word usually glossed as a place or way of spending; in Persian it is consumption."
            }
          ]
        },
