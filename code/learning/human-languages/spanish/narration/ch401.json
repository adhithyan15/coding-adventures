        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:01e94be3f340e09b",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Name the beach and the parking area. (La playa, el aparcamiento.)"
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know first",
          "segments": [
            {
              "kind": "speech",
              "text": "seguir — the action this direction modifies."
            },
            {
              "kind": "speech",
              "text": "derecha — right; a turn rather than a straight line."
            }
          ]
        },
        {
          "index": 2,
          "type": "pronunciation",
          "title": "Sounds you'll need",
          "segments": [
            {
              "kind": "speech",
              "text": "REC-to, two beats, weighted first. The pair in the middle is k-t."
            },
            {
              "kind": "speech",
              "text": "Keep recto/resto apart: REC-to has k; RES-to has s. see pronunciation reference."
            }
          ]
        },
        {
          "index": 3,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "recto — \"straight.\""
            },
            {
              "kind": "speech",
              "text": "It comes from Latin rectus, also \"straight.\" English rectilinear keeps the straight-line meaning, and every rectangle is built from straight sides and right angles."
            },
            {
              "kind": "speech",
              "text": "For a route, put it after the action:"
            },
            {
              "kind": "speech",
              "text": "seguir recto — continue straight."
            },
            {
              "kind": "speech",
              "text": "Do not let the exam's near-neighbour replace it:"
            },
            {
              "kind": "speech",
              "text": "recto — straight;"
            },
            {
              "kind": "speech",
              "text": "resto — the rest, the remainder."
            }
          ]
        },
        {
          "index": 4,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "You can combine an action and a quality into the direction seguir recto."
            }
          ]
        },
        {
