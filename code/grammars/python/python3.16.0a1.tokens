# Python 3.16.0a1 (2026-10-13) tokens: py-int-print lexical slice.
# @version 1
# PARTIAL: lexes only the py-int-print neighbourhood listed below; see code/grammars/python/README.md.
# source_ref: https://github.com/python/cpython/tree/v3.16.0a1
# source_sha: 22d79d9840a275ed6ed36cd590dc74edc61765fb
# evidence: Grammar/python.gram blob f2c9993aa4f80a78765d225d1b492db235c1378c; Grammar/Tokens blob 0547e6ed08f79ae397836c1b426af7760f7199ce;
#   Parser/lexer/lexer.c blob 83071e9e0b8ddf0e26fc81b54e4d10f7f12c52b7; Lib/keyword.py blob 98ffe2de28b1a1b9c04f298e4b6d833520e0ac77
# basis: reviewed against the tag's own syntax files (LANG84 phase 7a). Grammar/Tokens and keyword.py are blob-identical to 3.15.0's. Numbers moved to Parser/lexer/number.c (blob 220952a69cd69e869bb9a6e498b9cbad83d72859) with 3.13.16's rules (tok_decimal_tail, the leading-zeros error). The python.gram rules this subset uses (file, simple_stmts, sum, term, factor, primary, args) differ from 3.13.16's only in invalid_* error-reporting alternatives.

# ---------------------------------------------------------------------------
# What this pair lexes, and what it does not, so a reader never has to guess.
#
# Lexed: decimal integers, names, this release's keywords, every operator and
# delimiter its tokenizer knows, `#` comments, a `\`-newline continuation, and
# the indentation engine's NEWLINE/INDENT/DEDENT (newlines inside brackets are
# suppressed, blank and comment-only lines produce nothing).
#
# NOT lexed (a lexer error here; later LANG84 Python slices):
#   strings, bytes and f-strings      'a' "a" b'' f''
#   floats and imaginary numbers      1.5 1e3 .5 2j       (`1.5` lexes as INT DOT INT
#                                                          and fails to parse)
#   hex, octal and binary integers    0x1F 0o17 0b101
#   non-ASCII identifiers (PEP 3131), tabs before a comment, form feeds
#
# Known narrowings against the release's own tokenizer (each rejects; none
# accepts a program the release would read differently):
#   * A number must not run into a name character: `1if` and `1_` are lexer
#     errors (`\b` closes INT). CPython rejects `1_` too and only warns or
#     errors on `1if`, depending on the release.
#   * `\` must be followed directly by the newline, as CPython requires.
# ---------------------------------------------------------------------------

mode: indentation

skip:
  COMMENT           = /#[^\n]*/
  LINE_CONTINUATION = /\\\n/

# --- integers (PEP 515 `_` separators, 3.6+) ----------------------------------
# A non-zero decimal is a digit 1-9 then digits, each optionally preceded by one
# `_`. Zero is `0` then more zeros, each optionally after one `_` (`00`, `0_0`).
# `0123`, `0_1`, `1__0` and `1_` are errors in this release, and here.
INT = /(?:[1-9](?:_?[0-9])*|0(?:_?0)*)\b/

# --- names -------------------------------------------------------------------
NAME = /[a-zA-Z_][a-zA-Z0-9_]*/

# --- operators and delimiters (48 in this release's tokenizer) --------
# Longest first: the first matching pattern wins.
DOUBLE_STAR_EQUALS  = "**="
LEFT_SHIFT_EQUALS   = "<<="
RIGHT_SHIFT_EQUALS  = ">>="
FLOOR_DIV_EQUALS    = "//="
ELLIPSIS            = "..."
DOUBLE_STAR         = "**"
FLOOR_DIV           = "//"
LEFT_SHIFT          = "<<"
RIGHT_SHIFT         = ">>"
EQUALS_EQUALS       = "=="
NOT_EQUALS          = "!="
LESS_EQUALS         = "<="
GREATER_EQUALS      = ">="
ARROW               = "->"
PLUS_EQUALS         = "+="
MINUS_EQUALS        = "-="
STAR_EQUALS         = "*="
SLASH_EQUALS        = "/="
PERCENT_EQUALS      = "%="
AMP_EQUALS          = "&="
PIPE_EQUALS         = "|="
CARET_EQUALS        = "^="
AT_EQUALS           = "@="
WALRUS              = ":="
PLUS                = "+"
MINUS               = "-"
STAR                = "*"
SLASH               = "/"
PERCENT             = "%"
EQUALS              = "="
LESS_THAN           = "<"
GREATER_THAN        = ">"
AMP                 = "&"
PIPE                = "|"
CARET               = "^"
TILDE               = "~"
AT                  = "@"
EXCLAMATION         = "!"
LPAREN              = "("
RPAREN              = ")"
LBRACKET            = "["
RBRACKET            = "]"
LBRACE              = "{"
RBRACE              = "}"
COMMA               = ","
COLON               = ":"
SEMICOLON           = ";"
DOT                 = "."

# --- keywords (kwlist of Lib/keyword.py at the tag: 35) ------------------
# Soft keywords (`match`, `case`, `_`, `type`) stay NAME, so they are not listed.
keywords:
  False
  None
  True
  and
  as
  assert
  async
  await
  break
  class
  continue
  def
  del
  elif
  else
  except
  finally
  for
  from
  global
  if
  import
  in
  is
  lambda
  nonlocal
  not
  or
  pass
  raise
  return
  try
  while
  with
  yield
