        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: àihào",
          "segments": [
            {
              "kind": "speech",
              "text": "àihào — \"hobby\"."
            },
            {
              "kind": "speech",
              "text": "nǐ yǒu shénme àihào — What hobbies do you have?"
            },
            {
              "kind": "speech",
              "text": "Its characters come later; for now it is a word for the ear."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "àihào is built from ài 'to love' and hào 'to be fond of', both inherited from Middle Chinese, 'ojH and xawH (Guangyun, in Baxter's transcription), which glosses the first 'to cherish' and the second with this very word. The second is 好 said with a falling tone."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for what I like."
            }
          ]
        },
