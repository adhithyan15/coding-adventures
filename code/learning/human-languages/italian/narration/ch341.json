          "segments": [
            {
              "kind": "speech",
              "text": "obiettare — \"to object\"."
            },
            {
              "kind": "speech",
              "text": "Posso obiettare una cosa? Il prezzo è troppo alto. May I object to one thing? The price is too high."
            },
            {
              "kind": "speech",
              "text": "Obiettare che — to object that. Formal; in speech many people say non sono d'accordo."
            }
          ]
        },
