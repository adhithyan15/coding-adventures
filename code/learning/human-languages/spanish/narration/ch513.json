        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: la redacción",
          "segments": [
            {
              "kind": "speech",
              "text": "la redacción — \"the newsroom; the writing, the essay\"."
            },
            {
              "kind": "speech",
              "text": "La redacción del periódico está en el centro. The paper's newsroom is in the centre."
            },
            {
              "kind": "speech",
              "text": "At school una redacción is a written essay."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "redacción is built on redactar 'to write up, to draw up', which is usually traced to Latin redāctus, the participle of redigere 'to bring back, to reduce to order' (Lewis & Short), built on agere 'to drive'."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
