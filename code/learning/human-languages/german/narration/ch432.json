          "title": "You'll want to know: der Geschäftsführer",
          "segments": [
            {
              "kind": "speech",
              "text": "der Geschäftsführer — \"the manager, the managing director\"."
            },
            {
              "kind": "speech",
              "text": "Der Gast möchte mit dem Geschäftsführer sprechen. The guest would like to speak to the manager."
            },
            {
              "kind": "speech",
              "text": "Same form in the plural. A woman: die Geschäftsführerin."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Geschäftsführer is built from Geschäft 'business', inherited from Old High German giscaft (EtymDB), and Führer 'leader', from führen 'to lead'."
            }
          ]
        },
        {
