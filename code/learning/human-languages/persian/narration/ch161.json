        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "khoshmaze is khosh, \"pleasant\", with maze, \"taste\": pleasant-tasting. Both are native Persian; khosh is usually traced to Middle Persian xwaš."
            }
          ]
        },
