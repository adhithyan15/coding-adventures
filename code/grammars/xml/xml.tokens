# XML Token Grammar
# @version 1
# =================
#
# This grammar defines the lexical structure of XML 1.0. Unlike most
# programming languages, XML is *context-sensitive* at the lexical level:
# the same character has different meaning depending on position.
#
# For example, the equals sign `=` is:
# - An attribute delimiter inside a tag: <div class="main">
# - Plain text content outside a tag: 1 + 1 = 2
#
# To handle this, we use **pattern groups**. Each group defines a set
# of token patterns that are active only when that group is pushed onto
# the lexer's group stack. A callback function (written in the host
# language, not in this grammar file) controls when to push and pop
# groups based on which tokens are matched.
#
# Groups defined:
# - default (implicit): Content between tags — text, entities, tag openers
# - tag: Inside a tag — names, attributes, closing delimiters
# - comment: Inside <!-- ... -->
# - cdata: Inside <![CDATA[ ... ]]>
# - pi: Inside <? ... ?>
#
# The callback logic is straightforward:
# - OPEN_TAG_START or CLOSE_TAG_START → push("tag")
# - TAG_CLOSE or SELF_CLOSE → pop()
# - COMMENT_START → push("comment"), disable skip
# - COMMENT_END → pop(), enable skip
# - CDATA_START → push("cdata"), disable skip
# - CDATA_END → pop(), enable skip
# - PI_START → push("pi"), disable skip
# - PI_END → pop(), enable skip
#
# Portability note: every pattern below is written using only features that
# every target regex engine in this repo supports — no lookaround (`(?!`,
# `(?=`, ...) and no top-level alternation (`a|b`) inside a single token's
# regex. Lua's pattern engine has neither feature at all, and Rust's `regex`
# crate has no lookaround, so patterns relying on either would need a
# fork per host language. Two techniques keep this one file working
# everywhere (see the comment/cdata/pi groups and CHAR_REF below for both):
#
#   1. Split "A or B" into two separate rules aliased to the same token
#      name (`-> NAME`) instead of one rule with `A|B` — see CHAR_REF.
#   2. Replace "run of chars not starting the end delimiter" (a lookahead
#      idiom) with three rules in priority order: the end delimiter itself
#      (highest priority, tried first), a greedy bulk pattern for the safe
#      characters, and a single-character fallback (aliased to the bulk
#      token) for the one ambiguous character taken one at a time — see the
#      comment/cdata/pi groups. This means a comment/CDATA/PI body can
#      surface as *multiple* text tokens instead of one; the grammar
#      (`xml.grammar`) and AST builders account for that by repeating
#      (`{ COMMENT_TEXT }`, not `[ COMMENT_TEXT ]`) and concatenating.

escapes: none

# Skip patterns — whitespace is consumed silently in the default group
# and inside tags. Callbacks disable skip for comment/cdata/pi groups
# where whitespace is significant content.
skip:
  WHITESPACE = /[ \t\r\n]+/

# -----------------------------------------------------------------------
# Default group (implicit) — content between tags
# -----------------------------------------------------------------------
#
# When the lexer is in the default group, it recognizes text content,
# entity references, character references, and the opening delimiters
# for tags, comments, CDATA sections, and processing instructions.
#
# Pattern order matters! Longer/more-specific patterns must come first
# so they match before shorter ones. For example, COMMENT_START ("<!--")
# must precede OPEN_TAG_START ("<") or the lexer would match "<" first
# and never see "<!--".

TEXT              = /[^<&]+/
ENTITY_REF        = /&[a-zA-Z][a-zA-Z0-9]*;/

# CHAR_REF is "&#DIGITS;" (decimal) or "&#xHEX;" (hex). Written as two rules
# aliased to the same token name instead of one `A|B` pattern (see the
# portability note above) — hex is listed first since "&#x" is a strict
# prefix-disjoint case from the decimal form, so order doesn't matter for
# correctness, only for readability.
CHAR_REF_HEX      = /&#x[0-9a-fA-F]+;/ -> CHAR_REF
CHAR_REF_DEC      = /&#[0-9]+;/        -> CHAR_REF

COMMENT_START     = "<!--"
CDATA_START       = "<![CDATA["
PI_START          = "<?"
CLOSE_TAG_START   = "</"
OPEN_TAG_START    = "<"

# -----------------------------------------------------------------------
# Tag group — inside <tag ...> or </tag>
# -----------------------------------------------------------------------
#
# When a tag opener is matched (OPEN_TAG_START or CLOSE_TAG_START),
# the callback pushes the "tag" group. Inside this group, the lexer
# recognizes tag names, attribute names (same pattern as tag names),
# the equals sign, quoted attribute values, and tag closers.
#
# Attribute values can be double-quoted or single-quoted. Both variants
# alias to ATTR_VALUE so the parser sees a uniform token type.

group tag:
  TAG_NAME        = /[a-zA-Z_][a-zA-Z0-9_:.-]*/
  ATTR_EQUALS     = "="
  ATTR_VALUE_DQ   = /"[^"]*"/ -> ATTR_VALUE
  ATTR_VALUE_SQ   = /'[^']*'/ -> ATTR_VALUE
  TAG_CLOSE       = ">"
  SELF_CLOSE      = "/>"
  SLASH           = "/"

# -----------------------------------------------------------------------
# Comment group — inside <!-- ... -->
# -----------------------------------------------------------------------
#
# XML comments can contain any text except the sequence "-->" which ends
# the comment. Rather than a negative-lookahead regex (unsupported by some
# target engines — see the portability note above), this uses priority
# order: COMMENT_END is tried first and wins outright on "-->"; otherwise
# COMMENT_TEXT greedily consumes runs of non-dash characters; a lone dash
# that isn't part of "-->" falls through to COMMENT_DASH, which is aliased
# back to COMMENT_TEXT so the AST builder sees one token kind to collect
# and concatenate. ("hello - world" tokenizes as COMMENT_TEXT("hello "),
# COMMENT_DASH("-")->COMMENT_TEXT, COMMENT_TEXT(" world").)
#
# Skip patterns are disabled in this group (via callback) so that
# whitespace inside comments is preserved as part of COMMENT_TEXT.

group comment:
  COMMENT_END     = "-->"
  COMMENT_TEXT    = /[^-]+/
  COMMENT_DASH    = /-/ -> COMMENT_TEXT

# -----------------------------------------------------------------------
# CDATA group — inside <![CDATA[ ... ]]>
# -----------------------------------------------------------------------
#
# CDATA sections contain raw character data — no entity processing, no tag
# recognition. Everything is literal text until "]]>" is seen. Same
# priority-order technique as the comment group: CDATA_END wins outright on
# "]]>"; CDATA_TEXT greedily consumes non-bracket runs; a lone "]" that
# isn't part of "]]>" falls through to CDATA_BRACK, aliased to CDATA_TEXT.
#
# Skip patterns are disabled so whitespace is preserved.

group cdata:
  CDATA_END       = "]]>"
  CDATA_TEXT      = /[^\]]+/
  CDATA_BRACK     = /]/ -> CDATA_TEXT

# -----------------------------------------------------------------------
# Processing instruction groups — inside <? ... ?>
# -----------------------------------------------------------------------
#
# Processing instructions (PIs) like <?xml version="1.0"?> contain a target
# name and optional content, up to the closing "?>" delimiter. This needs
# *two* groups, not one, and that's not just the usual lookaround-free
# technique — it's a real disambiguation the other groups don't face.
#
# PI_TARGET may only be the very *first* token after PI_START; every group
# here is a flat, unordered-by-position list tried top-to-bottom on every
# token, so if PI_TARGET stayed in the same group as PI_TEXT/PI_QMARK, it
# would keep winning (it has to sit above PI_TEXT in priority, or the
# target name itself would be swallowed as body text) — and a PI body that
# contains a lone "?" followed by more letters, e.g. "<?t a?b?>", would
# have that "b" wrongly re-tokenized as a second PI_TARGET instead of body
# text once the "?" falls through to PI_QMARK. (COMMENT_TEXT/CDATA_TEXT
# don't have this problem: nothing else in their groups can also match an
# arbitrary run of characters.)
#
# So: `pi` (entered by PI_START) offers only PI_END and PI_TARGET. The
# callback swaps to `pi_body` the moment PI_TARGET matches — swap, not
# push, so PI_END's single pop still returns straight to the outer group.
# `pi_body` offers PI_END and the same priority-order bulk/fallback
# technique as the comment/cdata groups, with no PI_TARGET in sight to
# hijack anything.
#
# Skip patterns are disabled in both so whitespace is preserved.

group pi:
  PI_END          = "?>"
  PI_TARGET       = /[a-zA-Z_][a-zA-Z0-9_:.-]*/

group pi_body:
  PI_END          = "?>"
  PI_TEXT         = /[^?]+/
  PI_QMARK        = /\?/ -> PI_TEXT
