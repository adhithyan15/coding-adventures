        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: تزیین کردن",
          "segments": [
            {
              "kind": "speech",
              "text": "تزیین کردن (tazyin kardan) — \"to decorate\"."
            },
            {
              "kind": "speech",
              "text": "ما خانه را با گل تزیین کردیم. Mâ khâne râ bâ gol tazyin kardim. We decorated the house with flowers."
            },
            {
              "kind": "speech",
              "text": "Also spelled تزئین. Present tazyin mikonad."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "tazyin is usually traced to Arabic tazyīn, \"adornment\"; EtymDB lists no entry. kardan \"to do\" is inherited Persian."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
