        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ಸಮ್ಮತಿಸು",
          "segments": [
            {
              "kind": "speech",
              "text": "ಸಮ್ಮತಿಸು — sammatisu — \"to consent\"."
            },
            {
              "kind": "speech",
              "text": "ಅಪ್ಪ ನನ್ನ ಪ್ರವಾಸಕ್ಕೆ ಸಮ್ಮತಿಸಿದರು. appa nanna pravāsakke sammatisidaru. Father agreed to my trip."
            },
            {
              "kind": "speech",
              "text": "Past (I …): ಸಮ್ಮತಿಸಿದೆ, sammatiside."
            },
            {
              "kind": "speech",
              "text": "What you consent to takes -ಗೆ. ಸಮ್ಮತಿ, consent."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ಸಮ್ಮತಿಸು (sammatisu) is built on Sanskrit sammati, \"agreement, approval\" (Monier-Williams), with the Kannada verb ending -isu."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for giving reasons and opinions."
            }
          ]
        },
