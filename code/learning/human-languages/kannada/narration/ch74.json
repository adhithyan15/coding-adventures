          "segments": [
            {
              "kind": "speech",
              "text": "ಐದನೆಯ (aidaneya) — \"fifth\". ಐದು drops its -ು, takes -ಅನೆಯ, and the set is complete."
            },
            {
              "kind": "speech",
              "text": "ಐದನೆಯ ದಿನ (aidaneya dina), the fifth day."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
