          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "omnīnō is built on omnis, \"all\" (Lewis & Short): altogether. Where omnis comes from is uncertain."
            }
          ]
        },
