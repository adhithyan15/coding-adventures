        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: il battello",
          "segments": [
            {
              "kind": "speech",
              "text": "il battello — \"the boat (on a lake or river), the small steamer\"."
            },
            {
              "kind": "speech",
              "text": "Sul lago prendiamo il battello. On the lake we take the boat."
            },
            {
              "kind": "speech",
              "text": "For lakes and rivers; on the sea you take il traghetto."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "battello was borrowed from Old French batel, a little form of a word taken from Old English bāt 'boat' (EtymDB)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
