        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: tollō, tollere",
          "segments": [
            {
              "kind": "speech",
              "text": "tollō, tollere — \"to lift, to raise; to remove\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "tollō is inherited from Proto-Italic tolnō, \"to lift up\", usually traced to Proto-Indo-European tl-neh2-, \"to lift, to bear\" (EtymDB 2.1); Greek talanton, \"a balance, a weight\", is a cousin (Lewis & Short)."
            }
          ]
        },
