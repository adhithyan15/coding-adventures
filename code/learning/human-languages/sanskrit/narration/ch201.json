              "instruction": "yojanā, once more",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *yojanā*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "say yojanā",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: say *yojanā*]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
