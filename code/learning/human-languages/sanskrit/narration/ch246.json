          "segments": [
            {
              "kind": "speech",
              "text": "लाजाः — lājāḥ — \"puffed rice\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "lājāḥ is the plural of lāja, \"fried or parched grain\", used in the plural for the grains (MW). MW files it under a root √lāj, \"to fry\", and it is already in the Vājasaneyi Saṃhitā (CDIAL 11011). It lives on as Hindi lāī, \"parched grain\"."
            }
          ]
        },
