          "segments": [
            {
              "kind": "speech",
              "text": "व्याख्यान — vyākhyān — \"a lecture\"."
            },
            {
              "kind": "speech",
              "text": "प्राध्यापकांचं व्याख्यान दोन तास चाललं. prādhyāpkāñcaṁ vyākhyān don tās cāllaṁ. The professor's lecture went on for two hours."
            },
            {
              "kind": "speech",
              "text": "Neuter."
            },
            {
              "kind": "speech",
              "text": "व्याख्यान (vyākhyān) देणे, to give a lecture."
            }
          ]
        },
