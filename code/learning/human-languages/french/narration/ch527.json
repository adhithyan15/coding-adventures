            },
            {
              "kind": "speech",
              "text": "Je fais tremper le pantalon taché dans l'eau froide. I am soaking the stained trousers in cold water."
            },
            {
              "kind": "speech",
              "text": "Faire tremper — to leave to soak. Être trempé — to be soaked."
            }
          ]
        },
