            },
            {
              "kind": "speech",
              "text": "Before the new one: what did likhnā mean?"
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: बेटा",
          "segments": [
            {
              "kind": "speech",
              "text": "बेटा (beṭā) — \"son\"."
            },
            {
              "kind": "speech",
              "text": "The everyday word, not the Sanskrit putra that formal Hindi holds in reserve. Its -ā is the masculine ending you already met on बच्चा. Where the word itself came from is genuinely unsettled: comparative dictionaries reconstruct a Middle Indo-Aryan child-word behind it, with cousins in Punjabi, Gujarati and Marathi, and no agreed Sanskrit source."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "The first of four words for the people around you. Three follow, and each reuses the ones before."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "beṭā",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *beṭā*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "it once more, slowly",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: it once more, slowly]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "it after likhnā, so the two sit together",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: it after *likhnā*, so the two sit together]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What does बेटा (beṭā) mean? (\"son\".) Say it once more."
            }
          ]
        }
      ]
    },
