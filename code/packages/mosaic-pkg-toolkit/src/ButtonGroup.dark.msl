// ButtonGroup.dark.msl — dark-theme styling.

style ButtonGroup {
  part button-group {
    padding : 0 ;
  }
  part button-group-item {
    padding       : 8 ;
    background    : "#1e293b" ;
    color         : "#60a5fa" ;
    border-width  : 1 ;
    border-color  : "#60a5fa" ;
    font-size     : 14 ;
    border-radius : 0 ;
  }
}
