            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Persian for to seem, then the Persian for to be worried."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: گردگیری کردن",
          "segments": [
            {
              "kind": "speech",
              "text": "گردگیری کردن — gerdgiri kardan — \"to dust\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "gerdgiri kardan pairs gerdgiri, \"dust-taking\", with kardan. gerdgiri is gerd, \"dust\", with giri, \"taking\" (from gereftan, \"to take\"). All the pieces are native. kardan, \"to do\", is an inherited verb, from Middle Persian kardan (EtymDB)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
