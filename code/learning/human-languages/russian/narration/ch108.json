          "segments": [
            {
              "kind": "speech",
              "text": "полицейский (politséyskiy) — \"a police officer\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "полицейский (politséyskiy) is an adjective from полиция, \"police\", standing alone: \"a police officer\". полиция came, from Peter the Great's time, through Polish policja or German Polizei from Latin polītīa, Greek politeía, \"citizenship, government\" (Vasmer)."
            }
          ]
        },
