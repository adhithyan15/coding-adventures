            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "paṅkuccantai carintāl palar paṇattai iḻappārkaḷ. — If the stock market falls, many people will lose money.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *paṅkuccantai carintāl palar paṇattai iḻappārkaḷ.* — If the stock market falls, many people will lose money.]"
