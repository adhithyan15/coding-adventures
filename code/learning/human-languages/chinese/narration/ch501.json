        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: yùndòngyuán",
          "segments": [
            {
              "kind": "speech",
              "text": "yùndòngyuán — \"athlete\"."
            },
            {
              "kind": "speech",
              "text": "wǒ xiǎoshíhou xiǎng dāng yùndòngyuán — When I was a kid I wanted to be an athlete."
            },
            {
              "kind": "speech",
              "text": "Its characters come later; for now it is a word for the ear."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "yùndòngyuán is built from yùndòng 'sport' and yuán 'a member', all inherited from Middle Chinese, hjunH, duwngX and hjwen (Guangyun, in Baxter's transcription), which glosses the first 'to move' and the third 'a count of things'."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for saying how it was."
