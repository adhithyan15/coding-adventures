        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ಸಂಸಾರ",
          "segments": [
            {
              "kind": "speech",
              "text": "ಸಂಸಾರ — saṃsāra — \"family life; a household\"."
            },
            {
              "kind": "speech",
              "text": "ಅಕ್ಕ ತನ್ನ ಸಂಸಾರವನ್ನು ಚೆನ್ನಾಗಿ ನಡೆಸುತ್ತಾಳೆ. akka tanna saṃsāravannu cennāgi naḍesuttāḷe. My elder sister runs her household well."
            },
            {
              "kind": "speech",
              "text": "ಸಂಸಾರಿ, a family man or woman."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ಸಂಸಾರ (saṃsāra) is borrowed from Sanskrit saṃsāra, from saṃ-sṛ, \"to go round\", the round of worldly life (Monier-Williams); in Kannada it is the life of a family."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for describing what you lived and felt."
            }
          ]
        },
