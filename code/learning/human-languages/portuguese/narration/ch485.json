          "segments": [
            {
              "kind": "speech",
              "text": "a nódoa negra — \"bruise\"."
            },
            {
              "kind": "speech",
              "text": "Bati com a perna na cama e fiquei com uma nódoa negra. I hit my leg on the bed and got a bruise."
            },
            {
              "kind": "speech",
              "text": "Literally \"a black stain\". In Brazil: a mancha roxa."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "nódoa is inherited from Latin notula \"a little mark\" (EtymDB), a diminutive of nota \"a mark\"; negra comes from Latin niger \"black\" (Lewis & Short)."
            }
          ]
        },
