    {
      "id": "ZH-W196-piao-ticket",
      "sequence": 15415,
      "title": "票 (piào) — a framed top over 二 and three strokes",
      "headword": "票",
      "romanization": "piào",
      "gloss": "票 — a bar over a frame, then 二, a hooked vertical and two dots",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:81398b91d921afb4",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — a framed top over 二 and three strokes",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — a framed top over 二 and three strokes and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say chēpiào — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *chēpiào* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "车 二."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — chē, èr",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *chē*, *èr*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — a framed top over 二 and three strokes",
          "segments": [
            {
              "kind": "speech",
              "text": "票 (piào)."
            },
            {
              "kind": "speech",
              "text": "Two pieces, top before bottom."
            },
            {
              "kind": "speech",
              "text": "The top piece, six strokes. A bar across the top. Then a frame under it: a short vertical on the left, a stroke along the top that turns down the right side, two short verticals down through the top of the frame, and a bar that closes it."
            },
            {
              "kind": "speech",
              "text": "The bottom piece, five strokes. 二: a short bar, then a longer one. A vertical down the middle that hooks to the left at its foot. A dot falling to the left, then a dot falling to the right."
            },
            {
              "kind": "speech",
              "text": "6 + 5 = eleven."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "票 (piào), all eleven, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 票, all eleven, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many strokes in 票 (piào)? (Eleven.) What starts the bottom piece? (二.) What sits either side of the hooked vertical? (Two dots.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 票 (piào), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
