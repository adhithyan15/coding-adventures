          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Umwelt is um-, \"around\", + Welt, \"world\": the world around us. Welt was first \"the age of man\". (EtymDB 2.1)."
            }
