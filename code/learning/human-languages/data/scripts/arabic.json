{
  "script": "arabic",
  "name": "Arabic",
  "font": "_fonts/NotoNaskhArabic-Static.ttf",
  "direction": "rtl",
  "system": "abjad",
  "signature": "Right-to-left, joined into one flowing cursive ribbon, with dots placed above and below the line.",
  "complete": false,
  "combination": "Written right-to-left and cursive: most letters JOIN their neighbours and change shape by position — isolated, initial, medial, final. Six letters (ا د ذ ر ز و) never connect to the letter that follows them, so they force a break. Short vowels are usually unwritten; when shown they are harakat (small marks) above or below. Many letters share one skeleton and differ only by the number and position of DOTS — so the dots are a real 'piece' to practise.",
  "notes": "Used by the Arabic track. The initial inventory below covers the greeting/self-introduction vocabulary; it grows toward the full 28-letter set. Stroke orders are the common handwriting convention (right-to-left), not a standard.",
  "letters": [
    { "glyph": "ا", "sound": "ā / a (also a vowel carrier)", "role": "consonant", "forms": { "isolated": "ا", "initial": "ا", "medial": "ـا", "final": "ـا" }, "components": ["a single tall vertical stroke"], "strokeOrder": ["one downward vertical"], "strokeOrderNote": "conventional", "notes": "Does NOT join to the letter after it." },
    { "glyph": "ب", "sound": "b", "role": "consonant", "forms": { "isolated": "ب", "initial": "بـ", "medial": "ـبـ", "final": "ـب" }, "components": ["a shallow boat-shaped bowl", "one dot BELOW"], "strokeOrder": ["the bowl", "the dot below"], "strokeOrderNote": "conventional", "notes": "Skeleton shared with ت (two dots above), ث (three above), ن (one above), ي (two below)." },
    { "glyph": "ت", "sound": "t", "role": "consonant", "forms": { "isolated": "ت", "initial": "تـ", "medial": "ـتـ", "final": "ـت" }, "components": ["the boat bowl", "two dots ABOVE"], "strokeOrder": ["bowl", "two dots above"], "strokeOrderNote": "conventional" },
    { "glyph": "ث", "sound": "th", "role": "consonant", "forms": { "isolated": "ث", "initial": "ثـ", "medial": "ـثـ", "final": "ـث" }, "components": ["the boat bowl", "three dots ABOVE"], "strokeOrder": ["bowl", "three dots above"], "strokeOrderNote": "conventional" },
    { "glyph": "ج", "sound": "j", "role": "consonant", "forms": { "isolated": "ج", "initial": "جـ", "medial": "ـجـ", "final": "ـج" }, "components": ["a rounded hook with a tail dropping below the line", "one dot BELOW"], "strokeOrder": ["hook body", "descending tail", "dot below"], "strokeOrderNote": "conventional", "notes": "Skeleton shared with ح (no dot) and خ (one dot above)." },
    { "glyph": "ح", "sound": "ḥ (deep h)", "role": "consonant", "forms": { "isolated": "ح", "initial": "حـ", "medial": "ـحـ", "final": "ـح" }, "components": ["the same hook-and-tail body", "NO dot"], "strokeOrder": ["hook body", "descending tail"], "strokeOrderNote": "conventional" },
    { "glyph": "خ", "sound": "kh", "role": "consonant", "forms": { "isolated": "خ", "initial": "خـ", "medial": "ـخـ", "final": "ـخ" }, "components": ["the hook-and-tail body", "one dot ABOVE"], "strokeOrder": ["hook body", "descending tail", "dot above"], "strokeOrderNote": "conventional" },
    { "glyph": "د", "sound": "d", "role": "consonant", "forms": { "isolated": "د", "initial": "د", "medial": "ـد", "final": "ـد" }, "components": ["a single angular stroke like a bent nib"], "strokeOrder": ["one angled stroke"], "strokeOrderNote": "conventional", "notes": "Does NOT join to the letter after it." },
    { "glyph": "ر", "sound": "r", "role": "consonant", "forms": { "isolated": "ر", "initial": "ر", "medial": "ـر", "final": "ـر" }, "components": ["a short stroke curving below the line"], "strokeOrder": ["one curving downstroke"], "strokeOrderNote": "conventional", "notes": "Does NOT join to the letter after it." },
    { "glyph": "س", "sound": "s", "role": "consonant", "forms": { "isolated": "س", "initial": "سـ", "medial": "ـسـ", "final": "ـس" }, "components": ["three teeth (small humps)", "a final bowl"], "strokeOrder": ["three teeth", "the trailing bowl"], "strokeOrderNote": "conventional", "notes": "Skeleton shared with ش (three dots above)." },
    { "glyph": "ش", "sound": "sh", "role": "consonant", "forms": { "isolated": "ش", "initial": "شـ", "medial": "ـشـ", "final": "ـش" }, "components": ["three teeth", "a final bowl", "three dots ABOVE"], "strokeOrder": ["three teeth", "bowl", "three dots above"], "strokeOrderNote": "conventional" },
    { "glyph": "ص", "sound": "ṣ (emphatic s)", "role": "consonant", "forms": { "isolated": "ص", "initial": "صـ", "medial": "ـصـ", "final": "ـص" }, "components": ["a wide oval body", "a following bowl"], "strokeOrder": ["oval body", "trailing bowl"], "strokeOrderNote": "conventional", "notes": "Skeleton shared with ض (one dot above)." },
    { "glyph": "ع", "sound": "ʿ (ʿayn — a throat sound)", "role": "consonant", "forms": { "isolated": "ع", "initial": "عـ", "medial": "ـعـ", "final": "ـع" }, "components": ["an open-mouth curve on top", "a bowl below when final"], "strokeOrder": ["upper open curve", "lower bowl"], "strokeOrderNote": "conventional", "notes": "Skeleton shared with غ (one dot above)." },
    { "glyph": "ك", "sound": "k", "role": "consonant", "forms": { "isolated": "ك", "initial": "كـ", "medial": "ـكـ", "final": "ـك" }, "components": ["an angular upright body", "a small hamza-like stroke inside"], "strokeOrder": ["upright body", "inner stroke"], "strokeOrderNote": "conventional" },
    { "glyph": "ل", "sound": "l", "role": "consonant", "forms": { "isolated": "ل", "initial": "لـ", "medial": "ـلـ", "final": "ـل" }, "components": ["a tall upright", "a bowl curving up at the base"], "strokeOrder": ["upright", "base bowl"], "strokeOrderNote": "conventional", "notes": "لا (lām-alif) is a special obligatory ligature." },
    { "glyph": "م", "sound": "m", "role": "consonant", "forms": { "isolated": "م", "initial": "مـ", "medial": "ـمـ", "final": "ـم" }, "components": ["a small round head", "a tail dropping straight down (isolated/final)"], "strokeOrder": ["round head", "descending tail"], "strokeOrderNote": "conventional" },
    { "glyph": "ن", "sound": "n", "role": "consonant", "forms": { "isolated": "ن", "initial": "نـ", "medial": "ـنـ", "final": "ـن" }, "components": ["a deep bowl", "one dot ABOVE"], "strokeOrder": ["bowl", "dot above"], "strokeOrderNote": "conventional" },
    { "glyph": "ه", "sound": "h", "role": "consonant", "forms": { "isolated": "ه", "initial": "هـ", "medial": "ـهـ", "final": "ـه" }, "components": ["a loop that changes shape a lot by position"], "strokeOrder": ["the loop body"], "strokeOrderNote": "conventional", "notes": "Final ـة (tāʾ marbūṭa) is a related feminine ending." },
    { "glyph": "و", "sound": "w / ū", "role": "consonant", "forms": { "isolated": "و", "initial": "و", "medial": "ـو", "final": "ـو" }, "components": ["a small round head", "a tail curving below the line"], "strokeOrder": ["round head", "descending tail"], "strokeOrderNote": "conventional", "notes": "Does NOT join to the letter after it. Also carries the long vowel ū." },
    { "glyph": "ي", "sound": "y / ī", "role": "consonant", "forms": { "isolated": "ي", "initial": "يـ", "medial": "ـيـ", "final": "ـي" }, "components": ["the boat bowl (isolated) / tooth (joined)", "two dots BELOW"], "strokeOrder": ["body", "two dots below"], "strokeOrderNote": "conventional", "notes": "Also carries the long vowel ī." },
    { "glyph": "ء", "sound": "ʾ (hamza — a glottal stop)", "role": "other", "forms": { "isolated": "ء" }, "components": ["a small ʿayn-head shape, sitting on a carrier (ا و ي) or on the line"], "strokeOrder": ["the small head"], "strokeOrderNote": "conventional", "notes": "Often written on a seat: أ إ (on alif), ؤ (on wāw), ئ (on yāʾ)." }
  ],
  "marks": [
    { "mark": "َ", "sound": "a", "role": "diacritic", "attachesAs": "fatḥa — a short slash ABOVE the consonant", "example": { "base": "ب", "combined": "بَ", "sound": "ba" } },
    { "mark": "ِ", "sound": "i", "role": "diacritic", "attachesAs": "kasra — a short slash BELOW the consonant", "example": { "base": "ب", "combined": "بِ", "sound": "bi" } },
    { "mark": "ُ", "sound": "u", "role": "diacritic", "attachesAs": "ḍamma — a small wāw-shape ABOVE the consonant", "example": { "base": "ب", "combined": "بُ", "sound": "bu" } },
    { "mark": "ْ", "sound": "(no vowel)", "role": "diacritic", "attachesAs": "sukūn — a small circle ABOVE, marking no vowel", "example": { "base": "بْ", "combined": "بْ", "sound": "b" } },
    { "mark": "ّ", "sound": "(doubling)", "role": "diacritic", "attachesAs": "shadda — a small w-shape ABOVE, doubling the consonant", "example": { "base": "د", "combined": "دّ", "sound": "dd" } },
    { "mark": "ً", "sound": "an", "role": "diacritic", "attachesAs": "tanwīn fatḥ — double fatḥa, the indefinite '-an' ending (as in شكرًا)", "example": { "base": "ر", "combined": "رً", "sound": "ran" } }
  ]
}
