          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "varaq comes from Arabic waraq (EtymDB), a word for leaves and sheets of paper; Persian took the sheet and, from it, the playing card."
            }
          ]
        },
