          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "façade was borrowed from Italian facciata (EtymDB), built on faccia 'face', which goes back to Latin faciēs."
            }
          ]
        },
