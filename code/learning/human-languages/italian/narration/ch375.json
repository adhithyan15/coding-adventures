        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: annullare",
          "segments": [
            {
              "kind": "speech",
              "text": "annullare — \"to cancel, to call off\"."
            },
            {
              "kind": "speech",
              "text": "Se piove, annulliamo la gita. If it rains, we will call off the trip."
            },
            {
              "kind": "speech",
              "text": "Il volo è stato annullato — the flight has been cancelled."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "annullare comes from Late Latin annullāre \"to bring to nothing\" (EtymDB), built from ad and nūllus \"none\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
