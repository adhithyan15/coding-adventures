}

.variational-selected-summary {
  display: grid;
  gap: 4px;
  padding: 11px;
  border-left: 3px solid rgba(109, 91, 208, 0.45);
  background: rgba(109, 91, 208, 0.045);
}

.variational-selected-summary small,
.variational-selected-summary span {
