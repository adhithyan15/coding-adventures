% ADJ52 case-2 — patient observations + queries.
% Numeric IR args normalized to qualitative atoms for the adj-lang IDENT grammar:
% patient_age(29)->age(under_30); full_scale_iq(62)->iq(low_range);
% cognitive_screen 27/30 -> 21/30 over 3 months -> cognitive_screen(declining_over_months).

observe age(under_30)
observe patient_sex(male)
observe referral_reason(possible_adult_adhd)
observe symptom(progressive_forgetfulness)
observe symptom(distractibility)
observe symptom(impaired_planning)
observe premorbid_trait(lifelong_disorganized_scattered)
observe symptom(unusual_fatigue)
observe symptom(generalized_pruritus_episodic)
observe symptom(restlessness_fidgetiness_unsuppressible)
observe symptom(chronic_intermittent_loose_stools)
observe past_history(graves_disease_hyperthyroidism)
observe screen(adult_adhd_questionnaire_positive)
observe iq(low_range)
observe cognitive_screen(declining_over_months)
observe characterization(multidomain_amnestic_cognitive_impairment)
observe exam(hyperreflexia_four_limbs)
observe exam(bilateral_extensor_plantar_responses)
observe exam(progression_to_spastic_gait)
observe exam(bilateral_leg_tremor)
observe exam(bilateral_achilles_tendon_swellings_firm_painless)
observe exam(bilateral_cataracts)
observe test(osteoporosis_premature_for_age)
observe lab(elevated_antithyroid_antibodies)
observe test(csf_unremarkable)
observe test(eeg_no_epileptiform_activity)
observe test(nerve_conduction_normal)
observe imaging(mri_symmetric_t2_flair_hyperintensities)
observe mri_site(cerebellar_white_matter)
observe mri_site(dentate_nuclei)
observe mri_site(cerebral_peduncles)
observe mri_site(hypothalamus)
observe mri_site(posterior_limb_internal_capsule)

% q1 — unifying diagnosis (candidates)
? diagnosis(cerebrotendinous_xanthomatosis)
? diagnosis(adult_adhd)
? diagnosis(autoimmune_thyroid_encephalopathy)
? diagnosis(adrenoleukodystrophy)
? diagnosis(mitochondrial_leukoencephalopathy)

% q3 — confirmatory next step
? next_step(serum_cholestanol_assay)
? next_step(cyp27a1_genetic_testing)
