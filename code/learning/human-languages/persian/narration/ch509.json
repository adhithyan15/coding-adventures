          "index": 1,
          "type": "input",
          "title": "You'll want to know: تخته نرد",
          "segments": [
            {
              "kind": "speech",
              "text": "تخته نرد (takhte nard) — \"backgammon\"."
            },
            {
              "kind": "speech",
              "text": "پدربزرگ و پدرم عصرها تخته نرد بازی میکنند. pedarbozorg va pedaram 'asrhâ takhte nard bâzi mikonand. Grandfather and my father play backgammon in the afternoons."
            },
            {
              "kind": "speech",
              "text": "takhte 'board' + nard. Often shortened to takhte."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "takhte nard joins inherited takhte, which EtymDB traces to a Middle Persian word for 'tablet, plank, (chess) board' (EtymDB), and nard, the game's own name, whose origin is not settled."
            }
          ]
        },
