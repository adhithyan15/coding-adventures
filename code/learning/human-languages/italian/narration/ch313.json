        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: la morte",
          "segments": [
            {
              "kind": "speech",
              "text": "la morte — \"death\"."
            },
            {
              "kind": "speech",
              "text": "La morte del nonno ci ha cambiato la vita. Grandfather's death changed our lives."
            },
            {
              "kind": "speech",
              "text": "Annoiarsi a morte — to be bored to death."
            }
          ]
        },
