          "segments": [
            {
              "kind": "speech",
              "text": "verhindern — \"to prevent\"."
            },
            {
              "kind": "speech",
              "text": "Der Regen hat das Spiel nicht verhindert. The rain did not prevent the game."
            },
            {
              "kind": "speech",
              "text": "Inseparable: er verhindert, er hat verhindert. Verhindert sein — to be unable to come."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "verhindern is built with ver- on hindern \"to hinder\", a verb from the family of hinter \"behind\": you hold a thing back. EtymDB has no history for the verbs; Proto-Germanic hinder \"behind\" is the usual source."
            }
          ]
        },
