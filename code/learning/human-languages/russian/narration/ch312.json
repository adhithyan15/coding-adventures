            },
            {
              "kind": "speech",
              "text": "Отец произнёс тост за молодых. Otéts proiznyós tost za molodýkh. Father proposed a toast to the newlyweds."
            },
            {
              "kind": "speech",
              "text": "Поднять тост (tost) за + accusative. Also toasted bread."
            }
          ]
        },
