warrant tuple_forms v1
  -- Synthetic ir.tuple document of slice S10t-1 (VER04r Appendix A.1): every tuple form,
  -- every match pattern and every ir.tuple fault template.  GENERATED by make_tuple_forms.py;
  -- do not edit by hand.
  error TupleError = Bad | Worse | Worst

  -- pure models: tuple literals (arity 2 to 8, nesting, a typed literal context), project,
  -- structural equality, and match on a Result with every pattern --------------------------
  model lit2(a: Bool, b: Bool) -> (Bool,Bool) = (a, b)
  model lit3(a: Bool, b: Bool, c: Bool) -> (Bool,Bool,Bool) = (a, b, c)
  model lit4(a: Bool, b: Bool, c: Bool, d: Bool) -> (Bool,Bool,Bool,Bool) = (a, b, c, d)
  model lit5(a: Bool, b: Bool, c: Bool, d: Bool, e: Bool) -> (Bool,Bool,Bool,Bool,Bool) = (a, b, c, d, e)
  model lit6(a: Bool, b: Bool, c: Bool, d: Bool, e: Bool, f: Bool) -> (Bool,Bool,Bool,Bool,Bool,Bool) = (a, b, c, d, e, f)
  model lit7(a: Bool, b: Bool, c: Bool, d: Bool, e: Bool, f: Bool, g: Bool) -> (Bool,Bool,Bool,Bool,Bool,Bool,Bool) = (a, b, c, d, e, f, g)
  model lit8(a: Bool, b: Bool, c: Bool, d: Bool, e: Bool, f: Bool, g: Bool, h: Bool) -> (Bool,Bool,Bool,Bool,Bool,Bool,Bool,Bool) = (a, b, c, d, e, f, g, h)
  model nested(a: Bool, b: Bool, c: Bool) -> ((Bool,Bool),Bool) = ((a, b), c)
  model deep(a: Bool) -> (((Bool,Nat),Bool),Bytes<0>) = (((a, 1), not a), b"")
  model lit_ctx() -> (Nat,Nat) = (1, 2)
  model lit_arith(a: U8) -> (U8,Nat) = (a + 1u8, 3)
  model pair(a: Bool, n: Nat) -> (Bool,Nat) = (a, n)
  model proj0(t: (Bool,Nat)) -> Bool = t.0
  model proj1(t: (Bool,Nat)) -> Nat = t.1
  model proj_chain(t: ((Bool,Nat),Bool)) -> Nat = t.0.1
  model proj_last8(t: (Bool,Bool,Bool,Bool,Bool,Bool,Bool,Bool)) -> Bool = t.7
  model proj_postfix(a: Bool, n: Nat) -> Nat = pair(a, n).1
  model proj_literal() -> U8 = (true, 2u8).1
  model swap(t: (Bool,Bool)) -> (Bool,Bool) = (t.1, t.0)
  model tup_eq(a: (Bool,Bool), b: (Bool,Bool)) -> Bool = a == b
  model tup_ne(a: (Bool,Bool), b: (Bool,Bool)) -> Bool = a != b
  model tup_eq_lit(a: (Bool,Nat)) -> Bool = a == (true, 3)
  model k(a: Bool, b: Bool) -> Result<(Bool,Bool),TupleError> = if a and b then Err(TupleError.Worse) else Ok((a, b))
  model dec(a: Bool, n: Nat) -> Result<(Bool,Nat),TupleError> = if n > 60 then Err(TupleError.Bad) else Ok((a, n))
  model m_ok_wild(r: Result<(Bool,Bool),TupleError>) -> Bool = match r with Ok(_) -> true | Err(_) -> false
  model m_ok_bind(r: Result<Bool,TupleError>) -> Bool = match r with Ok(x) -> x | Err(_) -> false
  model m_ok_tuple(r: Result<(Bool,Bool),TupleError>) -> Bool = match r with Ok((a, b)) -> a and b | Err(_) -> false
  model m_ok_tuple_wild(r: Result<(Bool,Bool),TupleError>) -> Bool = match r with Ok((_, b)) -> b | Err(_) -> false
  model m_ok_nested(r: Result<((Bool,Bool),Bool),TupleError>) -> Bool = match r with Ok(((a, _), c)) -> a and c | Err(_) -> false
  model m_err_cases(r: Result<Bool,TupleError>) -> Nat = match r with Ok(_) -> 0 | Err(TupleError.Bad) -> 1 | Err(TupleError.Worse) -> 2 | Err(TupleError.Worst) -> 3
  model m_err_any_last(r: Result<Bool,TupleError>) -> Nat = match r with Err(TupleError.Bad) -> 1 | Err(e) -> 2 | Ok(_) -> 0
  model m_bind_whole(r: Result<Bool,TupleError>) -> Bool = match r with Ok(_) -> true | whole -> whole == r
  model m_wild_arm(r: Result<Bool,TupleError>) -> Nat = match r with Ok(_) -> 1 | _ -> 0
  model m_returns_tuple(r: Result<(Bool,Bool),TupleError>) -> (Bool,Bool) = match r with Ok((a, b)) -> (b, a) | Err(_) -> (false, false)
  model m_returns_result(r: Result<(Bool,Bool),TupleError>) -> Result<(Bool,Bool),TupleError> = match r with Ok((a, b)) -> Ok((b, a)) | Err(_) -> Err(TupleError.Bad)
  model m_nested_match(r: Result<Result<Bool,TupleError>,TupleError>) -> Nat = match r with Ok(Ok(_)) -> 0 | Ok(Err(_)) -> 1 | Err(_) -> 2
  model m_inner_match(r: Result<Bool,TupleError>, s: Result<Bool,TupleError>) -> Bool = match r with Ok(x) -> (match s with Ok(y) -> x and y | Err(_) -> false) | Err(_) -> false
  model m_on_call(a: Bool, b: Bool) -> Bool = match k(a, b) with Ok((x, _)) -> x | Err(TupleError.Worse) -> true | Err(_) -> false
  model m_arith_arm(r: Result<U8,TupleError>) -> U8 = match r with Ok(x) -> x + 1u8 | Err(_) -> 0u8
  model mixed(a: U8, n: Nat, d: Bytes<0>, f: Bool) -> (U8,Nat,Bytes<0>,Bool) = (a, n, d, f)

  -- subject ops, claims and examples ---------------------------------------------------
  op op_lit2(a: Bool, b: Bool) -> (Bool,Bool)
  op op_lit3(a: Bool, b: Bool, c: Bool) -> (Bool,Bool,Bool)
  op op_lit4(a: Bool, b: Bool, c: Bool, d: Bool) -> (Bool,Bool,Bool,Bool)
  op op_lit5(a: Bool, b: Bool, c: Bool, d: Bool, e: Bool) -> (Bool,Bool,Bool,Bool,Bool)
