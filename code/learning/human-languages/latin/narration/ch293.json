          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "paulisper is built on paulum, \"a little\", the neuter of paulus, \"small\", and per, \"through\" (EtymDB, Lewis & Short): through a small stretch of time."
            }
          ]
        },
