          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "جواب (javāb) is a loan from Arabic jawāb, \"an answer\", which reached Urdu through Persian. Its Arabic root is j-w-b (Lane)."
            }
          ]
