  "passRule": {
    "maximumPoints": 100,
    "passPoints": 60,
    "requiresEverySectionAttempted": true,
    "independentSkillThresholds": {
      "reading": null,
      "listening": null,
      "writing": null,
      "speaking": null
    },
    "note": "DELE A2 awards 25 points per prueba and requires at least 30/50 in each of two GROUPS: Grupo 1 is comprensión de lectura plus expresión e interacción escritas, and Grupo 2 is comprensión auditiva plus expresión e interacción orales. Reading is therefore paired with WRITING and listening with SPEAKING -- not reception with reception -- so a candidate who reads well and writes badly can fail Grupo 1 while passing overall on points. Sixty is the smallest possible passing total and 60/100 alone is not sufficient. Instituto Cervantes publishes no four independent skill thresholds; this file therefore leaves them null rather than inventing them, and the project assessment contract adds its own."
  },
