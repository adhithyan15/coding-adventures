        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "जालम् (jālam) is the word MW gives for a net for catching birds or fish; MW gives no derivation, so its origin is uncertain (MW)."
            }
          ]
        },
