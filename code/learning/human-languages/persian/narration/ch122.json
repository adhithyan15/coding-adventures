            {
              "kind": "speech",
              "text": "Before the new one: say the Persian for an insect, then the Persian for a giraffe."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: نهنگ",
          "segments": [
            {
              "kind": "speech",
              "text": "نهنگ — nahang — \"a whale\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "nahang is a native Persian word, inherited rather than borrowed: it continues Middle Persian nihang, \"crocodile\" (EtymDB). Persian moved it from the crocodile to the whale."
            }
          ]
        },
        {
