          "index": 1,
          "type": "input",
          "title": "You'll want to know: పిల్లలు",
          "segments": [
            {
              "kind": "speech",
              "text": "పిల్లలు (pillalu) — \"children\"."
            },
            {
              "kind": "speech",
              "text": "మీకు పిల్లలు (pillalu) ఉన్నారా? — \"do you have children?\", literally \"to you, are there children?\". The -లు at the end is the plural you met in your very first lesson."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "The question that follows a name in almost every first conversation."
            }
          ]
        },
