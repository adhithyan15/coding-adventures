            },
            {
              "kind": "speech",
              "text": "Letzte Woche habe ich zehn Überstunden gemacht. Last week I worked ten hours of overtime."
            },
            {
              "kind": "speech",
              "text": "Mostly plural: Überstunden machen — to work overtime."
            }
          ]
