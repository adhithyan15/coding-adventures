# Perl 5.003_97a (1997-04-05) tokens: plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: this does not lex all Perl 5.003_97a source.
# Evidence: https://github.com/Perl/perl5/blob/perl-5.003_97a/toke.c
# Tagged tokenizer matches 5.003_97. Unsupported characters, carriage
# returns and leading-zero forms remain refused.

PRINT     = "print"
INT       = /0|[1-9][0-9]*/
PLUS      = "+"
DECREMENT = "--"
MINUS     = "-"
STAR      = "*"
LPAREN    = "("
RPAREN    = ")"
SEMICOLON = ";"

skip:
  WHITESPACE = /[ \t\n]+/
