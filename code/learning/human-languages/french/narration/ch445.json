        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: la quincaillerie",
          "segments": [
            {
              "kind": "speech",
              "text": "la quincaillerie — \"the hardware shop, the ironmonger’s\"."
            },
            {
              "kind": "speech",
              "text": "Il achète des clous à la quincaillerie. He buys nails at the hardware shop."
            },
            {
              "kind": "speech",
              "text": "Le quincaillier runs it."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "quincaillerie is built on quincaille 'small metal goods', which is usually traced to an old word that imitates the clink of metal. EtymDB lists it without a source."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
