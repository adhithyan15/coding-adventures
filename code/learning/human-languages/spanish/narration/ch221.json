                "este libro",
                "este libro."
              ],
              "feedback": {
                "correct": "And it is in your hand.",
                "incorrect": "Este libro."
              }
            },
            {
              "kind": "activity",
              "scored": true,
              "id": "ES-C59-este-agree",
              "prompt": "Now: this house.",
              "assesses": [
                "ES-GRAMMAR-DEMONSTRATIVE-ESTE"
              ],
              "responseSeconds": 12,
