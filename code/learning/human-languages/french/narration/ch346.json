          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "causer is built on cause, which comes from Latin causa \"cause, reason, lawsuit\" (EtymDB; Lewis & Short)."
            }
          ]
        },
