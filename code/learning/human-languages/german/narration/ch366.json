          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "wenigstens is built on the superlative of wenig \"little\", from Middle High German weinec (EtymDB), with the adverb ending -ens: \"at the very least\"."
            }
          ]
        },
