        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: el combate",
          "segments": [
            {
              "kind": "speech",
              "text": "el combate — \"the fight, the combat\"."
            },
            {
              "kind": "speech",
              "text": "Murieron cien hombres en el combate. A hundred men died in the fighting."
            },
            {
              "kind": "speech",
              "text": "Fuera de combate — out of action, knocked out."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "combate is built on combatir 'to fight', which comes from spoken Latin combattere (EtymDB), built on com- and battuere 'to beat'."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
