  -- claims: one reference claim per model (op_<m>(args) == m(args)) ------------------------
  claim c_lit2:
    forall a: Bool, b: Bool. op_lit2(a, b) == lit2(a, b)
  claim c_lit3:
    forall a: Bool, b: Bool, c: Bool. op_lit3(a, b, c) == lit3(a, b, c)
  claim c_lit4:
    forall a: Bool, b: Bool, c: Bool, d: Bool. op_lit4(a, b, c, d) == lit4(a, b, c, d)
  claim c_lit5:
    forall a: Bool, b: Bool, c: Bool, d: Bool, e: Bool. op_lit5(a, b, c, d, e) == lit5(a, b, c, d, e)
  claim c_lit6:
    forall a: Bool, b: Bool, c: Bool, d: Bool, e: Bool, f: Bool. op_lit6(a, b, c, d, e, f) == lit6(a, b, c, d, e, f)
  claim c_lit7:
    forall a: Bool, b: Bool, c: Bool, d: Bool, e: Bool, f: Bool, g: Bool. op_lit7(a, b, c, d, e, f, g) == lit7(a, b, c, d, e, f, g)
  claim c_lit8:
    forall a: Bool, b: Bool, c: Bool, d: Bool, e: Bool, f: Bool, g: Bool, h: Bool. op_lit8(a, b, c, d, e, f, g, h) == lit8(a, b, c, d, e, f, g, h)
  claim c_nested:
    forall a: Bool, b: Bool, c: Bool. op_nested(a, b, c) == nested(a, b, c)
  claim c_deep:
    forall a: Bool. op_deep(a) == deep(a)
  claim c_lit_ctx:
    op_lit_ctx() == lit_ctx()
  claim c_lit_arith:
    forall a: U8. op_lit_arith(a) == lit_arith(a)
  claim c_pair:
    forall a: Bool, n: Nat. op_pair(a, n) == pair(a, n)
  claim c_proj0:
    forall t: (Bool,Nat). op_proj0(t) == proj0(t)
  claim c_proj1:
    forall t: (Bool,Nat). op_proj1(t) == proj1(t)
  claim c_proj_chain:
    forall t: ((Bool,Nat),Bool). op_proj_chain(t) == proj_chain(t)
  claim c_proj_last8:
    forall t: (Bool,Bool,Bool,Bool,Bool,Bool,Bool,Bool). op_proj_last8(t) == proj_last8(t)
  claim c_proj_postfix:
    forall a: Bool, n: Nat. op_proj_postfix(a, n) == proj_postfix(a, n)
  claim c_proj_literal:
    op_proj_literal() == proj_literal()
  claim c_swap:
    forall t: (Bool,Bool). op_swap(t) == swap(t)
  claim c_tup_eq:
    forall a: (Bool,Bool), b: (Bool,Bool). op_tup_eq(a, b) == tup_eq(a, b)
  claim c_tup_ne:
    forall a: (Bool,Bool), b: (Bool,Bool). op_tup_ne(a, b) == tup_ne(a, b)
  claim c_tup_eq_lit:
    forall a: (Bool,Nat). op_tup_eq_lit(a) == tup_eq_lit(a)
  claim c_k:
    forall a: Bool, b: Bool. op_k(a, b) == k(a, b)
  claim c_dec:
    forall a: Bool, n: Nat. op_dec(a, n) == dec(a, n)
  claim c_m_ok_wild:
    forall r: Result<(Bool,Bool),TupleError>. op_m_ok_wild(r) == m_ok_wild(r)
  claim c_m_ok_bind:
    forall r: Result<Bool,TupleError>. op_m_ok_bind(r) == m_ok_bind(r)
  claim c_m_ok_tuple:
    forall r: Result<(Bool,Bool),TupleError>. op_m_ok_tuple(r) == m_ok_tuple(r)
  claim c_m_ok_tuple_wild:
    forall r: Result<(Bool,Bool),TupleError>. op_m_ok_tuple_wild(r) == m_ok_tuple_wild(r)
  claim c_m_ok_nested:
    forall r: Result<((Bool,Bool),Bool),TupleError>. op_m_ok_nested(r) == m_ok_nested(r)
  claim c_m_err_cases:
    forall r: Result<Bool,TupleError>. op_m_err_cases(r) == m_err_cases(r)
  claim c_m_err_any_last:
    forall r: Result<Bool,TupleError>. op_m_err_any_last(r) == m_err_any_last(r)
  claim c_m_bind_whole:
    forall r: Result<Bool,TupleError>. op_m_bind_whole(r) == m_bind_whole(r)
  claim c_m_wild_arm:
    forall r: Result<Bool,TupleError>. op_m_wild_arm(r) == m_wild_arm(r)
  claim c_m_returns_tuple:
    forall r: Result<(Bool,Bool),TupleError>. op_m_returns_tuple(r) == m_returns_tuple(r)
  claim c_m_returns_result:
    forall r: Result<(Bool,Bool),TupleError>. op_m_returns_result(r) == m_returns_result(r)
  claim c_m_nested_match:
    forall r: Result<Result<Bool,TupleError>,TupleError>. op_m_nested_match(r) == m_nested_match(r)
  claim c_m_inner_match:
    forall r: Result<Bool,TupleError>, s: Result<Bool,TupleError>. op_m_inner_match(r, s) == m_inner_match(r, s)
  claim c_m_on_call:
    forall a: Bool, b: Bool. op_m_on_call(a, b) == m_on_call(a, b)
  claim c_m_arith_arm:
    forall r: Result<U8,TupleError>. op_m_arith_arm(r) == m_arith_arm(r)
  claim c_mixed:
    forall a: U8, n: Nat | n < 2, d: Bytes<0>, f: Bool. op_mixed(a, n, d, f) == (a, n, d, f)
  claim c_pair_literal:
    forall a: Bool. op_pair(a, 1) == (a, 1)
  claim c_swap_involutive:
    forall t: (Bool,Bool). op_swap(op_swap(t)) == t
  claim c_u8_bool_ne:
    forall a: (Bool,Bool), b: (Bool,Bool). op_tup_eq(a, b) != tup_ne(a, b)
  claim c_u8_bool:
    forall t: (U8,Bool). op_inc(t.0) == t.0 + 1u8

  -- claims: match on a Result.  Pure scrutinee, evaluated in the expected side -------------
  claim c_ok_and_inline:
    forall r: Result<(Bool,Bool),TupleError>. op_m_ok_tuple(r) == (match r with Ok((a, b)) -> a and b | Err(_) -> false)
  claim c_flip:
    forall r: Result<(Bool,Bool),TupleError>. op_flip(r) == m_returns_result(r)
  claim c_flip_inline:
    forall r: Result<(Bool,Bool),TupleError>. op_flip(r) == (match r with Ok((a, b)) -> Ok((b, a)) | Err(_) -> Err(TupleError.Bad))
  claim c_inc_in_arm:
    forall r: Result<U8,TupleError>. op_inc(match r with Ok(x) -> x | Err(_) -> 0u8) == m_arith_arm(r)
  claim c_admit_match:
    forall r: Result<(Bool,Bool),TupleError> | match r with Ok((a, b)) -> a or b | Err(_) -> true. op_m_ok_tuple(r) == m_ok_tuple(r)

  -- claims: a subject call as the scrutinee, and a subject call inside an arm (pure scrutinee) -
  claim c_k_match:
    forall a: Bool, b: Bool. match op_k(a, b) with Ok((x, y)) -> x == a and y == b | Err(TupleError.Worse) -> a and b | Err(_) -> false
  claim c_zero:
    forall d: Bytes<0>. op_zero(d) == Err(TupleError.Bad)
  claim c_arm_calls:
    forall r: Result<U8,TupleError>. match r with Ok(x) -> op_inc(x) == x + 1u8 | Err(_) -> true
  claim c_arm_admit_call:
    forall r: Result<U8,TupleError> | match r with Ok(x) -> x < 100u8 | Err(_) -> true. match r with Ok(x) -> op_small(x) == x | Err(_) -> true

  -- claims for the faults of the Bytes forms ------------------------------------------------
  claim c_bytes:
    forall d: Bytes<2>. op_bytes(d) == (if len(d) == 2 then Ok(d) else Err(TupleError.Bad))
  claim c_bits:
    forall d: Bytes<2>. op_bits(d) == d
  claim c_u8:
    forall a: U8. op_u8(a) == a

  -- examples: tuple values in TFV (L<n>), eq-shaped; the two match-shaped ones are omitted ----
  example e_pair:
    op_pair(true, 3) == (true, 3)
  example e_lit2:
    op_lit2(true, false) == (true, false)
  example e_nested:
    op_nested(true, false, true) == ((true, false), true)
  example e_tuple_arg:
    op_swap((true, false)) == (false, true)
  example e_k_ok:
    op_k(true, false) == Ok((true, false))
  example e_k_err:
    op_k(true, true) == Err(TupleError.Worse)
  example e_dec:
    op_dec(true, 7) == Ok((true, 7))
  example e_result_arg:
    op_flip(Ok((true, false))) == Ok((false, true))
  example e_match_ok:
    match op_k(true, false) with Ok((a, b)) -> a and not b | Err(_) -> false
  example e_match_err:
    match op_k(true, true) with Ok(_) -> false | Err(TupleError.Worse) -> true | Err(_) -> false

