          "segments": [
            {
              "kind": "speech",
              "text": "la delusione — \"disappointment\"."
            },
            {
              "kind": "speech",
              "text": "Non passare l'esame è stata una grande delusione. Failing the exam was a big disappointment."
            },
            {
              "kind": "speech",
              "text": "Una delusione d'amore — a heartbreak."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "delusione is a learned borrowing from Late Latin dēlūsiō \"a deceiving\" (Lewis & Short), from dēlūdere; in Italian it came to mean the feeling when hopes are let down."
            }
          ]
        },
