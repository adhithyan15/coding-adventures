          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "réservé is the past participle of réserver \"to keep back\", which comes from Latin reservāre (Lewis & Short), built on servāre \"to keep, to watch over\"."
            }
          ]
        },
