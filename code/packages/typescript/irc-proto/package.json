{
  "name": "@coding-adventures/irc-proto",
  "version": "0.1.0",
  "description": "Pure IRC message parsing and serialization (RFC 1459) — zero dependencies",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc",
    "test": "node node_modules/typescript/bin/tsc -p tsconfig.test.json && node --test dist-test/tests/irc_proto.test.js",
    "test:coverage": "node node_modules/typescript/bin/tsc -p tsconfig.test.json && node --experimental-test-coverage --test-coverage-lines=80 --test dist-test/tests/irc_proto.test.js"
  },
  "keywords": [
    "irc",
    "protocol",
    "parsing",
    "serialization",
    "rfc1459",
    "computer-science",
    "education"
  ],
  "author": "Adhithya Rajasekaran",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.0.0"
  }
}
