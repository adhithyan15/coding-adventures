        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: تیز",
          "segments": [
            {
              "kind": "speech",
              "text": "تیز — tiz — \"sharp\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "tiz is a native Persian word, inherited rather than borrowed; it is usually traced to Middle Persian tēz, \"sharp\". EtymDB takes it back to the Indo-European root (s)teyg-, \"to be sharp, to prick\", the root usually also given for English stick."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for this chapter."
