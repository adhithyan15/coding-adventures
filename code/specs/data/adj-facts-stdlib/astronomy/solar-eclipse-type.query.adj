% ============================================================================
% solar-eclipse-type.query.adj — worked recall over the
% solar-eclipse-type library.
% ============================================================================
% The shape a learner (or an LLM) produces to ANSWER "what is this solar
% eclipse type?" (direct) or "which eclipse type matches this
% description?" (reverse) — it states no fact of its own — it only
% `import`s the grounded table and asks binding queries.
% ============================================================================

import "solar-eclipse-type.adj"

? solar_eclipse_type(total_solar_eclipse, $D)                          % expect completely_blocking_the_face_of_the_sun (direct)
? solar_eclipse_type($T, moon_at_or_near_its_farthest_point_from_earth) % expect annular_solar_eclipse (reverse)
? solar_eclipse_type(hybrid_solar_eclipse, $D)                          % expect abstain -- a real eclipse type the source covers, but not one of the three tabled here
