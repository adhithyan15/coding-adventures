    {
      "id": "ZH-W81-li-inside",
      "sequence": 6195,
      "title": "里 (lǐ) — 日, a line through it, two bars",
      "headword": "里",
      "romanization": "lǐ",
      "gloss": "里 — 日, a line through it, two bars",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:3867ea8251381eb5",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — 日, a line through it, two bars",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — 日, a line through it, two bars and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say lǐ — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *lǐ* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "日 家."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — rì, jiā",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *rì*, *jiā*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — 日, a line through it, two bars",
          "segments": [
            {
              "kind": "speech",
              "text": "里 (lǐ)."
            },
            {
              "kind": "speech",
              "text": "One piece, built from the top down."
            },
            {
              "kind": "speech",
              "text": "日, four strokes: the left side, the top that turns down, the middle bar, the bottom bar."
            },
            {
              "kind": "speech",
              "text": "A vertical down the middle, through 日 and on below it."
            },
            {
              "kind": "speech",
              "text": "Two horizontals, a short one across the vertical, then a long one along the bottom."
            },
            {
              "kind": "speech",
              "text": "4 + 1 + 2 = seven."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "里 (lǐ), all seven, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 里, all seven, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many strokes in 里 (lǐ)? (Seven.) Which character you know is at the top? (日.) Which bar is longest? (The last, along the bottom.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 里 (lǐ), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
