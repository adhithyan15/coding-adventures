              "kind": "speech",
              "text": "Masculine."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "फेफड़ा (phephṛā) is a tadbhava: CDIAL lists Hindi phephṛā, \"lungs\", under Sanskrit phupphusa, \"lungs\" (CDIAL 9090)."
            }
          ]
        },
