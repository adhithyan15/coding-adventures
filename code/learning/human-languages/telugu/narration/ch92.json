          "segments": [
            {
              "kind": "speech",
              "text": "గాయం (gāyaṁ) — \"a wound, an injury\"."
            },
            {
              "kind": "speech",
              "text": "గాయం (gāyaṁ) అయింది — \"I have been hurt\", literally \"a wound has happened\". Like a wedding, an injury is something that happens."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "గాయం (gāyaṁ) comes from Sanskrit ghāta, \"blow, bruise\", reshaped to Telugu sounds: a tadbhava (CDIAL 4460). Prakrit ghāya, \"wound\", in the same entry, shows the same loss of the t."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "A way to say you are hurt."
            }
          ]
        },
