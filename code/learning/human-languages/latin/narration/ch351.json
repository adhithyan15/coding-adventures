        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: concīdō, concīdere",
          "segments": [
            {
              "kind": "speech",
              "text": "concīdō, concīdere — \"to chop up, to cut to pieces\"."
            },
            {
              "kind": "speech",
              "text": "Coquus cēpās et ālium concīdit. The cook chopped up the onions and garlic."
            },
            {
              "kind": "speech",
              "text": "concīdō, concīdere, concīdī, concīsum, long ī: con- + caedō. Do not confuse concidō, 'to collapse'. English concise."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "concīdō is built on caedō, \"to cut\", with con- (EtymDB): to cut up small. English concise, cut short, comes from its participle."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
