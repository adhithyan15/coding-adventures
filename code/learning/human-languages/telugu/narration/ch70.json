        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: కప్ప",
          "segments": [
            {
              "kind": "speech",
              "text": "కప్ప (kappa) — \"a frog\"."
            },
            {
              "kind": "speech",
              "text": "కప్ప (kappa) is a frog. Set it beside కప్పు, the roof, and you have a pair worth saying twice: one small vowel at the end is the whole difference."
            },
            {
              "kind": "speech",
              "text": "It is inherited and it belongs to the rains. The first కప్ప (kappa) heard after dark is how a గ్రామం knows the season turned, before anybody looks at a calendar."
            },
            {
              "kind": "speech",
              "text": "Telugu uses it for somebody whose world is small — a కప్ప (kappa) in a well, which is a picture a dozen unrelated languages reached for on their own."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "Two. And the roof is still కప్పు."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
