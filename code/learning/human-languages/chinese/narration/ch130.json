    {
      "id": "ZH-W130-bing-ill",
      "sequence": 10365,
      "title": "病 (bìng) — the sickbed piece around a box",
      "headword": "病",
      "romanization": "bìng",
      "gloss": "病 — the sickbed piece, and a small 人 in a box",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:8989e0177d48605f",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — the sickbed piece around a box",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — the sickbed piece around a box and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say bìngrén — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *bìngrén* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "人 男."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — rén, nán",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *rén*, *nán*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — the sickbed piece around a box",
          "segments": [
            {
              "kind": "speech",
              "text": "病 (bìng)."
            },
            {
              "kind": "speech",
              "text": "Two pieces: the sickbed piece outside, a boxed piece inside."
            },
            {
              "kind": "speech",
              "text": "The sickbed piece, five strokes. A dot at the top, a horizontal under it, a long left-falling stroke down the left side, then on the left a short dot and a short stroke rising to the right."
            },
            {
              "kind": "speech",
              "text": "The inside piece, five strokes. A horizontal across the top; a short vertical, the left side of the box; a horizontal that turns down the right side and hooks; then a small 人 from the top bar into the box: its left-falling stroke, then its dot."
            },
            {
              "kind": "speech",
              "text": "5 + 5 = ten."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "病 (bìng), all ten, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 病, all ten, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many pieces in 病 (bìng)? (Two — the sickbed piece and the boxed piece.) What sits on the left of the sickbed piece? (A dot and a rising stroke.) What is inside the box? (A small 人.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 病 (bìng), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
