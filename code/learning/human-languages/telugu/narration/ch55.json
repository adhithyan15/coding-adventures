      "id": "TE-C55-river",
      "sequence": 1580,
      "title": "నది (nadi) — a river",
      "headword": "నది",
      "romanization": "nadi",
      "gloss": "a river",
      "script": "telugu",
      "modality": "voice",
      "derivedModality": "voice",
