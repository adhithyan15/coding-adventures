              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *onnāṁ*, and say what you did to *onnŭ* to build it — **R2**]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say pinne — R3",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
