        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: el voto",
          "segments": [
            {
              "kind": "speech",
              "text": "el voto — \"the vote\"."
            },
            {
              "kind": "speech",
              "text": "Cada voto es importante. Every vote matters."
            },
            {
              "kind": "speech",
              "text": "Votar — to vote."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "voto is a learned borrowing from Latin votum 'a vow, a wish', from vovere 'to vow' (EtymDB)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
