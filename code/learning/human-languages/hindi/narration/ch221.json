              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Hindi for old age, then the Hindi for life."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: मौत",
          "segments": [
            {
              "kind": "speech",
              "text": "मौत — maut — \"death\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "मौत (maut) is a loan from Arabic mawt, \"death\", which reached Hindi through Persian. Its Arabic root is m-w-t (Lane)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
