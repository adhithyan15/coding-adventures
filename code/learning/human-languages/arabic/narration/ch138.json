        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: نسر",
          "segments": [
            {
              "kind": "speech",
              "text": "نسر — nasr — \"an eagle\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "نسر (nasr) is built on the native Arabic root n-s-r, \"to pluck with the beak\" (Lane); nasr is a vulture or an eagle. Lane compares Hebrew nesher, \"eagle\"."
            }
          ]
        },
        {
