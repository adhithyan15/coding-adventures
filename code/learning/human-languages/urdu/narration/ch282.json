          "segments": [
            {
              "kind": "speech",
              "text": "تفتیش — taftīsh — \"an investigation\"."
            },
            {
              "kind": "speech",
              "text": "تفتیش میں ایک مہینہ لگا۔ taftīsh meṅ ek mahīnā lagā. The investigation took a month."
            },
