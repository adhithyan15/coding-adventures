        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: مغز",
          "segments": [
            {
              "kind": "speech",
              "text": "مغز (maghz) — \"the brain\"."
            },
            {
              "kind": "speech",
              "text": "مغز در خواب هم کار میکند. maghz dar khâb ham kâr mikonad. The brain works even during sleep."
            },
            {
              "kind": "speech",
              "text": "Also the kernel of a nut: maghz-e gerdu 'a walnut kernel'."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "maghz is inherited: EtymDB traces it to Middle Persian, where the word meant 'brain, marrow' (EtymDB)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
