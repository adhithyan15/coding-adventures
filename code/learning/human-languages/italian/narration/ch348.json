          "segments": [
            {
              "kind": "speech",
              "text": "l'aspetto — \"the aspect, the side (of a question); the look, the appearance\"."
            },
            {
              "kind": "speech",
              "text": "C'è un aspetto del problema che non abbiamo considerato. There is one side of the problem that we have not considered."
            },
            {
              "kind": "speech",
              "text": "Also how something looks: ha un bell'aspetto. Do not mix it up with aspetto \"I wait\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "aspetto is a learned borrowing from Latin aspectus \"a look, an appearance\" (Lewis & Short), from aspicere \"to behold\", built on specere \"to look\". The verb aspettare \"to wait\" comes from the same Latin family."
            }
          ]
        },
