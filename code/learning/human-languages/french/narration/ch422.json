        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: le ferry",
          "segments": [
            {
              "kind": "speech",
              "text": "le ferry — \"the ferry\"."
            },
            {
              "kind": "speech",
              "text": "Nous prenons le ferry pour aller sur l'île. We take the ferry to go over to the island."
            },
            {
              "kind": "speech",
              "text": "In Québec: le traversier."
            }
          ]
        },
        {
