# @version 1
#
# Mermaid 11.16.1 radar parser grammar. Semantic lowering resolves detailed
# curve entries against declared axes and validates curve cardinality.

document = { terminator } HEADER { terminator | statement } EOF ;
terminator = NEWLINE | SEMICOLON ;
statement = ACC_TITLE_STATEMENT | ACC_DESCR_STATEMENT | ACC_DESCR_BLOCK | TITLE_STATEMENT | AXIS_STATEMENT | CURVE_STATEMENT ;
