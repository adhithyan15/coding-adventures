          "type": "input",
          "title": "You'll want to know: la diretta",
          "segments": [
            {
              "kind": "speech",
              "text": "la diretta — \"the live broadcast\"."
            },
            {
              "kind": "speech",
              "text": "Guardiamo la partita in diretta. Let us watch the match live."
            },
            {
              "kind": "speech",
              "text": "In diretta — live; the opposite is in differita, recorded."
            }
          ]
