          "segments": [
            {
              "kind": "speech",
              "text": "la décennie — \"the decade\"."
            },
            {
              "kind": "speech",
              "text": "La ville a beaucoup changé en une décennie. The town changed a lot in a decade."
            },
            {
              "kind": "speech",
              "text": "Ten years. La décade is also heard in this sense, though strictly it means ten days."
            }
          ]
        },
