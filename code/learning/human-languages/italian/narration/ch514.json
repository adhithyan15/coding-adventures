        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: il tuffo",
          "segments": [
            {
              "kind": "speech",
              "text": "il tuffo — \"dive, plunge\"."
            },
            {
              "kind": "speech",
              "text": "Ho fatto un tuffo dal molo. I dived in from the pier."
            },
            {
              "kind": "speech",
              "text": "Fare un tuffo — to go for a dip."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "The origin of tuffo is not settled; it is often taken to imitate the sound of a body hitting water, or traced to a Germanic word for dipping."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
