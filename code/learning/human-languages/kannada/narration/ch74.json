        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ಮೂರನೆಯ",
          "segments": [
            {
              "kind": "speech",
              "text": "ಮೂರನೆಯ (mūraneya) — \"third\"."
            },
            {
              "kind": "speech",
              "text": "You have already met the machine that made it. ಮೂರು loses its final -ು and takes -ಅನೆಯ:"
            },
            {
              "kind": "table",
              "headers": [
                "cardinal",
                "ordinal"
              ],
              "columns": 2,
              "rowCount": 2,
              "utterances": [
                "cardinal: ಎರಡು (eraḍu). ordinal: ಎರಡನೆಯ (eraḍaneya).",
                "cardinal: ಮೂರು (mūru). ordinal: ಮೂರನೆಯ (mūraneya)."
              ]
            },
            {
              "kind": "speech",
              "text": "ಮೂರನೆಯ ದಿನ (mūraneya dina), the third day. ಮೂರನೆಯ ಮರ (mūraneya mara), the third tree."
            },
            {
              "kind": "speech",
              "text": "This is the second word and it needed nothing new. That is what an exceptionless ending buys you: from here on, a number you can say is a position you can say."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
