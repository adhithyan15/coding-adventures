              "action": "SAY",
              "instruction": "el primo",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *el primo*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "el primo y el tío",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *el primo y el tío*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "el nombre del primo",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *el nombre del primo*]"
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What does primus mean? (First.) Which word did you already have from it? (Primero.) Which half of consobrinus primus did English keep? (Consobrinus, which became cousin.)"
            }
          ]
        }
      ]
    },
