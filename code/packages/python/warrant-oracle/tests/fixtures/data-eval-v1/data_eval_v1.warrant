warrant data_eval v1
  -- Synthetic ir.data EVALUATION document of slice S11c-1 (VER04r Appendix A.2, 5.1, 8.2): records, variants
  -- and Option evaluated over their domains, data values in examples, and the faults that need ir.data.
  -- GENERATED by make_data_eval.py; do not edit by hand.
  error DataError = Bad | Worse
  record Point(x: U8, y: U8)
  record Wrapped(p: Point, tag: Bool)
  record Slot(o: Option<U8>, t: (Bool,Nat))
  record Tri(a: Bool, n: Nat)
  record Duo(a: Bool, b: Bool)
  record Wide(w: U16, n: Nat)
  record Sum(sum: Bytes, carry_out: U8, overflow: Bool)
  record AluOut(result: Bytes, zero: Bool, carry: Bool, negative: Bool, overflow: Bool)
  record Holder(d: Bytes, pair: (Bytes,Bool))
  variant Shape = Circle(r: U8) | Rect(w: U8, h: U8) | Dot
  variant Mode = Add | Sub | Neg
  variant Dir = Up | Down(f: Bool) | Both(f: Bool, g: Bool)
  variant Msg = Short | Done(n: Nat, rest: Option<U16>) | Opt(o: Option<U8>)

  -- pure models: one per form of Appendix A.2, then one per fault op ------------------------------
  model some_u8(a: U8) -> Option<U8> = Some(a)
  model none_u8(u: Bool) -> Option<U8> = None
  model some_nested(a: Bool) -> Option<Option<Bool>> = Some(Some(a))
  model some_none(u: Bool) -> Option<Option<Bool>> = Some(None)
  model opt_if(c: Bool, a: U8) -> Option<U8> = if c then Some(a) else None
  model opt_bytes(d: Bytes) -> Option<Bytes> = if len(d) == 0 then None else Some(d)
  model opt_pair(a: Bool, n: Nat) -> Option<(Bool,Nat)> = Some((a, n))
  model opt_widen_nat(a: Nat) -> Option<Nat> = Some(a)
  model opt_eq(a: Option<U8>, b: Option<U8>) -> Bool = a == b
  model opt_ne(a: Option<Bool>, b: Option<Bool>) -> Bool = a != b
  model opt_is_none(a: Option<U8>) -> Bool = a == None
  model opt_is_some_lit(a: Option<U8>) -> Bool = Some(1u8) == a
  model unwrap_binder(o: Option<U8>) -> U8 = unwrap_or(o, 5u8)
  model unwrap_nested(o: Option<Option<Bool>>) -> Option<Bool> = unwrap_or(o, None)
  model inter_add(a: U8, b: U8) -> U8 = unwrap_or(checked_add(a, b), 0u8)
  model prod_eq(a: U8, b: U8) -> Bool = checked_add(a, b) == Some(a)
  model prod_try(a: Nat) -> Option<U8> = try<U8>(a)
  model mk_point(a: U8, b: U8) -> Point = Point(a, b)
  model px(p: Point) -> U8 = p.x
  model mk_wrapped(a: U8, b: U8, t: Bool) -> Wrapped = Wrapped(Point(a, b), t)
  model wrapped_y(w: Wrapped) -> U8 = w.p.y
  model mk_slot(o: Option<U8>, a: Bool) -> Slot = Slot(o, (a, 2))
  model slot_t0(s: Slot) -> Bool = s.t.0
  model rec_eq(a: Tri, b: Tri) -> Bool = a == b
  model rec_ne(a: Duo, b: Duo) -> Bool = a != b
  model rec_postfix(a: U8, b: U8) -> U8 = mk_point(a, b).y
  model mk_wide(n: Nat, w: U16) -> Wide = Wide(w, n)
  model wide_w(x: Wide) -> U16 = x.w
  model mk_circle(r: U8) -> Shape = Circle(r)
  model mk_rect(w: U8, h: U8) -> Shape = Rect(w, h)
  model mk_dot(u: Bool) -> Shape = Dot
  model mk_done(n: Nat) -> Msg = Done(n, None)
  model mk_opt_msg(o: Option<U8>) -> Msg = Opt(o)
  model var_eq(a: Dir, b: Dir) -> Bool = a == b
  model var_ne(a: Dir, b: Dir) -> Bool = a != b
  model var_eq_lit(a: Dir) -> Bool = a == Up
  model m_opt(o: Option<U8>) -> U8 = match o with Some(x) -> x | None -> 0u8
  model m_opt_wild_arm(o: Option<U8>) -> Bool = match o with None -> false | _ -> true
  model m_opt_nested(o: Option<Option<Bool>>) -> Nat = match o with Some(Some(x)) -> 2 | Some(None) -> 1 | None -> 0
  model m_opt_tuple(o: Option<(Bool,Nat)>) -> Nat = match o with Some((true, n)) -> n | Some((false, _)) -> 0 | None -> 0
  model m_bool(b: Bool) -> Nat = match b with true -> 1 | false -> 0
  model m_tuple_bool(t: (Bool,Bool)) -> Bool = match t with (true, x) -> x | (false, _) -> false
  model m_point(p: Point) -> U8 = match p with Point(x, y) -> x + y
  model m_wrapped(w: Wrapped) -> U8 = match w with Wrapped(Point(a, _), true) -> a | Wrapped(Point(_, b), false) -> b
  model m_slot(s: Slot) -> Nat = match s with Slot(Some(_), (true, n)) -> n | Slot(Some(_), (false, _)) -> 1 | Slot(None, _) -> 0
  model m_shape(s: Shape) -> U8 = match s with Circle(r) -> r | Rect(w, h) -> w + h | Dot -> 0u8
  model m_mode(o: Mode) -> Nat = match o with Add -> 0 | Sub -> 1 | Neg -> 2
  model m_msg(m: Msg) -> Nat = match m with Short -> 0 | Done(n, _) -> n | Opt(Some(x)) -> to_nat(x) | Opt(None) -> 0
  model m_dir_bind(d: Dir) -> Dir = match d with Up -> Up | other -> other
  model m_res_opt(r: Result<Option<U8>,DataError>) -> Nat = match r with Ok(Some(_)) -> 1 | Ok(None) -> 0 | Err(_) -> 2
  model m_res_rec(r: Result<Point,DataError>) -> U8 = match r with Ok(Point(x, _)) -> x | Err(DataError.Bad) -> 0u8 | Err(_) -> 1u8
  model m_inner(o: Option<U8>, b: Bool) -> Nat = match o with Some(_) -> (match b with true -> 1 | false -> 2) | None -> 0
  model m_tri(data: U8, enable: U8) -> Result<Option<U8>,DataError> = if enable > 1u8 then Err(DataError.Bad) else Ok(if enable == 1u8 then Some(data) else None)
  model m_pick(o: Option<U8>, a: U8) -> Result<Option<U8>,DataError> = if a > 200u8 then Err(DataError.Bad) else Ok(o)
  model m_adder(a: Bytes, b: Bytes) -> Result<Sum,DataError> = if len(a) == len(b) then Ok(Sum(a, if len(a) == 0 then 0u8 else 3u8, len(a) == 1)) else Err(DataError.Bad)
  model m_adder_n(n: U8, a: Bytes) -> Result<Sum,DataError> = if len(a) > 4 then Err(DataError.Bad) else Ok(Sum(a, n, n == 0u8))
  model m_alu(a: Bytes, m: Mode) -> Result<AluOut,DataError> = match m with Add -> Ok(AluOut(a, len(a) == 0, false, false, false)) | Sub -> Ok(AluOut(a, false, false, false, false)) | Neg -> Err(DataError.Worse)
  model m_holder(n: Nat) -> Result<Holder,DataError> = if n > 60 then Err(DataError.Bad) else Ok(Holder(take(b"00ff", n), (take(b"ff", n), n == 3)))
  model m_pr(n: Nat) -> Result<(Bytes,Bool),DataError> = if n > 60 then Err(DataError.Bad) else Ok((take(b"0102", n), n == 3))
  model m_dir_res(a: U8, d: Dir) -> Result<Dir,DataError> = if a > 200u8 then Err(DataError.Bad) else Ok(d)

  -- subject operations, labels, inputs and bounds -------------------------------------------------
  op op_some_u8(a: U8) -> Option<U8>
  op op_none_u8(u: Bool) -> Option<U8>
  op op_some_nested(a: Bool) -> Option<Option<Bool>>
  op op_some_none(u: Bool) -> Option<Option<Bool>>
  op op_opt_if(c: Bool, a: U8) -> Option<U8>
  op op_opt_bytes(d: Bytes) -> Option<Bytes>
  op op_opt_pair(a: Bool, n: Nat) -> Option<(Bool,Nat)>
  op op_opt_widen_nat(a: Nat) -> Option<Nat>
  op op_opt_eq(a: Option<U8>, b: Option<U8>) -> Bool
  op op_opt_ne(a: Option<Bool>, b: Option<Bool>) -> Bool
  op op_opt_is_none(a: Option<U8>) -> Bool
  op op_opt_is_some_lit(a: Option<U8>) -> Bool
  op op_unwrap_binder(o: Option<U8>) -> U8
  op op_unwrap_nested(o: Option<Option<Bool>>) -> Option<Bool>
  op op_inter_add(a: U8, b: U8) -> U8
  op op_prod_eq(a: U8, b: U8) -> Bool
  op op_prod_try(a: Nat) -> Option<U8>
  op op_mk_point(a: U8, b: U8) -> Point
  op op_px(p: Point) -> U8
  op op_mk_wrapped(a: U8, b: U8, t: Bool) -> Wrapped
  op op_wrapped_y(w: Wrapped) -> U8
  op op_mk_slot(o: Option<U8>, a: Bool) -> Slot
  op op_slot_t0(s: Slot) -> Bool
  op op_rec_eq(a: Tri, b: Tri) -> Bool
  op op_rec_ne(a: Duo, b: Duo) -> Bool
  op op_rec_postfix(a: U8, b: U8) -> U8
  op op_mk_wide(n: Nat, w: U16) -> Wide
  op op_wide_w(x: Wide) -> U16
  op op_mk_circle(r: U8) -> Shape
  op op_mk_rect(w: U8, h: U8) -> Shape
  op op_mk_dot(u: Bool) -> Shape
  op op_mk_done(n: Nat) -> Msg
