          "segments": [
            {
              "kind": "speech",
              "text": "liceor, licērī — \"to bid (at an auction)\"."
            },
            {
              "kind": "speech",
              "text": "Hunc equum centum dēnāriīs licitus est. He bid a hundred denarii for this horse."
            },
            {
              "kind": "speech",
              "text": "Deponent: liceor, licērī, licitus sum. The thing bid for goes in the accusative and the price in the ablative. It belongs with licet: to name what you are allowed to pay."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "liceor belongs with liceō \"to be for sale, to be valued\" and licet \"it is allowed\" (EtymDB; Lewis & Short): to put a value on a thing."
            }
          ]
        },
