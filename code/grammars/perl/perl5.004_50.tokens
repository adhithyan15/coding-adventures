# Perl 5.004_50 (1997-09-09) plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: unsupported Perl 5.004_50 syntax is rejected.
# Evidence: https://mirrors.develooper.com/perl/historical-perl/perl-5.004_50.tar.gz
# Archive SHA-256: 458f5850e8b36f9280fcd713210f83472901577e930b41e3f8dfd243a64b9938
# Its comment-stripped scan_num matches 5.004_05, including the 250-digit bound.
# Unsupported characters, carriage returns, and leading-zero forms remain refused.

PRINT     = "print"
INT       = /0|[1-9][0-9]{0,249}/
PLUS      = "+"
DECREMENT = "--"
MINUS     = "-"
STAR      = "*"
LPAREN    = "("
RPAREN    = ")"
SEMICOLON = ";"

skip:
  WHITESPACE = /[ \t\n]+/
