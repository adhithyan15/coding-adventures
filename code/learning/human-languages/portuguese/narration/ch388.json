          "segments": [
            {
              "kind": "speech",
              "text": "a pena — \"the penalty, the sentence served; the pity; the feather\"."
            },
            {
              "kind": "speech",
              "text": "Ele cumpriu uma pena de dois anos. He served a two-year sentence."
            },
            {
              "kind": "speech",
              "text": "Que pena! — what a pity; vale a pena — it is worth it. Uma pena is also a feather."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "pena \"penalty, pity\" is inherited from Latin poena \"penalty, punishment\" (EtymDB, Lewis & Short), from Greek poinḗ \"blood money, fine\"; pena \"feather\" is a separate word, from Latin penna."
            }
          ]
        },
