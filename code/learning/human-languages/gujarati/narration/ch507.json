            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "dādīe caśmā̃ paherīne soymā̃ doro parovyo. — Grandmother put on her glasses and threaded the needle.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *dādīe caśmā̃ paherīne soymā̃ doro parovyo.* — Grandmother put on her glasses and threaded the needle.]"
