              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *ammī*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "say ammī",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: say *ammī*]"
