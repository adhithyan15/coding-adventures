    {
      "id": "ZH-W134-zhong-heavy",
      "sequence": 10565,
      "title": "重 (zhòng) — a fall and a bar over 里",
      "headword": "重",
      "romanization": "zhòng",
      "gloss": "重 — a fall and a bar over 里",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:e5912fc438edf63b",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — a fall and a bar over 里",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — a fall and a bar over 里 and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say zhòng — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *zhòng* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "里 千."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — lǐ, qiān",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *lǐ*, *qiān*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — a fall and a bar over 里",
          "segments": [
            {
              "kind": "speech",
              "text": "重 (zhòng)."
            },
            {
              "kind": "speech",
              "text": "Two pieces, top to bottom."
            },
            {
              "kind": "speech",
              "text": "A short left-falling stroke, from the right down to the left, then a long horizontal across the whole width, as 千 begins."
            },
            {
              "kind": "speech",
              "text": "里, seven strokes, in the order your hand knows: the box (its left side, the top that turns down the right side, the middle bar, the bar that closes it), then the vertical, which here starts above the long bar and runs down through it and the box, then the two bars of the foot, the lower one longer."
            },
            {
              "kind": "speech",
              "text": "2 + 7 = nine."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "重 (zhòng), all nine, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 重, all nine, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What sits under the long bar of 重 (zhòng)? (里.) Where does the vertical start? (Above the long bar.) Which is the last stroke? (The long bar at the foot.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 重 (zhòng), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
