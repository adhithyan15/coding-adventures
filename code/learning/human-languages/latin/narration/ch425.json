          "segments": [
            {
              "kind": "speech",
              "text": "orbita, orbitae — \"a wheel rut, a track\"."
            },
            {
              "kind": "speech",
              "text": "In viā vetere altae orbitae sunt, et plaustrum lentē it. On the old road there are deep ruts, and the wagon goes slowly."
            },
            {
              "kind": "speech",
              "text": "First declension, feminine: orbita, orbitae f. English orbit is the same word: the track a planet runs in."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "orbita is built on orbis 'circle, wheel' (EtymDB; Lewis & Short): the track a wheel leaves. English orbit comes from it."
            }
          ]
        },
