          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "先 (xiān) is inherited from Middle Chinese sen (Guangyun, in Baxter's transcription), glossed 'before and after'."
            }
