              "action": "SAY",
              "instruction": "kōḻi",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *kōḻi*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "it once more, slowly",
              "spoken": true,
              "scored": false,
