          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "சூழ்நிலை (cūḻnilai) is native: cūḻ, \"to surround, encompass\" (DEDR 2698), and nilai, \"a standing, a state\" (DEDR 3675): the state of what surrounds us."
            }
          ]
        },
