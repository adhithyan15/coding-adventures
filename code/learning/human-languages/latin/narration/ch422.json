          "segments": [
            {
              "kind": "speech",
              "text": "abundō, abundāre — \"to have plenty (of), to abound; to overflow\"."
            },
            {
              "kind": "speech",
              "text": "Urbs frūmentō abundat. The city has plenty of grain."
            },
            {
              "kind": "speech",
              "text": "abundō, abundāre, abundāvī, abundātum + ablative, built on unda, a wave: to overflow. English abound and abundant."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "abundō is built from ab \"away, over\" and undō \"to surge\", from unda \"a wave\" (EtymDB; Lewis & Short): to flow over. English abound and abundant come from it."
            }
          ]
        },
