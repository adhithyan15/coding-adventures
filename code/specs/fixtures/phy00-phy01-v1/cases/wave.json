    {
      "id": "phy01/period/four-hertz",
      "operation": "period",
      "summary": "A four hertz wave has a quarter-second period.",
      "input": {
        "wave": {
          "amplitude": {"kind": "finite", "decimal": "1"},
          "frequency": {"kind": "finite", "decimal": "4"},
          "phase": {"kind": "finite", "decimal": "0"}
        }
      },
      "expected": {
        "outcome": "value",
        "value": {"kind": "finite", "decimal": "0.25"},
        "comparison": {"kind": "absolute", "tolerance": "1e-10"}
      }
    },
    {
      "id": "phy01/period/minimum-subnormal-frequency",
      "operation": "period",
      "summary": "The reciprocal of the minimum positive subnormal frequency rounds to positive infinity.",
      "input": {
        "wave": {
          "amplitude": {"kind": "finite", "decimal": "1"},
          "frequency": {"kind": "finite", "decimal": "4.9406564584124654e-324"},
          "phase": {"kind": "finite", "decimal": "0"}
        }
      },
      "expected": {
        "outcome": "value",
        "value": {"kind": "positive-infinity"},
        "comparison": {"kind": "exact"}
      }
    },
    {
      "id": "phy01/angular-frequency/ten-hertz",
      "operation": "angular-frequency",
      "summary": "Angular frequency is two pi times frequency.",
      "input": {
        "wave": {
          "amplitude": {"kind": "finite", "decimal": "1"},
          "frequency": {"kind": "finite", "decimal": "10"},
          "phase": {"kind": "finite", "decimal": "0"}
