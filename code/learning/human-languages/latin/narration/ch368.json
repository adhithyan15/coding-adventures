        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ōrātor, ōrātōris",
          "segments": [
            {
              "kind": "speech",
              "text": "ōrātor, ōrātōris — \"a speaker, an orator; an envoy\"."
            },
            {
              "kind": "speech",
              "text": "Ōrātor ā populō laudātus est. The speaker was praised by the people."
            },
            {
              "kind": "speech",
              "text": "ōrātor, ōrātōris m. Built on ōrō, to speak, to plead. An envoy who speaks for his city is also an ōrātor. English orator."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ōrātor is built on ōrō \"to speak, to plead\" (Lewis & Short), with the ending -tor of the one who does it. English orator comes from it."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
