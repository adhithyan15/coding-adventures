{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coding-adventures.dev/schemas/elixir-windows-build-front-v1.json",
  "title": "Elixir Windows BUILD-front contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workflow",
    "unsupported_protocol",
    "exceptions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pr_windows_runner",
        "setup_action",
        "elixir_version",
        "otp_version",
        "version_type",
        "setup_condition",
        "affected_build_condition"
      ],
      "properties": {
        "pr_windows_runner": {
          "const": "windows-2025"
        },
        "setup_action": {
          "type": "string",
          "pattern": "^erlef/setup-beam@[0-9a-f]{40}$"
        },
        "elixir_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "otp_version": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$"
        },
        "version_type": {
          "const": "strict"
        },
        "setup_condition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "affected_build_condition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "unsupported_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directive_prefix", "command_prefix", "command_suffix"],
      "properties": {
        "directive_prefix": {
          "const": "# build-tool: unsupported="
        },
        "command_prefix": {
          "const": "echo BUILD_TOOL_UNSUPPORTED:"
        },
        "command_suffix": {
          "const": " -- skipped"
        }
      }
    },
    "exceptions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["root", "code", "class"],
        "properties": {
          "root": {
            "type": "string",
            "pattern": "^code/(?:packages|programs)/elixir/[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
          },
          "class": {
            "enum": [
              "nif-erts-import-library",
              "target-specific-metal"
            ]
          }
        }
      },
      "uniqueItems": true
    }
  }
}
