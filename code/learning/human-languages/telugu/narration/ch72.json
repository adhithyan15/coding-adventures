              "action": "SAY",
              "instruction": "ḍabbu",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *ḍabbu*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "it once more, slowly",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: it once more, slowly]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "ḍabbu, then lēdu, as the phrase you already knew",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *ḍabbu*, then *lēdu*, as the phrase you already knew]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "read కప్ప, then say atta",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: read **కప్ప**, then say *atta*]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
