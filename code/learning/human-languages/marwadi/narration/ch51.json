          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: पीणो",
          "segments": [
            {
              "kind": "speech",
              "text": "पीणो — pīṇo — \"to drink\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "पीणो (pīṇo) is a tadbhava, a word inherited from Sanskrit and reshaped by sound change. It comes from pibati, \"drinks\". CDIAL gives no Marwari form in this entry (CDIAL 8209); the match is through Hindi pīnā and Gujarati pīvũ. It is built on the root pā, \"to drink\", as pāṇī is."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
