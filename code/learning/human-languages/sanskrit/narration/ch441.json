          "segments": [
            {
              "kind": "speech",
              "text": "दुर्दिनम् (durdinam) is built from dur, \"bad, ill\", and dina, \"a day\"; MW gives the compound as a rainy or cloudy day, bad weather (MW)."
            }
          ]
