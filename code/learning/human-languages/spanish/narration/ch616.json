            {
              "kind": "speech",
              "text": "Before the new one: say the Spanish for the intention, then the Spanish for to set out to."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: el imprevisto",
          "segments": [
            {
              "kind": "speech",
              "text": "el imprevisto — \"the unexpected problem; unforeseen\"."
            },
            {
              "kind": "speech",
              "text": "Tuve un imprevisto y llegué tarde. Something came up and I arrived late."
            },
            {
              "kind": "speech",
              "text": "Tener un imprevisto — something unexpected comes up."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "imprevisto is built on previsto, the participle of prever, a learned borrowing from Latin praevidere 'to foresee', with in- 'not' (EtymDB)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
