        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: la caparra",
          "segments": [
            {
              "kind": "speech",
              "text": "la caparra — \"the deposit\"."
            },
            {
              "kind": "speech",
              "text": "Per la camera chiedono una caparra del trenta per cento. For the room they ask for a thirty per cent deposit."
            },
            {
              "kind": "speech",
              "text": "If you cancel, you may lose la caparra."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "caparra is built from capo 'head, chief', inherited from Latin caput, and arra 'pledge', from Latin arrha, which came into Latin from Greek (Lewis & Short)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
            }
