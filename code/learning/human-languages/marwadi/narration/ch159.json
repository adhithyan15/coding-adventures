      "title": "घरै (gharai) — at home",
      "headword": "घरै",
      "romanization": "gharai",
      "gloss": "at home; home, as the place you go to",
      "script": "devanagari",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:26a6861ae16f2b55",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Say here, there and on top: अठै, बठै, माथै. Then a house: घर."
            }
          ]
        },
        {
          "index": 1,
          "type": "grammar",
          "title": "Grammar Lens: घर with -ै",
          "segments": [
            {
              "kind": "speech",
              "text": "घर with the -ै of अठै, बठै and माथै is घरै (gharai): at home, or home as the place you go to."
            },
            {
              "kind": "speech",
              "text": "हूं घरै हूं। hū̃ gharai hū̃. — I am at home."
            },
            {
              "kind": "speech",
              "text": "वो रोज आथण घरै आवै है। vo roj āthaṇ gharai āvai hai. — He comes home every evening."
            },
            {
              "kind": "speech",
              "text": "Old Marwari shows a place ending like it: āgai, \"before\", beside āgo, \"front\" (CDIAL 68)."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "मां घरै है। — mā̃ gharai hai. — Mother is at home.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: **मां घरै है।** — *mā̃ gharai hai.* — Mother is at home.]"
            },
