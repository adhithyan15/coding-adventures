              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *purāve*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "purāve, once more",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *purāve*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "avana mātige yāvudē purāve iralilla. — There was no proof for what he said.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *avana mātige yāvudē purāve iralilla.* — There was no proof for what he said.]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
