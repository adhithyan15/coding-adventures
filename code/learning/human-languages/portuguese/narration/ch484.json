        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: a enxaqueca",
          "segments": [
            {
              "kind": "speech",
              "text": "a enxaqueca — \"migraine\"."
            },
            {
              "kind": "speech",
              "text": "Quando tenho enxaqueca, fico às escuras no quarto. When I have a migraine, I stay in my room in the dark."
            },
            {
              "kind": "speech",
              "text": "Stronger than uma dor de cabeça."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "enxaqueca is usually traced to Arabic aš-šaqīqa, a word for a headache on one side of the head."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
