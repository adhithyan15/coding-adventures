        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: சோகம்",
          "segments": [
            {
              "kind": "speech",
              "text": "சோகம் (cōkam) — \"sadness, grief\"."
            },
            {
              "kind": "speech",
              "text": "சோகமாக இருக்கிறேன் — \"I am sad\". The -ஆக ending turns a feeling into how you are."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "சோகம் (cōkam) is a loan from Sanskrit śoka, \"heat, pain, sorrow\" (CDIAL 12619)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "The first feeling."
            }
          ]
        },
