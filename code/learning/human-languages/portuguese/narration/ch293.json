          "title": "You'll want to know: o agente",
          "segments": [
            {
              "kind": "speech",
              "text": "o agente — \"the officer, the agent\"."
            },
            {
              "kind": "speech",
              "text": "Um agente da polícia ajudou-nos. A police officer helped us."
            },
            {
              "kind": "speech",
              "text": "The polite way to address a police officer: Sim, senhor agente."
            }
          ]
