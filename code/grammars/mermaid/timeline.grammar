# @version 1
# Mermaid 11.16.1 timeline core parser grammar.

document = { terminator } header { terminator | statement } EOF ;
header = HEADER | HEADER_LR | HEADER_TD ;
terminator = NEWLINE | SEMICOLON ;
statement = ACC_TITLE_STATEMENT | ACC_DESCR_STATEMENT | ACC_DESCR_BLOCK | TITLE_STATEMENT | SECTION_STATEMENT | EVENT_STATEMENT | PERIOD_STATEMENT ;
