            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Malayalam for an aeroplane, then the Malayalam for an auto."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: പക്ഷി",
          "segments": [
            {
              "kind": "speech",
              "text": "പക്ഷി (pakṣi) — \"a bird\". A കാക്ക is one."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "പക്ഷി (pakṣi) from Sanskrit pakṣin, \"winged; bird\", taken over whole as a tatsama (CDIAL 7636). It is built on pakṣa, \"wing\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "The general word for anything with wings."
            }
          ]
        },
        {
          "index": 4,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
