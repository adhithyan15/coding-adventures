              "feedback": {
                "correct": "Describing word last.",
                "incorrect": "Una casa grande."
              }
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Ser or estar for tired? (Estar.) Where does the describing word go? (After the noun.) And what tells you whether it shifts? (Its last letter.)"
            }
          ]
