          "index": 1,
          "type": "input",
          "title": "You'll want to know: la naissance",
          "segments": [
            {
              "kind": "speech",
              "text": "la naissance — \"the birth\"."
            },
            {
              "kind": "speech",
              "text": "Nous avons fêté la naissance de notre fille. We celebrated the birth of our daughter."
            },
            {
              "kind": "speech",
              "text": "La date de naissance — date of birth; de naissance — from birth."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "naissance is built on the stem of naître \"to be born\", which is inherited from Vulgar Latin nāscere, from Latin nāscī \"to be born\" (Lewis & Short)."
            }
          ]
        },
