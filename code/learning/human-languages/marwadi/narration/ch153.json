  "lessons": [
    {
      "id": "MW-C153-hu-hai",
      "sequence": 9530,
      "title": "हूं and है — am and is",
      "headword": "हूं · है",
      "romanization": "hū̃ · hai",
      "gloss": "am and is: two forms of to be you have said from the start",
      "script": "devanagari",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:891b3c98f3eb6f4d",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Say I am fine, then he is ill. You have said am and is since the greeting; now they get a name."
            }
          ]
        },
        {
          "index": 1,
          "type": "grammar",
          "title": "Grammar Lens: हूं … हूं",
          "segments": [
            {
              "kind": "speech",
              "text": "In हूं ठीक हूं। the first हूं is I and the last one is am: the same word, at both ends."
            },
            {
              "kind": "speech",
              "text": "हूं अठै हूं। hū̃ aṭhai hū̃. — I am here."
            }
          ]
        },
        {
          "index": 2,
          "type": "grammar",
          "title": "Grammar Lens: है",
          "segments": [
            {
              "kind": "speech",
              "text": "Anyone or anything you talk about takes है, is: वो, राम, the tea."
            },
            {
              "kind": "speech",
              "text": "राम बठै है। rām baṭhai hai. — Ram is there."
            },
            {
              "kind": "speech",
              "text": "चाय गरम है। chāy garam hai. — The tea is hot."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "हूं अठै हूं पण राम बठै है। — hū̃ aṭhai hū̃ paṇ rām baṭhai hai. — I am here, but Ram is there.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: **हूं अठै हूं पण राम बठै है।** — *hū̃ aṭhai hū̃ paṇ rām baṭhai hai.* — I am here, but Ram is there.]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "हूं राजी हूं क्यूंकै चाय गरम है। — hū̃ rājī hū̃ kyū̃kai chāy garam hai. — I am happy because the tea is hot.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: **हूं राजी हूं क्यूंकै चाय गरम है।** — *hū̃ rājī hū̃ kyū̃kai chāy garam hai.* — I am happy because the tea is hot.]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "वो उदास है। — vo udās hai. — He is sad.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: **वो उदास है।** — *vo udās hai.* — He is sad.]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "I am ends on? (हूं.) He is? (है.)"
            },
            {
              "kind": "activity",
              "scored": true,
              "spoken": true,
              "id": "MW-C153-hu-hai-here-there",
              "prompt": "Say that you are here, but Ram is there.",
              "assesses": [
                "MW-GRAMMAR-C153-BE-HU-01",
                "MW-GRAMMAR-C153-BE-HAI-01"
              ],
              "responseSeconds": 20,
              "acceptedResponses": [
                "हूं अठै हूं पण राम बठै है।",
                "hū̃ aṭhai hū̃ paṇ rām baṭhai hai",
                "hu athai hu pan ram bathai hai"
              ],
              "feedback": {
                "correct": "Right: हूं for you, है for Ram.",
                "incorrect": "End your half on हूं and Ram's half on है."
              }
            }
          ]
        }
      ]
    },
    {
      "id": "MW-C153-aap-ho",
      "sequence": 9540,
      "title": "आप … हो (āp … ho) — you are",
      "headword": "आप … हो",
      "romanization": "āp … ho",
      "gloss": "you are: हो after the polite आप",
      "script": "devanagari",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:b6a1796ea27f08a0",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Ask the polite question: आप कैसो हो? Then say I am here and Ram is there."
            }
          ]
        },
        {
          "index": 1,
          "type": "grammar",
          "title": "Grammar Lens: हो after आप",
          "segments": [
            {
              "kind": "speech",
              "text": "आप कैसो हो? ends on हो. After आप, are is हो:"
            },
            {
              "kind": "speech",
              "text": "आप अठै हो। āp aṭhai ho. — You are here."
            },
            {
              "kind": "speech",
              "text": "हो answers to आप the way हूं answers to हूं, and है to वो."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "आप बठै हो पण हूं अठै हूं। — āp baṭhai ho paṇ hū̃ aṭhai hū̃. — You are there, but I am here.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: **आप बठै हो पण हूं अठै हूं।** — *āp baṭhai ho paṇ hū̃ aṭhai hū̃.* — You are there, but I am here.]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "आप राजी हो। — āp rājī ho. — You are happy.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: **आप राजी हो।** — *āp rājī ho.* — You are happy.]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "चाय अर पाणी? — chāy ar pāṇī? — Tea or water?",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: **चाय अर पाणी?** — *chāy ar pāṇī?* — Tea or water?]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "पाणी। — pāṇī. — Water.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: **पाणी।** — *pāṇī.* — Water.]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Which are goes with आप? (हो.) And with वो? (है.)"
            },
            {
              "kind": "activity",
              "scored": true,
              "spoken": true,
              "id": "MW-C153-aap-ho-here",
              "prompt": "Say politely: you are here.",
              "assesses": [
                "MW-GRAMMAR-C153-BE-HO-01"
              ],
              "responseSeconds": 12,
              "acceptedResponses": [
                "आप अठै हो।",
                "āp aṭhai ho",
                "aap athai ho"
              ],
              "feedback": {
                "correct": "Right: आप, and हो at the end.",
                "incorrect": "After आप the sentence ends on हो: आप अठै हो."
              }
            }
          ]
        }
      ]
    },
    {
