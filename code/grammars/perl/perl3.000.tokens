# Perl 3.000 (1989-10-18) tokens: verified arithmetic-print subset only.
# @version 1
# PARTIAL: this does not lex all Perl 3.000 source.
# Evidence: https://github.com/Perl/perl5/blob/perl-3.000/perl.y
# Evidence: https://github.com/Perl/perl5/blob/perl-3.000/toke.c
# The tagged tokenizer recognizes `print` as a list operator. This pair
# admits that spelling only, and leaves all other list operators unsupported.

# Leading-zero multi-digit forms are octal and outside this partial subset.
PRINT     = "print"
INT       = /0|[1-9][0-9]*/
PLUS      = "+"
DECREMENT = "--"
MINUS     = "-"
STAR      = "*"
LPAREN    = "("
RPAREN    = ")"
SEMICOLON = ";"

skip:
  WHITESPACE = /[ \t\r\n]+/
