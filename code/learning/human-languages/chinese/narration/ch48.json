    {
      "id": "ZH-W48-dian",
      "sequence": 3885,
      "title": "点 (diǎn) — a mark on 口, over four dots",
      "headword": "点",
      "romanization": "diǎn",
      "gloss": "点 — a small mark on 口, over four dots",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:52258cd25ae2f7c8",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — a mark on 口, over four dots",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — a mark on 口, over four dots and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say diǎn — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *diǎn* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "口 明."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — kǒu, míng",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *kǒu*, *míng*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — a mark on 口, over four dots",
          "segments": [
            {
              "kind": "speech",
              "text": "点 (diǎn)."
            },
            {
              "kind": "speech",
              "text": "Three pieces, top to bottom."
            },
            {
              "kind": "speech",
              "text": "Two strokes on top. A short vertical, then a short horizontal from its middle out to the right."
            },
            {
              "kind": "speech",
              "text": "口, three strokes, wide, under them."
            },
            {
              "kind": "speech",
              "text": "Four dots along the bottom, left to right; the first leans left, the other three lean right."
            },
            {
              "kind": "speech",
              "text": "2 + 3 + 4 = nine."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "点 (diǎn), all nine, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 点, all nine, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many pieces in 点 (diǎn)? (Three.) Which character you know is in the middle? (口.) How many dots at the bottom? (Four.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 点 (diǎn), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
