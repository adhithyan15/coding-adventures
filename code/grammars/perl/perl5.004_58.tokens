# Perl 5.004_58 (1998-02-06) plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: unsupported Perl 5.004_58 syntax is rejected.
# Evidence: https://mirrors.develooper.com/perl/historical-perl/perl-5.004_58.tar.gz
# Archive SHA-256: 3aea97f0fcd26b867512710d93625f9810dbb6c31c579035d24198fef1bdb977
# Its scan_num section matches 5.004_57 byte for byte, retaining the 250-digit bound.
# Lexical-state, regex, method, filter, brace, and heredoc changes do not widen this subset.
# CR remains outside this partial accepted subset, without platform-wide parity claim.
# Unsupported characters and leading-zero forms remain refused.

PRINT     = "print"
INT       = /0|[1-9][0-9]{0,249}/
PLUS      = "+"
DECREMENT = "--"
MINUS     = "-"
STAR      = "*"
LPAREN    = "("
RPAREN    = ")"
SEMICOLON = ";"

skip:
  WHITESPACE = /[ \t\n]+/
