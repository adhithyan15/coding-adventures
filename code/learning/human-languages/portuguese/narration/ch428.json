        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: o alojamento",
          "segments": [
            {
              "kind": "speech",
              "text": "o alojamento — \"the accommodation, the lodging\"."
            },
            {
              "kind": "speech",
              "text": "O alojamento perto da praia é caro. Accommodation near the beach is expensive."
            },
            {
              "kind": "speech",
              "text": "O alojamento local — short holiday lets in Portugal."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "alojamento is built on alojar 'to lodge', usually traced to French loger, on loge 'hut, shelter', which EtymDB traces to Frankish laubija 'shelter, roof'."
            }
          ]
        },
        {
