# Perl 5.004_60 (1998-02-20) plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: unsupported Perl 5.004_60 syntax is rejected.
# Evidence: https://mirrors.develooper.com/perl/historical-perl/perl-5.004_60.tar.gz
# Archive SHA-256: 912091e555a293955797efc07709116860850655bbe294f137f5cb99e5d372ca
# Its perly.y and toke.c match 5.004_59 byte for byte, retaining the 250-digit bound.
# CR remains outside this partial accepted subset, without platform-wide parity claim.
# Unsupported characters and leading-zero forms remain refused.

PRINT     = "print"
INT       = /0|[1-9][0-9]{0,249}/
PLUS      = "+"
DECREMENT = "--"
MINUS     = "-"
STAR      = "*"
LPAREN    = "("
RPAREN    = ")"
SEMICOLON = ";"

skip:
  WHITESPACE = /[ \t\n]+/
