      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: what did paṇḍu mean?"
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: బట్ట",
          "segments": [
            {
              "kind": "speech",
              "text": "బట్ట (baṭṭa) — \"cloth\"."
            },
            {
              "kind": "speech",
              "text": "బట్ట (baṭṭa) is the plain word for cloth: the bolt on the shelf, the washing on the line, the rag in your hand."
            },
            {
              "kind": "speech",
              "text": "Sanskrit has paṭṭa, \"a strip of cloth, a bandage\", and here the borrowing may have run the unusual way — into Sanskrit from a non-Aryan source, rather than the other direction this book has shown so often. The same strip reached English by a different road: Hindi paṭṭī, a wrapping, is the soldier's puttee."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "The origin of బట్ట (baṭṭa) is uncertain, and DEDR does not list it. It is often set beside Sanskrit paṭṭa, \"cloth, woven silk\", which CDIAL 7700 itself takes from a non-Aryan source, without naming which."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "Two: a fruit and a cloth."
            }
          ]
        },
        {
          "index": 4,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
