    {
      "id": "ES-C342-madrugada",
      "sequence": 6060,
      "title": "la madrugada — the small hours, named for ripeness",
      "headword": "la madrugada",
      "romanization": "la madrugada",
      "gloss": "the small hours, daybreak — Latin maturus, ripe or early, through madurgar; English mature and premature are the same ripeness",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:ae849ecaa3e1c43c",
      "notice": null,
      "blocks": [
        {
          "index": 0,
