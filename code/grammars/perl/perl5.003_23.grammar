# Perl 5.003_23 (1997-01-25) grammar: plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: unsupported Perl 5.003_23 syntax is rejected.
# Evidence: https://github.com/Perl/perl5/blob/perl-5.003_23/perly.y
# Tagged yacc changes format-subroutine setup outside this separate file's
# arithmetic precedence, parentheses and print subset.

program         = print_statement { print_statement } ;
print_statement = PRINT LPAREN expr RPAREN SEMICOLON ;
expr            = term { ( PLUS | MINUS ) term } ;
term            = unary { STAR unary } ;
unary           = MINUS unary | atom ;
atom            = INT | LPAREN expr RPAREN ;
