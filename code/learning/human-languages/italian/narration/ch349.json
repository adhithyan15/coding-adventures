        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: l'effetto",
          "segments": [
            {
              "kind": "speech",
              "text": "l'effetto — \"the effect\"."
            },
            {
              "kind": "speech",
              "text": "La medicina ha fatto effetto dopo dieci minuti. The medicine took effect after ten minutes."
            },
            {
              "kind": "speech",
              "text": "Fare effetto — to take effect. In effetti — in fact, indeed."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "effetto comes from Latin effectus \"an effect, a result, a purpose\" (EtymDB), from efficere \"to bring about\", built from ex \"out\" and facere \"to do, to make\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
