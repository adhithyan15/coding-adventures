# @version 1
# Mermaid 11.16.1 Wardley core grammar.
case_sensitive: false
skip:
  COMMENT = /[ \t]*%%[^\r\n]*/
NEWLINE = /\r?\n/
HEADER = /wardley-beta/
ACCELERATOR_LINE = /[ \t]*accelerator[ \t]+[^\r\n]*/
DEACCELERATOR_LINE = /[ \t]*deaccelerator[ \t]+[^\r\n]*/
STATEMENT_LINE = /[ \t]*[^\r\n%][^\r\n]*/
