          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: say the German for recently, then the German for the day before yesterday."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: inzwischen",
          "segments": [
            {
              "kind": "speech",
              "text": "inzwischen — \"meanwhile; by now\"."
            },
            {
              "kind": "speech",
              "text": "Ich habe gekocht, und inzwischen hat er die Teller geholt. I cooked, and meanwhile he fetched the plates."
            },
            {
              "kind": "speech",
              "text": "Also 'by now': Inzwischen ist sie zehn Jahre alt."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "inzwischen joins in and zwischen \"between\". Zwischen comes from Old High German in zuiskēn \"between the two\", built on zuiski \"twofold\" and so on the word for \"two\" (EtymDB)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
            }
          ]
        },
