              "action": "SAY",
              "instruction": "samayaṁ",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *samayaṁ*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "samayaṁ, once more",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *samayaṁ*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "ask samayaṁ etra?",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: ask *samayaṁ etra?*]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say the Malayalam for a tiger, then the Malayalam for a rabbit, then say samayaṁ again",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say the Malayalam for a tiger, then the Malayalam for a rabbit, then say *samayaṁ* again]"
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What does സമയം (samayaṁ) mean? (\"Time\".) Say it once more."
            }
          ]
        }
      ]
