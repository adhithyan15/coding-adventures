    {
      "id": "ZH-W319-xin-letter",
      "sequence": 25065,
      "title": "信 (xìn) — the person piece, then a dot, three bars and 口",
      "headword": "信",
      "romanization": "xìn",
      "gloss": "信 — the person piece, then a dot, three bars and 口",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:bb6909e954648de0",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — the person piece, then a dot, three bars and 口",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — the person piece, then a dot, three bars and 口 and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say xìnxīn — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *xìnxīn* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "你 说."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — nǐ, shuō",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *nǐ*, *shuō*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — the person piece, then a dot, three bars and 口",
          "segments": [
            {
              "kind": "speech",
              "text": "信 (xìn)."
            },
            {
              "kind": "speech",
              "text": "Two pieces, left before right. Count the pieces, not the strokes."
            },
            {
              "kind": "speech",
              "text": "The left piece, 亻, two strokes. A stroke falling to the left, then a vertical down to the foot, as in 你."
            },
            {
              "kind": "speech",
              "text": "The right piece, seven strokes, top to bottom. A dot. Three bars, the top one the longest. Then 口 at the foot: a short vertical, a bar that runs right and turns down, and the bar that closes it."
            },
            {
              "kind": "speech",
              "text": "2 + 7 = nine."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "信 (xìn), all nine, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 信, all nine, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many strokes in 信 (xìn)? (Nine.) What is the left piece? (亻, the person piece.) What closes the right piece at the foot? (口.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 信 (xìn), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
