          "segments": [
            {
              "kind": "speech",
              "text": "die Einschulung — \"starting school, the first day at school\"."
            },
            {
              "kind": "speech",
              "text": "Zur Einschulung bekam sie eine große Schultüte. For her first day at school she got a big school cone."
            },
            {
              "kind": "speech",
              "text": "A family occasion: the child gets a Schultüte, a big paper cone full of sweets."
            }
          ]
        },
