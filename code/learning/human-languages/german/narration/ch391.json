            },
            {
              "kind": "speech",
              "text": "Before the new one: say the German for the fortune, then the German for the payment."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: die Steuer",
          "segments": [
            {
              "kind": "speech",
              "text": "die Steuer — \"the tax\"."
            },
            {
              "kind": "speech",
              "text": "Auf Zigaretten zahlt man hohe Steuern. You pay high taxes on cigarettes."
            },
            {
              "kind": "speech",
              "text": "Plural: die Steuern. Careful: das Steuer is the steering wheel."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Steuer \"tax\" is usually traced to Old High German stiura \"a prop, a support\", and so a contribution; EtymDB lists English steer as a cousin of the word."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
