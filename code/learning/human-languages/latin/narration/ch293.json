        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: paulātim",
          "segments": [
            {
              "kind": "speech",
              "text": "paulātim — \"little by little\"."
            },
            {
              "kind": "speech",
              "text": "Paulātim aqua in fossā crēscēbat. Little by little the water in the ditch was rising."
            },
            {
              "kind": "speech",
              "text": "Built on paulum, 'a little'. Caesar writes of people who paulātim get used to something."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "paulātim is built on paulum, \"a little\" (Lewis & Short), with the adverb ending -ātim that is also seen in gradātim: one little bit after another."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
