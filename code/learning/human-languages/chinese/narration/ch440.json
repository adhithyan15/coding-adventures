          "type": "input",
          "title": "You'll want to know: gǎnjí",
          "segments": [
            {
              "kind": "speech",
              "text": "gǎnjí — \"to go to market day; to go to a country market\"."
            },
            {
              "kind": "speech",
              "text": "nǎinai měi ge xīngqī qù gǎnjí — Grandma goes to market day every week."
            },
            {
              "kind": "speech",
              "text": "Its characters come later; for now it is a word for the ear."
            }
          ]
        },
