          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "successivamente is built on successivo \"following\", a learned word usually traced to Late Latin successīvus, from succēdere \"to come after\" (Lewis & Short)."
            }
          ]
        },
