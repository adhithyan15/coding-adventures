      "id": "ZH-W221-xue-snow",
      "sequence": 17155,
      "title": "雪 (xuě) — 雨 on top, three bars below",
      "headword": "雪",
      "romanization": "xuě",
      "gloss": "雪 — 雨 pressed flat, over three bars joined on the right",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:c78099cfbdf55ce1",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — 雨 on top, three bars below",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — 雨 on top, three bars below and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say xuěrén — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *xuěrén* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "雨 白."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — yǔ, bái",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *yǔ*, *bái*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — 雨 on top, three bars below",
          "segments": [
            {
              "kind": "speech",
              "text": "雪 (xuě)."
            },
            {
              "kind": "speech",
              "text": "Two pieces, top before bottom. Count the pieces, not the strokes."
            },
            {
              "kind": "speech",
              "text": "On top, 雨, eight strokes, pressed flat: a short bar; a short stroke down on the left; a bar that runs right and turns down with a hook; a vertical through the middle; then four dots, two on the left and two on the right."
            },
            {
              "kind": "speech",
              "text": "Under it, three strokes. A bar that runs right and turns down, a bar across the middle, and a bar along the foot, all three meeting the stroke on the right."
            },
            {
              "kind": "speech",
              "text": "8 + 3 = eleven."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "雪 (xuě), all eleven, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 雪, all eleven, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many strokes in 雪 (xuě)? (Eleven.) What is on top? (雨, pressed flat.) How many bars at the foot? (Three.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 雪 (xuě), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
