          "segments": [
            {
              "kind": "speech",
              "text": "विजयः (vijayaḥ) is built from vi and the root √ji, \"to conquer, win\", as in jayati; MW gives vijaya as a contest for victory, victory, conquest (MW)."
            }
          ]
        },
