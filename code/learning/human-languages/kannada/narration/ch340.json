        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ದಂತಕಥೆ",
          "segments": [
            {
              "kind": "speech",
              "text": "ದಂತಕಥೆ — dantakathe — \"a legend\"."
            },
            {
              "kind": "speech",
              "text": "ಈ ಕೋಟೆಯ ಬಗ್ಗೆ ಒಂದು ದಂತಕಥೆ ಇದೆ. ī kōṭeya bagge ondu dantakathe ide. There is a legend about this fort."
            },
            {
              "kind": "speech",
              "text": "Plural: ದಂತಕಥೆಗಳು, dantakathegaḷu."
            },
            {
              "kind": "speech",
              "text": "A story told from one generation to the next, partly history and partly not."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ದಂತಕಥೆ (dantakathe) is a Kannada compound whose second part is ಕಥೆ, \"a story\", from Sanskrit kathā (CDIAL 2704); the origin of the first part is not settled."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling what happened."
            }
          ]
        },
