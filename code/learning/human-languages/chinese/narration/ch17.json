          "type": "script",
          "title": "Script — the shape",
          "segments": [
            {
              "kind": "speech",
              "text": "Write 文 (wén) in four separate strokes: top dot, horizontal bar, long fall left, long fall right. The last two strokes begin near the centre and open in opposite directions. Four strokes; three lifts."
            }
