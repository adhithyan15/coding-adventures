              }
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What word for will does Gujarati use? (None; the future is an ending.) Which ending did મળીશું teach you long ago? (-ીશું, we will.)"
            }
          ]
        }
      ]
