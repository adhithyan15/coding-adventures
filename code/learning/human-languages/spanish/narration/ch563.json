        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: la fábula",
          "segments": [
            {
              "kind": "speech",
              "text": "la fábula — \"the fable\"."
            },
            {
              "kind": "speech",
              "text": "En la fábula, la tortuga le gana a la liebre. In the fable, the tortoise beats the hare."
            },
            {
              "kind": "speech",
              "text": "La moraleja is the moral at the end."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "fábula is a learned borrowing from Latin fābula 'a story, a tale' (EtymDB), built on fārī 'to speak' (Lewis & Short). The inherited form of the same word is habla."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
