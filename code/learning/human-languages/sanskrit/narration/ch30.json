    {
      "id": "SA-R30-second-pass-from-the-door-to-the-promise",
      "sequence": 1475,
      "title": "स्वागतम् (svāgatam) — the door, the seat, and the promise at the end",
      "headword": "स्वागतम्",
      "romanization": "svāgatam",
      "gloss": "second pass over a whole visit — the welcome owed to a guest, the verb that carries the person, and the ending that turns seeing into a purpose",
      "script": "devanagari",
      "modality": "sight",
      "derivedModality": "sight",
      "modalityReasons": [
        "script-block"
      ],
      "sourceHash": "fnv1a64:2114d09b507c1786",
      "notice": {
        "modality": "sight",
        "needs": [
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Script: one letter, read cold"
        ],
        "text": "Before we start: you can do this one in the car, but part of it needs your eyes. For that part you will want your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach it, but leave this section until you have stopped: Script: one letter, read cold."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "The word you say to someone standing at your door. Then the one syllable that agrees to whatever they ask next."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "The exchange",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "speech",
              "text": "A whole visit, in the order it happens. The nouns around it — the door, the seat, the flower, the garland, the cupped hands — are this chapter's. Everything you say is older."
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "welcome them in — svāgatam",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: welcome them in — *svāgatam*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "ask how they are, respectfully — bhavān kathaṁ asti?",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: ask how they are, respectfully — *bhavān kathaṁ asti?*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "answer for yourself, with no pronoun — kuśalī asmi",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: answer for yourself, with no pronoun — *kuśalī asmi*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "agree to something — ām",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: agree to something — *ām*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "say when — śvaḥ",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
