        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ausrutschen",
          "segments": [
            {
              "kind": "speech",
              "text": "ausrutschen — \"to slip\"."
            },
            {
              "kind": "speech",
              "text": "Sie rutschte auf dem nassen Boden aus. She slipped on the wet floor."
            },
            {
              "kind": "speech",
              "text": "Separable, Perfekt with sein: Ich bin ausgerutscht."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ausrutschen joins aus and rutschen \"to slide\", which is usually traced to Middle High German rutschen; EtymDB lists no parent."
            }
          ]
        },
        {
