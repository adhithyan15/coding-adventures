        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:f7e181454a0cc2ec",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Marathi for a fine thread, then the Marathi for a ladder."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ठिकाण",
          "segments": [
            {
              "kind": "speech",
              "text": "ठिकाण — ṭhikāṇ — \"a place, a spot\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ठिकाण (ṭhikāṇ) is a tadbhava, a word inherited and reshaped by sound change. It comes from ṭhīkka, \"firm, right\", a form CDIAL reconstructs from its descendants (CDIAL 5503). CDIAL lists the Marathi word here only as a possibility; it derives the reconstruction, probably, from Sanskrit sthita, \"standing\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for this chapter."
            }
          ]
        },
        {
