              "instruction": "nobody, never, nowhere, anyone, anything",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: nobody, never, nowhere, anyone, anything]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "recently, already, last, once, to spend",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: recently, already, last, once, to spend]"
