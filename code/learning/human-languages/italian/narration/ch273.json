        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: innanzitutto",
          "segments": [
            {
              "kind": "speech",
              "text": "innanzitutto — \"first of all, above all\"."
            },
            {
              "kind": "speech",
              "text": "Innanzitutto, grazie a tutti di essere qui. First of all, thank you all for being here."
            },
            {
              "kind": "speech",
              "text": "Also written innanzi tutto; innanzi is an old word for ‘before, ahead’."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "innanzitutto joins innanzi \"before, ahead\", usually traced to Late Latin in ante, and tutto \"all\": before everything else. Latin ante meant \"before\" (Lewis & Short)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
