              "responseSeconds": 8,
              "source": "[YOU SAY: *vidya*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "vidya, once more",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *vidya*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "prati pillavāḍiki vidya avasaraṁ. — Every child needs education.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *prati pillavāḍiki vidya avasaraṁ.* — Every child needs education.]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say the Telugu for a scholarship, then the Telugu for to question, then say vidya again",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say the Telugu for a scholarship, then the Telugu for to question, then say *vidya* again]"
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
