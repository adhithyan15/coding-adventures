          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "paraître is inherited from Late Latin pārēscere, built on Latin pārēre \"to appear, to come in sight\" (Lewis & Short)."
            }
          ]
