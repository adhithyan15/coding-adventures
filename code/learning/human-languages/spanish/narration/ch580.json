        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: el motivo",
          "segments": [
            {
              "kind": "speech",
              "text": "el motivo — \"the reason, the motive\"."
            },
            {
              "kind": "speech",
              "text": "¿Cuál es el motivo del viaje? What is the reason for the trip?"
            },
            {
              "kind": "speech",
              "text": "Por este motivo — for this reason. Close to la razón."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "motivo is a learned borrowing from Late Latin motivus 'moving', built on movere 'to move': a motive is what moves you (EtymDB)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
