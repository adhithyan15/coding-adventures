              "action": "SAY",
              "instruction": "“I will do; I will read” — kariṣyāmi; paṭhiṣyāmi",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: “I will do; I will read” — *kariṣyāmi; paṭhiṣyāmi*]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
