          "segments": [
            {
              "kind": "speech",
              "text": "brouiller — \"to mix up, to blur; (se brouiller) to fall out\"."
            },
            {
              "kind": "speech",
              "text": "Les deux frères se sont brouillés à cause d'une maison. The two brothers fell out over a house."
            },
            {
              "kind": "speech",
              "text": "Se brouiller avec quelqu'un — to fall out with someone. Des œufs brouillés — scrambled eggs."
            }
          ]
        },
