      "expected": {
        "outcome": "error",
        "error_code": "invalid-argument"
      }
    },
    {
      "id": "phy01/construct/infinite-amplitude",
      "operation": "construct",
      "summary": "Infinite amplitude is rejected.",
      "input": {
        "wave": {
          "amplitude": {"kind": "positive-infinity"},
