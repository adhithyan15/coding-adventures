              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *rukhṣa*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "ʿinda ukhtī rukhṣat qiyāda jadīda. — My sister has a new driving licence.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *ʿinda ukhtī rukhṣat qiyāda jadīda.* — My sister has a new driving licence.]"
            },
            {
              "kind": "prompt",
