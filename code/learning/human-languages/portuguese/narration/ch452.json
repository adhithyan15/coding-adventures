        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: o barbeiro",
          "segments": [
            {
              "kind": "speech",
              "text": "o barbeiro — \"the barber\"."
            },
            {
              "kind": "speech",
              "text": "O barbeiro corta o cabelo ao meu avô há trinta anos. The barber has cut my grandfather's hair for thirty years."
            },
            {
              "kind": "speech",
              "text": "Built on a barba."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "barbeiro is built from barba 'beard' and -eiro (EtymDB); barba is inherited from Latin barba."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
