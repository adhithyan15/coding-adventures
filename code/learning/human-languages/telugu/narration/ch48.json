          "segments": [
            {
              "kind": "speech",
              "text": "విద్యార్థి (vidyārthi) — \"a student\"."
            },
            {
              "kind": "speech",
              "text": "Two Sanskrit pieces welded: vidyā, knowledge, and arthin, one who seeks. A student is a knowledge-seeker, and the word says so on its face."
            },
            {
              "kind": "speech",
              "text": "vidyā grows from the root vid, \"to know\" — the same ancient root behind English wit and wisdom, and behind Latin vidēre, \"to see\". Knowing and seeing were one word long before either language existed."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "Two: a teacher and a student."
            }
          ]
        },
        {
