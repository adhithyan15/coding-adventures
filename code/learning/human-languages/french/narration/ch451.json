            },
            {
              "kind": "speech",
              "text": "Before the new one: say the French for the card machine, then the French for cash."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: le retrait",
          "segments": [
            {
              "kind": "speech",
              "text": "le retrait — \"the withdrawal\"."
            },
            {
              "kind": "speech",
              "text": "Il a fait un retrait de cinquante euros. He took out fifty euros."
            },
            {
              "kind": "speech",
              "text": "Un retrait d'argent — a cash withdrawal."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "retrait is the old past participle of retraire 'to draw back', from Latin retrahere, built on trahere 'to draw' (Lewis & Short). EtymDB does not list it."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
            }
          ]
