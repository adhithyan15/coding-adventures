            {
              "kind": "speech",
              "text": "Before the new one: say the Sanskrit for is lost, then the Sanskrit for gets angry."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: वर्षति",
          "segments": [
            {
              "kind": "speech",
              "text": "वर्षति — varṣati — \"rains\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "varṣati is the present of the root √vṛṣ, \"to rain\" (MW), a Rigvedic verb (CDIAL 11394). It lives on as Hindi barasnā, \"to rain\", and its noun varṣa, \"rain, year\", gives Hindi baras, \"year\" (CDIAL 11392)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
