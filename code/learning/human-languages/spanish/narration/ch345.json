        },
        {
          "index": 6,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What did iacere mean? (To throw.) And what is a projectile, word for word? (A thing thrown forward.)"
            }
          ]
