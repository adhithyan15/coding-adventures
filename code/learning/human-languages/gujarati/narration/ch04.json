              "action": "SAY",
              "instruction": "\"maḷīshũ\"",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: \"maḷīshũ\"]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "the verb it's from (maḷvũ, \"to meet,\" from Sanskrit mil-)",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: the verb it's from (*maḷvũ*, \"to meet,\" ← Sanskrit *mil-*)]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "the extra letter it shows (retroflex ળ, ḷ)",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: the extra letter it shows (retroflex ળ, *ḷ*)]"
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What verb is maḷīshũ from, and what special letter does it use? (Maḷvũ \"to meet\"; the retroflex ળ ḷ, which Hindi lacks.)"
            }
          ]
        }
      ]
