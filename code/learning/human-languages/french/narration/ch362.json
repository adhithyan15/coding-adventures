          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "citoyen is inherited from Old French citoien (EtymDB), built on cité \"city\", from Latin cīvitās \"citizenship, a state\", from cīvis \"citizen\" (Lewis & Short)."
            }
          ]
        },
