          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Prognose is a learned borrowing from Late Latin prognōsis, from Greek prógnōsis \"foreknowledge\", built from pro \"before\" and gnôsis \"knowing\". EtymDB has no entry for the German word."
            }
          ]
        },
