        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "सहेली (sahelī) is a tadbhava, a word inherited from Sanskrit and reshaped by sound change. It comes from sakhī, \"woman's confidante\" (CDIAL 13074). CDIAL notes an added -l-."
            }
          ]
