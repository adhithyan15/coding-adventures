        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: il mazzo",
          "segments": [
            {
              "kind": "speech",
              "text": "il mazzo — \"deck (of cards); bunch\"."
            },
            {
              "kind": "speech",
              "text": "Il nonno mescola il mazzo e dà le carte. Grandad shuffles the deck and deals the cards."
            },
            {
              "kind": "speech",
              "text": "Un mazzo di fiori — a bunch of flowers; un mazzo di chiavi — a bunch of keys."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "mazzo is usually traced, like mazza \"a club\", to Vulgar Latin mattea, from Latin mateola \"a mallet\" (EtymDB)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
