        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: die Nadel",
          "segments": [
            {
              "kind": "speech",
              "text": "die Nadel — \"needle\"."
            },
            {
              "kind": "speech",
              "text": "Die Nadel ist so klein, dass meine Oma eine Brille braucht. The needle is so small that my grandma needs glasses."
            },
            {
              "kind": "speech",
              "text": "Plural: die Nadeln. Also a pin, or the needle of a pine tree."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Nadel is inherited from Middle High German nādele and Old High German nādala, from Proto-Germanic nēþlō \"needle\" (EtymDB); English needle is a cousin."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
