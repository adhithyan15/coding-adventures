// DeckStatsPanel.dark.msl - dark deck-stat panel theme.

style DeckStatsPanel {
  part deck-stats-panel {
    background    : "#172033" ;
    border-width  : 1 ;
    border-color  : "#475569" ;
    border-radius : 8 ;
    padding       : 14 ;
  }

  part deck-stats-label {
    color       : "#94a3b8" ;
    font-size   : 11 ;
    font-weight : 700 ;
  }

  part deck-stats-name {
    color          : "#f8fafc" ;
    font-size      : 20 ;
    font-weight    : 800 ;
    padding-bottom : 10 ;
  }

  part deck-list-label {
    color       : "#94a3b8" ;
    font-size   : 11 ;
    font-weight : 700 ;
  }

  part deck-list-row {
    padding-top    : 4 ;
    padding-bottom : 8 ;
  }

  part deck-option-button {
    background    : "#1e293b" ;
    border-width  : 1 ;
    border-color  : "#334155" ;
    border-radius : 6 ;
    color         : "#ecfeff" ;
    font-weight   : 700 ;
    padding       : 7 ;
  }

  part deck-stats-grid {
    padding : 2 ;
    padding-top : 10 ;
  }

  part deck-stat-total {
    background    : "#1e293b" ;
    border-width  : 1 ;
    border-color  : "#334155" ;
    border-radius : 6 ;
    padding       : 9 ;
  }

  part deck-stat-new {
    background    : "#1e293b" ;
    border-width  : 1 ;
    border-color  : "#334155" ;
    border-radius : 6 ;
    padding       : 9 ;
  }

  part deck-stat-due {
    background    : "#1e293b" ;
    border-width  : 1 ;
    border-color  : "#334155" ;
    border-radius : 6 ;
    padding       : 9 ;
  }

  part deck-stat-learning {
    background    : "#1e293b" ;
    border-width  : 1 ;
    border-color  : "#334155" ;
    border-radius : 6 ;
    padding       : 9 ;
  }

  part deck-stat-hidden {
    background    : "#1e293b" ;
    border-width  : 1 ;
    border-color  : "#334155" ;
    border-radius : 6 ;
    padding       : 9 ;
  }

  part deck-total-value {
    color       : "#f8fafc" ;
    font-size   : 18 ;
    font-weight : 800 ;
  }

  part deck-new-value {
    color       : "#60a5fa" ;
    font-size   : 18 ;
    font-weight : 800 ;
  }

  part deck-due-value {
    color       : "#fbbf24" ;
    font-size   : 18 ;
    font-weight : 800 ;
  }

  part deck-learning-value {
    color       : "#a78bfa" ;
    font-size   : 18 ;
    font-weight : 800 ;
  }

  part deck-hidden-value {
    color       : "#64748b" ;
    font-size   : 18 ;
    font-weight : 800 ;
  }

  part deck-total-label {
    color       : "#94a3b8" ;
    font-size   : 11 ;
    font-weight : 700 ;
  }

  part deck-new-label {
    color       : "#94a3b8" ;
    font-size   : 11 ;
    font-weight : 700 ;
  }

  part deck-due-label {
    color       : "#94a3b8" ;
    font-size   : 11 ;
    font-weight : 700 ;
  }

  part deck-learning-label {
    color       : "#94a3b8" ;
    font-size   : 11 ;
    font-weight : 700 ;
  }

  part deck-hidden-label {
    color       : "#94a3b8" ;
    font-size   : 11 ;
    font-weight : 700 ;
  }
}
