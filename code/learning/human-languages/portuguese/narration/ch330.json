        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: descascar",
          "segments": [
            {
              "kind": "speech",
              "text": "descascar — \"to peel\"."
            },
            {
              "kind": "speech",
              "text": "A minha mãe descasca as batatas. My mother peels the potatoes."
            },
            {
              "kind": "speech",
              "text": "Built on a casca, ‘the peel, the shell’."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "descascar is built from des- and casca \"peel, shell, bark\"; EtymDB derives casca from the verb cascar and goes no further, so the deeper origin is not settled."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
