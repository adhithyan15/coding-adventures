          "segments": [
            {
              "kind": "speech",
              "text": "durchsuchen — \"to search (a bag, a place)\"."
            },
            {
              "kind": "speech",
              "text": "Eine Beamtin durchsucht ihren Rucksack. An official searches her rucksack."
            },
            {
              "kind": "speech",
              "text": "Inseparable: sie durchsucht, sie hat durchsucht."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "durchsuchen is built from durch 'through' and suchen 'to look for', inherited from Old High German suohhen and Proto-Germanic sōkijaną (EtymDB). English seek is a cousin."
            }
          ]
        },
