          "segments": [
            {
              "kind": "speech",
              "text": "نمایشنامه (namâyeshnâme) — \"a play (script)\"."
            },
            {
              "kind": "speech",
              "text": "او یک نمایشنامه کوتاه برای بچه ها نوشت. u yek namâyeshnâme-ye kutâh barâ-ye bachchehâ nevesht. She wrote a short play for children."
            },
            {
              "kind": "speech",
              "text": "namâyesh 'show' + nâme 'writing, letter'. Add -nevis 'writer' for a playwright."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "namâyeshnâme is built on native Persian parts: namâyesh, 'show', from the verb namudan, 'to show', and nâme, 'letter, writing'. EtymDB has no entry for the compound."
            }
          ]
        },
