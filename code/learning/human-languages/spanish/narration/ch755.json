          "title": "You'll want to know: trotar",
          "segments": [
            {
              "kind": "speech",
              "text": "trotar — \"to jog, to trot\"."
            },
            {
              "kind": "speech",
              "text": "Troto en el parque cada mañana. I jog in the park every morning."
            },
            {
              "kind": "speech",
              "text": "Common in Latin America; in Spain people mostly say salir a correr."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "trotar was borrowed from French trotter \"to trot\", which is usually traced to Frankish trottōn \"to tread\"."
            }
          ]
        },
