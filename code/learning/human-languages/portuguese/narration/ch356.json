          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Portuguese for the candidate, then the Portuguese for to hire."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: despedir",
          "segments": [
            {
              "kind": "speech",
              "text": "despedir — \"to fire, to dismiss; (despedir-se) to say goodbye\"."
            },
            {
              "kind": "speech",
              "text": "A fábrica despediu cinquenta trabalhadores. The factory fired fifty workers."
            },
            {
              "kind": "speech",
              "text": "Despedir-se de alguém — to say goodbye to someone. Conjugated despeço, despedes, despede."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "despedir is formed from Latin dē and expetere \"to seek after, to ask for\" (EtymDB, Lewis & Short), built on petere \"to seek\"; it first meant \"to ask leave to go\", and then \"to send away\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
            }
          ]
        },
        {
          "index": 4,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
