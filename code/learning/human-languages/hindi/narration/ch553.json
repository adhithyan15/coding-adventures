        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: सिवा",
          "segments": [
            {
              "kind": "speech",
              "text": "सिवा — sivā — \"except (के सिवा)\"."
            },
            {
              "kind": "speech",
              "text": "रविवार के सिवा दुकान हर दिन खुली रहती है। Ravivār ke sivā dukān har din khulī rahtī hai. The shop is open every day except Sunday."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "सिवा (sivā) is usually traced to Arabic siwā, \"except\", through Persian."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for saying what happens if."
