            {
              "kind": "speech",
              "text": "नींद आ रही है (nīnd ā rahī hai) — \"I'm sleepy\", literally \"sleep is coming\"."
            },
            {
              "kind": "speech",
              "text": "नींद is the sleep you know. Sleep comes to you, the way anger and laughter do."
            }
          ]
        },
