    {
      "id": "ES-C416-quedarse",
      "sequence": 9590,
      "title": "quedarse — come to rest and stay",
      "headword": "quedarse",
      "romanization": "quedarse",
      "gloss": "to stay, to remain",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:e9c18fdcfa9d73c8",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Recall una habitación, a room. A traveller who keeps that room for several nights is going to quedarse, to stay."
            }
          ]
        },
        {
          "index": 1,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Spanish quedar reaches back to Latin quietāre, to make quiet or bring to rest. The se turns the action toward the person: quedarse is to remain or stay. Think of a traveller coming to rest in one place."
            }
          ]
        },
        {
          "index": 2,
          "type": "grammar",
          "title": "Grammar Lens: say who stays",
          "segments": [
            {
              "kind": "speech",
              "text": "The pronoun changes with the person: me quedo means “I stay,” while the infinitive follows another verb in quiero quedarme, “I want to stay.” A duration can follow directly: quedarse tres noches."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "quedarse",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *quedarse*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "me quedo tres noches",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *me quedo tres noches*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "quiero quedarme tres noches",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *quiero quedarme tres noches*]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "To stay? (Quedarse.) I am staying three nights? (Me quedo tres noches.)"
            },
            {
              "kind": "speech",
              "text": "Source: DLE: quedar."
            }
          ]
        }
      ]
    },
    {
