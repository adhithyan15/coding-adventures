              "responseSeconds": 8,
              "source": "[YOU RECALL: say the Russian for inevitable, then the Russian for to arise, then say *nesmotryá na* again]"
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
