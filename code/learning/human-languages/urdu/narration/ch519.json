              "kind": "speech",
              "text": "Masculine."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ڈھول (ḍhol) is inherited from Sanskrit ḍhōla, \"a large drum\" (CDIAL 5608)."
            }
          ]
        },
