        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: दंतकथा",
          "segments": [
            {
              "kind": "speech",
              "text": "दंतकथा — dantkathā — \"a legend\"."
            },
            {
              "kind": "speech",
              "text": "या तलावाबद्दल एक जुनी दंतकथा आहे. yā talāvābaddal ek junī dantkathā āhe. There is an old legend about this lake."
            },
            {
              "kind": "speech",
              "text": "Feminine."
            },
            {
              "kind": "speech",
              "text": "A tale passed on by word of mouth."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "दंतकथा (dantkathā) is built from Sanskrit danta, 'a tooth', and kathā, 'a story' (Monier-Williams); it is usually explained as a tale passed from mouth to mouth."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling what happened."
