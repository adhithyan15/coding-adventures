        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: punir",
          "segments": [
            {
              "kind": "speech",
              "text": "punir — \"to punish\"."
            },
            {
              "kind": "speech",
              "text": "A lei pune quem conduz depois de beber. The law punishes people who drive after drinking."
            },
            {
              "kind": "speech",
              "text": "Formal; ser punido — to be punished."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "punir is a learned borrowing from Latin pūnīre \"to punish\" (EtymDB), built on poena \"penalty, punishment\" (Lewis & Short)."
            }
          ]
        },
        {
