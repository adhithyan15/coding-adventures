<Window
    x:Class="Mosaic.HelloDialog.Demo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Mosaic.HelloDialog.Demo"
    xmlns:gen="using:Mosaic.Generated"
    Title="HelloDialog — Mosaic → XAML demo">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Margin="40"
                   FontSize="18"
                   TextWrapping="Wrap"
                   Text="Mosaic source → mosaic-emit-xaml → WinUI 3 ContentDialog. The dialog should appear automatically; click Close (or press Esc) to dismiss it. The status text below echoes the Dispatch events as they fire."/>
        <TextBlock Grid.Row="1" Margin="40,0,40,20" x:Name="StatusText"
                   FontSize="14"
                   Foreground="#888"
                   Text="Status: waiting for dialog..."/>
        <Button Grid.Row="1" HorizontalAlignment="Right" Margin="0,0,40,20"
                x:Name="OpenButton"
                Content="Open the dialog again"
                Click="OnOpenButtonClick"/>
    </Grid>
</Window>
