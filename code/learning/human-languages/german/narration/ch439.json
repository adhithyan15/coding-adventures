        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: der Stadtteil",
          "segments": [
            {
              "kind": "speech",
              "text": "der Stadtteil — \"the district, the part of town\"."
            },
            {
              "kind": "speech",
              "text": "In unserem Stadtteil gibt es zwei Schulen. There are two schools in our part of town."
            },
            {
              "kind": "speech",
              "text": "Plural: die Stadtteile."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Stadtteil is built from Stadt 'town' and Teil 'part', inherited from Proto-Germanic dailą (EtymDB)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
