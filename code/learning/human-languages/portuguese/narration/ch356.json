      "id": "PT-C356-despedir",
      "sequence": 20270,
      "title": "despedir — to fire, to dismiss; (despedir-se) to say goodbye",
      "headword": "despedir",
      "romanization": "despedir",
      "gloss": "to fire, to dismiss; (despedir-se) to say goodbye",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:aecc4278118f95a3",
      "notice": null,
      "blocks": [
        {
          "index": 0,
