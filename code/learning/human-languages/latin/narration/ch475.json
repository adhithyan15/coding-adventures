            },
            {
              "kind": "speech",
              "text": "Spīcae plēnae et flāvae sunt; messis bona erit. The ears of grain are full and golden; the harvest will be good."
            },
            {
              "kind": "speech",
              "text": "First declension, feminine: spīca, spīcae f. The head of wheat or barley."
            }
          ]
        },
