    {
      "id": "TE-C55-tank",
      "sequence": 1590,
      "title": "చెరువు (ceruvu) — a village tank, a reservoir",
      "headword": "చెరువు",
      "romanization": "ceruvu",
      "gloss": "a village tank, a reservoir",
      "script": "telugu",
      "modality": "voice",
      "derivedModality": "voice",
