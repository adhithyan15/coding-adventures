          "segments": [
            {
              "kind": "speech",
              "text": "la melancolía — \"melancholy, gloom\"."
            },
            {
              "kind": "speech",
              "text": "El otoño me da melancolía. Autumn makes me melancholy."
            },
            {
              "kind": "speech",
              "text": "A soft, lasting sadness. The adjective is melancólico."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "melancolía is a learned borrowing from Late Latin melancholia, from Greek melankholía \"blackness of the bile\" (EtymDB), built on mélas \"black\" and kholḗ \"bile\"; old medicine blamed gloom on black bile."
            }
          ]
        },
