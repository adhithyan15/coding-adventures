// CardBrowser.mil - reusable card browser/search surface.
//
// The host owns search execution and mutations. This component only describes
// a target-neutral UI contract for Anki-style browser workflows.

component CardBrowser {
  slot browser-label : text ;
  slot query-label : text ;
  slot query : text ;
  slot query-placeholder : text ;
  slot filter-label : text ;
  slot filter-value : text ;
  slot filter-options : list<text> ;
  slot filter-placeholder : text ;
  slot filter-open : bool ;
  slot search-label : text ;
  slot results-label : text ;
  slot results-summary : text ;
  slot results : list<text> ;
  slot result-card-ids : list<text> ;
  slot result-note-ids : list<text> ;
  slot result-template-ids : list<text> ;
  slot result-states : list<text> ;
  slot result-flags : list<text> ;
  slot selected-index : number ;
  slot selected-card-id : text ;
  slot selected-note-id : text ;
  slot selected-template-id : text ;
  slot selected-state : text ;
  slot selected-flag : text ;
  slot open-label : text ;
  slot edit-label : text ;
  slot suspend-label : text ;
  slot mark-label : text ;
  slot flag-label : text ;
  slot flag-value : text ;
  slot flag-options : list<text> ;
  slot flag-placeholder : text ;
  slot flag-open : bool ;
  slot tag-edit-label : text ;
  slot tag-edit : text ;
  slot tag-edit-placeholder : text ;
  slot add-tag-label : text ;
  slot remove-tag-label : text ;
  slot custom-study-label : text ;
  slot custom-study-limit-label : text ;
  slot custom-study-limit-value : number ;
  slot custom-study-reschedule-label : text ;
  slot custom-study-reschedule-value : bool ;
  slot custom-study-rebuild-label : text ;
  slot custom-study-empty-label : text ;

  emit onQueryChange ( value : text ) ;
  emit onToggleFilter ;
  emit onSetFilter ( value : text ) ;
  emit onSearch ;
  emit onSelectResult ( index : number ) ;
  emit onOpenSelected ;
  emit onEditSelected ;
  emit onToggleSuspendSelected ;
  emit onToggleMarkSelected ;
  emit onToggleFlagPicker ;
  emit onSetFlagSelected ( value : text ) ;
  emit onTagEditChange ( value : text ) ;
  emit onAddTagSelected ;
  emit onRemoveTagSelected ;
  emit onCustomStudyLimitChange ( value : number ) ;
  emit onCustomStudyRescheduleChange ( checked : bool ) ;
  emit onRebuildFilteredDeck ;
  emit onEmptyFilteredDeck ;
}
