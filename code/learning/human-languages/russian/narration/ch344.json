        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: логика",
          "segments": [
            {
              "kind": "speech",
              "text": "логика (lógika) — \"logic\"."
            },
            {
              "kind": "speech",
              "text": "В его словах нет логики. V yegó slovákh net lógiki. There is no logic in what he says."
            },
            {
              "kind": "speech",
              "text": "Feminine. По логике — logically speaking."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "логика (lógika) is usually traced, through western languages, to Greek logikḗ \"the art of reasoning\", built on lógos \"word, reason\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
