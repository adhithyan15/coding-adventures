        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "Read what you just did. The word ends in ം, so it welds onto ആണ് the way the last chapter's two words did, and you did it without being told."
            },
            {
              "kind": "table",
              "headers": [
                "",
                ""
              ],
              "columns": 2,
              "rowCount": 2,
              "utterances": [
                "ഇത് എളുപ്പമാണ്, this is easy.",
                "ഇത് സുന്ദരമാണ്, this is beautiful."
              ]
            },
            {
              "kind": "speech",
              "text": "That is what a frame is for. The chapter before this one cost you a rule; this one costs you a word, and the rule is still doing the work."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
