      "id": "ES-C45-nos",
      "sequence": 1226,
      "title": "nos — \"us\"",
      "headword": "nos",
      "romanization": "nos",
      "gloss": "\"us\" — the object pronoun that speaks for more than one person",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:75be56cd10daf7dd",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Say \"you love me.\" (Me quieres.) And \"I love you.\" (Te quiero.) Both of those are about one person on the receiving end. Here is more than one."
            },
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Podemos keeps the plain stem; pueden breaks it again. Say both."
            }
          ]
        },
        {
          "index": 1,
          "type": "grammar",
          "title": "Grammar Lens: the third person in the room",
          "segments": [
            {
              "kind": "speech",
              "text": "nos — us."
            },
            {
              "kind": "speech",
              "text": "Nos quieren. — They love us."
            },
            {
              "kind": "speech",
              "text": "Same slot as always, in front of the verb. Me is one person speaking; nos is that person and somebody else."
            },
            {
              "kind": "speech",
              "text": "Me quieren. — They love me. Nos quieren. — They love us."
            },
            {
              "kind": "speech",
              "text": "One letter of difference, and the difference is how many people you are speaking for."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "nos is Latin nos, \"us\" and \"we\", unchanged in two thousand years. The next lesson shows what Spanish built on it."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
