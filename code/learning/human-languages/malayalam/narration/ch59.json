      "id": "ML-C59-wind",
      "sequence": 1840,
      "title": "കാറ്റ് (kāṟṟŭ) — wind",
      "headword": "കാറ്റ്",
      "romanization": "kāṟṟŭ",
      "gloss": "wind",
      "script": "malayalam",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
