            },
            {
              "kind": "speech",
              "text": "“It is a language academy.”"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "Es una academia de idiomas.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *Es una academia de idiomas.*]"
            },
            {
              "kind": "speech",
              "text": "“I speak French.”"
