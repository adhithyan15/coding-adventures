          "segments": [
            {
              "kind": "speech",
              "text": "દિશા — diśā — \"direction\"."
            },
            {
              "kind": "speech",
              "text": "સ્ટેશન આ દિશામાં છે. — sṭeśan ā diśāmā̃ che — \"The station is in this direction.\""
            },
            {
              "kind": "speech",
              "text": "A feminine noun."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "દિશા (diśā) is Sanskrit diśā, \"direction, region\", a form of díś, taken over whole as a learned loan, a tatsama (CDIAL 6339)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
