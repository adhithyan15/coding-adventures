          "title": "Script — a bar, a vertical, a dot",
          "segments": [
            {
              "kind": "speech",
              "text": "下 (xià)."
            },
            {
              "kind": "speech",
              "text": "One piece, three strokes."
            },
            {
              "kind": "speech",
              "text": "A long horizontal across the top."
            },
            {
              "kind": "speech",
              "text": "A vertical hanging down from its middle."
            },
            {
              "kind": "speech",
              "text": "A dot to the right of the vertical, slanting down to the right."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
