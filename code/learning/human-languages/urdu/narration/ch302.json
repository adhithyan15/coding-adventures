          "segments": [
            {
              "kind": "speech",
              "text": "افواہ — afvāh — \"a rumour\"."
            },
            {
              "kind": "speech",
              "text": "شہر میں ایک افواہ تھی۔ shahr meṅ ek afvāh thī. There was a rumour going round the city."
            },
            {
              "kind": "speech",
              "text": "Feminine."
            }
          ]
        },
        {
