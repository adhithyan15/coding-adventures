          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "el medio ambiente is built on medio, inherited from Latin medius 'middle', and ambiente, from Latin ambiens 'going round', from ambire (Lewis & Short)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
