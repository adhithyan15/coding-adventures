      "id": "RU-C401-prilozhenie",
      "sequence": 23080,
      "title": "приложение (prilozhéniye) — an app; an attachment; a supplement",
      "headword": "приложение",
      "romanization": "prilozhéniye",
      "gloss": "an app; an attachment; a supplement",
      "script": "cyrillic",
      "modality": "voice",
      "derivedModality": "voice",
