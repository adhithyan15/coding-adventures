        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: दूरदर्शनम्",
          "segments": [
            {
              "kind": "speech",
              "text": "दूरदर्शनम् — dūradarśanam — \"a television\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "dūradarśana is built from dūra \"far\" and darśana \"seeing\", from the root √dṛś \"see\" (MW): \"far-seeing\". It is a modern coinage, made the way English television was made from Greek tele \"far\" + Latin visio \"seeing\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
