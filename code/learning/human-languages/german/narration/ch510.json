          "segments": [
            {
              "kind": "speech",
              "text": "Zuschauer is built on zuschauen \"to watch\", from schauen \"to look\", inherited from Old High German scouwōn, from Proto-Germanic skawwōną (EtymDB)."
            }
          ]
        },
