            },
            {
              "kind": "speech",
              "text": "Soweit ich weiß, ist das Geschäft am Montag geschlossen. As far as I know, the shop is closed on Monday."
            },
            {
              "kind": "speech",
              "text": "Soweit sends the verb to the end: soweit ich weiß, soweit ich mich erinnere."
            }
          ]
