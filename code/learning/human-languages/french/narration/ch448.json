        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: le coiffeur",
          "segments": [
            {
              "kind": "speech",
              "text": "le coiffeur — \"the hairdresser, the barber\"."
            },
            {
              "kind": "speech",
              "text": "Je vais chez le coiffeur une fois par mois. I go to the hairdresser's once a month."
            },
            {
              "kind": "speech",
              "text": "Feminine la coiffeuse. Aller chez le coiffeur."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "coiffeur is built on coiffer 'to do someone's hair' (EtymDB), from coiffe 'cap', which is usually traced to Late Latin cofia, of Germanic origin."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
