# Perl 5.004_05-MT8 (1998-12-03) plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: unsupported Perl 5.004_05-MT8 syntax is rejected.
# Evidence: https://mirrors.develooper.com/perl/historical-perl/perl-5.004_05-MT8.tar.gz
# Archive SHA-256: f7da20ab60e70f1b485c52c6d9556fdb9e03bfc31a497d5678fb4a00e3207a13
# perly.y matches 5.004_04-m4; only arithmetic precedence, grouping,
# and print are represented here. This file does not claim full Perl syntax.

program         = print_statement { print_statement } ;
print_statement = PRINT LPAREN expr RPAREN SEMICOLON ;
expr            = term { ( PLUS | MINUS ) term } ;
term            = unary { STAR unary } ;
unary           = MINUS unary | atom ;
atom            = INT | LPAREN expr RPAREN ;
