    {
      "id": "ZH-W159-fang-room",
      "sequence": 13075,
      "title": "房 (fáng) — a door over fāng",
      "headword": "房",
      "romanization": "fáng",
      "gloss": "房 — a door on top, the piece read fāng under it",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:5596a92698342f4d",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — a door over fāng",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — a door over fāng and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say shūfáng — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *shūfáng* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "书 门."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — shū, mén",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *shū*, *mén*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — a door over fāng",
          "segments": [
            {
              "kind": "speech",
              "text": "房 (fáng)."
            },
            {
              "kind": "speech",
              "text": "Two pieces, top over bottom. Count the pieces, not the strokes."
            },
            {
              "kind": "speech",
              "text": "The door, four strokes. A dot on top. A horizontal that turns down at its right end. A horizontal under it, closing the box. Then a long stroke from the top left falling down to the lower left: the side of the door."
            },
            {
              "kind": "speech",
              "text": "The piece read fāng, four strokes, under the door. A dot. A long horizontal. A horizontal that turns down and hooks back to the left. Last, a stroke falling to the left through the middle."
            },
            {
              "kind": "speech",
              "text": "4 + 4 = eight."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "房 (fáng), all eight, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 房, all eight, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many strokes in 房 (fáng)? (Eight.) Which piece is on top? (The door, four strokes.) Which stroke of the lower piece hooks? (The third, the one that turns down.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 房 (fáng), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
