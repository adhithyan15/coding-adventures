        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: летать",
          "segments": [
            {
              "kind": "speech",
              "text": "летать (letát) — \"to fly\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "летать (letát) is the repeated-action partner of лететь, \"to fly\", Proto-Slavic letěti — inherited (Vasmer). The same root is in самолёт, \"aeroplane\"."
            }
          ]
        },
        {
