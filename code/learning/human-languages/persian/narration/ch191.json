          "title": "You'll want to know: سر وقت",
          "segments": [
            {
              "kind": "speech",
              "text": "سر وقت — sar-e vaqt — \"on time\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "sar-e vaqt is \"at the head of the time\". sar, \"head\", is inherited (Middle Persian sar, EtymDB); vaqt, \"time\", is borrowed from Arabic waqt (root w-q-t, Lane)."
            }
