          "segments": [
            {
              "kind": "speech",
              "text": "داستان کوتاه (dâstân-e kutâh) — \"a short story\"."
            },
            {
              "kind": "speech",
              "text": "این نویسنده بیشتر داستان کوتاه مینویسد. in nevisande bishtar dâstân-e kutâh minevisad. This writer mostly writes short stories."
            },
            {
              "kind": "speech",
              "text": "dâstân 'story' + kutâh 'short'. Plural dâstânhâ-ye kutâh."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "dâstân-e kutâh is built on two native Persian words, dâstân, 'story', and kutâh, 'short', which EtymDB sets beside kuchek, 'small' (EtymDB)."
            }
          ]
        },
        {
