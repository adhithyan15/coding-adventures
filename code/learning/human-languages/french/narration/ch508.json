          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "le marathon takes its name from a Greek town (EtymDB), whose own name comes from Greek márathon \"fennel\"; the race recalls a runner's long journey from there."
            }
          ]
        },
