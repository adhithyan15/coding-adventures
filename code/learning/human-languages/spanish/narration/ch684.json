          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "forastero was borrowed from Catalan foraster (EtymDB), built on fora \"outside\", from Latin forās \"out of doors\"."
            }
          ]
        },
