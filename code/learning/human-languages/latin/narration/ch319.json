          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "restinguō is built on an old verb stinguō, \"to quench\", with re- (Lewis & Short); exstinguō is built on the same verb."
            }
          ]
        },
