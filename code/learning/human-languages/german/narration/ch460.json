            },
            {
              "kind": "speech",
              "text": "Morgens ist der Himmel bedeckt, später kommt die Sonne. In the morning the sky is overcast; later the sun comes out."
            },
            {
              "kind": "speech",
              "text": "The past participle of bedecken 'to cover', used as an adjective."
            }
          ]
        },
