          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Hindi for alone, then the Hindi for cold."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: दोबारा",
          "segments": [
            {
              "kind": "speech",
              "text": "दोबारा (dobārā) — \"again, a second time\"."
            },
            {
              "kind": "speech",
              "text": "दोबारा (dobārā) बोलिए — \"please say it again\". It is दो, \"two\", and बार, \"a time\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "दोबारा (dobārā) is a loan, usually traced to Persian dobāra, \"twice, a second time\". It is built from do, \"two\", and bār, \"a time\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "The repair a beginner needs most."
            }
          ]
        },
        {
          "index": 4,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "dobārā",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *dobārā*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "dobārā, once more",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *dobārā*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "say dobārā bolie",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: say *dobārā bolie*]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say the Hindi for alone, then the Hindi for cold, then say dobārā again",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say the Hindi for alone, then the Hindi for cold, then say *dobārā* again]"
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What does दोबारा (dobārā) mean? (\"Again, a second time\".) Say it once more."
            }
          ]
        }
      ]
    },
