          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "andererseits joins ander \"other\" to Seite \"side\", from Old High German sīta and Proto-Germanic sīdōn (EtymDB), with the adverb ending -s."
            }
