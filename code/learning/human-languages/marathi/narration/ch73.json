          "title": "You'll want to know: आजारी",
          "segments": [
            {
              "kind": "speech",
              "text": "आजारी — ājārī — \"ill, sick\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "आजारी (ājārī) is a loan, usually traced to Persian āzār, \"harm, pain, illness\". Marathi adds -ī: \"having an illness\"."
            }
          ]
        },
