      "id": "HI-C63-hunger",
      "sequence": 2360,
      "title": "भूख (bhūkh) — hunger",
      "headword": "भूख",
      "romanization": "bhūkh",
      "gloss": "hunger",
      "script": "devanagari",
      "modality": "voice",
      "derivedModality": "voice",
