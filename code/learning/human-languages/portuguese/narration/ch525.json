        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: o bibliotecário",
          "segments": [
            {
              "kind": "speech",
              "text": "o bibliotecário — \"librarian\"."
            },
            {
              "kind": "speech",
              "text": "O bibliotecário ajudou-me a encontrar o livro. The librarian helped me find the book."
            },
            {
              "kind": "speech",
              "text": "A woman is a bibliotecária."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "bibliotecário is built on biblioteca, a learned borrowing through Latin bibliothēca \"a library\" (Lewis & Short) from Greek bibliothḗkē, from biblíon \"book\" and thḗkē \"a store\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
