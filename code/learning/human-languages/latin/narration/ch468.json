          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ostrum was borrowed from Greek ostreon 'oyster, shellfish' (EtymDB; Lewis & Short), since the dye came from a shellfish."
            }
          ]
        },
