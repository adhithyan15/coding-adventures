              ],
              "responseSeconds": 14,
              "acceptedResponses": [
                "i had done something",
                "it marked a plain past, not a supposition"
              ],
              "feedback": {
                "correct": "From what had happened to what did not.",
                "incorrect": "A plain indicative past — amaveram, I had loved."
