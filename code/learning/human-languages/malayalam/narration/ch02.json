              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: \"enṟe pēru … āṇŭ\" with your name]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "note the copula at the end — āṇŭ",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: note the copula at the end — *āṇŭ*]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Give your name in Malayalam. (Enṟe pēru … āṇŭ.) What word does Malayalam add that Tamil omits? (The copula āṇŭ, \"is.\")"
            }
          ]
        }
      ]
