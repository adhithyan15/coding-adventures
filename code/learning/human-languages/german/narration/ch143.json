        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: die Miete",
          "segments": [
            {
              "kind": "speech",
              "text": "die Miete — \"the rent\". The noun behind mieten: Die Miete ist hoch. — \"The rent is high.\""
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Miete from Old High German miata, \"payment\" from Proto-Germanic mēzdō — inherited. (EtymDB 2.1) English meed, \"reward\", is a cousin."
            }
          ]
        },
        {
