            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Sanskrit for blunt, then the Sanskrit for valuable."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: कुशलः",
          "segments": [
            {
              "kind": "speech",
              "text": "कुशलः — kuśalaḥ — \"able, well\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "kuśala is the word behind kuśalam, \"well-being\", from your first greetings, and its origin is not settled (CDIAL 3365 judges the one modern derivation it cites \"very doubtful\"). A popular explanation takes it from kuśa, the sacred grass, with a root of cutting, \"skilled at cutting the grass\", but no dictionary we checked (MW, Apte, CDIAL) supports it. MW gives both \"well, healthy\" and \"competent, skilful\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for this chapter."
            }
          ]
        },
        {
          "index": 4,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
