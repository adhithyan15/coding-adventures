          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Latin for a paint, then the Latin for a paintbrush."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: incūs, incūdis",
          "segments": [
            {
              "kind": "speech",
              "text": "incūs, incūdis — \"an anvil\"."
            },
            {
              "kind": "speech",
              "text": "Faber ferrum calidum in incūde pōnit. The smith puts the hot iron on the anvil."
            },
            {
              "kind": "speech",
              "text": "Third declension, feminine: incūs, incūdis f. Ad incūdem redīre, to go back to the anvil, to rework a piece of writing. English incus is a bone of the ear, named for its shape."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "incūs is built on incūdō 'to forge on' (EtymDB; Lewis & Short), from in 'on' and cūdō 'to strike, to hammer': the block that iron is struck on."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
            }
          ]
        },
