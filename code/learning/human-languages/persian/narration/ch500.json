        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: عمو",
          "segments": [
            {
              "kind": "speech",
              "text": "عمو ('amu) — \"an uncle (father's brother)\"."
            },
            {
              "kind": "speech",
              "text": "عموی من در روستا زندگی میکند. 'amu-ye man dar rustâ zendegi mikonad. My uncle lives in a village."
            },
            {
              "kind": "speech",
              "text": "The father's brother; the mother's brother is dâyi. Children also call any friendly older man 'amu."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "'amu comes from Arabic ʿamm, 'paternal uncle' (EtymDB)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
