          "index": 1,
          "type": "input",
          "title": "You'll want to know: die Verpackung",
          "segments": [
            {
              "kind": "speech",
              "text": "die Verpackung — \"the packaging\"."
            },
            {
              "kind": "speech",
              "text": "Die Verpackung ist größer als das Geschenk. The packaging is bigger than the present."
            },
            {
              "kind": "speech",
              "text": "Plural: die Verpackungen."
            }
          ]
        },
