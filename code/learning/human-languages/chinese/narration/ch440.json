    {
      "id": "ZH-W440-cun-village",
      "sequence": 33525,
      "title": "村 (cūn) — the tree piece, then the right piece of 对",
      "headword": "村",
      "romanization": "cūn",
      "gloss": "村 — the tree piece of 机, then the right piece of 对",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:762093fb84fe9685",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — the tree piece, then the right piece of 对",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — the tree piece, then the right piece of 对 and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say shāncūn — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *shāncūn* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "机 对."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — jī, duì",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *jī*, *duì*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — the tree piece, then the right piece of 对",
          "segments": [
            {
              "kind": "speech",
              "text": "村 (cūn)."
            },
            {
              "kind": "speech",
              "text": "Two pieces, left before right. Count the pieces, not the strokes."
            },
            {
              "kind": "speech",
              "text": "The left piece, the tree piece, four strokes, as on the left of 机: a bar, a vertical, a stroke falling to the left, and a short dot to the right."
            },
            {
              "kind": "speech",
              "text": "The right piece, three strokes, as on the right of 对: a bar, a vertical with a hook at the foot, and a dot to the left of it."
            },
            {
              "kind": "speech",
              "text": "4 + 3 = seven."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "村 (cūn), all seven, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 村, all seven, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many strokes in 村 (cūn)? (Seven.) What is the left piece? (The tree piece, as in 机.) Where does the last dot go? (To the left of the hooked vertical.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 村 (cūn), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
