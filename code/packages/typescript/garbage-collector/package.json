{
  "name": "@coding-adventures/garbage-collector",
  "version": "0.1.0",
  "description": "Mark-and-sweep garbage collection primitives for educational virtual machines",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc",
    "test": "node node_modules/typescript/bin/tsc -p tsconfig.test.json && node --test dist-test/tests/gc.test.js",
    "test:coverage": "node node_modules/typescript/bin/tsc -p tsconfig.test.json && node --experimental-test-coverage --test-coverage-lines=80 --test dist-test/tests/gc.test.js"
  },
  "keywords": [
    "garbage-collector",
    "mark-and-sweep",
    "virtual-machine",
    "lisp",
    "computer-science",
    "education"
  ],
  "author": "Adhithya Rajasekaran",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  }
}
