        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: mǎidān",
          "segments": [
            {
              "kind": "speech",
              "text": "mǎidān — \"to pay the bill\"."
            },
            {
              "kind": "speech",
              "text": "fúwùyuán mǎidān — Excuse me, the bill, please!"
            },
            {
              "kind": "speech",
              "text": "Its characters come later; for now it is a word for the ear."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "mǎidān is built from 买 'to buy' and dān, both inherited from Middle Chinese, meaX and tan (Guangyun, in Baxter's transcription); the dictionary glosses the second 'single'. Paying the bill is a modern sense, and how the pair came to it is not settled."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for asking for what I want."
