          "segments": [
            {
              "kind": "speech",
              "text": "ચોકીદાર — cokīdār — \"watchman, guard\"."
            },
            {
              "kind": "speech",
              "text": "ચોકીદાર રાત્રે જાગે છે. — cokīdār rātre jāge che — \"The watchman stays awake at night.\""
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ચોકીદાર (cokīdār) is built from cokī, \"guard post\", and the Persian suffix -dār, \"holder, keeper\". CDIAL lists Gujarati cokī, \"square low seat\", with cok, \"square\", under Sanskrit catuṣka, \"set of four\" (CDIAL 4629)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for everyday life at A2."
