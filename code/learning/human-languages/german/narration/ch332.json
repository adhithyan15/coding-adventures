        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: zumal",
          "segments": [
            {
              "kind": "speech",
              "text": "zumal — \"especially since, all the more as\"."
            },
            {
              "kind": "speech",
              "text": "Wir bleiben zu Hause, zumal es draußen regnet. We are staying at home, especially since it is raining outside."
            },
            {
              "kind": "speech",
              "text": "Zumal starts a clause with the verb at the end, like weil. It adds a second, extra reason."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "zumal was built from zu \"at\" and Mal \"time, occasion\", from Old High German māl (EtymDB), and is usually said to have first meant \"at the same time, all together\", from which the sense \"especially since\" grew; EtymDB has no entry for the compound."
            }
          ]
        },
        {
          "index": 3,
