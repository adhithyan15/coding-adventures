          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "prensa comes from Catalan premsa 'a press' (EtymDB), a word usually traced to Latin premere 'to press'. The printing press gave its name to the papers it printed."
            }
          ]
        },
