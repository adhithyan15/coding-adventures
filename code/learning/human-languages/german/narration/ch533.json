          "segments": [
            {
              "kind": "speech",
              "text": "Kamin is inherited from Middle High German kamīn and Old High German kemīn, an early borrowing from Latin camīnus \"furnace\", from Greek káminos (EtymDB)."
            }
          ]
        },
