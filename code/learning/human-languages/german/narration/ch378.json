          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Aufsatz is usually traced to Middle High German ūfsaz, of the family of aufsetzen \"to set up, to draft\", built on setzen \"to set\": a text you set down."
            }
          ]
        },
