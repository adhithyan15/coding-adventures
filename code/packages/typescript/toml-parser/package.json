{
  "name": "@coding-adventures/toml-parser",
  "version": "0.1.1",
  "description": "Parses TOML text into ASTs using the grammar-driven parser.  Pure transform (no fs:read): the parser grammar is precompiled at build time into src/_grammar.ts and embedded as a TypeScript object literal.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "toml",
    "parser",
    "ast",
    "grammar-driven",
    "computer-science",
    "education"
  ],
  "author": "Adhithya Rajasekaran",
  "license": "MIT",
  "dependencies": {
    "@coding-adventures/lexer": "file:../lexer",
    "@coding-adventures/grammar-tools": "file:../grammar-tools",
    "@coding-adventures/parser": "file:../parser",
    "@coding-adventures/toml-lexer": "file:../toml-lexer",
    "@coding-adventures/directed-graph": "file:../directed-graph"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vitest": "^4.1.0",
    "@vitest/coverage-v8": "^4.1.0"
  }
}
