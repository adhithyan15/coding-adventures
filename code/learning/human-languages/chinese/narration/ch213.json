          "title": "You'll want to know: qiānzhèng",
          "segments": [
            {
              "kind": "speech",
              "text": "qiānzhèng — \"visa\"."
            },
            {
              "kind": "speech",
              "text": "wǒ hái méiyǒu qiānzhèng — I haven't got a visa yet."
            },
            {
              "kind": "speech",
              "text": "Its characters come later; for now it is a word for the ear."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "qiānzhèng is built from qiān 'to sign' and zhèng 'proof'. The second is inherited from Middle Chinese tsyingH (Guangyun, in Baxter's transcription), glossed 'to verify'; no dictionary we use records an older form of the first, so its history is not settled."
            }
          ]
        },
