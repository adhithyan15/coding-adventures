              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: its literal meaning (\"having gone, I come\" → \"I'll come back\")]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "the warm reply — pōy vā",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: the warm reply — *pōy vā*]"
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
