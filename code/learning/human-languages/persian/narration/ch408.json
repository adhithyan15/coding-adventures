        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: کلاهبرداری",
          "segments": [
            {
              "kind": "speech",
              "text": "کلاهبرداری (kolâhbardâri) — \"fraud, a scam\"."
            },
            {
              "kind": "speech",
              "text": "این ایمیل یک کلاهبرداری است. in imeyl yek kolâhbardâri ast. This email is a scam."
            },
            {
              "kind": "speech",
              "text": "Literally hat-lifting: kolâh \"hat\" + bardâri \"taking up\". Kolâhbardâr — a swindler."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "کلاهبرداری (kolâhbardâri) is a native Persian compound built from kolâh \"hat\", which EtymDB traces to Middle Persian kulāf, + bardâri \"lifting\", from bar \"up\" and dâshtan \"to hold\". A swindler lifts your hat."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
            }
          ]
        },
