        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: तथा",
          "segments": [
            {
              "kind": "speech",
              "text": "तथा (tathā) — \"so, in that way, likewise\"."
            },
            {
              "kind": "speech",
              "text": "कथम्, which you have had for a long time, asks \"how?\". तथा (tathā) answers it: \"that way\"."
            },
            {
              "kind": "speech",
              "text": "The t- at the front is the one you met on तत् and तत्र, and it does the same job here — it points back at what has just been said. On its own, as a reply, तथा means \"just so\", and doubled it agrees warmly: tathā tathā."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "The answer that matches a question you have had since early on."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
