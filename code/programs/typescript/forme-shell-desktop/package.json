{
  "name": "forme-shell-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Installable Tauri host for the Forme authoring shell",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "worker:bundle": "node scripts/build-worker-bundle.mjs",
    "worker:sea": "npm run worker:bundle && node scripts/build-worker-sea.mjs",
    "worker:sea:test": "node scripts/test-worker-sea.mjs",
    "dev": "vite --host 127.0.0.1 --port 1420",
    "ui:build": "vite build",
    "build": "npm run typecheck && npm run worker:bundle && npm run ui:build",
    "test": "npm run worker:bundle && vitest run",
    "test:coverage": "npm run worker:bundle && vitest run --coverage",
    "native:test": "cargo test --manifest-path src-tauri/Cargo.toml --tests",
    "native:check": "cargo check --manifest-path src-tauri/Cargo.toml --features desktop --bin forme-shell-desktop-native",
    "tauri:build": "tauri build --features desktop --bundles app --ci"
  },
  "dependencies": {
    "@coding-adventures/forme-authoring-core": "file:../../../packages/typescript/forme-authoring-core",
    "@coding-adventures/forme-authoring-editor": "file:../../../packages/typescript/forme-authoring-editor",
    "@coding-adventures/forme-authoring-preview": "file:../../../packages/typescript/forme-authoring-preview",
    "@coding-adventures/forme-authoring-publish": "file:../../../packages/typescript/forme-authoring-publish",
    "@coding-adventures/forme-authoring-shell": "file:../../../packages/typescript/forme-authoring-shell",
    "@coding-adventures/forme-cache": "file:../../../packages/typescript/forme-cache",
    "@coding-adventures/forme-capability": "file:../../../packages/typescript/forme-capability",
    "@coding-adventures/forme-deploy-runner-core": "file:../../../packages/typescript/forme-deploy-runner-core",
    "@coding-adventures/forme-emit-fs": "file:../../../packages/typescript/forme-emit-fs",
    "@coding-adventures/forme-errors": "file:../../../packages/typescript/forme-errors",
    "@coding-adventures/forme-identity": "file:../../../packages/typescript/forme-identity",
    "@coding-adventures/forme-orchestrator": "file:../../../packages/typescript/forme-orchestrator",
    "@coding-adventures/forme-pipeline-config": "file:../../../packages/typescript/forme-pipeline-config",
    "@coding-adventures/forme-render-static": "file:../../../packages/typescript/forme-render-static",
    "@coding-adventures/forme-router": "file:../../../packages/typescript/forme-router",
    "@coding-adventures/forme-stage": "file:../../../packages/typescript/forme-stage",
    "@coding-adventures/forme-theme-classless": "file:../../../packages/typescript/forme-theme-classless",
    "@coding-adventures/forme-types": "file:../../../packages/typescript/forme-types",
    "@tauri-apps/api": "2.12.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "^22.20.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/adhithyan15/coding-adventures.git",
    "directory": "code/programs/typescript/forme-shell-desktop"
  },
  "author": "Adhithya Rajasekaran",
  "license": "MIT"
}
