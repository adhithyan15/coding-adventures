          "title": "You'll want to know: l'inquiétude",
          "segments": [
            {
              "kind": "speech",
              "text": "l'inquiétude — \"worry, anxiety\"."
            },
            {
              "kind": "speech",
              "text": "Elle attend le résultat avec inquiétude. She is waiting for the result with worry."
            },
            {
              "kind": "speech",
              "text": "Built on inquiet \"worried\". Feminine: une inquiétude."
            }
          ]
        },
