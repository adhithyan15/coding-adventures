            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Malayalam for a tiger, then the Malayalam for a rabbit."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: സമയം",
          "segments": [
            {
              "kind": "speech",
              "text": "സമയം (samayaṁ) — \"time\". സമയം എത്ര? — \"what time is it?\""
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "സമയം (samayaṁ) from Sanskrit samaya, \"meeting, agreement; time\", taken over whole as a tatsama, with Malayalam's noun ending -ṁ (CDIAL 13185). A meeting at an agreed point became a time."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "The question on every street."
            }
          ]
        },
        {
          "index": 4,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
