              "source": "[YOU SAY: it once more, slowly]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "kōḻi, then maṇi, and say which one comes first in the morning",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *kōḻi*, then *maṇi*, and say which one comes first in the morning]"
