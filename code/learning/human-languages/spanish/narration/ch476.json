        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: el alumno",
          "segments": [
            {
              "kind": "speech",
              "text": "el alumno — \"the pupil, the student\"."
            },
            {
              "kind": "speech",
              "text": "Cada alumno tiene un libro. Each pupil has a book."
            },
            {
              "kind": "speech",
              "text": "A girl or woman is la alumna."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "alumno from Latin alumnus, \"a foster child, a pupil\" (EtymDB 2.1), from alere, \"to feed, to bring up\" — a learned borrowing: worn down in speech, its -mn- would have changed, as damnum became daño, \"harm\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for reading notices, forms and messages."
