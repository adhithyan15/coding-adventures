        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: la biglietteria",
          "segments": [
            {
              "kind": "speech",
              "text": "la biglietteria — \"the ticket office\"."
            },
            {
              "kind": "speech",
              "text": "La biglietteria apre alle sei. The ticket office opens at six."
            },
            {
              "kind": "speech",
              "text": "La biglietteria automatica is the ticket machine."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "biglietteria is built on biglietto 'ticket', which was borrowed from French billet 'note' (EtymDB)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
