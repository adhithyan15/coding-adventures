        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: le cordonnier",
          "segments": [
            {
              "kind": "speech",
              "text": "le cordonnier — \"the cobbler, the shoe mender\"."
            },
            {
              "kind": "speech",
              "text": "Le cordonnier a réparé mes bottes en une journée. The cobbler mended my boots in a day."
            },
            {
              "kind": "speech",
              "text": "Les cordonniers sont toujours les plus mal chaussés — the cobbler's children go barefoot."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "cordonnier is an altered form of an older word for a worker in fine leather, named after a city famous for it. EtymDB lists it without a source."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
