            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Bengali for time, then the Bengali for midday."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: কাছে",
          "segments": [
            {
              "kind": "speech",
              "text": "কাছে — kāchhe — \"near\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "কাছে (kāchhe), \"near\", probably goes back to Sanskrit kakṣa, \"armpit, side\", through Middle Indo-Aryan kaccha (CDIAL 2588). CDIAL has no Bengali row for it, but under that entry it lists Nepali kāch, \"side, edge\", and Assamese kāxe, \"by the side of\", and says some postpositions probably grew from the sense \"side\". The ending -e means \"at\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for this chapter."
            }
          ]
        },
        {
          "index": 4,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
