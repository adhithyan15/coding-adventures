# Perl 5.002 (1996-02-29) tokens: verified arithmetic-print subset only.
# @version 1
# PARTIAL: this does not lex all Perl 5.002 source.
# Evidence: https://github.com/Perl/perl5/blob/perl-5.002/perly.y
# Evidence: https://github.com/Perl/perl5/blob/perl-5.002/toke.c
# The tagged tokenizer maps `print` to KEY_print and exposes ADDOP/MULOP.

PRINT     = "print"
INT       = /[0-9]+/
PLUS      = "+"
MINUS     = "-"
STAR      = "*"
LPAREN    = "("
RPAREN    = ")"
SEMICOLON = ";"

skip:
  WHITESPACE = /[ \t\r\n]+/
