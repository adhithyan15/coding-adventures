              "kind": "speech",
              "text": "Masculine."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "طریقہ (tarīqā) is usually traced, through Persian, to Arabic ṭarīqa, \"a path, a way\"."
            }
          ]
        },
