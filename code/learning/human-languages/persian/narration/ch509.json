          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "tâs is the Persian word for a die. EtymDB's only entry under this spelling is tâs, 'cup', listed without a source, and the origin of the word for a die is not settled."
            }
          ]
        },
