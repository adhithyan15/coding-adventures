          "type": "input",
          "title": "You'll want to know: la reazione",
          "segments": [
            {
              "kind": "speech",
              "text": "la reazione — \"the reaction\"."
            },
            {
              "kind": "speech",
              "text": "La sua reazione mi ha sorpreso. Her reaction surprised me."
            },
            {
              "kind": "speech",
              "text": "Una reazione forte — a strong reaction."
            }
          ]
        },
