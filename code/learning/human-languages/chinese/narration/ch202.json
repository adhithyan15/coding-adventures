      "id": "ZH-C202-saoma",
      "sequence": 15720,
      "title": "sǎomǎ — to scan a code (to pay)",
      "headword": "sǎomǎ",
      "romanization": "sǎomǎ",
      "gloss": "to scan a code (to pay)",
      "script": "chinese",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:7cb15d751ef87696",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Mandarin for to send electronically, then the Mandarin for to get something sent."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: sǎomǎ",
          "segments": [
            {
              "kind": "speech",
              "text": "sǎomǎ — \"to scan a code (to pay)\"."
            },
            {
              "kind": "speech",
              "text": "kěyǐ sǎomǎ ma — Can I pay by scanning the code?"
            },
            {
              "kind": "speech",
              "text": "Its characters come later; for now it is a word for the ear."
            },
            {
              "kind": "speech",
              "text": "Two third tones meet in this word: sǎo is said with a rising tone before mǎ, and the spelling keeps both marks."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "sǎomǎ is built from 扫 'to sweep' and mǎ 'a code', both inherited from Middle Chinese, sawX and maeX (Guangyun, in Baxter's transcription). The pair is recent, and how sweeping came to mean scanning is not settled."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for asking for what I want."
            }
          ]
        },
        {
          "index": 4,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
