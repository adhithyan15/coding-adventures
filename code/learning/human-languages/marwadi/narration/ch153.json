      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:f555fda177109a3f",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: say a cow, a horse and an elephant. (गाय, घोड़ो, हाथी.)"
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ऊंट",
          "segments": [
            {
              "kind": "speech",
              "text": "ऊंट — ū̃ṭ — \"a camel\"."
            },
            {
              "kind": "speech",
              "text": "वो ऊंट है। vo ū̃ṭ hai. — That is a camel."
            },
            {
              "kind": "speech",
              "text": "It opens on a letter you have not written yet: the long ū, standing alone. The next lesson puts it in your hand."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ऊंट (ū̃ṭ) is inherited from Sanskrit uṣṭra, which named a buffalo as well as a camel. CDIAL lists Old Marwari uṭa in the same entry (CDIAL 2387)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "ऊंट is masculine, and takes है like anything you talk about: ऊंट अठै है। (ū̃ṭ aṭhai hai.), the camel is here."
            }
          ]
        },
        {
          "index": 4,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "ū̃ṭ",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *ū̃ṭ*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "वो ऊंट है। — vo ū̃ṭ hai. — That is a camel.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: **वो ऊंट है।** — *vo ū̃ṭ hai.* — That is a camel.]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say a cow, then ū̃ṭ again",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *a cow*, then *ū̃ṭ* again]"
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What does ऊंट (ū̃ṭ) mean? (\"A camel\".) Say it once more."
            },
            {
              "kind": "activity",
              "scored": true,
              "spoken": true,
              "id": "MW-C153-unt-type",
              "prompt": "Say the Marwadi for 'a camel'.",
              "assesses": [
                "MW-LEX-C153-ANIMAL153-01"
              ],
              "responseSeconds": 10,
              "acceptedResponses": [
                "ऊंट",
                "ū̃ṭ",
                "unt"
              ],
              "feedback": {
                "correct": "Right: ऊंट (ū̃ṭ) is 'a camel'.",
                "incorrect": "'a camel' is ऊंट (ū̃ṭ)."
              }
            }
          ]
        }
      ]
    },
    {
      "id": "MW-W45-uu",
      "sequence": 9560,
      "title": "ऊ (ū) — the letter that opens ऊंट (ū̃ṭ)",
      "headword": "ऊ",
      "romanization": "ū",
      "gloss": "ū — the letter that opens ऊंट",
      "script": "devanagari",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "writing-block",
        "script-block",
        "eyes-or-hands-step"
      ],
      "sourceHash": "fnv1a64:5a56aba8fc85cb64",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page",
          "your eyes or your hands for the steps that ask you to read, point, write or gesture"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script you'll notice: ऊ",
          "Guided Practice",
          "Wrap-up Recall"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on, your eyes, for letter shapes on the page and your eyes or your hands for the steps that ask you to read, point, write or gesture. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script you'll notice: ऊ, Guided Practice and Wrap-up Recall."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: write उ once, and name it. Then say हूं (hū̃): its long ū is the sign ू."
            },
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Now say ऊंट (ū̃ṭ), \"a camel\". It opens on the long vowel standing alone, and this lesson puts that letter in your hand."
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script you'll notice: ऊ",
          "segments": [
            {
              "kind": "speech",
              "text": "ऊ — ū, the long u."
            },
            {
              "kind": "speech",
              "text": "It opens ऊंट (ū̃ṭ). It is the letter उ with one more part: a separate loop on its right. उ and ऊ (ū) pair the way the signs ु and ू do, short and long."
            }
          ]
        },
        {
          "index": 2,
          "type": "writing",
          "title": "Writing: ऊ",
          "segments": [
            {
              "kind": "speech",
              "text": "1. curve down and left around the upper bowl, then sweep back through the waist and around the lower loop without lifting."
            },
            {
              "kind": "speech",
              "text": "2. lift at the waist and sweep the right-hand loop up, around, and down-left."
            },
            {
              "kind": "speech",
              "text": "3. lift and draw the top shirorekhā left-to-right."
            },
            {
              "kind": "speech",
              "text": "Pen lifts: 2."
            },
            {
              "kind": "speech",
              "text": "verified modern printed teaching form; everyday handwriting may simplify the curves."
            },
            {
              "kind": "speech",
              "text": "Stroke order is one attested teaching order; hands and teachers vary. Source: Saurmandal, ‘Devanagari ऊ (ū) stroke order.svg’, panels 1–3, Wikimedia Commons, 5 August 2023."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "LOOK",
              "instruction": "at ऊंट (ū̃ṭ) and point at ऊ (ū) inside it",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU LOOK: at **ऊंट** and point at ऊ inside it]"
            },
            {
              "kind": "prompt",
              "action": "TRACE",
              "instruction": "ऊ three times, saying ū as you finish each one",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU TRACE: ऊ three times, saying *ū* as you finish each one]"
            },
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "उ, then ऊ (ū), from memory",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: उ, then ऊ, from memory]"
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "ऊंट (ū̃ṭ) aloud once more",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: **ऊंट** aloud once more]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Which letter is this — ऊ? (ū, the long u.) Which word did it come from? (ऊंट, ū̃ṭ, \"a camel\".)"
            },
            {
              "kind": "activity",
              "scored": true,
              "spoken": false,
              "id": "MW-W45-uu-recall",
              "prompt": "Write the letter that opens ū̃ṭ (a camel).",
              "assesses": [
                "MW-SCRIPT-C153-UU-01"
              ],
              "responseSeconds": 10,
              "acceptedResponses": [
                "ऊ"
              ],
              "feedback": {
                "correct": "Yes: ऊ, from ū̃ṭ.",
                "incorrect": "The letter is ऊ. Find it in ऊंट and write it once more."
              }
            }
          ]
        }
      ]
    },
