# Perl 5.004_57 (1998-02-03) plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: unsupported Perl 5.004_57 syntax is rejected.
# Evidence: https://mirrors.develooper.com/perl/historical-perl/perl-5.004_57.tar.gz
# Archive SHA-256: 86a35b731294a6ba7d161af68074a7be7fdfc9815a1ccad457fa7519eda60dcb
# Its perly.y is byte-identical to 5.004_56; BEGIN/END/INIT remains outside this subset.
# Only arithmetic precedence, grouping, and print are represented here.

program         = print_statement { print_statement } ;
print_statement = PRINT LPAREN expr RPAREN SEMICOLON ;
expr            = term { ( PLUS | MINUS ) term } ;
term            = unary { STAR unary } ;
unary           = MINUS unary | atom ;
atom            = INT | LPAREN expr RPAREN ;
