# Parser grammar for moslayout — Component Layout Language
# @version 1
#
# A .mll file declares the structural layout of exactly one component.
# It wires slot and emit names from the .mil interface to a fixed vocabulary
# of layout primitives (Box, Row, Column, Text, Image, Spacer, Grid).
#
# Grammar notation:
#   |      alternation
#   { }    repetition (zero or more)
#   [ ]    optional (zero or one)
#   ( )    grouping
# UPPERCASE = token reference, lowercase = rule reference
#
# ============================================================================
# Design decisions
# ============================================================================
#
# 1. The grammar is kept deliberately uniform: every node has the same shape
#    (NAME, optional part, optional props, optional children).  The semantic
#    compiler layer validates that Grid nodes have no children, that Text nodes
#    reference a text-typed slot, etc.
#
# 2. Only three keywords are used: `layout`, `slot`, `emit`.  All primitive
#    names and property-value keywords are NAME tokens so they do not conflict
#    with user-chosen slot/emit names.
#
# 3. The grammar is LL(1).  Each optional section is distinguishable by its
#    first token: `[` for a part name, `(` for properties, `{` for children.
#
# ============================================================================
# Top-level structure
# ============================================================================
# A .mll file is exactly one layout definition.

file = layout_def ;

# ============================================================================
# Layout definition
# ============================================================================
# layout ComponentName { node* }
#
# Example:
#   layout Grid {
#     Column [ root ] {
#       Grid [ cell-grid ] (
#         headers: slot: column-headers ,
#         rows:    slot: viewport-rows
#       )
#     }
#   }

layout_def = KEYWORD NAME LBRACE { node } RBRACE ;

# ============================================================================
# Layout nodes
# ============================================================================
# Every node has:
#   - a type name — either an unqualified NAME (kernel primitive or same-file
#     local component reference) or a qualified `pkg::P::C` reference (UI34
#     §2) naming component `C` exported by package `P`.
#   - an optional part name in [ … ] (for mosstyle styling)
#   - optional structural properties in ( … ) (direction, align, slot bindings)
#   - optional children in { … } (container nodes only; leaves omit this)
#
# The semantic layer validates type-specific constraints:
#   - Grid nodes may have props but no children (it is a self-contained leaf)
#   - Text / Image nodes require a slot binding prop; they have no children
#   - Column / Row / Box nodes are containers (props are direction, align, etc.)
#   - Spacer has no children and only optional grow prop
#
# LL(1) note: `node` decides between the unqualified and qualified branches
# in `qualified_name` by looking at one token — `KEYWORD(pkg)` selects the
# qualified branch; any other `NAME` selects the unqualified branch.

node           = qualified_name [ part_name ]
                                [ LPAREN prop_list RPAREN ]
                                [ LBRACE { node } RBRACE ] ;

# UI34 §3.2 — a node's type name is either a bare NAME (the legacy form)
# or a fully-qualified `pkg::P::C` reference.  The two NAMEs in the
# qualified branch are validated by the compiler, not the grammar: the
# package name must be kebab-case (matching `mosaic-package-manifest`'s
# `package.name` shape) and the component name must be PascalCase.
qualified_name = NAME
               | KEYWORD DOUBLE_COLON NAME DOUBLE_COLON NAME ;

# ============================================================================
# Part name
# ============================================================================
# An optional label used by mosstyle to target this node for styling.
#
#   [ cell-grid ]
#   [ header-row ]
#   [ root ]

part_name = LBRACKET NAME RBRACKET ;

# ============================================================================
# Property list
# ============================================================================
# Comma-separated property assignments inside ( … ).
#
# Every property is: name : value
#
# Values come in four forms:
#   1.  KEYWORD COLON NAME   — a slot or emit binding
#          slot: column-headers
#          emit: onNavigate
#   2.  NAME                  — a keyword value or property name as value
#          row   (direction: row)
#          true  (focusable: true)
#          center (align: center)
#   3.  NUMBER               — a numeric value
#          1.5  (grow: 1.5)
#   4.  STRING               — a double-quoted string literal
#          "Enter formula"   (placeholder: "Enter formula")
#          "system-ui"       (font: "system-ui")
#
# LL(1) disambiguation:
#   - If prop_value starts with KEYWORD → slot/emit binding
#   - If prop_value starts with NAME    → keyword value
#   - If prop_value starts with NUMBER  → numeric value
#   - If prop_value starts with STRING  → string literal

prop_list = prop { COMMA prop } ;

# Two forms are supported:
#   1.  NAME COLON prop_value     — named prop: direction: row, headers: slot: column-headers
#   2.  KEYWORD COLON NAME        — shorthand slot/emit binding: slot: label, emit: onNavigate
#
# The shorthand is syntactic sugar for single-slot leaf nodes (Text, Image)
# where there is only one meaningful binding and naming it explicitly is noise.
# Semantically it is equivalent to: content: slot: label (for Text) or
# source: slot: avatar-url (for Image).
#
# LL(1): KEYWORD and NAME are disjoint token types so the two alternatives
# are unambiguous with a one-token look-ahead.

prop = NAME    COLON prop_value
     | KEYWORD COLON NAME ;

# ============================================================================
# Expressions (UI29 §3.3 — U29-G3)
# ============================================================================
# `prop_value` is an expression. Expressions cover:
#   • The four legacy prop-value forms (slot ref, NAME, NUMBER, STRING)
#     because every one of them is a valid `primary`.
#   • Comparison and logical combinations for For `each:` and If `when:`
#     (e.g. `r == editRow`, `editing && !readonly`, `cols.visible`).
#   • Field access (`row.cells`) and index access (`row[c]`).
#
# Deliberately excluded by UI29 §3.3 (do not add without a spec amendment):
#   • Arithmetic (`+ - * /`)
#   • String concatenation
#   • Ternary (`? :`)
#   • Function / method calls
#
# Operator precedence (low → high):
#   or_expr   ||
#   and_expr  &&
#   eq_expr   == !=
#   rel_expr  <  <=  >  >=
#   unary     !
#   postfix   . []
#   primary   slot ref | NAME | NUMBER | STRING | ( expr )
#
# The grammar is LL(1) because each level's first-token set is disjoint
# from the operator token that starts the next-higher level.

prop_value = expr ;

expr     = or_expr ;
or_expr  = and_expr { OR  and_expr } ;
and_expr = eq_expr  { AND eq_expr  } ;
eq_expr  = rel_expr [ ( EQ | NEQ ) rel_expr ] ;
rel_expr = unary    [ ( LT | LE | GT | GE ) unary ] ;
unary    = NOT unary | postfix ;
postfix  = primary { DOT NAME | LBRACKET expr RBRACKET } ;
primary  = KEYWORD COLON NAME
         | NAME
         | NUMBER
         | STRING
         | LPAREN expr RPAREN ;
