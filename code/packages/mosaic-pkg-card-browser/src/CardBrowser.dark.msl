// CardBrowser.dark.msl - dark card-browser theme.

style CardBrowser {
  part card-browser {
    background    : "#162033" ;
    border-width  : 1 ;
    border-color  : "#334155" ;
    border-radius : 8 ;
    padding       : 14 ;
  }

  part browser-title {
    color          : "#f8fafc" ;
    font-size      : 20 ;
    font-weight    : 800 ;
    padding-bottom : 10 ;
  }

  part browser-search-row {
    padding-bottom : 10 ;
  }

  part query-column {
    padding : 2 ;
  }

  part query-label {
    color       : "#93c5fd" ;
    font-size   : 11 ;
    font-weight : 700 ;
  }

  part search-button {
    background    : "#2563eb" ;
    border-width  : 1 ;
    border-color  : "#1d4ed8" ;
    border-radius : 6 ;
    color         : "#ffffff" ;
    font-weight   : 700 ;
    padding       : 8 ;
  }

  part results-label {
    color       : "#c4b5fd" ;
    font-size   : 11 ;
    font-weight : 700 ;
  }

  part results-summary {
    color          : "#e2e8f0" ;
    font-size      : 14 ;
    padding-bottom : 8 ;
  }

  part browser-actions {
    padding-top : 10 ;
  }

  part browser-tag-row {
    padding-top    : 10 ;
    padding-bottom : 2 ;
  }

  part tag-edit-column {
    padding : 2 ;
  }

  part tag-edit-label {
    color       : "#86efac" ;
    font-size   : 11 ;
    font-weight : 700 ;
  }

  part tag-edit-input {
    background    : "#0f172a" ;
    border-width  : 1 ;
    border-color  : "#334155" ;
    border-radius : 6 ;
    color         : "#f8fafc" ;
    padding       : 8 ;
  }

  part add-tag-button {
    background    : "#15803d" ;
    border-width  : 1 ;
    border-color  : "#166534" ;
    border-radius : 6 ;
    color         : "#f8fafc" ;
    font-weight   : 700 ;
    padding       : 8 ;
  }

  part remove-tag-button {
    background    : "#7f1d1d" ;
    border-width  : 1 ;
    border-color  : "#991b1b" ;
    border-radius : 6 ;
    color         : "#f8fafc" ;
    font-weight   : 700 ;
    padding       : 8 ;
  }

  part open-button {
    background    : "#334155" ;
    border-width  : 1 ;
    border-color  : "#64748b" ;
    border-radius : 6 ;
    color         : "#f8fafc" ;
    font-weight   : 700 ;
    padding       : 8 ;
  }

  part edit-button {
    background    : "#0f766e" ;
    border-width  : 1 ;
    border-color  : "#134e4a" ;
    border-radius : 6 ;
    color         : "#f8fafc" ;
    font-weight   : 700 ;
    padding       : 8 ;
  }

  part suspend-button {
    background    : "#b45309" ;
    border-width  : 1 ;
    border-color  : "#78350f" ;
    border-radius : 6 ;
    color         : "#f8fafc" ;
    font-weight   : 700 ;
    padding       : 8 ;
  }

  part mark-button {
    background    : "#be123c" ;
    border-width  : 1 ;
    border-color  : "#881337" ;
    border-radius : 6 ;
    color         : "#f8fafc" ;
    font-weight   : 700 ;
    padding       : 8 ;
  }
}
