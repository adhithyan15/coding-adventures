            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Urdu for shorts, then the Urdu for a raincoat."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: پپیتا",
          "segments": [
            {
              "kind": "speech",
              "text": "پپیتا — papītā — \"a papaya\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "The origin of پپیتا (papītā) is uncertain. It is usually linked with papaya, a Caribbean word that Spanish and Portuguese sailors carried round the world; CDIAL has no entry for it."
            }
          ]
        },
        {
