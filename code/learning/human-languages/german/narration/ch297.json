          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Einschulung is built on Schule \"school\", from Old High German scuola, which came from Latin schola (EtymDB): being taken into school."
            }
          ]
        },
