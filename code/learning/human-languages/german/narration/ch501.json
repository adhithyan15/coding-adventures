        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: das Brettspiel",
          "segments": [
            {
              "kind": "speech",
              "text": "das Brettspiel — \"board game\"."
            },
            {
              "kind": "speech",
              "text": "Am Wochenende spielen wir gern Brettspiele. At the weekend we like playing board games."
            },
            {
              "kind": "speech",
              "text": "Plural: die Brettspiele."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Brettspiel is built on Brett \"board, plank\", inherited from Middle High German bret, and Spiel \"game\", from Old High German spil (EtymDB)."
            }
          ]
        },
        {
          "index": 3,
