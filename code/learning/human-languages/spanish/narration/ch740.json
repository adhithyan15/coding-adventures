          "title": "You'll want to know: las náuseas",
          "segments": [
            {
              "kind": "speech",
              "text": "las náuseas — \"nausea, sickness\"."
            },
            {
              "kind": "speech",
              "text": "El barco me da náuseas. Boats make me feel sick."
            },
            {
              "kind": "speech",
              "text": "Usually plural: tener náuseas, dar náuseas."
            }
          ]
        },
