{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coding-adventures.dev/schemas/warrant-lane-consumers-v1.json",
  "title": "Consumers of the ct-compare Warrant corpus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "corpus",
    "consumer_count",
    "active_consumer_count",
    "consumers"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "profile": { "const": "warrant-lane-consumers-v1" },
    "corpus": { "const": "code/specs/fixtures/ct-compare-warrant-v1/corpus.json" },
    "consumer_count": { "type": "integer", "minimum": 1, "maximum": 18 },
    "active_consumer_count": { "type": "integer", "minimum": 0, "maximum": 18 },
    "consumers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 18,
      "items": { "$ref": "#/$defs/consumer" }
    }
  },
  "$defs": {
    "package_path": {
      "type": "string",
      "pattern": "^code/packages/[a-z]+/[a-z0-9-]+$"
    },
    "file_path": {
      "type": "string",
      "pattern": "^code/packages/[a-z]+/[a-z0-9-]+/(?:[A-Za-z0-9_@+-][A-Za-z0-9_.@+-]*(?:/[A-Za-z0-9_@+-][A-Za-z0-9_.@+-]*)*)$"
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane",
        "package",
        "module",
        "package_root",
        "binding",
        "runner_entry",
        "evidence_manifest",
        "build_files",
        "status"
      ],
      "properties": {
        "lane": { "type": "string", "pattern": "^[a-z]+$" },
        "package": { "type": "string", "pattern": "^[a-z]+/[a-z0-9-]+$" },
        "module": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "package_root": { "$ref": "#/$defs/package_path" },
        "binding": { "$ref": "#/$defs/file_path" },
        "runner_entry": { "$ref": "#/$defs/file_path" },
        "evidence_manifest": { "$ref": "#/$defs/file_path" },
        "build_files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/file_path" }
        },
        "status": { "enum": ["planned", "active"] }
      }
    }
  }
}
