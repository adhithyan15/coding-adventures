        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: der Torwart",
          "segments": [
            {
              "kind": "speech",
              "text": "der Torwart — \"goalkeeper\"."
            },
            {
              "kind": "speech",
              "text": "Der Torwart hat den Ball sicher gefangen. The goalkeeper caught the ball safely."
            },
            {
              "kind": "speech",
              "text": "Plural: die Torwarte. Also der Torhüter."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Torwart is built on Tor \"gate, goal\" (EtymDB) and Wart \"keeper\", from warten, inherited from Old High German wartēn \"to watch, to look after\" (EtymDB)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
