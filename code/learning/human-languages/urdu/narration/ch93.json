            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Urdu for half past, then the Urdu for a quarter past."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: پونے",
          "segments": [
            {
              "kind": "speech",
              "text": "پونے — paune — \"a quarter to (less a quarter)\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "پونے (paune) is a tadbhava, a word inherited and reshaped by sound change. It comes from padūna, \"less by a quarter\", a form CDIAL reconstructs from its descendants (CDIAL 7765)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
