  "lessons": [
    {
      "id": "JA-C09-sumimasen",
      "sequence": 450,
      "title": "すみません (sumimasen) — open the repair gently",
      "headword": "すみません",
      "romanization": "sumimasen",
      "gloss": "excuse me; I am sorry",
      "script": "japanese",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:729268f3906c3c30",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 8,
              "perItem": false,
              "source": "[PAUSE 8s]"
            },
            {
              "kind": "speech",
              "text": "Say the farewell from the last chapter once. Now imagine that the other person has spoken and you missed it. Do not guess; open a repair."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know",
          "segments": [
            {
              "kind": "speech",
              "text": "すみません (sumimasen)。 — su-mi-ma-se-n — excuse me; I am sorry."
            },
            {
              "kind": "speech",
              "text": "Five morae, each given room. This polite expression can apologise, attract attention, or soften the request that follows. Here it means: “Excuse me — I need help with what was just said.”"
            },
            {
              "kind": "speech",
              "text": "Its shape is useful, not a literal translation burden. It is related to sumu, “to be settled or finished,” in a polite negative form: the small social debt is not yet settled. Keep the practical job first."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "HEAR",
              "instruction": "sumimasen becomes point to repair, not farewell",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU HEAR: *sumimasen* → point to **repair**, not **farewell**]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "su | mi | ma | se | n",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *su | mi | ma | se | n*]"
            },
            {
              "kind": "repeat",
              "times": 2,
              "source": "[REPEAT x2]"
            },
            {
              "kind": "prompt",
              "action": "CHOOSE",
              "instruction": "you missed a word becomes すみません (sumimasen)",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU CHOOSE: you missed a word → **すみません**]"
            },
            {
              "kind": "speech",
              "text": "The Japanese spelling is exposure for now. The next two lessons isolate its two new signs before either becomes load-bearing."
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "speech",
              "text": "Say it once, then stop. The request itself comes later."
            },
            {
              "kind": "speech",
              "text": "Source: Japan Foundation Irodori Starter lesson 2, pp. 1–3."
            },
            {
              "kind": "activity",
              "scored": true,
              "id": "JA-C09-sumimasen-job",
              "prompt": "What polite Japanese opener tells a speaker that you need to repair the exchange?",
              "assesses": [
                "JA-LEX-SUMIMASEN"
              ],
              "responseSeconds": 10,
              "acceptedResponses": [
                "すみません",
                "sumimasen",
                "すみません。"
              ],
              "feedback": {
                "correct": "Yes: すみません opens the repair politely.",
                "incorrect": "Use すみません — su-mi-ma-se-n."
              }
            }
          ]
        }
      ]
    },
    {
      "id": "JA-W09-mi",
      "sequence": 460,
      "title": "み (mi) — one looped bridge",
      "headword": "み",
      "romanization": "mi",
      "gloss": "the hiragana sign for the mora mi",
      "script": "japanese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:3ab9b51bad9e5dab",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Script — the shape"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now — leave the section called Script — the shape until you have stopped, and I will say so again when we reach it."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 10,
              "perItem": false,
              "source": "[PAUSE 10s]"
            },
            {
              "kind": "speech",
              "text": "Say sumimasen once, then write known ま. The new sign shares the m opening but carries a different vowel."
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — the shape",
          "segments": [
            {
              "kind": "speech",
              "text": "み — mi."
            },
            {
              "kind": "speech",
              "text": "Write it in two strokes. First make the bent left body, ending in a small turn. Then begin at the upper right, sweep down through the middle, and finish by lifting to the right. Say mi only when the second stroke ends."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "speech",
              "text": "Trace み (mi) once with a finger."
            },
            {
              "kind": "speech",
              "text": "Trace it once with a pencil."
            },
            {
              "kind": "speech",
              "text": "Point to み inside すみません (sumimasen); do not decode the other signs yet."
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "speech",
              "text": "Cover the model and air-write the two strokes once."
            },
            {
              "kind": "speech",
              "text": "Source: Unicode Hiragana chart; stroke order per Hitsujun Shido no Tebiki (Japanese Ministry of Education, 1958)."
            },
            {
              "kind": "activity",
              "scored": true,
              "id": "JA-W09-mi-select",
              "prompt": "Which sign carries mi?",
              "assesses": [
                "JA-SCRIPT-MI-01"
              ],
              "responseSeconds": 8,
              "acceptedResponses": [
                "み",
                "hiragana mi"
              ],
              "feedback": {
                "correct": "Right: み carries mi.",
                "incorrect": "Write み, the two-stroke looped bridge."
              }
            }
          ]
        }
      ]
    },
    {
      "id": "JA-W09-me",
      "sequence": 470,
      "title": "め (me) — cross, loop, release",
      "headword": "め",
      "romanization": "me",
      "gloss": "the hiragana sign for the mora me",
      "script": "japanese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:be960949aa91fd3a",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Script — the shape"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now — leave the section called Script — the shape until you have stopped, and I will say so again when we reach it."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 10,
              "perItem": false,
              "source": "[PAUSE 10s]"
            },
            {
              "kind": "speech",
              "text": "Find み in すみません (sumimasen), then say the five-mora repair opener."
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — the shape",
          "segments": [
            {
              "kind": "speech",
              "text": "め — me."
            },
            {
              "kind": "speech",
              "text": "Two strokes. The short first stroke leans down to the right. The longer second stroke crosses it, curves into an open loop, and releases at the lower right. Keep that final opening visible; do not close it into a circle."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "COPY",
              "instruction": "め (me) once with the model visible",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COPY: **め** once with the model visible]"
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "point to み, then め and say mi, me",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: point to **み**, then **め** and say *mi, me*]"
            },
            {
              "kind": "prompt",
              "action": "FIND",
              "instruction": "circle め (me) inside すみません (sumimasen)",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU FIND: circle **め** inside **すみません**]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "speech",
              "text": "Write め once more while saying me."
            },
            {
              "kind": "speech",
              "text": "Source: Unicode Hiragana chart; stroke order per Hitsujun Shido no Tebiki (Japanese Ministry of Education, 1958)."
            },
            {
              "kind": "activity",
              "scored": true,
              "id": "JA-W09-me-strokes",
              "prompt": "How many strokes does め (me) have?",
              "assesses": [
                "JA-SCRIPT-ME-01"
              ],
              "responseSeconds": 8,
              "acceptedResponses": [
                "2",
                "two",
                "2 strokes",
                "two strokes"
              ],
              "feedback": {
                "correct": "Two: a short diagonal, then the crossing open loop.",
                "incorrect": "Two strokes; the long second stroke makes the open loop."
              }
            }
          ]
        }
      ]
    },
    {
      "id": "JA-C09-yoku",
      "sequence": 480,
      "title": "よく (yoku) — how fully?",
      "headword": "よく",
      "romanization": "yoku",
      "gloss": "well; fully, as an adverb",
      "script": "japanese",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:a93ca12a70a8949d",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 12,
              "perItem": false,
              "source": "[PAUSE 12s]"
            },
            {
              "kind": "speech",
              "text": "Say sumimasen. Point to み and め (me) inside it."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know",
          "segments": [
            {
              "kind": "speech",
              "text": "よく (yoku) — yo-ku — well; fully."
            },
            {
              "kind": "speech",
              "text": "Two morae. Yoku is the adverbial partner of yoi, “good.” In the coming line, it says that understanding did not happen well or fully. It does not itself mean “understand.”"
            },
            {
              "kind": "speech",
              "text": "You already write よ. Treat く (ku) as visible support for now; its own tiny writing lesson follows."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "HEAR",
              "instruction": "yoku becomes choose well/fully",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU HEAR: *yoku* → choose **well/fully**]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "yo | ku",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *yo | ku*]"
            },
            {
              "kind": "repeat",
              "times": 2,
              "source": "[REPEAT x2]"
            },
            {
              "kind": "prompt",
              "action": "POINT",
              "instruction": "known よ, then supported く (ku)",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU POINT: known **よ**, then supported **く**]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "speech",
              "text": "Say yoku once without adding the rest of the sentence."
            },
            {
              "kind": "speech",
              "text": "Source: Japan Foundation Irodori Starter lesson 2, p. 1."
            },
            {
              "kind": "activity",
              "scored": true,
              "id": "JA-C09-yoku-meaning",
              "prompt": "In the repair line, what does yoku measure?",
              "assesses": [
                "JA-LEX-YOKU"
              ],
              "responseSeconds": 10,
              "acceptedResponses": [
                "how well or fully understanding happened",
                "well",
                "fully"
              ],
              "feedback": {
                "correct": "Right: yoku means well or fully here.",
                "incorrect": "Yoku measures degree: well or fully."
              }
            }
          ]
        }
      ]
    },
    {
      "id": "JA-W09-ku",
      "sequence": 490,
      "title": "く (ku) — one angled stroke",
      "headword": "く",
      "romanization": "ku",
      "gloss": "the hiragana sign for the mora ku",
      "script": "japanese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block",
        "sight-cue"
      ],
      "sourceHash": "fnv1a64:bf3f973a5241e926",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page",
          "your eyes, because the lesson points at something written down"
        ],
        "waitUntilStopped": [
          "Script — the shape"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on, your eyes, for letter shapes on the page and your eyes, because the lesson points at something written down. You can listen to everything else now — leave the section called Script — the shape until you have stopped, and I will say so again when we reach it."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 8,
              "perItem": false,
              "source": "[PAUSE 8s]"
            },
            {
              "kind": "speech",
              "text": "Write known よ and say yoku."
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — the shape",
          "segments": [
            {
              "kind": "speech",
              "text": "く — ku."
            },
            {
              "kind": "speech",
              "text": "One stroke. Begin high on the right, sweep down-left to the point, then turn and sweep down-right. Keep it narrow and open. The turn is part of the same stroke."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "speech",
              "text": "Look at く (ku) for five seconds."
            },
            {
              "kind": "speech",
              "text": "Hide it and write the one angled stroke."
            },
            {
              "kind": "speech",
              "text": "Reveal, check, then join known よ + く becomes よく (yoku)."
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "speech",
              "text": "Read よく (yoku) once without romanization."
            },
            {
              "kind": "speech",
              "text": "Source: Unicode Hiragana chart; stroke order per Hitsujun Shido no Tebiki (Japanese Ministry of Education, 1958)."
            },
            {
              "kind": "activity",
              "scored": true,
              "id": "JA-W09-ku-write",
              "prompt": "Write the one-stroke hiragana sign for ku.",
              "assesses": [
                "JA-SCRIPT-KU-01"
              ],
              "responseSeconds": 10,
              "acceptedResponses": [
                "く",
                "hiragana ku"
              ],
              "feedback": {
                "correct": "Yes: く is one continuous angled stroke.",
                "incorrect": "Write く: down-left, turn, down-right."
              }
            }
          ]
        }
      ]
    },
    {
      "id": "JA-C09-wakarimasen",
      "sequence": 500,
      "title": "わかりません (wakarimasen) — I do not understand",
      "headword": "わかりません",
      "romanization": "wakarimasen",
      "gloss": "I do not understand",
      "script": "japanese",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:17db2713d923bb2c",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 12,
              "perItem": false,
              "source": "[PAUSE 12s]"
            },
            {
              "kind": "speech",
              "text": "Read よく (yoku), then open a repair with sumimasen."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know",
          "segments": [
            {
              "kind": "speech",
              "text": "わかりません (wakarimasen)。 — wa-ka-ri-ma-se-n — I do not understand."
            },
            {
              "kind": "speech",
              "text": "Six morae. The wakari- part carries “understand”; polite -masen makes the predicate negative. Japanese often leaves out “I” when the situation already makes the experiencer obvious."
            },
            {
              "kind": "speech",
              "text": "Combine the two known pieces only in sound for now:"
            },
            {
              "kind": "speech",
              "text": "yoku wakarimasen — I do not understand well / fully."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "HEAR",
              "instruction": "wakarimasen becomes choose does not understand",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU HEAR: *wakarimasen* → choose **does not understand**]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "wa | ka | ri | ma | se | n",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *wa | ka | ri | ma | se | n*]"
            },
            {
              "kind": "prompt",
              "action": "REPAIR",
              "instruction": "yoku wakarimasen",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU REPAIR: *yoku wakarimasen*]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "speech",
              "text": "Do not add an invented pronoun. The short Japanese line is complete here."
            },
            {
              "kind": "speech",
              "text": "Source: Japan Foundation Irodori Starter lesson 2, pp. 1–2."
            },
            {
              "kind": "activity",
              "scored": true,
              "id": "JA-C09-wakarimasen-response",
              "prompt": "Say politely: I do not understand.",
              "assesses": [
                "JA-LEX-WAKARIMASEN"
              ],
              "responseSeconds": 12,
              "acceptedResponses": [
                "わかりません",
                "wakarimasen",
                "わかりません。"
              ],
              "feedback": {
                "correct": "Right: わかりません is the polite negative response.",
                "incorrect": "Use わかりません — wa-ka-ri-ma-se-n."
              }
            }
          ]
        }
      ]
    },
    {
      "id": "JA-W09-do",
      "sequence": 510,
      "title": "ど (do) — voice a sign you already own",
      "headword": "ど",
      "romanization": "do",
      "gloss": "the hiragana sign と voiced with dakuten to carry the mora do",
      "script": "japanese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:07b83e96053f7d1c",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Script — carry the voicing mark"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now — leave the section called Script — carry the voicing mark until you have stopped, and I will say so again when we reach it."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 12,
              "perItem": false,
              "source": "[PAUSE 12s]"
            },
            {
              "kind": "speech",
              "text": "Write と. Add the two-stroke dakuten beside it. Say wakarimasen once as the reason a repetition may be needed."
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — carry the voicing mark",
          "segments": [
            {
              "kind": "speech",
              "text": "と to + ゛ becomes ど do."
            },
            {
              "kind": "speech",
              "text": "The base shape does not change. Write と first, then add the two short dakuten strokes at the upper right. The mark voices the opening consonant: t becomes d while the vowel stays o."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "speech",
              "text": "Copy と becomes ど (do) once."
            },
            {
              "kind": "speech",
              "text": "Cover the model and write the voiced sign from the heard mora do."
            },
            {
              "kind": "speech",
