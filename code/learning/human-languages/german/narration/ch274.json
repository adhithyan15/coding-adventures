          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Quelle is inherited from Old High German quella, which EtymDB traces to Proto-Germanic kwellōn \"well, spring\": where water, and later news, comes from."
            }
          ]
        },
