{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coding-adventures.dev/schemas/se04-xchacha20-poly1305-v1.json",
  "title": "SE04 XChaCha20-Poly1305 v1 cross-language fixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "authentication_failure",
    "hchacha20_cases",
    "xchacha20_cases",
    "aead_cases",
    "mutations"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "profile": { "const": "se04-xchacha20-poly1305-v1" },
    "authentication_failure": { "const": "authentication_failed" },
    "hchacha20_cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/hchacha20_case" }
    },
    "xchacha20_cases": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/xchacha20_case" }
    },
    "aead_cases": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/aead_case" }
    },
    "mutations": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/mutation" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "hex": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{2})*$"
    },
    "key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonce16": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "nonce24": {
      "type": "string",
      "pattern": "^[0-9a-f]{48}$"
    },
    "tag": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "hchacha20_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "key_hex", "nonce_hex", "subkey_hex"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "key_hex": { "$ref": "#/$defs/key" },
        "nonce_hex": { "$ref": "#/$defs/nonce16" },
        "subkey_hex": { "$ref": "#/$defs/key" }
      }
    },
    "xchacha20_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "counter", "key_hex", "nonce_hex", "input_hex", "output_hex"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "counter": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "key_hex": { "$ref": "#/$defs/key" },
        "nonce_hex": { "$ref": "#/$defs/nonce24" },
        "input_hex": { "$ref": "#/$defs/hex" },
        "output_hex": { "$ref": "#/$defs/hex" }
      }
    },
    "aead_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "key_hex", "nonce_hex", "aad_hex", "plaintext_hex", "ciphertext_hex", "tag_hex"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "key_hex": { "$ref": "#/$defs/key" },
        "nonce_hex": { "$ref": "#/$defs/nonce24" },
        "aad_hex": { "$ref": "#/$defs/hex" },
        "plaintext_hex": { "$ref": "#/$defs/hex" },
        "ciphertext_hex": { "$ref": "#/$defs/hex" },
        "tag_hex": { "$ref": "#/$defs/tag" }
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_case", "target", "byte_indices", "xor_hex"],
      "properties": {
        "source_case": { "$ref": "#/$defs/id" },
        "target": { "enum": ["ciphertext", "key", "nonce", "aad", "tag"] },
        "byte_indices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0 }
        },
        "xor_hex": { "type": "string", "pattern": "^[0-9a-f]{2}$" }
      }
    }
  }
}
