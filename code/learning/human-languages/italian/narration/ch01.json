  "lessons": [
    {
      "id": "IT-C01-ciao",
      "sequence": 10,
      "title": "ciao — \"hi,\" and the word that means \"I am your slave\"",
      "headword": "ciao",
      "romanization": "ciao",
      "gloss": "hi / bye (informal)",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:6ca3f1aa607f1ca3",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The most famous \"hello\" in the world — and it hides an astonishing history."
            }
          ]
        },
        {
          "index": 1,
          "type": "pronunciation",
          "title": "Sounds you'll need",
          "segments": [
            {
              "kind": "speech",
              "text": "ciao = CHOW: ci before a vowel is the ch of church; -ao is one gliding syllable."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ciao began as the Venetian greeting s-ciào (vostro) — \"[I am your] slave / servant,\" a humble \"at your service.\" That s-ciào is Venetian for schiavo (\"slave\") from Medieval Latin sclavus. The very same word is English slave — and, astonishingly, Slav: medieval slaves were so often Slavic captives that the ethnic name became the word for \"slave\" across Europe. So every casual ciao is a fossil of \"I am your servant.\""
            }
          ]
        },
        {
          "index": 3,
          "type": "culture-pragmatics",
          "title": "Why it's said this way",
          "segments": [
            {
              "kind": "speech",
              "text": "ciao is informal, and works both coming and going (\"hi\" and \"bye\") — for friends, family, peers. To someone you'd show respect, or on a first meeting, you reach for buongiorno (coming soon). Doubled, ciao ciao, it's a breezy \"bye-bye.\""
            }
          ]
        },
        {
          "index": 4,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "\"ciao\" (CHOW)",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: \"ciao\" (*CHOW*)]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "its buried meaning — \"I am your slave/servant\"",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: its buried meaning — \"I am your slave/servant\"]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "the English cousins — slave, Slav",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: the English cousins — *slave*, *Slav*]"
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What did ciao literally mean, and what two English words share its root? (\"I am your slave\"; slave and Slav, from Latin sclavus.)"
            }
          ]
        }
      ]
    },
    {
      "id": "IT-C01-buono",
      "sequence": 20,
      "title": "buono / buon — \"good\"",
      "headword": "buono / buon",
      "romanization": "buono / buon",
      "gloss": "good (adjective)",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:2db5c41d4c4ee96c",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word that starts buongiorno, buonasera, buonanotte. Learn it alone first."
            }
          ]
        },
        {
          "index": 1,
          "type": "pronunciation",
          "title": "Sounds you'll need",
          "segments": [
            {
              "kind": "speech",
              "text": "buono = BWOH-no (the uo is a glide). Before a masculine noun it clips to buon (bwon) — buon giorno."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "buono (\"good\") from Latin bonus becomes English bonus, bonanza, bonbon, and (via French) bounty. Spanish, another daughter of Latin, made bonus into bueno; Italian kept it closer, buono."
            }
          ]
        },
        {
          "index": 3,
          "type": "grammar",
          "title": "Grammar Lens: it agrees with the noun",
          "segments": [
            {
              "kind": "speech",
              "text": "buono changes to match its noun's gender and number: buono (m.), buona (f.), buoni / buone (pl.) — Latin's legacy across the Romance family. Before a masculine noun it drops the -o to buon (buon giorno)."
            }
          ]
        },
        {
          "index": 4,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "\"buono\", then clipped \"buon\"",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: \"buono\", then clipped \"buon\"]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "English cousins — bonus, bonanza",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: English cousins — *bonus*, *bonanza*]"
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What Latin word is buono from, and why does it become buon in buon giorno? (bonus; it drops -o before a masculine noun.)"
            }
          ]
        }
      ]
    },
    {
      "id": "IT-C01-il-la-lo",
      "sequence": 30,
      "title": "il / la / lo — \"the,\" and the gender it carries",
      "headword": "il / la / lo",
      "romanization": "il / la / lo",
      "gloss": "the (masculine / feminine)",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:4e47245ae0ffffe4",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before your first noun: the words for \"the.\" Italian splits \"the\" by gender — a habit inherited from Latin."
            }
          ]
        },
        {
          "index": 1,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "il and lo (masculine \"the\") and la (feminine) from Latin ille / illa (\"that one\"), the pointing word worn down to \"the.\" The same ille/illa gave Spanish el/la and French le/la — and also Italian lui / lei (\"he/she\"). (English \"the\" is Germanic, unrelated.)"
            }
          ]
        },
        {
          "index": 2,
          "type": "grammar",
          "title": "Grammar Lens: gender, and two masculine \"the\"s",
          "segments": [
            {
              "kind": "speech",
              "text": "Every Italian noun is masculine or feminine — Latin's three genders (the neuter folding into the masculine) collapsed to two. Learn each noun with its article. Italian has two masculine articles: lo before tricky clusters (lo studente, lo zio), il everywhere else (il giorno); feminine is always la. Meet il at your first noun, next."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "\"il\", \"la\", \"lo\"",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: \"il\", \"la\", \"lo\"]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "their source — Latin ille / illa",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: their source — Latin *ille / illa*]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What Latin word gave il / lo / la, and how many genders does Italian have? (ille / illa; two — masculine and feminine.)"
            }
          ]
        }
      ]
    },
    {
      "id": "IT-C01-giorno",
      "sequence": 40,
      "title": "giorno — \"day,\" and the road to English journey",
      "headword": "giorno",
      "romanization": "giorno",
      "gloss": "day (masculine)",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:41d5c0fe0be4d53c",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Your first noun — masculine, and a cousin of journal and journey."
            }
          ]
        },
        {
          "index": 1,
          "type": "pronunciation",
          "title": "Sounds you'll need",
          "segments": [
            {
              "kind": "speech",
              "text": "gi = the j of jam; giorno = JOR-no."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "il giorno (masc.) from Latin diurnum (\"daytime\"), from dies (\"day\"). That detour through diurnum is why giorno looks nothing like dies:"
            },
            {
              "kind": "speech",
              "text": "via diurnum: journal, adjourn, sojourn, journey (a day's travel);"
            },
            {
              "kind": "speech",
              "text": "via dies: diurnal, diary."
            },
            {
              "kind": "speech",
              "text": "Italian giorno and French jour are near-twins here; Spanish, taking dies directly, got the very different día."
            }
          ]
        },
        {
          "index": 3,
          "type": "grammar",
          "title": "Grammar Lens: masculine, plural by vowel-change",
          "segments": [
            {
              "kind": "speech",
              "text": "giorno is masculine (il giorno). Plural i giorni — Italian marks the plural by changing the final vowel (-o becomes -i), not by adding -s."
            }
          ]
        },
        {
          "index": 4,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "\"il giorno\" (masc.), \"i giorni\" (pl.)",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: \"il giorno\" (masc.), \"i giorni\" (pl.)]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "the cousins — journal, journey, diary",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: the cousins — *journal*, *journey*, *diary*]"
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What Latin word gave giorno, and what English words share it? (diurnum from dies; journal, journey, diurnal, diary.) How does Italian form the plural? (Changes the final vowel: -o becomes -i.)"
            }
          ]
        }
      ]
    },
    {
      "id": "IT-C01-buongiorno",
      "sequence": 50,
      "title": "buongiorno — \"good day,\" assembled",
      "headword": "buongiorno",
      "romanization": "buongiorno",
      "gloss": "good day / good morning",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:4d06591169ec14c8",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Put the two pieces together into the polite, all-purpose hello."
            }
          ]
        },
        {
          "index": 1,
          "type": "unknown",
          "title": "The phrase, assembled",
          "segments": [
            {
              "kind": "speech",
              "text": "buon (\"good\") + giorno (\"day\")."
            },
            {
              "kind": "speech",
              "text": "buongiorno = \"good day,\" one word."
            }
          ]
        },
        {
          "index": 2,
          "type": "culture-pragmatics",
          "title": "Why it's said this way",
          "segments": [
            {
              "kind": "speech",
              "text": "Where the casual ciao says \"I'm your servant,\" buongiorno simply wishes you a good day — and it's the safe, respectful choice with anyone: shopkeepers, strangers, elders. Used through the day until late afternoon, when it gives way to buonasera."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "\"buongiorno\" — buon + giorno",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: \"buongiorno\" — buon + giorno]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "when to use it (respect, daytime) vs ciao (friends)",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: when to use it (respect, daytime) vs *ciao* (friends)]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What two words make buongiorno, and when do you use it rather than ciao? (buon + giorno; for respect / strangers / daytime.)"
            }
          ]
        }
      ]
    },
    {
      "id": "IT-C01-sera",
      "sequence": 60,
      "title": "sera / buonasera — \"evening\" and \"good evening\"",
      "headword": "sera / buonasera",
      "romanization": "sera / buonasera",
      "gloss": "evening / good evening",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:1eb2fa43556aab91",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The evening swap for buongiorno."
            }
          ]
        },
        {
          "index": 1,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "la sera (fem.) from Latin sera (\"late [hour]\"), from serus, \"late.\" English cousin: the rare serotine (a bat of the late evening). buonasera = buona + sera, \"good evening\" — buona in its feminine form, because sera is feminine (contrast the masculine buon giorno)."
            }
          ]
        },
        {
          "index": 2,
          "type": "grammar",
          "title": "Grammar Lens: feminine agreement",
          "segments": [
            {
              "kind": "speech",
              "text": "Notice buona sera vs. buon giorno: the \"good\" word matches its noun's gender — feminine sera takes buona, masculine giorno takes buon. Same adjective, two coats."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "\"buonasera\" (buona + sera)",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: \"buonasera\" (*buona* + *sera*)]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "why it's buona here but buon in buon giorno (gender)",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: why it's *buona* here but *buon* in *buon giorno* (gender)]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What Latin word gave sera, and why is it buonasera but buon giorno? (sera from serus, \"late\"; sera is feminine so \"good\" is buona.)"
            }
          ]
        }
      ]
    },
    {
      "id": "IT-C01-notte",
      "sequence": 70,
      "title": "notte / buonanotte — \"night,\" and the -ct- becomes -tt- rule",
      "headword": "notte / buonanotte",
      "romanization": "notte / buonanotte",
      "gloss": "night / good night",
      "script": "latin",
      "modality": "sight",
      "derivedModality": "sight",
      "modalityReasons": [
        "wide-table"
      ],
      "sourceHash": "fnv1a64:80c32e88e71504c6",
      "notice": {
        "modality": "sight",
        "needs": [
          "your eyes for one table that cannot be read aloud"
        ],
        "waitUntilStopped": [
          "The word, taken apart"
        ],
        "text": "Before we start: this one needs your eyes, so it is not fully a driving lesson. You will want your eyes for one table that cannot be read aloud. You can listen to everything else now — leave the section called The word, taken apart until you have stopped, and I will say so again when we reach it."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "\"Night\" — and a sound-rule that decodes dozens of Italian words at once."
            }
          ]
        },
        {
          "index": 1,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "la notte (fem.) from Latin noctem (noct-) becomes English nocturnal, equinox. The change is a rule: Latin -ct- became Italian -tt- (notte), where Spanish softened it to -ch- (noche) and French to -it- (nuit):"
            },
            {
              "kind": "table-skipped",
              "reason": "too-wide",
              "columns": 5,
              "rowCount": 3,
              "headers": [
                "Latin",
                "Italian",
                "Spanish",
                "French",
                "English"
              ],
              "text": "There is a table here I cannot read to you — 5 columns and 3 rows, and it has more columns than can be held in the ear at once. Its columns are: Latin, Italian, Spanish, French, English. Come back and look at it when you have stopped."
            },
            {
              "kind": "speech",
              "text": "Learn the rule once and Italian's double tt words light up."
            },
            {
              "kind": "speech",
              "text": "buonanotte = buona + notte, \"good night\" — the farewell for bed (not an evening hello; that's buonasera)."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "\"buonanotte\"",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: \"buonanotte\"]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "the rule — Latin -ct- becomes Italian -tt- (notte, latte, fatto)",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: the rule — Latin *-ct-* → Italian *-tt-* (*notte*, *latte*, *fatto*)]"
            }
          ]
        },
