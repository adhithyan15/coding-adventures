# Perl 5.004_59 (1998-02-13) plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: unsupported Perl 5.004_59 syntax is rejected.
# Evidence: https://mirrors.develooper.com/perl/historical-perl/perl-5.004_59.tar.gz
# Archive SHA-256: 76425638c9ca1502947e26728c4b9a3dd1982a538727629c5f5c4339757231cc
# Its scan_num section matches 5.004_58 byte for byte, retaining the 250-digit bound.
# Sublexical scope entry/exit changes do not widen this subset.
# CR remains outside this partial accepted subset, without platform-wide parity claim.
# Unsupported characters and leading-zero forms remain refused.

PRINT     = "print"
INT       = /0|[1-9][0-9]{0,249}/
PLUS      = "+"
DECREMENT = "--"
MINUS     = "-"
STAR      = "*"
LPAREN    = "("
RPAREN    = ")"
SEMICOLON = ";"

skip:
  WHITESPACE = /[ \t\n]+/
