    {
      "id": "TE-C47-leg",
      "sequence": 1180,
      "title": "కాలు (kālu) — leg, foot",
      "headword": "కాలు",
      "romanization": "kālu",
      "gloss": "leg, foot",
      "script": "telugu",
      "modality": "voice",
      "derivedModality": "voice",
