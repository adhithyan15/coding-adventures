          "segments": [
            {
              "kind": "speech",
              "text": "sēnsim — \"gradually, gently\"."
            },
            {
              "kind": "speech",
              "text": "Senex sēnsim ad forum ambulābat. The old man was walking slowly to the forum."
            },
            {
              "kind": "speech",
              "text": "So gentle that each step is felt; the opposite of repente."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "sēnsim is built on sentiō, \"to perceive\" (Lewis & Short): first \"perceptibly\", then \"gently, little by little\", as opposed to what comes suddenly."
            }
          ]
        },
