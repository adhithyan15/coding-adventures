    {
      "id": "ZH-W467-xing-nature",
      "sequence": 35475,
      "title": "性 (xìng) — the heart piece, then 生",
      "headword": "性",
      "romanization": "xìng",
      "gloss": "性 — the heart piece, then 生",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:ea0ef0033d5192ff",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — the heart piece, then 生",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — the heart piece, then 生 and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say gèxìng — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *gèxìng* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "生 怕."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — shēng, pà",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *shēng*, *pà*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — the heart piece, then 生",
          "segments": [
            {
              "kind": "speech",
              "text": "性 (xìng)."
            },
            {
              "kind": "speech",
              "text": "Two pieces, left before right. Count the pieces, not the strokes."
            },
            {
              "kind": "speech",
              "text": "The left piece, three strokes: the heart piece. A short dot on the left, a short dot on the right, then a long vertical down between them."
            },
            {
              "kind": "speech",
              "text": "The right piece, 生, five strokes. A short stroke falling to the left at the top, a bar, a second bar, a vertical down through them, then a long bar across the foot."
            },
            {
              "kind": "speech",
              "text": "3 + 5 = eight."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "性 (xìng), all eight, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 性, all eight, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many pieces does 性 (xìng) have? (Two: three strokes and five.) Which written character is on the right? (生.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 性 (xìng), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
