      "id": "phy01/construct/infinite-phase",
      "operation": "construct",
      "summary": "Infinite phase is rejected.",
      "input": {
        "wave": {
          "amplitude": {"kind": "finite", "decimal": "1"},
          "frequency": {"kind": "finite", "decimal": "1"},
