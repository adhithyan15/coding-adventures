        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: కుడి",
          "segments": [
            {
              "kind": "speech",
              "text": "కుడి — kuḍi — \"right (not left)\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "కుడి (kuḍi) is native Dravidian. DEDR 1654 lists kuḍi, \"right, right-hand\", in the same entry as kuḍucu, \"to eat, drink\", with Tamil kuṭi, \"to drink\"."
            }
          ]
        },
