          "segments": [
            {
              "kind": "speech",
              "text": "പുല്ല് (pullŭ) — \"grass\"."
            },
            {
              "kind": "speech",
              "text": "Native Dravidian, matching Tamil pul, and it ends the way നെല്ല് (nellŭ) ends — a doubled l with the vowel shaved off, so the two words rhyme on the tail."
            },
            {
              "kind": "speech",
              "text": "They are the field's two crops seen from opposite sides. One is planted and counted; the other turns up on its own and is cut for the animals."
            },
            {
              "kind": "speech",
              "text": "Which makes this the paśu's word rather than the farmer's: grass is what the cow is walked out to."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "പുല്ല് (pullŭ) is native Dravidian, one word with Tamil pul, Kannada pul and Telugu pulu (DEDR 4300)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "Two."
            }
          ]
        },
