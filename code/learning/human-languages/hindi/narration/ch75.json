              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *angrezī*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "hindī aur angrezī, do bhāshā",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
