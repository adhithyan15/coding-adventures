        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: o pincel",
          "segments": [
            {
              "kind": "speech",
              "text": "o pincel — \"paintbrush\"."
            },
            {
              "kind": "speech",
              "text": "Ela pinta com um pincel muito fino. She paints with a very fine brush."
            },
            {
              "kind": "speech",
              "text": "Plural pincéis. A hairbrush is uma escova."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "pincel comes from Catalan pinzell \"paintbrush\" (EtymDB), which goes back to Latin pēnicillum \"a painter's brush\"."
            }
          ]
        },
        {
