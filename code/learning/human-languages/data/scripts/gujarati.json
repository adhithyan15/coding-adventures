{
  "script": "gujarati",
  "name": "Gujarati",
  "font": "_fonts/NotoSansGujarati-Static.ttf",
  "direction": "ltr",
  "system": "abugida",
  "signature": "Looks like Devanagari with the head-line erased — round tops and no bar running across the top.",
  "complete": false,
  "combination": "A consonant carries an inherent 'a' (ક = ka). A vowel mark (mātrā) replaces that vowel (ક + ી → કી = kī). The virama ્ strips the vowel, and the bare consonant joins the next into a conjunct (ન + ્ + મ → ન્મ). Gujarati is Devanagari's sister, but with one visible difference: it has NO horizontal top line (shirorekhā) — the letters float free, which is why it is sometimes called 'the headless script.'",
  "notes": "Used by Gujarati (the language of Gandhi). The initial inventory below covers the greeting/self-introduction/first-verbs vocabulary; it grows toward a complete set. Letterforms mirror Devanagari without the top bar. Stroke orders are the common handwriting convention, not a standard.",
  "letters": [
    { "glyph": "અ", "sound": "a", "role": "independent-vowel", "components": ["a left curve", "a vertical stem (no top bar)", "the inherent-vowel default"], "strokeOrder": ["left curve", "vertical stem"], "strokeOrderNote": "conventional" },
    { "glyph": "આ", "sound": "ā", "role": "independent-vowel", "components": ["અ", "plus a trailing vertical (the ā stroke)"], "strokeOrder": ["write અ", "add the vertical on the right"], "strokeOrderNote": "conventional" },
    { "glyph": "ઇ", "sound": "i", "role": "independent-vowel", "components": ["a rounded body with a hook"], "strokeOrder": ["body", "hook"], "strokeOrderNote": "conventional" },
    { "glyph": "ઈ", "sound": "ī", "role": "independent-vowel", "components": ["ઇ", "with the hook closed into a loop"], "strokeOrder": ["body", "loop"], "strokeOrderNote": "conventional" },
    { "glyph": "ઉ", "sound": "u", "role": "independent-vowel", "components": ["a curved body dropping below the line"], "strokeOrder": ["body", "descending curve"], "strokeOrderNote": "conventional" },
    { "glyph": "ઊ", "sound": "ū", "role": "independent-vowel", "components": ["ઉ", "with a longer tail"], "strokeOrder": ["body", "longer tail"], "strokeOrderNote": "conventional" },
    { "glyph": "એ", "sound": "e", "role": "independent-vowel", "components": ["a stem with a small flag"], "strokeOrder": ["body", "flag"], "strokeOrderNote": "conventional" },
    { "glyph": "ઓ", "sound": "o", "role": "independent-vowel", "components": ["આ", "plus the e-flag on top"], "strokeOrder": ["આ", "flag"], "strokeOrderNote": "conventional" },
    { "glyph": "ક", "sound": "ka", "role": "consonant", "inherentVowel": "a", "components": ["a left loop", "a vertical spine on the right (no top bar)"], "strokeOrder": ["left loop", "vertical spine"], "strokeOrderNote": "conventional" },
    { "glyph": "ગ", "sound": "ga", "role": "consonant", "inherentVowel": "a", "components": ["a hooked body", "right spine"], "strokeOrder": ["body hook", "spine"], "strokeOrderNote": "conventional" },
    { "glyph": "ચ", "sound": "ca", "role": "consonant", "inherentVowel": "a", "components": ["a rounded body opening right", "spine"], "strokeOrder": ["rounded body", "spine"], "strokeOrderNote": "conventional" },
    { "glyph": "છ", "sound": "cha", "role": "consonant", "inherentVowel": "a", "components": ["two joined rounded lobes"], "strokeOrder": ["left lobe", "right lobe"], "strokeOrderNote": "conventional" },
    { "glyph": "જ", "sound": "ja", "role": "consonant", "inherentVowel": "a", "components": ["a three-part body", "spine"], "strokeOrder": ["body", "spine"], "strokeOrderNote": "conventional" },
    { "glyph": "ત", "sound": "ta", "role": "consonant", "inherentVowel": "a", "components": ["a small left curl", "a tall spine"], "strokeOrder": ["left curl", "spine"], "strokeOrderNote": "conventional" },
    { "glyph": "દ", "sound": "da", "role": "consonant", "inherentVowel": "a", "components": ["an S-like body", "no separate right spine"], "strokeOrder": ["upper curve", "lower curve"], "strokeOrderNote": "conventional" },
    { "glyph": "ધ", "sound": "dha", "role": "consonant", "inherentVowel": "a", "components": ["like દ with an extra inner loop"], "strokeOrder": ["body", "inner loop"], "strokeOrderNote": "conventional" },
    { "glyph": "ન", "sound": "na", "role": "consonant", "inherentVowel": "a", "components": ["a left bowl", "right spine"], "strokeOrder": ["bowl", "spine"], "strokeOrderNote": "conventional" },
    { "glyph": "પ", "sound": "pa", "role": "consonant", "inherentVowel": "a", "components": ["a left loop open at the bottom", "right spine"], "strokeOrder": ["loop", "spine"], "strokeOrderNote": "conventional" },
    { "glyph": "બ", "sound": "ba", "role": "consonant", "inherentVowel": "a", "components": ["like વ with an inner bar", "right spine"], "strokeOrder": ["body", "inner bar", "spine"], "strokeOrderNote": "conventional" },
    { "glyph": "ભ", "sound": "bha", "role": "consonant", "inherentVowel": "a", "components": ["a left loop with an inner stroke", "right spine"], "strokeOrder": ["loop", "inner stroke", "spine"], "strokeOrderNote": "conventional" },
    { "glyph": "મ", "sound": "ma", "role": "consonant", "inherentVowel": "a", "components": ["a lower loop", "an upper loop", "right spine"], "strokeOrder": ["lower loop", "upper loop", "spine"], "strokeOrderNote": "conventional" },
    { "glyph": "ય", "sound": "ya", "role": "consonant", "inherentVowel": "a", "components": ["a left loop", "a right hook body", "spine"], "strokeOrder": ["left loop", "right body", "spine"], "strokeOrderNote": "conventional" },
    { "glyph": "ર", "sound": "ra", "role": "consonant", "inherentVowel": "a", "components": ["a single downward stroke with a small shoulder"], "strokeOrder": ["shoulder", "downstroke"], "strokeOrderNote": "conventional" },
    { "glyph": "લ", "sound": "la", "role": "consonant", "inherentVowel": "a", "components": ["a left curl", "a bowl", "right spine"], "strokeOrder": ["curl", "bowl", "spine"], "strokeOrderNote": "conventional" },
    { "glyph": "ળ", "sound": "ḷa", "role": "consonant", "inherentVowel": "a", "components": ["a looped body", "right spine"], "strokeOrder": ["loop body", "spine"], "strokeOrderNote": "conventional", "notes": "The retroflex ḷ, shared with Marathi and the Dravidian south; Hindi lacks it." },
    { "glyph": "વ", "sound": "va", "role": "consonant", "inherentVowel": "a", "components": ["a single left loop", "right spine"], "strokeOrder": ["loop", "spine"], "strokeOrderNote": "conventional" },
    { "glyph": "શ", "sound": "śa", "role": "consonant", "inherentVowel": "a", "components": ["a left hook", "a bowl", "right spine"], "strokeOrder": ["hook", "bowl", "spine"], "strokeOrderNote": "conventional" },
    { "glyph": "સ", "sound": "sa", "role": "consonant", "inherentVowel": "a", "components": ["a left curl", "a body", "right spine"], "strokeOrder": ["curl", "body", "spine"], "strokeOrderNote": "conventional" },
    { "glyph": "હ", "sound": "ha", "role": "consonant", "inherentVowel": "a", "components": ["a single looped body", "right spine"], "strokeOrder": ["loop body", "spine"], "strokeOrderNote": "conventional" }
  ],
  "marks": [
    { "mark": "ા", "sound": "ā", "role": "vowel-sign", "attachesAs": "a vertical bar to the right of the consonant", "example": { "base": "ન", "combined": "ના", "sound": "nā" } },
    { "mark": "િ", "sound": "i", "role": "vowel-sign", "attachesAs": "a curl placed BEFORE (to the left of) the consonant, though pronounced after", "example": { "base": "શ", "combined": "શિ", "sound": "śi" } },
    { "mark": "ી", "sound": "ī", "role": "vowel-sign", "attachesAs": "a curl to the right with a tail", "example": { "base": "દ", "combined": "દી", "sound": "dī" } },
    { "mark": "ુ", "sound": "u", "role": "vowel-sign", "attachesAs": "a small hook below the consonant", "example": { "base": "ત", "combined": "તુ", "sound": "tu" } },
    { "mark": "ૂ", "sound": "ū", "role": "vowel-sign", "attachesAs": "a longer hook below the consonant", "example": { "base": "મ", "combined": "મૂ", "sound": "mū" } },
    { "mark": "ે", "sound": "e", "role": "vowel-sign", "attachesAs": "a stroke above the consonant", "example": { "base": "ક", "combined": "કે", "sound": "ke" } },
    { "mark": "ો", "sound": "o", "role": "vowel-sign", "attachesAs": "the ā bar on the right plus a stroke above", "example": { "base": "છ", "combined": "છો", "sound": "cho" } },
    { "mark": "ં", "sound": "ṃ (nasal)", "role": "nasal", "attachesAs": "an anusvāra dot above, nasalizing the syllable", "example": { "base": "હ", "combined": "હં", "sound": "haṃ" } },
    { "mark": "્", "sound": "(vowel killer)", "role": "virama", "attachesAs": "a stroke below that removes the inherent 'a' and forms a conjunct with the next consonant", "example": { "base": "ક", "combined": "ક્", "sound": "k" } },
    { "mark": "ૃ", "sound": "ṛ", "role": "vowel-sign", "attachesAs": "a small hook below (the vocalic r, in Sanskrit loanwords)", "example": { "base": "ક", "combined": "કૃ", "sound": "kṛ" } }
  ]
}
