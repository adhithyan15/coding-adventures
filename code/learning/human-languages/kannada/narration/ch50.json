      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new run: what did hāge mean, and what did bahuśaḥ mean?"
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ಈಗ",
          "segments": [
            {
              "kind": "speech",
              "text": "ಈಗ (īga) — \"now\"."
            },
            {
              "kind": "speech",
              "text": "ಈಗ (īga) is 'now', and it stands on the same ಇ- of nearness the chapter before ended on. ಆಗ (āga) is its partner: 'then, at that time', carrying the ಅ- of distance."
            },
            {
              "kind": "speech",
              "text": "So Kannada names this moment and that moment by the same means it names this thing and that thing. Time is handled as one more place to point at."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "The first of five words for going."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "īga",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *īga*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "it once more, slowly",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: it once more, slowly]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "īga, then āga, and point at the near one and the far one",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *īga*, then *āga*, and point at the near one and the far one]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What does ಈಗ (īga) mean? (\"now\".) Say it once more."
            }
          ]
        }
      ]
    },
