          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "fath is borrowed from Arabic fatḥ (EtymDB), usually glossed \"an opening, a conquest\". kardan \"to do\" is inherited Persian."
            }
          ]
        },
