          "segments": [
            {
              "kind": "speech",
              "text": "تعليم — taʿlīm — \"education\"."
            },
            {
              "kind": "speech",
              "text": "التعليم مجاني في هذا البلد. at-taʿlīm majjānī fī hādhā al-balad. Education is free in this country."
            }
          ]
        },
        {
