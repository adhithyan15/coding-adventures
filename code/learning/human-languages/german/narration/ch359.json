        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: die Gerechtigkeit",
          "segments": [
            {
              "kind": "speech",
              "text": "die Gerechtigkeit — \"justice, fairness\"."
            },
            {
              "kind": "speech",
              "text": "Viele junge Leute kämpfen für mehr Gerechtigkeit. Many young people fight for more justice."
            },
            {
              "kind": "speech",
              "text": "No plural in everyday use. From gerecht — fair."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Gerechtigkeit is formed from gerecht \"fair, righteous\", Old High German gireht (EtymDB), with -igkeit; the adjective is built on the word for \"right\", Proto-Germanic rehtaz."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
