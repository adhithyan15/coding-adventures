              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say nián — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *nián* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "生 十."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — shēng, shí",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *shēng*, *shí*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — three bars and a long vertical",
          "segments": [
            {
              "kind": "speech",
              "text": "年 (nián)."
            },
            {
              "kind": "speech",
              "text": "One piece, six strokes."
            },
            {
              "kind": "speech",
              "text": "A short left-falling stroke at the top left."
            },
            {
              "kind": "speech",
              "text": "Two horizontals, the upper one short, the one below it longer."
            },
            {
              "kind": "speech",
              "text": "A short vertical down from the left end of the second bar."
            },
            {
              "kind": "speech",
              "text": "A long horizontal across the bottom."
            },
            {
              "kind": "speech",
              "text": "Last, the long vertical down through the middle, past the bottom bar."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "年 (nián), all six, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 年, all six, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many strokes in 年 (nián)? (Six.) What comes first? (A short left-falling stroke.) Which stroke is last? (The long vertical through the middle.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 年 (nián), pinned stroke paths and medians."
            }
          ]
        }
