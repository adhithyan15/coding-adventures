          "type": "input",
          "title": "You'll want to know: el autocar",
          "segments": [
            {
              "kind": "speech",
              "text": "el autocar — \"the coach (long-distance bus)\"."
            },
            {
              "kind": "speech",
              "text": "El autocar sale a las ocho. The coach leaves at eight."
            },
            {
              "kind": "speech",
              "text": "A Spain word; Latin America says el autobús, el bus or el micro."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "autocar was borrowed from French autocar (EtymDB), made from auto- and English car."
            }
          ]
        },
