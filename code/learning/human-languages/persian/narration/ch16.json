          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "speech",
              "text": "A run learned forwards is a rhyme. Break it four ways."
            },
            {
              "kind": "speech",
              "text": "Hear each of the five named singly and out of order, and say what it is."
            },
            {
              "kind": "speech",
              "text": "Count backwards from panj to yek."
            },
            {
              "kind": "speech",
              "text": "Read the five printed shuffled — پنج (panj)، یک (yek)، چهار (chahâr)، سه (se)، دو (do) — and say each."
            },
            {
              "kind": "speech",
              "text": "Write سه, the one of the five whose letters are already yours."
            },
            {
              "kind": "speech",
              "text": "Then say each number's English cousin: one, two, three, four, five. Every one of the five has one, and that is not a coincidence — it is the same set of words, five thousand years apart."
            }
          ]
        },
        {
          "index": 2,
          "type": "recall",
          "title": "Wrap-up Recall",
