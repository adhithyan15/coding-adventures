    {
      "id": "SA-C04-punar-darshanaya",
      "sequence": null,
      "title": "पुनर्दर्शनाय (punar-darśanāya) — \"until we meet again\"",
      "headword": "पुनर्दर्शनाय",
      "romanization": "",
      "gloss": "until we meet again (lit. \"for seeing again\")",
      "script": "devanagari",
      "modality": "sight",
      "derivedModality": "sight",
      "modalityReasons": [
