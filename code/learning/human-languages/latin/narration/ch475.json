          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "spīca is usually traced to a root meaning 'to be sharp, pointed' (Lewis & Short), the root of spīna 'thorn'. EtymDB lists it without a parent."
            }
          ]
        },
