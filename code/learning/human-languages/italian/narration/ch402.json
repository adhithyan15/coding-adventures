          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "rete is inherited from Latin rēte \"a net\" (Lewis & Short): a fishing net, then any network of threads, roads or computers."
            }
          ]
        },
