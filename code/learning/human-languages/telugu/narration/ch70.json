      "id": "TE-C70-mouse",
      "sequence": 2330,
      "title": "ఎలుక (eluka) — a mouse, a rat",
      "headword": "ఎలుక",
      "romanization": "eluka",
      "gloss": "a mouse, a rat",
      "script": "telugu",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:ab7dd7ea911ba11a",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: what did karra mean?"
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ఎలుక",
          "segments": [
            {
              "kind": "speech",
              "text": "ఎలుక (eluka) — \"a mouse, a rat\"."
            },
            {
              "kind": "speech",
              "text": "ఎలుక (eluka) is a mouse, and the same word does for a rat. Telugu does not split them the way English does; when the size matters, a word for size is added."
            },
            {
              "kind": "speech",
              "text": "It is inherited. Any house with బియ్యం in it has an ఎలుక (eluka) story, and the పిల్లి you already know earns its keep here."
            },
            {
              "kind": "speech",
              "text": "Asked whether there is one about, most people say అవును before they have thought about it, and లేదు only after going to look."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One. And the first thing anybody asks about a house."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "eluka",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *eluka*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "it once more, slowly",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: it once more, slowly]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "eluka, then avunu, then lēdu",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *eluka*, then *avunu*, then *lēdu*]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What does ఎలుక (eluka) mean? (\"a mouse, a rat\".) Say it once more."
            }
          ]
        }
      ]
    },
