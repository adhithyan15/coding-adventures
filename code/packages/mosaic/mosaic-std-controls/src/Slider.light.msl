style Slider {
  part slider-root {
    gap : $foundation-space-xs ;
  }

  part slider-heading {
    gap : $foundation-space-sm ;
  }

  part slider-label {
    color       : $foundation-color-text-light ;
    font-size   : $foundation-font-body ;
    font-weight : 600 ;
  }

  part slider-value {
    color     : $foundation-color-muted-light ;
    font-size : $foundation-font-caption ;
  }
}
