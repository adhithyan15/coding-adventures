          "segments": [
            {
              "kind": "speech",
              "text": "opīniō, opīniōnis — \"an opinion, a belief; a reputation\"."
            },
            {
              "kind": "speech",
              "text": "Haec est opīniō mea, nōn tua. This is my opinion, not yours."
            },
            {
              "kind": "speech",
              "text": "opīniō, opīniōnis f., third declension. It is also what people think of you: bona opīniō, a good name. English opinion."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "opīniō is the noun built on opīnor \"to suppose\" (EtymDB; Lewis & Short), and English opinion comes from it through French."
            }
          ]
        },
