          "title": "You'll want to know: cochlear, cochleāris",
          "segments": [
            {
              "kind": "speech",
              "text": "cochlear, cochleāris — \"a spoon\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "cochlear is built on cochlea, \"a snail\" (EtymDB 2.1), a word Latin took from Greek kokhlias, \"snail, spiral\": the spoon was first for eating snails, its pointed end for picking them out."
            }
          ]
        },
