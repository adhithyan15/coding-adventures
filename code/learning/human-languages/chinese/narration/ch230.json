    {
      "id": "ZH-W230-shen-body",
      "sequence": 17625,
      "title": "身 (shēn) — a frame with two bars, crossed by two long strokes",
      "headword": "身",
      "romanization": "shēn",
      "gloss": "身 — a short fall, a frame with two bars inside, a rising stroke and a long fall",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:bb171feeb8821b98",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — a frame with two bars, crossed by two long strokes",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — a frame with two bars, crossed by two long strokes and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say shēnshang — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *shēnshang* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "上 月."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — shàng, yuè",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *shàng*, *yuè*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — a frame with two bars, crossed by two long strokes",
          "segments": [
            {
              "kind": "speech",
              "text": "身 (shēn)."
            },
            {
              "kind": "speech",
              "text": "One piece, seven strokes. Count them in three groups."
            },
            {
              "kind": "speech",
              "text": "The frame, three strokes. A short stroke falling to the left at the top. A short vertical on the left. Then a bar from its top that runs right and turns down into a long stroke to the foot, hooking left."
            },
            {
              "kind": "speech",
              "text": "Inside, two short bars, one under the other."
            },
            {
              "kind": "speech",
              "text": "Across it all, two long strokes. A stroke rising from the far left to the right, through the frame. Then a long stroke from the upper right falling down to the lower left."
            },
            {
              "kind": "speech",
              "text": "3 + 2 + 2 = seven."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "身 (shēn), all seven, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 身, all seven, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many strokes in 身 (shēn)? (Seven.) How many short bars sit inside the frame? (Two.) What comes last? (The long stroke falling to the left.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 身 (shēn), pinned stroke paths and medians."
            }
          ]
        }
      ]
