        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: சாமான்",
          "segments": [
            {
              "kind": "speech",
              "text": "சாமான் — cāmāṉ — \"luggage; things, goods\"."
            },
            {
              "kind": "speech",
              "text": "என் சாமான்கள் எல்லாம் காரில் இருக்கின்றன. eṉ cāmāṉkaḷ ellām kāril irukkiṉṟaṉa. All my luggage is in the car."
            },
            {
              "kind": "speech",
              "text": "Plural: சாமான்கள், cāmāṉkaḷ."
            },
            {
              "kind": "speech",
              "text": "Often plural: சாமான்கள், one's things."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "சாமான் (cāmāṉ) is a loan from Persian sāmān, \"goods, equipment\", through Hindustani."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for getting around."
