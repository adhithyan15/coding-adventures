          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "hamle is borrowed from Arabic ḥamla (EtymDB lists the Arabic word), usually glossed \"a charge, an attack\". kardan \"to do\" is inherited Persian."
            }
          ]
        },
