        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: लड़का",
          "segments": [
            {
              "kind": "speech",
              "text": "लड़का (laṛkā) — \"a boy\", and in a family, \"a son\"."
            },
            {
              "kind": "speech",
              "text": "बेटा is \"son\" as a family word; लड़का (laṛkā) is any boy."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "A boy, beside the word for son you know."
