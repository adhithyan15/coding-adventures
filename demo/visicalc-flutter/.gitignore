# Flutter / Dart build artifacts
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
.pub-cache/
.pub/
pubspec.lock

# Per-platform native build caches & toolchain droppings.  The
# platform scaffolds themselves (android/, ios/, web/) are checked
# in so the build-tool can reach them, but the volatile caches
# under each are gitignored.
android/.gradle/
android/local.properties
android/app/.cxx/
android/.kotlin/
ios/Pods/
ios/Podfile.lock
ios/.symlinks/
ios/Flutter/Flutter.framework/
ios/Flutter/Flutter.podspec
ios/Flutter/flutter_export_environment.sh
ios/Flutter/Generated.xcconfig
ios/Runner.xcworkspace/xcuserdata/
ios/Runner.xcodeproj/xcuserdata/
ios/Runner.xcodeproj/project.xcworkspace/xcuserdata/

# IDE
.idea/
.vscode/
*.iml

# Generated by mosaic-compile via scripts/build.sh — regenerate
# with that script; not checked in (matches the React demo pattern
# in `demo/visicalc/src/components/`).
lib/generated/formula_bar.dart

# Vendored engine — the C ABI dynamic library dart:ffi loads at runtime, built
# by scripts/build.sh from the spreadsheet-capi crate (cdylib). Like the
# SwiftUI/Qt demos' Vendor/, it's a build artifact, not source.
native/
