        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: परसों",
          "segments": [
            {
              "kind": "speech",
              "text": "परसों (parsoṁ) — \"the day after tomorrow\"."
            },
            {
              "kind": "speech",
              "text": "And also the day before yesterday. Like कल, which does duty for both tomorrow and yesterday, परसों (parsoṁ) counts two days out from today and leaves the direction to the sentence."
            },
            {
              "kind": "speech",
              "text": "Sanskrit parasu, 'the far day', lies underneath, and the language evidently never felt the lack of two separate words. Time is being measured here by distance from now, with the direction supplied by whatever the sentence is already doing."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "Two, and both of them are about when."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
