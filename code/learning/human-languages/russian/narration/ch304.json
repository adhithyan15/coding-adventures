          "index": 1,
          "type": "input",
          "title": "You'll want to know: детство",
          "segments": [
            {
              "kind": "speech",
              "text": "детство (détstvo) — \"childhood\"."
            },
            {
              "kind": "speech",
              "text": "Детство я провёл в деревне. Détstvo ya provyól v derévne. I spent my childhood in the countryside."
            },
            {
              "kind": "speech",
              "text": "Neuter. С детства — since childhood."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "детство (détstvo) is built on дети \"children\", from Proto-Slavic dětę \"a child\", which EtymDB traces to PIE dʰeh₁(y)- \"to suckle\"."
            }
          ]
        },
