              "kind": "speech",
              "text": "Before the new one: say the Spanish for as soon as, then the Spanish for the moment that."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: desde entonces",
          "segments": [
            {
              "kind": "speech",
              "text": "desde entonces — \"since then\"."
            },
            {
              "kind": "speech",
              "text": "Desde entonces no lo he visto. I haven't seen him since then."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "desde entonces is built on desde 'since' and entonces, which comes from Latin in tunc 'at that time' (EtymDB), with an -s added on the end."
            }
          ]
        },
        {
