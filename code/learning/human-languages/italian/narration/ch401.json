      ],
      "sourceHash": "fnv1a64:2c4411a3c90ad62a",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Italian for the device, then the Italian for the software."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: il file",
          "segments": [
            {
              "kind": "speech",
              "text": "il file — \"the computer file\"."
            },
            {
              "kind": "speech",
              "text": "Se mi mandi il file, lo stampo. If you send me the file, I will print it."
            },
            {
              "kind": "speech",
              "text": "Masculine, invariable: i file. Pronounced as in English."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "file was borrowed from English file, which came from French fil \"thread\", from Latin fīlum (Lewis & Short): papers were once kept threaded on a string."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
            }
          ]
        },
        {
          "index": 4,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "il file",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *il file*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "il file, once more",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *il file*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "a sentence of your own with il file",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: a sentence of your own with *il file*]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say the Italian for the device, then the Italian for the software, then say il file again",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say the Italian for the device, then the Italian for the software, then say *il file* again]"
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What does il file mean? (\"The computer file\".) Say it once more."
            }
          ]
        }
      ]
