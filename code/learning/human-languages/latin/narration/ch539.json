          "segments": [
            {
              "kind": "speech",
              "text": "fritillus, fritillī — \"a dice-box\"."
            },
            {
              "kind": "speech",
              "text": "Senex tālōs ē fritillō iacit. The old man throws the knucklebones from the dice-box."
            },
            {
              "kind": "speech",
              "text": "Masculine, second declension. A little cup for shaking and throwing the dice."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "fritillus is a native Latin noun whose origin is not settled (Lewis & Short gives none). The flower fritillary is named after it."
            }
          ]
        },
