% ============================================================================
% proportion.query.adj — a worked example of the proportion formula library.
% ============================================================================
% Run against the shipped stdlib:
%
%   adj-lang-cli proportion.query.adj
%
% "2 is to 3 as 4 is to WHAT?" — the proportion 2/3 = 4/x. The rule of three
% gives x = (3 × 4) / 2 = 6, computed on the CPU by composing the cited `product`
% primitive (3 × 4 = 12) and then the cited `quotient` primitive (12 / 2 = 6)
% from arithmetic.adj. The answer carries the cross-multiplication rule of three
% (primary) AND both primitives it built on (corroboration) — the model performs
% zero arithmetic. (Check: 2/3 = 4/6 = 0.666…, so the proportion balances.)
% ============================================================================
import "proportion.adj"

observe first_term(2)
    quote "first term is 2." at 0 snapshot "b68d08d0f11dc65522ec6f32c02a535a82bb8ce548596b839e259979208d0638"
    source "proportion input fixture"
    locator "repo://code/specs/data/adj-stdlib-provenance/fixtures/proportion-inputs.txt"
    trust authoritative
observe second_term(3)
    quote "second term is 3." at 17 snapshot "b68d08d0f11dc65522ec6f32c02a535a82bb8ce548596b839e259979208d0638"
    source "proportion input fixture"
    locator "repo://code/specs/data/adj-stdlib-provenance/fixtures/proportion-inputs.txt"
    trust authoritative
observe third_term(4)
    quote "third term is 4." at 35 snapshot "b68d08d0f11dc65522ec6f32c02a535a82bb8ce548596b839e259979208d0638"
    source "proportion input fixture"
    locator "repo://code/specs/data/adj-stdlib-provenance/fixtures/proportion-inputs.txt"
    trust authoritative

% Route the third term through an exact identity computation so this positive
% fixture witnesses a derived guard operand without changing the proportion.
% `product` is already imported by proportion.adj and its source remains separate
% from the outer rule-of-three formula in the execution witness.
let checked_third_term = product(third_term, 1)

? fourth_proportional(first_term, second_term, checked_third_term)

