# SQL Token Grammar — ANSI SQL subset
# @version 1
# @case_insensitive true
#
# Note: keyword values are normalized to uppercase when @case_insensitive
# is true. Grammar literals like "SELECT" match select/SELECT/Select.
#
# Operator order: longest match first (<=  before  <,  >=  before  >,
# !=  before  nothing).  NEQ_ANSI (<>) aliased to NOT_EQUALS so the grammar
# references a single token type for both inequality spellings.
#
# case_sensitive: false tells the Lua GrammarLexer to do case-insensitive
# keyword matching (input is lowercased before matching). Perl GrammarTools
# silently ignores the case_sensitive: directive, so this is cross-platform.
case_sensitive: false

# SQL strings do NOT use backslash escapes — '\\' is two literal backslashes,
# 'a\_b' is the four characters a, \, _, b.  The only escape sequence is ''
# (two single quotes) for an embedded apostrophe.  Tell the GrammarLexer to
# leave string contents alone after stripping the surrounding quotes.
escapes: none

BLOB_HEX      = /[xX]'[0-9A-Fa-f]*'/ -> BLOB
# Hex integer literal — SQLite spelling is `0x...` or `0X...` with one or
# more hex digits.  Must precede NUMBER so the leading `0` does not get
# eaten as a separate decimal token (which would leave `xFF` to be parsed
# as a NAME).  HEX_INT folds down to a NUMBER token so the grammar can
# keep referencing a single literal-integer token type everywhere.
HEX_INT       = /0[xX][0-9A-Fa-f]+/ -> NUMBER
NAME          = /[a-zA-Z_][a-zA-Z0-9_]*/
NUMBER        = /[0-9]+\.?[0-9]*/
STRING_SQ     = /'(''|[^'])*'/ -> STRING
QUOTED_ID     = /`[^`]+`/ -> NAME
# Double-quoted identifiers: SQLite (and ANSI SQL) allow "name" to quote
# identifiers that contain spaces, are reserved words, or are otherwise
# non-standard.  We map them to NAME so they work as column aliases, table
# names, etc.  The value stored strips the surrounding quotes.
QUOTED_ID_DQ  = /"([^"]|"")*"/ -> NAME

LESS_EQUALS    = "<="
GREATER_EQUALS = ">="
NOT_EQUALS     = "!="
NEQ_ANSI       = "<>" -> NOT_EQUALS
CONCAT_OP      = "||"

# Bitwise shift operators — must be matched before the single-character
# ``<`` and ``>`` for longest-match semantics.
SHIFT_LEFT     = "<<"
SHIFT_RIGHT    = ">>"

# JSON path-shortcut operators (SQLite 3.38+).  ->> must be matched before
# -> for longest-match.  Both are binary operators with their own precedence
# (between PRIMARY and the unary minus, per SQLite).
#   j -> p   → JSON form of json_extract(j, '$.p')
#   j ->> p  → SQL  form (raw scalar) of json_extract(j, '$.p')
JSON_ARROW_TEXT = "->>"
JSON_ARROW      = "->"

EQUALS        = "="
LESS_THAN     = "<"
GREATER_THAN  = ">"
PLUS          = "+"
MINUS         = "-"
STAR          = "*"
SLASH         = "/"
PERCENT       = "%"

# Bitwise operators — &, |, ~ (binary AND/OR and unary NOT).  All three are
# single-character tokens; no longest-match conflict to worry about.
BIT_AND_OP    = "&"
BIT_OR_OP     = "|"
BIT_NOT_OP    = "~"

LPAREN        = "("
RPAREN        = ")"
COMMA         = ","
SEMICOLON     = ";"
DOT           = "."

keywords:
  WITH
  RECURSIVE
  SELECT
  FROM
  WHERE
  GROUP
  BY
  HAVING
  ORDER
  LIMIT
  OFFSET
  INSERT
  INTO
  VALUES
  UPDATE
  SET
  DELETE
  ALTER
  ADD
  COLUMN
  CREATE
  DROP
  RENAME
  TABLE
  IF
  EXISTS
  NOT
  AND
  OR
  NULL
  IS
  IN
  BETWEEN
  LIKE
  ESCAPE
  AS
  DISTINCT
  ALL
  UNION
  INTERSECT
  EXCEPT
  JOIN
  INNER
  LEFT
  RIGHT
  OUTER
  CROSS
  FULL
  ON
  ASC
  DESC
  TRUE
  FALSE
  CASE
  WHEN
  THEN
  ELSE
  END
  PRIMARY
  KEY
  AUTOINCREMENT
  UNIQUE
  INDEX
  INDEXED
  CHECK
  REFERENCES
  DEFAULT
  COLLATE
  ATTACH
  DETACH
  DATABASE
  STRICT
  WITHOUT
  VIEW
  BEGIN
  COMMIT
  ROLLBACK
  TRANSACTION
  SAVEPOINT
  RELEASE
  TO
  OVER
  PARTITION
  WINDOW
  TRIGGER
  BEFORE
  AFTER
  FOR
  EACH
  ROW
  RETURNING
  CAST
  GLOB
  NATURAL
  USING
  REPLACE
  IGNORE
  ABORT
  FAIL
  CONFLICT
  DO
  NOTHING
  ROWS
  RANGE
  GROUPS
  PRECEDING
  FOLLOWING
  UNBOUNDED
  CURRENT
  MATERIALIZED
  NULLS

skip:
  WHITESPACE    = /[ \t\r\n]+/
  LINE_COMMENT  = /--[^\n]*/
  BLOCK_COMMENT = /\x2f\*([^*]|\*[^\x2f])*\*\x2f/
