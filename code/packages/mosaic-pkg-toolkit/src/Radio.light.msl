// Radio.light.msl — default light-theme styling.

style Radio {
  part radio {
    padding : 4 ;
  }
  part radio-box-selected {
    width         : 18 ;
    height        : 18 ;
    border-radius : 9 ;
    background    : "#ffffff" ;
    color         : "#0d6efd" ;
    border-width  : 1 ;
    border-color  : "#0d6efd" ;
    font-size     : 14 ;
    padding       : 0 ;
  }
  part radio-box-unselected {
    width         : 18 ;
    height        : 18 ;
    border-radius : 9 ;
    background    : "#ffffff" ;
    border-width  : 1 ;
    border-color  : "#ced4da" ;
    padding       : 0 ;
  }
  part radio-label {
    padding : 4 ;
  }
}
