-- vos-probe-ready: the fixture of the VOS-028b capacity probe (VOS30 section 9.1).
--
-- The probe's experiment E1 measures the throughput of a generated by-value harness.  The real
-- scheduler vos-sched-fp-bitmap is fixed at N = 8, so this package carries only what the real
-- component cannot: `insert` at N = 10 (state 2^10 times a U8 index = 262,144 cases), a claim whose
-- binder product is 393,216 (just under the 400,000 budget), and the `Impl(mask: U8)` form beside
-- the eight-Bool form.  The N = 11 document that the generator must refuse (W0706) is
-- refusal/insert_n11.warrant, which the probe reads but never generates a harness from.
--
-- Hand-written for the probe: it is not a generated document and not a contract.  Operations are
-- plain scalar functions of a bitmap held in a U8 (N = 8) or a U16 (N = 10).
warrant vos_probe_ready v1
  record Ready8(p0: Bool, p1: Bool, p2: Bool, p3: Bool, p4: Bool, p5: Bool, p6: Bool, p7: Bool)
  record Ready10(p0: Bool, p1: Bool, p2: Bool, p3: Bool, p4: Bool, p5: Bool, p6: Bool, p7: Bool, p8: Bool, p9: Bool)
  model set_at(cur: Bool, i: U8, k: U8, b: Bool) -> Bool = if i == k then b else cur
  model b2m8(b: Bool, k: Nat) -> U8 = if b then shl(1u8, k) else 0u8
  model b2m10(b: Bool, k: Nat) -> U16 = if b then shl(1u16, k) else 0u16
  model mem8(m: Ready8, i: U8) -> Bool = ((i == 0u8 and m.p0) or (i == 1u8 and m.p1) or (i == 2u8 and m.p2) or (i == 3u8 and m.p3) or (i == 4u8 and m.p4) or (i == 5u8 and m.p5) or (i == 6u8 and m.p6) or (i == 7u8 and m.p7))
  model put8(m: Ready8, i: U8, b: Bool) -> Ready8 = Ready8(set_at(m.p0, i, 0u8, b), set_at(m.p1, i, 1u8, b), set_at(m.p2, i, 2u8, b), set_at(m.p3, i, 3u8, b), set_at(m.p4, i, 4u8, b), set_at(m.p5, i, 5u8, b), set_at(m.p6, i, 6u8, b), set_at(m.p7, i, 7u8, b))
  model abs_insert8(m: Ready8, t: U8) -> Ready8 = (
    if t >= 8u8 then m else put8(m, t, true))
  model build8(m: Ready8) -> U8 = bit_or(bit_or(bit_or(bit_or(bit_or(bit_or(bit_or(b2m8(m.p0, 0), b2m8(m.p1, 1)), b2m8(m.p2, 2)), b2m8(m.p3, 3)), b2m8(m.p4, 4)), b2m8(m.p5, 5)), b2m8(m.p6, 6)), b2m8(m.p7, 7))
  model dec8(w: U8) -> Ready8 = Ready8(not (bit_and(w, 1u8) == 0u8), not (bit_and(w, 2u8) == 0u8), not (bit_and(w, 4u8) == 0u8), not (bit_and(w, 8u8) == 0u8), not (bit_and(w, 16u8) == 0u8), not (bit_and(w, 32u8) == 0u8), not (bit_and(w, 64u8) == 0u8), not (bit_and(w, 128u8) == 0u8))
  model mem10(m: Ready10, i: U8) -> Bool = ((i == 0u8 and m.p0) or (i == 1u8 and m.p1) or (i == 2u8 and m.p2) or (i == 3u8 and m.p3) or (i == 4u8 and m.p4) or (i == 5u8 and m.p5) or (i == 6u8 and m.p6) or (i == 7u8 and m.p7) or (i == 8u8 and m.p8) or (i == 9u8 and m.p9))
  model put10(m: Ready10, i: U8, b: Bool) -> Ready10 = Ready10(set_at(m.p0, i, 0u8, b), set_at(m.p1, i, 1u8, b), set_at(m.p2, i, 2u8, b), set_at(m.p3, i, 3u8, b), set_at(m.p4, i, 4u8, b), set_at(m.p5, i, 5u8, b), set_at(m.p6, i, 6u8, b), set_at(m.p7, i, 7u8, b), set_at(m.p8, i, 8u8, b), set_at(m.p9, i, 9u8, b))
  model abs_insert10(m: Ready10, t: U8) -> Ready10 = (
    if t >= 10u8 then m else put10(m, t, true))
  model build10(m: Ready10) -> U16 = bit_or(bit_or(bit_or(bit_or(bit_or(bit_or(bit_or(bit_or(bit_or(b2m10(m.p0, 0), b2m10(m.p1, 1)), b2m10(m.p2, 2)), b2m10(m.p3, 3)), b2m10(m.p4, 4)), b2m10(m.p5, 5)), b2m10(m.p6, 6)), b2m10(m.p7, 7)), b2m10(m.p8, 8)), b2m10(m.p9, 9))
  model dec10(w: U16) -> Ready10 = Ready10(not (bit_and(w, 1u16) == 0u16), not (bit_and(w, 2u16) == 0u16), not (bit_and(w, 4u16) == 0u16), not (bit_and(w, 8u16) == 0u16), not (bit_and(w, 16u16) == 0u16), not (bit_and(w, 32u16) == 0u16), not (bit_and(w, 64u16) == 0u16), not (bit_and(w, 128u16) == 0u16), not (bit_and(w, 256u16) == 0u16), not (bit_and(w, 512u16) == 0u16))
  model top8(m: Ready8) -> U8 = (if m.p7 then 7u8 else (if m.p6 then 6u8 else (if m.p5 then 5u8 else (if m.p4 then 4u8 else (if m.p3 then 3u8 else (if m.p2 then 2u8 else (if m.p1 then 1u8 else (if m.p0 then 0u8 else 255u8))))))))

  op insert8(mask: U8, t: U8) -> U8
  op insert10(mask: U16, t: U8) -> U16
  op pick8(mask: U8) -> U8

  example insert8_sets_bit_three:
    insert8(0u8, 3u8) == 8u8
  -- Ids past N change nothing.  11 is 3 modulo 8 and 17 is 1 modulo 16, so an adapter that reduces
  -- the id modulo the word width (the shift-mask fault) would insert here, and these catch it.
  example insert8_ignores_id_eleven:
    insert8(0u8, 11u8) == 0u8
  example insert10_sets_bit_nine:
    insert10(0u16, 9u8) == 512u16
  example insert10_ignores_id_seventeen:
    insert10(0u16, 17u8) == 0u16

  -- E1 knob 256: eight Bool binders.
  claim pick_n8:
    forall b0: Bool, b1: Bool, b2: Bool, b3: Bool, b4: Bool, b5: Bool, b6: Bool, b7: Bool. pick8(build8(Ready8(b0, b1, b2, b3, b4, b5, b6, b7))) == top8(Ready8(b0, b1, b2, b3, b4, b5, b6, b7))
  -- E1 knob 65,536, the eight-Bool form (state built from Bools).
  claim insert_n8_bool:
    forall b0: Bool, b1: Bool, b2: Bool, b3: Bool, b4: Bool, b5: Bool, b6: Bool, b7: Bool, t: U8. insert8(build8(Ready8(b0, b1, b2, b3, b4, b5, b6, b7)), t) == build8(abs_insert8(Ready8(b0, b1, b2, b3, b4, b5, b6, b7), t))
  -- E1 knob 65,536, the `Impl(mask: U8)` form (state is a U8 binder).
  claim insert_n8_mask:
    forall mask: U8, t: U8. insert8(mask, t) == build8(abs_insert8(dec8(mask), t))
  -- E1 knob 262,144: insert at N = 10 (1,024 states times a U8 index).
  claim insert_n10:
    forall b0: Bool, b1: Bool, b2: Bool, b3: Bool, b4: Bool, b5: Bool, b6: Bool, b7: Bool, b8: Bool, b9: Bool, t: U8. insert10(build10(Ready10(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9)), t) == build10(abs_insert10(Ready10(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9), t))
  -- E1 knob 393,216 = 65,536 x 3 x 2: the U8 pair of the Impl form with an Option<Bool> and a Bool.
  claim insert_n8_mask_tagged:
    forall mask: U8, t: U8, o: Option<Bool>, b: Bool. (o == o and b == b) => insert8(mask, t) == build8(abs_insert8(dec8(mask), t))

  -- v1 obligations the checker requires of every operation: labels, hostile inputs and a bound.
  labels insert8:
    mask public
    t public
  labels insert10:
    mask public
    t public
  labels pick8:
    mask public
  input insert8.mask:
    hostile
    ensures no_panic, terminates
  input insert8.t:
    hostile
    ensures no_panic, terminates
  input insert10.mask:
    hostile
    ensures no_panic, terminates
  input insert10.t:
    hostile
    ensures no_panic, terminates
  input pick8.mask:
    hostile
    ensures no_panic, terminates
  bound insert8:
    steps <= 160
  bound insert10:
    steps <= 160
  bound pick8:
    steps <= 160
