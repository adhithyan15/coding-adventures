          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Zeitpunkt joins the inherited Zeit \"time\" and Punkt \"point\", which came from Latin punctum \"a prick, a point\" (EtymDB)."
            }
          ]
        },
