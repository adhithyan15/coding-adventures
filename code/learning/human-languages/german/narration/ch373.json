          "title": "You'll want to know: spontan",
          "segments": [
            {
              "kind": "speech",
              "text": "spontan — \"spontaneous, on the spur of the moment\"."
            },
            {
              "kind": "speech",
              "text": "Wir sind ganz spontan ans Meer gefahren. We drove to the seaside on the spur of the moment."
            },
            {
              "kind": "speech",
              "text": "Very common for plans made at the last minute: Ich bin da ganz spontan."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "spontan goes back to Latin spontāneus \"of one's own accord\" (EtymDB), from sponte \"of one's free will\" (Lewis & Short)."
            }
          ]
        },
