# Perl 5.003_03 (1996-08-28) tokens: verified arithmetic-print subset only.
# @version 1
# PARTIAL: this does not lex all Perl 5.003_03 source.
# Evidence: https://github.com/Perl/perl5/blob/perl-5.003_03/perly.y
# Evidence: https://github.com/Perl/perl5/blob/perl-5.003_03/toke.c
# Tagged perly.y matches 5.003_02; tokenizer changes do not alter KEY_print,
# ADDOP/MULOP or PREDEC/POSTDEC behavior in this bounded subset.

PRINT     = "print"
INT       = /[0-9]+/
PLUS      = "+"
DECREMENT = "--"
MINUS     = "-"
STAR      = "*"
LPAREN    = "("
RPAREN    = ")"
SEMICOLON = ";"

skip:
  WHITESPACE = /[ \t\r\n]+/
