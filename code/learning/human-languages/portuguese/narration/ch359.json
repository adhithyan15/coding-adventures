        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: o gerente",
          "segments": [
            {
              "kind": "speech",
              "text": "o gerente — \"the manager\"."
            },
            {
              "kind": "speech",
              "text": "O gerente da loja resolveu o problema. The shop manager sorted out the problem."
            },
            {
              "kind": "speech",
              "text": "Same form for a woman: a gerente."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "gerente is a learned borrowing from Latin gerēns (EtymDB), the present participle of gerere \"to carry, to carry on, to manage\" (Lewis & Short)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
