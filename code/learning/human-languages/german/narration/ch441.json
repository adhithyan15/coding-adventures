            },
            {
              "kind": "speech",
              "text": "Im Schaufenster stehen schöne Schuhe. There are nice shoes in the shop window."
            },
            {
              "kind": "speech",
              "text": "Same form in the plural. Einen Schaufensterbummel machen — to go window-shopping."
            }
          ]
