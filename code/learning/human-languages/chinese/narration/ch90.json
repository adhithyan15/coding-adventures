        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: 会",
          "segments": [
            {
              "kind": "speech",
              "text": "会 — huì — \"can (having learned how)\"."
            },
            {
              "kind": "speech",
              "text": "我会开车 wǒ huì kāichē — I can drive."
            },
            {
              "kind": "speech",
              "text": "我会说汉语 wǒ huì shuō Hànyǔ — I can speak Chinese."
            }
