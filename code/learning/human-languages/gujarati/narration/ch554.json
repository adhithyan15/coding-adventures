              "responseSeconds": 8,
              "source": "[YOU SAY: *rās*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "jo āje rātre varsād nahī̃ paḍe to āpaṇe rās ramīśũ. — If it doesn't rain tonight, we'll dance raas.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *jo āje rātre varsād nahī̃ paḍe to āpaṇe rās ramīśũ.* — If it doesn't rain tonight, we'll dance raas.]"
