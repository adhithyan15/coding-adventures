          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "dur shodan is built from native dur 'far', which EtymDB traces to Proto-Iranian duHráh 'far' and PIE duh₂-ró-s 'long', and the native verb shodan 'to become'."
            }
          ]
        },
