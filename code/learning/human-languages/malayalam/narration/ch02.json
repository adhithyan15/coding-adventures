        {
          "index": 1,
          "type": "unknown",
          "title": "The phrase, assembled",
          "segments": [
            {
              "kind": "speech",
              "text": "enṟe (my) + pēru (name) + your name + āṇŭ (is)."
            },
            {
              "kind": "speech",
              "text": "എന്റെ (enṟe) പേര് (pēr) … ആണ് = \"my name … is\" = \"my name is…\""
            },
            {
              "kind": "speech",
              "text": "Enṟe pēru Arun āṇŭ. becomes \"My name is Arun.\""
            }
          ]
        },
        {
          "index": 2,
          "type": "grammar",
          "title": "Grammar Lens: verb last",
          "segments": [
            {
              "kind": "speech",
              "text": "Malayalam is subject–object–verb, so āṇŭ (\"is\") sits at the end — \"my name Arun is,\" like Hindi hai and unlike Tamil's verbless eṉ peyar Arun."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
