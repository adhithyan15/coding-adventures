              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *bhūkhā*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "bhūkhā, once more",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *bhūkhā*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "say maiṁ bhūkhā hūṁ",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: say *maiṁ bhūkhā hūṁ*]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say the Hindi for what's going on, then the Hindi for have you eaten, then say bhūkhā again",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say the Hindi for what's going on, then the Hindi for have you eaten, then say *bhūkhā* again]"
            }
          ]
        },
        {
