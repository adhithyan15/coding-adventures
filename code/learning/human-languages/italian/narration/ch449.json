          "index": 1,
          "type": "input",
          "title": "You'll want to know: il condominio",
          "segments": [
            {
              "kind": "speech",
              "text": "il condominio — \"the block of flats; the joint ownership\"."
            },
            {
              "kind": "speech",
              "text": "Nel nostro condominio ci sono venti famiglie. There are twenty families in our block of flats."
            },
            {
              "kind": "speech",
              "text": "La riunione di condominio — the residents' meeting."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "condominio is a learned borrowing from Modern Latin condominium 'joint ownership' (EtymDB), built on dominium 'ownership', from domus 'house'."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
