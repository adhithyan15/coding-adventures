        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "кролик comes from Polish królik, \"little king\", which copies a German dialect Künigl, Middle High German küniklîn, from Latin cunīculus, \"rabbit\", heard as \"little king\" (Vasmer)."
            }
          ]
        },
