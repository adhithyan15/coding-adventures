        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ನಕ್ಷೆ",
          "segments": [
            {
              "kind": "speech",
              "text": "ನಕ್ಷೆ (nakṣe) — \"a map\". The ಕ್ಷ is k and ṣ joined, the same pair as in ಕ್ಷಮಿಸಿ."
            },
            {
              "kind": "speech",
              "text": "ನಕ್ಷೆ ತೋರಿಸಿ (nakṣe tōrisi) — \"please show me the map\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "Something to point at when words run out."
            }
          ]
        },
