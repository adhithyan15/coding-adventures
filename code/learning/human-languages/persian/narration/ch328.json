        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: آتش سوزی",
          "segments": [
            {
              "kind": "speech",
              "text": "آتش سوزی (âtash suzi) — \"a fire, a blaze\"."
            },
            {
              "kind": "speech",
              "text": "دیشب در یک انبار آتش سوزی شد. Dishab dar yek anbâr âtash suzi shod. Last night there was a fire in a warehouse."
            },
            {
              "kind": "speech",
              "text": "âtash \"fire\" + suzi \"burning\", from suz-, the present stem of sukhtan \"to burn\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "âtash \"fire\" is inherited from Middle Persian (EtymDB), and suzi \"burning\" comes from suz-, the present stem of the native verb sukhtan \"to burn\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
