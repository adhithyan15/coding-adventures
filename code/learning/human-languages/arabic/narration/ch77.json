            {
              "kind": "speech",
              "text": "Before the new one: say the Arabic for sand, then the Arabic for a field."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: نجم",
          "segments": [
            {
              "kind": "speech",
              "text": "نجم — najm — \"a star\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "نجم (najm) is built on the native Arabic root n-j-m, \"a star; to rise, to appear\" (Lane). Lane gives najm as a star, and also the Pleiades."
            }
          ]
        },
        {
