          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "beschenken is built on schenken \"to give as a present\", from Old High German scenken \"to pour in, to give drink to\" (EtymDB): first a drink poured for a guest, then any gift."
            }
          ]
        },
