warrant off_by_one_consumed v1
  -- Synthetic document of slice S10o-1 (VER04r 8.2, D36): every shape the fault `off-by-one-consumed`
  -- applies to.  GENERATED by make_off_by_one_consumed.py; do not edit by hand.
  error E = Bad | Worse

  model m_bare_nat(a: Bool, n: Nat) -> (Bool,Nat) = (a, n)
  model m_bare_u8(a: Bool, n: U8) -> (Bool,U8) = (a, n)
  model m_bare_i8(a: Bool, n: I8) -> (Bool,I8) = (a, n)
  model m_dec_u64(v: U64, n: Nat) -> Result<(U64,Nat),E> = if n > 6 then Err(E.Bad) else Ok((v, n))
  model m_dec_i64(v: I64, n: Nat) -> Result<(I64,Nat),E> = if n > 6 then Err(E.Bad) else Ok((v, n))
  model m_dec_u8(a: Bool, n: U8) -> Result<(Bool,U8),E> = if n > 200u8 then Err(E.Bad) else Ok((a, n))
  model m_tri(a: U8, n: Nat, c: Bool) -> (U8,Nat,Bool) = (a, n, c)

  op bare_nat(a: Bool, n: Nat | n < 8) -> (Bool,Nat)
  op bare_u8(a: Bool, n: U8) -> (Bool,U8)
  op bare_i8(a: Bool, n: I8) -> (Bool,I8)
  op dec_u64(v: U64, n: Nat | n < 8) -> Result<(U64,Nat),E>
  op dec_i64(v: I64, n: Nat | n < 8) -> Result<(I64,Nat),E>
  op dec_u8(a: Bool, n: U8) -> Result<(Bool,U8),E>
  op tri(a: U8, n: Nat | n < 8, c: Bool) -> (U8,Nat,Bool)
  assume platform:
    none
  assume environment:
    none
  labels bare_nat:
    a secret
    n secret
  labels bare_u8:
    a secret
    n secret
  labels bare_i8:
    a secret
    n secret
  labels dec_u64:
    v secret
    n secret
  labels dec_i64:
    v secret
    n secret
  labels dec_u8:
    a secret
    n secret
  labels tri:
    a secret
    n secret
    c secret
  input bare_nat.a:
    hostile
    ensures no_panic, terminates
  input bare_nat.n:
    hostile
    ensures no_panic, terminates
  input bare_u8.a:
    hostile
    ensures no_panic, terminates
  input bare_u8.n:
    hostile
    ensures no_panic, terminates
  input bare_i8.a:
    hostile
    ensures no_panic, terminates
  input bare_i8.n:
    hostile
    ensures no_panic, terminates
  input dec_u64.v:
    hostile
    ensures no_panic, terminates
  input dec_u64.n:
    hostile
    ensures no_panic, terminates
  input dec_i64.v:
    hostile
    ensures no_panic, terminates
  input dec_i64.n:
    hostile
    ensures no_panic, terminates
  input dec_u8.a:
    hostile
    ensures no_panic, terminates
  input dec_u8.n:
    hostile
    ensures no_panic, terminates
  input tri.a:
    hostile
    ensures no_panic, terminates
  input tri.n:
    hostile
    ensures no_panic, terminates
  input tri.c:
    hostile
    ensures no_panic, terminates
  bound bare_nat:
    steps <= 64
    heap <= 0
    depth <= 8
  bound bare_u8:
    steps <= 64
    heap <= 0
    depth <= 8
  bound bare_i8:
    steps <= 64
    heap <= 0
    depth <= 8
  bound dec_u64:
    steps <= 64
    heap <= 0
    depth <= 8
  bound dec_i64:
    steps <= 64
    heap <= 0
    depth <= 8
  bound dec_u8:
    steps <= 64
    heap <= 0
    depth <= 8
  bound tri:
    steps <= 64
    heap <= 0
    depth <= 8

  claim c_bare_nat:
    forall a: Bool, n: Nat | n < 8. bare_nat(a, n) == m_bare_nat(a, n)
  claim c_bare_u8:
    forall a: Bool, n: U8. bare_u8(a, n) == m_bare_u8(a, n)
  claim c_bare_i8:
    forall a: Bool, n: I8. bare_i8(a, n) == m_bare_i8(a, n)
  claim c_dec_u64:
    forall v: U64, n: Nat | n < 8. dec_u64(v, n) == m_dec_u64(v, n)
  claim c_dec_i64:
    forall v: I64, n: Nat | n < 8. dec_i64(v, n) == m_dec_i64(v, n)
  claim c_dec_u8:
    forall a: Bool, n: U8. dec_u8(a, n) == m_dec_u8(a, n)
  claim c_tri:
    forall a: U8, n: Nat | n < 8, c: Bool. tri(a, n, c) == m_tri(a, n, c)

