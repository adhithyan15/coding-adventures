          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Latin for a quaestor, then the Latin for a censor."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: suffrāgium, suffrāgiī",
          "segments": [
            {
              "kind": "speech",
              "text": "suffrāgium, suffrāgiī — \"a vote; the right to vote\"."
            },
            {
              "kind": "speech",
              "text": "Cīvēs suffrāgia ferunt. The citizens cast their votes."
            },
            {
              "kind": "speech",
              "text": "suffrāgium, suffrāgiī n. Suffrāgium ferre, to vote. English suffrage."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "The origin of suffrāgium is not settled: Lewis & Short link it, with a \"perhaps\", to suffrāgō \"the hock of a leg\", and EtymDB has no parent for it. English suffrage comes from it."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
