          "segments": [
            {
              "kind": "speech",
              "text": "nachhaltig — \"sustainable; lasting\"."
            },
            {
              "kind": "speech",
              "text": "Wir kaufen nur noch nachhaltige Produkte. We only buy sustainable products now."
            },
            {
              "kind": "speech",
              "text": "Die Nachhaltigkeit — sustainability. Ein nachhaltiger Eindruck — a lasting impression."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "nachhaltig is built on Nachhalt \"something held back, a reserve\", from nach and halten \"to hold\", Proto-Germanic haldaną (EtymDB). It is usually said to have been first a word of forestry, for felling no more trees than grow back."
            }
          ]
        },
