        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: il sindacato",
          "segments": [
            {
              "kind": "speech",
              "text": "il sindacato — \"the trade union\"."
            },
            {
              "kind": "speech",
              "text": "Il sindacato chiede stipendi più alti. The union is asking for higher wages."
            },
            {
              "kind": "speech",
              "text": "A union member is un iscritto al sindacato."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "sindacato is built on sindaco, a learned borrowing from Late Latin syndicus \"a representative of a body\" (Lewis & Short), from Greek sýndikos \"one who helps in court\", built on díkē \"justice\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
