    {
      "id": "SA-C267-exam-time",
      "sequence": 15830,
      "title": "Build one bounded school plan",
      "headword": "(build one bounded school plan)",
      "romanization": "",
      "gloss": "ask when an exam will be, answer, and learn two complete schoolwork frames",
      "script": "devanagari",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:703942805fdba755",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Ask the familiar market question and give its short rupee answer. (Mūlyaṃ kiyat? Viṃśatiḥ rūpyakāṇi.)"
            }
          ]
        },
        {
          "index": 1,
          "type": "grammar",
          "title": "Grammar Lens: four complete turns",
          "segments": [
            {
              "kind": "speech",
              "text": "Put four known pieces together:"
            },
            {
              "kind": "speech",
              "text": "परीक्षा कदा भविष्यति? Parīkṣā kadā bhaviṣyati? When will the exam be?"
            },
            {
              "kind": "speech",
              "text": "Answer from the smallest possible timetable:"
            },
            {
              "kind": "speech",
              "text": "श्वः परीक्षा भविष्यति। Śvaḥ parīkṣā bhaviṣyati. The exam will be tomorrow."
            },
            {
              "kind": "speech",
              "text": "This is one useful school-time pattern. It does not teach a new future paradigm or a complete timetable system. Complete the bounded plan with two whole schoolwork frames:"
            },
            {
              "kind": "speech",
              "text": "गृहकार्यं करिष्यामि। Gṛhakāryaṃ kariṣyāmi. I will do the homework."
            },
            {
              "kind": "speech",
              "text": "पाठं पठिष्यामि। Pāṭhaṃ paṭhiṣyāmi. I will read or study the lesson."
            },
            {
              "kind": "speech",
              "text": "Own those two lines as complete frames. In particular, पाठं belongs to the whole second frame here; do not use it to infer a masculine accusative rule."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": true,
              "source": "[PAUSE 2s each]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "ask when the exam will be",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: ask when the exam will be]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "answer that it will be tomorrow",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: answer that it will be tomorrow]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "the complete homework frame",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: the complete homework frame]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "the complete study frame",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: the complete study frame]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Ask and answer the exam-time turn, then say both complete schoolwork frames from memory."
            }
          ]
        }
      ]
    },
