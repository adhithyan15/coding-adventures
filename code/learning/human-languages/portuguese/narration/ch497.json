        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: brigar",
          "segments": [
            {
              "kind": "speech",
              "text": "brigar — \"to quarrel, to fight\"."
            },
            {
              "kind": "speech",
              "text": "Os irmãos brigam por tudo. The brothers fight over everything."
            },
            {
              "kind": "speech",
              "text": "Very common in Brazil; in Portugal zangar-se and discutir are frequent too."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "EtymDB traces brigar to Gothic brikan \"to break\"; other accounts suggest other sources, so the origin is not fully settled."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
