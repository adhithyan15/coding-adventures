            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Telugu for a bridge, then the Telugu for a park."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: గుడి",
          "segments": [
            {
              "kind": "speech",
              "text": "గుడి — guḍi — \"a temple\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "గుడి (guḍi) is native Dravidian, one word with Tamil kuṭi, \"house\", and Kannada guḍi, \"house, temple\" (DEDR 1655). DEDR compares Sanskrit kuṭī, \"hut\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for this chapter."
