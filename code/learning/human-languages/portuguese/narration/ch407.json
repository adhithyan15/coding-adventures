          "segments": [
            {
              "kind": "speech",
              "text": "a bagageira — \"the boot (of a car)\"."
            },
            {
              "kind": "speech",
              "text": "As malas grandes não cabem na bagageira. The big suitcases do not fit in the boot."
            },
            {
              "kind": "speech",
              "text": "In Brazil: o porta-malas. In Portugal people also say a mala do carro."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "bagageira is built on bagagem 'luggage' with -eira, a place for things; bagagem came from French bagage (EtymDB lists the French word)."
            }
          ]
        },
