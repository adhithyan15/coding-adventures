        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: enttäuschen",
          "segments": [
            {
              "kind": "speech",
              "text": "enttäuschen — \"to disappoint\"."
            },
            {
              "kind": "speech",
              "text": "Der Film hat mich enttäuscht. The film disappointed me."
            },
            {
              "kind": "speech",
              "text": "Enttäuscht sein von — to be disappointed by or in. Inseparable: hat enttäuscht."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "enttäuschen is built on ent- \"away\" and täuschen \"to deceive\", from Middle High German tiuschen (EtymDB); it is usually explained as first meaning \"to free someone from a delusion\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
