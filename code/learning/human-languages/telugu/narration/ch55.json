      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: what did mokka mean?"
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: నది",
          "segments": [
            {
              "kind": "speech",
              "text": "నది (nadi) — \"a river\"."
            },
            {
              "kind": "speech",
              "text": "Sanskrit nadī is the river, and it is built on a piece meaning \"to sound, to roar\". A river is named for the noise it makes, which tells you the people who named it were listening for water before they could see it."
            },
            {
              "kind": "speech",
              "text": "Telugu clipped the long final vowel and says నది (nadi). The inherited Telugu word is ఏరు, a stream, and it survives in place names up and down the country long after it stopped being said on its own."
            },
            {
              "kind": "speech",
              "text": "నది (nadi) is the word you want when asking a stranger which way the water is."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "The first thing you would ask the way to."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "nadi",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *nadi*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "it once more, slowly",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: it once more, slowly]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "nadi, then dayacēsi, and put the two together as a question",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *nadi*, then *dayacēsi*, and put the two together as a question]"
            }
          ]
        },
        {
          "index": 4,
