          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "speech",
              "text": "“I want to stay three nights.”"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "Quiero quedarme tres noches.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *Quiero quedarme tres noches.*]"
            },
            {
              "kind": "speech",
              "text": "“From the fifteenth to the eighteenth of May.”"
