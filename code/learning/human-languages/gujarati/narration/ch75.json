            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Gujarati for up, then the Gujarati for down."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: આગળ",
          "segments": [
            {
              "kind": "speech",
              "text": "આગળ (āgaḷ) — \"ahead, in front\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "આગળ (āgaḷ) is a tadbhava. CDIAL lists it under Sanskrit agra, \"top, front\", among the forms built with an -l- suffix (CDIAL 68)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for ahead, behind, in and out."
            }
          ]
        },
