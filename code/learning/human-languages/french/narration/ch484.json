          "title": "You'll want to know: l'ambulance",
          "segments": [
            {
              "kind": "speech",
              "text": "l'ambulance — \"ambulance\"."
            },
            {
              "kind": "speech",
              "text": "L'ambulance est arrivée en dix minutes. The ambulance arrived in ten minutes."
            },
            {
              "kind": "speech",
              "text": "Feminine: une ambulance. Appeler une ambulance — to call an ambulance."
            }
          ]
        },
