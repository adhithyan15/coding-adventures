          "segments": [
            {
              "kind": "speech",
              "text": "el colectivo — \"the group; collective\"."
            },
            {
              "kind": "speech",
              "text": "Es un colectivo de artistas. It is a collective of artists."
            },
            {
              "kind": "speech",
              "text": "Also a group of people with something in common: el colectivo de jóvenes. In Argentina el colectivo is also the city bus."
            }
          ]
        },
