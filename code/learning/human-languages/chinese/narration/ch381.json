    {
      "id": "ZH-W381-quan-whole",
      "sequence": 29375,
      "title": "全 (quán) — a wide roof, then three bars and a vertical",
      "headword": "全",
      "romanization": "quán",
      "gloss": "全 — a wide roof like 人, then three bars and a vertical",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:5d57631fc2c66083",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — a wide roof, then three bars and a vertical",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — a wide roof, then three bars and a vertical and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say quánjiā — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *quánjiā* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "人 安."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — rén, ān",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *rén*, *ān*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — a wide roof, then three bars and a vertical",
          "segments": [
            {
              "kind": "speech",
              "text": "全 (quán)."
            },
            {
              "kind": "speech",
              "text": "Two pieces, top before bottom."
            },
            {
              "kind": "speech",
              "text": "The roof, two strokes, like 人 opened wide: a long stroke falling to the left, then a long stroke falling to the right from near its top."
            },
            {
              "kind": "speech",
              "text": "Under it, four strokes. A bar. A second bar under it. A vertical down from the first bar through the second. Then a long bar across the foot."
            },
            {
              "kind": "speech",
              "text": "2 + 4 = six."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "全 (quán), all six, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 全, all six, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many strokes in 全 (quán)? (Six.) What is the roof like? (人, opened wide.) Which stroke comes after the two bars? (The vertical.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 全 (quán), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
