              "id": "ES-C56-hablara-why",
              "prompt": "Why does this form have no irregular verbs?",
              "assesses": [
                "ES-GRAMMAR-IMPERFECT-SUBJUNCTIVE-DERIVATION"
              ],
              "responseSeconds": 16,
              "acceptedResponses": [
                "because it is built from the preterite which already absorbed them",
