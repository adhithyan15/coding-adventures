        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: दुःखी",
          "segments": [
            {
              "kind": "speech",
              "text": "दुःखी — duḥkhī — \"sad\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "दुःखी (duḥkhī) is Sanskrit duḥkhin, \"in pain, unhappy\", a tatsama built on duḥkha, \"difficulty, pain\" (CDIAL 6375)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
