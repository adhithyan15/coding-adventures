          "segments": [
            {
              "kind": "speech",
              "text": "शुकः (śukaḥ) — \"a parrot\", the हरितः bird that repeats words."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "MW takes śuka as probably \"the bright one\", from the root √śuc, \"to shine\", after the parrot's green. It is Rigvedic, and lives on as Hindi suwā, \"parrot\" (CDIAL 12503)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "The green bird."
