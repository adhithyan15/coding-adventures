{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coding-adventures.dev/schemas/build-tool-language-source-input-registry-v1.json",
  "title": "Build-tool language source-input registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "universal_inputs", "languages"],
  "properties": {
    "schema_version": {"const": 1},
    "universal_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build_filenames",
        "generated_directory_components",
        "root_exact_basenames"
      ],
      "properties": {
        "build_filenames": {"$ref": "#/$defs/basename_array"},
        "generated_directory_components": {"$ref": "#/$defs/basename_array"},
        "root_exact_basenames": {"$ref": "#/$defs/basename_array"}
      }
    },
    "languages": {
      "type": "array",
      "minItems": 23,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/language_entry"}
    }
  },
  "$defs": {
    "language": {
      "enum": [
        "c", "cpp", "csharp", "dart", "dotnet", "elixir", "fsharp",
        "go", "haskell", "java", "kotlin", "lua", "mosaic", "ocaml",
        "perl", "python", "ruby", "rust", "starlark", "swift", "twig",
        "typescript", "wasm"
      ]
    },
    "suffix": {
      "type": "string",
      "minLength": 2,
      "maxLength": 32,
      "pattern": "^\\.[A-Za-z0-9][A-Za-z0-9._+-]*$"
    },
    "basename": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^/\\\\<>:\"|?*\\u0000-\\u001F]+$"
    },
    "safe_relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)[^<>:\"|?*\\u0000-\\u001F/]+(?:/[^<>:\"|?*\\u0000-\\u001F/]+)*$"
    },
    "suffix_array": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/suffix"}
    },
    "basename_array": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/basename"}
    },
    "path_array": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/safe_relative_path"}
    },
    "case_alias_group": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/basename"}
    },
    "scoped_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "role", "decision", "scope", "suffixes",
        "exact_basenames", "reason", "owner"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "role": {"enum": ["native_companion", "resource"]},
        "decision": {"const": "include"},
        "scope": {"enum": ["root", "subtree"]},
        "path_prefix": {"$ref": "#/$defs/safe_relative_path"},
        "suffixes": {"$ref": "#/$defs/suffix_array"},
        "exact_basenames": {"$ref": "#/$defs/basename_array"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 512},
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "allOf": [
        {
          "if": {"properties": {"scope": {"const": "subtree"}}},
          "then": {"required": ["path_prefix"]},
          "else": {"not": {"required": ["path_prefix"]}}
        },
        {
          "anyOf": [
            {"properties": {"suffixes": {"minItems": 1}}},
            {"properties": {"exact_basenames": {"minItems": 1}}}
          ]
        }
      ]
    },
    "package_exact_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "package_root", "paths", "reason", "owner"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "package_root": {"$ref": "#/$defs/safe_relative_path"},
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/safe_relative_path"}
        },
        "reason": {"type": "string", "minLength": 1, "maxLength": 512},
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      }
    },
    "language_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language", "recursive_suffixes", "recursive_exact_basenames",
        "root_exact_basenames", "root_variable_suffixes",
        "root_exact_relative_paths", "package_exact_inputs",
        "case_alias_groups", "scoped_inputs"
      ],
      "properties": {
        "language": {"$ref": "#/$defs/language"},
        "recursive_suffixes": {"$ref": "#/$defs/suffix_array"},
        "recursive_exact_basenames": {"$ref": "#/$defs/basename_array"},
        "root_exact_basenames": {"$ref": "#/$defs/basename_array"},
        "root_variable_suffixes": {"$ref": "#/$defs/suffix_array"},
        "root_exact_relative_paths": {"$ref": "#/$defs/path_array"},
        "package_exact_inputs": {
          "type": "array",
          "maxItems": 64,
          "items": {"$ref": "#/$defs/package_exact_input"}
        },
        "case_alias_groups": {
          "type": "array",
          "maxItems": 32,
          "items": {"$ref": "#/$defs/case_alias_group"}
        },
        "scoped_inputs": {
          "type": "array",
          "maxItems": 64,
          "items": {"$ref": "#/$defs/scoped_input"}
        }
      }
    }
  }
}
