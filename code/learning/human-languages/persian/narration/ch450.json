          "segments": [
            {
              "kind": "speech",
              "text": "مرکز (markaz) — \"a centre\"."
            },
            {
              "kind": "speech",
              "text": "هتل ما در مرکز شهر است. Hotel-e mâ dar markaz-e shahr ast. Our hotel is in the town centre."
            },
            {
              "kind": "speech",
              "text": "Arabic plural marâkez. Markaz-e kharid — a shopping centre."
            }
          ]
        },
