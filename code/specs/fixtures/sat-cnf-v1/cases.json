{
  "version": 1,
  "cases": [
    {
      "id": "empty_formula_sat",
      "dimacs": "p cnf 2 0\n",
      "steps": [
        {"op": "solve", "assumptions": [], "expect": "sat"}
      ]
    },
    {
      "id": "assumption_satisfies_clause",
      "dimacs": "c x1 or x2\np cnf 2 1\n1 2 0\n",
      "steps": [
        {"op": "solve", "assumptions": [-1], "expect": "sat"}
      ]
    },
    {
      "id": "assumption_conflict_with_irrelevant_and_duplicate",
      "dimacs": "p cnf 3 1\n-1 2 0\n",
      "steps": [
        {"op": "solve", "assumptions": [3, 1, -2, 1], "expect": "unsat"},
        {"op": "solve", "assumptions": [], "expect": "sat"}
      ]
    },
    {
      "id": "known_permanent_contradiction_clears_core",
      "dimacs": "p cnf 1 1\n1 0\n",
      "steps": [
        {"op": "solve", "assumptions": [-1], "expect": "unsat"},
        {"op": "add_clause", "clause": [-1]},
        {"op": "solve", "assumptions": [], "expect": "unsat", "expect_core": []}
      ]
    },
    {
      "id": "nonminimal_but_sound_failed_core",
      "dimacs": "p cnf 3 5\n-1 -2 0\n-1 3 4 0\n-1 3 -4 0\n-1 -3 4 0\n-1 -3 -4 0\n",
      "steps": [
        {"op": "solve", "assumptions": [1, 2], "expect": "unsat"}
      ]
    },
    {
      "id": "empty_clause_unsat",
      "dimacs": "p cnf 0 1\n0\n",
      "steps": [
        {"op": "solve", "assumptions": [], "expect": "unsat", "expect_core": []}
      ]
    },
    {
      "id": "transport_crlf_comments_spanning_and_multiple_clauses",
      "dimacs": "c CRLF, clauses spanning lines and multiple clauses per line\r\np cnf 3 2\r\n1\r\n-2 0 3 0\r\n",
      "steps": [
        {"op": "solve", "assumptions": [], "expect": "sat"}
      ]
    },
    {
      "id": "satlib_terminator_ignores_following_text",
      "dimacs": "p cnf 1 1\n1 0\n%\nmalformed trailing bytes\n",
      "steps": [
        {"op": "solve", "assumptions": [], "expect": "sat"}
      ]
    },
    {
      "id": "negative_zero_terminates_empty_clause",
      "dimacs": "p cnf 0 1\n-0\n",
      "steps": [
        {"op": "solve", "assumptions": [], "expect": "unsat", "expect_core": []}
      ]
    },
    {
      "id": "contradictory_assumptions_and_recovery",
      "dimacs": "p cnf 1 0\n",
      "steps": [
        {"op": "solve", "assumptions": [1, -1], "expect": "unsat"},
        {"op": "solve", "assumptions": [1, 1], "expect": "sat"},
        {"op": "reset"},
        {"op": "solve", "assumptions": [], "expect": "sat"}
      ]
    },
    {
      "id": "zero_budget_unknown_then_unbounded_sat",
      "dimacs": "p cnf 1 0\n",
      "steps": [
        {"op": "solve", "assumptions": [], "budget": {"max_steps": 0}, "expect": "unknown"},
        {"op": "solve", "assumptions": [], "expect": "sat"}
      ]
    },
    {
      "id": "clause_addition_invalidates_model_and_preserves_constraint",
      "dimacs": "p cnf 2 0\n",
      "steps": [
        {"op": "solve", "assumptions": [], "expect": "sat"},
        {"op": "add_clause", "clause": [1]},
        {"op": "solve", "assumptions": [-1], "expect": "unsat"},
        {"op": "solve", "assumptions": [], "expect": "sat"}
      ]
    }
  ]
}
