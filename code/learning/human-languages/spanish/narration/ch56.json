      "title": "grande",
      "headword": "grande",
      "romanization": "grande",
      "gloss": "big — the first word in this book for what something is like, and it does not change for gender",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
