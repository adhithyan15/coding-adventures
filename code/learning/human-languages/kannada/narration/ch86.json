              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *ondu nimiṣa*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "ondu nimiṣa, once more",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *ondu nimiṣa*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "say ondu nimiṣa",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: say *ondu nimiṣa*]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say the Kannada for meaning, then the Kannada for please write it, then say ondu nimiṣa again",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say the Kannada for meaning, then the Kannada for please write it, then say *ondu nimiṣa* again]"
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
