          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ändern from Middle High German endern (EtymDB 2.1), from Old High German antarōn, \"to make other\", built on the word for \"other\", a cousin of English other."
            }
          ]
        },
