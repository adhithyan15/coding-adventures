// Accordion.dark.msl — dark-theme styling.

style Accordion {
  part accordion {
    padding : 0 ;
  }
  part accordion-item {
    padding      : 0 ;
    border-width : 1 ;
    border-color : "#374151" ;
  }
  part accordion-header {
    padding       : 12 ;
    background    : "#111827" ;
    color         : "#f3f4f6" ;
    border-width  : 0 ;
    font-size     : 16 ;
    border-radius : 0 ;
  }
  part accordion-body {
    padding    : 12 ;
    background : "#1f2937" ;
    color      : "#f3f4f6" ;
    font-size  : 14 ;
  }
}
