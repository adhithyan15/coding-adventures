        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: вина",
          "segments": [
            {
              "kind": "speech",
              "text": "вина (viná) — \"guilt, fault, blame\"."
            },
            {
              "kind": "speech",
              "text": "Это не твоя вина. Éto ne tvoyá viná. It is not your fault."
            },
            {
              "kind": "speech",
              "text": "Feminine, stressed on the end. По моей вине — through my fault. Not to be confused with вино, wine."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "вина (viná) is usually traced to Proto-Slavic vina \"guilt, cause\"; it is the root of извиняться \"to apologise\", which asks to be taken out of guilt."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
