          "title": "You'll want to know: naguère",
          "segments": [
            {
              "kind": "speech",
              "text": "naguère — \"not long ago; formerly (literary)\"."
            },
            {
              "kind": "speech",
              "text": "Naguère, ce village était très calme. Not long ago, this village was very quiet."
            },
            {
              "kind": "speech",
              "text": "From n'a guère: it is hardly (long) ago. Many writers now use it for 'formerly'."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "naguère comes from n'a guère \"it is hardly (long)\". Guère is usually traced to a Frankish word meaning \"much\"; the origin is not fully settled (EtymDB lists no parent)."
            }
          ]
        },
