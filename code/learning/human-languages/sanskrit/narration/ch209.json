        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: कविः",
          "segments": [
            {
              "kind": "speech",
              "text": "कविः — kaviḥ — \"a poet\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "kavi is a Rigvedic word for a wise man or seer, and later a poet (CDIAL 2964). MW links it to a root √kū and to kāvya, \"poetry\". Hindi, Telugu and Malayalam took it over as their word for \"poet\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
