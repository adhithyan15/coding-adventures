-- Ops whose result error type and parameter type do not match the model (VER33 4.8).
warrant gate_ops v1
  error GateError = INVALID_INPUT
  error OtherError = OTHER_INVALID
  assume platform:
    none
  assume environment:
    none

  op nand_gate(a: U8, b: U8) -> Result<U8, OtherError>
  op inv_gate(a: Bytes) -> Result<U8, GateError>

  labels nand_gate:
    a public
    b public
  labels inv_gate:
    a public
