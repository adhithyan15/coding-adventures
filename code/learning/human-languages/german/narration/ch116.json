            {
              "kind": "speech",
              "text": "Before the new one: say the German for a washing machine, then the German for an armchair."
            },
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "An alarm clock is for the morning: say der Morgen, then der Tag."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: der Wecker",
          "segments": [
            {
              "kind": "speech",
              "text": "der Wecker — \"an alarm clock\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Wecker is the verb \"to wake someone\" + -er: \"the waker\". The verb from Old High German wecchen from Proto-Germanic wakjaną, a cousin of English wake. (EtymDB 2.1)."
            }
          ]
        },
        {
