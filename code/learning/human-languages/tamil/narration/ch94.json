        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: புரியவில்லை",
          "segments": [
            {
              "kind": "speech",
              "text": "புரியவில்லை (puriyavillai) — \"I don't understand\", literally \"it did not become clear\"."
            },
            {
              "kind": "speech",
              "text": "The most useful sentence a learner owns. It also ends in இல்லை."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "புரியவில்லை (puriyavillai) is puri, \"to become clear\", with native illai, \"not\" (DEDR 2559). As an earlier lesson said, whether this puri is one root with an older puri, \"to do\", is not settled."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "The honest sentence every learner needs."
            }
          ]
        },
        {
          "index": 4,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
