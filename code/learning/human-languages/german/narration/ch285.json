          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "betrügen is inherited from Old High German bitriogan, which EtymDB traces to Proto-Germanic bidreuganą \"to betray, to deceive\"."
            }
          ]
        },
