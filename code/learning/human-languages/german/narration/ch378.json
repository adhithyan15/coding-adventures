        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: die Hausarbeit",
          "segments": [
            {
              "kind": "speech",
              "text": "die Hausarbeit — \"the term paper; housework\"."
            },
            {
              "kind": "speech",
              "text": "Bis Ende März muss ich eine Hausarbeit über die Industrie schreiben. By the end of March I have to write a term paper about industry."
            },
            {
              "kind": "speech",
              "text": "Plural: die Hausarbeiten. It also means housework: die Hausarbeit teilen."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Hausarbeit joins Haus \"house\" to Arbeit \"work\", Old High German arbeit, Proto-Germanic arbaidiz (EtymDB): work done at home."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
