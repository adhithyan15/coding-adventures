{
  "name": "@coding-adventures/jit-core",
  "version": "0.1.0",
  "description": "JIT coordinator for LANG VM modules and backend artifact emission",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc",
    "test": "node node_modules/typescript/bin/tsc -p tsconfig.test.json && node --experimental-transform-types --test dist-test/tests/jit-core.test.js",
    "test:coverage": "node node_modules/typescript/bin/tsc -p tsconfig.test.json && node --experimental-transform-types --experimental-test-coverage --test-coverage-exclude=../** --test-coverage-exclude=tests/** --test-coverage-lines=80 --test dist-test/tests/jit-core.test.js"
  },
  "author": "Adhithya Rajasekaran",
  "license": "MIT",
  "dependencies": {
    "@coding-adventures/interpreter-ir": "file:../interpreter-ir",
    "@coding-adventures/vm-core": "file:../vm-core",
    "@coding-adventures/codegen-core": "file:../codegen-core"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  }
}
