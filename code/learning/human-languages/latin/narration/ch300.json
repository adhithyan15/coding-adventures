        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: tabellārius, tabellāriī",
          "segments": [
            {
              "kind": "speech",
              "text": "tabellārius, tabellāriī — \"a letter-carrier, a courier\"."
            },
            {
              "kind": "speech",
              "text": "Tabellārius epistulam patris ad nōs portāvit. The courier carried father's letter to us."
            },
            {
              "kind": "speech",
              "text": "Masculine. Romans with money sent their own slaves as couriers; letters went on wax tabellae."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "tabellārius is built on tabella, \"a small writing tablet, a letter\" (Lewis & Short): the man who carries the tablets."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
