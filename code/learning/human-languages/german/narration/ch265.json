          "segments": [
            {
              "kind": "speech",
              "text": "mittlerweile — \"by now, in the meanwhile\"."
            },
            {
              "kind": "speech",
              "text": "Mittlerweile wohnt sie in einer größeren Wohnung. By now she lives in a bigger flat."
            },
            {
              "kind": "speech",
              "text": "Close to inzwischen, and a little more conversational."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "mittlerweile is built on mittler \"middle\" and Weile \"a while\", both inherited Germanic words; Weile is a cousin of English while. EtymDB lists no parent for the compound."
            }
          ]
        },
