        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "galea is probably a loan from Greek galeē, \"a weasel, a marten\", for a cap of animal skin; Lewis & Short's comparison with Sanskrit is doubtful."
            }
          ]
        },
