          "segments": [
            {
              "kind": "speech",
              "text": "objecter — \"to object, to say in reply\"."
            },
            {
              "kind": "speech",
              "text": "Elle a objecté que c'était trop cher. She objected that it was too expensive."
            },
            {
              "kind": "speech",
              "text": "Objecter que… — to object that… Formal; in speech many people say je ne suis pas d'accord."
            }
          ]
        },
