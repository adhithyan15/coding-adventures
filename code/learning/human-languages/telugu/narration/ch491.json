            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "ekkuva naḍavaḍantō nā ceppulu arigipōyāyi. — With so much walking, my sandals have worn down.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *ekkuva naḍavaḍantō nā ceppulu arigipōyāyi.* — With so much walking, my sandals have worn down.]"
            },
            {
              "kind": "prompt",
