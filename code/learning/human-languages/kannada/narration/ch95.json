          "segments": [
            {
              "kind": "speech",
              "text": "ಹಾಗಲ್ಲ (hāgalla) is native Dravidian: hāge, \"in that way\" (DEDR 1), and alla, \"is not\" (DEDR 234)."
            }
          ]
        },
