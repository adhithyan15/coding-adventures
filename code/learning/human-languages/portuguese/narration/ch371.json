            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Portuguese for possible, then the Portuguese for possibly."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: prever",
          "segments": [
            {
              "kind": "speech",
              "text": "prever — \"to foresee, to predict\"."
            },
            {
              "kind": "speech",
              "text": "Ninguém previu tanta chuva. Nobody predicted so much rain."
            },
            {
              "kind": "speech",
              "text": "Conjugated like ver: prevejo, prevês, prevê. Estar previsto — to be scheduled."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "prever is built from pre- \"before\" and ver \"to see\", modelled on Latin praevidēre \"to foresee\" (Lewis & Short), on vidēre \"to see\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
            }
          ]
        },
