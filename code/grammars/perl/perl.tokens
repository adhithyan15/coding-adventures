# Token definitions for LANG81's bounded Perl 5.40 print pilot.
# @version 1
# This is a deliberately small Perl-language lexer, not a claim to lex all Perl.

INT       = /[0-9]+/
NAME      = /[a-zA-Z_][a-zA-Z0-9_]*/
PLUS      = "+"
MINUS     = "-"
STAR      = "*"
LPAREN    = "("
RPAREN    = ")"
SEMICOLON = ";"

skip:
  WHITESPACE = /[ \t\r\n]+/
