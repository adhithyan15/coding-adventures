      "id": "TE-C69-saw",
      "sequence": 2290,
      "title": "రంపం (rampaṁ) — a saw",
      "headword": "రంపం",
      "romanization": "rampaṁ",
      "gloss": "a saw",
      "script": "telugu",
      "modality": "voice",
      "derivedModality": "voice",
