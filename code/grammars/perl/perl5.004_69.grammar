# Perl 5.004_69 (1998-06-29) plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: unsupported Perl 5.004_69 syntax is rejected by this grammar.
# Evidence: https://mirrors.develooper.com/perl/historical-perl/perl-5.004_69.tar.gz
# Archive SHA-256: 4ea95f1a46502ac8db0d4631ea77abb55327447356d02a5e82c3f3ac9c0f4828
# Compared with 5.004_68, perly.y and keywords.h are byte-identical.
# scan_num adds hints-guarded constant hooks; plain numeric scanning stays.
# Standalone subset: no pragmas, BEGIN, imports, or hint mutation/overloads.
# Only arithmetic precedence, grouping, and print are represented here.

program         = print_statement { print_statement } ;
print_statement = PRINT LPAREN expr RPAREN SEMICOLON ;
expr            = term { ( PLUS | MINUS ) term } ;
term            = unary { STAR unary } ;
unary           = MINUS unary | atom ;
atom            = INT | LPAREN expr RPAREN ;
