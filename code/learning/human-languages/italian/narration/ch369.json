          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "parlamento is built on parlare \"to speak\", inherited from Late Latin parabolāre (EtymDB), after Old French parlement \"a speaking, a meeting\": the place where people talk."
            }
          ]
        },
