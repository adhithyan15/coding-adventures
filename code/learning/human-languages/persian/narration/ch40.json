              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Persian for to come back, then the Persian for to take away; to win."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: شدن",
          "segments": [
            {
              "kind": "speech",
              "text": "شدن — shodan — \"to become\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "shodan is a native Persian verb, inherited rather than borrowed; it is usually traced to Middle Persian šudan, which meant \"to go\". \"To go\" turning into \"to become\" is a shift English go shows too, as in \"go bad\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for this chapter."
            }
          ]
        },
