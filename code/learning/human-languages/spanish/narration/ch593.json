            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Spanish for the head office, then the Spanish for the branch."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: la tarea",
          "segments": [
            {
              "kind": "speech",
              "text": "la tarea — \"the task; homework\"."
            },
            {
              "kind": "speech",
              "text": "Mi tarea es hablar con los clientes. My task is to talk to the customers."
            },
            {
              "kind": "speech",
              "text": "In Latin America la tarea is also school homework; Spain says los deberes."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "tarea was borrowed from Andalusian Arabic ṭaríḥa, a set amount of work (EtymDB)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
