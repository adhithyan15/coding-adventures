              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Arabic for to empty out, then the Arabic for to confiscate."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: مسافة",
          "segments": [
            {
              "kind": "speech",
              "text": "مسافة — masāfa — \"a distance\"."
            },
            {
              "kind": "speech",
              "text": "المسافة من القرية إلى المدينة قصيرة. al-masāfa min al-qarya ilā al-madīna qaṣīra. The distance from the village to the city is short."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "مسافة (masāfa) is built on the native Arabic root s-w-f, \"to smell\" (Lane). Lane records the old account: a desert guide smelled the ground to know the way, so the stretch he sniffed out was a masāfa."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for getting around."
            }
          ]
        },
        {
          "index": 4,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "masāfa",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *masāfa*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "masāfa, once more",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *masāfa*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "al-masāfa min al-qarya ilā al-madīna qaṣīra. — The distance from the village to the city is short.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *al-masāfa min al-qarya ilā al-madīna qaṣīra.* — The distance from the village to the city is short.]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say the Arabic for to empty out, then the Arabic for to confiscate, then say masāfa again",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say the Arabic for to empty out, then the Arabic for to confiscate, then say *masāfa* again]"
            }
          ]
        },
        {
          "index": 5,
