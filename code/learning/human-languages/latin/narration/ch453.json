      "id": "LA-C453-ductor",
      "sequence": 24130,
      "title": "ductor, ductōris — a leader, one who leads the way; a commander",
      "headword": "ductor, ductōris",
      "romanization": "ductor, ductōris",
      "gloss": "a leader, one who leads the way; a commander",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
