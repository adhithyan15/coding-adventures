# build-tool: deps=swift/conduit rust/conduit-capi
# The dependency declaration must be repeated here: the build tool reads the
# `deps=` directive out of the BUILD file it selects for the current platform,
# so a directive that lives only in BUILD is invisible on Windows and the
# conduit edges silently disappear from the graph.
( cd ..\..\..\packages\rust\conduit-capi && cargo build --release ) && (where swift >/dev/null 2>/dev/null && ( copy ..\..\..\packages\rust\target\release\conduit_capi.lib ..\..\..\packages\swift\conduit\Sources\CConduit\ && swift test ) || echo Swift not available — conduit-capi built, skipping swift test)
