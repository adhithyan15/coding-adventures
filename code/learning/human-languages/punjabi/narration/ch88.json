        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ਨੇੜੇ",
          "segments": [
            {
              "kind": "speech",
              "text": "ਨੇੜੇ — neṛe — \"near\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ਨੇੜੇ (neṛe) is a tadbhava, a word inherited from Sanskrit and reshaped by sound change. It comes from nikaṭam, \"near\" (CDIAL 7136). CDIAL calls a Munda origin unlikely."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for this chapter."
