        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: સ્વાદ",
          "segments": [
            {
              "kind": "speech",
              "text": "સ્વાદ — svād — \"taste, flavour\"."
            },
            {
              "kind": "speech",
              "text": "આ દાળનો સ્વાદ સારો છે. — ā dāḷno svād sāro che — \"This dal tastes good.\""
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "સ્વાદ (svād) is Sanskrit svāda, \"taste, flavour\", taken over whole as a learned loan, a tatsama. CDIAL lists the Sanskrit word but no Gujarati form (CDIAL 13923)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for everyday life at A2."
