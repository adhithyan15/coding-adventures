        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: el matrimonio",
          "segments": [
            {
              "kind": "speech",
              "text": "el matrimonio — \"the marriage; the married couple\"."
            },
            {
              "kind": "speech",
              "text": "Su matrimonio duró cincuenta años. Their marriage lasted fifty years."
            },
            {
              "kind": "speech",
              "text": "Un matrimonio is also a married couple: En el quinto vive un matrimonio mayor."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "matrimonio is a learned borrowing from Latin mātrimōnium 'marriage, wedlock' (EtymDB), built on māter 'mother'."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
