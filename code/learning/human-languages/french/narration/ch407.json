          "title": "You'll want to know: le stationnement",
          "segments": [
            {
              "kind": "speech",
              "text": "le stationnement — \"parking\"."
            },
            {
              "kind": "speech",
              "text": "Le stationnement est interdit devant l'école. Parking is not allowed in front of the school."
            },
            {
              "kind": "speech",
              "text": "Stationnement payant — pay parking."
            }
          ]
        },
        {
