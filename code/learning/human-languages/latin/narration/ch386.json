        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: societās, societātis",
          "segments": [
            {
              "kind": "speech",
              "text": "societās, societātis — \"a partnership, an alliance; society\"."
            },
            {
              "kind": "speech",
              "text": "Cum frātre societātem fēcit. He went into partnership with his brother."
            },
            {
              "kind": "speech",
              "text": "societās, societātis f., built on socius, a partner, an ally. A business partnership in Roman law. English society."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "societās is built on socius \"a partner, an ally\" (EtymDB; Lewis & Short), a word kin to sequor \"to follow\": one who goes along with you. English society comes from it."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
