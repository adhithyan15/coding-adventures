          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: opus, operis",
          "segments": [
            {
              "kind": "speech",
              "text": "opus, operis — \"a work, a task; need (opus est)\"."
            },
            {
              "kind": "speech",
              "text": "Mihi pecūniā opus est. I need money."
            },
            {
              "kind": "speech",
              "text": "opus, operis n. Opus est + dative of the person and ablative of the thing: mihi pecūniā opus est, I need money. English operate comes from its family, and opera comes through Italian from the related opera, effort."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "opus is inherited from a Proto-Indo-European noun built on a root meaning \"to work, to produce\" (EtymDB), with ops \"power, means\" as a cousin (EtymDB; Lewis & Short). English operate comes from its family, and opera from the related opera \"effort\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
            }
          ]
