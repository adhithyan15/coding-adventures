  "lessons": [
    {
      "id": "ES-R01-no-entiendo",
      "sequence": 506,
      "title": "no entiendo — the most useful sentence a beginner owns",
      "headword": "no entiendo",
      "romanization": "no entiendo",
      "gloss": "\"I don't understand\" — the most useful sentence a beginner owns",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:ca5d584e23891eb2",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Everything so far assumed you understood what was said to you. This chapter is for when you did not."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know first",
          "segments": [
            {
              "kind": "speech",
              "text": "No entiendo. — \"I don't understand.\""
            },
            {
              "kind": "speech",
              "text": "Say it whole. You already have no; the rest comes with it for now, and the piece you are not yet meant to take apart will come apart later."
            },
            {
              "kind": "speech",
              "text": "This is not an admission of failure. It is the sentence that keeps a conversation alive — the alternative is nodding at something you did not catch."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "The word hiding inside entiendo comes from Latin intendere — literally to stretch toward. To understand something was to lean into it."
            },
            {
              "kind": "speech",
              "text": "English took the same word and kept it in several places: intend (to stretch your mind toward a thing), intense, and — through the same family — attention, which is what you are stretching when you listen hard."
            },
            {
              "kind": "speech",
              "text": "So no entiendo is, underneath, \"I am not managing to stretch that far yet.\" Which is exactly true, and much kinder than \"I failed.\""
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "\"No entiendo.\" — calmly, not apologetically",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: \"No entiendo.\" — calmly, not apologetically]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "it again, to someone speaking too fast",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: it again, to someone speaking too fast]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Say it once from memory. Which English word shares its root?"
            }
          ]
        }
      ]
    },
    {
      "id": "ES-R02-mas-despacio",
      "sequence": 507,
      "title": "más despacio — the request that makes the last sentence solvable",
      "headword": "más despacio",
      "romanization": "más despacio",
      "gloss": "\"more slowly\" — the request that makes the last sentence solvable",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:8efebaa3a6860d7b",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Everything so far assumed you understood what was said to you. This chapter is for when you did not."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know first",
          "segments": [
            {
              "kind": "speech",
              "text": "Más despacio, por favor. — \"More slowly, please.\""
            },
            {
              "kind": "speech",
              "text": "No entiendo stops the conversation. This restarts it. Together they are the whole repair kit: say what went wrong, then say what would fix it."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Despacio comes from de spatio — \"of space.\" Latin spatium is English space, and also spatial."
            },
            {
              "kind": "speech",
              "text": "Doing something de spatio meant doing it with room around it, unhurried. The sense drifted from space into time, which is a journey English made too: we still say we need space when we mean we need time."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "\"Más despacio.\" — calmly, not apologetically",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: \"Más despacio.\" — calmly, not apologetically]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "it again, to someone speaking too fast",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: it again, to someone speaking too fast]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Say it once from memory. Which English word shares its root?"
            }
          ]
        }
      ]
    },
    {
      "id": "ES-R03-repaso-reparar",
      "sequence": 508,
      "title": "When you don't understand — putting it together",
      "headword": "(practice)",
      "romanization": "(practice)",
      "gloss": "When you don't understand — putting the repair kit together",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:b31bbb2641c73a67",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Two sentences. Between them they rescue almost any conversation."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "The exchange",
          "segments": [
            {
              "kind": "speech",
              "text": "— (something too fast to follow) — No entiendo. Más despacio, por favor. — (again, slower) — Gracias."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "Until now, a sentence you missed was the end of the conversation. It is not any more. You can say what went wrong and what would fix it, and then thank someone for doing it — which is the difference between speaking a language badly and not speaking it at all."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "both sentences, one after the other, without a pause between them",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: both sentences, one after the other, without a pause between them]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "them again, then \"Gracias.\" — the whole repair, start to finish",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: them again, then \"Gracias.\" — the whole repair, start to finish]"
            },
            {
              "kind": "repeat",
              "times": 2,
              "source": "[REPEAT x2]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What do you say when you did not follow? And what do you ask for next? Which English words hide inside entiendo and despacio? (Intend, intense, attention — and space.)"
            }
          ]
        }
      ]
    }
  ],
