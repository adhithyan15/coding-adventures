              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Marathi for education, then the Marathi for a feeling."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: सण",
          "segments": [
            {
              "kind": "speech",
              "text": "सण — saṇ — \"a festival\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "सण (saṇ) is a tadbhava, a word inherited from Sanskrit and reshaped by sound change. It comes from kṣaṇa, \"moment; festival\" (CDIAL 3642). CDIAL glosses the Marathi word \"festival, holiday\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for this chapter."
            }
          ]
        },
        {
          "index": 4,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
