        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: guadagnare",
          "segments": [
            {
              "kind": "speech",
              "text": "guadagnare — \"to earn; to gain\"."
            },
            {
              "kind": "speech",
              "text": "Se lavori il sabato, guadagni di più. If you work on Saturdays, you earn more."
            },
            {
              "kind": "speech",
              "text": "Guadagnarsi da vivere — to earn a living. Guadagnare tempo — to gain time."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "guadagnare comes from a Germanic verb: EtymDB traces it through Vulgar Latin wadanio \"to pursue, to win; to graze\" to Proto-Germanic waiþanjaną (EtymDB). Italian turned the Germanic w- into gu-, as in guerra."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
            }
          ]
        },
