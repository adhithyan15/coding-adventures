          "title": "You'll want to know: el personaje",
          "segments": [
            {
              "kind": "speech",
              "text": "el personaje — \"the character (in a story)\"."
            },
            {
              "kind": "speech",
              "text": "Mi personaje favorito es el abuelo. My favourite character is the grandfather."
            },
            {
              "kind": "speech",
              "text": "Always masculine, even for a woman: el personaje principal."
            }
          ]
        },
