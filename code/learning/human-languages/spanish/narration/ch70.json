            },
            {
              "kind": "speech",
              "text": "Three learned verbs now place g in the yo form: tengo, hago, digo. Compare those three without guessing the form of any unseen verb."
            }
          ]
        },
        {
          "index": 1,
          "type": "grammar",
          "title": "Grammar Lens: one visible corner",
          "segments": [
            {
              "kind": "table-skipped",
