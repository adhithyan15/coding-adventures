        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: കശുവണ്ടി",
          "segments": [
            {
              "kind": "speech",
              "text": "കശുവണ്ടി — kaśuvaṇṭi — \"a cashew nut\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "കശുവണ്ടി (kaśuvaṇṭi) joins kaśu, from Portuguese caju, \"cashew\", a word from the Tupi of Brazil, to native aṇṭi, \"kernel, nut\" (DEDR 126, with Tamil aṇṭi-kkoṭṭai)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for this chapter."
