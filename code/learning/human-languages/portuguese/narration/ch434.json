        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: reclamar",
          "segments": [
            {
              "kind": "speech",
              "text": "reclamar — \"to complain; to claim\"."
            },
            {
              "kind": "speech",
              "text": "Reclamámos do barulho, mas ninguém fez nada. We complained about the noise, but nobody did anything."
            },
            {
              "kind": "speech",
              "text": "Reclamar de — to complain about."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "reclamar is a learned borrowing from Latin reclāmāre 'to cry out against' (EtymDB), built on clāmāre 'to shout'."
            }
          ]
        },
        {
