        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: வன்முறை",
          "segments": [
            {
              "kind": "speech",
              "text": "வன்முறை — vaṉmuṟai — \"violence\"."
            },
            {
              "kind": "speech",
              "text": "நாங்கள் வன்முறையை ஏற்றுக்கொள்ள மாட்டோம். nāṅkaḷ vaṉmuṟaiyai ēṟṟukkoḷḷa māṭṭōm. We will not accept violence."
            },
            {
              "kind": "speech",
              "text": "வல், hard + முறை, way: the hard way."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "வன்முறை (vaṉmuṟai) is native: val, \"strong, hard, forceful\" (DEDR 5276), whose l becomes ன் before m, and muṟai, \"order, way\" (DEDR 5015)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for giving reasons and opinions."
            }
          ]
        },
