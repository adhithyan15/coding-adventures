      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:d13ebb279c3deac0",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — a mouth over an insect",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — a mouth over an insect and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say suīrán — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *suīrán* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "口 然."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — kǒu, rán",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *kǒu*, *rán*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — a mouth over an insect",
          "segments": [
            {
              "kind": "speech",
              "text": "虽 (suī)."
            },
            {
              "kind": "speech",
              "text": "Two pieces, top before bottom. Count the pieces, not the strokes."
            },
            {
              "kind": "speech",
              "text": "The top piece, 口, three strokes, small: a vertical, a horizontal that turns down, the bottom horizontal."
            },
            {
              "kind": "speech",
              "text": "The bottom piece, the insect piece, six strokes: a vertical, a horizontal that turns down, a horizontal closing the small box, a vertical down through it, a stroke rising to the right along the foot, then a dot on the right."
            },
            {
              "kind": "speech",
              "text": "3 + 6 = nine."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "虽 (suī), all nine, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 虽, all nine, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many pieces in 虽 (suī)? (Two.) What is on top? (口.) What is the last stroke? (A dot on the right.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 虽 (suī), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
