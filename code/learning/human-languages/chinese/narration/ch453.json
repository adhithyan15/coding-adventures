        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: bēibāo",
          "segments": [
            {
              "kind": "speech",
              "text": "bēibāo — \"backpack; rucksack\"."
            },
            {
              "kind": "speech",
              "text": "wǒ de bēibāo bú jiàn le — My backpack has gone missing."
            },
            {
              "kind": "speech",
              "text": "Its characters come later; for now it is a word for the ear."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "bēibāo is built from bēi 'to carry on the back' and 包 'a bag', both inherited from Middle Chinese, pwojH and paew (Guangyun, in Baxter's transcription), which glosses the first as the back of the body and the second 'to wrap'; the level-toned bēi 'to carry on the back' is irregular beside it."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for getting around."
