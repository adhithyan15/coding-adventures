          "title": "Guided Practice",
          "segments": [
            {
              "kind": "speech",
              "text": "Say the first four in order, then out of order."
            },
            {
              "kind": "speech",
              "text": "Build, do not recall: fifth, seventh, tenth, twentieth, hundredth, from the cardinals and the ending."
            },
            {
              "kind": "speech",
              "text": "Say which one of the whole series is not built that way, and where it came from."
            },
            {
              "kind": "speech",
              "text": "Write اول (avval) and سوم from memory. Both are made entirely of letters the script chapter taught."
            },
            {
              "kind": "speech",
              "text": "Use one: name the floor a room is on, and the day of the month a notice gives."
            }
          ]
        },
