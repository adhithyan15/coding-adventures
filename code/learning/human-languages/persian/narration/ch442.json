          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "bargardândan is built from bar 'up, back' and gardândan 'to turn something', the causative built on gard-, the present stem of gashtan 'to turn', usually traced to Middle Persian gaštan."
            }
          ]
        },
