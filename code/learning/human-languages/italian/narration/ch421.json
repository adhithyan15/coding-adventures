          "title": "You'll want to know: il molo",
          "segments": [
            {
              "kind": "speech",
              "text": "il molo — \"the pier, the jetty (of stone)\"."
            },
            {
              "kind": "speech",
              "text": "Le barche sono legate al molo. The boats are tied to the pier."
            },
            {
              "kind": "speech",
              "text": "Il molo is built of stone and shelters the harbour."
            }
          ]
        },
