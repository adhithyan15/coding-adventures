  -- claims: one reference claim per model (op_<m>(args) == m(args)) --------------------------------
  claim c_some_u8:
    forall a: U8. op_some_u8(a) == some_u8(a)
  claim c_none_u8:
    forall u: Bool. op_none_u8(u) == none_u8(u)
  claim c_some_nested:
    forall a: Bool. op_some_nested(a) == some_nested(a)
  claim c_some_none:
    forall u: Bool. op_some_none(u) == some_none(u)
  claim c_opt_if:
    forall c: Bool, a: U8. op_opt_if(c, a) == opt_if(c, a)
  claim c_opt_bytes:
    forall d: Bytes. op_opt_bytes(d) == opt_bytes(d)
  claim c_opt_pair:
    forall a: Bool, n: Nat. op_opt_pair(a, n) == opt_pair(a, n)
  claim c_opt_widen_nat:
    forall a: Nat. op_opt_widen_nat(a) == opt_widen_nat(a)
  claim c_opt_eq:
    forall a: Option<U8>, b: Option<U8>. op_opt_eq(a, b) == opt_eq(a, b)
  claim c_opt_ne:
    forall a: Option<Bool>, b: Option<Bool>. op_opt_ne(a, b) == opt_ne(a, b)
  claim c_opt_is_none:
    forall a: Option<U8>. op_opt_is_none(a) == opt_is_none(a)
  claim c_opt_is_some_lit:
    forall a: Option<U8>. op_opt_is_some_lit(a) == opt_is_some_lit(a)
  claim c_unwrap_binder:
    forall o: Option<U8>. op_unwrap_binder(o) == unwrap_binder(o)
  claim c_unwrap_nested:
    forall o: Option<Option<Bool>>. op_unwrap_nested(o) == unwrap_nested(o)
  claim c_inter_add:
    forall a: U8, b: U8. op_inter_add(a, b) == inter_add(a, b)
  claim c_prod_eq:
    forall a: U8, b: U8. op_prod_eq(a, b) == prod_eq(a, b)
  claim c_prod_try:
    forall a: Nat. op_prod_try(a) == prod_try(a)
  claim c_mk_point:
    forall a: U8, b: U8. op_mk_point(a, b) == mk_point(a, b)
  claim c_px:
    forall p: Point. op_px(p) == px(p)
  claim c_mk_wrapped:
    forall a: U8, b: U8, t: Bool. op_mk_wrapped(a, b, t) == mk_wrapped(a, b, t)
  claim c_wrapped_y:
    forall w: Wrapped. op_wrapped_y(w) == wrapped_y(w)
  claim c_mk_slot:
    forall o: Option<U8>, a: Bool. op_mk_slot(o, a) == mk_slot(o, a)
  claim c_slot_t0:
    forall s: Slot. op_slot_t0(s) == slot_t0(s)
  claim c_rec_eq:
    forall a: Tri, b: Tri. op_rec_eq(a, b) == rec_eq(a, b)
  claim c_rec_ne:
    forall a: Duo, b: Duo. op_rec_ne(a, b) == rec_ne(a, b)
  claim c_rec_postfix:
    forall a: U8, b: U8. op_rec_postfix(a, b) == rec_postfix(a, b)
  claim c_mk_wide:
    forall n: Nat, w: U16. op_mk_wide(n, w) == mk_wide(n, w)
  claim c_wide_w:
    forall x: Wide. op_wide_w(x) == wide_w(x)
  claim c_mk_circle:
    forall r: U8. op_mk_circle(r) == mk_circle(r)
  claim c_mk_rect:
    forall w: U8, h: U8. op_mk_rect(w, h) == mk_rect(w, h)
  claim c_mk_dot:
    forall u: Bool. op_mk_dot(u) == mk_dot(u)
  claim c_mk_done:
    forall n: Nat. op_mk_done(n) == mk_done(n)
  claim c_mk_opt_msg:
    forall o: Option<U8>. op_mk_opt_msg(o) == mk_opt_msg(o)
  claim c_var_eq:
    forall a: Dir, b: Dir. op_var_eq(a, b) == var_eq(a, b)
  claim c_var_ne:
    forall a: Dir, b: Dir. op_var_ne(a, b) == var_ne(a, b)
  claim c_var_eq_lit:
    forall a: Dir. op_var_eq_lit(a) == var_eq_lit(a)
  claim c_m_opt:
    forall o: Option<U8>. op_m_opt(o) == m_opt(o)
  claim c_m_opt_wild_arm:
    forall o: Option<U8>. op_m_opt_wild_arm(o) == m_opt_wild_arm(o)
  claim c_m_opt_nested:
    forall o: Option<Option<Bool>>. op_m_opt_nested(o) == m_opt_nested(o)
  claim c_m_opt_tuple:
    forall o: Option<(Bool,Nat)>. op_m_opt_tuple(o) == m_opt_tuple(o)
  claim c_m_bool:
    forall b: Bool. op_m_bool(b) == m_bool(b)
  claim c_m_tuple_bool:
    forall t: (Bool,Bool). op_m_tuple_bool(t) == m_tuple_bool(t)
  claim c_m_point:
    forall p: Point. op_m_point(p) == m_point(p)
  claim c_m_wrapped:
    forall w: Wrapped. op_m_wrapped(w) == m_wrapped(w)
  claim c_m_slot:
    forall s: Slot. op_m_slot(s) == m_slot(s)
  claim c_m_shape:
    forall s: Shape. op_m_shape(s) == m_shape(s)
  claim c_m_mode:
    forall o: Mode. op_m_mode(o) == m_mode(o)
  claim c_m_msg:
    forall m: Msg. op_m_msg(m) == m_msg(m)
  claim c_m_dir_bind:
    forall d: Dir. op_m_dir_bind(d) == m_dir_bind(d)
  claim c_m_res_opt:
    forall r: Result<Option<U8>,DataError>. op_m_res_opt(r) == m_res_opt(r)
  claim c_m_res_rec:
    forall r: Result<Point,DataError>. op_m_res_rec(r) == m_res_rec(r)
  claim c_m_inner:
    forall o: Option<U8>, b: Bool. op_m_inner(o, b) == m_inner(o, b)
  claim c_tri:
    forall data: U8, enable: U8. op_tri(data, enable) == m_tri(data, enable)
  claim c_pick:
    forall o: Option<U8>, a: U8. op_pick(o, a) == m_pick(o, a)
  claim c_adder:
    forall a: Bytes, b: Bytes. op_adder(a, b) == m_adder(a, b)
  claim c_adder_n:
    forall n: U8, a: Bytes. op_adder_n(n, a) == m_adder_n(n, a)
  claim c_alu:
    forall a: Bytes, m: Mode. op_alu(a, m) == m_alu(a, m)
  claim c_holder:
    forall n: Nat. op_holder(n) == m_holder(n)
  claim c_pr:
    forall n: Nat. op_pr(n) == m_pr(n)
  claim c_dir_res:
    forall a: U8, d: Dir. op_dir_res(a, d) == m_dir_res(a, d)

  -- claims: data inline in the pure side, a subject call in an arm and as the scrutinee -------------
  claim c_inline_match:
    forall o: Option<U8>. op_m_opt(o) == (match o with Some(x) -> x | None -> 0u8)
  claim c_inline_ctor:
    forall a: U8, b: U8. op_mk_point(a, b) == Point(a, b)
  claim c_inline_field:
    forall p: Point. op_px(p) == p.x
  claim c_arm_calls:
    forall o: Option<U8>. match o with Some(x) -> op_px(Point(x, x)) == x | None -> true
  claim c_scrutinee_calls:
    forall a: U8. match op_some_u8(a) with Some(x) -> x == a | None -> false
  claim c_option_binder_compare:
    forall o: Option<U8>. op_opt_is_none(o) == (o == None)
  claim c_adder_computed:
    forall a: Bytes, b: Bytes. op_adder(concat(a, b), a) == m_adder(concat(a, b), a)
  claim c_adder_err_only:
    forall a: Bytes, b: Bytes | len(a) != len(b). op_adder(a, b) == m_adder(a, b)

  -- examples: Option, record and variant values in JSON and TFV -----------------------------------
  example e_some:
    op_some_u8(7u8) == Some(7u8)
  example e_none:
    op_none_u8(true) == None
  example e_nested:
    op_some_nested(true) == Some(Some(true))
  example e_some_none:
    op_some_none(true) == Some(None)
  example e_pair:
    op_opt_pair(true, 4) == Some((true, 4))
  example e_point:
    op_mk_point(1u8, 2u8) == Point(1u8, 2u8)
  example e_wrapped:
    op_mk_wrapped(1u8, 2u8, true) == Wrapped(Point(1u8, 2u8), true)
  example e_slot:
    op_mk_slot(Some(9u8), true) == Slot(Some(9u8), (true, 2))
  example e_wide:
    op_mk_wide(3, 65535u16) == Wide(65535u16, 3)
  example e_circle:
    op_mk_circle(3u8) == Circle(3u8)
  example e_rect:
    op_mk_rect(3u8, 4u8) == Rect(3u8, 4u8)
  example e_dot:
    op_mk_dot(true) == Dot
  example e_done:
    op_mk_done(5) == Done(5, None)
  example e_opt_msg:
    op_mk_opt_msg(Some(1u8)) == Opt(Some(1u8))
  example e_ok_record:
    op_adder(b"01", b"02") == Ok(Sum(b"01", 3u8, true))
  example e_err:
    op_adder(b"01", b"") == Err(DataError.Bad)
  example e_ok_option:
    op_tri(7u8, 1u8) == Ok(Some(7u8))
  example e_ok_none:
    op_tri(7u8, 0u8) == Ok(None)
  example e_ok_tuple:
    op_pr(1) == Ok((take(b"0102", 1), false))
  example e_ok_holder:
    op_holder(3) == Ok(Holder(take(b"00ff", 3), (take(b"ff", 3), true)))
  example e_arg_record:
    op_px(Point(4u8, 5u8)) == 4u8
  example e_arg_variant:
    op_m_shape(Rect(1u8, 2u8)) == 3u8
  example e_arg_option:
    op_unwrap_binder(Some(8u8)) == 8u8

