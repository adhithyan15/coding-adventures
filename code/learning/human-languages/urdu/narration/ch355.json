        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: تعریف",
          "segments": [
            {
              "kind": "speech",
              "text": "تعریف — tārīf — \"praise\"."
            },
            {
              "kind": "speech",
              "text": "استاد نے سارا کی تعریف کی۔ ustād ne sārā kī tārīf kī. The teacher praised Sara."
            },
            {
              "kind": "speech",
              "text": "Feminine."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "تعریف (tārīf) is usually traced, through Persian, to Arabic taʿrīf, \"making known, description\"; Urdu uses it for describing someone well, \"praise\"."
            }
          ]
        },
        {
