# Perl 5.004_61 (1998-02-27) plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: unsupported Perl 5.004_61 syntax is rejected.
# Evidence: https://mirrors.develooper.com/perl/historical-perl/perl-5.004_61.tar.gz
# Archive SHA-256: ddddc1b0c5b832c9337691e70c585a98010d66a65fd68df171722a3292310347
# Its perly.y matches 5.004_60 byte for byte; only the bounded subset is modeled.
# Only arithmetic precedence, grouping, and print are represented here.

program         = print_statement { print_statement } ;
print_statement = PRINT LPAREN expr RPAREN SEMICOLON ;
expr            = term { ( PLUS | MINUS ) term } ;
term            = unary { STAR unary } ;
unary           = MINUS unary | atom ;
atom            = INT | LPAREN expr RPAREN ;
