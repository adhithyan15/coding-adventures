      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Say ఛాయ (chāya) once. What does it mean? (\"Shade\" or \"shadow.\")"
            },
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "speech",
              "text": "Now slow the first piece: chā. The base letter carrying that airy ch is today's whole task."
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script you'll notice: ఛ",
          "segments": [
            {
              "kind": "speech",
              "text": "ఛ — cha."
            },
            {
              "kind": "speech",
              "text": "In ఛాయ (chāya), the long ా sign turns the base sound into ఛా. Remove that vowel sign and the base letter is ఛ (cha)."
            },
            {
              "kind": "speech",
              "text": "This aspirated letter is uncommon in everyday Telugu vocabulary. That is why the book gave you ఛాయ (chāya) before asking you to practise the shape."
            }
          ]
        },
        {
          "index": 2,
          "type": "writing",
          "title": "Writing: ఛ — five movements, two runs",
          "segments": [
            {
              "kind": "speech",
              "text": "Follow the filmstrip slowly. Movements 1–4 stay joined: draw the short upper bar, turn around the left bowl, sweep around the broad outer bowl, and continue through the upper flourish. Lift once. Movement 5 draws the separate stem downward below the middle."
            },
            {
              "kind": "speech",
              "text": "The numbered route is one attested school-style order; Telugu handwriting can vary. Keep the two pen-down runs distinct and let the long curves stay round."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "TRACE",
              "instruction": "ఛ (cha) once, following the five numbered movements",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU TRACE: **ఛ** once, following the five numbered movements]"
            },
            {
              "kind": "prompt",
              "action": "COPY",
              "instruction": "ఛ (cha) twice without tracing",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COPY: **ఛ** twice without tracing]"
            },
            {
              "kind": "prompt",
              "action": "BUILD",
              "instruction": "ఛ (cha) + ా = ఛా",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
