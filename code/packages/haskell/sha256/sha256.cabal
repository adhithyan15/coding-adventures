cabal-version: 3.0
name:          sha256
version:       0.2.0
synopsis:      SHA-256 cryptographic hash function (FIPS 180-4) implemented from scratch
description:
    A pure SHA-256 implementation with compatible list-based one-shot helpers.
    It also provides an opaque immutable context for bounded incremental hashing
    over strict ByteString chunks, repeatable finalization, and safe branching.
category:      Cryptography
license:       MIT
author:        Adhithya Rajasekaran
maintainer:    Adhithya Rajasekaran
build-type:    Simple
extra-doc-files: README.md
               CHANGELOG.md

library
    exposed-modules:  Sha256
    other-modules:    Sha256.Internal
    build-depends:    base >=4.14 && <5
                    , bytestring >=0.10 && <0.13
    hs-source-dirs:   src
                      internal
    default-language: Haskell2010

test-suite spec
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    other-modules:    Sha256Spec
                      Sha256.Internal
    hs-source-dirs:   test
                      internal
    build-depends:    base >=4.14 && <5
                    , sha256
                    , hspec == 2.*
                    , bytestring >=0.10 && <0.13
    default-language: Haskell2010

test-suite allocation-budget
    type:             exitcode-stdio-1.0
    main-is:          AllocationBudget.hs
    hs-source-dirs:   test
    build-depends:    base >=4.14 && <5
                    , sha256
                    , bytestring >=0.10 && <0.13
    ghc-options:      -O2 -Wall -Werror -rtsopts -with-rtsopts=-T
    default-language: Haskell2010
