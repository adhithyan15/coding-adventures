{
  "schema_version": 1,
  "id": "resolution/gradle-kotlin-field-aware",
  "domain": "resolution",
  "summary": "Kotlin Gradle resolution reads only same-lane relative includeBuild calls from settings.gradle.kts and ignores comments, strings, and build-script coordinates.",
  "platforms": [
    "darwin",
    "linux",
    "windows"
  ],
  "capabilities": [
    "resolution"
  ],
  "workspace": {
    "files": [
      {
        "path": "code/packages/kotlin/alpha/BUILD",
        "content_utf8": "echo build alpha\n"
      },
      {
        "path": "code/packages/kotlin/alpha/settings.gradle.kts",
        "content_utf8": "rootProject.name = \"alpha\"\nincludeBuild(\"../beta-helper\")\n/* includeBuild(\"../gamma\") */\nval example = \"includeBuild(\\\"../gamma\\\")\"\ninclude(\"../gamma\")\nincludeBuild(\"/tmp/gamma\")\nincludeBuild(\"../../java/gamma\")\n"
      },
      {
        "path": "code/packages/kotlin/alpha/build.gradle.kts",
        "content_utf8": "val documentedDependency = \"gamma\"\n"
      },
      {
        "path": "code/packages/kotlin/beta-helper/BUILD",
        "content_utf8": "echo build beta-helper\n"
      },
      {
        "path": "code/packages/kotlin/beta-helper/settings.gradle.kts",
        "content_utf8": "rootProject.name = \"beta-helper\"\n"
      },
      {
        "path": "code/packages/kotlin/gamma/BUILD",
        "content_utf8": "echo build gamma\n"
      },
      {
        "path": "code/packages/kotlin/gamma/settings.gradle.kts",
        "content_utf8": "rootProject.name = \"gamma\"\n"
      },
      {
        "path": "code/packages/java/gamma/BUILD",
        "content_utf8": "echo build cross-lane gamma\n"
      },
      {
        "path": "code/packages/java/gamma/settings.gradle.kts",
        "content_utf8": "rootProject.name = \"cross-lane-gamma\"\n"
      },
      {
        "path": "code/programs/kotlin/delta-app/BUILD",
        "content_utf8": "echo build delta-app\n"
      },
      {
        "path": "code/programs/kotlin/delta-app/settings.gradle.kts",
        "content_utf8": "rootProject.name = \"delta-app\"\nincludeBuild(\n    \"../../../../code/packages/kotlin/alpha\"\n)\n// includeBuild(\"../../../../code/packages/kotlin/gamma\")\n"
      },
      {
        "path": "code/programs/kotlin/delta-app/build.gradle.kts",
        "content_utf8": "dependencies { implementation(\"com.codingadventures:alpha\") }\n"
      }
    ]
  },
