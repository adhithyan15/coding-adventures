          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "intervallum joins inter, \"between\", and vallum, \"rampart, palisade\" (EtymDB): the space between the stakes. English interval comes from it through French."
            }
          ]
        },
