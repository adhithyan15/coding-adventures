    {
      "id": "ZH-W108-shi-try",
      "sequence": 8465,
      "title": "试 (shì) — the speech piece, then a slanting hook",
      "headword": "试",
      "romanization": "shì",
      "gloss": "试 — the speech piece, then a slanting hook",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:d33f2bf0b61bc378",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — the speech piece, then a slanting hook",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — the speech piece, then a slanting hook and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say shì — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *shì* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "说 请."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — shuō, qǐng",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *shuō*, *qǐng*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — the speech piece, then a slanting hook",
          "segments": [
            {
              "kind": "speech",
              "text": "试 (shì)."
            },
            {
              "kind": "speech",
              "text": "Two pieces, left before right. Count the pieces, not the strokes."
            },
            {
              "kind": "speech",
              "text": "The speech piece, two strokes, as in 说: a dot, then a stroke across that turns down and rises."
            },
            {
              "kind": "speech",
              "text": "The right piece, six strokes: a horizontal across the top; then, low on the left, a short horizontal, a vertical and a stroke that rises to the right; then one long stroke that slants down to the right and hooks up; and last a dot at the top right."
            },
            {
              "kind": "speech",
              "text": "2 + 6 = eight."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "试 (shì), all eight, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 试, all eight, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many pieces in 试 (shì)? (Two — the speech piece, then the right piece.) Which characters you know start with the same piece? (说, 请, 课.) Which stroke comes last? (The dot at the top right.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 试 (shì), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
