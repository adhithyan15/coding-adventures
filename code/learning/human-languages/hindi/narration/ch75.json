    {
      "id": "HI-C68-english",
      "sequence": 2650,
      "title": "अंग्रेज़ी (angrezī) — English, the language",
      "headword": "अंग्रेज़ी",
      "romanization": "angrezī",
      "gloss": "English, the language",
      "script": "devanagari",
      "modality": "voice",
