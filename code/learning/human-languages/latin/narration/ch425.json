        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: crepīdō, crepīdinis",
          "segments": [
            {
              "kind": "speech",
              "text": "crepīdō, crepīdinis — \"a raised edge; a kerb, a raised footway; a quay\"."
            },
            {
              "kind": "speech",
              "text": "Viātōrēs in crepīdine ambulant, plaustra in mediā viā eunt. The travellers walk on the raised footway, the wagons go in the middle of the road."
            },
            {
              "kind": "speech",
              "text": "Third declension, feminine: crepīdō, crepīdinis f. Any raised edge: the kerb of a street, the base of a building, the stone edge of a quay."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "crepīdō was borrowed from Greek krēpis, krēpidos 'foundation, base' (EtymDB; Lewis & Short). The Greek word also meant a kind of boot, the source of Latin crepida 'sandal'."
            }
          ]
        },
        {
