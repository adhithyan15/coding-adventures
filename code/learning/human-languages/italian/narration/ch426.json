        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: il trolley",
          "segments": [
            {
              "kind": "speech",
              "text": "il trolley — \"the wheeled suitcase\"."
            },
            {
              "kind": "speech",
              "text": "Porto solo un trolley piccolo. I am taking only a small wheeled case."
            },
            {
              "kind": "speech",
              "text": "An English word with an Italian meaning: in English a trolley is a cart."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "trolley was borrowed from English trolley 'a small cart', and in Italian it came to mean a suitcase on wheels."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
