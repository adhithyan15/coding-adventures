        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The stem? (Dij-.) The they form? (Dijeron — no i.)"
            },
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "And is that an exception you must memorise for this one verb, or a rule? (A rule, for every strong stem that ends in j.)"
            }
          ]
        }
