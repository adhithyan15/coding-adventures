          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "அபாயம் (apāyam) is borrowed from Sanskrit apāya, \"departure, death, misfortune\" (CDIAL 481), with the Tamil ending -அம்."
            }
          ]
        },
