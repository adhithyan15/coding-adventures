        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:66d90da5cfda6cf6",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Say Aman bought a book. Then he, she, ਉਹ, and the familiar ਉਸ."
            }
          ]
        },
        {
          "index": 1,
          "type": "grammar",
          "title": "Grammar Lens: ਉਹ turns into ਉਸ",
          "segments": [
            {
              "kind": "speech",
              "text": "Before ਨੇ, ਉਹ turns into ਉਸ. The verb still agrees with the thing:"
            },
            {
              "kind": "speech",
              "text": "ਉਸ ਨੇ ਦੁੱਧ ਪੀਤਾ। — us ne duddh pītā. — He drank milk; she drank milk."
            },
            {
              "kind": "speech",
              "text": "ਉਸ ਨੇ ਕਿਤਾਬ ਖ਼ਰੀਦੀ। — us ne kitāb kharīdī. — He bought a book; she bought a book."
            },
            {
              "kind": "speech",
              "text": "So ਉਸ ਨੇ (us ne) can mean he or she: the sentence does not say which."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "HEAR",
              "instruction": "she ate a roti",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU HEAR: *she ate a roti*]"
            },
            {
              "kind": "speech",
              "text": "Say ਉਸ ਨੇ (us ne) ਰੋਟੀ ਖਾਧੀ।."
            },
            {
              "kind": "prompt",
              "action": "HEAR",
              "instruction": "he drank tea",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU HEAR: *he drank tea*]"
            },
            {
              "kind": "speech",
              "text": "Say ਉਸ ਨੇ (us ne) ਚਾਹ ਪੀਤੀ।."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "ਉਸ ਨੇ (us ne) ਦੁੱਧ ਪੀਤਾ।",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: **ਉਸ ਨੇ ਦੁੱਧ ਪੀਤਾ।**]"
            },
            {
              "kind": "speech",
              "text": "Give its meaning."
            },
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "copy ਉਸ ਨੇ (us ne) once",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: copy **ਉਸ ਨੇ** once]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "He before ਨੇ? (ਉਸ.) He went? (ਉਹ ਗਿਆ, with no ਨੇ.)"
            }
          ]
        }
      ]
    },
