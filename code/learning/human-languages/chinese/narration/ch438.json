    {
      "id": "ZH-W438-bu-part",
      "sequence": 33425,
      "title": "部 (bù) — five strokes over 口, then the right piece of 那",
      "headword": "部",
      "romanization": "bù",
      "gloss": "部 — five strokes over 口 on the left, then the right piece of 那",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:3a28e9dc7c62611c",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — five strokes over 口, then the right piece of 那",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — five strokes over 口, then the right piece of 那 and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say běibù — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *běibù* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "那 口."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — nà, kǒu",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *nà*, *kǒu*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — five strokes over 口, then the right piece of 那",
          "segments": [
            {
              "kind": "speech",
              "text": "部 (bù)."
            },
            {
              "kind": "speech",
              "text": "Two pieces, left before right. Count the pieces, not the strokes."
            },
            {
              "kind": "speech",
              "text": "The left piece, eight strokes, in two parts. On top, five strokes: a dot, a bar, then a short dot on the left and a short stroke falling to the left on the right, and a long bar under them. Under them, 口 kǒu, three strokes."
            },
            {
              "kind": "speech",
              "text": "The right piece, two strokes, as on the right of 那: a stroke that runs right, bends back and curls down to a hook, then a long vertical."
            },
            {
              "kind": "speech",
              "text": "5 + 3 + 2 = ten."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "部 (bù), all ten, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 部, all ten, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many strokes in 部 (bù)? (Ten.) What sits under the five strokes on top? (口.) Where has your hand made the right piece before? (On the right of 那.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 部 (bù), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
