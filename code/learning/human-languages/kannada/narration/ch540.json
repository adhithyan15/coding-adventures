        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ಕಬಡ್ಡಿ",
          "segments": [
            {
              "kind": "speech",
              "text": "ಕಬಡ್ಡಿ — kabaḍḍi — \"kabaddi\"."
            },
            {
              "kind": "speech",
              "text": "ಹಳ್ಳಿಯ ಹುಡುಗರು ಮೈದಾನದಲ್ಲಿ ಕಬಡ್ಡಿ ಆಡುತ್ತಾರೆ. haḷḷiya huḍugaru maidānadalli kabaḍḍi āḍuttāre. The village boys play kabaddi on the ground."
            },
            {
              "kind": "speech",
              "text": "A raider holds his breath, chants, and tags players on the other side."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ಕಬಡ್ಡಿ (kabaḍḍi) is the name of a team game of south Asia; the origin of the name is not settled."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for describing what you lived and felt."
            }
          ]
        },
