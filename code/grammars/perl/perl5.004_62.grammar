# Perl 5.004_62 (1998-03-06) plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: unsupported Perl 5.004_62 syntax is rejected by this grammar.
# Evidence: https://mirrors.develooper.com/perl/historical-perl/perl-5.004_62.tar.gz
# Archive SHA-256: 18a6f01ee34399326376c5132d0acbc0fc13d198ec9de17e50f6650f39ec3b82
# Its perly.y adds expr FOR expr; that form is outside this bounded subset.
# Only arithmetic precedence, grouping, and print are represented here.

program         = print_statement { print_statement } ;
print_statement = PRINT LPAREN expr RPAREN SEMICOLON ;
expr            = term { ( PLUS | MINUS ) term } ;
term            = unary { STAR unary } ;
unary           = MINUS unary | atom ;
atom            = INT | LPAREN expr RPAREN ;
