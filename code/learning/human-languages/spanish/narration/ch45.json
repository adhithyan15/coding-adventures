      "title": "Hablas español, Quiero que hables español — fact or wanted event?",
      "headword": "Hablas español · Quiero que hables español",
      "romanization": "Hablas español · Quiero que hables español",
      "gloss": "an asserted event beside a wanted, not-yet-real event",
      "script": "latin",
