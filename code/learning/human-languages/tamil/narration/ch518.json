        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: நிரல்",
          "segments": [
            {
              "kind": "speech",
              "text": "நிரல் — niral — \"a computer program\"."
            },
            {
              "kind": "speech",
              "text": "என் தம்பி கணினியில் ஒரு சிறிய நிரல் எழுதினான். eṉ tampi kaṇiṉiyil oru ciṟiya niral eḻutiṉāṉ. My younger brother wrote a small program on the computer."
            },
            {
              "kind": "speech",
              "text": "The one who writes them is a நிரலாளர், a programmer."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "நிரல் (niral) is native Dravidian: DEDR 3673 gives நிரல் (niral), \"to be placed in a row, in order\"; a program is a row of steps in order."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for describing what you lived and felt."
            }
          ]
        },
