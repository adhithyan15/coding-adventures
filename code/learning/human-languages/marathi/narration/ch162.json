        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "The origin of पेटवणे (petavṇe) is not settled. Neither CDIAL nor DEDR, searched by form and by meaning, has an entry for it."
            }
          ]
        },
