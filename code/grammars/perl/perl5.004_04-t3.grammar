# Perl 5.004_04-t3 (1997-10-10) grammar: plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: unsupported Perl 5.004_04-t3 syntax is rejected.
# Evidence: https://mirrors.develooper.com/perl/historical-perl/perl-5.004_04-t3.tar.gz
# Archive SHA-256: 3337caa03309b6f772dedde87b40600c04911e795cf64c9efa6949a9c2cae744
# Historical perly.y shares the 5.004_04 trial/final yacc source;
# loop source-line changes are outside this subset.
# This separate file retains arithmetic precedence, parentheses, and print only.

program         = print_statement { print_statement } ;
print_statement = PRINT LPAREN expr RPAREN SEMICOLON ;
expr            = term { ( PLUS | MINUS ) term } ;
term            = unary { STAR unary } ;
unary           = MINUS unary | atom ;
atom            = INT | LPAREN expr RPAREN ;
