              "source": "[YOU SAY: *Iterum Rōmam vidēre cupiō, et spērō tē venīre.*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "a place you have been: when, for how long, and what was bigger or better than you expected",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: a place you have been: when, for how long, and what was bigger or better than you expected]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Say \"two years ago\". (Abhinc duōs annōs.) Say \"for ten days\". (Decem diēs.) Say \"better\". (Melior.) A woman says \"I was happy\". (Laeta eram.)"
            }
          ]
        }
      ]
    }
