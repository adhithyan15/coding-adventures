          "index": 1,
          "type": "input",
          "title": "You'll want to know: meritum, meritī",
          "segments": [
            {
              "kind": "speech",
              "text": "meritum, meritī — \"a kindness, service; merit\"."
            },
            {
              "kind": "speech",
              "text": "Prō meritīs tuīs tibi grātiās agō. I thank you for your kindnesses."
            },
            {
              "kind": "speech",
              "text": "Neuter, second declension, from mereō — to earn. A good deed that deserves thanks. English merit."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "meritum is the neuter past participle of mereō \"to earn, deserve\", used as a noun (Lewis & Short; EtymDB). English merit comes from it."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
