      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Two verbs for to be. Which is for what a thing is? (Ser.) Which is for how it is right now? (Estar.)"
            }
          ]
        },
        {
          "index": 1,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "You met ser and estar as a pair long before this book had a single word to put after them. Now it does, and the pair finally does its job:"
            },
            {
              "kind": "table",
              "headers": [
                "",
                ""
              ],
              "columns": 2,
              "rowCount": 3,
              "utterances": [
                "La casa es grande., The house is big — that is what it is.",
                "Estoy cansado., I am tired — today.",
                "Soy profesor., I am a teacher — and no un."
              ]
            },
            {
              "kind": "speech",
              "text": "Three sentences, three different jobs for to be, and nothing memorised as a phrase."
            }
          ]
        },
        {
          "index": 2,
          "type": "grammar",
          "title": "Grammar Lens: which words shift",
          "segments": [
            {
              "kind": "speech",
              "text": "The ending tells you, and you now have one of each:"
            },
            {
              "kind": "table",
              "headers": [
                "ending",
                "shifts?",
                "example"
              ],
              "columns": 3,
              "rowCount": 3,
              "utterances": [
                "ending: -o. shifts?: yes. example: cansado becomes cansada.",
                "ending: -e. shifts?: no. example: grande stays grande.",
                "ending: -ista, -ante. shifts?: no. example: artista, estudiante."
              ]
            },
            {
              "kind": "speech",
              "text": "So you never have to guess. Look at the last letter."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "La casa es grande",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *La casa es grande*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
