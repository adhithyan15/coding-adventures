warrant enum_probe v1
  -- Suites that exercise the S3b evaluator and enumeration: wraps, refinements on a prefix and on the last binder, pure guards, call counts, Result and Nat results, 16/32/64-bit binders.
  error E = BAD
  model cutm(a: Bytes, b: Bytes) -> Bytes = concat(drop(take(a, 4), 1), take(b, len(a) + 1))
  model cut2(a: Bytes, b: Bytes) -> Bytes = concat(take(a, len(a) - len(b)), concat(drop(b, len(b) - 1), b"00ff"))
  model sel(a: U8, b: U8) -> U8 = if (a < b or a == 200u8) and not (b >= 250u8) then a - b else b * a + 3u8
  model impl8(a: U8, b: U8) -> U8 = if a > 7u8 => b <= a then a else b
  model u64m(a: U64) -> U64 = a * a + 3u64 * a - 7u64
  model u32m(a: U32) -> U32 = a * a - 0xffu32
  model u16m(a: U16) -> U16 = a * a + 1u16
  model i8m(a: I8) -> I8 = if a < -100i8 then a - 100i8 else a * a
  model natm(a: Bytes) -> Int = len(a) * len(a) + len(a)
  model signm(a: Bytes, b: Bytes) -> Bool = len(a) - len(b) < 0 - 1 or -len(a) + 2 * len(b) >= 1
  model litm(a: Bytes) -> Result<Bytes, E> = if a == b"00" then Err(E.BAD) else Ok(concat(a, b"ab"))
  model add8(a: U8, b: U8) -> U8 = a + b
  model sub8(a: U8, b: U8) -> U8 = a - b
  model mul8(a: U8, b: U8) -> U8 = a * b
  model neg8(a: I8) -> I8 = -a
  model inc(x: U8) -> U8 = x + 1u8
  model twice(x: U8) -> U8 = inc(inc(x))
  model pick(c: Bool, a: Bytes) -> Result<Bytes, E> = if c then Ok(a) else Err(E.BAD)
  model id64(a: U64) -> U64 = a
  model id32(a: U32) -> U32 = a
  model id16(a: U16) -> U16 = a
  model len_of(a: Bytes) -> Nat = len(a)
  op op_add(a: U8, b: U8) -> U8
  op op_sub(a: U8, b: U8) -> U8
  op op_mul(a: U8, b: U8) -> U8
  op op_neg(a: I8) -> I8
  op op_inc(x: U8) -> U8
  op op_pick(c: Bool, a: Bytes) -> Result<Bytes, E>
  op op_u64(a: U64) -> U64
  op op_u32(a: U32) -> U32
  op op_u16(a: U16) -> U16
  op op_len(a: Bytes) -> Nat
  op op_cat(a: Bytes, b: Bytes) -> Bytes

  assume platform:
    none
  assume environment:
    none

  labels op_add:
    a secret
    b secret

  labels op_sub:
    a secret
    b secret

  labels op_mul:
    a secret
    b secret

  labels op_neg:
    a secret

  labels op_inc:
    x secret

  labels op_pick:
    c secret
    a.contents secret
    a.length public

  labels op_u64:
    a secret

  labels op_u32:
    a secret

  labels op_u16:
    a secret

  labels op_len:
    a.contents secret
    a.length public

  labels op_cat:
    a.contents secret
    a.length public
    b.contents secret
    b.length public

  input op_add.a:
    hostile
    ensures no_panic, terminates
  input op_add.b:
    hostile
    ensures no_panic, terminates
  input op_sub.a:
    hostile
    ensures no_panic, terminates
  input op_sub.b:
    hostile
    ensures no_panic, terminates
  input op_mul.a:
    hostile
    ensures no_panic, terminates
  input op_mul.b:
    hostile
    ensures no_panic, terminates
  input op_neg.a:
    hostile
    ensures no_panic, terminates
  input op_inc.x:
    hostile
    ensures no_panic, terminates
  input op_pick.c:
    hostile
    ensures no_panic, terminates
  input op_pick.a:
    hostile
    ensures no_panic, terminates
  input op_u64.a:
    hostile
    ensures no_panic, terminates
  input op_u32.a:
    hostile
    ensures no_panic, terminates
  input op_u16.a:
    hostile
    ensures no_panic, terminates
  input op_len.a:
    hostile
    ensures no_panic, terminates
  input op_cat.a:
    hostile
    ensures no_panic, terminates
  input op_cat.b:
    hostile
    ensures no_panic, terminates

  bound op_add:
    steps <= 64
    heap <= 0
    depth <= 8
  bound op_sub:
    steps <= 64
    heap <= 0
    depth <= 8
  bound op_mul:
    steps <= 64
    heap <= 0
    depth <= 8
  bound op_neg:
    steps <= 64
    heap <= 0
    depth <= 8
  bound op_inc:
    steps <= 64
    heap <= 0
    depth <= 8
  bound op_pick:
    steps <= 64 * len(a) + 512
    heap <= 2 * len(a)
    depth <= 32
  bound op_u64:
    steps <= 64
    heap <= 0
    depth <= 8
  bound op_u32:
    steps <= 64
    heap <= 0
    depth <= 8
  bound op_u16:
    steps <= 64
    heap <= 0
    depth <= 8
  bound op_len:
    steps <= 64 * len(a) + 512
    heap <= 2 * len(a)
    depth <= 32
  bound op_cat:
    steps <= 64 * len(a) + 512
    heap <= 2 * len(a)
    depth <= 32

  claim t_cut:
    forall a: Bytes, b: Bytes. op_cat(a, b) == cutm(a, b)
  claim t_cut2:
    forall a: Bytes, b: Bytes. op_cat(a, b) == cut2(a, b)
  claim t_sel:
    forall a: U8, b: U8. op_add(a, b) == sel(a, b)
  claim t_impl:
    forall a: U8, b: U8. op_add(a, b) == impl8(a, b)
  claim t_u64:
    forall a: U64. op_u64(a) == u64m(a)
  claim t_u32:
    forall a: U32. op_u32(a) == u32m(a)
  claim t_u16:
    forall a: U16. op_u16(a) == u16m(a)
  claim t_i8:
    forall a: I8. op_neg(a) == i8m(a)
  claim t_nat:
    forall a: Bytes. op_len(a) == natm(a)
  claim t_admit:
    forall a: Bytes, b: Bytes | signm(a, b) and not (a == b). op_cat(a, b) == cutm(b, a)
  claim t_lit:
    forall c: Bool, a: Bytes. op_pick(c, a) == litm(a)
  claim t_guard:
    forall a: U8, b: U8. a * b > 100u8 or op_add(a, b) == sel(a, b)
  claim t_guard2:
    forall a: U8, b: U8. a + b < 50u8 => op_add(a + b, b - a) == sel(a, b)
