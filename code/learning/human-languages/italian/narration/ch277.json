          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "durare is inherited from Latin dūrāre \"to harden; to hold out, to last\" (EtymDB), built on dūrus \"hard\" (Lewis & Short)."
            }
          ]
        },
