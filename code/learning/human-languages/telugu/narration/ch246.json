          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "అప్పు ఇవ్వు (appu ivvu) is native Dravidian: appu, \"loan\" (DEDR 216), and ivvu, \"to give\", one word with Tamil ī and Kannada ī, \"to give\" (DEDR 2598)."
            }
          ]
        },
