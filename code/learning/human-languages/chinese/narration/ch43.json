    {
      "id": "ZH-W43-qu",
      "sequence": 3625,
      "title": "去 (qù) — a cross on a bar, and a corner below",
      "headword": "去",
      "romanization": "qù",
      "gloss": "去 — a 十 on a long bar, and a two-stroke piece below",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:07529bdc85e4de0a",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — a cross on a bar, and a corner below",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — a cross on a bar, and a corner below and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say qù — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *qù* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "十 大."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — shí, dà",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *shí*, *dà*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — a cross on a bar, and a corner below",
          "segments": [
            {
              "kind": "speech",
              "text": "去 (qù)."
            },
            {
              "kind": "speech",
              "text": "Two pieces, top before bottom."
            },
            {
              "kind": "speech",
              "text": "The top piece, three strokes. A short horizontal, a vertical through it, then a long horizontal under them: 十 standing on a wide base."
            },
            {
              "kind": "speech",
              "text": "The bottom piece, two strokes. A stroke that falls to the left and turns out to the right, then a dot inside the turn."
            },
            {
              "kind": "speech",
              "text": "3 + 2 = five."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "去 (qù), all five, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 去, all five, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many pieces in 去 (qù)? (Two.) Which character you know is in the top piece? (十, on a long bar.) What is the last stroke? (A dot.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 去 (qù), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
