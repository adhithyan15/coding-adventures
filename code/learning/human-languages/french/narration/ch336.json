        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: le désaccord",
          "segments": [
            {
              "kind": "speech",
              "text": "le désaccord — \"the disagreement\"."
            },
            {
              "kind": "speech",
              "text": "Nous sommes en désaccord sur presque tout. We disagree about almost everything."
            },
            {
              "kind": "speech",
              "text": "Être en désaccord — to disagree. The opposite is être d'accord."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "désaccord is built from dés- \"not\" and accord \"agreement\", which comes from the Old French verb acorder (EtymDB). That verb is usually traced to a Latin formation on cor, cordis \"heart\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
            }
          ]
        },
