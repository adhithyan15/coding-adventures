    {
      "id": "ES-C407-medio",
      "sequence": 9180,
      "title": "en medio — in the middle",
      "headword": "en medio",
      "romanization": "en medio",
      "gloss": "in the middle",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:1350b09838e1ee21",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Recall la puerta, the door. Now place it at the centre: la puerta está en medio."
            }
          ]
        },
        {
          "index": 1,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Medio comes from Latin medius, “middle.” English kept the same root in median, medium and intermediate. Spanish uses en medio for a position between the edges or between two things."
            }
          ]
        },
        {
          "index": 2,
          "type": "grammar",
          "title": "Grammar Lens: the frame en medio de",
          "segments": [
            {
              "kind": "speech",
              "text": "Say en medio when the reference is understood. Add de before the thing that frames the middle: en medio de la puerta, in the middle of the door."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "en medio",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *en medio*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "en medio de la puerta",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *en medio de la puerta*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "la puerta está en medio",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *la puerta está en medio*]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "In the middle? (En medio.)"
            },
            {
              "kind": "speech",
              "text": "Source: DLE: medio."
            }
          ]
        }
      ]
    },
    {
      "id": "ES-C407-debajo",
      "sequence": 9190,
      "title": "debajo — underneath",
      "headword": "debajo",
      "romanization": "debajo",
      "gloss": "underneath; below",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:1704a98540c84c23",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Recall la mesa. Something lower than the tabletop can be debajo de la mesa."
            }
          ]
        },
        {
          "index": 1,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "The history is visible: de + bajo. Bajo is low; debajo names the lower position. The DLE defines it as a place below another higher one."
            }
          ]
        },
        {
          "index": 2,
          "type": "grammar",
          "title": "Grammar Lens: debajo de",
          "segments": [
            {
              "kind": "speech",
              "text": "Before a reference object, use debajo de: debajo de la mesa. With no object stated, está debajo is complete."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "debajo",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *debajo*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "debajo de la mesa",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *debajo de la mesa*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "está debajo",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *está debajo*]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Underneath? (Debajo.) Under the table? (Debajo de la mesa.)"
            },
            {
              "kind": "speech",
              "text": "Source: DLE: debajo."
            }
          ]
        }
      ]
    },
    {
      "id": "ES-C407-fuera",
      "sequence": 9200,
      "title": "fuera — outside",
      "headword": "fuera",
      "romanization": "fuera",
      "gloss": "outside",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:dbbbccb6cdd9b83f",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Recall la casa. Inside it is one location; beyond it is fuera, outside."
            }
          ]
        },
        {
          "index": 1,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Fuera comes from Latin foras, “outward.” The core picture is crossing the boundary and standing beyond it. The opening fue- is one syllable: say FWE-ra, not fu-E-ra."
            }
          ]
        },
        {
          "index": 2,
          "type": "grammar",
          "title": "Grammar Lens: fuera and fuera de",
          "segments": [
            {
              "kind": "speech",
              "text": "Está fuera means it is outside. Add de for the boundary: fuera de la casa, outside the house."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "fuera",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *fuera*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "está fuera",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *está fuera*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "fuera de la casa",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *fuera de la casa*]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Outside? (Fuera.)"
            },
            {
              "kind": "speech",
              "text": "Source: DLE: fuera."
            }
          ]
        }
