# ECMAScript 2020 (ES11) — Lexical Grammar
# @version 1
# @ecmascript_edition 2020
# source_ref: https://github.com/tc39/ecma262/tree/es2020
# source_sha: dfd5ea2ec5862de21b005737650ba08bc57271fa
# PARTIAL: the IIR path claims es-number-log only (LANG84 phase 6d; see releases.csv); this lexical pair predates LANG84 and is not yet audited clause by clause against the tagged spec text.
#
# ECMA-262, 11th Edition — June 2020
#
# ES2020 is a substantial release with several new token types. It introduces
# optional chaining (`?.`), nullish coalescing (`??`), BigInt literals, and
# dynamic import syntax.
#
# New features:
#
#   1. Optional chaining: `obj?.prop`, `obj?.[expr]`, `obj?.method()`
#      Safely access nested properties without explicit null checks.
#      Returns `undefined` if the left side is null/undefined, instead of
#      throwing a TypeError.
#
#   2. Nullish coalescing: `x ?? fallback`
#      Returns the right operand when the left is null or undefined (but NOT
#      for other falsy values like 0, '', or false). This fills a gap that
#      `||` couldn't: `0 || 42` gives 42, but `0 ?? 42` gives 0.
#
#   3. BigInt: `42n`, `0xFFn`, `0b101n`, `0o77n`
#      Arbitrary-precision integers. The `n` suffix distinguishes BigInt from
#      Number. You cannot mix BigInt and Number in arithmetic — explicit
#      conversion is required.
#
#   4. Dynamic import: `import("./module.js")` — grammar, not token change
#   5. import.meta: `import.meta.url` — grammar, not token change
#   6. globalThis — runtime only
#   7. Promise.allSettled() — runtime only
#   8. String.prototype.matchAll() — runtime only
#
# Token ordering notes:
#   - `?.` must come before `?` (first-match-wins)
#   - `??` must come before `?`
#   - BIGINT patterns must come before NUMBER patterns (the `n` suffix
#     would otherwise be consumed as NAME after a NUMBER)

# ============================================================================
# Literals
# ============================================================================

NAME = /[a-zA-Z_$][a-zA-Z0-9_$]*/

# --- BigInt literals ---
#
# NEW IN ES2020: Arbitrary-precision integers with `n` suffix.
#
# BigInt supports the same literal forms as Number (decimal, hex, binary,
# octal) but with a trailing `n`. BigInt has no floating-point representation
# and no scientific notation — it is always an exact integer.
#
# These must appear BEFORE the corresponding NUMBER patterns so that `42n`
# is lexed as BIGINT, not NUMBER followed by NAME.

BIGINT_HEX = /0[xX][0-9a-fA-F]+n/ -> BIGINT
BIGINT_BINARY = /0[bB][01]+n/ -> BIGINT
BIGINT_OCTAL = /0[oO][0-7]+n/ -> BIGINT
BIGINT_DECIMAL = /[0-9]+n/ -> BIGINT

# --- Numbers (unchanged from ES2019) ---

BINARY_NUMBER = /0[bB][01]+/ -> NUMBER
OCTAL_NUMBER = /0[oO][0-7]+/ -> NUMBER
HEX_NUMBER = /0[xX][0-9a-fA-F]+/ -> NUMBER
FLOAT_NUMBER = /[0-9]+\.[0-9]*([eE][+-]?[0-9]+)?/ -> NUMBER
LEADING_DOT_FLOAT = /\.[0-9]+([eE][+-]?[0-9]+)?/ -> NUMBER
SCI_NUMBER = /[0-9]+[eE][+-]?[0-9]+/ -> NUMBER
INT_NUMBER = /[0-9]+/ -> NUMBER

# --- Strings (unchanged from ES2019, with U+2028/U+2029 support) ---

STRING_DQ = /"([^"\\]|\\.)*"/ -> STRING
STRING_SQ = /'([^'\\]|\\.)*'/ -> STRING

# --- Template literals (unchanged) ---

TEMPLATE_HEAD = /`([^`\\$]|\\.|\$+([^{`\\$]|\\.))*\$*\$\{/
TEMPLATE_NO_SUB = /`([^`\\$]|\\.|\$+([^{`\\$]|\\.))*\$*`/

# --- Regular expressions (unchanged from ES2018) ---

REGEX = /\/([^\/\\\n\r]|\\[^\n\r])+\/[gimsuy]*/

# ============================================================================
# Multi-character operators
# ============================================================================
#
# Token ordering is critical here. New tokens must be placed so that
# longer matches win over shorter prefixes:
#
#   ?.  must come before ?
#   ??  must come before ?
#   **= must come before ** must come before *= must come before *

# --- NEW IN ES2020: Optional chaining and nullish coalescing ---

OPTIONAL_CHAIN   = "?."
NULLISH_COALESCE = "??"

# --- ES2016+ operators ---

STAR_STAR_EQUALS         = "**="
STAR_STAR                = "**"
STRICT_EQUALS            = "==="
STRICT_NOT_EQUALS        = "!=="
UNSIGNED_RIGHT_SHIFT_EQUALS = ">>>="
UNSIGNED_RIGHT_SHIFT     = ">>>"
LEFT_SHIFT_EQUALS        = "<<="
RIGHT_SHIFT_EQUALS       = ">>="
EQUALS_EQUALS            = "=="
NOT_EQUALS               = "!="
LESS_EQUALS              = "<="
GREATER_EQUALS           = ">="
PLUS_EQUALS              = "+="
MINUS_EQUALS             = "-="
STAR_EQUALS              = "*="
SLASH_EQUALS             = "/="
PERCENT_EQUALS           = "%="
AMPERSAND_EQUALS         = "&="
PIPE_EQUALS              = "|="
CARET_EQUALS             = "^="
LEFT_SHIFT               = "<<"
RIGHT_SHIFT              = ">>"
AND_AND                  = "&&"
OR_OR                    = "||"
PLUS_PLUS                = "++"
MINUS_MINUS              = "--"
ARROW                    = "=>"
ELLIPSIS                 = "..."

# ============================================================================
# Single-character operators
# ============================================================================

EQUALS       = "="
PLUS         = "+"
MINUS        = "-"
STAR         = "*"
SLASH        = "/"
PERCENT      = "%"
LESS_THAN    = "<"
GREATER_THAN = ">"
BANG         = "!"
AMPERSAND    = "&"
PIPE         = "|"
CARET        = "^"
TILDE        = "~"
QUESTION     = "?"

# ============================================================================
# Delimiters
# ============================================================================

LPAREN    = "("
RPAREN    = ")"
LBRACE    = "{"
RBRACE    = "}"
LBRACKET  = "["
RBRACKET  = "]"
SEMICOLON = ";"
COMMA     = ","
COLON     = ":"
DOT       = "."

# ============================================================================
# Keywords
# ============================================================================

keywords:
  break
  case
  catch
  class
  const
  continue
  debugger
  default
  delete
  do
  else
  export
  extends
  finally
  for
  function
  if
  import
  in
  instanceof
  let
  new
  return
  super
  switch
  this
  throw
  try
  typeof
  var
  void
  while
  with
  yield
  true
  false
  null

# ============================================================================
# Future reserved words
# ============================================================================

reserved:
  enum

# ============================================================================
# Context keywords
# ============================================================================

context_keywords:
  as
  async
  await
  from
  of
  get
  set
  static

# ============================================================================
# Token groups
# ============================================================================

group template:
  TEMPLATE_MIDDLE = /\}([^`\\$]|\\.|\$+([^{`\\$]|\\.))*\$*\$\{/
  TEMPLATE_TAIL   = /\}([^`\\$]|\\.|\$+([^{`\\$]|\\.))*\$*`/

# ============================================================================
# Declarative lexer modes (F10): regex-vs-division disambiguation
# ============================================================================
#
# A `/` starts a REGEX literal in expression position but is DIVISION in
# operand position, so `a/b/c` must not lex as `a` + regex `/b/` + `c`.
# This is the same table es2025.tokens carries (see its header comment
# for the full explanation), restricted to the token names and keywords
# this edition defines (LANG84 phase 6a). A program starts in `default`
# (expression position); after a value-producing token the lexer switches
# to `div`, whose two overrides make `/` and `/=` division.
#
# `template` / `template_div` keep `${...}` substitutions working: see
# es2025.tokens for the first-slice limits (no nested braces).

start_mode: default

group div:
  SLASH_EQUALS = "/="
  SLASH        = "/"

group template_div:
  SLASH_EQUALS    = "/="
  SLASH           = "/"
  TEMPLATE_MIDDLE = /\}([^`\\$]|\\.|\$+([^{`\\$]|\\.))*\$*\$\{/
  TEMPLATE_TAIL   = /\}([^`\\$]|\\.|\$+([^{`\\$]|\\.))*\$*`/

transitions:
  # ── Template substitution entry/exit (gap-044, first slice) ──────────────
  # After a template opener, enter flat `template` mode so TEMPLATE_TAIL/
  # MIDDLE patterns are tried before the inherited RBRACE.
  on TEMPLATE_HEAD   -> set-mode template
  on TEMPLATE_MIDDLE -> set-mode template

  # Inside `${...}`, after a value-producing NAME, switch to `template_div`
  # (like `div` but still carries TEMPLATE_TAIL/MIDDLE as own patterns).
  # The in_mode guard must come BEFORE the general NAME rule below, because
  # first-match-wins would otherwise fire the general rule in template mode.
  on NAME in template      -> set-mode template_div
  on NAME in template_div  -> set-mode template_div

  # Closing the substitution: TEMPLATE_TAIL is value-producing → div.
  on TEMPLATE_TAIL -> set-mode div

  # ── Regex-vs-division (gap-115, gap-119) ─────────────────────────────────
  # Value-producing tokens -> the next `/` is DIVISION. (One rule per line:
  # the transition parser reads each indented line as a complete rule.)
  on (NAME | NUMBER | BIGINT | STRING | REGEX | TEMPLATE_NO_SUB | RPAREN | RBRACKET) -> set-mode div
  on KEYWORD="this"  -> set-mode div
  on KEYWORD="super" -> set-mode div
  on KEYWORD="true"  -> set-mode div
  on KEYWORD="false" -> set-mode div
  on KEYWORD="null"  -> set-mode div

  # Operators, openers, separators -> the next `/` is a REGEX.
  on (LPAREN | LBRACKET | LBRACE | COMMA | SEMICOLON | COLON | DOT | EQUALS | ARROW | QUESTION | ELLIPSIS | PLUS | MINUS | STAR | SLASH | PERCENT | STAR_STAR | EQUALS_EQUALS | NOT_EQUALS | STRICT_EQUALS | STRICT_NOT_EQUALS | LESS_THAN | GREATER_THAN | LESS_EQUALS | GREATER_EQUALS | AND_AND | OR_OR | NULLISH_COALESCE | OPTIONAL_CHAIN | BANG | TILDE | AMPERSAND | PIPE | CARET | LEFT_SHIFT | RIGHT_SHIFT | UNSIGNED_RIGHT_SHIFT | PLUS_EQUALS | MINUS_EQUALS | STAR_EQUALS | SLASH_EQUALS | PERCENT_EQUALS | STAR_STAR_EQUALS | AMPERSAND_EQUALS | PIPE_EQUALS | CARET_EQUALS | LEFT_SHIFT_EQUALS | RIGHT_SHIFT_EQUALS | UNSIGNED_RIGHT_SHIFT_EQUALS) -> set-mode default
  on KEYWORD="return"     -> set-mode default
  on KEYWORD="typeof"     -> set-mode default
  on KEYWORD="delete"     -> set-mode default
  on KEYWORD="void"       -> set-mode default
  on KEYWORD="in"         -> set-mode default
  on KEYWORD="instanceof" -> set-mode default
  on KEYWORD="new"        -> set-mode default
  on KEYWORD="do"         -> set-mode default
  on KEYWORD="else"       -> set-mode default
  on KEYWORD="case"       -> set-mode default
  on KEYWORD="yield"      -> set-mode default
  on KEYWORD="throw"      -> set-mode default

# ============================================================================
# Skip patterns
# ============================================================================

skip:
  WHITESPACE    = /[ \t\r\n\v\f]+/
  LINE_COMMENT  = /\/\/[^\n\r]*/
  BLOCK_COMMENT = /\/\*[^*]*\*+([^\/*][^*]*\*+)*\//

# ============================================================================
# Error recovery tokens
# ============================================================================

errors:
  BAD_STRING_DQ = /"[^"]*$/
  BAD_STRING_SQ = /'[^']*$/
  BAD_REGEX = /\/([^\/\\\n]|\\.)*$/
  BAD_TEMPLATE = /`([^`\\$]|\\.|\$+([^{`\\$]|\\.))*\$*$/
