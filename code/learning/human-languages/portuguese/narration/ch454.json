            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Portuguese for to haggle, then the Portuguese for to wrap."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: o remetente",
          "segments": [
            {
              "kind": "speech",
              "text": "o remetente — \"the sender\"."
            },
            {
              "kind": "speech",
              "text": "O remetente escreve a morada nas costas do envelope. The sender writes his address on the back of the envelope."
            },
            {
              "kind": "speech",
              "text": "On envelopes: Rem. — sender."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "remetente is built on remeter 'to send', which goes back to Latin remittere 'to send back', on mittere 'to send' (Lewis & Short); EtymDB lists Spanish remitente as a cousin."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
