        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "दवा (davā) is a loan from Arabic dawāʾ, \"remedy, medicine\", which reached Hindi through Persian. Its Arabic root is d-w-y (Lane)."
            }
          ]
        },
