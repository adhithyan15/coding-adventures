          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "solidaridad is built on solidario with -idad (EtymDB); solidario was borrowed from French solidaire, from Latin solidus 'whole, firm'."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
