  op op_var_ne(a: Dir, b: Dir) -> Bool
  op op_var_eq_lit(a: Dir) -> Bool
  op op_m_opt(o: Option<U8>) -> U8
  op op_m_opt_wild_arm(o: Option<U8>) -> Bool
  op op_m_opt_nested(o: Option<Option<Bool>>) -> Nat
  op op_m_opt_tuple(o: Option<(Bool,Nat)>) -> Nat
  op op_m_bool(b: Bool) -> Nat
  op op_m_tuple_bool(t: (Bool,Bool)) -> Bool
  op op_m_point(p: Point) -> U8
  op op_m_wrapped(w: Wrapped) -> U8
  op op_m_slot(s: Slot) -> Nat
  op op_m_shape(s: Shape) -> U8
