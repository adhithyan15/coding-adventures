        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: la cuisse",
          "segments": [
            {
              "kind": "speech",
              "text": "la cuisse — \"thigh\"."
            },
            {
              "kind": "speech",
              "text": "Après la course, j'ai mal aux cuisses. After the run my thighs hurt."
            },
            {
              "kind": "speech",
              "text": "Also a leg of chicken: une cuisse de poulet."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "la cuisse is inherited, through Old French, from Latin coxa \"hip\" (Lewis & Short); the word slid down from the hip to the thigh."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
