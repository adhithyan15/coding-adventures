        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: عملة",
          "segments": [
            {
              "kind": "speech",
              "text": "عملة — ʿumla — \"a currency\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "عملة (ʿumla) is built on the native Arabic root ʿ-m-l, \"to work\" (Lane). Lane's ʿumla is pay for work; the currency is a modern sense."
            }
          ]
        },
