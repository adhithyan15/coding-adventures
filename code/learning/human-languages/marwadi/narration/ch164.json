            {
              "kind": "prompt",
              "action": "ANSWER",
              "instruction": "is the shop open on Monday? (No: सोमवार दुकान बंद (band) है।)",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU ANSWER: is the shop open on Monday? (No: **सोमवार दुकान बंद है।**)]"
            },
            {
              "kind": "prompt",
              "action": "ANSWER",
              "instruction": "until when is it open on Sunday morning? (Until twelve: १२ तांई (tā̃ī).)",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU ANSWER: until when is it open on Sunday morning? (Until twelve: **१२ तांई**.)]"
            },
            {
              "kind": "prompt",
              "action": "ANSWER",
              "instruction": "is there ghee today? (No: आज घी कोनी।)",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU ANSWER: is there ghee today? (No: **आज घी कोनी।**)]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Which day is the shop closed all day? (सोमवार, Monday.) When is it closed every day? (दोपार अर रात, midday and night.)"
