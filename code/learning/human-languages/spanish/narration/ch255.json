              }
            },
            {
              "kind": "activity",
              "scored": true,
              "id": "ES-C65-vi-di-accent",
              "prompt": "Why does vi take no accent when comi does?",
              "assesses": [
                "ES-ORTHOGRAPHY-ONE-SYLLABLE-NO-ACCENT",
                "ES-ORTHOGRAPHY-ER-IR-PRETERITE-FINAL-STRESS"
              ],
              "responseSeconds": 15,
              "acceptedResponses": [
