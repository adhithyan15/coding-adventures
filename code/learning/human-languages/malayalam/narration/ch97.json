            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "itŭ sundaraṁ alla",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *itŭ sundaraṁ alla*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "the two one after the other, and hear where they part",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: the two one after the other, and hear where they part]"
            },
            {
              "kind": "prompt",
              "action": "LOOK",
              "instruction": "at സുന്ദരം (sundaraṁ) in the second sentence, and say what happened to its ം",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU LOOK: at **സുന്ദരം** in the second sentence, and say what happened to its **ം**]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How do you say this is not beautiful? (ഇത് സുന്ദരം അല്ല (itŭ sundaraṁ alla).) Does അല്ല weld onto the word before it? (No — it stands apart.) So what happens to the ം? (Nothing.)"
            }
          ]
        }
      ]
