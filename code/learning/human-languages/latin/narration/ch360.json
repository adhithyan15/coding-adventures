        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: manifestus, manifesta, manifestum",
          "segments": [
            {
              "kind": "speech",
              "text": "manifestus, manifesta, manifestum — \"evident, plain; caught in the act\"."
            },
            {
              "kind": "speech",
              "text": "Rēs manifesta est: fūr pecūniam habet. The matter is plain: the thief has the money."
            },
            {
              "kind": "speech",
              "text": "manifestus, manifesta, manifestum. A thief manifestus is caught red-handed. English manifest."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "manifestus is built from manus \"hand\" and an old verb fendō \"to strike\", the one in dēfendō and offendō (EtymDB; Lewis & Short): a thing you could strike with your hand, so plain to see. English manifest comes from it."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
