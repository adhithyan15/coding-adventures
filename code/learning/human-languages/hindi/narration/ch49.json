      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new run of words: what did śāyad mean, and what did bilkul mean?"
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: अभी",
          "segments": [
            {
              "kind": "speech",
              "text": "अभी (abhī) — \"right now\"."
            },
            {
              "kind": "speech",
              "text": "Ab, 'now', with the emphatic -hī welded onto it: now and nothing but now. Behind ab stands Sanskrit adhunā."
            },
            {
              "kind": "speech",
              "text": "That little -hī is one of the most useful pieces in the language. It narrows whatever it lands on, and you will meet it stuck to other words later. Here it turns a vague present into a pointed one — not now-ish, but this moment, and no other."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "The first of five words for leaving."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "abhī",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *abhī*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "it once more, slowly",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: it once more, slowly]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "abhī, then bilkul, so the timing and the emphasis sit together",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *abhī*, then *bilkul*, so the timing and the emphasis sit together]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What does अभी (abhī) mean? (\"right now\".) Say it once more."
            }
          ]
        }
      ]
    },
