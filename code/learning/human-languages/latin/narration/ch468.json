          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: tingō, tingere",
          "segments": [
            {
              "kind": "speech",
              "text": "tingō, tingere — \"to dye, to colour; to wet, to dip\"."
            },
            {
              "kind": "speech",
              "text": "Servus lānam in aquā calidā tingit. The slave dyes the wool in hot water."
            },
            {
              "kind": "speech",
              "text": "tingō, tingere, tīnxī, tīnctum, also spelled tinguō. English tinge, tint and tincture come from it."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "tingō is inherited from PIE teng- 'to dip, to soak' (EtymDB), and Greek tengō 'to wet' is a cousin. English tinge, tint and tincture come from it."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
