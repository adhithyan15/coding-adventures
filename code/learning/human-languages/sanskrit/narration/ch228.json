        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: इतिहासः",
          "segments": [
            {
              "kind": "speech",
              "text": "इतिहासः — itihāsaḥ — \"history\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "itihāsa is built from a phrase frozen into a word: iti, \"thus\", ha, \"indeed\", and āsa, \"it was\" (MW). History is \"so indeed it was\", the telling of past events."
            }
          ]
        },
