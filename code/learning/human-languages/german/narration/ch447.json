        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: der Friseur",
          "segments": [
            {
              "kind": "speech",
              "text": "der Friseur — \"the hairdresser, the barber\"."
            },
            {
              "kind": "speech",
              "text": "Einmal im Monat geht er zum Friseur. He goes to the hairdresser once a month."
            },
            {
              "kind": "speech",
              "text": "Plural: die Friseure. A woman: die Friseurin. Also spelled Frisör."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Friseur was borrowed from French friseur 'hairdresser', from friser 'to curl, to frizz' (EtymDB); French today mostly says coiffeur."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
