# Perl 5.003_97b (1997-04-08) tokens: plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: this does not lex all Perl 5.003_97b source.
# Evidence: https://github.com/Perl/perl5/blob/perl-5.003_97b/toke.c
# Tagged tokenizer changes interpolation of $<digit> and regex scan
# promotion outside this subset. Unsupported characters, carriage returns
# and leading-zero forms remain refused.

PRINT     = "print"
INT       = /0|[1-9][0-9]*/
PLUS      = "+"
DECREMENT = "--"
MINUS     = "-"
STAR      = "*"
LPAREN    = "("
RPAREN    = ")"
SEMICOLON = ";"

skip:
  WHITESPACE = /[ \t\n]+/
