            {
              "kind": "speech",
              "text": "Before the new one: say the Persian for the turn of the year, then the Persian for birth."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: مدت",
          "segments": [
            {
              "kind": "speech",
              "text": "مدت — moddat — \"a period, a length of time\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "moddat is borrowed from Arabic mudda, \"period, space of time\". Its Arabic root is m-d-d (Lane)."
            }
          ]
        },
