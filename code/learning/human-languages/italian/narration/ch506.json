          "type": "input",
          "title": "You'll want to know: scattare",
          "segments": [
            {
              "kind": "speech",
              "text": "scattare — \"to take (a photo); to spring\"."
            },
            {
              "kind": "speech",
              "text": "Ho scattato cento foto in vacanza. I took a hundred photos on holiday."
            },
            {
              "kind": "speech",
              "text": "Scattare una foto — to take a photo; lo scatto is one shot."
            }
          ]
        },
