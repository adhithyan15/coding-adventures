        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: रक्तः",
          "segments": [
            {
              "kind": "speech",
              "text": "रक्तः — raktaḥ — \"red\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "rakta is the past participle of the root √rañj, \"to be coloured, dyed\" (MW): \"dyed\", then \"red\", then \"blood\" (CDIAL 10539). It lives on as Hindi rātā, \"dyed, red\"."
            }
          ]
        },
