        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "طبع (ṭabaʿa) is built on the native Arabic root ṭ-b-ʿ, \"to seal, to stamp\" (Lane). Ṭabaʿa is to stamp, hence to print."
            }
          ]
        },
