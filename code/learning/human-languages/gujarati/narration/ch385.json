        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: પુરસ્કાર",
          "segments": [
            {
              "kind": "speech",
              "text": "પુરસ્કાર — puraskār — \"an award\"."
            },
            {
              "kind": "speech",
              "text": "જો મીરા હરીફાઈ જીતશે તો શાળા તેને પુરસ્કાર આપશે. jo Mīrā harīphāī jītśe to śāḷā tene puraskār āpśe. If Mira wins the contest, the school will give her an award."
            },
            {
              "kind": "speech",
              "text": "A masculine noun."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "પુરસ્કાર (puraskār) is a tatsama, borrowed from Sanskrit puraskāra, \"placing in front, honouring\" (Monier-Williams)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for saying what happens if."
