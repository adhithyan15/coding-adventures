    {
      "id": "ZH-W188-qian-money",
      "sequence": 15005,
      "title": "钱 (qián) — the metal piece, then two bars and a hook",
      "headword": "钱",
      "romanization": "qián",
      "gloss": "钱 — the metal piece, then two bars, a slanting hook, a fall and a dot",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:4adcf8f1424c026b",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — the metal piece, then two bars and a hook",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — the metal piece, then two bars and a hook and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say yǒuqián — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *yǒuqián* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "有 多."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — yǒu, duō",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *yǒu*, *duō*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — the metal piece, then two bars and a hook",
          "segments": [
            {
              "kind": "speech",
              "text": "钱 (qián)."
            },
            {
              "kind": "speech",
              "text": "Two pieces, left before right. Count the pieces, not the strokes."
            },
            {
              "kind": "speech",
              "text": "The left piece, the metal piece, five strokes. A long stroke falling to the left, two short bars, a short bar rising to the right, then a vertical that turns up to the right at its foot."
            },
            {
              "kind": "speech",
              "text": "The right piece, five strokes. Two short bars, one over the other. A long slanting hook from the top down to the lower right, flicking up at its foot. A stroke falling to the left across it. Then a dot at the top right."
            },
            {
              "kind": "speech",
              "text": "5 + 5 = ten."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "钱 (qián), all ten, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 钱, all ten, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many strokes in 钱 (qián)? (Ten.) What is the left piece? (The metal piece, five strokes.) What comes last? (The dot at the top right.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 钱 (qián), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
