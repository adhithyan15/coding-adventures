        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: matrimoniale",
          "segments": [
            {
              "kind": "speech",
              "text": "matrimoniale — \"double (of a bed or room); of marriage\"."
            },
            {
              "kind": "speech",
              "text": "Vorrei una camera matrimoniale per due notti. I would like a double room for two nights."
            },
            {
              "kind": "speech",
              "text": "Un letto matrimoniale; a room with two beds is una doppia."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "matrimoniale is built on matrimonio 'marriage', a learned borrowing from Latin mātrimōnium, built on māter 'mother' (Lewis & Short)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
