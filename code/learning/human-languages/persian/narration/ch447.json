          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "kodposti is built from two French loans: kod 'code', usually traced to French code, and posti 'postal', from post, usually traced to French poste."
            }
          ]
        },
