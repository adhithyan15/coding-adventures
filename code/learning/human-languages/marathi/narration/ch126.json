      "id": "MR-C126-ravivar",
      "sequence": 5750,
      "title": "रविवार (ravivār) — Sunday",
      "headword": "रविवार",
      "romanization": "ravivār",
      "gloss": "Sunday",
      "script": "devanagari",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:ddb21f36e1eed82b",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Marathi for Friday, then the Marathi for Saturday."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: रविवार",
          "segments": [
            {
              "kind": "speech",
              "text": "रविवार — ravivār — \"Sunday\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "रविवार (ravivār) is a Sanskrit compound, a tatsama: ravi, \"the sun\", and vāra, \"day of the week\" (CDIAL 11547). Sunday is the sun's day, as in English."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for this chapter."
            }
          ]
        },
        {
          "index": 4,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
