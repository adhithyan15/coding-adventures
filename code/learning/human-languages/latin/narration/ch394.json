        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: apparō, apparāre",
          "segments": [
            {
              "kind": "speech",
              "text": "apparō, apparāre — \"to prepare, to get ready\"."
            },
            {
              "kind": "speech",
              "text": "Convīvium magnum apparāvit. He prepared a great banquet."
            },
            {
              "kind": "speech",
              "text": "apparō, apparāre, apparāvī, apparātum, ad + parō. Apparātus, equipment, splendour; English apparatus."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "apparō is built from ad \"towards\" and parō \"to make ready\" (Lewis & Short). English apparatus comes from its noun."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
