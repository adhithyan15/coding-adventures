          "title": "You'll want to know: il bugiardo",
          "segments": [
            {
              "kind": "speech",
              "text": "il bugiardo — \"liar; lying\"."
            },
            {
              "kind": "speech",
              "text": "Non credergli, è un bugiardo. Do not believe him, he is a liar."
            },
            {
              "kind": "speech",
              "text": "Built on la bugia \"a lie\". Dire bugie — to tell lies."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "bugiardo is built on bugia \"a lie\" with -ardo (EtymDB). Bugia is usually traced to Old Occitan bauzia \"deceit\", itself from a Germanic word."
            }
          ]
        },
