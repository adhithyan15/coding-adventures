          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new run: what did bella mean, and what did sakkare mean?"
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ನೂಲು",
          "segments": [
            {
              "kind": "speech",
              "text": "ನೂಲು (nūlu) — \"thread, yarn\"."
            },
            {
              "kind": "speech",
              "text": "ನೂಲು (nūlu) is inherited, and it is the stuff ಬಟ್ಟೆ is made of. Everything worn in the cloth chapter began here."
            },
            {
              "kind": "speech",
              "text": "The same shape does double duty: ನೂಲು (nūlu) is the thread and it is equally the spinning of it, so one word covers the material and the making. Kannada does that often, and you will start to expect it."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "The first of five things a household makes or keeps."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "nūlu",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *nūlu*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "it once more, slowly",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: it once more, slowly]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "nūlu, then baṭṭe, and say which one comes first",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *nūlu*, then *baṭṭe*, and say which one comes first]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What does ನೂಲು (nūlu) mean? (\"thread, yarn\".) Say it once more."
            }
          ]
        }
      ]
    },
