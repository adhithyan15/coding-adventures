          "segments": [
            {
              "kind": "speech",
              "text": "வேட்பாளர் (vēṭpāḷar) is native: vēṭpu, \"desire\", from vēḷ, \"to desire\" (DEDR 5528), with -āḷar, \"one who\": one who seeks."
            }
          ]
        },
