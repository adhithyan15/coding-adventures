          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "algazarra comes from Arabic with the article al-; EtymDB traces it to ghazāra 'abundance', but the details are not settled."
            }
          ]
        },
        {
