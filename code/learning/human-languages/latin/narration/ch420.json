          "segments": [
            {
              "kind": "speech",
              "text": "auctiō, auctiōnis — \"an auction\"."
            },
            {
              "kind": "speech",
              "text": "Bona eius in auctiōne vendita sunt. His goods were sold at an auction."
            },
            {
              "kind": "speech",
              "text": "auctiō, auctiōnis f., built on augeō, to increase: the price goes up and up. English auction."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "auctiō is the noun built on augeō \"to increase\" (EtymDB; Lewis & Short): a sale where the price keeps rising. English auction comes from it."
            }
          ]
        },
