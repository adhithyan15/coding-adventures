          "index": 1,
          "type": "input",
          "title": "You'll want to know: сюжет",
          "segments": [
            {
              "kind": "speech",
              "text": "сюжет (syuzhét) — \"a plot\"."
            },
            {
              "kind": "speech",
              "text": "У этого романа интересный сюжет. U étogo romána interésnyy syuzhét. This novel has an interesting plot."
            },
            {
              "kind": "speech",
              "text": "Masculine."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "сюжет (syuzhét) was borrowed from French sujet 'subject', which comes from Latin subiectum (EtymDB), from subicere 'to place under'."
            }
          ]
        },
        {
