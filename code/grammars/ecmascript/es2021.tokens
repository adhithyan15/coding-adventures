# ECMAScript 2021 (ES12) — Lexical Grammar
# @version 1
# @ecmascript_edition 2021
# source_ref: https://github.com/tc39/ecma262/tree/es2021
# source_sha: fc85c50181b2b8d7d75f034800528d87fda6b654
# PARTIAL: the IIR path claims es-number-log only (LANG84 phase 6d; see releases.csv); this lexical pair predates LANG84 and is not yet audited clause by clause against the tagged spec text.
#
# ECMA-262, 12th Edition — June 2021
#
# ES2021 adds logical assignment operators and numeric separators.
#
# New features:
#
#   1. Logical assignment: `||=`, `&&=`, `??=`
#      These combine logical/nullish operators with assignment, similar to
#      how `+=` combines `+` with `=`:
#
#        x ||= y   →   x || (x = y)    — assign if x is falsy
#        x &&= y   →   x && (x = y)    — assign if x is truthy
#        x ??= y   →   x ?? (x = y)    — assign if x is null/undefined
#
#      Note the short-circuit semantics: assignment only happens if the
#      logical condition triggers. This means `x ||= y` does NOT always
#      write to x — it only writes when x is falsy. This matters for
#      property setters and proxies.
#
#   2. Numeric separators: underscores in number literals
#      `1_000_000` is the same as `1000000` but much more readable.
#      Rules: no leading `_`, no trailing `_`, no double `__`, no `_`
#      adjacent to `.`, `e`, `E`, `x`, `o`, `b`, or `n`.
#
#   3. String.prototype.replaceAll() — runtime only
#   4. Promise.any() + AggregateError — runtime only
#   5. WeakRef and FinalizationRegistry — runtime only
#
# Token ordering notes:
#   - `||=` must come before `||`
#   - `&&=` must come before `&&`
#   - `??=` must come before `??` which must come before `?`

# ============================================================================
# Literals
# ============================================================================

NAME = /[a-zA-Z_$][a-zA-Z0-9_$]*/

# --- Numbers ---
#
# CHANGED IN ES2021: Numeric separators with `_` in all number forms.
#
# The underscore `_` can appear between any two digits in a number literal
# to improve readability. It is purely visual — `1_000` and `1000` produce
# identical values. The separator works in all numeric forms:
#
#   Decimal:     1_000_000
#   Float:       3.141_592_653
#   Scientific:  1.5e1_0 (= 1.5 * 10^10)
#   Hex:         0xFF_FF_FF
#   Binary:      0b1010_0001
#   Octal:       0o777_777
#   BigInt:      1_000_000n
#
# Restrictions (enforced by the lexer):
#   - No leading underscore: `_100` is a NAME, not a NUMBER
#   - No trailing underscore: `100_` is invalid
#   - No adjacent to radix prefix: `0x_FF` is invalid
#   - No adjacent to decimal point: `3._14` or `3_.14` is invalid
#   - No adjacent to exponent: `1e_10` or `1_e10` is invalid
#   - No double underscore: `1__000` is invalid

BIGINT_HEX = /0[xX][0-9a-fA-F]([0-9a-fA-F_]*[0-9a-fA-F])?n/ -> BIGINT
BIGINT_BINARY = /0[bB][01]([01_]*[01])?n/ -> BIGINT
BIGINT_OCTAL = /0[oO][0-7]([0-7_]*[0-7])?n/ -> BIGINT
BIGINT_DECIMAL = /[0-9]([0-9_]*[0-9])?n/ -> BIGINT

BINARY_NUMBER = /0[bB][01]([01_]*[01])?/ -> NUMBER
OCTAL_NUMBER = /0[oO][0-7]([0-7_]*[0-7])?/ -> NUMBER
HEX_NUMBER = /0[xX][0-9a-fA-F]([0-9a-fA-F_]*[0-9a-fA-F])?/ -> NUMBER
FLOAT_NUMBER = /[0-9]([0-9_]*[0-9])?\.[0-9]([0-9_]*[0-9])?([eE][+-]?[0-9]([0-9_]*[0-9])?)?/ -> NUMBER
LEADING_DOT_FLOAT = /\.[0-9]([0-9_]*[0-9])?([eE][+-]?[0-9]([0-9_]*[0-9])?)?/ -> NUMBER
SCI_NUMBER = /[0-9]([0-9_]*[0-9])?[eE][+-]?[0-9]([0-9_]*[0-9])?/ -> NUMBER
INT_NUMBER = /[0-9]([0-9_]*[0-9])?/ -> NUMBER

# --- Strings (unchanged from ES2019) ---

STRING_DQ = /"([^"\\]|\\.)*"/ -> STRING
STRING_SQ = /'([^'\\]|\\.)*'/ -> STRING

# --- Template literals (unchanged) ---

TEMPLATE_HEAD = /`([^`\\$]|\\.|\$+([^{`\\$]|\\.))*\$*\$\{/
TEMPLATE_NO_SUB = /`([^`\\$]|\\.|\$+([^{`\\$]|\\.))*\$*`/

# --- Regular expressions (unchanged from ES2018) ---

REGEX = /\/([^\/\\\n\r]|\\[^\n\r])+\/[gimsuy]*/

# ============================================================================
# Multi-character operators
# ============================================================================
#
# NEW IN ES2021: Three logical assignment operators.
#
# These must appear before their non-assignment counterparts:
#   ||= before ||
#   &&= before &&
#   ??= before ?? before ?

OR_OR_EQUALS             = "||="
AND_AND_EQUALS           = "&&="
NULLISH_COALESCE_EQUALS  = "??="
OPTIONAL_CHAIN           = "?."
NULLISH_COALESCE         = "??"
STAR_STAR_EQUALS         = "**="
STAR_STAR                = "**"
STRICT_EQUALS            = "==="
STRICT_NOT_EQUALS        = "!=="
UNSIGNED_RIGHT_SHIFT_EQUALS = ">>>="
UNSIGNED_RIGHT_SHIFT     = ">>>"
LEFT_SHIFT_EQUALS        = "<<="
RIGHT_SHIFT_EQUALS       = ">>="
EQUALS_EQUALS            = "=="
NOT_EQUALS               = "!="
LESS_EQUALS              = "<="
GREATER_EQUALS           = ">="
PLUS_EQUALS              = "+="
MINUS_EQUALS             = "-="
STAR_EQUALS              = "*="
SLASH_EQUALS             = "/="
PERCENT_EQUALS           = "%="
AMPERSAND_EQUALS         = "&="
PIPE_EQUALS              = "|="
CARET_EQUALS             = "^="
LEFT_SHIFT               = "<<"
RIGHT_SHIFT              = ">>"
AND_AND                  = "&&"
OR_OR                    = "||"
PLUS_PLUS                = "++"
MINUS_MINUS              = "--"
ARROW                    = "=>"
ELLIPSIS                 = "..."

# ============================================================================
# Single-character operators
# ============================================================================

EQUALS       = "="
PLUS         = "+"
MINUS        = "-"
STAR         = "*"
SLASH        = "/"
PERCENT      = "%"
LESS_THAN    = "<"
GREATER_THAN = ">"
BANG         = "!"
AMPERSAND    = "&"
PIPE         = "|"
CARET        = "^"
TILDE        = "~"
QUESTION     = "?"

# ============================================================================
# Delimiters
# ============================================================================

LPAREN    = "("
RPAREN    = ")"
LBRACE    = "{"
RBRACE    = "}"
LBRACKET  = "["
RBRACKET  = "]"
SEMICOLON = ";"
COMMA     = ","
COLON     = ":"
DOT       = "."

# ============================================================================
# Keywords
# ============================================================================

keywords:
  break
  case
  catch
  class
  const
  continue
  debugger
  default
  delete
  do
  else
  export
  extends
  finally
  for
  function
  if
  import
  in
  instanceof
  let
  new
  return
  super
  switch
  this
  throw
  try
  typeof
  var
  void
  while
  with
  yield
  true
  false
  null

# ============================================================================
# Future reserved words
# ============================================================================

reserved:
  enum

# ============================================================================
# Context keywords
# ============================================================================

context_keywords:
  as
  async
  await
  from
  of
  get
  set
  static

# ============================================================================
# Token groups
# ============================================================================

group template:
  TEMPLATE_MIDDLE = /\}([^`\\$]|\\.|\$+([^{`\\$]|\\.))*\$*\$\{/
  TEMPLATE_TAIL   = /\}([^`\\$]|\\.|\$+([^{`\\$]|\\.))*\$*`/

# ============================================================================
# Declarative lexer modes (F10): regex-vs-division disambiguation
# ============================================================================
#
# A `/` starts a REGEX literal in expression position but is DIVISION in
# operand position, so `a/b/c` must not lex as `a` + regex `/b/` + `c`.
# This is the same table es2025.tokens carries (see its header comment
# for the full explanation), restricted to the token names and keywords
# this edition defines (LANG84 phase 6a). A program starts in `default`
# (expression position); after a value-producing token the lexer switches
# to `div`, whose two overrides make `/` and `/=` division.
#
# `template` / `template_div` keep `${...}` substitutions working: see
# es2025.tokens for the first-slice limits (no nested braces).

start_mode: default

group div:
  SLASH_EQUALS = "/="
  SLASH        = "/"

group template_div:
  SLASH_EQUALS    = "/="
  SLASH           = "/"
  TEMPLATE_MIDDLE = /\}([^`\\$]|\\.|\$+([^{`\\$]|\\.))*\$*\$\{/
  TEMPLATE_TAIL   = /\}([^`\\$]|\\.|\$+([^{`\\$]|\\.))*\$*`/

transitions:
  # ── Template substitution entry/exit (gap-044, first slice) ──────────────
  # After a template opener, enter flat `template` mode so TEMPLATE_TAIL/
  # MIDDLE patterns are tried before the inherited RBRACE.
  on TEMPLATE_HEAD   -> set-mode template
  on TEMPLATE_MIDDLE -> set-mode template

  # Inside `${...}`, after a value-producing NAME, switch to `template_div`
  # (like `div` but still carries TEMPLATE_TAIL/MIDDLE as own patterns).
  # The in_mode guard must come BEFORE the general NAME rule below, because
  # first-match-wins would otherwise fire the general rule in template mode.
  on NAME in template      -> set-mode template_div
  on NAME in template_div  -> set-mode template_div

  # Closing the substitution: TEMPLATE_TAIL is value-producing → div.
  on TEMPLATE_TAIL -> set-mode div

  # ── Regex-vs-division (gap-115, gap-119) ─────────────────────────────────
  # Value-producing tokens -> the next `/` is DIVISION. (One rule per line:
  # the transition parser reads each indented line as a complete rule.)
  on (NAME | NUMBER | BIGINT | STRING | REGEX | TEMPLATE_NO_SUB | RPAREN | RBRACKET) -> set-mode div
  on KEYWORD="this"  -> set-mode div
  on KEYWORD="super" -> set-mode div
  on KEYWORD="true"  -> set-mode div
  on KEYWORD="false" -> set-mode div
  on KEYWORD="null"  -> set-mode div

  # Operators, openers, separators -> the next `/` is a REGEX.
  on (LPAREN | LBRACKET | LBRACE | COMMA | SEMICOLON | COLON | DOT | EQUALS | ARROW | QUESTION | ELLIPSIS | PLUS | MINUS | STAR | SLASH | PERCENT | STAR_STAR | EQUALS_EQUALS | NOT_EQUALS | STRICT_EQUALS | STRICT_NOT_EQUALS | LESS_THAN | GREATER_THAN | LESS_EQUALS | GREATER_EQUALS | AND_AND | OR_OR | NULLISH_COALESCE | OPTIONAL_CHAIN | BANG | TILDE | AMPERSAND | PIPE | CARET | LEFT_SHIFT | RIGHT_SHIFT | UNSIGNED_RIGHT_SHIFT | PLUS_EQUALS | MINUS_EQUALS | STAR_EQUALS | SLASH_EQUALS | PERCENT_EQUALS | STAR_STAR_EQUALS | AMPERSAND_EQUALS | PIPE_EQUALS | CARET_EQUALS | LEFT_SHIFT_EQUALS | RIGHT_SHIFT_EQUALS | UNSIGNED_RIGHT_SHIFT_EQUALS | AND_AND_EQUALS | OR_OR_EQUALS | NULLISH_COALESCE_EQUALS) -> set-mode default
  on KEYWORD="return"     -> set-mode default
  on KEYWORD="typeof"     -> set-mode default
  on KEYWORD="delete"     -> set-mode default
  on KEYWORD="void"       -> set-mode default
  on KEYWORD="in"         -> set-mode default
  on KEYWORD="instanceof" -> set-mode default
  on KEYWORD="new"        -> set-mode default
  on KEYWORD="do"         -> set-mode default
  on KEYWORD="else"       -> set-mode default
  on KEYWORD="case"       -> set-mode default
  on KEYWORD="yield"      -> set-mode default
  on KEYWORD="throw"      -> set-mode default

# ============================================================================
# Skip patterns
# ============================================================================

skip:
  WHITESPACE    = /[ \t\r\n\v\f]+/
  LINE_COMMENT  = /\/\/[^\n\r]*/
  BLOCK_COMMENT = /\/\*[^*]*\*+([^\/*][^*]*\*+)*\//

# ============================================================================
# Error recovery tokens
# ============================================================================

errors:
  BAD_STRING_DQ = /"[^"]*$/
  BAD_STRING_SQ = /'[^']*$/
  BAD_REGEX = /\/([^\/\\\n]|\\.)*$/
  BAD_TEMPLATE = /`([^`\\$]|\\.|\$+([^{`\\$]|\\.))*\$*$/
