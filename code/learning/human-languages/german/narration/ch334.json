          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "zugeben is built from zu and geben \"to give\", inherited from Old High German geban and Proto-Germanic gebaną (EtymDB): you give a point to the other side."
            }
          ]
        },
