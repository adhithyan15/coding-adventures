              "instruction": "一个 — yí ge — rising, before a fourth tone",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: 一个 — *yí ge* — rising, before a fourth tone]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "一天 — yì tiān — falling, before a first tone",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: 一天 — *yì tiān* — falling, before a first tone]"
            },
