component VisiCalc {
  slot editor-label : text ;
  slot row-height : number = 32 ;
  slot font-eyebrow : number = 10 ;
  slot font-row : number = 11 ;
  slot font-caption : number = 12 ;
  slot font-body : number = 13 ;
  slot font-input : number = 14 ;
  slot font-introduction : number = 18 ;
  slot font-symbol : number = 22 ;
  slot font-title : number = 38 ;
  slot text-scale-label : text ;
  slot smaller-text-disabled : bool ;
  slot larger-text-disabled : bool ;
  emit onSmallerText ;
  emit onLargerText ;
  slot workbook-empty : bool ;
  slot file-status : text ;
  slot selection-summary : text ;
  slot viewport-offset : number ;
  slot total-rows : number ;
  slot row-headers : list<text> ;
  slot cell-address : text ;
  slot formula : text ;
  slot read-only : bool ;
  slot column-headers : list<text> ;
  slot column-widths : list<number> ;
  slot viewport-rows : list<list<text>> ;
  slot grid-selected-row : number ;
  slot selected-col : number ;
  slot grid-edit-row : number ;
  slot edit-col : number ;
  slot edit-content : text ;
  emit onGridNavigate ( row : number , col : number ) ;
  emit onFormulaChange ( value : text ) ;
  emit onCommit ;
  emit onCancel ;
  emit onEditCommit ;
  emit onEditCancel ;
  emit onNewWorkbook ;
  emit onOpenWorkbook ;
  emit onSaveWorkbook ;
  emit onViewportShift ( rows : number ) ;
  emit onViewportRows ( rows : number ) ;
}
