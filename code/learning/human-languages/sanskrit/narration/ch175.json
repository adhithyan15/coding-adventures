        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "harati is the present tense of the root √hṛ, which MW glosses \"to take, carry, carry off\". The verb lives on in Hindi harnā, \"to take, seize, plunder\" (CDIAL 13980)."
            }
          ]
        },
