# Perl 5.003_16 (1996-12-24) tokens: plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: this does not lex all Perl 5.003_16 source.
# Evidence: https://github.com/Perl/perl5/blob/perl-5.003_16/toke.c
# The tagged tokenizer matches 5.003_15; this release still has its own
# addressable file. Multi-digit leading-zero forms remain refused.

PRINT     = "print"
INT       = /0|[1-9][0-9]*/
PLUS      = "+"
DECREMENT = "--"
MINUS     = "-"
STAR      = "*"
LPAREN    = "("
RPAREN    = ")"
SEMICOLON = ";"

skip:
  WHITESPACE = /[ \t\r\n]+/
