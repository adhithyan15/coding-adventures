          "title": "You'll want to know: il lampo",
          "segments": [
            {
              "kind": "speech",
              "text": "il lampo — \"the flash of lightning, the flash\"."
            },
            {
              "kind": "speech",
              "text": "Ho visto un lampo sopra le colline. I saw a flash of lightning over the hills."
            },
            {
              "kind": "speech",
              "text": "In un lampo — in a flash."
            }
          ]
        },
