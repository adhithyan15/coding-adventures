        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ēripiō, ēripere",
          "segments": [
            {
              "kind": "speech",
              "text": "ēripiō, ēripere — \"to snatch away, to rescue\"."
            },
            {
              "kind": "speech",
              "text": "Pater fīlium ē flūmine ēripuit. The father snatched his son out of the river."
            },
            {
              "kind": "speech",
              "text": "ēripiō, ēripere, ēripuī, ēreptum: ē + rapiō. Ēripere ex perīculō: to rescue from danger."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ēripiō is built on rapiō, \"to snatch\", with ex-, \"out\" (EtymDB); the vowel changes inside the compound."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
