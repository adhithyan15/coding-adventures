# Perl 5.003_12 (1996-12-19) grammar: plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: unsupported Perl 5.003_12 syntax is rejected.
# Evidence: https://github.com/Perl/perl5/blob/perl-5.003_12/perly.y
# The tagged yacc change concerns while/until block forms outside this
# arithmetic precedence, unary minus, parentheses and print subset.

program         = print_statement { print_statement } ;
print_statement = PRINT LPAREN expr RPAREN SEMICOLON ;
expr            = term { ( PLUS | MINUS ) term } ;
term            = unary { STAR unary } ;
unary           = MINUS unary | atom ;
atom            = INT | LPAREN expr RPAREN ;
