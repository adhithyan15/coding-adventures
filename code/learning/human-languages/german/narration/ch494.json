          "segments": [
            {
              "kind": "speech",
              "text": "zanken — \"to squabble (sich zanken)\"."
            },
            {
              "kind": "speech",
              "text": "Die Geschwister zanken sich um das letzte Stück Kuchen. The brother and sister are squabbling over the last piece of cake."
            },
            {
              "kind": "speech",
              "text": "Mostly reflexive: sich zanken um + accusative."
            }
          ]
        },
