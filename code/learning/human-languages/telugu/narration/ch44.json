    {
      "id": "TE-C44-look",
      "sequence": 1050,
      "title": "చూడు (cūḍu) — look",
      "headword": "చూడు",
      "romanization": "cūḍu",
      "gloss": "look",
      "script": "telugu",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:e0a24f7a216c4733",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Four verbs for taking things in and putting them out, one at a time."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: చూడు",
          "segments": [
            {
              "kind": "speech",
              "text": "చూడు (cūḍu) — \"look\"."
            },
            {
              "kind": "speech",
              "text": "You met it earlier as \"to see, to look\"; here it opens the run. It also stretches to 'to look after', the same three meanings Kannada packs into nōḍu, although the two verbs themselves are not related."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "చూడు (cūḍu) is native Dravidian. DEDR 2735 lists the Telugu verb cūcu, \"to see, look at\", with the stem cūḍ-, beside Kannada cūpu, \"sight\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more. Three follow, and each reuses the ones before."
            }
          ]
        },
        {
          "index": 4,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "cūḍu",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *cūḍu*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "it once more, slowly",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: it once more, slowly]"
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What does చూడు (cūḍu) mean? (\"look\".) Say it once more."
            }
          ]
        }
      ]
    },
