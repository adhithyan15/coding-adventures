        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: صحافة",
          "segments": [
            {
              "kind": "speech",
              "text": "صحافة — ṣaḥāfa — \"journalism; the press\"."
            },
            {
              "kind": "speech",
              "text": "درس أخي الصحافة في الجامعة. darasa akhī aṣ-ṣaḥāfa fī al-jāmiʿa. My brother studied journalism at university."
            },
            {
              "kind": "speech",
              "text": "A journalist is صحفي; the newspaper is صحيفة: one root."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "صحافة (ṣaḥāfa) is built on the native Arabic root ṣ-ḥ-f (Lane), a written leaf or page, the root of ṣaḥīfa. The modern sense, the press, comes from ṣaḥīfa, a newspaper."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling what happened."
            }
          ]
        },
