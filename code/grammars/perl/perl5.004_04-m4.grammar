# Perl 5.004_04-m4 (1998-05-19) plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: unsupported Perl 5.004_04-m4 syntax is rejected.
# Evidence: https://mirrors.develooper.com/perl/historical-perl/perl-5.004_04-m4.tar.gz
# Archive SHA-256: 8e883ceed74188b2cf69a8cb6247f80e8e8178c8904b9e1591c0342e20148241
# The maintenance perly.y adds postfix for and hash-element scalarization
# outside this subset; all four maintenance yacc blobs agree.
# This separate file retains arithmetic precedence, parentheses, and print only.

program         = print_statement { print_statement } ;
print_statement = PRINT LPAREN expr RPAREN SEMICOLON ;
expr            = term { ( PLUS | MINUS ) term } ;
term            = unary { STAR unary } ;
unary           = MINUS unary | atom ;
atom            = INT | LPAREN expr RPAREN ;
