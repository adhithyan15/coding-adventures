    {
      "id": "TE-R99-second-pass-welcome",
      "sequence": 3880,
      "title": "A warm welcome and short answers — a second pass",
      "headword": "(dialogue)",
      "romanization": "",
      "gloss": "second pass over short answers and a warm welcome",
      "script": "telugu",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:c2af6b2c4037b8b6",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "A friend arrives at your door. Greet them with palms together, and say you are delighted."
            }
          ]
        },
        {
          "index": 1,
          "type": "grammar",
          "title": "Grammar Lens: the ending -ఏ, \"exactly this\"",
          "segments": [
            {
              "kind": "table",
              "headers": [
                "word",
                "built from"
              ],
              "columns": 2,
              "rowCount": 2,
              "utterances": [
                "word: నిజమే. built from: truth + -ఏ.",
                "word: అదే. built from: that + -ఏ."
              ]
            },
            {
              "kind": "speech",
              "text": "The -ఏ points: this truth and no other, that one exactly."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": true,
              "source": "[PAUSE 2s each]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "hand over a gift; congratulate your friend",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: hand over a gift; congratulate your friend]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "say the wedding invitation came",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: say the wedding invitation came]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "someone asks what happened: it's nothing. Have you eaten? Not yet",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: someone asks what happened: it's nothing. Have you eaten? Not yet]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "agree that it's true; say that will do; and \"that's the one!\"",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: agree that it's true; say that will do; and \"that's the one!\"]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Nothing? (ఏమీ లేదు.) Not yet? (ఇంకా లేదు.) That will do? (సరిపోతుంది.) That's true? (నిజమే.) That's the one? (అదే.) Namaste? (నమస్తే (namastē).) Delight? (ఆనందం (ānandaṁ).) Congratulations? (అభినందనలు (abhinandanalu).) A gift? (బహుమతి (bahumati).) An invitation? (ఆహ్వానం (āhvānaṁ).)"
            }
          ]
        }
      ]
    },
