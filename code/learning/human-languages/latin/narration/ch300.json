        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: renūntiō, renūntiāre",
          "segments": [
            {
              "kind": "speech",
              "text": "renūntiō, renūntiāre — \"to bring back word, to report\"."
            },
            {
              "kind": "speech",
              "text": "Servus ad dominum rediit et omnia renūntiāvit. The slave went back to his master and reported everything."
            },
            {
              "kind": "speech",
              "text": "renūntiō, renūntiāre, renūntiāvī, renūntiātum: re- 'back' + nūntiō (taught). Also 'to declare someone elected', and 'to give up, to renounce'."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "renūntiō is built on nūntiō, \"to announce\", with re-, \"back\" (Lewis & Short): to carry word back. English renounce comes from another sense, \"to call off, to give up\"."
            }
          ]
        },
