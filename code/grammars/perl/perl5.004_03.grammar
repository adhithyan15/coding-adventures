# Perl 5.004_03 (1997-09-05) grammar: plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: unsupported Perl 5.004_03 syntax is rejected.
# Evidence: https://github.com/Perl/perl5/tree/perl-5.004_03
# Tagged perly.y matches the preceding source; this separate file
# retains only arithmetic precedence, parentheses and print subset.

program         = print_statement { print_statement } ;
print_statement = PRINT LPAREN expr RPAREN SEMICOLON ;
expr            = term { ( PLUS | MINUS ) term } ;
term            = unary { STAR unary } ;
unary           = MINUS unary | atom ;
atom            = INT | LPAREN expr RPAREN ;
