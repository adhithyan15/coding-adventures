              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: 他也是学生 — *tā yě shì xuésheng* — He's a student too.]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say wǒ xiǎngyào yìdiǎnr shuǐ, then answer it for yourself with 我也要 (wǒ yě yào)",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *wǒ xiǎngyào yìdiǎnr shuǐ*, then answer it for yourself with 我也要]"
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
