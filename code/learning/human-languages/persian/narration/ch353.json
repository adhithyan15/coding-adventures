          "segments": [
            {
              "kind": "speech",
              "text": "سده (sade) — \"a century\"."
            },
            {
              "kind": "speech",
              "text": "این مسجد در سده دوازدهم ساخته شد. In masjed dar sade-ye davâzdahom sâkhte shod. This mosque was built in the twelfth century."
            },
            {
              "kind": "speech",
              "text": "The native word for a century; qarn is the Arabic one. Also the name of a winter fire festival."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "sade is a native Persian word that EtymDB lists without a parent; it is usually linked with sad \"hundred\"."
            }
          ]
        },
