// Badge.mil — interface for the toolkit's Badge component.
//
// A small pill label. Bootstrap's `<span class="badge bg-primary">N</span>`
// equivalent. Used for counts, status indicators, tags.

component Badge {
  // Visible label text. Required.
  slot label : text ;

  // Variant keyword. The base style is primary when the host omits
  // this slot; the closed type rejects unknown values.
  slot variant : one-of primary secondary success danger warning info light dark ;
}
