  "lessons": [
    {
      "id": "ES-C12-hacer",
      "sequence": 1110,
      "title": "hacer — doing or making with three singular forms",
      "headword": "hacer",
      "romanization": "hacer",
      "gloss": "to do or make — with the singular present forms hago, haces, and hace",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:7417fd6e16c01507",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "You already use tengo, tienes, tiene, and you already know café and the question word qué. Reuse that small frontier for one verb that covers both English “do” and “make.”"
            }
          ]
        },
        {
          "index": 1,
          "type": "pronunciation",
          "title": "Sounds you'll need",
          "segments": [
            {
              "kind": "speech",
              "text": "The h in hacer is silent, just as it is in hola. In hago, the written g has the hard sound heard before a."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "hacer means “to do” or “to make.” It descends from Latin facere, with the same making root preserved in English fact, factory, and manufacture. Much of early Castilian changed word-initial Latin f into an h sound that later became silent, leaving the spelling as a historical trace."
            }
          ]
        },
        {
          "index": 3,
          "type": "grammar",
          "title": "Grammar Lens: only the three singular forms",
          "segments": [
            {
              "kind": "table",
              "headers": [
                "person",
                "present of hacer"
              ],
              "columns": 2,
              "rowCount": 3,
              "utterances": [
                "person: yo. present of hacer: hago.",
                "person: tú. present of hacer: haces.",
                "person: él / ella / usted. present of hacer: hace."
              ]
            },
            {
              "kind": "speech",
              "text": "Say the bounded set as hago, haces, hace. Only the learned yo form contains g. Compare it with the familiar tengo, but do not extend the comparison beyond forms you already own."
            },
            {
              "kind": "speech",
              "text": "Use the forms with one known object:"
            },
            {
              "kind": "speech",
              "text": "Hago café. — “I make coffee.”"
            },
            {
              "kind": "speech",
              "text": "Haces café. — “You make coffee.”"
            },
            {
              "kind": "speech",
              "text": "Hace café. — “He, she, or formal you makes coffee.”"
            },
            {
              "kind": "speech",
              "text": "You can also ask ¿Qué haces? — “What are you doing?” Plural persons and weather expressions wait for later lessons."
            }
          ]
        },
        {
          "index": 4,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
