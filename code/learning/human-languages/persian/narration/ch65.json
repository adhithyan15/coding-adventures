              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Persian for a week, then the Persian for a year."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: دقیقه",
          "segments": [
            {
              "kind": "speech",
              "text": "دقیقه — daghighe — \"a minute\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "daghighe is borrowed from Arabic daqīqa, \"minute\". Its Arabic root is d-q-q (Lane). The root means \"fine, thin\": a minute is a fine division of time."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
