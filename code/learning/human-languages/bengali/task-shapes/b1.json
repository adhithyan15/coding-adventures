  "administration": {"writtenMinutes": 125, "speakingMinutes": 15, "speakingGroupMaximum": 2, "speakingPreparationMinutes": 10, "deliveryModes": ["paper", "recorded-audio", "live-interlocutor"]},
  "passRule": {
    "maximumPoints": 400,
    "passPoints": 240,
    "requiresEverySectionAttempted": true,
    "independentSkillThresholds": {"reading": 0.6, "listening": 0.6, "writing": 0.6, "speaking": 0.6},
    "note": "Each skill is a separate 100-point paper and must independently reach 60/100; the 240-point headline sum cannot compensate for a failed paper. This project-defined assessment uses contemporary standard Bengali in Bengali script and is not an external qualification."
  },
