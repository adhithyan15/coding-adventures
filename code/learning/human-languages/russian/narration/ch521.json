          "index": 1,
          "type": "input",
          "title": "You'll want to know: кисть",
          "segments": [
            {
              "kind": "speech",
              "text": "кисть (kist) — \"a paintbrush; the hand\"."
            },
            {
              "kind": "speech",
              "text": "Художник взял тонкую кисть. Khudózhnik vzyal tónkuyu kist. The artist picked up a fine brush."
            },
            {
              "kind": "speech",
              "text": "Feminine. Also the hand from the wrist down, and a bunch of grapes."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "EtymDB lists кисть (kist), glossed 'cluster, bunch', without a source, and the origin is not settled."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
