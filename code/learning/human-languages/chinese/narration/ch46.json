    {
      "id": "ZH-W46-xing",
      "sequence": 3773,
      "title": "星 (xīng) — 日 above 生",
      "headword": "星",
      "romanization": "xīng",
      "gloss": "星 — 日 above 生",
      "script": "chinese",
      "modality": "pen",
