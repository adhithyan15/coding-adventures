          "segments": [
            {
              "kind": "speech",
              "text": "चुप (cup) is a tadbhava: CDIAL lists Hindi cup, \"silent\", under cuppa, a form it reconstructs (CDIAL 4864). cup raho! is \"be quiet!\"."
            }
