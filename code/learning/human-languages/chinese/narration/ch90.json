    {
      "id": "ZH-W90-neng",
      "sequence": 7370,
      "title": "能 (néng) — 厶 over the moon piece, then two 匕",
      "headword": "能",
      "romanization": "néng",
      "gloss": "能 — 厶 over the moon piece, then two 匕",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:457dae0a0f1760d8",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — 厶 over the moon piece, then two 匕",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — 厶 over the moon piece, then two 匕 and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say néng — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *néng* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "明 前."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — míng, qián",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *míng*, *qián*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — 厶 over the moon piece, then two 匕",
          "segments": [
            {
              "kind": "speech",
              "text": "能 (néng)."
            },
            {
              "kind": "speech",
              "text": "The whole left side first, top to bottom, then the right."
            },
            {
              "kind": "speech",
              "text": "厶, two strokes: a stroke that falls to the left and turns right, then a dot."
            },
            {
              "kind": "speech",
              "text": "The moon piece 月, four strokes, as it stands in 明 and 前: the left side, the top that turns down and hooks, two short bars inside."
            },
            {
              "kind": "speech",
              "text": "Two 匕, two strokes each, the upper one first: a short left-falling stroke, then a vertical that bends right along its foot and hooks up."
            },
            {
              "kind": "speech",
              "text": "2 + 4 + 4 = ten."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "能 (néng), all ten, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 能, all ten, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many strokes in 能 (néng)? (Ten.) Which piece do you know from 明? (The moon piece, 月.) Which side is written first? (The left, all of it.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 能 (néng), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
