        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: رتب",
          "segments": [
            {
              "kind": "speech",
              "text": "رتب — rattaba — \"to tidy, to arrange\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "رتب (rattaba) is built on the native Arabic root r-t-b, \"to be fixed, to be firm\" (Lane). Rattaba is Form II, \"to set in order\"."
            }
          ]
        },
