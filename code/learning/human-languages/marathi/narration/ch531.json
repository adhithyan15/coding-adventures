              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *phalandāj*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "phalandājāne ceṇḍū maidānābāher mārlā. — The batsman hit the ball out of the ground.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *phalandājāne ceṇḍū maidānābāher mārlā.* — The batsman hit the ball out of the ground.]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say the Marathi for a contestant, then the Marathi for to carry off, then say phalandāj again",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say the Marathi for a contestant, then the Marathi for to carry off, then say *phalandāj* again]"
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
