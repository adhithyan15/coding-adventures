              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say the Marathi for a subsidy, then the Marathi for economic, then say *āndolan* again]"
            }
          ]
        },
        {
          "index": 5,
