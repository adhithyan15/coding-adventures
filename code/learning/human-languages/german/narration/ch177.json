        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "bewerben is be- + the verb \"to recruit, to woo\", Old High German werban from Proto-Germanic hwerbaną, \"to turn\" (EtymDB 2.1). To apply is to court a post."
            }
          ]
        },
