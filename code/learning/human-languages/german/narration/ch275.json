        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: angeblich",
          "segments": [
            {
              "kind": "speech",
              "text": "angeblich — \"supposedly, allegedly\"."
            },
            {
              "kind": "speech",
              "text": "Angeblich war der Dieb ein junger Mann. Supposedly the thief was a young man."
            },
            {
              "kind": "speech",
              "text": "The speaker does not promise that it is true."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "angeblich is built on angeben \"to state\", from geben \"to give\", Old High German geban (EtymDB): as it is stated."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
