    {
      "id": "ZH-W362-xu-must",
      "sequence": 27835,
      "title": "须 (xū) — three sweeps, then the page piece",
      "headword": "须",
      "romanization": "xū",
      "gloss": "须 — three left-falling strokes, then the page piece of 题",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:79831cd4909bbd30",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — three sweeps, then the page piece",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — three sweeps, then the page piece and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say bìxū — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *bìxū* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "题 必."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — tí, bì",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *tí*, *bì*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — three sweeps, then the page piece",
          "segments": [
            {
              "kind": "speech",
              "text": "须 (xū)."
            },
            {
              "kind": "speech",
              "text": "Two pieces, left before right. Count the pieces, not the strokes."
            },
            {
              "kind": "speech",
              "text": "The left piece, three strokes: three short strokes falling to the left, one under another, the last the longest."
            },
            {
              "kind": "speech",
              "text": "The right piece, the page piece, six strokes, as on the right of 题: a horizontal, a short left-falling stroke, a vertical, a horizontal that turns down, a left-falling stroke inside, then a dot at the foot."
            },
            {
              "kind": "speech",
              "text": "3 + 6 = nine."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "须 (xū), all nine, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 须, all nine, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many pieces in 须 (xū)? (Two.) Where have you written the right piece? (On the right of 题.) How many strokes on the left? (Three, all falling to the left.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 须 (xū), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
