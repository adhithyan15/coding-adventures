          "title": "You'll want to know: apparecchiare",
          "segments": [
            {
              "kind": "speech",
              "text": "apparecchiare — \"to lay (a table)\"."
            },
            {
              "kind": "speech",
              "text": "Apparecchio la tavola per sei persone. I lay the dinner table for six people."
            },
            {
              "kind": "speech",
              "text": "Apparecchiare la tavola."
            }
          ]
        },
