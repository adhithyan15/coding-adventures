          "segments": [
            {
              "kind": "speech",
              "text": "明 (míng)."
            },
            {
              "kind": "speech",
              "text": "Two pieces, left before right: the sun, then the moon."
            },
            {
              "kind": "speech",
              "text": "日, four strokes, narrow and set a little high on the left."
            },
            {
              "kind": "speech",
              "text": "The moon, four strokes, as on the right of 期: a left-falling stroke, a horizontal that turns down and hooks, and two short horizontals inside."
            },
            {
              "kind": "speech",
              "text": "4 + 4 = eight."
            }
          ]
        },
