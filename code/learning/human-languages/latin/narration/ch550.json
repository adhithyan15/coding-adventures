            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Latin for a public reading, then the Latin for a listener."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: litterātus, litterāta, litterātum",
          "segments": [
            {
              "kind": "speech",
              "text": "litterātus, litterāta, litterātum — \"learned, well-read\"."
            },
            {
              "kind": "speech",
              "text": "Vir litterātus multōs librōs habet. The learned man has many books."
            },
            {
              "kind": "speech",
              "text": "From litterae — letters, learning. English literate."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "litterātus is built on littera \"a letter\" (Lewis & Short; EtymDB): lettered, learned. English literate comes from it."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
