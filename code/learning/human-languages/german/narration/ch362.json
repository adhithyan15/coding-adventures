        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: das Ehrenamt",
          "segments": [
            {
              "kind": "speech",
              "text": "das Ehrenamt — \"voluntary work, an unpaid post\"."
            },
            {
              "kind": "speech",
              "text": "Neben dem Beruf hat sie ein Ehrenamt im Sportverein. Besides her job she has an unpaid post at the sports club."
            },
            {
              "kind": "speech",
              "text": "Plural: die Ehrenämter. Literally an office of honour."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Ehrenamt joins Ehre \"honour\", Old High German ēra (EtymDB), to Amt \"office\", from Middle High German ambahte (EtymDB), a word that goes back to Proto-Germanic ambahtaz \"follower, servant\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
