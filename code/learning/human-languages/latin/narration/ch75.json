              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Latin for a farmer, then the Latin for a field."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: labōrō, labōrāre",
          "segments": [
            {
              "kind": "speech",
              "text": "labōrō, labōrāre — \"to work\". English labour."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "labōrō is built on labor, \"toil, effort\" (Lewis & Short): to work is to put in labor. Where labor itself comes from is uncertain."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
