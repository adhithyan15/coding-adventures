        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: خاراندن",
          "segments": [
            {
              "kind": "speech",
              "text": "خاراندن — khârândan — \"to scratch (an itch)\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "khârândan is built from khâr-, the stem of khâridan, \"to itch\", as its causative: to make the itch go. The verb is native Persian, inherited rather than borrowed."
            }
          ]
        },
