style SpiceWorkbench {
  part workbench { background : "#f8fafc" ; color : "#1f2937" ; padding : 16 ; gap : 12 ; }
  part workbench-header { align : center-vertical ; }
  part workbench-title { width : 100% ; font-size : 20 ; font-weight : bold ; color : "#0f172a" ; }
  part workbench-mode { background : "#e0f2fe" ; color : "#075985" ; border-radius : 4 ; padding : 5 ; }
  part deck-editor { gap : 6 ; }
  part schematic { gap : 6 ; }
  part schematic-label { font-size : 12 ; font-weight : bold ; color : "#475569" ; }
  part schematic-title { color : "#0f172a" ; font-weight : bold ; }
  part schematic-palette { gap : 6 ; }
  part schematic-palette-item { background : "#ecfeff" ; color : "#155e75" ; border-width : 1 ; border-color : "#67e8f9" ; border-radius : 3 ; padding : 6 ; }
  part schematic-analysis-label { font-size : 12 ; font-weight : bold ; color : "#475569" ; }
  part schematic-analysis-controls { gap : 6 ; }
  part schematic-analysis-control { background : "#f5f3ff" ; color : "#5b21b6" ; border-width : 1 ; border-color : "#c4b5fd" ; border-radius : 3 ; padding : 6 ; }
  part schematic-analysis-card-label { font-size : 12 ; font-weight : bold ; color : "#475569" ; }
  part schematic-analysis-cards { gap : 6 ; }
  part schematic-analysis-card { background : "#eef2ff" ; color : "#4338ca" ; border-width : 1 ; border-color : "#a5b4fc" ; border-radius : 3 ; padding : 6 ; }
  part selected-schematic-analysis { color : "#6d28d9" ; font-weight : bold ; }
  part schematic-analysis-configuration { gap : 4 ; }
  part schematic-analysis-configuration-label { font-size : 12 ; font-weight : bold ; color : "#475569" ; }
  part remove-schematic-analysis-card { background : "#fff1f2" ; color : "#9f1239" ; border-width : 1 ; border-color : "#fda4af" ; border-radius : 3 ; padding : 6 ; }
  part schematic-analysis-source-label { font-size : 12 ; color : "#475569" ; }
  part schematic-analysis-source-options { gap : 6 ; }
  part schematic-analysis-source-option { background : "#eef2ff" ; color : "#4338ca" ; border-width : 1 ; border-color : "#a5b4fc" ; border-radius : 3 ; padding : 6 ; }
  part selected-schematic-analysis-source { color : "#5b21b6" ; font-family : "monospace" ; }
  part schematic-analysis-parameter-one-label { font-size : 12 ; color : "#475569" ; }
  part schematic-analysis-parameter-two-label { font-size : 12 ; color : "#475569" ; }
  part schematic-analysis-parameter-three-label { font-size : 12 ; color : "#475569" ; }
  part schematic-analysis-parameter-one-input { background : "#ffffff" ; color : "#0f172a" ; border-width : 1 ; border-color : "#cbd5e1" ; border-radius : 3 ; padding : 6 ; font-family : "monospace" ; }
  part schematic-analysis-parameter-two-input { background : "#ffffff" ; color : "#0f172a" ; border-width : 1 ; border-color : "#cbd5e1" ; border-radius : 3 ; padding : 6 ; font-family : "monospace" ; }
  part schematic-analysis-parameter-three-input { background : "#ffffff" ; color : "#0f172a" ; border-width : 1 ; border-color : "#cbd5e1" ; border-radius : 3 ; padding : 6 ; font-family : "monospace" ; }
  part schematic-grid-label { font-size : 12 ; font-weight : bold ; color : "#475569" ; }
  part schematic-grid { width : 360 ; min-height : 240 ; background : "#ffffff" ; border-width : 1 ; border-color : "#cbd5e1" ; }
  part schematic-grid-line { border-color : "#e2e8f0" ; border-width : 1 ; }
  part schematic-wire-segment { border-color : "#0369a1" ; border-width : 2 ; }
  part schematic-terminal { background : "#f59e0b" ; border-color : "#92400e" ; border-width : 1 ; }
  part schematic-components { gap : 6 ; }
  part schematic-component { background : "#ffffff" ; color : "#0f172a" ; border-width : 1 ; border-color : "#cbd5e1" ; border-radius : 3 ; padding : 6 ; }
  part selected-schematic { color : "#0369a1" ; font-weight : bold ; }
  part schematic-properties { gap : 4 ; }
  part schematic-properties-label { font-size : 12 ; font-weight : bold ; color : "#475569" ; }
  part selected-schematic-kind { color : "#0f172a" ; }
  part schematic-value-label { font-size : 12 ; color : "#475569" ; }
  part schematic-value-input { background : "#ffffff" ; color : "#0f172a" ; border-width : 1 ; border-color : "#cbd5e1" ; border-radius : 3 ; padding : 6 ; font-family : "monospace" ; }
  part route-schematic { font-size : 12 ; font-weight : bold ; color : "#475569" ; }
  part schematic-route-targets { gap : 6 ; }
  part schematic-route-target { background : "#f0fdfa" ; color : "#115e59" ; border-width : 1 ; border-color : "#5eead4" ; border-radius : 3 ; padding : 6 ; }
  part synchronize-schematic { background : "#fef3c7" ; color : "#92400e" ; border-width : 1 ; border-color : "#fcd34d" ; border-radius : 4 ; padding : 8 ; }
  part netlist-label { font-size : 12 ; font-weight : bold ; color : "#475569" ; }
  part diagnostics-label { font-size : 12 ; font-weight : bold ; color : "#475569" ; }
  part analysis-label { font-size : 12 ; font-weight : bold ; color : "#475569" ; }
  part result-label { font-size : 12 ; font-weight : bold ; color : "#475569" ; }
  part netlist-input { min-height : 240 ; background : "#ffffff" ; color : "#0f172a" ; border-width : 1 ; border-color : "#cbd5e1" ; border-radius : 4 ; padding : 10 ; font-family : "monospace" ; }
  part workbench-actions { gap : 8 ; }
  part inspect-button { background : "#e0f2fe" ; color : "#075985" ; border-width : 1 ; border-color : "#7dd3fc" ; border-radius : 4 ; padding : 8 ; }
  part run-button { background : "#dcfce7" ; color : "#166534" ; border-width : 1 ; border-color : "#86efac" ; border-radius : 4 ; padding : 8 ; }
  part diagnostics { color : "#334155" ; }
  part diagnostic-row { color : "#b91c1c" ; font-family : "monospace" ; }
  part workbench-body { gap : 14 ; }
  part analyses { width : "30%" ; gap : 6 ; }
  part analysis-option { background : "#ffffff" ; color : "#0f172a" ; border-width : 1 ; border-color : "#cbd5e1" ; border-radius : 3 ; padding : 7 ; }
  part selected-analysis { color : "#0369a1" ; font-weight : bold ; }
  part results { width : "70%" ; gap : 6 ; }
  part result-table { background : "#ffffff" ; border-width : 1 ; border-color : "#cbd5e1" ; }
  part result-header { background : "#e0f2fe" ; color : "#0f172a" ; font-weight : bold ; padding : 6 ; }
  part result-cell { color : "#0f172a" ; padding : 6 ; font-family : "monospace" ; }
  part waveforms { gap : 6 ; }
  part waveform-label { font-size : 12 ; font-weight : bold ; color : "#475569" ; }
  part waveform-options { gap : 6 ; }
  part waveform-option { background : "#ffffff" ; color : "#0f172a" ; border-width : 1 ; border-color : "#cbd5e1" ; border-radius : 3 ; padding : 6 ; }
  part selected-waveform { color : "#0f766e" ; font-weight : bold ; }
  part waveform-axis { color : "#475569" ; font-size : 12 ; }
  part waveform-plot { width : 360 ; min-height : 220 ; background : "#ffffff" ; border-width : 1 ; border-color : "#cbd5e1" ; }
  part waveform-axis-x { border-color : "#94a3b8" ; border-width : 1 ; }
  part waveform-axis-y { border-color : "#94a3b8" ; border-width : 1 ; }
  part waveform-segment { border-color : "#0f766e" ; border-width : 2 ; }
  part raw-result-label { font-size : 12 ; font-weight : bold ; color : "#475569" ; }
  part result-output { min-height : 160 ; background : "#ffffff" ; color : "#0f172a" ; border-width : 1 ; border-color : "#cbd5e1" ; border-radius : 4 ; padding : 10 ; font-family : "monospace" ; white-space : "pre-wrap" ; }
}
