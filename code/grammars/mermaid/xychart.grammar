# @version 1
#
# Mermaid 11.16.1 XY-chart parser grammar. Semantic lowering validates axis
# forms and numeric data after this grammar establishes statement boundaries.

document = { terminator } HEADER [ ORIENTATION ] { terminator | statement } EOF ;
terminator = NEWLINE | SEMICOLON ;
statement = ACC_TITLE_STATEMENT | ACC_DESCR_STATEMENT | ACC_DESCR_BLOCK | TITLE_STATEMENT | X_AXIS_STATEMENT | Y_AXIS_STATEMENT | LINE_STATEMENT | BAR_STATEMENT ;
