        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: عين",
          "segments": [
            {
              "kind": "speech",
              "text": "عين — ʿayn — \"an eye\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "عين (ʿayn) is built on the native Arabic root ʿ-y-n, \"an eye; a spring of water\" (Lane). The letter ʿayn carries the same name, and Hebrew ʿayin, \"eye\", is its cousin."
            }
          ]
        },
        {
