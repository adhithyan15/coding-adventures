        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: die Melodie",
          "segments": [
            {
              "kind": "speech",
              "text": "die Melodie — \"melody, tune\"."
            },
            {
              "kind": "speech",
              "text": "Die Melodie von diesem Lied ist sehr schön. The tune of this song is very beautiful."
            },
            {
              "kind": "speech",
              "text": "Plural: die Melodien."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Melodie was borrowed, through Late Latin melōdia, from Greek melōidía \"singing, a song\"; EtymDB lists the German word without a source."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
