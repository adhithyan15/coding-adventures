    {
      "id": "ZH-W505-wu-dance",
      "sequence": 37995,
      "title": "舞 (wǔ) — eight strokes on top, then two pieces below",
      "headword": "舞",
      "romanization": "wǔ",
      "gloss": "舞 — eight strokes on top, then the top of 多 and three more",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:2c0cd0a2c3652168",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — eight strokes on top, then two pieces below",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — eight strokes on top, then two pieces below and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say wǔhuì — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *wǔhuì* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "多 会."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — duō, huì",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *duō*, *huì*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — eight strokes on top, then two pieces below",
          "segments": [
            {
              "kind": "speech",
              "text": "舞 (wǔ)."
            },
            {
              "kind": "speech",
              "text": "The top, eight strokes. A short stroke falling to the left. A short bar, then a longer bar under it. Four short verticals through it, from left to right. Then a long bar across the whole width."
            },
            {
              "kind": "speech",
              "text": "The lower left, three strokes, as on top of 多: a stroke falling to the left, a bar that turns and falls to the left, and a dot."
            },
            {
              "kind": "speech",
              "text": "The lower right, three strokes: a bar, a stroke that drops and turns to the right, then a long vertical down through them."
            },
            {
              "kind": "speech",
              "text": "8 + 3 + 3 = fourteen."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "舞 (wǔ), all fourteen, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 舞, all fourteen, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many strokes does 舞 (wǔ) have? (Fourteen.) How many short verticals in the top? (Four.) Which character you know has the lower left piece on top? (多.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 舞 (wǔ), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
