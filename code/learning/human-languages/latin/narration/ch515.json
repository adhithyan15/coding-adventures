          "index": 1,
          "type": "input",
          "title": "You'll want to know: vultus, vultūs",
          "segments": [
            {
              "kind": "speech",
              "text": "vultus, vultūs — \"face, expression\"."
            },
            {
              "kind": "speech",
              "text": "Vultus mātris laetus est. Mother's face is happy."
            },
            {
              "kind": "speech",
              "text": "Masculine, fourth declension. The face as it shows feeling and mood."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "vultus is a native Latin noun; EtymDB links it with a Proto-Indo-European root meaning \"to see\", while Lewis & Short calls it doubtful, so the origin is not settled."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
