          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ಪ್ರಬಂಧ (prabandha) is borrowed from Sanskrit prabandha, \"a connection, a continuous composition\" (CDIAL 8695)."
            }
          ]
        },
