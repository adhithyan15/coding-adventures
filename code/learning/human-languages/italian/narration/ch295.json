          "type": "input",
          "title": "You'll want to know: indagare",
          "segments": [
            {
              "kind": "speech",
              "text": "indagare — \"to investigate\"."
            },
            {
              "kind": "speech",
              "text": "La polizia indaga sulla rapina. The police are investigating the robbery."
            },
            {
              "kind": "speech",
              "text": "Indagare su qualcosa."
