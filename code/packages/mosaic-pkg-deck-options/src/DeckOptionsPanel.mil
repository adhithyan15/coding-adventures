// DeckOptionsPanel.mil - reusable Anki-style deck scheduler settings surface.
//
// Hosts can route changes through Engram's shared event facade, which persists
// them with the shared `setDeckOptions` reducer command.

component DeckOptionsPanel {
  slot settings-label : text ;
  slot new-cards-label : text ;
  slot new-cards-value : number ;
  slot reviews-label : text ;
  slot reviews-value : number ;
  slot graduating-interval-label : text ;
  slot graduating-interval-value : number ;
  slot easy-interval-label : text ;
  slot easy-interval-value : number ;
  slot maximum-interval-label : text ;
  slot maximum-interval-value : number ;
  slot interval-modifier-label : text ;
  slot interval-modifier-value : number ;
  slot hard-multiplier-label : text ;
  slot hard-multiplier-value : number ;
  slot easy-bonus-label : text ;
  slot easy-bonus-value : number ;
  slot lapse-multiplier-label : text ;
  slot lapse-multiplier-value : number ;

  emit onNewCardsChange ( value : number ) ;
  emit onReviewsChange ( value : number ) ;
  emit onGraduatingIntervalChange ( value : number ) ;
  emit onEasyIntervalChange ( value : number ) ;
  emit onMaximumIntervalChange ( value : number ) ;
  emit onIntervalModifierChange ( value : number ) ;
  emit onHardMultiplierChange ( value : number ) ;
  emit onEasyBonusChange ( value : number ) ;
  emit onLapseMultiplierChange ( value : number ) ;
}
