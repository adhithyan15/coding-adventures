          "segments": [
            {
              "kind": "speech",
              "text": "ворота (voróta) — \"gates; the goal (in football)\"."
            },
            {
              "kind": "speech",
              "text": "Мяч пролетел мимо ворот. Myach proletél mímo vorót. The ball flew past the goal."
            },
            {
              "kind": "speech",
              "text": "Plural only; genitive ворот."
