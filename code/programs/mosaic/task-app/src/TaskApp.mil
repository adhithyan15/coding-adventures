// TaskApp — interface (mosmodel).
//
// A to-do app that *auto-schedules*. The host fills these slots from the pure
// task-core engine (via task-wasm) and turns the emitted events back into engine
// operations. Each row is a *list of cells* — [done-glyph, name, due, schedule,
// overdue] — pre-formatted by the engine's `table` projection, so the layout can
// place each cell in its own styled element (a real toggle, the name, meta chips)
// via a `For` over `list<list<text>>` with `( row[n] )` cell access. The cell order
// here is the contract between the host (main.tsx) and the layout's `row[n]` indices.

component TaskApp {
  // Header + add-row inputs.
  slot app-title     : text ;
  slot new-task-name : text ;
  slot new-task-due  : text ;

  // The workspace's projects, depth-first so a sub-project follows its parent. Each row
  // is [ name, active-marker, indent ]: the marker is non-empty for exactly the project
  // being shown (the layout renders that one as selected), and `indent` is a non-empty
  // glyph for a *nested* project, empty for a top-level one — which is what turns a
  // flat list into a visible hierarchy. Everything else in this interface (tasks,
  // summary, schedule) describes the active project.
  //
  // Straight pass-through to pkg::mosaic-pkg-project-nav::ProjectNav — see
  // ProjectNav.mil for the full contract and
  // code/specs/task-app-project-nav-v1.md for the extraction rationale
  // (the tree + composer moved into the package; the brand row and the
  // view-switcher deliberately did not).
  slot project-rows     : list<list<text>> ;
  slot new-project-name : text ;

  // A one-line summary (counts, project finish), plus the engine's verdict on the
  // plan rendered as a pill. `status-warn` is non-empty when that verdict is bad
  // news, which is the layout's cue to colour it as a warning rather than as OK.
  slot summary      : text ;
  slot status-label : text ;
  slot status-warn  : text ;

  // The project-progress ring (task-app-icon-assets-v1.md) — the workspace's
  // overall percent-complete as a circular fill, next to the view switcher.
  // `ring-gradient` is a host-computed `conic-gradient(...)` CSS string (the
  // one value in this whole component bound through UI36's `background`
  // property rather than a size — see the spec's "the one real gap" section);
  // `ring-percent` is the same number pre-formatted for the caption ("25%").
  // `ring-percent-value` (#12028 item 2, first half) is the raw 0..100
  // number itself — every host already computed this number internally to
  // build `ring-gradient`/`ring-percent`, but never exposed it as typed
  // data. Native hosts previously received `ring-gradient: ""` (the web
  // host's CSS trick is web-only; nothing else can consume a CSS string)
  // with no numeric fallback to render *anything* from — this closes that
  // gap. Native *rendering* of the ring from this number is a separate,
  // still-open follow-up (see #12028 item 2's tracking comment) — this
  // slot only stops the data from leaking.
  slot ring-gradient       : text ;
  slot ring-percent        : text ;
  slot ring-percent-value  : number ;

  // The theme toggle (task-app-icon-assets-v1.md) — moved into the topbar
  // from a `position: fixed` button main.tsx used to render entirely outside
  // this component (invisible to mostyle, unreachable by keyboard nav in
  // document order). `theme-is-dark` follows the same "non-empty slot gates
  // a branch" idiom as `status-warn`/`allow-timeline` above — non-empty when
  // the CURRENT theme is dark, so the layout shows a sun (the icon for the
  // theme you'd switch TO) rather than needing string-equality comparison.
  slot theme-is-dark : text ;
  emit onToggleTheme ;

  // Per-project complexity toggle (Board ↔ Full CPM) — see
  // code/specs/task-app-complexity-config-v1.md. `complexity-label` names the
  // active project's CURRENT tier ("Board" / "Full CPM"), for a single small
  // topbar button that flips it. `allow-timeline` is non-empty only when the
  // active project is Full — it gates the Timeline button out of the
  // view-switcher entirely for a Board-tier project, since the engine keeps
  // computing CPM either way but Board tier deliberately never shows it.
  slot complexity-label : text ;
  slot allow-timeline   : text ;

  // Timeline (Gantt). `timeline-mode` is non-empty when the timeline is showing instead
  // of the task list, and `view-toggle-label` names the view you'd switch TO.
  // See code/specs/task-app-richer-gantt-v1.md for the day-grid/milestone/tooltip
  // richness this view gained beyond the original plain proportional-bar chart.
  //
  // Each timeline row is
  // [ name, pad-width, bar-width, window, critical-marker, milestone-marker,
  //   percent-complete, tooltip-text ]. `pad-width` and `bar-width` are CSS
  // percentages of the shared track (e.g. "18%"), so every bar sits on one date
  // scale — they reach the layout through UI36 data-driven sizing
  // (`width: ( t[n] )`). `timeline-scale` is the matching date ruler. A non-empty
  // `critical-marker` means the row is on the critical path; a non-empty
  // `milestone-marker` means the layout renders a diamond instead of the usual
  // bar (a zero-duration `TaskKind::Milestone` task). `percent-complete` is a
  // CSS-ready percentage ("40%") for a darker fill inside the bar — meaningless
  // for a milestone row, so the layout only reads it in the non-milestone
  // branch. `tooltip-text` wraps the bar in the kernel's `HostTooltip`.
  //
  // `timeline-grid` is the day-grid BEHIND the bars: one row per calendar day
  // in the visible span, [ width-pct, weekend-marker, today-marker ]. Both
  // markers are non-empty/empty the same way `critical-marker` is — the layout
  // picks a styled variant per branch, not a bound colour.
  slot timeline-mode     : text ;
  slot timeline-grid     : list<list<text>> ;

  // Board (kanban). `board-mode` is non-empty when the board is showing.
  //
  //   board-columns : one per status, [ title, key, count, accent-color ]
  //   board-cards   : one per task,   [ name, column-key, task-id, overdue ]
  //
  // `column-key` (both lists) is one of the workflow's real status ids
  // (task-app-super-app.md's design-fidelity item; see
  // `ProjectState::ensure_default_workflow` in task-core) — no longer the
  // old completed/percent-complete heuristic. `count` is the column's real
  // card count, appended so the header can show it without the layout
  // doing its own counting. `accent-color` is a UI36-bound value (the
  // `col[3]` a `For`-loop row can't be resolved by the stylesheet
  // alone) — the host resolves it to the theme-correct hex per column,
  // same reasoning as `ring-gradient`. `overdue` — despite its historical
  // name in this codebase, this is the `OVERDUE` builtin field, not CPM
  // criticality (Board-tier projects have no CPM data); it drives a
  // colored left border on the card, not text, per the design-fidelity
  // item's own wording.
  //
  // A card is placed by comparing its column-key with the column's, rather than by
  // nesting a list inside a list — the layout can express that with a single `If`,
  // and it keeps both loops flat enough to read.
  //
  // Dropping carries KEYS, never indices: that is what makes the drag kernel usable
  // from a nested loop at all, since an inner loop's index would otherwise shadow the
  // outer one and a card would report the wrong row.
  slot board-mode    : text ;
  slot board-columns : list<list<text>> ;
  slot board-cards   : list<list<text>> ;
  slot timeline-scale    : text ;
  slot timeline-rows     : list<list<text>> ;

  // Sheet (spreadsheet). `sheet-mode` is non-empty when the sheet is showing. Every
  // `sheet-*` slot is a straight pass-through to `pkg::mosaic-pkg-sheet::Sheet` — see
  // Sheet.mil for the full contract. TaskApp adds no shaping of its own here; the host
  // builds the sheet's rows from the SAME `table(view)` projection call it already uses
  // for the list view, just with a broader `visibleFields` and the current filter/sort.
  slot sheet-mode           : text ;
  slot sheet-viewport-rows  : list<list<text>> ;
  slot sheet-column-headers : list<text> ;
  slot sheet-column-widths  : list<number> ;
  slot sheet-selected-row   : number ;
  slot sheet-selected-col   : number ;
  slot sheet-edit-row       : number ;
  slot sheet-edit-col       : number ;
  slot sheet-edit-content   : text ;
  slot sheet-filter-text    : text ;
  slot sheet-sort-field      : text ;
  slot sheet-sort-options    : list<text> ;
  slot sheet-sort-open        : bool ;
  slot sheet-sort-ascending   : bool ;

  // The label composer wrapping the Sheet (see TaskApp.mll's sheet-mode branch).
  // Deliberately TaskApp's own concern, not a mosaic-pkg-sheet slot — Sheet is a
  // generic grid+toolbar wrapper and has no business knowing about labels
  // specifically. Assignment (typing an existing label's name into a task's Labels
  // cell) goes through the Sheet's own editable-cell mechanism instead; this
  // composer is creation only.
  slot new-label-name : text ;

  // Calendar (month grid). `calendar-mode` is non-empty when the calendar is
  // showing. Every `calendar-*` slot is a straight pass-through to
  // `pkg::mosaic-pkg-calendar::Calendar` — see Calendar.mil for the full
  // contract and code/specs/task-app-calendar-v1.md for the scope. The host
  // builds calendar-cells/calendar-events from the SAME `calendar(range,
  // view)` engine call each time the visible month changes.
  slot calendar-mode   : text ;
  slot calendar-title  : text ;
  slot calendar-cells  : list<list<text>> ;
  slot calendar-events : list<list<text>> ;

  // Notes (list + editor). `notes-mode` is non-empty when the notes view is
  // showing. Every `notes-*` slot is a straight pass-through to
  // `pkg::mosaic-pkg-notes::Notes` — see Notes.mil for the full contract
  // and code/specs/task-app-notes-ui-v1.md for the scope. The host builds
  // note-rows from task-core's Note entities (via `workspace()`) and owns
  // the in-progress edit buffer.
  slot notes-mode          : text ;
  slot notes-title         : text ;
  slot note-rows           : list<list<text>> ;
  slot selected-note-id    : text ;
  slot note-title-value    : text ;
  slot note-body-value     : text ;
  slot note-task-value     : text ;

  // One row per task, in schedule order. Each row is a list of pre-formatted cells:
  //
  //   [ 0 ] done-glyph      [ 5  ] expanded-marker  — non-empty for the ONE open row
  //   [ 1 ] name            [ 6  ] detail: scheduled / earliest / latest
  //   [ 2 ] due             [ 7  ] detail: slack, or "on the critical path"
  //   [ 3 ] schedule        [ 8  ] detail: free slack (only when it differs)
  //   [ 4 ] overdue         [ 9  ] group heading — present ONLY on the row that
  //                                opens a group, so the list reads as sections
  //                         [ 10 ] priority display name (e.g. "High"), or empty
  //                         [ 11 ] labels, comma-joined display names, or empty
  //                         [ 12 ] detail: dependency list (predecessors/successors,
  //                                each labelled FS/SS/FF/SF), or empty
  //                         [ 13 ] detail: attached notes' body text, or empty
  //                         [ 14 ] group-count badge (task-app-icon-assets-v1.md) —
  //                                present ONLY alongside cell 9, same row, same
  //                                "opens a group" gating; the count of tasks in
  //                                THIS group, pre-formatted (e.g. "2")
  //
  // Every cell is optional: an empty one (no due date, not overdue, nothing to add)
  // is the empty string and the layout hides it. Cells 6-8 and 12-13 are the
  // progressive-disclosure payload, filled ONLY for the expanded row — so a collapsed
  // list stays a plain to-do list, and the host skips the CPM recompute (and the
  // dependency/notes lookups) entirely when nothing is open. 10-14 are appended
  // rather than inserted between 9 and the old end, so no existing row[n] reference
  // anywhere shifts meaning. Cell 13 was drafted once before and pulled back out
  // because nothing could populate `Note.attached_task` — now that
  // `pkg::mosaic-pkg-notes::Notes` has the attach-to-task field (see its own
  // Notes.mil and code/specs/task-app-notes-ui-v1.md's addendum), the read side
  // is reachable and ships here.
  //
  // For a Board-tier project (see `complexity-label`/`allow-timeline` above and
  // task-app-complexity-config-v1.md), the host additionally blanks cells 3
  // (schedule window) and 6-8 (the CPM-derived detail lines) regardless of
  // whether the row is expanded — Board tier hides these everywhere, not just
  // in the collapsed state. Cells 2/4 (due/overdue) and 12/13 (dependencies/
  // notes) are unaffected: they're basic todo-app concepts per the spec's
  // Decision 4, not CPM output, so Board tier keeps them.
  slot task-rows : list<list<text>> ;

  // Typing in the inputs.
  emit onNewTaskNameChange ( value : text ) ;
  emit onNewTaskDueChange ( value : text ) ;
  emit onNewProjectNameChange ( value : text ) ;

  // Create a project (top-level, or nested under the one currently shown), and switch
  // which one is shown (by row index).
  emit onAddProject ;
  emit onAddSubproject ;
  emit onSelectProject ( index : number ) ;

  // Flip the active project's complexity tier (Board ↔ Full).
  emit onToggleProjectComplexity ;

  // Choose a view. Two explicit events rather than one toggle, so clicking the view
  // you are already on is a no-op instead of switching away from it.
  emit onShowList ;
  emit onShowBoard ;
  emit onShowTimeline ;
  emit onShowSheet ;
  emit onShowCalendar ;
  emit onShowNotes ;

  // A drop is a PROPOSAL: the engine decides whether the move is legal and performs
  // it. The payload is the UI35 contract — what moved, of what kind, onto which
  // target, and where within it.
  emit onCardDropped ( key : text , kind : text , targetKey : text , position : text ) ;

  // Sheet emits — straight pass-through to/from pkg::mosaic-pkg-sheet::Sheet.
  emit onSheetNavigate ( row : number , col : number ) ;
  emit onSheetFormulaChange ( value : text ) ;
  emit onSheetEditCommit ( value : text ) ;
  emit onSheetEditCancel ;
  emit onSheetFilterChange        ( value : text ) ;
  emit onSheetSortFieldChange     ( value : text ) ;
  emit onSheetToggleSortOpen ;
  emit onSheetToggleSortDirection ;

  // Label composer (TaskApp's own — see the new-label-name slot's note).
  emit onNewLabelNameChange ( value : text ) ;
  emit onAddLabel ;

  // Calendar emits — straight pass-through to/from pkg::mosaic-pkg-calendar::Calendar.
  emit onCalendarPrev ;
  emit onCalendarNext ;
  emit onCalendarEventDropped ( key : text , kind : text , targetKey : text , position : text ) ;

  // Notes emits — straight pass-through to/from pkg::mosaic-pkg-notes::Notes.
  emit onSelectNote ( index : number ) ;
  emit onNewNote ;
  emit onNoteTitleChange ( value : text ) ;
  emit onNoteBodyChange ( value : text ) ;
  emit onNoteTaskNameChange ( value : text ) ;
  emit onSaveNote ;
  emit onDeleteNote ;
  emit onCancelNote ;

  // Expand (or collapse) a task row to reveal its scheduling detail.
  emit onExpandTask ( index : number ) ;

  // Add the typed task; toggle/delete a row (the row index is delivered as the number
  // payload of a single-number-param event).
  emit onAddTask ;
  emit onToggleTask ( index : number ) ;
  emit onDeleteTask ( index : number ) ;
}
