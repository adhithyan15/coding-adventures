    {
      "id": "ZH-W422-bei-north",
      "sequence": 32045,
      "title": "北 (běi) — two halves back to back",
      "headword": "北",
      "romanization": "běi",
      "gloss": "北 — a vertical with two short bars, then a falling stroke and a bending hook",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:a527dc05abe81f52",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — two halves back to back",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — two halves back to back and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say dōngběi — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *dōngběi* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "比 东."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — bǐ, dōng",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *bǐ*, *dōng*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — two halves back to back",
          "segments": [
            {
              "kind": "speech",
              "text": "北 (běi)."
            },
            {
              "kind": "speech",
              "text": "Two halves, left before right."
            },
            {
              "kind": "speech",
              "text": "The left half, three strokes. A vertical. A short bar from the left into it. Then a bar rising to the right into its foot, from the left."
            },
            {
              "kind": "speech",
              "text": "The right half, two strokes, as on the right of 比: a stroke falling to the left, then a vertical that bends to the right along the foot and hooks up."
            },
            {
              "kind": "speech",
              "text": "3 + 2 = five."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "北 (běi), all five, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 北, all five, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many strokes in 北 (běi)? (Five.) What is the right half? (The right half of 比.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 北 (běi), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
