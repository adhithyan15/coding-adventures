        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "طابع (ṭābiʿ) is built on the native Arabic root ṭ-b-ʿ, \"to seal, to stamp\" (Lane). Ṭābiʿ is the active participle, \"a stamp\"; the postage stamp is a modern sense."
            }
          ]
        },
