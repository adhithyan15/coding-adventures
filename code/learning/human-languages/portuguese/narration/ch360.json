        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: a promoção",
          "segments": [
            {
              "kind": "speech",
              "text": "a promoção — \"the promotion; the special offer\"."
            },
            {
              "kind": "speech",
              "text": "Ela recebeu uma promoção depois de dois anos. She got a promotion after two years."
            },
            {
              "kind": "speech",
              "text": "In shops, em promoção — on special offer."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "promoção is a learned borrowing from Latin prōmōtiō \"advancement, promotion\" (EtymDB, Lewis & Short), from prōmovēre \"to move forward\", on movēre \"to move\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
