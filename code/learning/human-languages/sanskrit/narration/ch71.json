              "action": "SAY",
              "instruction": "dhāvati",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *dhāvati*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "dhāvati, once more",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *dhāvati*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "say bālaḥ dhāvati",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: say *bālaḥ dhāvati*]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say the Sanskrit for the shoulder, then the Sanskrit for the lip, then say dhāvati again",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say the Sanskrit for the shoulder, then the Sanskrit for the lip, then say *dhāvati* again]"
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What does धावति (dhāvati) mean? (\"Runs\".) Say it once more."
            }
          ]
        }
      ]
