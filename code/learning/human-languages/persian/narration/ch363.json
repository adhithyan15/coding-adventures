          "index": 1,
          "type": "input",
          "title": "You'll want to know: ادعا",
          "segments": [
            {
              "kind": "speech",
              "text": "ادعا (edde'â) — \"a claim\"."
            },
            {
              "kind": "speech",
              "text": "این ادعا درست نیست. in edde'â dorost nist. This claim is not true."
            },
            {
              "kind": "speech",
              "text": "Plural edde'âhâ. Formal; also a claim in court."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ادعا (edde'â) is usually traced to Arabic iddi'ā' \"a claim, a pretension\"; Persian drops the final hamza."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
