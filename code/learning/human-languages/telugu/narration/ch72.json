    {
      "id": "TE-C72-bargain",
      "sequence": 2470,
      "title": "బేరం (bēraṁ) — a bargain, haggling",
      "headword": "బేరం",
      "romanization": "bēraṁ",
      "gloss": "a bargain, haggling",
      "script": "telugu",
      "modality": "voice",
