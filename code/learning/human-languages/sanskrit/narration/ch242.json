        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: सुलभः",
          "segments": [
            {
              "kind": "speech",
              "text": "सुलभः — sulabhaḥ — \"easy to get, cheap\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "sulabha is built on su-, \"well, easily\", and the root √labh, \"to take, obtain\" (MW; CDIAL 13512). MW compares √labh with Greek lambanō, \"I take\". Pali sulabha, \"easy to be obtained\", carries it on."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
