    {
      "id": "HI-C42-come",
      "sequence": 1230,
      "title": "आना / आता / आती / आते (ānā / ātā / ātī / āte) — to come and its present forms",
      "headword": "आना / आता / आती / आते",
      "romanization": "ānā / ātā / ātī / āte",
      "gloss": "to come / come — infinitive / masculine / feminine / respectful or plural",
      "script": "devanagari",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:d0c8b8b7da4d4358",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "A short run of everyday verbs, one at a time."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: आना",
          "segments": [
            {
              "kind": "speech",
              "text": "आना (ānā) — \"to come\"."
            },
            {
              "kind": "speech",
              "text": "Every Hindi infinitive ends in -ना (-nā), so this is 'to come' in the form a dictionary lists."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "आना (ānā) is a tadbhava, a word inherited from Sanskrit and reshaped by sound change. CDIAL lists it under āpayati, \"causes to reach\", from the verb whose old form āpa meant \"came towards\"; Prakrit already had āvaï, \"comes\" (CDIAL 1200)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "Take off -ना and add the endings you already know: आता (ātā, masculine), आती (ātī, feminine), आते (āte, respectful or plural). The action-chaining lesson will put आता हूँ after a chained action; now the form will already be yours."
            }
          ]
        },
        {
          "index": 4,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "ānā",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *ānā*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "आता / आती / आते (ātā / ātī / āte)",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: **आता / आती / आते** (*ātā / ātī / āte*)]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "it again, to someone standing in a doorway",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: it again, to someone standing in a doorway]"
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What does आना mean? (\"to come\".) Give its masculine, feminine, and respectful or plural forms. (आता / आती / आते.)"
            }
          ]
        }
      ]
    },
