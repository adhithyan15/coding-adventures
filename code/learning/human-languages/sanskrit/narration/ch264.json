    {
      "id": "SA-C264-near-term-plan",
      "sequence": 15670,
      "title": "A small plan: when, then what I will do",
      "headword": "(near-term first-person plan)",
      "romanization": "",
      "gloss": "choose a known future time and say what I will do",
      "script": "devanagari",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:73d8c56515838b2f",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Recall tomorrow, the day after tomorrow, and the three complete forms “I will go,” “I will do,” and “I will read.”"
            }
          ]
        },
        {
          "index": 1,
          "type": "grammar",
          "title": "Grammar Lens: time first, plan second",
          "segments": [
            {
              "kind": "speech",
              "text": "Make a near-term plan in two small choices: choose श्वः (śvaḥ) or परश्वः (paraśvaḥ), then choose one complete first-person future form."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": true,
              "source": "[PAUSE 2s each]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "“Tomorrow, I will read” — śvaḥ paṭhiṣyāmi",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: “Tomorrow, I will read” — *śvaḥ paṭhiṣyāmi*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "“The day after tomorrow, I will go” — paraśvaḥ gamiṣyāmi",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: “The day after tomorrow, I will go” — *paraśvaḥ gamiṣyāmi*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "“Tomorrow, I will do the work” — śvaḥ kāryaṃ kariṣyāmi",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: “Tomorrow, I will do the work” — *śvaḥ kāryaṃ kariṣyāmi*]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What are the two choices in a small plan? (When; then what I will do.)"
            }
          ]
        }
      ]
    },
