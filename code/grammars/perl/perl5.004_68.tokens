# Perl 5.004_68 (1998-06-23) plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: unsupported Perl 5.004_68 syntax is rejected by this grammar.
# Evidence: https://mirrors.develooper.com/perl/historical-perl/perl-5.004_68.tar.gz
# Archive SHA-256: 582b8818c3c890982fdb0b40bf9dd0cb55f5be17f649a3e11fc2f64c6e733273
# Compared with 5.004_67, perly.y and keywords.h are byte-identical.
# toke.c changes user-subroutine prototype tracking and string allocations;
# the complete scan_num definition and file tail are byte-identical.
# Retain the source-backed 250-digit bound for the bounded print subset.
# CR remains outside this partial subset, without platform-wide parity claim.
# Unsupported characters and leading-zero forms remain refused.

PRINT     = "print"
INT       = /0|[1-9][0-9]{0,249}/
PLUS      = "+"
DECREMENT = "--"
MINUS     = "-"
STAR      = "*"
LPAREN    = "("
RPAREN    = ")"
SEMICOLON = ";"

skip:
  WHITESPACE = /[ \t\n]+/
