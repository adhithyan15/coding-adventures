# Perl 5.003_18 (1996-12-31) grammar: plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: unsupported Perl 5.003_18 syntax is rejected.
# Evidence: https://github.com/Perl/perl5/blob/perl-5.003_18/perly.y
# The tagged yacc matches 5.003_17; this separate file remains deliberately
# limited to arithmetic precedence, parentheses and print.

program         = print_statement { print_statement } ;
print_statement = PRINT LPAREN expr RPAREN SEMICOLON ;
expr            = term { ( PLUS | MINUS ) term } ;
term            = unary { STAR unary } ;
unary           = MINUS unary | atom ;
atom            = INT | LPAREN expr RPAREN ;
