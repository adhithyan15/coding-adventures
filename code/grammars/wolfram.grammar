# @version 1

# =============================================================================
# wolfram.grammar — Parser grammar for the Wolfram Language (subset)
# =============================================================================
#
# Drives the generic grammar-driven parser engine (parser::GrammarParser) over
# the token stream from the wolfram-lexer. Everything in Wolfram is an expression
# `head[args]`; this grammar parses the surface operators, and the W-4 runtime
# desugars each rule into the canonical symbolic-ir head (Plus, Times, Power,
# List, Rule, ReplaceAll, Set, …). See code/specs/MA04-wolfram-language.md.
#
# Token names (UPPERCASE) come from the Wolfram lexer (code/grammars/wolfram.tokens):
#   NUMBER STRING NAME                literals and symbols
#   SET (=)  SETDELAYED (:=)          assignment
#   RULE (->)  RULEDELAYED (:>)  REPLACEALL (/.)
#   AND (&&)  OR (||)  NOT (!)
#   EQUAL (==)  UNEQUAL (!=)  LESS (<)  GREATER (>)  LE (<=)  GE (>=)
#   PLUS MINUS TIMES SLASH POWER       arithmetic
#   MAP (/@)  APPLY (@@)                map / apply sugar  (W-6)
#   BLANK (_)                          pattern blank
#   LBRACKET RBRACKET   (f[...] application)
#   LDBRACKET           ([[...]] Part sugar opener; closes with RBRACKET RBRACKET)  (W-6)
#   LBRACE RBRACE       ({...} list)
#   LPAREN RPAREN       (grouping)
#   COMMA SEMI NEWLINE
#
# Precedence cascade (loosest binds first -> tightest binds last)
# ---------------------------------------------------------------
#   assignment      =  :=                 (right-associative)
#   replaceall      /.                    (left-associative)
#   rule            ->  :>                (right-associative)
#   logical_or      ||
#   logical_and     &&
#   logical_not     !  (prefix)
#   comparison      == != < > <= >=
#   additive        + -
#   multiplicative  * /
#   unary           - +  (prefix)
#   power           ^                     (right-associative)
#   amp             expr &                (postfix, pure function)    (W-11)
#   mapapply        /@ @@                 (infix, left-associative)   (W-6)
#   application     f[...]  x[[...]]      (postfix)                   (W-6: [[]])
#   atom            literals, symbols, patterns, slots, {...}, ( ... )  (W-11: # ## #n)
# =============================================================================

program = { statement_line } ;

# A line is one statement followed by a NEWLINE or `;` (which suppresses its
# result's display), or a blank/terminator-only line.
statement_line = statement ( NEWLINE | SEMI )
               | statement
               | NEWLINE
               | SEMI ;

statement = expr ;

expr = assignment ;

# Set / SetDelayed — right-associative, the loosest binding.
assignment = replaceall [ ( SET | SETDELAYED ) assignment ] ;

# ReplaceAll — left-associative: `e /. a /. b` is ReplaceAll[ReplaceAll[e,a],b].
replaceall = rule { REPLACEALL rule } ;

# Rule / RuleDelayed — right-associative: `a -> b -> c` is Rule[a, Rule[b, c]].
rule = logical_or [ ( RULE | RULEDELAYED ) rule ] ;

logical_or  = logical_and { OR logical_and } ;
logical_and = logical_not { AND logical_not } ;
logical_not = NOT logical_not | comparison ;

# A single (non-chained) comparison for the subset.
comparison = additive [ ( EQUAL | UNEQUAL | LESS | GREATER | LE | GE ) additive ] ;

additive       = multiplicative { ( PLUS | MINUS ) multiplicative } ;
multiplicative = unary { ( TIMES | SLASH ) unary } ;

# Prefix minus/plus. Binds looser than Power and than the `&` postfix, so
# `-x^2` is -(x^2). Calls `amp` (the pure-function postfix) which in turn calls
# `power`, so `-#^2 &` is -((#^2)&).
unary = ( MINUS | PLUS ) unary | amp ;

# Pure-function `&` postfix (W-11). A trailing run of `&` turns the preceding
# `power` expression into an anonymous `Function`: `#^2 &` is `(#^2)&`, i.e.
# Function[Power[Slot[1], 2]] — NOT Power[Slot[1], Function[2]]. The `&` binds
# LOOSER than `^` (so it captures the whole `#^2`) but tighter than the prefix
# unary / arithmetic above it; this is the key precedence the W-11 tests pin
# down. A double `& &` wraps twice. The runtime lowers each trailing `&` to a
# slot-based `Function[body]`.
amp = power { AMP } ;

# Power — right-associative: `a^b^c` is Power[a, Power[b, c]]. Unchanged by
# W-11; `power` still calls `mapapply`, and the `&` postfix sits one level
# *above* it (in `amp`).
power = mapapply [ POWER unary ] ;

# Map / Apply sugar (W-6), infix and left-associative, binding just above
# application: `f /@ x` is Map[f, x], `f @@ x` is Apply[f, x]. The runtime
# desugars each to the SAME W-5 head the long form uses (`Map`/`Apply`), so
# `f /@ {1, 2}` and `Map[f, {1, 2}]` produce identical IR. A chain folds left,
# `g @@ f /@ x` ⇒ `Apply[g, Map[f, x]]` — exact precedence vs arithmetic is not
# part of the tested subset (write parentheses when mixing).
mapapply = postfix { ( MAP | APPLY ) postfix } ;

# Postfix application (W-6 adds the `[[ … ]]` Part sugar alongside `f[…]`):
#   `f[x][y]`     is `(f[x])[y]`             — function application, may be empty
#   `x[[i]]`      is Part[x, i]              — double-bracket Part sugar
#   `x[[1]][[2]]` is Part[Part[x, 1], 2]     — both chain left-associatively
# Both forms are postfix and bind equally tightly, so they interleave freely
# (`f[x][[1]]`, `x[[1]][y]`). `[[ … ]]` requires at least one index expression
# (a bare `x[[]]` is not valid Wolfram); the runtime emits one `Part` per index.
#
# The opener `[[` is a single LDBRACKET token, but the closer is `RBRACKET
# RBRACKET` — there is intentionally no `]]` token (see wolfram.tokens for why:
# a greedy `]]` would mis-lex the tail of nested `f[g[x]]`). So `x[[i]]` closes
# with two single `]`, exactly as it lexes.
postfix = atom { LBRACKET [ arglist ] RBRACKET | LDBRACKET arglist RBRACKET RBRACKET } ;

arglist = expr { COMMA expr } ;

# Atoms, including the pattern blank forms and the W-11 slots:
#   NAME                a symbol
#   NAME BLANK [NAME]   x_  or  x_h   (Pattern[x, Blank[]] / Pattern[x, Blank[h]])
#   BLANK [NAME]        _   or  _h    (Blank[] / Blank[h])
#   slot                #  #n  ##     (Slot / SlotSequence — W-11 pure functions)
# `slot` is listed first: HASH/SLOTSEQ are disjoint token types from NUMBER/
# STRING/NAME/BLANK, so order is not required for correctness, but putting the
# new arm up front keeps the pure-function additions visually grouped.
atom = slot
     | NUMBER
     | STRING
     | NAME [ BLANK [ NAME ] ]
     | BLANK [ NAME ]
     | list
     | group ;

# A pure-function argument slot (W-11):
#   #     ≡  #1      the first argument            (HASH, no number)
#   #n              the n-th argument              (HASH NUMBER)
#   ##              SlotSequence — all arguments    (SLOTSEQ)
# `#n` is HASH followed by the ordinary NUMBER token (there is no dedicated
# slot-number token — the lexer is unchanged), so the parser reads the optional
# number here; the runtime turns `#`/`#n` into Slot[n] and `##` into
# SlotSequence[1].
slot = HASH [ NUMBER ] | SLOTSEQ ;

list  = LBRACE [ arglist ] RBRACE ;
group = LPAREN expr RPAREN ;
