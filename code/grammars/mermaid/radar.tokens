# @version 1
# @case_insensitive true
#
# Mermaid 11.16.1 radar token grammar. This native slice covers axes,
# curves, titles, and accessibility metadata; chart options remain explicit
# compatibility gaps.

case_sensitive: false

skip:
  WHITESPACE          = /[ \t]+/
  COMMENT             = /%%[^\r\n]*/

NEWLINE               = /\r?\n/
SEMICOLON             = ";"
HEADER                = /radar-beta[ \t]*:?/
ACC_DESCR_BLOCK       = /accDescr[ \t]*\{[^}]*\}/
ACC_TITLE_STATEMENT   = /accTitle[ \t]*:[^\r\n;%]+/
ACC_DESCR_STATEMENT   = /accDescr[ \t]*:[^\r\n;%]+/
TITLE_STATEMENT       = /title[ \t]+[^\r\n;%]+/
AXIS_STATEMENT        = /axis[ \t]+[^\r\n;%]+/
CURVE_STATEMENT       = /curve[ \t]+[^{}\r\n;%]+\{[^}]+\}/
