warrant scalar_faults v1
  -- Synthetic document of slice S11f-1 (VER04r 8.2): the shapes `saturate-add`, `saturate-sub`, `shift-mask`
  -- and the scalar `missing-error` apply to.  GENERATED by make_scalar_faults.py; do not edit by hand.
  error E = Bad | Worse

  model m_sat_u8(a: U8, b: U8) -> U8 = a
  model m_satr_u8(a: U8, b: U8, c: Bool) -> Result<U8,E> = Ok(a)
  model m_sat_u16(a: U16, b: U16) -> U16 = a
  model m_sat_u32(a: U32, b: U32) -> U32 = a
  model m_sat_u64(a: U64, b: U64) -> U64 = a
  model m_satr_u64(a: U64, b: U64, c: Bool) -> Result<U64,E> = Ok(a)
  model m_sat_i8(a: I8, b: I8) -> I8 = a
  model m_satr_i8(a: I8, b: I8, c: Bool) -> Result<I8,E> = Ok(a)
  model m_sat_i16(a: I16, b: I16) -> I16 = a
  model m_sat_i32(a: I32, b: I32) -> I32 = a
  model m_sat_i64(a: I64, b: I64) -> I64 = a
  model m_satr_i64(a: I64, b: I64, c: Bool) -> Result<I64,E> = Ok(a)
  model m_sh_u8(a: U8, n: U8) -> U8 = n
  model m_sh_u32_by_u8(a: U32, n: U8) -> U8 = n
  model m_sh_i16_by_u16(a: I16, n: U16) -> U16 = n
  model m_sh_u8_by_i8(a: U8, n: I8) -> I8 = n
  model m_sh_i64_by_i32(a: I64, n: I32) -> I32 = n
  model m_sh_u64_by_u64(a: U64, n: U64) -> U64 = n
  model m_sh_only(a: U16) -> U16 = a
  model m_me_u8(a: U8, b: U32) -> Result<U8,E> = if b == 0u32 then Err(E.Bad) else Ok(a)
  model m_me_u16_zero(a: U8) -> Result<U16,E> = if a == 0u8 then Err(E.Bad) else Ok(1u16)
  model m_me_i32(a: I32, b: U32) -> Result<I32,E> = if b == 0u32 then Err(E.Bad) else Ok(a)
  model m_me_bool(a: U8, f: Bool) -> Result<Bool,E> = if a == 0u8 then Err(E.Bad) else Ok(f)
  model m_me_bool_zero(a: U8) -> Result<Bool,E> = if a == 0u8 then Err(E.Bad) else Ok(true)
  model m_me_nat(a: Bool, n: Nat) -> Result<Nat,E> = if a then Err(E.Bad) else Ok(n)
  model m_me_nat_zero(a: Bool) -> Result<Nat,E> = if a then Err(E.Bad) else Ok(1)
  model m_me_bytes4_zero(a: U8) -> Result<Bytes<4>,E> = if a == 0u8 then Err(E.Bad) else Ok(b"01010101")
  model m_me_bytes_zero(a: U8) -> Result<Bytes,E> = if a == 0u8 then Err(E.Bad) else Ok(b"01")
  model m_sat_u8_tuple_param(a: U8, b: U8, p: (Bool,Bool)) -> U8 = a

  op sat_u8(a: U8, b: U8) -> U8
  op satr_u8(a: U8, b: U8, c: Bool) -> Result<U8,E>
  op sat_u16(a: U16, b: U16) -> U16
  op sat_u32(a: U32, b: U32) -> U32
  op sat_u64(a: U64, b: U64) -> U64
