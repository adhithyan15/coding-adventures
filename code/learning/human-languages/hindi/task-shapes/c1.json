{
  "version": 1,
  "language": "hindi",
  "level": "C1",
  "target": {"name": "Coding Adventures Hindi C1 Assessment — project-defined equivalent", "basis": "project-defined"},
  "sources": [
    {"id": "ca-hl16-assessment-policy", "title": "HL16 — Exam-ready books and the gentle writing ramp", "url": "https://github.com/adhithyan15/coding-adventures/blob/main/code/specs/HL16-exam-ready-books-and-writing-ramp.md", "published": "2026-08-20", "accessed": "2026-08-31"},
    {"id": "ca-hl18-task-shapes", "title": "HL18 — Four-skill task shapes", "url": "https://github.com/adhithyan15/coding-adventures/blob/main/code/specs/HL18-four-skill-task-shapes.md", "published": "2026-08-20", "accessed": "2026-08-31"},
    {"id": "ca-hindi-assessment", "title": "Coding Adventures Hindi Assessment Specification", "url": "https://github.com/adhithyan15/coding-adventures/blob/main/code/learning/human-languages/hindi/assessment-spec.md", "published": "2026-08-31", "accessed": "2026-08-31"}
  ],
  "administration": {"writtenMinutes": 200, "speakingMinutes": 22, "speakingGroupMaximum": 3, "speakingPreparationMinutes": 15, "deliveryModes": ["paper", "recorded-audio", "live-interlocutor"]},
  "passRule": {
    "maximumPoints": 400, "passPoints": 240, "requiresEverySectionAttempted": true,
    "independentSkillThresholds": {"reading": 0.6, "listening": 0.6, "writing": 0.6, "speaking": 0.6},
    "note": "Each skill is a separate 100-point paper and must independently reach 60/100; the 240-point headline sum cannot compensate for a failed paper."
  },
  "sections": [
    {
      "skill": "reading", "minutes": 75,
      "parts": [
        {
          "id": "c1-reading-dense-public-text", "promptModes": ["written-devanagari"],
          "promptGenres": ["dense public-policy, institutional, or civic text"],
          "responseModes": ["selection", "claim-evidence match", "implicit-stance match"], "items": 9,
          "stimulusLength": {"unit": "words", "minimum": 650, "maximum": 800, "approximate": false},
          "responseLength": {"unit": "items", "minimum": 1, "maximum": 1, "approximate": false},
          "interaction": "individual", "replayCount": 0,
          "scoring": {"maxRawPoints": 25, "criteria": ["argument structure", "implicit stance", "rhetorical purpose", "specific textual support"]},
          "aids": {"allowed": ["marking on the question paper", "one unscored example"], "forbidden": ["romanization", "dictionary", "translator"], "notPublished": []},
          "notPublished": [], "sourceIds": ["ca-hl16-assessment-policy", "ca-hl18-task-shapes", "ca-hindi-assessment"]
        },
        {
          "id": "c1-reading-professional-text", "promptModes": ["written-devanagari"],
          "promptGenres": ["professional report, proposal, or analytical memorandum"],
          "responseModes": ["selection", "source-purpose match", "implication match"], "items": 9,
          "stimulusLength": {"unit": "words", "minimum": 700, "maximum": 850, "approximate": false},
          "responseLength": {"unit": "items", "minimum": 1, "maximum": 1, "approximate": false},
          "interaction": "individual", "replayCount": 0,
          "scoring": {"maxRawPoints": 25, "criteria": ["professional purpose", "evidence evaluation", "unstated implication", "register effect"]},
          "aids": {"allowed": ["marking on the question paper", "one unscored example"], "forbidden": ["romanization", "dictionary", "translator"], "notPublished": []},
          "notPublished": [], "sourceIds": ["ca-hl16-assessment-policy", "ca-hl18-task-shapes", "ca-hindi-assessment"]
        },
        {
          "id": "c1-reading-academic-text", "promptModes": ["written-devanagari"],
          "promptGenres": ["academic or research-informed exposition"],
          "responseModes": ["selection", "argument-stage match", "qualification match"], "items": 9,
          "stimulusLength": {"unit": "words", "minimum": 700, "maximum": 880, "approximate": false},
          "responseLength": {"unit": "items", "minimum": 1, "maximum": 1, "approximate": false},
          "interaction": "individual", "replayCount": 0,
          "scoring": {"maxRawPoints": 25, "criteria": ["concept relation", "method or evidence evaluation", "qualification recognition", "authorial stance"]},
          "aids": {"allowed": ["marking on the question paper", "one unscored example"], "forbidden": ["romanization", "dictionary", "translator"], "notPublished": []},
          "notPublished": [], "sourceIds": ["ca-hl16-assessment-policy", "ca-hl18-task-shapes", "ca-hindi-assessment"]
        },
        {
          "id": "c1-reading-literary-text", "promptModes": ["written-devanagari"],
          "promptGenres": ["literary prose or essay with layered voice and cultural context"],
          "responseModes": ["selection", "voice-effect match", "implicit-meaning match"], "items": 9,
          "stimulusLength": {"unit": "words", "minimum": 750, "maximum": 970, "approximate": false},
          "responseLength": {"unit": "items", "minimum": 1, "maximum": 1, "approximate": false},
          "interaction": "individual", "replayCount": 0,
          "scoring": {"maxRawPoints": 25, "criteria": ["narrative voice", "figurative and implicit meaning", "cultural context", "stylistic effect"]},
          "aids": {"allowed": ["marking on the question paper", "one unscored example"], "forbidden": ["romanization", "dictionary", "translator"], "notPublished": []},
          "notPublished": [], "sourceIds": ["ca-hl16-assessment-policy", "ca-hl18-task-shapes", "ca-hindi-assessment"]
        }
      ], "variants": []
    },
    {
      "skill": "listening", "minutes": 50,
      "parts": [
        {
