        },
        {
          "index": 1,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": true,
              "source": "[PAUSE 2s each]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "name boredom, enthusiasm, shyness, alarm and peace of mind",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: name boredom, enthusiasm, shyness, alarm and peace of mind]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "take a breath; name skin and blood; say you have a stomach ache; ask someone's weight",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: take a breath; name skin and blood; say you have a stomach ache; ask someone's weight]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "ask for the map and one ticket; ask where the bus stop is; ask if it is near",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: ask for the map and one ticket; ask where the bus stop is; ask if it is near]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "please open the door; please close it; please stop here; please call the doctor; it's urgent!",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: please open the door; please close it; please stop here; please call the doctor; it's urgent!]"
            }
          ]
        },
        {
          "index": 2,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Boredom? (ಬೇಸರ.) Enthusiasm? (ಉತ್ಸಾಹ.) Shyness? (ನಾಚಿಕೆ.) Alarm? (ಗಾಬರಿ.) Peace of mind? (ನೆಮ್ಮದಿ.) Breath, skin, blood? (ಉಸಿರು, ಚರ್ಮ, ರಕ್ತ.) Stomach ache? (ಹೊಟ್ಟೆನೋವು.) Weight? (ತೂಕ.) Map, ticket, bus, station? (ನಕ್ಷೆ, ಟಿಕೆಟ್, ಬಸ್, ನಿಲ್ದಾಣ.) Near? (ಹತ್ತಿರ.) Open, close, stop, call? (ತೆರೆಯಿರಿ, ಮುಚ್ಚಿ, ನಿಲ್ಲಿಸಿ, ಕರೆಯಿರಿ.) Urgent? (ತುರ್ತು.)"
            }
          ]
        }
      ]
    },
