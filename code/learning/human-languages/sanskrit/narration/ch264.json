              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: tomorrow + I will go — *śvaḥ gamiṣyāmi*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "tomorrow + I will read — śvaḥ paṭhiṣyāmi",
