              "source": "[YOU HEAR: *mō* in a repair → choose **again**]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "mo | o and tap twice",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *mo | o* and tap twice]"
            },
            {
              "kind": "prompt",
              "action": "POINT",
              "instruction": "も (mo) | う; う owns the held second beat",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU POINT: **も | う**; **う** owns the held second beat]"
