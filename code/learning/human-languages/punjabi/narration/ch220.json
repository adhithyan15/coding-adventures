          ]
        },
        {
          "index": 1,
          "type": "grammar",
          "title": "Grammar Lens: ਕੀ in the past",
          "segments": [
            {
              "kind": "speech",
              "text": "ਕੀ turns a past sentence into a question the same way it turns a present one:"
            },
            {
              "kind": "speech",
              "text": "ਕੀ ਤੁਸੀਂ ਰੋਟੀ ਖਾਧੀ? — kī tusīṁ roṭī khādhī? — Did you eat the roti?"
            },
