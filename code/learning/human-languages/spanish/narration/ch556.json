          "type": "input",
          "title": "You'll want to know: el entierro",
          "segments": [
            {
              "kind": "speech",
              "text": "el entierro — \"the burial, the funeral\"."
            },
            {
              "kind": "speech",
              "text": "Fuimos al entierro de su abuelo. We went to his grandfather's funeral."
            }
          ]
        },
