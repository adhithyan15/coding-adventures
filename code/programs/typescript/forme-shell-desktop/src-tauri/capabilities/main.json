{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "The Forme authoring window receives only the closed application commands.",
  "windows": ["main"],
  "permissions": [
    "allow-project-load",
    "allow-project-compare-and-swap",
    "allow-identity-create",
