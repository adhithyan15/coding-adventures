% ADJ52 case-19 — patient observations + queries (deriver output).
% Same vocabulary as rulebook.adj. Numeric/unit term-args from the IR are
% normalized to qualitative atoms per the adj-lang IDENT grammar:
%   patient_age(23_years) -> patient_age(young_adult)
%   residence rural mountainous SW endemic district -> residence_history(rural_mountainous_endemic_region)
%   cough productive of sputum -> cough_productive_of(sputum)
%   episodic hemoptysis over ~5 years -> hemoptysis(episodic_chronic)
%   waxed/waned never resolved (5y) -> symptom_course(chronic_waxing_waning_unresolved)
%   TST induration 14x16mm markedly positive -> tuberculin_skin_test(positive)
%   IGRA T-spot positive both antigens -> igra(positive)
%   CT patchy/nodular/band-like, heterogeneous, poorly-defined, RUL+RML
%       -> chest_ct_finding(patchy_nodular_bandlike_heterogeneous_poorly_defined)
%       + ct_location(right_upper_and_middle_zones)
%   localized pleural thickening/adhesion -> ct_finding(pleural_thickening_adhesion)
%   few thin-walled cavitary spaces -> ct_finding(thin_walled_cavities)
%   eosinophil fraction 8.4% (ref 0.5-5.0) -> eosinophilia(peripheral_mild)
%   absolute eosinophil ~0.49 x10^9/L near upper-normal -> eosinophilia_absolute(near_upper_normal)
%   repeated sputum+BAL AFB smear negative -> afb_smear(negative_repeated)
%   mycobacterial cultures negative -> mycobacterial_culture(negative)
%   GeneXpert MTB/RIF negative -> genexpert(negative)
%   endobronchial biopsy no granulomatous/tuberculous pathology
%       -> endobronchial_biopsy(no_granulomatous_pathology)
%   adherent full four-drug anti-TB course, no improvement
%       -> treatment_response(no_response_to_anti_tb)

observe patient_age(young_adult)
observe residence_history(rural_mountainous_endemic_region)
observe cough_productive_of(sputum)
observe hemoptysis(episodic_chronic)
observe symptom_course(chronic_waxing_waning_unresolved)
observe tuberculin_skin_test(positive)
observe igra(positive)
observe chest_ct_finding(patchy_nodular_bandlike_heterogeneous_poorly_defined)
observe ct_location(right_upper_and_middle_zones)
observe ct_finding(pleural_thickening_adhesion)
observe ct_finding(thin_walled_cavities)
observe eosinophilia(peripheral_mild)
observe eosinophilia_absolute(near_upper_normal)
observe afb_smear(negative_repeated)
observe mycobacterial_culture(negative)
observe genexpert(negative)
observe endobronchial_biopsy(no_granulomatous_pathology)
observe treatment_response(no_response_to_anti_tb)

% q1/q2/q3 — unifying diagnosis (parasitic vs mycobacterial vs fungal vs neoplastic)
? diagnosis(pulmonary_paragonimiasis)
? diagnosis(active_pulmonary_tuberculosis)
? diagnosis(chronic_pulmonary_aspergillosis)
? diagnosis(allergic_bronchopulmonary_aspergillosis)
? diagnosis(nontuberculous_mycobacterial_infection)
? diagnosis(cavitary_lung_malignancy)

% recommended next step (confirmatory investigation)
? next_step(paragonimus_serology_elisa)
? next_step(sputum_bal_examination_for_paragonimus_eggs)
? next_step(praziquantel_trial)
