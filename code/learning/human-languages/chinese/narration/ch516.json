    {
      "id": "ZH-W516-shu-tree",
      "sequence": 39115,
      "title": "树 (shù) — the tree piece, 又, and three strokes on the right",
      "headword": "树",
      "romanization": "shù",
      "gloss": "树 — the tree piece, 又, then a bar, a hooked vertical and a dot",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:47d2e90932dbfca6",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — the tree piece, 又, and three strokes on the right",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — the tree piece, 又, and three strokes on the right and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say shù — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *shù* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "机 又."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — jī, yòu",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *jī*, *yòu*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — the tree piece, 又, and three strokes on the right",
          "segments": [
            {
              "kind": "speech",
              "text": "树 (shù)."
            },
            {
              "kind": "speech",
              "text": "Three pieces, left to right. Count the pieces, not the strokes."
            },
            {
              "kind": "speech",
              "text": "The left piece, the tree piece, four strokes, narrow, as in 机: a short bar, a vertical down through it, a stroke falling to the left from the crossing, then a short dot to the right."
            },
            {
              "kind": "speech",
              "text": "The middle piece, 又, two strokes: a short bar that turns into a stroke falling to the left, then a short stroke falling to the right across it."
            },
            {
              "kind": "speech",
              "text": "The right piece, three strokes: a bar, a long vertical down the right side that hooks to the left at the foot, then a dot on the left of the vertical."
            },
            {
              "kind": "speech",
              "text": "4 + 2 + 3 = nine."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "树 (shù), all nine, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 树, all nine, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many pieces does 树 (shù) have? (Three: the tree piece, 又 and a right piece.) What is the last stroke? (A dot beside the hooked vertical.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 树 (shù), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
