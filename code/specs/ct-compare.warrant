warrant ct_compare
  error SelectError = CT_SELECT_LENGTH_MISMATCH
  model same(a: Bytes, b: Bytes) -> Bool = a == b
  model same_u64(a: U64, b: U64) -> Bool = a == b
  op eq(a: Bytes, b: Bytes) -> Bool
  op eq_fixed<N: Nat>(a: Bytes<N>, b: Bytes<N>) -> Bool
  op select_bytes(a: Bytes, b: Bytes, choice: Bool) -> Result<Bytes, SelectError> fresh
  op eq_u64(a: U64, b: U64) -> Bool

  assume platform:
    none
  assume environment:
    none

  labels eq:
    a.contents secret
    a.length public
    b.contents secret
    b.length public
  labels eq_fixed:
    a.contents secret
    a.length public
    b.contents secret
    b.length public
  labels select_bytes:
    a.contents secret
    a.length public
    b.contents secret
    b.length public
    choice secret
  labels eq_u64:
    a secret
    b secret

  input eq.a:
    hostile
    ensures no_panic, terminates
  input eq.b:
    hostile
    ensures no_panic, terminates

  input eq_fixed.a:
    hostile
    ensures no_panic, terminates
  input eq_fixed.b:
    hostile
    ensures no_panic, terminates

  input select_bytes.a:
    hostile
    rejects len(a) != len(b) with SelectError.CT_SELECT_LENGTH_MISMATCH
    ensures no_panic, terminates
  input select_bytes.b:
    hostile
    rejects len(a) != len(b) with SelectError.CT_SELECT_LENGTH_MISMATCH
    ensures no_panic, terminates
  input select_bytes.choice:
    hostile
    ensures no_panic, terminates

  input eq_u64.a:
    hostile
    ensures no_panic, terminates
  input eq_u64.b:
    hostile
    ensures no_panic, terminates

  bound eq:
    steps <= 64 * len(a) + 512
    heap <= 2 * len(a)
    depth <= 32
  bound eq_fixed:
    steps <= 64 * len(a) + 512
    heap <= 2 * len(a)
    depth <= 32
  bound select_bytes:
    steps <= 64 * len(a) + 512
    heap <= 2 * len(a)
    depth <= 32
  bound eq_u64:
    steps <= 64
    heap <= 0
    depth <= 8

  example eq_empty:
    eq(b"", b"") == true
  example eq_one_equal:
    eq(b"00", b"00") == true
  example eq_one_diff:
    eq(b"00", b"01") == false
  example eq_diff_len:
    eq(b"", b"00") == false

  example fixed_zero:
    eq_fixed<0>(b"", b"") == true
  example fixed_16_equal:
    eq_fixed<16>(b"000102030405060708090a0b0c0d0e0f", b"000102030405060708090a0b0c0d0e0f") == true
  example fixed_16_diff:
    eq_fixed<16>(b"000102030405060708090a0b0c0d0e0f", b"000102030405060708090a0b0c0d0e00") == false

  example select_left_fresh:
    select_bytes(b"00", b"ff", true) == Ok(b"00")
  example select_right_fresh:
    select_bytes(b"00", b"ff", false) == Ok(b"ff")
  example select_length_mismatch:
    select_bytes(b"", b"00", false) == Err(SelectError.CT_SELECT_LENGTH_MISMATCH)

  example u64_equal:
    eq_u64(0u64, 0u64) == true
  example u64_diff:
    eq_u64(9223372036854775808u64, 0u64) == false

  claim eq_agrees:
    forall a: Bytes, b: Bytes. eq(a, b) == same(a, b)

  claim eq_fixed_agrees_w0:
    forall a: Bytes<0>, b: Bytes<0>. eq_fixed<0>(a, b) == same(a, b)
  claim eq_fixed_agrees_w1:
    forall a: Bytes<1>, b: Bytes<1>. eq_fixed<1>(a, b) == same(a, b)
  claim eq_fixed_agrees_w2:
    forall a: Bytes<2>, b: Bytes<2>. eq_fixed<2>(a, b) == same(a, b)
  claim eq_fixed_agrees_w4:
    forall a: Bytes<4>, b: Bytes<4>. eq_fixed<4>(a, b) == same(a, b)
  claim eq_fixed_agrees_w16:
    forall a: Bytes<16>, b: Bytes<16>. eq_fixed<16>(a, b) == same(a, b)

  claim select_picks:
    forall a: Bytes, b: Bytes | len(a) == len(b), choice: Bool. select_bytes(a, b, choice) == Ok(if choice then a else b)
  claim select_rejects_mismatch:
    forall a: Bytes, b: Bytes | len(a) != len(b), choice: Bool. select_bytes(a, b, choice) == Err(SelectError.CT_SELECT_LENGTH_MISMATCH)

  claim eq_u64_agrees:
    forall a: U64, b: U64. eq_u64(a, b) == same_u64(a, b)
