        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: कोई बात नहीं",
          "segments": [
            {
              "kind": "speech",
              "text": "कोई बात नहीं (koī bāt nahīṁ) — \"no problem\", \"never mind\", literally \"no matter\"."
            },
            {
              "kind": "speech",
              "text": "It is the answer to माफ़ कीजिए, and to thanks for a small favour."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "कोई बात नहीं (koī bāt nahīṁ) is \"not any matter\". koī comes from Sanskrit kaścid, \"someone, anyone\" (CDIAL 2967), and bāt, \"matter, talk\", from vārttā, \"tidings, business\" (CDIAL 11564)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "The answer to an apology."
            }
          ]
        },
        {
