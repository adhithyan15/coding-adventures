    {
      "id": "ZH-W137-jie-joint",
      "sequence": 10725,
      "title": "节 (jié) — the grass piece over a hook",
      "headword": "节",
      "romanization": "jié",
      "gloss": "节 — the grass piece over a turning hook",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:30cb67188d7308cd",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — the grass piece over a hook",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — the grass piece over a hook and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say jiérì — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *jiérì* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "菜 日."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — cài, rì",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *cài*, *rì*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — the grass piece over a hook",
          "segments": [
            {
              "kind": "speech",
              "text": "节 (jié)."
            },
            {
              "kind": "speech",
              "text": "Two pieces, top to bottom."
            },
            {
              "kind": "speech",
              "text": "The grass piece, three strokes, as on top of 菜: a horizontal across, then a short vertical on the left and a short vertical on the right, both crossing it."
            },
            {
              "kind": "speech",
              "text": "The lower piece, two strokes. A horizontal that turns down and ends in a hook to the left, then a long vertical down through it to the foot."
            },
            {
              "kind": "speech",
              "text": "3 + 2 = five."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "节 (jié), all five, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 节, all five, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many pieces in 节 (jié)? (Two.) How many strokes in the grass piece? (Three.) Which stroke is the last? (The long vertical.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 节 (jié), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
