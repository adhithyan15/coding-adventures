        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: o rendimento",
          "segments": [
            {
              "kind": "speech",
              "text": "o rendimento — \"the income; the yield\"."
            },
            {
              "kind": "speech",
              "text": "O rendimento da família subiu este ano. The family's income went up this year."
            },
            {
              "kind": "speech",
              "text": "Rendimento mensal — monthly income."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "rendimento is built on render \"to yield, to give back\", usually traced to Vulgar Latin rendere, a form of Latin reddere \"to give back\" (Lewis & Short)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
