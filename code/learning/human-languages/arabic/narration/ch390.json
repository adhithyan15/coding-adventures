        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: كلية",
          "segments": [
            {
              "kind": "speech",
              "text": "كلية — kulliyya — \"a faculty\"."
            },
            {
              "kind": "speech",
              "text": "درس أبي في كلية (kulliyya) الطب. darasa abī fī kulliyyat aṭ-ṭibb. My father studied at the faculty of medicine."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "كلية (kulliyya) is built on the native Arabic root k-l-l, \"to be all, the whole\" (Lane). Kulliyya is a modern abstract noun from kull, all; its use for a college of a university is usually explained as a whole branch of learning."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for giving reasons and opinions."
