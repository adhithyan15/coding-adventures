        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: valutare",
          "segments": [
            {
              "kind": "speech",
              "text": "valutare — \"to evaluate, to weigh up\"."
            },
            {
              "kind": "speech",
              "text": "Dobbiamo valutare bene i costi prima di comprare la casa. We have to weigh up the costs carefully before buying the house."
            },
            {
              "kind": "speech",
              "text": "Also to value in money: valutare un quadro."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "valutare is built on valuta \"value\", from valere \"to be worth\", which is inherited from Latin valēre \"to be strong, to be worth\" (Lewis & Short)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
