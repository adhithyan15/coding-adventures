        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: la troupe",
          "segments": [
            {
              "kind": "speech",
              "text": "la troupe — \"(theatre) company, troupe; troop\"."
            },
            {
              "kind": "speech",
              "text": "La troupe joue la même pièce depuis deux ans. The company has been playing the same play for two years."
            },
            {
              "kind": "speech",
              "text": "Also a group of soldiers or animals."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "la troupe is usually traced to Frankish thorp \"a gathering, a village\" (EtymDB), a Germanic word."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
