              "instruction": "pasu, then āṭu, and say which one a house keeps when it has no land",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *pasu*, then *āṭu*, and say which one a house keeps when it has no land]"
            }
