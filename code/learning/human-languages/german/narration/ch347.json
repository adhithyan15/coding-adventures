        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: der Zufall",
          "segments": [
            {
              "kind": "speech",
              "text": "der Zufall — \"the chance, the coincidence\"."
            },
            {
              "kind": "speech",
              "text": "Was für ein Zufall! Wir sind im selben Hotel. What a coincidence! We are in the same hotel."
            },
            {
              "kind": "speech",
              "text": "Plural: die Zufälle. Durch Zufall — by chance."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Zufall is built from zu \"to\" and Fall \"fall, case\", from Old High German val (EtymDB): what falls to you. It is usually explained as a rendering of Latin accidēns, from accidere \"to fall upon, to happen\" (Lewis & Short)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
            }
          ]
        },
