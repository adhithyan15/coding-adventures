              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Latin for to give up, then the Latin for to exchange."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: exprimō, exprimere",
          "segments": [
            {
              "kind": "speech",
              "text": "exprimō, exprimere — \"to press out, to express\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "exprimō is ex, \"out\", with premō, \"to press\" (Lewis & Short), its e weakened to i: to press out. English express comes from it."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
