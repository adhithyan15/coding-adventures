          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "English shawl comes from this Persian word. Where Persian got it is not settled: EtymDB links it to Sanskrit śāṭī, \"cloth, sari\"."
            }
          ]
        },
