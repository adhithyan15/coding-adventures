      "sequence": 1960,
      "title": "கழுத்து (kaḻuttu) — the neck",
      "headword": "கழுத்து",
      "romanization": "kaḻuttu",
      "gloss": "the neck",
      "script": "tamil",
      "modality": "voice",
      "derivedModality": "voice",
