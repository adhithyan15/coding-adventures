          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "entierro is built on enterrar 'to bury', which comes from spoken Latin interrāre 'to put in the earth' (EtymDB), from terra 'earth'."
            }
          ]
        },
