              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *shāsāno*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "shāsāno, once more",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *shāsāno*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "ḍākātrā dokāndārke shāsālô, kintu tini bhôy pelen nā. — The robbers threatened the shopkeeper, but he wasn't afraid.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *ḍākātrā dokāndārke shāsālô, kintu tini bhôy pelen nā.* — The robbers threatened the shopkeeper, but he wasn't afraid.]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
