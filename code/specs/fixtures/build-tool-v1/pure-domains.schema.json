    "validation_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "options"
      ],
      "properties": {
        "operation": {
          "const": "validation"
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "platform",
            "checks",
            "packages",
            "dependency_edges"
          ],
          "properties": {
            "platform": {
              "enum": [
                "darwin",
                "linux",
                "windows"
              ]
