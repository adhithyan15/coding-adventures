              "instruction": "gātra, once more",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *gātra*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "ī aṅgi nanna gātrakke sariyāgilla. — This shirt is not my size.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *ī aṅgi nanna gātrakke sariyāgilla.* — This shirt is not my size.]"
