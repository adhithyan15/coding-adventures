<!-- Generated by mosaic-emit-xaml, then hand-patched for the demo.

     Generator gap discovered while making this demo run:
       mosaic-emit-xaml lowered HostDialog inside a <UserControl> root.
       That doesn't work — ContentDialog cannot be embedded as a
       UserControl child and then shown via ShowAsync(); the parented
       child can't be re-parented to the dialog presenter.

       Pattern that DOES work: the XAML root IS the ContentDialog, and
       the partial class extends ContentDialog. Title and other DPs
       can live directly on the ContentDialog. ShowAsync is called on
       the class itself.

     This file reflects the working pattern. The companion
     HelloDialog.xaml.cs partial class is hand-patched to extend
     ContentDialog instead of UserControl.

     Other patches from the original generator output:
       - Removed `mos:Dialog.IsOpen` attribute (undeclared namespace).
       - Switched {Binding ...} → {x:Bind ...} for Title (DataContext
         consistency). -->
<ContentDialog
    x:Class="Mosaic.Generated.HelloDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Mosaic.Generated"
    Title="{x:Bind DialogTitle, Mode=OneWay}"
    PrimaryButtonText=""
    CloseButtonText=""
    Closed="OnHostDialogClose_1">

    <!-- HostDialog #1 onClose: dispatches Close; handler wired in code-behind. -->
    <StackPanel Orientation="Vertical" Padding="16">
        <Border Padding="8">
            <TextBlock Text="{x:Bind Message, Mode=OneWay}" TextWrapping="Wrap"/>
        </Border>
        <Border Padding="8">
            <Button x:Name="CloseBtn" Content="Close" Click="CloseBtn_Click"/>
        </Border>
    </StackPanel>

</ContentDialog>
