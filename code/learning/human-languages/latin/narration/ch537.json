            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Latin for a darling, then the Latin for a gift."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: iūrgium, iūrgiī",
          "segments": [
            {
              "kind": "speech",
              "text": "iūrgium, iūrgiī — \"a quarrel, dispute\"."
            },
            {
              "kind": "speech",
              "text": "Inter frātrēs saepe iūrgium est. There is often a quarrel between the brothers."
            },
            {
              "kind": "speech",
              "text": "Neuter, second declension. A quarrel of words, at home or between neighbours."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "iūrgium is built on iūrgō \"to quarrel\", which Lewis & Short takes from iūs \"right, law\" and agō \"to drive\"; EtymDB agrees on iūs."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
