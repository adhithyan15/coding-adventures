warrant vos_fixture_rep v1
  -- vos02:generated by vos-link gen-doc; do not edit; contract-package=vos_sched_contract
  -- vos02:contract-begin sha256=fd4b88aaa4cab44c03947906aab0d8b97b996351111608de19446ef40b8f673b
  variant Upd = Changed | Unchanged | OutOfRange
  variant Pick = Idle | Run(t: U8)

  -- Abstract state M: the ready set over the thread ids 0..7. Thread t has priority t, so a
  -- larger id wins. Eight Bools: structural equality is set equality (VOS01 section 2.1).
  record Ready(p0: Bool, p1: Bool, p2: Bool, p3: Bool, p4: Bool, p5: Bool, p6: Bool, p7: Bool)
  model ready_of(b0: Bool, b1: Bool, b2: Bool, b3: Bool, b4: Bool, b5: Bool, b6: Bool, b7: Bool) -> Ready = Ready(b0, b1, b2, b3, b4, b5, b6, b7)
  model empty() -> Ready = Ready(false, false, false, false, false, false, false, false)
  model mem(m: Ready, i: U8) -> Bool = (
    (i == 0u8 and m.p0) or (i == 1u8 and m.p1) or (i == 2u8 and m.p2) or (i == 3u8 and m.p3) or
    (i == 4u8 and m.p4) or (i == 5u8 and m.p5) or (i == 6u8 and m.p6) or (i == 7u8 and m.p7))
  model set_at(cur: Bool, i: U8, k: U8, b: Bool) -> Bool = if i == k then b else cur
  model put(m: Ready, i: U8, b: Bool) -> Ready = (
    Ready(set_at(m.p0, i, 0u8, b), set_at(m.p1, i, 1u8, b), set_at(m.p2, i, 2u8, b), set_at(m.p3, i, 3u8, b),
          set_at(m.p4, i, 4u8, b), set_at(m.p5, i, 5u8, b), set_at(m.p6, i, 6u8, b), set_at(m.p7, i, 7u8, b)))
  model subset(a: Ready, b: Ready) -> Bool = (
    (not a.p0 or b.p0) and (not a.p1 or b.p1) and (not a.p2 or b.p2) and (not a.p3 or b.p3) and
    (not a.p4 or b.p4) and (not a.p5 or b.p5) and (not a.p6 or b.p6) and (not a.p7 or b.p7))

  -- inv(M) is total: every one of the 256 states is well formed, so there is nothing to
  -- preserve by accident. It is still written down, and closure is still claimed below, so
  -- a later M with structure (queues, counts) cannot change inv without restating closure.
  model inv(m: Ready) -> Bool = true
  model init_m() -> Ready = empty()

  -- Total abstract operations: every U8 id has a defined answer.
  model abs_insert(m: Ready, t: U8) -> (Upd, Ready) = (
    if t >= 8u8 then (OutOfRange, m)
    else (if mem(m, t) then (Unchanged, m) else (Changed, put(m, t, true))))
  model abs_remove(m: Ready, t: U8) -> (Upd, Ready) = (
    if t >= 8u8 then (OutOfRange, m)
    else (if mem(m, t) then (Changed, put(m, t, false)) else (Unchanged, m)))

  -- dispatch is not a function of M in the safety tier (any ready thread, or Idle, may be
  -- chosen), so M gives it a successor as a function of the CHOICE: the chosen thread leaves.
  model after(m: Ready, o: Pick) -> Ready = (
    match o with Idle -> m | Run(t) -> put(m, t, false))
  model valid_pick(m: Ready, o: Pick) -> Bool = (
    match o with Idle -> true | Run(t) -> t < 8u8 and mem(m, t))
  -- The highest-priority ready thread (the largest id), or Idle for the empty set.
  model top(m: Ready) -> Pick = (
    if m.p7 then Run(7u8) else (if m.p6 then Run(6u8) else (if m.p5 then Run(5u8) else
    (if m.p4 then Run(4u8) else (if m.p3 then Run(3u8) else (if m.p2 then Run(2u8) else
    (if m.p1 then Run(1u8) else (if m.p0 then Run(0u8) else Idle))))))))
  -- A Pick from a byte: 255 is Idle, anything else names a thread (possibly an invalid one).
  -- Lemmas use it to range over every Pick without a variant binder.
  model pick_of(k: U8) -> Pick = if k == 255u8 then Idle else Run(k)

  -- Caller preconditions (VOS01 section 2.8): the id names a thread. Outside it the
  -- operation answers OutOfRange and changes nothing. dispatch has none.
  model pre_insert(m: Ready, t: U8) -> Bool = t < 8u8
  model pre_remove(m: Ready, t: U8) -> Bool = t < 8u8

  -- Safety tier: a RELATION over (state, output, new state). What system theorems may use.
  model safe_dispatch(m: Ready, o: Pick, m2: Ready) -> Bool = valid_pick(m, o) and m2 == after(m, o)
  -- Policy tier: the fixed-priority function. What the hard-RTOS and flight profiles add.
  model policy_dispatch(m: Ready, o: Pick, m2: Ready) -> Bool = o == top(m) and m2 == after(m, o)
  -- vos02:contract-end
  -- vos02:impl-begin
  -- A representation fixture (VOS-D061, VOS02 section 2.7): a one-byte ready mask plus a
  -- round-robin pointer `ptr` that `alpha` forgets.  The operations are bound (no bodies, R3);
  -- the models `rep`, `rr_pick` and `rr_next` are op-free, so a claim can say what the state
  -- and the history do without calling the implementation.
  record Impl(mask: U8, ptr: U8)
  record AbsW(w: U8)
  record CfgN(v: U8)
  model dec(x: AbsW) -> Ready = (
    Ready(not (bit_and(x.w, 1u8) == 0u8), not (bit_and(x.w, 2u8) == 0u8), not (bit_and(x.w, 4u8) == 0u8),
          not (bit_and(x.w, 8u8) == 0u8), not (bit_and(x.w, 16u8) == 0u8), not (bit_and(x.w, 32u8) == 0u8),
          not (bit_and(x.w, 64u8) == 0u8), not (bit_and(x.w, 128u8) == 0u8)))
  op init() -> Impl
  op insert_out(s: Impl, t: U8) -> Upd
  op insert_img(s: Impl, t: U8) -> Impl
  op remove_out(s: Impl, t: U8) -> Upd
  op remove_img(s: Impl, t: U8) -> Impl
  op dispatch_out(s: Impl) -> Pick
  op dispatch_img(s: Impl) -> Impl
  op alpha_w(s: Impl) -> AbsW
  op cfg_n() -> CfgN

  model b2m(b: Bool, k: Nat) -> U8 = if b then shl(1u8, k) else 0u8
  -- build sets the pointer to a constant: the pointer is OUTSIDE the cone of build and alpha.
  model build(m: Ready) -> Impl = (
    Impl(bit_or(bit_or(bit_or(bit_or(bit_or(bit_or(bit_or(b2m(m.p0, 0), b2m(m.p1, 1)), b2m(m.p2, 2)), b2m(m.p3, 3)),
           b2m(m.p4, 4)), b2m(m.p5, 5)), b2m(m.p6, 6)), b2m(m.p7, 7)), 0u8))
  model inv_impl(s: Impl) -> Bool = s.ptr < 8u8

  -- The two models the representation tier names (VOS02 2.7): the state an abstract state and a
  -- history code name (the pointer is the code), and the code of a state.  The contract owns the
  -- packing of the code; this crate only says what the code is.
  model rep(m: Ready, h: U8) -> Impl = Impl(build(m).mask, h)
  model hist(s: Impl) -> U8 = s.ptr

  -- The op-free round-robin model: scan from the pointer, wrapping at 8.
  model has_bit(mask: U8, i: U8) -> Bool = not (bit_and(mask, shl(1u8, to_nat(bit_and(i, 7u8)))) == 0u8)
  model rr_pick(mask: U8, p: U8) -> Pick = (
    if has_bit(mask, p) then Run(bit_and(p, 7u8)) else
    (if has_bit(mask, p + 1u8) then Run(bit_and(p + 1u8, 7u8)) else
    (if has_bit(mask, p + 2u8) then Run(bit_and(p + 2u8, 7u8)) else
    (if has_bit(mask, p + 3u8) then Run(bit_and(p + 3u8, 7u8)) else
    (if has_bit(mask, p + 4u8) then Run(bit_and(p + 4u8, 7u8)) else
    (if has_bit(mask, p + 5u8) then Run(bit_and(p + 5u8, 7u8)) else
    (if has_bit(mask, p + 6u8) then Run(bit_and(p + 6u8, 7u8)) else
    (if has_bit(mask, p + 7u8) then Run(bit_and(p + 7u8, 7u8)) else Idle))))))))
  model rr_next(mask: U8, p: U8) -> Impl = (
    match rr_pick(mask, p) with
      Idle -> Impl(mask, p)
    | Run(t) -> Impl(bit_and(mask, bit_not(shl(1u8, to_nat(t)))), bit_and(t + 1u8, 7u8)))

  -- An OPTIONAL, ungated impl-own claim (VOS02 2.7): the full post-state of dispatch against the
  -- op-free model.  The representation tier does not require it; a round-robin keeps it so that a
  -- dispatch that stops rotating (and stays inside the image) is still caught by evidence.
  claim dispatch_det:
    forall mask: U8, p: U8 | p < 8u8. (
      dispatch_out(Impl(mask, p)) == rr_pick(mask, p) and
      dispatch_img(Impl(mask, p)) == rr_next(mask, p))

  -- The secrecy labels, hostile inputs and step bounds the Warrant checker requires of every
  -- operation (copied in shape from vos-sched-fp-bitmap; check-doc only type-checks them).
  labels insert_out:
    s public
    t public
  labels insert_img:
    s public
    t public
  labels remove_out:
    s public
    t public
  labels remove_img:
    s public
    t public
  labels dispatch_out:
    s public
  labels dispatch_img:
    s public
  labels alpha_w:
    s public

  input insert_out.s:
    hostile
    ensures no_panic, terminates
  input insert_out.t:
    hostile
    ensures no_panic, terminates
  input insert_img.s:
    hostile
    ensures no_panic, terminates
  input insert_img.t:
    hostile
    ensures no_panic, terminates
  input remove_out.s:
    hostile
    ensures no_panic, terminates
  input remove_out.t:
    hostile
    ensures no_panic, terminates
  input remove_img.s:
    hostile
    ensures no_panic, terminates
  input remove_img.t:
    hostile
    ensures no_panic, terminates
  input dispatch_out.s:
    hostile
    ensures no_panic, terminates
  input dispatch_img.s:
    hostile
    ensures no_panic, terminates
  input alpha_w.s:
    hostile
    ensures no_panic, terminates

  -- Bounds: the contract ceilings.
  bound init:
    steps <= 80
  bound insert_out:
    steps <= 160
    heap <= 0
  bound insert_img:
    steps <= 160
  bound remove_out:
    steps <= 160
    heap <= 0
  bound remove_img:
    steps <= 160
  bound dispatch_out:
    steps <= 160
  bound dispatch_img:
    steps <= 160
  bound alpha_w:
    steps <= 160
  -- vos02:impl-end
  -- vos02:obligations-begin tier=representation sha256=6e88c6c9ffe9d37db40710a4814a02a7cbf141af1c0d7d7b215a776dabf1b695
  -- The reachable states are exactly the image of rep (VOS02 2.7): init is in it, every step from it
  -- lands back in it (the _post claims, the canon_*_post pattern with rep for build), and safety holds
  -- from every state of it.  The implementation supplies two models: rep(m: Ready, h: U8) -> Impl, the
  -- state an abstract state and a history code name, and hist(s: Impl) -> U8, the code of a state.  The
  -- contract owns the packing: the history is a U8 code of which these claims use three bits
  -- (bit_and(k, 7u8)); the high bits of the same binder k are the thread argument (shr(k, 3), 0 to 31),
  -- so a claim has nine binders, not ten.  An implementation with more than eight history values needs
  -- a contract revision.  Nothing here names a field of Impl.
  claim rep_init:
    forall b: Bool. init() == rep(dec(alpha_w(init())), bit_and(hist(init()), 7u8))
  claim rep_alpha:
    forall b0: Bool, b1: Bool, b2: Bool, b3: Bool, b4: Bool, b5: Bool, b6: Bool, b7: Bool, k: U8. dec(alpha_w(rep(ready_of(b0, b1, b2, b3, b4, b5, b6, b7), bit_and(k, 7u8)))) == ready_of(b0, b1, b2, b3, b4, b5, b6, b7)
  claim insert_rep:
    forall b0: Bool, b1: Bool, b2: Bool, b3: Bool, b4: Bool, b5: Bool, b6: Bool, b7: Bool, k: U8. (
      insert_out(rep(ready_of(b0, b1, b2, b3, b4, b5, b6, b7), bit_and(k, 7u8)), shr(k, 3)) == abs_insert(ready_of(b0, b1, b2, b3, b4, b5, b6, b7), shr(k, 3)).0 and
      dec(alpha_w(insert_img(rep(ready_of(b0, b1, b2, b3, b4, b5, b6, b7), bit_and(k, 7u8)), shr(k, 3)))) == abs_insert(ready_of(b0, b1, b2, b3, b4, b5, b6, b7), shr(k, 3)).1)
  claim insert_rep_post:
    forall b0: Bool, b1: Bool, b2: Bool, b3: Bool, b4: Bool, b5: Bool, b6: Bool, b7: Bool, k: U8. rep(dec(alpha_w(insert_img(rep(ready_of(b0, b1, b2, b3, b4, b5, b6, b7), bit_and(k, 7u8)), shr(k, 3)))), bit_and(hist(insert_img(rep(ready_of(b0, b1, b2, b3, b4, b5, b6, b7), bit_and(k, 7u8)), shr(k, 3))), 7u8)) == insert_img(rep(ready_of(b0, b1, b2, b3, b4, b5, b6, b7), bit_and(k, 7u8)), shr(k, 3))
  claim remove_rep:
    forall b0: Bool, b1: Bool, b2: Bool, b3: Bool, b4: Bool, b5: Bool, b6: Bool, b7: Bool, k: U8. (
      remove_out(rep(ready_of(b0, b1, b2, b3, b4, b5, b6, b7), bit_and(k, 7u8)), shr(k, 3)) == abs_remove(ready_of(b0, b1, b2, b3, b4, b5, b6, b7), shr(k, 3)).0 and
      dec(alpha_w(remove_img(rep(ready_of(b0, b1, b2, b3, b4, b5, b6, b7), bit_and(k, 7u8)), shr(k, 3)))) == abs_remove(ready_of(b0, b1, b2, b3, b4, b5, b6, b7), shr(k, 3)).1)
  claim remove_rep_post:
    forall b0: Bool, b1: Bool, b2: Bool, b3: Bool, b4: Bool, b5: Bool, b6: Bool, b7: Bool, k: U8. rep(dec(alpha_w(remove_img(rep(ready_of(b0, b1, b2, b3, b4, b5, b6, b7), bit_and(k, 7u8)), shr(k, 3)))), bit_and(hist(remove_img(rep(ready_of(b0, b1, b2, b3, b4, b5, b6, b7), bit_and(k, 7u8)), shr(k, 3))), 7u8)) == remove_img(rep(ready_of(b0, b1, b2, b3, b4, b5, b6, b7), bit_and(k, 7u8)), shr(k, 3))
  claim dispatch_rep:
    forall b0: Bool, b1: Bool, b2: Bool, b3: Bool, b4: Bool, b5: Bool, b6: Bool, b7: Bool, k: U8. safe_dispatch(ready_of(b0, b1, b2, b3, b4, b5, b6, b7), dispatch_out(rep(ready_of(b0, b1, b2, b3, b4, b5, b6, b7), bit_and(k, 7u8))), dec(alpha_w(dispatch_img(rep(ready_of(b0, b1, b2, b3, b4, b5, b6, b7), bit_and(k, 7u8))))))
  claim dispatch_rep_post:
    forall b0: Bool, b1: Bool, b2: Bool, b3: Bool, b4: Bool, b5: Bool, b6: Bool, b7: Bool, k: U8. rep(dec(alpha_w(dispatch_img(rep(ready_of(b0, b1, b2, b3, b4, b5, b6, b7), bit_and(k, 7u8))))), bit_and(hist(dispatch_img(rep(ready_of(b0, b1, b2, b3, b4, b5, b6, b7), bit_and(k, 7u8)))), 7u8)) == dispatch_img(rep(ready_of(b0, b1, b2, b3, b4, b5, b6, b7), bit_and(k, 7u8)))
  -- vos02:obligations-end
  -- vos02:obligations-begin tier=safety sha256=238c31381646b16001784c8533f8b2ed97e83256b48869d716816f01d435b16f
  -- insert and remove are deterministic in both tiers (shape A of VOS01 section 2.3).
  claim insert_safe:
    forall b0: Bool, b1: Bool, b2: Bool, b3: Bool, b4: Bool, b5: Bool, b6: Bool, b7: Bool, t: U8. (
      insert_out(build(ready_of(b0, b1, b2, b3, b4, b5, b6, b7)), t) == abs_insert(ready_of(b0, b1, b2, b3, b4, b5, b6, b7), t).0 and
      dec(alpha_w(insert_img(build(ready_of(b0, b1, b2, b3, b4, b5, b6, b7)), t))) == abs_insert(ready_of(b0, b1, b2, b3, b4, b5, b6, b7), t).1)
  claim remove_safe:
    forall b0: Bool, b1: Bool, b2: Bool, b3: Bool, b4: Bool, b5: Bool, b6: Bool, b7: Bool, t: U8. (
      remove_out(build(ready_of(b0, b1, b2, b3, b4, b5, b6, b7)), t) == abs_remove(ready_of(b0, b1, b2, b3, b4, b5, b6, b7), t).0 and
      dec(alpha_w(remove_img(build(ready_of(b0, b1, b2, b3, b4, b5, b6, b7)), t))) == abs_remove(ready_of(b0, b1, b2, b3, b4, b5, b6, b7), t).1)
  -- dispatch is a relation (shape B): any permitted choice, and the chosen thread leaves.
  claim dispatch_safe:
    forall b0: Bool, b1: Bool, b2: Bool, b3: Bool, b4: Bool, b5: Bool, b6: Bool, b7: Bool. (
      safe_dispatch(ready_of(b0, b1, b2, b3, b4, b5, b6, b7), dispatch_out(build(ready_of(b0, b1, b2, b3, b4, b5, b6, b7))), dec(alpha_w(dispatch_img(build(ready_of(b0, b1, b2, b3, b4, b5, b6, b7)))))))
  -- alpha is onto M (shape C of VOS01 section 2.3): build and alpha agree on every abstract state.
  -- It pins build, alpha and dec for EVERY implementation: a representation-mode scheduler and -any
  -- carry the safety tier but not canonical, and would otherwise have an alpha nothing constrains.
  claim safety_alpha_build:
    forall b0: Bool, b1: Bool, b2: Bool, b3: Bool, b4: Bool, b5: Bool, b6: Bool, b7: Bool. dec(alpha_w(build(ready_of(b0, b1, b2, b3, b4, b5, b6, b7)))) == ready_of(b0, b1, b2, b3, b4, b5, b6, b7)
  -- init starts from the empty ready set, for EVERY implementation (VOS-D081).  The binder is unused
  -- (the same convention as canon_init, F5): the generator needs one.
  claim safety_init:
    forall b: Bool. dec(alpha_w(init())) == empty()
  -- vos02:obligations-end
  assume platform:
    none
  assume environment:
    none
