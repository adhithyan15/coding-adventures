# Perl 5.004_59 (1998-02-13) plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: unsupported Perl 5.004_59 syntax is rejected.
# Evidence: https://mirrors.develooper.com/perl/historical-perl/perl-5.004_59.tar.gz
# Archive SHA-256: 76425638c9ca1502947e26728c4b9a3dd1982a538727629c5f5c4339757231cc
# Its perly.y matches 5.004_58 byte for byte; only the bounded subset is modeled.
# Only arithmetic precedence, grouping, and print are represented here.

program         = print_statement { print_statement } ;
print_statement = PRINT LPAREN expr RPAREN SEMICOLON ;
expr            = term { ( PLUS | MINUS ) term } ;
term            = unary { STAR unary } ;
unary           = MINUS unary | atom ;
atom            = INT | LPAREN expr RPAREN ;
