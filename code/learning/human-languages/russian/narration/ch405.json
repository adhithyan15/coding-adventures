          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "насос (nasós) is built from на- and the root of сосать 'to suck': a pump sucks up air or water. EtymDB lists the word without a source."
            }
          ]
        },
