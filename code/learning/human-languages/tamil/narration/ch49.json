          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new run of words: what did piṟaku mean, and what did puṟappaḍu mean?"
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: அன்பு",
          "segments": [
            {
              "kind": "speech",
              "text": "அன்பு (aṉbu) — \"affection\"."
            },
            {
              "kind": "speech",
              "text": "This is the warm, ordinary love — for a family, for a friend, for a place. kādal is the other kind, the one the poems are about, and Tamil keeps the two apart where English makes one word do both."
            },
            {
              "kind": "speech",
              "text": "A letter opens aṉbuḷḷa, \"dear\", which is literally 'having affection'. Put the endings you know on the stem and you get aṉbaṉ and aṉbar, somebody who loves — the same two endings, doing the same work, on new material."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "The first of five courtesies."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "aṉbu",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *aṉbu*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "it once more, slowly",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: it once more, slowly]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "aṉbu, then aṉbuḷḷa, and hear the stem stay put",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *aṉbu*, then *aṉbuḷḷa*, and hear the stem stay put]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
