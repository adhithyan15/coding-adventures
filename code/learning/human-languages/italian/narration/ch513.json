          "segments": [
            {
              "kind": "speech",
              "text": "la maratona — \"marathon\"."
            },
            {
              "kind": "speech",
              "text": "Ho corso la mia prima maratona a quarant'anni. I ran my first marathon at forty."
            },
            {
              "kind": "speech",
              "text": "Also a long session: una maratona di film."
            }
          ]
        },
