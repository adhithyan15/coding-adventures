        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: o cidadão",
          "segments": [
            {
              "kind": "speech",
              "text": "o cidadão — \"the citizen\"."
            },
            {
              "kind": "speech",
              "text": "Todos os cidadãos podem votar aos dezoito anos. All citizens can vote at eighteen."
            },
            {
              "kind": "speech",
              "text": "Plural os cidadãos; feminine a cidadã. O cartão de cidadão is the Portuguese identity card."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "cidadão is inherited from Old Portuguese çidadão (EtymDB), built on cidade \"city\", from Latin cīvitās \"citizenship, city\", on cīvis \"citizen\" (Lewis & Short)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
