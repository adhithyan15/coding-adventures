        "path": "code/packages/ruby/gamma/BUILD",
        "content_utf8": "echo build gamma\n"
      },
      {
        "path": "code/packages/ruby/gamma/coding_adventures_gamma.gemspec",
        "content_utf8": "Gem::Specification.new do |spec|\n  spec.name = \"coding_adventures_gamma\"\nend\n"
      }
    ]
