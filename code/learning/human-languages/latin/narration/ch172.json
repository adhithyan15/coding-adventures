        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: serō, serere",
          "segments": [
            {
              "kind": "speech",
              "text": "serō, serere — \"to sow, to plant\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "serō, \"to sow\", is inherited from Proto-Italic sizō, \"I sow\", usually traced to Proto-Indo-European si-sh1-, \"to sow\", a doubled form of the root (EtymDB 2.1); sēmen, \"seed\", has the same root. It is a different word from serō, \"to join, to bind\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for this chapter."
