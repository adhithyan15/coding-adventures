          "segments": [
            {
              "kind": "speech",
              "text": "il saldo — \"the balance (of an account); the final payment\"."
            },
            {
              "kind": "speech",
              "text": "Controllo il saldo prima di fare acquisti. I check my balance before I go shopping."
            },
            {
              "kind": "speech",
              "text": "Il saldo is also what is left to pay: pagare il saldo. I saldi are the sales."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "saldo is built on saldare \"to weld, to settle an account\", from the adjective saldo \"firm\", inherited from Latin solidus \"solid, whole\" (Lewis & Short): the account made whole."
            }
          ]
        },
        {
