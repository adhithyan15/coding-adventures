        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: der Flugbegleiter",
          "segments": [
            {
              "kind": "speech",
              "text": "der Flugbegleiter — \"the flight attendant\"."
            },
            {
              "kind": "speech",
              "text": "Der Flugbegleiter bringt uns Wasser und Kaffee. The flight attendant brings us water and coffee."
            },
            {
              "kind": "speech",
              "text": "Same form in the plural. A woman: die Flugbegleiterin."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Flugbegleiter is built from Flug 'flight', inherited from Proto-Germanic flugiz (EtymDB), and Begleiter 'companion', from begleiten 'to accompany', which is built on leiten 'to lead'."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
