          "segments": [
            {
              "kind": "speech",
              "text": "praecō, praecōnis — \"a herald, a crier\"."
            },
            {
              "kind": "speech",
              "text": "Praecō in forō victōriam nūntiāvit. The herald announced the victory in the forum."
            },
            {
              "kind": "speech",
              "text": "Masculine, 3rd declension. He called for silence at trials, announced the lots at auctions and proclaimed winners at the games."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "praecō is usually traced to prae, \"before, in front\", and vocō, \"to call\": one who calls out in front. Lewis & Short give the word without a settled origin."
            }
          ]
        },
