        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: el recibo",
          "segments": [
            {
              "kind": "speech",
              "text": "el recibo — \"the receipt\"."
            },
            {
              "kind": "speech",
              "text": "Guarde el recibo para cambiar el producto. Keep the receipt to exchange the item."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "recibo is the noun of recibir, \"to receive\", from Latin recipere, \"to take back\" — inherited: the -p- became -b-."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
