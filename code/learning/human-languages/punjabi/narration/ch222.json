  "lessons": [
    {
      "id": "PA-C222-fut-return",
      "sequence": 12170,
      "title": "Return to going tomorrow",
      "headword": "ਜਾਵਾਂਗਾ · ਜਾਵੇਗਾ · ਜਾਵਾਂਗੇ",
      "romanization": "jāvāṅgā · jāvegā · jāvāṅge",
      "gloss": "retrieve I will go, he will go and we will go by ear",
      "script": "gurmukhi",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:55198adbc9fa690d",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "prompt",
              "action": "HEAR",
              "instruction": "jāvāṅgā; jāvegā; jāvāṅge",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU HEAR: *jāvāṅgā; jāvegā; jāvāṅge*]"
            },
            {
              "kind": "speech",
              "text": "Say ਜਾਵਾਂਗਾ, ਜਾਵੇਗਾ, ਜਾਵਾਂਗੇ."
            }
          ]
        },
        {
          "index": 1,
          "type": "grammar",
          "title": "Grammar Lens",
          "segments": [
            {
              "kind": "speech",
              "text": "Those three futures needed ਵ after the vowel of ਜਾ. The verb ਕਰਨਾ, \"to do\", has a stem that ends in a consonant, ਕਰ. Keep it ready."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "HEAR",
              "instruction": "I will go tomorrow",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU HEAR: *I will go tomorrow*]"
            },
            {
              "kind": "speech",
              "text": "Say it with the ending that fits you."
            },
            {
              "kind": "prompt",
              "action": "HEAR",
              "instruction": "she will go tomorrow",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU HEAR: *she will go tomorrow*]"
            },
            {
              "kind": "speech",
              "text": "Say ਉਹ ਕੱਲ੍ਹ ਜਾਵੇਗੀ."
            },
            {
              "kind": "prompt",
              "action": "HEAR",
              "instruction": "to do",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU HEAR: *to do*]"
            },
            {
              "kind": "speech",
              "text": "Say ਕਰਨਾ."
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Say we will go, then to do."
            }
          ]
        }
      ]
    },
    {
      "id": "PA-C222-karanga",
      "sequence": 12180,
      "title": "ਕਰਾਂਗਾ, ਕਰੇਗਾ — will do",
      "headword": "ਕਰਾਂਗਾ · ਕਰੇਗਾ",
      "romanization": "karāṅgā · karegā",
      "gloss": "I will do, he will do: the future of a consonant stem",
      "script": "gurmukhi",
      "modality": "sight",
      "derivedModality": "sight",
      "modalityReasons": [
        "eyes-or-hands-step"
      ],
      "sourceHash": "fnv1a64:15c5b814f7f0874f",
      "notice": {
        "modality": "sight",
        "needs": [
          "your eyes or your hands for the steps that ask you to read, point, write or gesture"
        ],
        "waitUntilStopped": [
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your eyes, so it is not fully a driving lesson. You will want your eyes or your hands for the steps that ask you to read, point, write or gesture. You can listen to everything else now. I will say so again when we reach it, but leave this section until you have stopped: Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Say I will go and he will go. Then to do."
            }
          ]
        },
        {
          "index": 1,
          "type": "grammar",
          "title": "Grammar Lens: the ending straight on",
          "segments": [
            {
              "kind": "speech",
              "text": "A consonant stem takes the endings with no ਵ between:"
            },
            {
              "kind": "speech",
              "text": "ਕਰ + ਾਂਗਾ becomes ਕਰਾਂਗਾ, ਕਰ + ੇਗਾ becomes ਕਰੇਗਾ."
            },
            {
              "kind": "speech",
              "text": "ਮੈਂ ਕੱਲ੍ਹ ਕੰਮ ਕਰਾਂਗਾ। — maiṁ kallh kamm karāṅgā. — I will work tomorrow (a man speaking)."
            },
            {
              "kind": "speech",
              "text": "ਮੈਂ ਕੱਲ੍ਹ ਕੰਮ ਕਰਾਂਗੀ। — maiṁ kallh kamm karāṅgī. — I will work tomorrow (a woman speaking)."
            },
            {
              "kind": "speech",
              "text": "ਅਮਨ ਕੰਮ ਕਰੇਗਾ। — Aman kamm karegā. — Aman will work."
            },
            {
              "kind": "speech",
              "text": "ਕਰੇਗੀ is for a woman, and ਕਰਾਂਗੇ for ਅਸੀਂ."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "HEAR",
              "instruction": "she will work tomorrow",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU HEAR: *she will work tomorrow*]"
            },
            {
              "kind": "speech",
              "text": "Say ਉਹ ਕੱਲ੍ਹ ਕੰਮ ਕਰੇਗੀ।."
            },
            {
              "kind": "prompt",
              "action": "HEAR",
              "instruction": "we will work",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU HEAR: *we will work*]"
            },
            {
              "kind": "speech",
              "text": "Say ਅਸੀਂ ਕੰਮ ਕਰਾਂਗੇ।."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "ਕਰਾਂਗਾ",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: **ਕਰਾਂਗਾ**]"
            },
            {
              "kind": "speech",
              "text": "Point to the stem ਕਰ, then the ending."
            },
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "copy ਕਰਾਂਗਾ and ਕਰੇਗਾ once",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: copy **ਕਰਾਂਗਾ** and **ਕਰੇਗਾ** once]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "I will do? (ਕਰਾਂਗਾ or ਕਰਾਂਗੀ.) He will do? (ਕਰੇਗਾ.)"
            }
          ]
        }
      ]
    },
    {
      "id": "PA-C222-karoge",
      "sequence": 12190,
      "title": "ਕਰੋਗੇ, ਕਰਨਗੇ — you will do, they will do",
      "headword": "ਕਰੋਗੇ · ਕਰਨਗੇ",
      "romanization": "karoge · karange",
      "gloss": "you will do, they will do",
      "script": "gurmukhi",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:3f5a2472df98975b",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Say I will work tomorrow and we will work. Then ਤੁਸੀਂ."
            }
          ]
        },
        {
          "index": 1,
          "type": "grammar",
          "title": "Grammar Lens: two more cells",
          "segments": [
            {
              "kind": "speech",
              "text": "With ਤੁਸੀਂ the future of ਕਰਨਾ is ਕਰੋਗੇ; with ਉਹ, for a group, it is ਕਰਨਗੇ:"
            },
            {
              "kind": "speech",
              "text": "ਤੁਸੀਂ ਕੱਲ੍ਹ ਕੀ ਕਰੋਗੇ? — tusīṁ kallh kī karoge? — What will you do tomorrow?"
            },
            {
              "kind": "speech",
              "text": "ਉਹ ਕੱਲ੍ਹ ਕੰਮ ਕਰਨਗੇ। — uh kallh kamm karange. — They will work tomorrow."
            },
            {
              "kind": "speech",
              "text": "Here ਕੀ is \"what\": it stands where the answer goes."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "HEAR",
              "instruction": "what will you do tomorrow?",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU HEAR: *what will you do tomorrow?*]"
            },
            {
              "kind": "speech",
              "text": "Say ਤੁਸੀਂ ਕੱਲ੍ਹ ਕੀ ਕਰੋਗੇ? (tusīṁ kallh kī karoge?)"
            },
            {
              "kind": "prompt",
              "action": "HEAR",
              "instruction": "I will go to the market",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU HEAR: *I will go to the market*]"
            },
            {
              "kind": "speech",
              "text": "Answer it with the ending that fits you."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "ਉਹ ਕੱਲ੍ਹ ਕੰਮ ਕਰਨਗੇ।",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: **ਉਹ ਕੱਲ੍ਹ ਕੰਮ ਕਰਨਗੇ।**]"
            },
            {
              "kind": "speech",
              "text": "Give its meaning."
            },
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "copy ਕਰੋਗੇ once",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: copy **ਕਰੋਗੇ** once]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "You will do? (ਕਰੋਗੇ.) They will do? (ਕਰਨਗੇ.)"
            }
          ]
        }
      ]
    },
