    {
      "id": "ZH-W334-hong-red",
      "sequence": 25835,
      "title": "红 (hóng) — the silk piece, then 工",
      "headword": "红",
      "romanization": "hóng",
      "gloss": "红 — the silk piece of 给, then 工",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:3a949d6e17122d52",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — the silk piece, then 工",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — the silk piece, then 工 and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say hóngbāo — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *hóngbāo* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "给 工."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — gěi, gōng",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *gěi*, *gōng*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — the silk piece, then 工",
          "segments": [
            {
              "kind": "speech",
              "text": "红 (hóng)."
            },
            {
              "kind": "speech",
              "text": "Two pieces, left before right."
            },
            {
              "kind": "speech",
              "text": "The left piece, three strokes, as on the left of 给: a stroke that falls to the left and turns right, a second one like it below, then a short stroke rising to the right."
            },
            {
              "kind": "speech",
              "text": "The right piece, 工, three strokes. A short bar, a vertical down from its middle, then a longer bar along the foot."
            },
            {
              "kind": "speech",
              "text": "3 + 3 = six."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "红 (hóng), all six, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 红, all six, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many strokes in 红 (hóng)? (Six.) Where have you met the left piece? (On the left of 给.) What is the right piece? (工.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 红 (hóng), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
