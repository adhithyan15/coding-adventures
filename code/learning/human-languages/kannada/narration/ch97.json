      ],
      "sourceHash": "fnv1a64:5558db471019653f",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Kannada for hello, then the Kannada for are you well."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ಕ್ಷಮೆ",
          "segments": [
            {
              "kind": "speech",
              "text": "ಕ್ಷಮೆ (kṣame) — \"pardon, forgiveness\". You know its verb from ಕ್ಷಮಿಸಿ (kṣamisi), \"excuse me\"."
            },
            {
              "kind": "speech",
              "text": "ಕ್ಷಮೆ ಇರಲಿ (kṣame irali) — \"please forgive me\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ಕ್ಷಮೆ (kṣame) is Sanskrit kṣamā, \"patience\", taken over whole as a learned loan, a tatsama, with Kannada's -e for the Sanskrit -ā (CDIAL 3659). Patience with someone became pardon."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "The noun behind excuse me."
            }
          ]
        },
        {
          "index": 4,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "kṣame",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *kṣame*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "kṣame, once more",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *kṣame*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "say kṣame irali",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: say *kṣame irali*]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say the Kannada for hello, then the Kannada for are you well, then say kṣame again",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say the Kannada for hello, then the Kannada for are you well, then say *kṣame* again]"
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What does ಕ್ಷಮೆ (kṣame) mean? (\"Pardon, forgiveness\".) Say it once more."
            }
          ]
        }
