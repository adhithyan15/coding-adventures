          "segments": [
            {
              "kind": "speech",
              "text": "山区 — shānqū — \"mountain area\"."
            },
            {
              "kind": "speech",
              "text": "wǒ nǎinai zhù zài shānqū — My grandmother lives up in the mountains."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "山区 (shānqū) is built from 山 'a mountain' and 区 'an area', both inherited from Middle Chinese, srean and khju (Guangyun, in Baxter's transcription); the dictionary gives the second as the name of a marsh, and the sense 'an area' is not given there."
            }
          ]
        },
