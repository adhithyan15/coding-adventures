            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Spanish for to fall ill, then the Spanish for to get worse."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: la gripe",
          "segments": [
            {
              "kind": "speech",
              "text": "la gripe — \"the flu\"."
            },
            {
              "kind": "speech",
              "text": "Estoy en cama con gripe. I am in bed with the flu."
            },
            {
              "kind": "speech",
              "text": "In Mexico and Colombia people say la gripa."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "gripe was borrowed from French grippe (EtymDB), from gripper \"to seize\", which comes from Frankish grīpan: an illness that grips you."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
