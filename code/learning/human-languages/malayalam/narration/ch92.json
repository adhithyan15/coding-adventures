          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Ask how many rupees something is. Then say where you are."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ബിൽ",
          "segments": [
            {
              "kind": "speech",
              "text": "ബിൽ — bil — the bill."
            },
            {
              "kind": "speech",
              "text": "Another borrowing, and this one kept its meaning intact — which is the point of meeting it right after one that did not. Borrowed words are not all alike; you have to check each one."
            },
            {
              "kind": "speech",
              "text": "The asking costs nothing new. എത്ര has been yours since the distance chapter, and വില since the shopping chapter:"
            },
            {
              "kind": "table",
              "headers": [
                "",
                ""
              ],
              "columns": 2,
              "rowCount": 2,
              "utterances": [
                "എത്ര രൂപ?, how many rupees?",
                "ബിൽ, the bill."
              ]
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "The far end of a meal."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
