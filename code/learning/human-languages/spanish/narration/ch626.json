        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: la sentencia",
          "segments": [
            {
              "kind": "speech",
              "text": "la sentencia — \"the court ruling, the judgment; the sentence\"."
            },
            {
              "kind": "speech",
              "text": "La sentencia sale mañana. The ruling comes out tomorrow."
            },
            {
              "kind": "speech",
              "text": "A court decision; dictar sentencia — to pass judgment. A sentence in grammar is la oración or la frase."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "sentencia is a learned borrowing from Latin sententia 'way of thinking, opinion, verdict', built on sentire 'to feel, to think' (EtymDB)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
            }
          ]
