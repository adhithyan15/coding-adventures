          "index": 1,
          "type": "input",
          "title": "You'll want to know: صادق",
          "segments": [
            {
              "kind": "speech",
              "text": "صادق (sâdeq) — \"honest, sincere\"."
            },
            {
              "kind": "speech",
              "text": "دوست من همیشه با من صادق است. dust-e man hamishe bâ man sâdeq ast. My friend is always honest with me."
            },
            {
              "kind": "speech",
              "text": "bâ kasi sâdeq budan — to be honest with someone."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "sâdeq was borrowed from Arabic ṣādiq, 'true, sincere; reliable' (EtymDB)."
            }
          ]
        },
        {
