        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: lacrimō, lacrimāre",
          "segments": [
            {
              "kind": "speech",
              "text": "lacrimō, lacrimāre — \"to weep, shed tears\"."
            },
            {
              "kind": "speech",
              "text": "Īnfāns tōtam noctem lacrimat. The baby cries all night."
            },
            {
              "kind": "speech",
              "text": "lacrimō, lacrimāre, lacrimāvī, lacrimātum, from lacrima — a tear. English lachrymose comes from the same family."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "lacrimō is built on lacrima \"a tear\" (Lewis & Short), which EtymDB traces to a Proto-Indo-European word for \"tear\"; English tear is a cousin."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
