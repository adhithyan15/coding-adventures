        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: zustimmen",
          "segments": [
            {
              "kind": "speech",
              "text": "zustimmen — \"to agree (with)\"."
            },
            {
              "kind": "speech",
              "text": "Ich stimme dir zu: Wir sollten früher losfahren. I agree with you: we should set off earlier."
            },
            {
              "kind": "speech",
              "text": "Separable, with the dative: ich stimme dir zu, sie hat zugestimmt. Einem Plan zustimmen — to approve a plan."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "zustimmen is built from zu \"to\" and stimmen, a verb made from Stimme \"voice, vote\" (EtymDB): you add your voice to an idea."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
