        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: die Katastrophe",
          "segments": [
            {
              "kind": "speech",
              "text": "die Katastrophe — \"the disaster, the catastrophe\"."
            },
            {
              "kind": "speech",
              "text": "Das Wetter war eine Katastrophe. The weather was a disaster."
            },
            {
              "kind": "speech",
              "text": "Plural: die Katastrophen. Colloquially, anything that went badly."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Katastrophe comes from Latin catastropha, from Greek katastrophē \"an overturning\" (EtymDB), built on kata \"down\" and strephein \"to turn\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
