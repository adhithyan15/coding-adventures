    {
      "id": "SA-C260-singular-object-practice",
      "sequence": 15530,
      "title": "Is the one person me or you?",
      "headword": "(singular object contrast)",
      "romanization": "",
      "gloss": "me or you, one person",
      "script": "devanagari",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:9f4a300bf5117831",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Give the two singular objects: “me” and “you”. (Mām; tvām.)"
            }
          ]
        },
        {
          "index": 1,
          "type": "grammar",
          "title": "Grammar Lens: choose by person",
          "segments": [
            {
              "kind": "speech",
              "text": "There is one person in either sentence. Choose by who that person is:"
            },
            {
              "kind": "speech",
              "text": "the speaker as object: माम् (mām);"
            },
            {
              "kind": "speech",
              "text": "one familiar addressee as object: त्वाम् (tvām)."
            },
            {
              "kind": "speech",
              "text": "Both are independent full forms and both take the same place before पश्यति. The choice changes the person seen, not the verb."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": true,
              "source": "[PAUSE 2s each]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "“he sees me” — saḥ mām paśyati",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: “he sees me” — *saḥ mām paśyati*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "“he sees you” — saḥ tvām paśyati",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: “he sees you” — *saḥ tvām paśyati*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "the rule — choose mām for the speaker, tvām for one familiar addressee",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: the rule — choose *mām* for the speaker, *tvām* for one familiar addressee]"
            },
            {
              "kind": "prompt",
              "action": "CONTRAST",
              "instruction": "mām; tvām; mām; tvām",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU CONTRAST: *mām; tvām; mām; tvām*]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Say both sentences without looking back, then name what changes. (Saḥ mām paśyati; saḥ tvām paśyati; the person used as the object changes.)"
            }
          ]
        }
      ]
    }
