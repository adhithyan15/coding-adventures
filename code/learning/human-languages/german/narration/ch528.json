        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: die Unordnung",
          "segments": [
            {
              "kind": "speech",
              "text": "die Unordnung — \"mess, disorder\"."
            },
            {
              "kind": "speech",
              "text": "In seinem Zimmer herrscht immer Unordnung. His room is forever in a mess."
            },
            {
              "kind": "speech",
              "text": "No plural."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Unordnung is built on un- \"not\" and Ordnung \"order\", inherited from Old High German ordinunga (EtymDB), built on a verb borrowed from Latin ōrdināre, from ōrdō \"row, order\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
