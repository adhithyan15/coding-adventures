          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "नींद आ रही है (nīnd ā rahī hai) is \"sleep is coming\". nīnd comes from Sanskrit nidrā, \"sleep\" (CDIAL 7200)."
            }
          ]
        },
