        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: facultās, facultātis",
          "segments": [
            {
              "kind": "speech",
              "text": "facultās, facultātis — \"a chance, the means to do something\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "facultās is built on facul, \"easily\", an old form of facilis, \"easy\" (Lewis & Short): ease, and so the means to do something."
            }
          ]
        },
