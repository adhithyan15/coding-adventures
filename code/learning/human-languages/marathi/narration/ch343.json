              "responseSeconds": 8,
              "source": "[YOU SAY: *muddā*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "muddā, once more",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *muddā*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "hā muddā phār mahattvācā āhe. — This point is very important.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *hā muddā phār mahattvācā āhe.* — This point is very important.]"
            },
            {
              "kind": "prompt",
