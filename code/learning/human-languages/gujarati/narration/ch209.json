          "segments": [
            {
              "kind": "speech",
              "text": "બગડવું — bagaḍvũ — \"to break down, to go bad\"."
            },
            {
              "kind": "speech",
              "text": "રસ્તામાં ગાડી બગડી. — rastāmā̃ gāḍī bagaḍī — \"The car broke down on the way.\""
            }
          ]
        },
        {
