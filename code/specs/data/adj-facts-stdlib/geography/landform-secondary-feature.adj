% ============================================================================
% landform-secondary-feature — for the landforms whose SAME cited USGS
% thesaurus span also names a second, structural feature, that feature
% (adj-facts-stdlib, GEOGRAPHY).
% ============================================================================
% A sibling to the already-shipped `landforms.adj` (`landform_description
% (landform, description)`, ONE defining descriptor per landform: mountain,
% valley, plateau, plain, canyon). That table's own header already quotes,
% VERBATIM, the FULL USGS Feature Type Thesaurus span for every row — but
% the descriptor-only schema reduced each span to a single atom, leaving a
% SECOND (and, for canyon, a THIRD) structural clause unused for four of the
% five landforms:
%
%   valley → contains_stream_with_outlet
%     "...commonly situated between two mountains or between ranges of
%      hills or mountains, and often containing a stream with an outlet."
%
%   plateau → bounded_by_abrupt_descent
%     "...commonly limited on at least one side by an abrupt descent..."
%
%   canyon → continuous_slope_at_bottom
%     "...the bottom of which generally has a continuous slope"
%     (no full stop: on the page a bracketed source citation follows)
%
%   canyon → steep_sides
%     "Relatively narrow, deep depressions with steep sides..."
%
%   plain → uniform_slope
%     "Regions of general uniform slope, comparatively level and of
%      considerable extent."
%
% Recall is a binding query:
%
%     ? landform_secondary_feature(valley, $Feature)   % contains_stream_with_outlet
%
% This is a native `table` (ADJ-TABLES RS-5, a TWO-column table like
% `landforms.adj`'s own `landform_description`): each `row` lowers to a
% ground relation `landform_secondary_feature(landform, feature)` carrying
% the citation, so the lookup above is the ordinary SLD binding query — the
% engine returns the secondary feature WITH its source, on the CPU, with
% zero model calls, and abstains on mountain, whose own cited span states
% ONLY the single descriptor already captured by the parent table, with no
% second structural clause. `canyon` carries TWO rows in this table (its own
% cited span states two distinct structural clauses — steep sides AND a
% continuous slope at the bottom), so a forward recall on canyon is a
% genuine multi-answer query, the established pattern this stdlib already
% uses elsewhere (e.g. `geology/igneous-rock-type-eruption-location.adj`).
%
% Only mountain, among `landforms.adj`'s five landforms, has NO genuinely
% distinct secondary feature in its already-cited span; this table is
% deliberately narrow rather than inventing a feature the source does not
% state. The query also runs BACKWARD — bind a feature and recall which
% landform it names:
%
%     ? landform_secondary_feature($Landform, continuous_slope_at_bottom)   % canyon
%
% Provenance: the four definitions come from the USGS-hosted Alexandria
% Digital Library Feature Type Thesaurus page that `landforms.adj` also cites.
% EACH ROW CITES ITS OWN LANDFORM'S DEFINITION (ADJ-TABLES RS-5e, #14986).
% Until 2026-09-15 the table held valley's definition as its one envelope and
% attached the other three as table-level `cites`, so every answer carried
% all four definitions and was primarily sourced to valley's. On the page
% each definition is a <span class="scope"> under a separate term link and
% never names its landform, so a definition corroborates its row and does not
% warrant it on its own. The envelope is now the thesaurus's own description,
% "Types of named geographic features.", from the italic line under its
% title. Measured 2026-09-15: each definition and the envelope occur exactly
% once in the page's visible text. (The valley definition's apostrophe is
% `&#039;` in the HTML, which renders as the straight one shipped here.)
% `trust authoritative` — USGS, a U.S. federal .gov source. This header used
% to say the spans were reproduced "byte-for-byte" with "no new WebFetch";
% the check above is a raw fetch, and it replaces that claim.
% (See ../README.md; feedback_nothing_human_authored,
% feedback_adj_only_shipped_artifacts.)
% ============================================================================

table landform_secondary_feature {
    columns landform, feature

    % Each row CITES the thesaurus's own definition of its landform.
    % `cites`, not `source`: on the page the landform is a separate
    % term link and the definition a <span> beneath it that never
    % names the landform -- #13934's held question, decided as in
    % `physics/energy-form-family.adj`. Both canyon rows cite the one
    % canyon definition, which states both features.
    row (valley, contains_stream_with_outlet) {
        cites "Low-lying land bordered by higher ground; especially elongate, relatively large gently sloping depressions of the Earth's surface, commonly situated between two mountains or between ranges of hills or mountains, and often containing a stream with an outlet." locator "https://apps.usgs.gov/thesaurus/thesaurus-full.php?thcode=3"
    }
    row (plateau, bounded_by_abrupt_descent) {
        cites "Comparatively flat areas of great extent and elevation; specif. extensive land regions considerably above the adjacent country or above sea level; commonly limited on at least one side by an abrupt descent, have flat or nearly smooth surfaces but are often dissected by deep valleys and surmounted by high hills or mountains, and have a large part of their total surface at or near the summit level." locator "https://apps.usgs.gov/thesaurus/thesaurus-full.php?thcode=3"
    }
    row (canyon, continuous_slope_at_bottom) {
        cites "Relatively narrow, deep depressions with steep sides, the bottom of which generally has a continuous slope" locator "https://apps.usgs.gov/thesaurus/thesaurus-full.php?thcode=3"
    }
    row (canyon, steep_sides) {
        cites "Relatively narrow, deep depressions with steep sides, the bottom of which generally has a continuous slope" locator "https://apps.usgs.gov/thesaurus/thesaurus-full.php?thcode=3"
    }
    row (plain, uniform_slope) {
        cites "Regions of general uniform slope, comparatively level and of considerable extent." locator "https://apps.usgs.gov/thesaurus/thesaurus-full.php?thcode=3"
    }

    % THE ENVELOPE WAS VALLEY'S OWN DEFINITION, and three table-level
    % `cites` attached every other definition to every answer. It is
    % now the thesaurus's own description of what it lists, which
    % names no landform and warrants no single row.
    source "Types of named geographic features."
    locator "https://apps.usgs.gov/thesaurus/thesaurus-full.php?thcode=3"
    trust authoritative
}
