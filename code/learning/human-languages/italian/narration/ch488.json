        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: il pronto soccorso",
          "segments": [
            {
              "kind": "speech",
              "text": "il pronto soccorso — \"emergency room, A&E\"."
            },
            {
              "kind": "speech",
              "text": "Di notte siamo andati al pronto soccorso. At night we went to A&E."
            },
            {
              "kind": "speech",
              "text": "Literally \"ready help\"; pronto is also what you say on the phone."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "pronto soccorso is built from pronto \"ready, quick\", inherited from Latin prōmptus (EtymDB), and soccorso \"help\", from Vulgar Latin succursum (EtymDB), built on currere \"to run\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
