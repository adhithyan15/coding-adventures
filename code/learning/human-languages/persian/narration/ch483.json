          "segments": [
            {
              "kind": "speech",
              "text": "صداقت (sedâqat) — \"honesty, sincerity\"."
            },
            {
              "kind": "speech",
              "text": "صداقت برای من از پول مهمتر است. sedâqat barâ-ye man az pul mohemtar ast. Honesty matters more to me than money."
            },
            {
              "kind": "speech",
              "text": "A noun; it shares its Arabic root with sâdeq 'honest'."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "sedâqat is a loan, usually traced to Arabic ṣadāqa, a word from the same root as ṣādiq, 'true, sincere'. In Arabic ṣadāqa means 'friendship'; Persian took it as 'honesty'. EtymDB has no entry for it."
            }
          ]
        },
