        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: travolgere",
          "segments": [
            {
              "kind": "speech",
              "text": "travolgere — \"to run over, to sweep away\"."
            },
            {
              "kind": "speech",
              "text": "Un'auto ha travolto un ciclista. A car ran over a cyclist."
            },
            {
              "kind": "speech",
              "text": "Past participle travolto. Also a wave or a flood: travolto dall'acqua."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "travolgere joins tra- \"across\", from Latin trāns, and volgere \"to turn\", from Latin volvere \"to roll\" (Lewis & Short)."
            }
          ]
        },
        {
