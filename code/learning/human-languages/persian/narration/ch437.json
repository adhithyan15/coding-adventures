        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: مسافرخانه",
          "segments": [
            {
              "kind": "speech",
              "text": "مسافرخانه (mosâferkhâne) — \"a guesthouse, a cheap inn\"."
            },
            {
              "kind": "speech",
              "text": "شب در یک مسافرخانه ارزان ماندیم. Shab dar yek mosâferkhâne-ye arzân mândim. We spent the night in a cheap guesthouse."
            },
            {
              "kind": "speech",
              "text": "mosâfer 'traveller' + khâne 'house'. Simpler and cheaper than a hotel."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "mosâferkhâne is built from mosâfer 'traveller', borrowed from Arabic musāfir, and native khâne 'house', usually traced to Middle Persian xānag."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
