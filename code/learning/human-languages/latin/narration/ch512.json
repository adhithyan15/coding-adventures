        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ingrātus, ingrāta, ingrātum",
          "segments": [
            {
              "kind": "speech",
              "text": "ingrātus, ingrāta, ingrātum — \"ungrateful; unpleasant\"."
            },
            {
              "kind": "speech",
              "text": "Fīlius ingrātus parentēs nōn vīsitat. The ungrateful son does not visit his parents."
            },
            {
              "kind": "speech",
              "text": "in- 'not' + grātus. English ingrate."
            }
          ]
        },
