% ============================================================================
% ocean-zone-depth.query.adj — worked recall over the ocean-zone-depth
% library.
% ============================================================================
% The shape a learner (or an LLM) produces to ANSWER "how deep does the
% twilight zone go?" (direct) or "which zone reaches down to 4,000
% meters?" (reverse) — it states no fact of its own — it only `import`s
% the grounded table and asks binding queries. A zone that is not one of
% the three tabled here abstains honestly — the engine never invents a
% depth.
% ============================================================================

import "ocean-zone-depth.adj"

? ocean_zone_depth(twilight_zone, $MaxDepthMeters)  % expect 1000
? ocean_zone_depth($Zone, 4000)                     % reverse bind — expect midnight_zone
? ocean_zone_depth(abyssal_zone, $MaxDepthMeters)   % expect abstain -- a real deeper zone the source names, but not one of the three tabled here
