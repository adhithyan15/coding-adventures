    row (they, primer)
    row (but, primer)
    row (at, primer)
    row (with, primer)
    row (all, primer)
    row (there, primer)
    row (out, primer)
    row (be, primer)
    row (have, primer)
    row (am, primer)
    row (do, primer)
    row (did, primer)
    row (what, primer)
    row (so, primer)
    row (get, primer)
    row (like, primer)
    row (this, primer)
    row (will, primer)
    row (yes, primer)
    row (went, primer)
    row (are, primer)
    row (now, primer)
    row (no, primer)
    row (came, primer)
    row (ride, primer)
    row (into, primer)
    row (good, primer)
