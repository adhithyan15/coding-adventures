    {
      "id": "KA-C103-origin",
      "sequence": 4125,
      "title": "ನೀವು ಎಲ್ಲಿಂದ ಬಂದಿದ್ದೀರಿ? (nīvu ellinda bandiddīri?) — where are you from?",
      "headword": "ನೀವು ಎಲ್ಲಿಂದ ಬಂದಿದ್ದೀರಿ?",
      "romanization": "nīvu ellinda bandiddīri?",
      "gloss": "where are you from? — ask and answer with -ಇಂದ",
      "script": "kannada",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:455b916171dec88a",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Ask ನಿಮ್ಮ ಊರು ಯಾವುದು? Then say city, country and state."
            }
          ]
        },
        {
          "index": 1,
          "type": "grammar",
          "title": "Grammar Lens: -ಇಂದ means “from”",
          "segments": [
            {
              "kind": "speech",
              "text": "Change Chapter 5's ಬೆಂಗಳೂರಿನಲ್ಲಿ (Beṅgaḷūrinalli, “in Bengaluru”):"
            },
            {
              "kind": "speech",
              "text": "ಬೆಂಗಳೂರಿನಿಂದ — Beṅgaḷūrininda — from Bengaluru."
            },
            {
              "kind": "speech",
              "text": "-ಇಂದ (-inda) marks a starting place. ಎಲ್ಲಿ (elli, “where?”) becomes ಎಲ್ಲಿಂದ (ellinda), “from where?”"
            }
          ]
        },
        {
          "index": 2,
          "type": "input",
          "title": "You'll want to know: ask it as one respectful frame",
          "segments": [
            {
              "kind": "speech",
              "text": "ನೀವು ಎಲ್ಲಿಂದ ಬಂದಿದ್ದೀರಿ? nīvu ellinda bandiddīri? — “Where are you from?”"
            },
            {
              "kind": "speech",
              "text": "Keep ಬಂದಿದ್ದೀರಿ (bandiddīri) inside this fixed frame."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "Beṅgaḷūru — Bengaluru; Beṅgaḷūrininda — from Bengaluru",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *Beṅgaḷūru* — Bengaluru; *Beṅgaḷūrininda* — from Bengaluru]"
            },
            {
              "kind": "prompt",
              "action": "ASK",
              "instruction": "ನೀವು ಎಲ್ಲಿಂದ ಬಂದಿದ್ದೀರಿ? (nīvu ellinda bandiddīri?)",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU ASK: **ನೀವು ಎಲ್ಲಿಂದ ಬಂದಿದ್ದೀರಿ?**]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "ask for a home town, then say city, country and state",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: ask for a home town, then say city, country and state]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Ask “Where are you from?” Which ending turns ಎಲ್ಲಿ into “from where”? (-ಇಂದ, “from”.)"
            }
          ]
        }
      ]
    },
