              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Four verbs for taking things in and putting them out, one at a time."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ನೋಡು",
          "segments": [
            {
              "kind": "speech",
              "text": "ನೋಡು (nōḍu) — \"look\"."
            },
            {
              "kind": "speech",
              "text": "Also 'to see' and, in the right sentence, 'to look after'. One stem covering watching, seeing and caring for is common across the Dravidian languages."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more. Three follow, and each reuses the ones before."
            }
          ]
        },
