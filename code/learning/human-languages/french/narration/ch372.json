          "segments": [
            {
              "kind": "speech",
              "text": "hasardeux — \"risky, chancy\"."
            },
            {
              "kind": "speech",
              "text": "C'est un projet hasardeux, mais il veut essayer. It is a risky project, but he wants to try."
            },
            {
              "kind": "speech",
              "text": "Feminine hasardeuse. Formal; in speech, risqué."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "hasardeux is built from an old French word for chance and the suffix -eux. That word is usually traced, through Spanish, to Arabic az-zahr \"the die\"; the details are not settled."
            }
          ]
        },
