          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "قرش (qirsh) is usually traced to the native Arabic root q-r-sh, \"to gather, to scrape together\"."
            }
          ]
        },
