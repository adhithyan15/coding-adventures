          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What is itŭ? (this one — the thing near me.) What sound does it start with, and does that sound mean near, far, or a question? (i- — near.)"
            }
          ]
        }
