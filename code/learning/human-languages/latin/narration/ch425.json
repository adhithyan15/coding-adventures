        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: silex, silicis",
          "segments": [
            {
              "kind": "speech",
              "text": "silex, silicis — \"a flint; a hard paving stone\"."
            },
            {
              "kind": "speech",
              "text": "Haec via ē silice facta est, itaque in pluviā quoque bona est. This road is made of hard stone, so it is good in the rain too."
            },
            {
              "kind": "speech",
              "text": "Third declension, usually masculine: silex, silicis m. Roman roads were paved with blocks of it. English silica and silicon come from it."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "The origin of silex is not settled: Lewis & Short tentatively link it with a root meaning 'firm', as in solidus, and EtymDB gives no parent. EtymDB lists English silica and silicon among the words made from it."
            }
          ]
        },
        {
