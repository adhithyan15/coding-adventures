          "segments": [
            {
              "kind": "speech",
              "text": "le fou rire — \"fit of the giggles\"."
            },
            {
              "kind": "speech",
              "text": "Pendant le cours, nous avons eu un fou rire. During the lesson we got the giggles."
            },
            {
              "kind": "speech",
              "text": "Avoir le fou rire — to be unable to stop laughing."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "le fou rire is \"mad laughter\": fou is inherited from Latin follis \"bellows, a bag of wind\", and rire from Latin rīdēre \"to laugh\" (Lewis & Short)."
            }
          ]
        },
