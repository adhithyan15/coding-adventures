          "segments": [
            {
              "kind": "speech",
              "text": "indagare is a learned borrowing from Latin indāgāre \"to track down\" (Lewis & Short), first said of hunting dogs; EtymDB links it with indāgō \"a ring of hunters\"."
            }
          ]
        },
        {
