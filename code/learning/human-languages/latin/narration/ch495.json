        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: admīrātiō, admīrātiōnis",
          "segments": [
            {
              "kind": "speech",
              "text": "admīrātiō, admīrātiōnis — \"admiration, wonder\"."
            },
            {
              "kind": "speech",
              "text": "Hospitēs templum novum cum admīrātiōne spectant. The guests gaze at the new temple in wonder."
            },
            {
              "kind": "speech",
              "text": "Feminine, third declension, from admīror, already known. English admiration."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "admīrātiō is the action noun of admīror \"to wonder at\", built on ad- and mīror \"to wonder\" (Lewis & Short; EtymDB). English admiration comes from it."
            }
          ]
        },
        {
