        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: das Vorurteil",
          "segments": [
            {
              "kind": "speech",
              "text": "das Vorurteil — \"the prejudice\"."
            },
            {
              "kind": "speech",
              "text": "Er hat viele Vorurteile gegen Menschen aus der Stadt. He has a lot of prejudices against people from the city."
            },
            {
              "kind": "speech",
              "text": "Plural: die Vorurteile. Literally a judgement made beforehand."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Vorurteil joins vor \"before\" to Urteil \"judgement\", from Old High German urteil (EtymDB). It is usually explained as a rendering of Latin praeiūdicium \"a judgement beforehand\" (Lewis & Short)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
