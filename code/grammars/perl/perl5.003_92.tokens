# Perl 5.003_92 (1997-03-06) tokens: plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: this does not lex all Perl 5.003_92 source.
# Evidence: https://github.com/Perl/perl5/blob/perl-5.003_92/toke.c
# Tagged tokenizer changes string interpolation and shebang handling outside
# this subset. Carriage return and leading-zero forms
# remain refused; unsupported Perl syntax is outside this subset.

PRINT     = "print"
INT       = /0|[1-9][0-9]*/
PLUS      = "+"
DECREMENT = "--"
MINUS     = "-"
STAR      = "*"
LPAREN    = "("
RPAREN    = ")"
SEMICOLON = ";"

skip:
  WHITESPACE = /[ \t\n]+/
