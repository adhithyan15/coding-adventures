              "action": "SAY",
              "instruction": "taiyārī",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *taiyārī*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "taiyārī, once more",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *taiyārī*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "agar taiyārī acchī hogī to parīkṣā se ḍar nahīṃ lagegā. — If your preparation is good, you won't be afraid of the exam.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *agar taiyārī acchī hogī to parīkṣā se ḍar nahīṃ lagegā.* — If your preparation is good, you won't be afraid of the exam.]"
