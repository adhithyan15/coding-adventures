          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "einlösen is built from ein 'in' and lösen 'to release', inherited from Proto-Germanic lausijaną, built on lausaz 'loose' (EtymDB): to get back what a pledge held."
            }
          ]
        },
