cabal-version: 3.0
name:          microbenchmark
version:       0.1.0
synopsis:      Paired array microbenchmarks with replayable reports
license:       MIT
author:        Adhithya Rajasekaran
maintainer:    Adhithya Rajasekaran
build-type:    Simple
extra-source-files: testdata/microbenchmark-pairs-v1.json

library
    exposed-modules:  Microbenchmark, ArrayWorkload
    build-depends:    base >=4.14 && <5
                    , array >=0.5
                    , aeson >=2.2 && <3
                    , bytestring >=0.10
                    , containers >=0.6 && <0.9
                    , rank-statistics >=0.1 && <0.2
                    , scientific >=0.3
                    , text >=2.0
                    , vector >=0.13
    hs-source-dirs:   src
    default-language: Haskell2010
    ghc-options:      -Wall

executable array-microbenchmark
    main-is:          Main.hs
    hs-source-dirs:   app
    build-depends:    base >=4.14 && <5
                    , bytestring >=0.10
                    , microbenchmark
    default-language: Haskell2010
    ghc-options:      -Wall -threaded -rtsopts

test-suite spec
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    hs-source-dirs:   test
    build-depends:    base >=4.14 && <5
                    , aeson >=2.2 && <3
                    , array >=0.5
                    , bytestring >=0.10
                    , directory >=1.3
                    , filepath >=1.4
                    , microbenchmark
                    , rank-statistics >=0.1 && <0.2
                    , scientific >=0.3
    default-language: Haskell2010
    ghc-options:      -Wall
