{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coding-adventures.local/fixtures/language-frontends-v1/schema.json",
  "oneOf": [
    {"$ref": "#/$defs/manifest"},
    {"$ref": "#/$defs/corpus"}
  ],
  "$defs": {
    "family": {
      "enum": ["csharp", "excel", "java", "javascript", "lattice", "python", "ruby", "sql", "starlark", "typescript", "verilog", "vhdl"]
    },
    "version": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.]*$", "maxLength": 40},
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "grammars"],
      "properties": {
        "schema_version": {"const": 1},
        "kind": {"const": "grammars"},
        "grammars": {
          "type": "array", "minItems": 24, "maxItems": 256,
          "items": {"$ref": "#/$defs/grammar"}
        }
      }
    },
    "grammar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "version", "kind", "path", "sha256"],
      "properties": {
        "family": {"$ref": "#/$defs/family"},
        "version": {"$ref": "#/$defs/version"},
        "kind": {"enum": ["tokens", "grammar"]},
        "path": {"type": "string", "pattern": "^code/grammars/[a-z]+/[a-z0-9.]+\\.(tokens|grammar)$", "maxLength": 160},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "cases"],
      "properties": {
        "schema_version": {"const": 1},
        "kind": {"const": "cases"},
        "cases": {
          "type": "array", "minItems": 12, "maxItems": 256,
          "items": {"$ref": "#/$defs/case"}
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "family", "version", "source", "outcome", "tokens", "ast"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$", "maxLength": 120},
        "family": {"$ref": "#/$defs/family"},
        "version": {"$ref": "#/$defs/version"},
        "source": {"type": "string", "maxLength": 4096},
        "outcome": {"const": "ok"},
        "tokens": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/token"}},
        "ast": {"$ref": "#/$defs/ast"}
      }
    },
    "token": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "value", "line", "column"],
      "properties": {
        "type": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "maxLength": 128},
        "value": {"type": "string", "maxLength": 4096},
        "line": {"type": "integer", "minimum": 1, "maximum": 4096},
        "column": {"type": "integer", "minimum": 1, "maximum": 4096}
      }
    },
    "ast": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["token"],
          "properties": {"token": {"type": "integer", "minimum": 0, "maximum": 4095}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["rule", "children"],
          "properties": {
            "rule": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "maxLength": 128},
            "children": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/ast"}}
          }
        }
      ]
    }
  }
}
