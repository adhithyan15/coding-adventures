        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: le bénévole",
          "segments": [
            {
              "kind": "speech",
              "text": "le bénévole — \"the volunteer; unpaid, voluntary\"."
            },
            {
              "kind": "speech",
              "text": "Les bénévoles servent des repas aux personnes âgées. The volunteers serve meals to elderly people."
            },
            {
              "kind": "speech",
              "text": "The same form for a man or a woman. As an adjective: un travail bénévole."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "bénévole is a learned borrowing from Latin benevolus \"well-wishing, kind\" (Lewis & Short), built from bene \"well\" and velle \"to want\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
