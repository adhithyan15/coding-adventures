        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ganhar",
          "segments": [
            {
              "kind": "speech",
              "text": "ganhar — \"to earn; to win; to gain\"."
            },
            {
              "kind": "speech",
              "text": "Ela ganha mil e quinhentos euros por mês. She earns one thousand five hundred euros a month."
            },
            {
              "kind": "speech",
              "text": "Ganhar a vida — to earn a living; ganhar um jogo — to win a game."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ganhar is usually traced to a Germanic verb meaning \"to graze, to hunt for food\", through Vulgar Latin wadaniāre (EtymDB); French gagner and Italian guadagnare are its cousins."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
