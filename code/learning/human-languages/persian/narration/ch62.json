          "segments": [
            {
              "kind": "speech",
              "text": "شیرین — shirin — \"sweet\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "shirin is a native Persian word, inherited rather than borrowed: it continues Middle Persian šīrēn, \"sweet\" (EtymDB). It is usually explained as built on šīr, \"milk\"."
            }
          ]
        },
