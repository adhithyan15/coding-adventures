  "lessons": [
    {
      "id": "ES-C340-cerca",
      "sequence": 5920,
      "title": "cerca — near, from the ring drawn around you",
      "headword": "cerca",
      "romanization": "cerca",
      "gloss": "near, nearby — Latin circa, around; English circa, circle, circuit and circus all turn on the same ring",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:e6027c89eade7c23",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Say heat, then age. (El calor; la edad.)"
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know first",
          "segments": [
            {
              "kind": "speech",
              "text": "¿dónde está? — the question this answers."
            },
            {
              "kind": "speech",
              "text": "ahí, allí — the two distances you already have."
            }
          ]
        },
        {
          "index": 2,
          "type": "pronunciation",
          "title": "Sounds you'll need",
          "segments": [
            {
              "kind": "speech",
              "text": "SER-ka, two beats with the weight on the first. The c before e is soft — an s across the Americas. see pronunciation reference."
            }
          ]
        },
        {
          "index": 3,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "cerca — \"near,\" \"nearby.\""
            },
            {
              "kind": "speech",
              "text": "Latin circā meant around, round about — the preposition of a ring drawn about a thing. What lies around you lies close, and Spanish let the word slide from around to near."
            },
            {
              "kind": "speech",
              "text": "English took circa whole and left it in Latin, where it still marks a date given loosely: circa 1500, somewhere in the ring around that year. The same ring is in circle, in a circuit that goes round and comes back, and in the circus, which was a ring long before it was a show."
            },
            {
              "kind": "speech",
              "text": "So when you say cerca, the picture underneath is a circle with you at the centre, and everything inside it counted as near."
            }
          ]
        },
        {
          "index": 4,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "The first of a handful of words for where a thing is."
            }
          ]
        },
        {
          "index": 5,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "cerca",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *cerca*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "muy cerca",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *muy cerca*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "la plaza está cerca",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *la plaza está cerca*]"
            }
          ]
        },
        {
          "index": 6,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What did circā mean? (Around, round about.) And what does English circa still do to a date? (Marks it as roughly that year.)"
            }
          ]
        }
      ]
    },
    {
      "id": "ES-C340-lejos",
      "sequence": 5930,
      "title": "lejos — far, from a rope let out further",
      "headword": "lejos",
      "romanization": "lejos",
      "gloss": "far, far away — Latin laxius, more loosely, from laxus loose; English lax, relax, release and leash come off the same slack rope",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:ce894873871c543b",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Say age, then near. (La edad; cerca.)"
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know first",
          "segments": [
            {
              "kind": "speech",
              "text": "cerca — the other end of this pair."
            }
          ]
        },
        {
          "index": 2,
          "type": "pronunciation",
          "title": "Sounds you'll need",
          "segments": [
            {
              "kind": "speech",
              "text": "LE-hos, the weight on the first beat. The j is the throaty jota, further back than an English h. see pronunciation reference."
            }
          ]
        },
        {
          "index": 3,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "lejos — \"far,\" \"far away.\""
            },
            {
              "kind": "speech",
              "text": "Latin laxus meant loose, slack, not drawn tight — said of a rope, a rein, a bowstring. Its comparative laxius meant more loosely, further apart, and Spanish froze that comparative into a plain adverb of distance."
            },
            {
              "kind": "speech",
              "text": "The slack rope is all over English. Something lax is loose in its discipline. To relax is to let out again. To release is to slacken a hold entirely. Even a leash is the loose length you let a dog run on."
            },
            {
              "kind": "speech",
              "text": "Two words, two pictures: cerca draws a ring and stays inside it; lejos pays the rope out until you are past the far end."
            }
          ]
        },
        {
          "index": 4,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "A pair now: cerca and lejos, the two answers to how far."
            }
          ]
        },
        {
          "index": 5,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "lejos",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *lejos*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "muy lejos",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *muy lejos*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "la casa está lejos",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *la casa está lejos*]"
            }
          ]
        },
        {
          "index": 6,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What did laxus mean? (Loose, slack.) And which English verb means to let that slack out again? (Relax.)"
            }
          ]
        }
      ]
    },
    {
      "id": "ES-C340-derecha",
      "sequence": 5940,
      "title": "la derecha — the right hand, from the line that goes straight",
      "headword": "la derecha",
      "romanization": "la derecha",
      "gloss": "the right, the right-hand side — Latin directus, straightened, from dirigere to set straight; English direct, direction, erect and address share it",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:7b61e5581b906ea4",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Say near, then far. (Cerca; lejos.)"
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know first",
          "segments": [
            {
              "kind": "speech",
              "text": "el camino — what you will be sending somebody along."
            },
            {
              "kind": "speech",
              "text": "la esquina — where the turn happens."
            }
          ]
        },
        {
          "index": 2,
          "type": "pronunciation",
          "title": "Sounds you'll need",
          "segments": [
            {
              "kind": "speech",
              "text": "de-RE-cha, three beats with the weight on the middle. The ch is one sound, as in English church. see pronunciation reference."
            }
          ]
        },
        {
          "index": 3,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "la derecha — \"the right,\" the right-hand side."
            },
            {
              "kind": "speech",
              "text": "Latin dīrigere meant to set straight, to line up — dis- apart plus regere, to rule or guide. Its past participle dīrectus meant straightened, and that is the word underneath derecha."
            },
            {
              "kind": "speech",
              "text": "Most languages name the right hand for what it does well, and Latin thought of it as the hand that goes straight to the mark. The left got the leftovers."
            },
            {
              "kind": "speech",
              "text": "The straightening is loud in English. Something direct goes the straight way. A direction is the straight line you are pointed along. Something erect has been straightened upright. And to address a letter is to set it straight toward somebody."
            },
            {
              "kind": "speech",
              "text": "Spanish keeps both jobs: a la derecha is to the right, and derecho on its own is straight ahead — the older meaning, still working."
            }
          ]
        },
        {
          "index": 4,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "Now you can send somebody one way at the corner."
            }
          ]
        },
        {
          "index": 5,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "la derecha",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *la derecha*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "a la derecha",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *a la derecha*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "la calle está a la derecha",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *la calle está a la derecha*]"
            }
          ]
        },
        {
          "index": 6,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What did dīrectus mean? (Straightened, set straight.) And what does derecho mean when it stands alone? (Straight ahead.)"
            }
          ]
        }
      ]
    },
    {
      "id": "ES-C340-izquierda",
      "sequence": 5950,
      "title": "la izquierda — the left hand, the word that is older than Rome",
      "headword": "la izquierda",
      "romanization": "la izquierda",
      "gloss": "the left, the left-hand side — Basque ezkerra, one of the few pre-Roman words in Spanish; it drove out Latin sinistra, which English kept as sinister",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:fb92783f10001749",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Say far, then the right. (Lejos; la derecha.)"
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know first",
          "segments": [
            {
              "kind": "speech",
              "text": "la derecha — the side this one answers."
            }
          ]
        },
        {
          "index": 2,
          "type": "pronunciation",
          "title": "Sounds you'll need",
          "segments": [
            {
              "kind": "speech",
              "text": "is-KYER-da, the weight on the second beat. The z is an s across the Americas, and -quie- is one gliding syllable. see pronunciation reference."
            }
          ]
        },
        {
          "index": 3,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "la izquierda — \"the left,\" the left-hand side."
            },
            {
              "kind": "speech",
              "text": "Nearly every Spanish word you have met came from Latin. This one did not."
            },
            {
              "kind": "speech",
              "text": "Izquierda is ezkerra, from Basque — a language already old in the peninsula when the Romans arrived, related to nothing else alive. A few Basque words survived the whole Roman centuries and are still in daily Spanish, and this is the best known of them."
            },
            {
              "kind": "speech",
              "text": "What it pushed aside was Latin sinistra, the ordinary Latin word for left. Latin had long treated the left as the unlucky side, and sinistra carried so much of that dread that Spanish quietly replaced it with a neutral borrowed word."
            },
            {
              "kind": "speech",
              "text": "English went the other way and kept the discarded one. Sinister in English means threatening or evil, which is what Latin had already made of left — so Spanish and English ended up with opposite halves of the same old quarrel: Spanish took the plain Basque word, English took the dark Latin one."
            },
            {
              "kind": "speech",
              "text": "A la izquierda is to the left."
            }
          ]
        },
        {
          "index": 4,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "Both hands now, and one word in your Spanish older than Rome."
            }
          ]
        },
        {
          "index": 5,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "la izquierda",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *la izquierda*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "a la izquierda",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *a la izquierda*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "a la derecha o a la izquierda",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *a la derecha o a la izquierda*]"
            }
          ]
        },
        {
          "index": 6,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Which language did izquierda come from? (Basque.) And which Latin word did it push out, that English kept? (Sinistra — English sinister.)"
            }
          ]
        }
      ]
    },
    {
      "id": "ES-C340-enfrente",
      "sequence": 5960,
      "title": "enfrente — opposite, standing forehead to forehead",
      "headword": "enfrente",
      "romanization": "enfrente",
      "gloss": "opposite, across from, facing — Latin frontem, the forehead; English front, frontier, affront, confront and effrontery all come off the same brow",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:4e84afee96360255",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Say the right, then the left. (La derecha; la izquierda.)"
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know first",
          "segments": [
            {
              "kind": "speech",
              "text": "cerca — one of the distances this refines."
            },
            {
              "kind": "speech",
              "text": "la calle — what you will be crossing."
            }
          ]
        },
        {
          "index": 2,
          "type": "pronunciation",
          "title": "Sounds you'll need",
          "segments": [
            {
              "kind": "speech",
              "text": "en-FREN-te, the weight on the middle beat. Both e sounds are short and even, never sliding the way an English e does. see pronunciation reference."
            }
          ]
        },
        {
          "index": 3,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "enfrente — \"opposite,\" \"across from,\" \"facing.\""
            },
            {
              "kind": "speech",
              "text": "It is two pieces you can see: en plus frente."
            },
            {
              "kind": "speech",
              "text": "Frente is Latin frontem, from frōns — and the Latin word meant the forehead. The forehead is the part of you that goes first, the flat face you present to whatever is coming, so frons widened to mean the front of anything at all."
            },
            {
              "kind": "speech",
              "text": "English is full of that brow. The front of a building is its forehead. A frontier is the forehead of a country, the part that faces outward. To confront somebody is to bring foreheads together. An affront is a blow struck at the forehead, which is why it means an insult. And effrontery is behaving as though you had no forehead left to blush with."
            },
            {
              "kind": "speech",
              "text": "So enfrente is not merely near. It is the thing whose forehead is turned toward yours — across the street, facing you."
            }
          ]
        },
        {
          "index": 4,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "Five words for where a thing is: cerca, lejos, la derecha, la izquierda, enfrente. Enough to place almost anything."
            }
          ]
        },
        {
          "index": 5,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "enfrente",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *enfrente*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "enfrente de la casa",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *enfrente de la casa*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "está enfrente, muy cerca",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *está enfrente, muy cerca*]"
            }
          ]
        },
        {
          "index": 6,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What did frontem mean in Latin? (The forehead.) And what is an affront, word for word? (A blow at the forehead.)"
            }
          ]
        }
      ]
    }
  ],
