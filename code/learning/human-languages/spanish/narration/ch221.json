                "no",
                "no, este replaces the article"
              ],
              "feedback": {
                "correct": "One word per job.",
                "incorrect": "No. Este takes the article's place."
              }
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Where does este stand, and what does it push out? (Before the noun, in the article's place.)"
            },
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "And who did Latin's iste originally point at? (You — the person being spoken to. Spanish moved it closer.)"
            }
          ]
        }
      ]
    }
  ],
