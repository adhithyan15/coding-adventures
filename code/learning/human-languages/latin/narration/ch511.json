          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "mānsuētus is the participle of mānsuēscō \"to grow tame\", built on manus \"hand\" and suēscō \"to become used to\" (Lewis & Short): used to the hand."
            }
          ]
        },
