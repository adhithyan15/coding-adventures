      "sequence": 4490,
      "title": "la tía --- a third word for the same relative",
      "headword": "la tía",
      "romanization": "la tía",
      "gloss": "the aunt --- the same Greek root feminine; English aunt comes from a wholly different Latin word, amita",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:13ef896d878b5583",
      "notice": null,
      "blocks": [
        {
