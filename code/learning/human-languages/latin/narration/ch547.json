          "segments": [
            {
              "kind": "speech",
              "text": "figūra is built on fingō \"to shape, mould\" (Lewis & Short); EtymDB traces fingō to a Proto-Indo-European root meaning \"to knead, shape\". English figure comes from it."
            }
          ]
        },
