          "segments": [
            {
              "kind": "speech",
              "text": "lūsus, lūsūs — \"play, a game\"."
            },
            {
              "kind": "speech",
              "text": "Lūsus puerōrum in viā clāmōsus est. The children's play in the street is noisy."
            },
            {
              "kind": "speech",
              "text": "Masculine, fourth declension, from lūdō — to play."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "lūsus is the action noun of lūdō \"to play\" (Lewis & Short; EtymDB). English illusion comes from the family, through illūdō \"to mock\"."
            }
          ]
        },
