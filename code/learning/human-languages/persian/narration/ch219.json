          "segments": [
            {
              "kind": "speech",
              "text": "توقف کردن — tavaqqof kardan — \"to stop, to halt\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "tavaqqof kardan pairs tavaqqof, borrowed from Arabic tawaqquf, \"stopping, pausing\" (root w-q-f, Lane), with the Persian verb kardan, \"to do, to make\". kardan, \"to do\", is an inherited verb, from Middle Persian kardan (EtymDB)."
            }
          ]
        },
