            },
            {
              "kind": "speech",
              "text": "Der Maler stellt eine neue Leinwand auf. The painter sets up a new canvas."
            },
            {
              "kind": "speech",
              "text": "Plural: die Leinwände. Also a cinema screen."
            }
          ]
        },
