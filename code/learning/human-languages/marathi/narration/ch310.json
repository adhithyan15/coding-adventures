          "segments": [
            {
              "kind": "speech",
              "text": "दैनिक — dainik — \"a daily paper; daily\"."
            },
            {
              "kind": "speech",
              "text": "माझे बाबा रोज दोन दैनिकं वाचतात. mājhe bābā roj don dainikaṁ vāctāt. My father reads two daily papers every day."
            },
            {
              "kind": "speech",
              "text": "Neuter."
            },
            {
              "kind": "speech",
              "text": "Neuter as a noun, plural दैनिकं; as an adjective: दैनिक (dainik) काम, daily work."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "दैनिक (dainik) is a tatsama, taken from Sanskrit dainika, 'daily' (Monier-Williams), built on dina, 'a day'."
            }
          ]
        },
