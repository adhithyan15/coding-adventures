          "title": "You'll want to know: заранее",
          "segments": [
            {
              "kind": "speech",
              "text": "заранее (zaráneye) — \"in advance, beforehand\"."
            },
            {
              "kind": "speech",
              "text": "Мы купили билеты заранее. My kupíli biléty zaráneye. We bought the tickets in advance."
            },
            {
              "kind": "speech",
              "text": "Заранее спасибо — thanks in advance."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "заранее (zaráneye) is built on за- and ранний \"early\", the adjective of рано, which is inherited from Proto-Slavic ranŭ \"early\" (EtymDB)."
            }
          ]
        },
