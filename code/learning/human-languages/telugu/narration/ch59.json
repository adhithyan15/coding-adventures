    {
      "id": "TE-C59-fire",
      "sequence": 1820,
      "title": "నిప్పు (nippu) — fire, a live coal",
      "headword": "నిప్పు",
      "romanization": "nippu",
      "gloss": "fire, a live coal",
      "script": "telugu",
