        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: vorheizen",
          "segments": [
            {
              "kind": "speech",
              "text": "vorheizen — \"to preheat\"."
            },
            {
              "kind": "speech",
              "text": "Er heizte den Ofen auf hundertachtzig Grad vor. He preheated the oven to a hundred and eighty degrees."
            },
            {
              "kind": "speech",
              "text": "Separable: er heizt vor, er hat vorgeheizt."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "vorheizen is built on heizen \"to heat\", from Old High German heizen, Proto-Germanic haitijaną \"to make hot\" (EtymDB), with vor \"before\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
