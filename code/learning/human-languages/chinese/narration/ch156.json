              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say kuài, yuan, as said — R3, durable",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *kuài*, yuan, as said — **R3**, durable]"
