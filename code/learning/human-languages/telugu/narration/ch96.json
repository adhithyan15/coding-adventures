          "segments": [
            {
              "kind": "speech",
              "text": "ముద్దుపేరు (muddupēru) — \"a nickname, a pet name\"."
            },
            {
              "kind": "speech",
              "text": "ముద్దు is \"a kiss, affection\", so a nickname is an affection name: the one family uses."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ముద్దుపేరు (muddupēru) is native Dravidian: muddu, \"kiss\", one word with Tamil muttu (DEDR 4960), and pēru, \"name\" (DEDR 4410). DEDR compares Prakrit muddī, \"kiss\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "The name the family uses."
