            {
              "kind": "speech",
              "text": "Before the new one: say the Persian for broken, then the Persian for different."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: بهتر",
          "segments": [
            {
              "kind": "speech",
              "text": "بهتر — behtar — \"better\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "behtar is beh, \"good\", with the comparative ending -tar. beh is native, usually traced to Middle Persian weh. English better only looks alike: it is a Germanic word, and no source links it to beh."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
