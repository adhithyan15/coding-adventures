      "sequence": 570,
      "title": "せ — close the opener",
      "headword": "せ",
      "romanization": "se",
      "gloss": "the hiragana sign for the mora se",
      "script": "japanese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
