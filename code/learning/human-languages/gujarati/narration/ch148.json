              "action": "SAY",
              "instruction": "mẽ bhāt khādho",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *mẽ bhāt khādho*]"
            },
            {
              "kind": "prompt",
