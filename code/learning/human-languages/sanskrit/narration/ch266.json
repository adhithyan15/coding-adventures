      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Say “a film,” then “I will go.” (Citrapaṭaḥ; gamiṣyāmi.)"
            }
          ]
        },
        {
          "index": 1,
          "type": "guided-production",
          "title": "Guided Practice: independent round two",
          "segments": [
            {
              "kind": "speech",
              "text": "No Sanskrit model is shown before you answer."
            },
            {
              "kind": "pause",
              "seconds": 12,
              "perItem": false,
              "source": "[PAUSE 12s]"
            },
            {
              "kind": "speech",
              "text": "Choose a shop or market and a different familiar item. Say that you buy it. Ask its price. The shopkeeper says that the price is twenty rupees. Request the item politely and close with thanks."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built: check after speaking",
          "segments": [
            {
              "kind": "speech",
              "text": "A complete answer still has five jobs: say what you buy; ask the price; hear the rupee amount; request the item; thank the shopkeeper. Your chosen item may differ from the first round."
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall: boundary",
          "segments": [
            {
              "kind": "speech",
              "text": "You can now complete one small A1 market exchange with familiar language. This is not complete commerce, currency, bargaining, consumer-rights, or present paradigm coverage, and it is not evidence of exam readiness or learner success."
            }
          ]
        }
      ]
