# Each line runs as its own `cmd /C`, so no sh syntax. The perl on PATH is the
# one prove loads the extension into, so it is the one asked for $Config{dlext}.
cargo build --release
perl -MConfig -MFile::Path=make_path -MFile::Copy=copy -e "make_path('lib/auto/CodingAdventures/IrcServerNative'); copy('target/release/IrcServerNative.dll', 'lib/auto/CodingAdventures/IrcServerNative/IrcServerNative.' . $Config{dlext}) or die qq{cannot stage IrcServerNative.dll: $!\n}"
prove -I"%CD%\lib" -v t/
