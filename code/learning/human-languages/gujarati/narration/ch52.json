        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: કાકા",
          "segments": [
            {
              "kind": "speech",
              "text": "કાકા (kākā) — \"uncle (father's brother)\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "કાકા (kākā) goes back to kākka, \"senior male relative\", a form CDIAL reconstructs and takes from Dravidian, comparing Kannada kakka, \"uncle\" (CDIAL 2998)."
            }
          ]
        },
