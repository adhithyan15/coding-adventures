    {
      "id": "ES-C307-esposa",
      "sequence": 4470,
      "title": "la esposa --- the pledge that binds",
      "headword": "la esposa",
      "romanization": "la esposa",
      "gloss": "the wife --- the same spondere pledge, feminine; and the reason handcuffs are called esposas",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:468a2d723c025a75",
      "notice": null,
      "blocks": [
