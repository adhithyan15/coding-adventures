      "id": "ES-C15-tener-preterite",
      "sequence": 1320,
      "title": "tuve — let the strong stem carry the stress",
      "headword": "tuve",
      "romanization": "tuve",
      "gloss": "the strong singular preterite of tener — tuve, tuviste, tuvo",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
