# needs-toolchain: lua
# Same steps as the Unix BUILD (every line is plain cmd syntax).  On Windows the
# smoke module is a DLL that must resolve lua_* at link time, so build.rs links
# lua54.lib, found next to the lua.exe on PATH (CI installs Lua with
# scripts/setup_lua.py, which puts it in <prefix>\lib beside <prefix>\bin\lua.exe);
# `lua tests/smoke.lua` then loads target\release\examples\lua_bridge_smoke.dll.
cargo test -p lua-bridge
cargo build --release -p lua-bridge
cargo clippy -p lua-bridge --all-targets -- -D warnings
cargo build --release -p lua-bridge --example lua_bridge_smoke --target-dir target
lua tests/smoke.lua target/release/examples
