          "title": "You'll want to know: la solución",
          "segments": [
            {
              "kind": "speech",
              "text": "la solución — \"the solution\"."
            },
            {
              "kind": "speech",
              "text": "Tenemos que buscar una solución. We have to look for a solution."
            },
            {
              "kind": "speech",
              "text": "No tiene solución — it cannot be fixed."
