            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Latin for country manners, then the Latin for generosity."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: superbia, superbiae",
          "segments": [
            {
              "kind": "speech",
              "text": "superbia, superbiae — \"pride, haughtiness\"."
            },
            {
              "kind": "speech",
              "text": "Superbia rēgis cīvēs vexat. The king's arrogance troubles the citizens."
            },
            {
              "kind": "speech",
              "text": "Feminine, first declension, from superbus. Usually a fault in Latin, not a virtue."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "superbia is built on superbus \"proud\", which Lewis & Short and EtymDB take from super \"above\": one who holds himself above others."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
