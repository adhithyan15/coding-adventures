          "segments": [
            {
              "kind": "speech",
              "text": "спальник (spálnik) is a colloquial short form of спальный мешок 'a sleeping bag', from спать 'to sleep', which is inherited from Proto-Slavic sŭpati (EtymDB)."
            }
          ]
        },
