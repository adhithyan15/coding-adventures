        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: de pronto",
          "segments": [
            {
              "kind": "speech",
              "text": "de pronto — \"suddenly\"."
            },
            {
              "kind": "speech",
              "text": "De pronto se apagaron las luces. Suddenly the lights went out."
            },
            {
              "kind": "speech",
              "text": "The same as de repente."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "de pronto is built on pronto, which comes from Latin promptus 'brought forth, ready' (EtymDB). De pronto is the moment something is ready to happen and happens."
            }
          ]
        },
        {
