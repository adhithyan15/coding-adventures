          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "naufragus joins nāvis, \"ship\", and frangō, \"to break\" (EtymDB): one whose ship is broken."
