      "sourceHash": "fnv1a64:543ba16b7afc4d71",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Script — the shape"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now — leave the section called Script — the shape until you have stopped, and I will say so again when we reach it."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 40,
              "perItem": false,
              "source": "[PAUSE 40s]"
            },
            {
              "kind": "speech",
              "text": "Ask for one repetition. Then hear the farewell in your mind, say it, read さようなら, and write its final ら. Write known す, み, ま, ん separately. Only the fourth sign of sumimasen is still missing."
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — the shape",
          "segments": [
            {
              "kind": "speech",
              "text": "せ — se."
            },
            {
              "kind": "speech",
              "text": "Three strokes: a short horizontal, a longer crossing horizontal with a small hook, then a vertical curve through the right side. Keep the two horizontals separate."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "speech",
              "text": "Copy せ (se) once."
            },
            {
              "kind": "speech",
              "text": "Hide it and write it after ten seconds."
            },
            {
              "kind": "speech",
              "text": "Join the five known blocks: す | み | ま | せ (se) | ん."
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "speech",
              "text": "Read すみません once without romanization."
            },
            {
              "kind": "speech",
              "text": "Source: Unicode Hiragana chart; stroke order per Hitsujun Shido no Tebiki (Japanese Ministry of Education, 1958)."
            },
            {
              "kind": "activity",
              "scored": true,
              "id": "JA-W10-se-write",
              "prompt": "Write the hiragana sign for se.",
              "assesses": [
                "JA-SCRIPT-SE-01"
              ],
              "responseSeconds": 10,
              "acceptedResponses": [
                "せ",
                "hiragana se"
              ],
              "feedback": {
                "correct": "Right: せ closes the fourth mora of すみません.",
                "incorrect": "Write せ: two horizontals, then the right-side curve."
              }
            }
          ]
        }
      ]
    },
