          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "painel came from Old French panel, from Vulgar Latin pannellus, a small form of Latin pannus 'piece of cloth' (EtymDB)."
            }
          ]
        },
