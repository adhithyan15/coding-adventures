        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: die Sammlung",
          "segments": [
            {
              "kind": "speech",
              "text": "die Sammlung — \"collection\"."
            },
            {
              "kind": "speech",
              "text": "Mein Opa hat eine große Sammlung von alten Briefmarken. My grandpa has a big collection of old stamps."
            },
            {
              "kind": "speech",
              "text": "Plural: die Sammlungen."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Sammlung is built on sammeln \"to collect\" with -ung (EtymDB); sammeln is inherited from Middle High German sameln."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
