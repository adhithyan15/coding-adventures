        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "The origin of છોડ (choḍ), \"plant\", is not settled: CDIAL lists no Gujarati form like it among its words for plants."
            }
          ]
        },
