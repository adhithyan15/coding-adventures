# Perl 5.004_04-m4 (1998-05-19) plain-decimal arithmetic-print subset.
# @version 1
# PARTIAL: unsupported Perl 5.004_04-m4 syntax is rejected.
# Evidence: https://mirrors.develooper.com/perl/historical-perl/perl-5.004_04-m4.tar.gz
# Archive SHA-256: 8e883ceed74188b2cf69a8cb6247f80e8e8178c8904b9e1591c0342e20148241
# Threading, filter, and quoted-curly changes are outside this subset.
# Comment-stripped scan_num is unchanged from 5.004_04, including its 250-digit bound.
# Unsupported characters, carriage returns, and leading-zero forms remain refused.

PRINT     = "print"
INT       = /0|[1-9][0-9]{0,249}/
PLUS      = "+"
DECREMENT = "--"
MINUS     = "-"
STAR      = "*"
LPAREN    = "("
RPAREN    = ")"
SEMICOLON = ";"

skip:
  WHITESPACE = /[ \t\n]+/
