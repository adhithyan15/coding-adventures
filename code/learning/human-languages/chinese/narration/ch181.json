    {
      "id": "ZH-W181-jian-room",
      "sequence": 14205,
      "title": "间 (jiān) — 门 with 日 inside",
      "headword": "间",
      "romanization": "jiān",
      "gloss": "间 — 门, then 日 inside it",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:0af66972eab98b10",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — 门 with 日 inside",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — 门 with 日 inside and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say jiān — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *jiān* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "门 时."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — mén, shí",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *mén*, *shí*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — 门 with 日 inside",
          "segments": [
            {
              "kind": "speech",
              "text": "间 (jiān)."
            },
            {
              "kind": "speech",
              "text": "Two pieces, the frame first. Count the pieces, not the strokes."
            },
            {
              "kind": "speech",
              "text": "门, three strokes, as you write it: a dot, a vertical down the left, and a horizontal that turns down the right side and hooks."
            },
            {
              "kind": "speech",
              "text": "Then 日 inside it, four strokes, as you write it, but smaller: a vertical, a horizontal that turns down, a bar across the middle, and the bottom bar."
            },
            {
              "kind": "speech",
              "text": "3 + 4 = seven."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "间 (jiān), all seven, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 间, all seven, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many strokes in 间 (jiān)? (Seven.) Which piece comes first? (门, the frame.) What sits inside? (日.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 间 (jiān), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
