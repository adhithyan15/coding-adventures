<!-- MainWindow.xaml — hand-written WinUI 3 host shell that mounts
     the auto-generated FormulaBar above a hand-written grid. -->
<Window
    x:Class="Mosaic.Generated.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:gen="using:Mosaic.Generated"
    Title="VisiCalc — Mosaic XAML demo">

    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header label. -->
        <TextBlock Grid.Row="0" Margin="16,16,16,8"
                   Text="VISICALC · MOSAIC XAML DEMO"
                   Foreground="#9D9D9D"
                   FontSize="11"
                   CharacterSpacing="100"/>

        <!-- FormulaBar — auto-generated by mosaic-compile. -->
        <gen:FormulaBar Grid.Row="1" x:Name="FormulaBarControl"/>

        <!-- Grid — HAND-WRITTEN placeholder (XAML emitter doesn't yet
             know the Grid built-in primitive). 5×5 sample matching
             Grid.dark.msl palette and the other VC2-* demos. -->
        <ScrollViewer Grid.Row="2" Margin="16">
            <Grid x:Name="SheetGrid" Background="#1E1E1E"
                  BorderBrush="#3F3F46" BorderThickness="1">
                <!-- Build the 5×5 + header rows programmatically in
                     MainWindow.xaml.cs so the markup stays compact. -->
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
