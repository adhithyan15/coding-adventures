          "segments": [
            {
              "kind": "speech",
              "text": "le verglas — \"the black ice\"."
            },
            {
              "kind": "speech",
              "text": "Avec le verglas, les voitures roulent très lentement. Because of the black ice, cars are going very slowly."
            },
            {
              "kind": "speech",
              "text": "Une route verglacée — an icy road."
            }
          ]
        },
