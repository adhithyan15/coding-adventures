          "title": "You'll want to know: durare",
          "segments": [
            {
              "kind": "speech",
              "text": "durare — \"to last\"."
            },
            {
              "kind": "speech",
              "text": "Il film è durato tre ore. The film lasted three hours."
            },
            {
              "kind": "speech",
              "text": "In the passato prossimo, è durato is the usual form; ha durato is also heard."
            }
          ]
        },
