          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "interpeller is a learned borrowing from Latin interpellāre \"to interrupt, to address\" (EtymDB)."
            }
          ]
        },
