        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: afirmar",
          "segments": [
            {
              "kind": "speech",
              "text": "afirmar — \"to state, to say that something is so\"."
            },
            {
              "kind": "speech",
              "text": "El director afirma que no hay problema. The director states that there is no problem."
            },
            {
              "kind": "speech",
              "text": "More formal than decir; news reports use it a lot."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "afirmar from Latin affirmare, \"to make firm, to assert\" (EtymDB 2.1), built on firmus, \"firm\" — the firmus inside firmar, \"to sign\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
