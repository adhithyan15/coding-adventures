              "id": "ES-C62-estoy-hablando-which",
              "prompt": "Which of the two words changes for different people?",
              "assesses": [
                "ES-GRAMMAR-PROGRESSIVE-ESTAR-GERUND"
              ],
              "responseSeconds": 13,
              "acceptedResponses": [
                "estar",
                "estar, the gerund never changes"
              ],
              "feedback": {
                "correct": "One verb, one fixed ending.",
                "incorrect": "Estar. The gerund is the same for everybody."
              }
            },
            {
