        "waitUntilStopped": [],
        "text": "Before we start: this one needs your eyes, so it is not fully a driving lesson. You will want your eyes, because the lesson points at something written down. You can listen to all of it now and come back to the parts that need looking at once you have stopped."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 16,
              "perItem": false,
              "source": "[PAUSE 16s]"
            },
            {
              "kind": "speech",
              "text": "Say mā̃ from its meaning. Write म, ा, and ं; then write ि and say the known question word kāĩ."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know",
          "segments": [
            {
              "kind": "speech",
              "text": "म + ा + ं becomes मां — mā̃ — mother."
            },
            {
              "kind": "speech",
              "text": "Nothing on the page is new. Join three earned units and read the complete word."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "speech",
              "text": "Look at मां (mā̃) for five seconds. Cover it, wait five seconds, then write the word once. Uncover and compare the long-vowel sign and nasal mark separately."
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "speech",
              "text": "Read and write मां (mā̃) once without romanization."
            },
            {
              "kind": "speech",
              "text": "Source: Marwari Pathshala, Lesson 4."
            },
            {
              "kind": "activity",
              "scored": true,
              "id": "MW-C08-maa-dictation",
              "prompt": "From the spoken cue mā̃, write the taught word and give its meaning.",
              "assesses": [
                "MW-LEX-MAA-01",
                "MW-SCRIPT-MAA-01"
              ],
              "responseSeconds": 15,
              "acceptedResponses": [
                "मां — mother",
                "मां",
                "मां mother"
              ],
              "feedback": {
                "correct": "Right: known signs now carry मां.",
                "incorrect": "Repair one unit at a time: म + ा + ं = मां."
              }
            }
          ]
        }
      ]
