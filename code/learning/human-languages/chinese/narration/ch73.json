              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many strokes in 下 (xià)? (Three.) Which character you know is it turned over? (上.) Where does the dot go? (To the right of the vertical.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 下 (xià), pinned stroke paths and medians."
