        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: conqueror, conquerī",
          "segments": [
            {
              "kind": "speech",
              "text": "conqueror, conquerī — \"to complain (loudly), to complain of\"."
            },
            {
              "kind": "speech",
              "text": "Viātor dē cīmicibus et dē pretiō conqueritur. The traveller complains about the bedbugs and about the price."
            },
            {
              "kind": "speech",
              "text": "Deponent: conqueror, conquerī, conquestus sum. English conquer does not come from it; that word goes back to conquīrere 'to seek out'."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "conqueror is built from con-, which strengthens, and queror 'to complain' (EtymDB; Lewis & Short). English conquer looks like it but comes from a different verb, conquīrere 'to seek out'."
            }
          ]
        },
