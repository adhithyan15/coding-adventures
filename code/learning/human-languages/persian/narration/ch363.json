          "segments": [
            {
              "kind": "speech",
              "text": "ادعا کردن (edde'â kardan) — \"to claim\"."
            },
            {
              "kind": "speech",
              "text": "او ادعا میکند که آن مرد را دیده است. u edde'â mikonad ke ân mard râ dide ast. He claims that he has seen that man."
            },
            {
              "kind": "speech",
              "text": "Edde'â \"a claim\" + kardan (stem kon-), followed by ke and a clause."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ادعا کردن (edde'â kardan) joins edde'â, usually traced to Arabic iddi'ā' \"a claim\", to the inherited Persian verb kardan \"to do\"."
            }
          ]
        },
