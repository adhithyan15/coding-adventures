  "chapter": 19,
  "title": "Reading — Words, Greetings, and the Cues You Have Only Heard",
  "drivablePrefix": 0,
  "sourceHash": "fnv1a64:c95a4b0cf6589563",
  "lessons": [
    {
      "id": "JA-C19-words",
      "sequence": 1580,
      "title": "(reading) (te, mimi, kuchi, hana, kao, me) (wakarimashita, wakarimasen, mō ichido, onegaishimasu) (hai, iie, konnichiwa, arigatō, sayōnara, sumimasen) — six words, nothing said first",
      "headword": "(reading)",
      "romanization": "te, mimi, kuchi, hana, kao, me",
      "gloss": "six words read cold — every sign in them is one you can already write",
      "script": "japanese",
      "modality": "sight",
      "derivedModality": "sight",
      "modalityReasons": [
        "sight-cue"
      ],
      "sourceHash": "fnv1a64:245106cef633a0ed",
      "notice": {
        "modality": "sight",
        "needs": [
          "your eyes, because the lesson points at something written down"
        ],
        "waitUntilStopped": [],
        "text": "Before we start: this one needs your eyes, so it is not fully a driving lesson. You will want your eyes, because the lesson points at something written down. You can listen to all of it now and come back to the parts that need looking at once you have stopped."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "You have written every sign in every one of these. Not one word is new."
            },
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "speech",
              "text": "What is new is that nobody says them before you read them."
            }
          ]
        },
        {
          "index": 1,
          "type": "comprehension",
          "title": "Reading",
          "segments": [
            {
              "kind": "speech",
              "text": "て みみ くち はな かお め."
            },
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Read down the list once. Do not sound out each sign — look at the whole word and let it arrive."
            },
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Again, and notice which came at once and which you had to build. Both are fine. The difference is what practice removes."
            }
          ]
        },
        {
          "index": 2,
          "type": "input",
          "title": "You'll want to know",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Two of these are one sign long. て and め are whole words, and you have written both as signs on their own."
            },
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "That is worth noticing, because it is the thing hiragana does that an alphabet does not: a sign can be a letter and a word at the same time, and nothing on the page tells you which it is. Only knowing the word does."
            },
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Six is enough for one sitting."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "the six words down the list, once, without stopping",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: the six words down the list, once, without stopping]"
            },
            {
              "kind": "repeat",
              "times": 2,
              "source": "[REPEAT x2]"
            },
            {
              "kind": "activity",
              "scored": true,
              "id": "JA-C19-words-eye",
              "prompt": "Which of the six is one sign long and means eye?",
              "assesses": [
                "JA-SKILL-READ-WORDS"
              ],
              "responseSeconds": 12,
              "acceptedResponses": [
                "me",
                "め"
              ],
              "feedback": {
                "correct": "め.",
                "incorrect": "め -- eye."
              }
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "How many of the six were new? (None.)"
            },
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "What was new? (Nobody said them first. You read them.)"
            }
          ]
        }
      ]
    },
    {
      "id": "JA-C19-greetings",
      "sequence": 1590,
      "title": "(reading) (te, mimi, kuchi, hana, kao, me) (wakarimashita, wakarimasen, mō ichido, onegaishimasu) (hai, iie, konnichiwa, arigatō, sayōnara, sumimasen) — the doorway words, on the page",
      "headword": "(reading)",
      "romanization": "hai, iie, konnichiwa, arigatō, sayōnara, sumimasen",
      "gloss": "six greetings on the page — the doorway words, met without a voice",
      "script": "japanese",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:2c78e3420d894721",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The last lesson gave you six words. These are the six the book opened with."
            },
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "speech",
              "text": "Every one of them reached your ear before it reached a page. Today that order is reversed."
            }
          ]
        },
        {
          "index": 1,
          "type": "comprehension",
          "title": "Reading",
          "segments": [
            {
              "kind": "speech",
              "text": "はい いいえ こんにちは ありがとう さようなら すみません."
            },
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Read down once, without stopping."
            },
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Again — and notice that the two longest are the two you say most often. Length is not difficulty here; familiarity is."
            }
          ]
        },
        {
          "index": 2,
          "type": "input",
          "title": "You'll want to know",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "こんにちは ends in は, and you know that sign says ha. In this word it is read wa, because the greeting keeps a spelling from an older sentence that nobody finishes any more."
            },
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "You do not need the history to read it. You need to know that this one word is spelled the way it is for a reason, and that reading a language means meeting a handful of such words rather than a rule you can apply."
            },
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Six lines, and one of them is a small piece of history."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "the six lines, once, without stopping",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: the six lines, once, without stopping]"
            },
            {
              "kind": "repeat",
              "times": 2,
              "source": "[REPEAT x2]"
            },
            {
              "kind": "activity",
              "scored": true,
              "id": "JA-C19-greetings-thanks",
              "prompt": "Which line thanks somebody?",
              "assesses": [
                "JA-SKILL-READ-GREETINGS"
              ],
              "responseSeconds": 13,
              "acceptedResponses": [
                "arigatou",
                "ありがとう",
                "arigatō",
                "thank you"
              ],
              "feedback": {
                "correct": "ありがとう.",
                "incorrect": "ありがとう -- thank you."
              }
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "How many of the six were new? (None.)"
            },
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Which sign is read differently in one of them? (は, in こんにちは.)"
            }
          ]
        }
      ]
    },
    {
      "id": "JA-C19-kyoushitsu",
      "sequence": 1600,
      "title": "(reading) (te, mimi, kuchi, hana, kao, me) (wakarimashita, wakarimasen, mō ichido, onegaishimasu) (hai, iie, konnichiwa, arigatō, sayōnara, sumimasen) — the cues you have only ever heard",
      "headword": "(reading)",
      "romanization": "wakarimashita, wakarimasen, mō ichido, onegaishimasu",
      "gloss": "the classroom cues, read rather than heard — the longest Japanese the book has put on one page",
      "script": "japanese",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:b77ebaf680fcfe54",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Six words, then six greetings. These are the longest lines the book has set on one page."
            },
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "speech",
              "text": "Every one of them is a cue you already use. None is new."
            }
          ]
        },
        {
          "index": 1,
          "type": "comprehension",
          "title": "Reading",
          "segments": [
            {
              "kind": "speech",
              "text": "ここ すこし わかりました わかりません もういちど、おねがいします もうすこし、ゆっくりいってください."
            },
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Read down once, without stopping. The list gets longer as it goes; let it."
            },
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Again — and notice that the last two are the only ones with a comma in them, and that the comma falls exactly where you pause when you say it."
            }
          ]
        },
        {
          "index": 2,
          "type": "input",
          "title": "You'll want to know",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "わかりました and わかりません differ in three signs at the end and in nothing else. Understood, and not understood."
            },
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "That is the pair worth being able to read rather than only hear. A cue you can only recognise when somebody says it to you is a cue you can only use when they do. Read once off a page, it becomes something you can reach for."
            },
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Six lines, and the last one is fourteen signs long — the longest stretch of Japanese this book has asked you to take in at once."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "the six lines, once, in order, without stopping",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: the six lines, once, in order, without stopping]"
            },
            {
              "kind": "repeat",
              "times": 2,
              "source": "[REPEAT x2]"
            },
            {
              "kind": "activity",
              "scored": true,
              "id": "JA-C19-kyoushitsu-not",
              "prompt": "Which line says you did NOT understand?",
              "assesses": [
                "JA-SKILL-CONNECTED-READING"
              ],
              "responseSeconds": 14,
              "acceptedResponses": [
                "wakarimasen",
                "わかりません"
              ],
              "feedback": {
                "correct": "わかりません.",
                "incorrect": "わかりません -- I do not understand."
              }
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "How many of the six were new? (None.)"
            },
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Which two differ only at the end? (わかりました and わかりません.)"
            }
          ]
        }
      ]
    }
  ],
