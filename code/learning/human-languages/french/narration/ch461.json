          "title": "You'll want to know: la bruine",
          "segments": [
            {
              "kind": "speech",
              "text": "la bruine — \"the drizzle\"."
            },
            {
              "kind": "speech",
              "text": "Une bruine fine tombe depuis ce matin. A fine drizzle has been falling since this morning."
            },
            {
              "kind": "speech",
              "text": "Very light rain."
            }
          ]
        },
