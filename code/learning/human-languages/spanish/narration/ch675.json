        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: las afueras",
          "segments": [
            {
              "kind": "speech",
              "text": "las afueras — \"the outskirts\"."
            },
            {
              "kind": "speech",
              "text": "Vivimos en las afueras de la ciudad. We live on the outskirts of the city."
            },
            {
              "kind": "speech",
              "text": "Always plural: las afueras."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "afueras is built on afuera and fuera \"outside\", which come from Latin forās \"out of doors\" (EtymDB)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
