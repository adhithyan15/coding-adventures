// NoteTypeEditor.dark.msl - dark note-type editor theme.

style NoteTypeEditor {
  part note-type-editor {
    background    : "#111827" ;
    border-width  : 1 ;
    border-color  : "#475569" ;
    border-radius : 8 ;
    padding       : 14 ;
  }

  part note-type-editor-title {
    color          : "#f8fafc" ;
    font-size      : 20 ;
    font-weight    : 800 ;
    padding-bottom : 10 ;
  }

  part note-type-editor-body {
    padding-bottom : 12 ;
  }

  part note-type-list-column {
    padding : 2 ;
  }

  part note-types-label {
    color       : "#93c5fd" ;
    font-size   : 11 ;
    font-weight : 700 ;
  }

  part note-type-list {
    padding-top : 6 ;
  }

  part note-type-option {
    background    : "#1e293b" ;
    border-width  : 1 ;
    border-color  : "#475569" ;
    border-radius : 6 ;
    color         : "#f8fafc" ;
    padding       : 8 ;
  }

  part note-type-detail-column {
    padding : 2 ;
  }

  part note-type-metadata {
    padding-bottom : 8 ;
  }

  part note-type-id-meta {
    padding : 6 ;
  }

  part note-type-id-label {
    color       : "#c4b5fd" ;
    font-size   : 11 ;
    font-weight : 700 ;
  }

  part note-type-id-value {
    color       : "#e2e8f0" ;
    font-size   : 14 ;
    font-weight : 600 ;
  }

  part note-type-name-label {
    color       : "#86efac" ;
    font-size   : 11 ;
    font-weight : 700 ;
  }

  part note-type-name-input {
    background    : "#0f172a" ;
    border-width  : 1 ;
    border-color  : "#334155" ;
    border-radius : 6 ;
    color         : "#f8fafc" ;
    padding       : 8 ;
  }

  part note-type-schema-summary {
    padding-top    : 10 ;
    padding-bottom : 10 ;
  }

  part field-summary-column {
    padding : 2 ;
  }

  part template-summary-column {
    padding : 2 ;
  }

  part note-type-fields-label {
    color       : "#fde68a" ;
    font-size   : 11 ;
    font-weight : 700 ;
  }

  part note-type-templates-label {
    color       : "#fca5a5" ;
    font-size   : 11 ;
    font-weight : 700 ;
  }

  part note-type-field-list {
    padding-top : 6 ;
  }

  part note-type-template-list {
    padding-top : 6 ;
  }

  part note-type-field-option {
    background    : "#1e293b" ;
    border-width  : 1 ;
    border-color  : "#475569" ;
    border-radius : 6 ;
    color         : "#f8fafc" ;
    padding       : 6 ;
  }

  part note-type-field-name-label {
    color       : "#fde68a" ;
    font-size   : 11 ;
    font-weight : 700 ;
    padding-top : 8 ;
  }

  part note-type-field-name-input {
    background    : "#0f172a" ;
    border-width  : 1 ;
    border-color  : "#334155" ;
    border-radius : 6 ;
    color         : "#f8fafc" ;
    padding       : 8 ;
  }

  part note-type-field-required-checkbox {
    color       : "#e2e8f0" ;
    font-size   : 13 ;
    padding-top : 6 ;
  }

  part note-type-template-label {
    color         : "#e2e8f0" ;
    font-size     : 13 ;
    padding       : 5 ;
  }

  part note-type-stylesheet-label {
    color       : "#7dd3fc" ;
    font-size   : 11 ;
    font-weight : 700 ;
  }

  part note-type-stylesheet-input {
    background    : "#0f172a" ;
    border-width  : 1 ;
    border-color  : "#334155" ;
    border-radius : 6 ;
    color         : "#f8fafc" ;
    padding       : 8 ;
  }

  part note-type-editor-actions {
    padding-top : 2 ;
  }

  part note-type-new-button {
    background    : "#1d4ed8" ;
    border-width  : 1 ;
    border-color  : "#1e40af" ;
    border-radius : 6 ;
    color         : "#f8fafc" ;
    font-weight   : 700 ;
    padding       : 8 ;
  }

  part note-type-save-button {
    background    : "#0f766e" ;
    border-width  : 1 ;
    border-color  : "#134e4a" ;
    border-radius : 6 ;
    color         : "#f8fafc" ;
    font-weight   : 700 ;
    padding       : 8 ;
  }

  part note-type-delete-button {
    background    : "#be123c" ;
    border-width  : 1 ;
    border-color  : "#881337" ;
    border-radius : 6 ;
    color         : "#f8fafc" ;
    font-weight   : 700 ;
    padding       : 8 ;
  }

  part note-type-cancel-button {
    background    : "#334155" ;
    border-width  : 1 ;
    border-color  : "#64748b" ;
    border-radius : 6 ;
    color         : "#f8fafc" ;
    font-weight   : 700 ;
    padding       : 8 ;
  }
}
