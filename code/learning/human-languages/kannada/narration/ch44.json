              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *nōḍu*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "it once more, slowly",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: it once more, slowly]"
            }
          ]
        },
        {
