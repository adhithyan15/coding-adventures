          "segments": [
            {
              "kind": "speech",
              "text": "vātēs, vātis — \"a seer, a prophet; a poet\"."
            },
            {
              "kind": "speech",
              "text": "Vātēs fāta urbis cecinit. The seer sang of the fates of the city."
            },
            {
              "kind": "speech",
              "text": "Masculine or feminine, 3rd declension. Poets liked to call themselves vātēs, inspired singers."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "vātēs is inherited; EtymDB traces it to a Proto-Indo-European word for \"seer\", and Lewis & Short compare an Old Irish word for a seer."
            }
          ]
        },
