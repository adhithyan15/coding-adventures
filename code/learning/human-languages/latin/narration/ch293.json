          "segments": [
            {
              "kind": "speech",
              "text": "gradātim — \"step by step\"."
            },
            {
              "kind": "speech",
              "text": "Gradātim ad summum montem ascendimus. Step by step we climbed to the top of the mountain."
            },
            {
              "kind": "speech",
              "text": "From gradus, 'a step' (taught). Cicero uses it of an argument that moves one point at a time."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "gradātim is built on gradus, \"step\" (EtymDB), with the adverb ending -ātim. Gradus is inherited and goes back to a root meaning \"to walk, to step\"."
            }
          ]
        },
