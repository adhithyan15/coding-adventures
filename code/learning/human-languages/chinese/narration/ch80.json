        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: shàngbān",
          "segments": [
            {
              "kind": "speech",
              "text": "shàngbān — \"to go to work\"."
            },
            {
              "kind": "speech",
              "text": "wǒ jiǔ diǎn shàngbān — I start work at nine."
            },
            {
              "kind": "speech",
              "text": "Its characters come later; for now it is a word for the ear."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "shàngbān is built from 上 'to go up to' and bān, both inherited from Middle Chinese, dzyangX and paen (Guangyun, in Baxter's transcription). The dictionary explains the second, through an older book, as dividing up jade tallies; a shift of work is a likely step, but it is not settled."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word about people."
            }
          ]
        },
