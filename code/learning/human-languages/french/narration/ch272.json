        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: jadis",
          "segments": [
            {
              "kind": "speech",
              "text": "jadis — \"long ago, in olden days\"."
            },
            {
              "kind": "speech",
              "text": "Jadis, cette rue était un marché. Long ago, this street was a market."
            },
            {
              "kind": "speech",
              "text": "Literary and a little old-fashioned; fairy tales like it."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "jadis comes from Old French ja a dis \"it is days already\" (EtymDB), with ja from Latin iam \"already\" and dis from Latin diēs \"day\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
