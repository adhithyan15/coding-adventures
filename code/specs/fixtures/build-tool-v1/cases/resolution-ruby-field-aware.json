        "path": "code/packages/ruby/alpha/coding_adventures_alpha.gemspec",
        "content_utf8": "Gem::Specification.new do |spec|\n  spec.name = \"coding_adventures_alpha\"\n  spec.summary = \"Mentions coding_adventures_gamma without depending on it.\"\n  spec.description = \"The coding_adventures_gamma text is metadata only.\"\n  spec.files = [\"lib/coding_adventures_gamma.rb\"]\n  spec.require_paths = [\"lib/coding_adventures_gamma\"]\n  spec.metadata = {\"source_code_uri\" => \"https://example.invalid/coding_adventures_gamma\"}\n\n  spec.add_dependency 'coding_adventures_beta', '~> 0.1'\n  spec.add_runtime_dependency(\"coding_adventures_delta\", \">= 0.1\") # coding_adventures_gamma stays a comment\n  spec.add_development_dependency \"coding_adventures_gamma\", \"~> 0.1\"\n  # spec.add_dependency \"coding_adventures_gamma\"\nend\n"
      },
      {
        "path": "code/packages/ruby/beta/BUILD",
        "content_utf8": "echo build beta\n"
      },
      {
        "path": "code/packages/ruby/beta/coding_adventures_beta.gemspec",
        "content_utf8": "Gem::Specification.new do |spec|\n  spec.name = \"coding_adventures_beta\"\nend\n"
      },
      {
        "path": "code/packages/ruby/delta/BUILD",
        "content_utf8": "echo build delta\n"
      },
