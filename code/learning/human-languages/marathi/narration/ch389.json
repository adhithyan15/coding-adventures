          "segments": [
            {
              "kind": "speech",
              "text": "अंशतः (aṁśataḥ) is a learned adverb built from Sanskrit aṁśa, \"share, part\" (CDIAL 2), with the ending -taḥ, \"by, in\"."
            }
          ]
        },
