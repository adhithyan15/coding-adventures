      "title": "നൃത്തം (nṛtthaṁ) — dance",
      "headword": "നൃത്തം",
      "romanization": "nṛtthaṁ",
      "gloss": "dance — an anusvara word, so the join is the one the book has had longest",
      "script": "malayalam",
      "modality": "voice",
