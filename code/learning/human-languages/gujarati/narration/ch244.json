          "segments": [
            {
              "kind": "speech",
              "text": "ગણિત — gaṇit — \"mathematics, maths\"."
            },
            {
              "kind": "speech",
              "text": "મને ગણિત ગમે છે. — mane gaṇit game che — \"I like maths.\""
            },
            {
              "kind": "speech",
              "text": "A neuter noun."
