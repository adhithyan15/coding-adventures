      ],
      "sourceHash": "fnv1a64:7e9436abb743085c",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Say \"a ship\", then \"the fare\". (Nāvis. Naulum.)"
            }
          ]
        },
        {
          "index": 1,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "Two chapters, and a whole journey. The way through the town, quā viā …, rēctā viā, ad dextram. The ship, the fare and the master who takes it. And the trouble: quid accidit?, answered in the perfect."
            },
            {
              "kind": "speech",
              "text": "Iter Rōmam faciēbam. Prīmum naulum solvī. Deinde sarcinam āmīsī. Postrēmō nāvis discessit! — I was making a journey to Rome. First I paid the fare. Then I lost my pack. And last of all, the ship left!"
            },
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "One line of scene, faciēbam, and three events."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
