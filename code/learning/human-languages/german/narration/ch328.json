          "type": "input",
          "title": "You'll want to know: das Sieb",
          "segments": [
            {
              "kind": "speech",
              "text": "das Sieb — \"the sieve, the colander\"."
            },
            {
              "kind": "speech",
              "text": "Er goss die Nudeln in ein Sieb. He poured the pasta into a colander."
            },
            {
              "kind": "speech",
              "text": "Plural: die Siebe."
            }
          ]
        },
