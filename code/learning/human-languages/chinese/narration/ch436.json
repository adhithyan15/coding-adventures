    {
      "id": "ZH-W436-fang-side",
      "sequence": 33325,
      "title": "方 (fāng) — a dot over a bar, a hook and a long stroke",
      "headword": "方",
      "romanization": "fāng",
      "gloss": "方 — a dot, a bar, a hook and a long stroke falling to the left",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:080c40764265bf7b",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — a dot over a bar, a hook and a long stroke",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — a dot over a bar, a hook and a long stroke and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say nánfāng — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *nánfāng* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "南 万."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — nán, wàn",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *nán*, *wàn*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — a dot over a bar, a hook and a long stroke",
          "segments": [
            {
              "kind": "speech",
              "text": "方 (fāng)."
            },
            {
              "kind": "speech",
              "text": "One piece, four strokes. Count the strokes this time: there is only one piece."
            },
            {
              "kind": "speech",
              "text": "A dot on top, in the middle."
            },
            {
              "kind": "speech",
              "text": "A long bar under it."
            },
            {
              "kind": "speech",
              "text": "From under the bar, a stroke that runs a little to the right, turns down and hooks to the left at the foot. Then a long stroke falling to the left, also from under the bar. These last two are made as in 万."
            },
            {
              "kind": "speech",
              "text": "1 + 1 + 2 = four."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "方 (fāng), all four, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 方, all four, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many strokes in 方 (fāng)? (Four.) What comes first? (A dot.) Which stroke hooks? (The third: it runs right, turns down and hooks.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 方 (fāng), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
