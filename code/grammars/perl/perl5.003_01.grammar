# Perl 5.003_01 (1996-07-31) grammar: verified arithmetic-print subset only.
# @version 1
# PARTIAL: unsupported Perl 5.003_01 syntax is rejected.
# Evidence: https://github.com/Perl/perl5/blob/perl-5.003_01/perly.y
# The tagged yacc grammar differs from 5.003, including LSTOPSUB forms, but
# retains ADDOP/MULOP precedence, unary minus, and parenthesized terms. Only
# `print` and the listed arithmetic subset are admitted here.

program         = print_statement { print_statement } ;
print_statement = PRINT LPAREN expr RPAREN SEMICOLON ;
expr            = term { ( PLUS | MINUS ) term } ;
term            = unary { STAR unary } ;
unary           = MINUS unary | atom ;
atom            = INT | LPAREN expr RPAREN ;
