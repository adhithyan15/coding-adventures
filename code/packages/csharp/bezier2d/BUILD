# Build first with production instrumentation so a clean project-reference
# graph is measured when the test phase reuses it with --no-build.
mkdir -p .dotnet/tmp .artifacts && HOME="$PWD/.dotnet" TMPDIR="$PWD/.dotnet/tmp" DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1 DOTNET_CLI_HOME="$PWD/.dotnet" dotnet build tests/CodingAdventures.Bezier2D.Tests/CodingAdventures.Bezier2D.Tests.csproj --disable-build-servers --artifacts-path .artifacts /p:CollectCoverage=true "/p:Include=[CodingAdventures.Bezier2D]*" && HOME="$PWD/.dotnet" TMPDIR="$PWD/.dotnet/tmp" DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1 DOTNET_CLI_HOME="$PWD/.dotnet" dotnet test tests/CodingAdventures.Bezier2D.Tests/CodingAdventures.Bezier2D.Tests.csproj --no-build --disable-build-servers --artifacts-path .artifacts /p:CollectCoverage=true /p:Threshold=95 /p:ThresholdType=line "/p:Include=[CodingAdventures.Bezier2D]*"
