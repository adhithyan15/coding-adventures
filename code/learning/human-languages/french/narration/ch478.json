          "type": "input",
          "title": "You'll want to know: le sourcil",
          "segments": [
            {
              "kind": "speech",
              "text": "le sourcil — \"eyebrow\"."
            },
            {
              "kind": "speech",
              "text": "Il lève les sourcils quand il est surpris. He raises his eyebrows when he is surprised."
            },
            {
              "kind": "speech",
              "text": "Froncer les sourcils — to frown."
            }
          ]
        },
