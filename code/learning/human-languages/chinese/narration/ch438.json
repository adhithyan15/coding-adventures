              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "běibù",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *běibù*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "běibù, once more",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *běibù*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "wǒmen zuò huǒchē qù Zhōngguó běibù — We're taking the train up to the north of China.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *wǒmen zuò huǒchē qù Zhōngguó běibù* — We're taking the train up to the north of China.]"
            },
            {
