        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: causer",
          "segments": [
            {
              "kind": "speech",
              "text": "causer — \"to cause\"."
            },
            {
              "kind": "speech",
              "text": "Le brouillard a causé un accident sur l'autoroute. The fog caused an accident on the motorway."
            },
            {
              "kind": "speech",
              "text": "Another causer, informal, means to chat: causer avec un ami."
            }
          ]
        },
