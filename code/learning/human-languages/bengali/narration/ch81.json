              "action": "SAY",
              "instruction": "kāchhe",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *kāchhe*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "kāchhe, once more",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *kāchhe*, once more]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "say kāchhe",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: say *kāchhe*]"
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say the Bengali for time, then the Bengali for midday, then say kāchhe again",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say the Bengali for time, then the Bengali for midday, then say *kāchhe* again]"
            }
          ]
        },
        {
          "index": 5,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "What does কাছে (kāchhe) mean? (\"Near\".) Say it once more."
            }
          ]
        }
      ]
