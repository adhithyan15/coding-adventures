// Select.dark.msl — dark-theme styling.

style Select {
  part select {
    padding : 0 ;
  }
  part select-toggle {
    padding       : 8 ;
    background    : "#1f2937" ;
    color         : "#f3f4f6" ;
    border-width  : 1 ;
    border-color  : "#4b5563" ;
    font-size     : 14 ;
    border-radius : 4 ;
  }
  part select-options {
    padding      : 4 ;
    background   : "#111827" ;
    border-width : 1 ;
    border-color : "#374151" ;
  }
  part select-option {
    padding       : 8 ;
    background    : "#111827" ;
    color         : "#f3f4f6" ;
    border-width  : 0 ;
    font-size     : 14 ;
    border-radius : 0 ;
  }
}
