          "segments": [
            {
              "kind": "speech",
              "text": "ohne dass — \"without (someone) doing\"."
            },
            {
              "kind": "speech",
              "text": "Er ist gegangen, ohne dass jemand es gemerkt hat. He left without anyone noticing."
            },
            {
              "kind": "speech",
              "text": "Ohne dass sends the verb to the end. When the subject stays the same, German says ohne … zu: Er ging, ohne etwas zu sagen."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ohne dass joins ohne \"without\", from Proto-Germanic ēnu (EtymDB), a cousin of Greek áneu \"without\", to dass \"that\"."
            }
          ]
        },
        {
