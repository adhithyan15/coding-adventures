        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: la boa",
          "segments": [
            {
              "kind": "speech",
              "text": "la boa — \"the buoy\"."
            },
            {
              "kind": "speech",
              "text": "Non nuotare oltre le boe. Do not swim beyond the buoys."
            },
            {
              "kind": "speech",
              "text": "On beaches the buoys mark the safe swimming area."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "boa is usually traced to a Germanic word for a sign or marker, through Old French, but the origin is not settled."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
