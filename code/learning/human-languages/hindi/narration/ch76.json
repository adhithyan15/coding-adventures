    {
      "id": "HI-C69-ticket",
      "sequence": 2910,
      "title": "टिकट (ṭikaṭ) — a ticket",
      "headword": "टिकट",
      "romanization": "ṭikaṭ",
      "gloss": "a ticket",
      "script": "devanagari",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:4793865a32183c47",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Write स्टेशन (sṭeshan) from memory. Start with the stacked स्, then ट, then े on top, then श, then न."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: टिकट",
          "segments": [
            {
              "kind": "speech",
              "text": "टिकट (ṭikaṭ) — \"a ticket\"."
            },
            {
              "kind": "speech",
              "text": "English ticket, and both of its t sounds land on retroflex ट for the reason the last lesson gave. The ि in the middle is the short i matra, and it is written before the letter it is sounded after — you learnt that trick when you first wrote a name."
            },
            {
              "kind": "speech",
              "text": "This is the word you actually say at a window. You already know how to ask for one thing politely: एक चाय दीजिए got you a cup of tea. एक टिकट (ṭikaṭ) दीजिए is the same frame with a new word dropped in, and it will get you onto a train."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "Four, and a request you can already make with the fourth."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "ṭikaṭ",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *ṭikaṭ*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "ek ṭikaṭ dījie",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *ek ṭikaṭ dījie*]"
            },
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "टिकट (ṭikaṭ), putting the ि down before the ट it belongs to",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: टिकट, putting the ि down before the ट it belongs to]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How do you ask for one ticket? (ek ṭikaṭ dījie.) Say it once more."
            }
          ]
        }
      ]
    },
    {
      "id": "HI-C69-go",
      "sequence": 2920,
      "title": "जाना (jānā) — to go",
      "headword": "जाना",
      "romanization": "jānā",
      "gloss": "to go",
      "script": "devanagari",
      "modality": "voice",
      "derivedModality": "voice",
