        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: o estágio",
          "segments": [
            {
              "kind": "speech",
              "text": "o estágio — \"the internship, the traineeship; the stage\"."
            },
            {
              "kind": "speech",
              "text": "Fiz um estágio de três meses num hotel. I did a three-month internship in a hotel."
            },
            {
              "kind": "speech",
              "text": "Estágio profissional — work placement. Also a stage or phase."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "estágio is usually traced to French stage \"a period of training\", which EtymDB derives from Medieval Latin stagium (EtymDB), a formation on Latin stāre \"to stand\" (Lewis & Short)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
