% ============================================================================
% valve-alternate-name.query.adj — worked recall over the valve-alternate-name
% library.
% ============================================================================
% The shape a learner (or an LLM) produces to ANSWER "what is the mitral
% valve also called?" (direct) or "which valve is called the bicuspid?"
% (reverse) — it states no fact of its own — it only `import`s the grounded
% table and asks binding queries. A valve not tabled here abstains honestly
% — the engine never invents an alternate name.
% ============================================================================

import "valve-alternate-name.adj"

? valve_alternate_name(mitral, $AltName)   % expect bicuspid
? valve_alternate_name($Valve, bicuspid)    % reverse bind — expect mitral
? valve_alternate_name(tricuspid, $AltName)  % expect abstain -- a real, already-tabled valve whose own quote never supplies an alternate name
