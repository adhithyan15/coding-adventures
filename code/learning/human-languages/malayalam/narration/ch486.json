          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ശാഖ (śākha) is borrowed from Sanskrit śākhā, \"a branch\" of a tree, and so a part of a larger body (Monier-Williams)."
            }
          ]
        },
