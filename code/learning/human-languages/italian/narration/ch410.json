          "segments": [
            {
              "kind": "speech",
              "text": "il guasto — \"the breakdown, the fault\"."
            },
            {
              "kind": "speech",
              "text": "C'è un guasto al motore. There is a fault in the engine."
            },
            {
              "kind": "speech",
              "text": "As an adjective, guasto means out of order: il telefono è guasto."
            }
          ]
        },
