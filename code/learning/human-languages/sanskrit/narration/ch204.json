          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "sūcayati is, MW says, a verb made from sūca and sūci, \"needle, pointer\": a needle is a pointer. Its noun sūcanā, \"information\", went into Hindi as sūcnā."
            }
          ]
        },
