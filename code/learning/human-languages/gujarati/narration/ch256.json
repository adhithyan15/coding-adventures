        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ચિત્ર (citra) is Sanskrit citrá, \"conspicuous, bright, variegated\", taken over as a tatsama for a picture (CDIAL 4803)."
            }
          ]
        },
