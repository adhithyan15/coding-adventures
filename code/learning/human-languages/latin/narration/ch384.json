          "segments": [
            {
              "kind": "speech",
              "text": "comitia, comitiōrum — \"the voting assembly, the elections\"."
            },
            {
              "kind": "speech",
              "text": "Comitia mox habēbuntur. The elections will be held soon."
            },
            {
              "kind": "speech",
              "text": "comitia, comitiōrum n. pl.: the Roman people meeting to vote. The singular comitium is the meeting place."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "comitia is built from com- \"together\" and the root of eō \"to go\" (Lewis & Short): a going together."
            }
          ]
        },
