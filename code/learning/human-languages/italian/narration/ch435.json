        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: il riscaldamento",
          "segments": [
            {
              "kind": "speech",
              "text": "il riscaldamento — \"the heating\"."
            },
            {
              "kind": "speech",
              "text": "Il riscaldamento è spento e fa freddo. The heating is off and it is cold."
            },
            {
              "kind": "speech",
              "text": "Il riscaldamento globale — global warming."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "riscaldamento is built on scaldare 'to warm', which is inherited from Late Latin excaldāre (EtymDB), built on calidus 'hot'."
            }
          ]
        },
        {
