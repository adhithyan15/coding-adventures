        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: گرنا",
          "segments": [
            {
              "kind": "speech",
              "text": "گرنا — girnā — \"to fall\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "گرنا (girnā) is a tadbhava, a word inherited and reshaped by sound change. It comes from girati, \"drips, falls\", a form CDIAL reconstructs from its descendants (CDIAL 4159)."
            }
          ]
        },
