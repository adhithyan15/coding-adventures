            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Punjabi for summer, then the Punjabi for winter."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ਬਰਸਾਤ",
          "segments": [
            {
              "kind": "speech",
              "text": "ਬਰਸਾਤ — barsāt — \"the rainy season\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ਬਰਸਾਤ (barsāt) matches Hindi barsāt, which CDIAL lists under Sanskrit varṣārātri, \"the rainy season\", or else as a blend with varṣartu, \"rainy season\" (CDIAL 11398). It gives no Punjabi form."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
