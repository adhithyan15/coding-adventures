# @version 1
# Mermaid 11.16.1 Wardley core grammar.
case_sensitive: false
skip:
  COMMENT = /[ \t]*%%[^\r\n]*/
NEWLINE = /\r?\n/
HEADER = /wardley-beta/
ACC_TITLE_LINE = /[ \t]*accTitle[ \t]*:[^\r\n]*/
ACC_DESCR_LINE = /[ \t]*accDescr[ \t]*:[^\r\n]*/
PIPELINE_LINE = /[ \t]*pipeline[ \t]+[^\r\n{]+\{[ \t]*/
COMPONENT_LINE = /[ \t]*component[ \t]+[^\r\n]*/
PIPELINE_END = /[ \t]*\}[ \t]*/
EVOLUTION_LINE = /[ \t]*evolution[ \t]+[^\r\n]*/
ACCELERATOR_LINE = /[ \t]*accelerator[ \t]+[^\r\n]*/
DEACCELERATOR_LINE = /[ \t]*deaccelerator[ \t]+[^\r\n]*/
LINK_LINE = /[ \t]*[^\r\n]+(?:-.->|-->|->|\+<>|\+>|\+<|\+'[^']*'(?:<>|<|>))[^\r\n]*/
STATEMENT_LINE = /[ \t]*[^\r\n%][^\r\n]*/
