          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "tapfer is inherited from Middle High German tapfer and Old High German tapfar, from Proto-Germanic dapraz \"stout, solid, heavy\" (EtymDB); the sense moved from firm to brave."
            }
          ]
        },
