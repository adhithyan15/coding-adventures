        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: fortitūdō, fortitūdinis",
          "segments": [
            {
              "kind": "speech",
              "text": "fortitūdō, fortitūdinis — \"courage, bravery\"."
            },
            {
              "kind": "speech",
              "text": "Mīlitēs magnā fortitūdine pugnant. The soldiers fight with great courage."
            },
            {
              "kind": "speech",
              "text": "Feminine, third declension, from fortis. One of the four great virtues of ancient ethics. English fortitude."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "fortitūdō is built on fortis \"strong, brave\" with -tūdō (Lewis & Short; EtymDB). English fortitude comes from it."
            }
          ]
        },
