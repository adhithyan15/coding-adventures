        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: la gaieté",
          "segments": [
            {
              "kind": "speech",
              "text": "la gaieté — \"cheerfulness\"."
            },
            {
              "kind": "speech",
              "text": "Sa gaieté met tout le monde de bonne humeur. Her cheerfulness puts everyone in a good mood."
            },
            {
              "kind": "speech",
              "text": "Also spelt la gaîté. Built on gai \"cheerful\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "la gaieté is built on gai \"cheerful\" (EtymDB), which came into French from Old Occitan gai; it is usually traced further back to a Germanic word."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
