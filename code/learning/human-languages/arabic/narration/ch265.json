        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: مسرح",
          "segments": [
            {
              "kind": "speech",
              "text": "مسرح — masraḥ — \"a theatre\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "مسرح (masraḥ) is built on the native Arabic root s-r-ḥ, \"to send cattle out to pasture\" (Lane). Masraḥ is a pasture ground; the theatre is a modern sense."
            }
          ]
        },
