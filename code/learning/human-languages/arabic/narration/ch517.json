          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "دخن (dakhkhana) is built on the native Arabic root d-kh-n, \"smoke\" (Lane). Midkhana, a chimney, which you know, is from the same root."
            }
          ]
        },
