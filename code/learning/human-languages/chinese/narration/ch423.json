    {
      "id": "ZH-W423-nan-south",
      "sequence": 32095,
      "title": "南 (nán) — 十 over a frame",
      "headword": "南",
      "romanization": "nán",
      "gloss": "南 — 十 on top, then a frame with a dot, a short stroke, two bars and a vertical inside",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:63f546027c7d6788",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — 十 over a frame",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — 十 over a frame and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say dōngnán — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *dōngnán* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "十 东."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — shí, dōng",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *shí*, *dōng*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — 十 over a frame",
          "segments": [
            {
              "kind": "speech",
              "text": "南 (nán)."
            },
            {
              "kind": "speech",
              "text": "Two pieces, top to bottom."
            },
            {
              "kind": "speech",
              "text": "The top piece, 十, two strokes. A short bar, then a vertical down through it."
            },
            {
              "kind": "speech",
              "text": "The frame, two strokes. A vertical down the left. Then a bar across that turns down the right side and hooks to the left at the foot: the frame is open at the bottom."
            },
            {
              "kind": "speech",
              "text": "Inside, five strokes. A dot and a short stroke falling to the left, side by side. Two bars, one under the other. Then a vertical from the upper bar down through the lower one."
            },
            {
              "kind": "speech",
              "text": "2 + 2 + 5 = nine."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "南 (nán), all nine, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 南, all nine, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many strokes in 南 (nán)? (Nine.) What sits on top? (十.) Is the frame closed at the foot? (No, it is open.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 南 (nán), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
