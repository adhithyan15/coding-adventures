    {
      "id": "ES-C417-curso",
      "sequence": 9630,
      "title": "el curso — a path of learning",
      "headword": "el curso",
      "romanization": "el curso",
      "gloss": "course, class",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:1eba92521262cd60",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Recall aprender, to learn. A planned path for learning something is un curso, a course or class."
            }
          ]
        },
        {
          "index": 1,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Latin cursus meant a running or a course, from currere, to run. English course keeps the same idea of a route, while current is something running onward. A learning course is a route followed from lesson to lesson."
            }
          ]
        },
        {
          "index": 2,
          "type": "grammar",
          "title": "Grammar Lens: name the subject",
          "segments": [
            {
              "kind": "speech",
              "text": "The noun is masculine: el curso, un curso. Use de to name its subject: un curso de natación, a swimming course."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "el curso",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *el curso*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "un curso",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *un curso*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "un curso de natación",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *un curso de natación*]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Course? (El curso.) A swimming course? (Un curso de natación.)"
            },
            {
              "kind": "speech",
              "text": "Source: DLE: curso."
            }
          ]
        }
      ]
    },
    {
      "id": "ES-C417-nadar",
      "sequence": 9640,
      "title": "nadar — move through the water",
      "headword": "nadar",
      "romanization": "nadar",
      "gloss": "to swim",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:ef593d2f9a8fef52",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Recall la piscina and un curso. What might a course at a pool teach? Nadar, to swim."
            }
          ]
        },
        {
          "index": 1,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Spanish nadar continues Latin natāre, to swim. English keeps the root in natatorium, a building with a swimming pool. The infinitive ends in -ar, like many familiar action words."
            }
          ]
        },
        {
          "index": 2,
          "type": "grammar",
          "title": "Grammar Lens: learn to swim",
          "segments": [
            {
              "kind": "speech",
              "text": "After aprender, Spanish uses a before another verb: aprender a nadar, to learn to swim. The related noun is la natación, swimming, as in curso de natación."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "nadar",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *nadar*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "aprender a nadar",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *aprender a nadar*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "un curso de natación",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *un curso de natación*]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "To swim? (Nadar.) To learn to swim? (Aprender a nadar.)"
            },
            {
              "kind": "speech",
              "text": "Source: DLE: nadar."
            }
          ]
        }
      ]
    },
    {
      "id": "ES-C417-adulto",
      "sequence": 9650,
      "title": "adulto, adulta — fully grown",
      "headword": "adulto, adulta",
      "romanization": "adulto, adulta",
      "gloss": "adult, grown-up",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:8661741085f61814",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Recall un curso and nadar. If this class is for grown-ups, the notice says para adultos, for adults."
            }
          ]
        },
        {
          "index": 1,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Latin adultus meant grown up, from adolescere, to grow. English adult is the same word with its ending shortened. Spanish keeps the ending and matches gender and number: adulto, adulta, adultos, adultas."
            }
          ]
        },
        {
          "index": 2,
          "type": "grammar",
          "title": "Grammar Lens: say who it is for",
          "segments": [
            {
              "kind": "speech",
              "text": "Use para for the intended group: un curso de natación para adultos. The plural adultos can describe a mixed group or a group of men."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "adulto, adulta",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *adulto, adulta*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "para adultos",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *para adultos*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "un curso de natación para adultos",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *un curso de natación para adultos*]"
            }
          ]
        },
        {
          "index": 4,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Adult? (Adulto, adulta.) For adults? (Para adultos.)"
            },
            {
              "kind": "speech",
              "text": "Source: DLE: adulto."
            }
          ]
        }
      ]
    },
