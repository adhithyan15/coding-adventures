    {
      "id": "ZH-W111-bian",
      "sequence": 8625,
      "title": "边 (biān) — the foot of 男, inside the walking piece",
      "headword": "边",
      "romanization": "biān",
      "gloss": "边 — the foot of 男, inside the walking piece",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:55398deb280853e3",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — the foot of 男, inside the walking piece",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — the foot of 男, inside the walking piece and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say qiánbian — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *qiánbian* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "男 这 进."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — nán, zhè, jìn",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *nán*, *zhè*, *jìn*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — the foot of 男, inside the walking piece",
          "segments": [
            {
              "kind": "speech",
              "text": "边 (biān)."
            },
            {
              "kind": "speech",
              "text": "The inside first, two strokes, the foot of 男: a stroke across that turns down and hooks, then a left-falling stroke through it."
            },
            {
              "kind": "speech",
              "text": "The walking piece, three strokes, written last, as in 这 and 进: a dot, a small zigzag down the left, and a long flat sweep along the foot."
            },
            {
              "kind": "speech",
              "text": "2 + 3 = five."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "边 (biān), all five, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 边, all five, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "Which comes first in 边 (biān), the inside or the walking piece? (The inside.) Where have you written that inside piece? (At the foot of 男.) Which characters you know end with the walking piece? (这 and 进.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 边 (biān), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
