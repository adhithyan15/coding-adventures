        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: फिर से",
          "segments": [
            {
              "kind": "speech",
              "text": "फिर से (phir se) — \"once more\", \"from the start again\"."
            },
            {
              "kind": "speech",
              "text": "फिर से (phir se) बोलिए — \"please say it again\", a softer cousin of दोबारा."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "फिर से (phir se) is phir, \"again\", with se. CDIAL lists phir under a reconstructed phirati, \"turns\" (CDIAL 9078)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
