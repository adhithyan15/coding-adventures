        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: l'emballage",
          "segments": [
            {
              "kind": "speech",
              "text": "l'emballage — \"the packaging, the wrapping\"."
            },
            {
              "kind": "speech",
              "text": "Il y a trop d'emballage autour de ce petit objet. There is too much packaging round this small object."
            },
            {
              "kind": "speech",
              "text": "A masculine noun. Un emballage cadeau — gift wrap."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "emballage is built on emballer 'to wrap up' with -age (EtymDB lists it). Emballer comes from balle 'bale', usually traced to a Frankish word."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
