        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ಸ್ಮಾರಕ",
          "segments": [
            {
              "kind": "speech",
              "text": "ಸ್ಮಾರಕ — smāraka — \"a memorial; a monument\"."
            },
            {
              "kind": "speech",
              "text": "ಊರಿನ ಮಧ್ಯದಲ್ಲಿ ಸೈನಿಕರ ಸ್ಮಾರಕ ಇದೆ. ūrina madhyadalli sainikara smāraka ide. There is a soldiers' memorial in the middle of the town."
            },
            {
              "kind": "speech",
              "text": "Plural: ಸ್ಮಾರಕಗಳು, smārakagaḷu."
            },
            {
              "kind": "speech",
              "text": "Old temples and forts are ಐತಿಹಾಸಿಕ ಸ್ಮಾರಕಗಳು, historic monuments."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ಸ್ಮಾರಕ (smāraka) is borrowed from Sanskrit smāraka, \"recalling, reminding of\" (Monier-Williams), from smṛ, \"to remember\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling what happened."
            }
          ]
