          "segments": [
            {
              "kind": "speech",
              "text": "opifex is built from opus \"work\" and faciō \"to make\" (Lewis & Short; EtymDB puts the related ops \"power, means\" in place of opus), with the ending -fex of a maker."
            }
          ]
        },
