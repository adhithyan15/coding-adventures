        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: नोकरी",
          "segments": [
            {
              "kind": "speech",
              "text": "नोकरी — nokrī — \"a job\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "नोकरी (nokrī) is nokar, \"servant\", with the ending -ī. Nokar is usually traced to Persian naukar, which Persian took from Mongolic nökör, \"companion\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
