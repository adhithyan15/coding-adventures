{
  "version": 1,
  "language": "sanskrit",
  "level": "C1",
  "target": {"name": "Coding Adventures Sanskrit C1 Assessment — project-defined equivalent", "basis": "project-defined"},
  "sources": [
    {"id": "ca-hl16-assessment-policy", "title": "HL16 — Exam-ready books and the gentle writing ramp", "url": "https://github.com/adhithyan15/coding-adventures/blob/main/code/specs/HL16-exam-ready-books-and-writing-ramp.md", "published": "2026-08-20", "accessed": "2026-10-12"},
    {"id": "ca-hl18-task-shapes", "title": "HL18 — Four-skill task shapes", "url": "https://github.com/adhithyan15/coding-adventures/blob/main/code/specs/HL18-four-skill-task-shapes.md", "published": "2026-08-20", "accessed": "2026-10-12"},
    {"id": "ca-sanskrit-assessment", "title": "Coding Adventures Sanskrit Assessment Specification", "url": "https://github.com/adhithyan15/coding-adventures/blob/main/code/learning/human-languages/sanskrit/assessment-spec.md", "published": "2026-09-15", "accessed": "2026-10-12"}
  ],
  "administration": {"writtenMinutes": 200, "speakingMinutes": 22, "speakingGroupMaximum": 3, "speakingPreparationMinutes": 15, "deliveryModes": ["paper", "recorded-audio", "live-interlocutor"]},
  "passRule": {
    "maximumPoints": 400, "passPoints": 240, "requiresEverySectionAttempted": true,
    "independentSkillThresholds": {"reading": 0.6, "listening": 0.6, "writing": 0.6, "speaking": 0.6},
    "note": "Each skill is a separate 100-point paper and must independently reach 60/100; the 240-point headline sum cannot compensate for a failed paper. Reading and writing use Devanagari with external sandhi, while Classical Sanskrit remains in scope and Vedic accent and morphology remain out of scope. Spoken responses are scored in a documented Sanskrit pronunciation tradition. This is a project-defined assessment, not an external qualification."
  },
  "sections": [
    {
      "skill": "reading", "minutes": 75,
      "parts": [
        {
          "id": "c1-reading-dense-public-text", "promptModes": ["written-devanagari with external sandhi"],
          "promptGenres": ["dense public-policy, institutional, or civic text"],
          "responseModes": ["selection", "claim-evidence match", "implicit-stance match"], "items": 9,
          "stimulusLength": {"unit": "words", "minimum": 650, "maximum": 800, "approximate": false},
          "responseLength": {"unit": "items", "minimum": 1, "maximum": 1, "approximate": false},
          "interaction": "individual", "replayCount": 0,
          "scoring": {"maxRawPoints": 25, "criteria": ["argument structure", "implicit stance", "rhetorical purpose", "specific textual support", "external-sandhi decoding"]},
          "aids": {"allowed": ["marking on the question paper", "one unscored example"], "forbidden": ["romanization", "dictionary", "translator"], "notPublished": []},
          "notPublished": [], "sourceIds": ["ca-hl16-assessment-policy", "ca-hl18-task-shapes", "ca-sanskrit-assessment"]
        },
        {
          "id": "c1-reading-professional-text", "promptModes": ["written-devanagari with external sandhi"],
          "promptGenres": ["professional report, proposal, or analytical memorandum"],
          "responseModes": ["selection", "source-purpose match", "implication match"], "items": 9,
          "stimulusLength": {"unit": "words", "minimum": 700, "maximum": 850, "approximate": false},
          "responseLength": {"unit": "items", "minimum": 1, "maximum": 1, "approximate": false},
          "interaction": "individual", "replayCount": 0,
          "scoring": {"maxRawPoints": 25, "criteria": ["professional purpose", "evidence evaluation", "unstated implication", "register effect", "external-sandhi decoding"]},
          "aids": {"allowed": ["marking on the question paper", "one unscored example"], "forbidden": ["romanization", "dictionary", "translator"], "notPublished": []},
          "notPublished": [], "sourceIds": ["ca-hl16-assessment-policy", "ca-hl18-task-shapes", "ca-sanskrit-assessment"]
        },
        {
          "id": "c1-reading-academic-text", "promptModes": ["written-devanagari with external sandhi"],
          "promptGenres": ["academic or research-informed exposition"],
          "responseModes": ["selection", "argument-stage match", "qualification match"], "items": 9,
          "stimulusLength": {"unit": "words", "minimum": 700, "maximum": 880, "approximate": false},
          "responseLength": {"unit": "items", "minimum": 1, "maximum": 1, "approximate": false},
          "interaction": "individual", "replayCount": 0,
          "scoring": {"maxRawPoints": 25, "criteria": ["concept relation", "method or evidence evaluation", "qualification recognition", "authorial stance", "external-sandhi decoding"]},
          "aids": {"allowed": ["marking on the question paper", "one unscored example"], "forbidden": ["romanization", "dictionary", "translator"], "notPublished": []},
          "notPublished": [], "sourceIds": ["ca-hl16-assessment-policy", "ca-hl18-task-shapes", "ca-sanskrit-assessment"]
        },
        {
          "id": "c1-reading-literary-text", "promptModes": ["written-devanagari with external sandhi"],
          "promptGenres": ["literary prose or essay with layered voice and cultural context"],
          "responseModes": ["selection", "voice-effect match", "implicit-meaning match"], "items": 9,
          "stimulusLength": {"unit": "words", "minimum": 750, "maximum": 970, "approximate": false},
          "responseLength": {"unit": "items", "minimum": 1, "maximum": 1, "approximate": false},
          "interaction": "individual", "replayCount": 0,
          "scoring": {"maxRawPoints": 25, "criteria": ["narrative voice", "figurative and implicit meaning", "cultural context", "stylistic effect", "external-sandhi decoding"]},
          "aids": {"allowed": ["marking on the question paper", "one unscored example"], "forbidden": ["romanization", "dictionary", "translator"], "notPublished": []},
          "notPublished": [], "sourceIds": ["ca-hl16-assessment-policy", "ca-hl18-task-shapes", "ca-sanskrit-assessment"]
        }
      ], "variants": []
    },
    {
      "skill": "listening", "minutes": 50,
      "parts": [
        {
          "id": "c1-listening-unscripted-discussion", "promptModes": ["recorded Sanskrit at 160-185 words per minute with natural variation", "multiple speakers including one documented regional Sanskrit pronunciation tradition"],
          "promptGenres": ["unscripted discussion with overlap, repair, and implicit alignment"],
          "responseModes": ["selection", "speaker-stance match", "interaction-function match"], "items": 7,
          "stimulusLength": {"unit": "seconds", "minimum": 300, "maximum": 420, "approximate": false},
          "responseLength": {"unit": "items", "minimum": 1, "maximum": 1, "approximate": false},
          "interaction": "individual", "replayCount": 1,
          "scoring": {"maxRawPoints": 25, "criteria": ["speaker tracking", "implicit alignment", "interactional purpose", "supporting detail"]},
          "aids": {"allowed": ["paper notes", "one unscored orienting preview"], "forbidden": ["transcript", "dictionary", "translator", "audio controls"], "notPublished": []},
          "notPublished": [], "sourceIds": ["ca-hl16-assessment-policy", "ca-hl18-task-shapes", "ca-sanskrit-assessment"]
        },
        {
          "id": "c1-listening-lecture", "promptModes": ["recorded Sanskrit at 160-185 words per minute with natural variation"],
          "promptGenres": ["extended lecture or expert explanation"],
          "responseModes": ["selection", "argument-stage match", "note completion"], "items": 7,
          "stimulusLength": {"unit": "seconds", "minimum": 360, "maximum": 480, "approximate": false},
          "responseLength": {"unit": "items", "minimum": 1, "maximum": 1, "approximate": false},
          "interaction": "individual", "replayCount": 1,
          "scoring": {"maxRawPoints": 25, "criteria": ["lecture structure", "concept relation", "qualification recognition", "supporting detail"]},
          "aids": {"allowed": ["paper notes", "one unscored orienting preview"], "forbidden": ["transcript", "dictionary", "translator", "audio controls"], "notPublished": []},
          "notPublished": [], "sourceIds": ["ca-hl16-assessment-policy", "ca-hl18-task-shapes", "ca-sanskrit-assessment"]
        },
        {
          "id": "c1-listening-interview", "promptModes": ["recorded Sanskrit at 160-185 words per minute with natural variation", "multiple speakers including a second documented regional Sanskrit pronunciation tradition"],
          "promptGenres": ["extended interview with challenge and qualification"],
          "responseModes": ["selection", "speaker-intent match", "evidence match"], "items": 7,
          "stimulusLength": {"unit": "seconds", "minimum": 330, "maximum": 450, "approximate": false},
          "responseLength": {"unit": "items", "minimum": 1, "maximum": 1, "approximate": false},
          "interaction": "individual", "replayCount": 1,
          "scoring": {"maxRawPoints": 25, "criteria": ["speaker intent", "challenge-response relation", "qualification", "implicit stance"]},
          "aids": {"allowed": ["paper notes", "one unscored orienting preview"], "forbidden": ["transcript", "dictionary", "translator", "audio controls"], "notPublished": []},
          "notPublished": [], "sourceIds": ["ca-hl16-assessment-policy", "ca-hl18-task-shapes", "ca-sanskrit-assessment"]
        },
        {
          "id": "c1-listening-narrative", "promptModes": ["recorded Sanskrit at 160-185 words per minute with natural variation"],
          "promptGenres": ["extended narrative or documentary account"],
          "responseModes": ["selection", "voice-effect match", "implicit-meaning match"], "items": 7,
          "stimulusLength": {"unit": "seconds", "minimum": 330, "maximum": 450, "approximate": false},
          "responseLength": {"unit": "items", "minimum": 1, "maximum": 1, "approximate": false},
          "interaction": "individual", "replayCount": 1,
          "scoring": {"maxRawPoints": 25, "criteria": ["narrative architecture", "voice and attitude", "implicit meaning", "cultural inference"]},
          "aids": {"allowed": ["paper notes", "one unscored orienting preview"], "forbidden": ["transcript", "dictionary", "translator", "audio controls"], "notPublished": []},
          "notPublished": [], "sourceIds": ["ca-hl16-assessment-policy", "ca-hl18-task-shapes", "ca-sanskrit-assessment"]
        }
      ], "variants": []
    },
    {
      "skill": "writing", "minutes": 75,
      "parts": [
        {
          "id": "c1-writing-source-synthesis", "promptModes": ["two short written Devanagari Sanskrit source texts with external sandhi"],
          "promptGenres": ["contrasting public, professional, or academic source extracts"],
          "responseModes": ["independent handwritten Sanskrit synthesis in Devanagari with external sandhi"], "items": 1,
          "stimulusLength": {"unit": "words", "minimum": 450, "maximum": 650, "approximate": false},
          "responseLength": {"unit": "words", "minimum": 180, "maximum": 220, "approximate": false},
          "interaction": "individual", "replayCount": 0,
          "scoring": {"maxRawPoints": 40, "criteria": ["accurate source synthesis", "selection and integration", "organisation and cohesion", "audience and register", "Sanskrit vocabulary and grammar", "external sandhi", "word-final visarga or anusvara", "continuous śirorekhā and word-boundary control"]},
          "aids": {"allowed": ["paper notes", "marking on source texts"], "forbidden": ["copyable answer model", "romanization", "non-Devanagari response", "dictionary", "translator", "spell-checker"], "notPublished": []},
          "notPublished": [], "sourceIds": ["ca-hl16-assessment-policy", "ca-hl18-task-shapes", "ca-sanskrit-assessment"]
        },
        {
          "id": "c1-writing-extended-response", "promptModes": ["written-devanagari Sanskrit task brief with external sandhi"],
          "promptGenres": ["audience-aware argument, report, or critical response"],
          "responseModes": ["independent handwritten Sanskrit extended text in Devanagari with external sandhi"], "items": 1,
          "stimulusLength": {"unit": "words", "minimum": 90, "maximum": 150, "approximate": false},
          "responseLength": {"unit": "words", "minimum": 300, "maximum": 380, "approximate": false},
          "interaction": "individual", "replayCount": 0,
          "scoring": {"maxRawPoints": 60, "criteria": ["task fulfilment and intellectual development", "organisation and cohesion", "genre, audience, and register control", "Sanskrit vocabulary and grammar", "external sandhi", "word-final visarga or anusvara", "continuous śirorekhā and word-boundary control"]},
          "aids": {"allowed": ["paper planning notes"], "forbidden": ["copyable answer model", "romanization", "non-Devanagari response", "dictionary", "translator", "spell-checker"], "notPublished": []},
          "notPublished": [], "sourceIds": ["ca-hl16-assessment-policy", "ca-hl18-task-shapes", "ca-sanskrit-assessment"]
        }
      ], "variants": []
    },
    {
      "skill": "speaking", "minutes": 22,
      "parts": [
        {
          "id": "c1-speaking-source-based-presentation", "promptModes": ["two short written Devanagari Sanskrit sources with external sandhi"],
          "promptGenres": ["contrasting public, professional, or academic viewpoints"],
          "responseModes": ["five-minute source-based presentation"], "items": 1,
          "stimulusLength": {"unit": "words", "minimum": 350, "maximum": 500, "approximate": false},
          "responseLength": {"unit": "seconds", "minimum": 270, "maximum": 300, "approximate": false},
          "interaction": "individual", "replayCount": 0,
          "scoring": {"maxRawPoints": 35, "criteria": ["source synthesis", "argument development", "organisation and cohesion", "Sanskrit vocabulary and grammar", "pronunciation and fluency in a documented tradition"]},
          "aids": {"allowed": ["examiner-provided sources", "paper notes made during fifteen-minute preparation"], "forbidden": ["written answer script", "romanization", "dictionary", "translator", "electronic notes"], "notPublished": []},
          "notPublished": [], "sourceIds": ["ca-hl16-assessment-policy", "ca-hl18-task-shapes", "ca-sanskrit-assessment"]
        },
        {
          "id": "c1-speaking-collaborative-synthesis", "promptModes": ["live-speech", "written-devanagari Sanskrit synthesis brief with external sandhi"],
          "promptGenres": ["multi-source collaborative synthesis problem"],
          "responseModes": ["spoken integration, comparison, negotiation, and joint conclusion"], "items": 1,
          "stimulusLength": {"unit": "words", "minimum": 60, "maximum": 100, "approximate": false},
          "responseLength": {"unit": "seconds", "minimum": 300, "maximum": 360, "approximate": false},
          "interaction": "group", "replayCount": 0,
          "scoring": {"maxRawPoints": 30, "criteria": ["source integration", "collaborative interaction and repair", "negotiation and conclusion", "Sanskrit vocabulary and grammar", "pronunciation and fluency in a documented tradition"]},
          "aids": {"allowed": ["examiner-provided brief", "paper notes made during fifteen-minute preparation"], "forbidden": ["written answer script", "romanization", "dictionary", "translator", "electronic notes"], "notPublished": []},
          "notPublished": [], "sourceIds": ["ca-hl16-assessment-policy", "ca-hl18-task-shapes", "ca-sanskrit-assessment"]
        },
        {
          "id": "c1-speaking-challenge-and-defence", "promptModes": ["live-speech"],
          "promptGenres": ["sustained challenge to presentation claims and synthesis decisions"],
          "responseModes": ["spoken defence, qualification, reformulation, and counterargument"], "items": 6,
          "stimulusLength": {"unit": "seconds", "minimum": 20, "maximum": 75, "approximate": false},
          "responseLength": {"unit": "seconds", "minimum": 330, "maximum": 420, "approximate": false},
          "interaction": "group", "replayCount": 0,
          "scoring": {"maxRawPoints": 35, "criteria": ["reasoned defence", "qualification and reformulation", "interaction and repair", "register control", "Sanskrit vocabulary and grammar", "pronunciation and fluency in a documented tradition"]},
          "aids": {"allowed": ["paper notes made during fifteen-minute preparation"], "forbidden": ["written answer script", "romanization", "dictionary", "translator", "electronic notes"], "notPublished": []},
          "notPublished": [], "sourceIds": ["ca-hl16-assessment-policy", "ca-hl18-task-shapes", "ca-sanskrit-assessment"]
        }
