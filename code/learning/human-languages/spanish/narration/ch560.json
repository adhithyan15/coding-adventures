          "segments": [
            {
              "kind": "speech",
              "text": "juntarse — \"to get together; to join\"."
            },
            {
              "kind": "speech",
              "text": "Los amigos se juntan los viernes. The friends get together on Fridays."
            },
            {
              "kind": "speech",
              "text": "Common in Latin America for meeting friends. Juntarse con alguien — to hang out with someone."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "juntarse is built on junto 'together', which comes from Latin iūnctus 'joined', the participle of iungere 'to join, to yoke' (Lewis & Short)."
            }
          ]
        },
