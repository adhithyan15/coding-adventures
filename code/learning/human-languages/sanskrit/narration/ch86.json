          "segments": [
            {
              "kind": "speech",
              "text": "समयः (samayaḥ) — \"time\". कः समयः? — \"what is the time?\""
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Samaya is built from sam, \"together\", and the root √i, \"to go\": first a coming together, then an agreement, an appointed time, and time itself (MW, CDIAL 13185)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "The question on every street."
            }
