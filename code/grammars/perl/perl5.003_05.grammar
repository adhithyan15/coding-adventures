# Perl 5.003_05 (1996-09-12) grammar: verified arithmetic-print subset only.
# @version 1
# PARTIAL: unsupported Perl 5.003_05 syntax is rejected.
# Evidence: https://github.com/Perl/perl5/blob/perl-5.003_05/perly.y
# The tagged yacc grammar matches 5.003_04 and retains ADDOP/MULOP
# precedence, unary minus, and parenthesized terms. This pair admits only
# print and the arithmetic subset listed below.

program         = print_statement { print_statement } ;
print_statement = PRINT LPAREN expr RPAREN SEMICOLON ;
expr            = term { ( PLUS | MINUS ) term } ;
term            = unary { STAR unary } ;
unary           = MINUS unary | atom ;
atom            = INT | LPAREN expr RPAREN ;
