  claim c_sat_u8:
    forall a: U8, b: U8. sat_u8(a, b) == m_sat_u8(a, b)
  claim c_satr_u8:
    forall a: U8, b: U8, c: Bool. satr_u8(a, b, c) == m_satr_u8(a, b, c)
  claim c_sat_u16:
    forall a: U16, b: U16. sat_u16(a, b) == m_sat_u16(a, b)
  claim c_sat_u32:
    forall a: U32, b: U32. sat_u32(a, b) == m_sat_u32(a, b)
  claim c_sat_u64:
    forall a: U64, b: U64. sat_u64(a, b) == m_sat_u64(a, b)
  claim c_satr_u64:
    forall a: U64, b: U64, c: Bool. satr_u64(a, b, c) == m_satr_u64(a, b, c)
  claim c_sat_i8:
    forall a: I8, b: I8. sat_i8(a, b) == m_sat_i8(a, b)
  claim c_satr_i8:
    forall a: I8, b: I8, c: Bool. satr_i8(a, b, c) == m_satr_i8(a, b, c)
  claim c_sat_i16:
    forall a: I16, b: I16. sat_i16(a, b) == m_sat_i16(a, b)
  claim c_sat_i32:
    forall a: I32, b: I32. sat_i32(a, b) == m_sat_i32(a, b)
  claim c_sat_i64:
    forall a: I64, b: I64. sat_i64(a, b) == m_sat_i64(a, b)
  claim c_satr_i64:
    forall a: I64, b: I64, c: Bool. satr_i64(a, b, c) == m_satr_i64(a, b, c)
  claim c_sh_u8:
    forall a: U8, n: U8. sh_u8(a, n) == m_sh_u8(a, n)
  claim c_sh_u32_by_u8:
    forall a: U32, n: U8. sh_u32_by_u8(a, n) == m_sh_u32_by_u8(a, n)
  claim c_sh_i16_by_u16:
    forall a: I16, n: U16. sh_i16_by_u16(a, n) == m_sh_i16_by_u16(a, n)
  claim c_sh_u8_by_i8:
    forall a: U8, n: I8. sh_u8_by_i8(a, n) == m_sh_u8_by_i8(a, n)
  claim c_sh_i64_by_i32:
    forall a: I64, n: I32. sh_i64_by_i32(a, n) == m_sh_i64_by_i32(a, n)
  claim c_sh_u64_by_u64:
    forall a: U64, n: U64. sh_u64_by_u64(a, n) == m_sh_u64_by_u64(a, n)
  claim c_sh_only:
    forall a: U16. sh_only(a) == m_sh_only(a)
  claim c_me_u8:
    forall a: U8, b: U32. me_u8(a, b) == m_me_u8(a, b)
  claim c_me_u8_err:
    forall a: U8, b: U32 | b == 0u32. me_u8(a, b) == Err(E.Bad)
  claim c_me_u16_zero:
    forall a: U8. me_u16_zero(a) == m_me_u16_zero(a)
  claim c_me_i32:
    forall a: I32, b: U32. me_i32(a, b) == m_me_i32(a, b)
  claim c_me_bool:
    forall a: U8, f: Bool. me_bool(a, f) == m_me_bool(a, f)
  claim c_me_bool_zero:
    forall a: U8. me_bool_zero(a) == m_me_bool_zero(a)
  claim c_me_nat:
    forall a: Bool, n: Nat | n < 8. me_nat(a, n) == m_me_nat(a, n)
  claim c_me_nat_zero:
    forall a: Bool. me_nat_zero(a) == m_me_nat_zero(a)
  claim c_me_bytes4_zero:
    forall a: U8. me_bytes4_zero(a) == m_me_bytes4_zero(a)
  claim c_me_bytes_zero:
    forall a: U8. me_bytes_zero(a) == m_me_bytes_zero(a)
  claim c_sat_u8_tuple_param:
    forall a: U8, b: U8, p: (Bool,Bool). sat_u8_tuple_param(a, b, p) == m_sat_u8_tuple_param(a, b, p)

