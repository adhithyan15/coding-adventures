{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coding-adventures.dev/schemas/barcode-layout-1d-v1.json",
  "title": "Barcode layout 1D v1 conformance corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "limits", "error_ids", "cases"],
  "properties": {
    "schema_version": { "const": 1 },
    "profile": { "const": "barcode-layout-1d-v1" },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_pattern_scalars", "max_runs", "max_content_modules", "max_quiet_zone_modules", "max_symbols", "max_label_scalars", "max_metadata_entries", "max_metadata_key_scalars", "max_metadata_value_scalars", "max_metadata_utf8_bytes", "max_module_width", "max_bar_height", "max_color_scalars", "max_cases", "max_fixture_bytes", "max_fixture_depth"],
      "properties": {
        "max_pattern_scalars": { "const": 65567 },
        "max_runs": { "const": 40979 },
        "max_content_modules": { "const": 65567 },
        "max_quiet_zone_modules": { "const": 4096 },
        "max_symbols": { "const": 40979 },
        "max_label_scalars": { "const": 4096 },
        "max_metadata_entries": { "const": 64 },
        "max_metadata_key_scalars": { "const": 128 },
        "max_metadata_value_scalars": { "const": 4096 },
        "max_metadata_utf8_bytes": { "const": 65536 },
        "max_module_width": { "const": 8192 },
        "max_bar_height": { "const": 8192 },
        "max_color_scalars": { "const": 128 },
        "max_cases": { "const": 64 },
        "max_fixture_bytes": { "const": 131072 },
        "max_fixture_depth": { "const": 8 }
      }
    },
    "error_ids": {
      "const": ["pattern-too-long", "empty-pattern", "invalid-binary-token", "invalid-width-token", "invalid-marker-configuration", "invalid-module-count", "too-many-runs", "content-too-wide", "non-alternating-runs", "invalid-quiet-zone", "too-many-symbols", "symbol-width-mismatch", "invalid-render-config", "metadata-too-large", "human-readable-text-unsupported", "invalid-source-attribution"]
    },
    "cases": {
      "type": "array",
      "minItems": 48,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "role": { "enum": ["data", "start", "stop", "guard", "check", "inter-character-gap"] },
    "symbol_role": { "enum": ["data", "start", "stop", "guard", "check"] },
    "input_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["color", "modules", "sourceLabel", "sourceIndex", "role"],
      "properties": {
        "color": { "enum": ["bar", "space"] },
        "modules": { "type": "integer", "minimum": 0, "maximum": 65568 },
        "sourceLabel": { "type": "string", "maxLength": 4097 },
        "sourceIndex": { "type": "integer", "minimum": -2147483649, "maximum": 2147483648 },
        "role": { "$ref": "#/$defs/role" }
      }
    },
    "output_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["color", "modules", "sourceLabel", "sourceIndex", "role"],
      "properties": {
        "color": { "enum": ["bar", "space"] },
        "modules": { "type": "integer", "minimum": 1, "maximum": 65567 },
        "sourceLabel": { "type": "string", "maxLength": 4096 },
        "sourceIndex": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
        "role": { "$ref": "#/$defs/role" }
      }
    },
    "symbol_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "modules", "sourceIndex", "role"],
      "properties": {
        "label": { "type": "string", "maxLength": 4097 },
        "modules": { "type": "integer", "minimum": 0, "maximum": 65568 },
        "sourceIndex": { "type": "integer", "minimum": -2147483649, "maximum": 2147483648 },
        "role": { "$ref": "#/$defs/symbol_role" }
      }
    },
    "symbol_layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "startModule", "endModule", "sourceIndex", "role"],
      "properties": {
        "label": { "type": "string", "maxLength": 4096 },
        "startModule": { "type": "integer", "minimum": 0, "maximum": 65567 },
        "endModule": { "type": "integer", "minimum": 1, "maximum": 65567 },
        "sourceIndex": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
        "role": { "$ref": "#/$defs/symbol_role" }
      }
    },
    "repeat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token", "count"],
      "properties": {
        "token": { "type": "string", "minLength": 1, "maxLength": 2 },
        "count": { "type": "integer", "minimum": 0, "maximum": 65569 },
        "suffix": { "type": "string", "maxLength": 1 }
      }
    },
    "repeat_runs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["firstColor", "modules", "count", "sourceLabel", "sourceIndex", "role"],
      "properties": {
        "firstColor": { "enum": ["bar", "space"] },
        "modules": { "type": "integer", "minimum": 0, "maximum": 65568 },
        "count": { "type": "integer", "minimum": 0, "maximum": 40980 },
        "sourceLabel": { "type": "string", "maxLength": 4096 },
        "sourceIndex": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
        "role": { "$ref": "#/$defs/role" }
      }
    },
    "repeat_symbols": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "modules", "count", "role"],
      "properties": {
        "label": { "type": "string", "maxLength": 4096 },
        "modules": { "type": "integer", "minimum": 0, "maximum": 65568 },
        "count": { "type": "integer", "minimum": 0, "maximum": 40980 },
        "role": { "$ref": "#/$defs/symbol_role" }
      }
    },
    "render_config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "moduleWidth": { "type": "integer", "minimum": 0, "maximum": 8193 },
        "barHeight": { "type": "integer", "minimum": 0, "maximum": 8193 },
        "foreground": { "type": "string", "maxLength": 129 },
        "background": { "type": "string", "maxLength": 129 },
        "includeHumanReadableText": { "type": "boolean" }
      }
    },
    "caller_metadata": {
      "type": "object",
      "maxProperties": 65,
      "propertyNames": { "type": "string", "maxLength": 128 },
      "additionalProperties": { "type": "string", "maxLength": 4096 }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        { "not": { "required": ["pattern", "repeat"] } },
        { "not": { "required": ["runs", "repeatRuns"] } },
        { "not": { "required": ["symbols", "repeatSymbols"] } }
      ],
      "properties": {
        "pattern": { "type": "string", "maxLength": 65568 },
        "repeat": { "$ref": "#/$defs/repeat" },
        "sourceLabel": { "type": "string", "maxLength": 4097 },
        "sourceIndex": { "type": "integer", "minimum": -2147483649, "maximum": 2147483648 },
        "role": { "$ref": "#/$defs/role" },
        "narrowMarker": { "type": "string", "minLength": 1, "maxLength": 1 },
        "wideMarker": { "type": "string", "minLength": 1, "maxLength": 1 },
        "narrowModules": { "type": "integer", "minimum": 0, "maximum": 65568 },
        "wideModules": { "type": "integer", "minimum": 0, "maximum": 65568 },
        "startingColor": { "enum": ["bar", "space"] },
        "runs": { "type": "array", "maxItems": 40980, "items": { "$ref": "#/$defs/input_run" } },
        "repeatRuns": { "$ref": "#/$defs/repeat_runs" },
        "quietZoneModules": { "type": "integer", "minimum": 0, "maximum": 4097 },
        "symbols": { "type": "array", "maxItems": 40980, "items": { "$ref": "#/$defs/symbol_descriptor" } },
        "repeatSymbols": { "$ref": "#/$defs/repeat_symbols" },
        "renderConfig": { "$ref": "#/$defs/render_config" },
        "label": { "type": "string", "maxLength": 4097 },
        "metadata": { "$ref": "#/$defs/caller_metadata" },
        "humanReadableText": { "type": ["string", "null"], "maxLength": 4096 }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["leftQuietZoneModules", "rightQuietZoneModules", "contentModules", "totalModules", "symbolLayouts"],
      "properties": {
        "leftQuietZoneModules": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "rightQuietZoneModules": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "contentModules": { "type": "integer", "minimum": 0, "maximum": 65567 },
        "totalModules": { "type": "integer", "minimum": 2, "maximum": 73759 },
        "symbolLayouts": { "type": "array", "maxItems": 40979, "items": { "$ref": "#/$defs/symbol_layout" } }
      }
    },
    "rectangle_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceLabel", "sourceIndex", "role", "moduleStart", "moduleEnd"],
      "properties": {
        "sourceLabel": { "type": "string", "maxLength": 4096 },
        "sourceIndex": { "type": "string", "pattern": "^-?[0-9]+$", "maxLength": 11 },
        "role": { "enum": ["data", "start", "stop", "guard", "check", "inter-character-gap"] },
        "moduleStart": { "type": "string", "pattern": "^[0-9]+$", "maxLength": 5 },
        "moduleEnd": { "type": "string", "pattern": "^[0-9]+$", "maxLength": 5 }
      }
    },
    "scene_metadata": {
      "type": "object",
      "maxProperties": 74,
      "required": ["label", "leftQuietZoneModules", "rightQuietZoneModules", "contentModules", "totalModules", "moduleWidthPx", "barHeightPx", "sceneWidthPx", "sceneHeightPx", "symbolCount"],
      "propertyNames": { "type": "string", "maxLength": 128 },
      "additionalProperties": { "type": "string", "maxLength": 4096 }
    },
    "rectangle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height", "fill", "metadata"],
      "properties": {
        "x": { "type": "integer", "minimum": 0, "maximum": 604233728 },
        "y": { "const": 0 },
        "width": { "type": "integer", "minimum": 1, "maximum": 537124864 },
        "height": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "fill": { "type": "string", "maxLength": 128 },
        "metadata": { "$ref": "#/$defs/rectangle_metadata" }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "background", "rectangles", "metadata"],
      "properties": {
        "width": { "type": "integer", "minimum": 1, "maximum": 604233728 },
        "height": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "background": { "type": "string", "maxLength": 128 },
        "rectangles": { "type": "array", "maxItems": 40979, "items": { "$ref": "#/$defs/rectangle" } },
        "metadata": { "$ref": "#/$defs/scene_metadata" }
      }
    },
    "run_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runCount", "contentModules", "firstRun", "lastRun", "runsSha256"],
      "properties": {
        "runCount": { "type": "integer", "minimum": 1, "maximum": 40979 },
        "contentModules": { "type": "integer", "minimum": 1, "maximum": 65567 },
        "firstRun": { "$ref": "#/$defs/output_run" },
        "lastRun": { "$ref": "#/$defs/output_run" },
        "runsSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "minLength": 64, "maxLength": 64 }
      }
    },
    "expected": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["runs"], "properties": { "runs": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/output_run" } } } },
        { "type": "object", "additionalProperties": false, "required": ["runDigest"], "properties": { "runDigest": { "$ref": "#/$defs/run_digest" } } },
        { "type": "object", "additionalProperties": false, "required": ["layout"], "properties": { "layout": { "$ref": "#/$defs/layout" } } },
        { "type": "object", "additionalProperties": false, "required": ["scene"], "properties": { "scene": { "$ref": "#/$defs/scene" } } },
        { "type": "object", "additionalProperties": false, "required": ["error"], "properties": { "error": { "enum": ["pattern-too-long", "empty-pattern", "invalid-binary-token", "invalid-width-token", "invalid-marker-configuration", "invalid-module-count", "too-many-runs", "content-too-wide", "non-alternating-runs", "invalid-quiet-zone", "too-many-symbols", "symbol-width-mismatch", "invalid-render-config", "metadata-too-large", "human-readable-text-unsupported", "invalid-source-attribution"] } } }
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "operation", "input", "expected"],
      "allOf": [
        {
          "if": { "properties": { "operation": { "const": "expand-binary" } } },
          "then": {
            "properties": {
              "input": {
                "required": ["sourceLabel", "sourceIndex", "role"],
                "oneOf": [{ "required": ["pattern"] }, { "required": ["repeat"] }]
              },
              "expected": {
                "anyOf": [{ "required": ["runs"] }, { "required": ["runDigest"] }, { "required": ["error"] }]
              }
            }
          }
        },
        {
          "if": { "properties": { "operation": { "const": "expand-width" } } },
          "then": {
            "properties": {
              "input": {
                "required": ["sourceLabel", "sourceIndex", "role"],
                "oneOf": [{ "required": ["pattern"] }, { "required": ["repeat"] }]
              },
              "expected": {
                "anyOf": [{ "required": ["runs"] }, { "required": ["runDigest"] }, { "required": ["error"] }]
              }
            }
          }
        },
        {
          "if": { "properties": { "operation": { "const": "compute-layout" } } },
          "then": {
            "properties": {
              "input": {
                "required": ["quietZoneModules"],
                "oneOf": [{ "required": ["runs"] }, { "required": ["repeatRuns"] }]
              },
              "expected": { "anyOf": [{ "required": ["layout"] }, { "required": ["error"] }] }
            }
          }
        },
        {
          "if": { "properties": { "operation": { "const": "project-scene" } } },
          "then": {
            "properties": {
              "input": {
                "required": ["quietZoneModules"],
                "oneOf": [{ "required": ["runs"] }, { "required": ["repeatRuns"] }]
              },
              "expected": { "anyOf": [{ "required": ["scene"] }, { "required": ["error"] }] }
            }
          }
        }
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^layout-v1-[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 12, "maxLength": 128 },
        "operation": { "enum": ["expand-binary", "expand-width", "compute-layout", "project-scene"] },
        "input": { "$ref": "#/$defs/input" },
        "expected": { "$ref": "#/$defs/expected" }
      }
    }
  }
}
