          "segments": [
            {
              "kind": "speech",
              "text": "тошнить (toshnít) — \"to feel sick (impersonal)\"."
            },
            {
              "kind": "speech",
              "text": "В автобусе меня часто тошнит. V avtóbuse menyá chásto toshnít. I often feel sick on the bus."
            },
            {
              "kind": "speech",
              "text": "Impersonal: меня тошнит — I feel sick. Imperfective; perfective стошнить — to be sick."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "тошнить (toshnít) is built on тошно 'sickening, miserable'; EtymDB has no entry, and the root is usually linked to the one in тоска 'longing'."
            }
          ]
        },
        {
