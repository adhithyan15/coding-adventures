              "id": "ES-C67-primer-libro-third",
              "prompt": "Which side of the noun does an ordinal take, and which habit does primer share with muy and mal?",
              "assesses": [
                "ES-GRAMMAR-ORDINAL-BEFORE-NOUN",
                "ES-GRAMMAR-APOCOPE-PATTERN"
              ],
              "responseSeconds": 16,
              "acceptedResponses": [
                "in front, and the ending is bitten off when it leans on the noun",
                "before the noun; the same shortening",
                "in front; apocope"
              ],
              "feedback": {
                "correct": "Third sighting of one habit.",
                "incorrect": "In front -- and the same biting-short you met in muy and mal."
              }
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Where does an ordinal stand? (Before the noun, unlike other adjectives.)"
            },
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "And which two lose their o? (Primero and tercero, in front of a masculine noun.)"
            }
          ]
        }
      ]
    }
