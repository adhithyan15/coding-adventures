          "title": "You'll want to know: l'annuncio",
          "segments": [
            {
              "kind": "speech",
              "text": "l'annuncio — \"the announcement; the advert\"."
            },
            {
              "kind": "speech",
              "text": "L'annuncio è arrivato alle otto di sera. The announcement came at eight in the evening."
            },
            {
              "kind": "speech",
              "text": "In a paper, gli annunci are the small ads."
            }
