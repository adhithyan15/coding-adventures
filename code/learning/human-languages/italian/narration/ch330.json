          "title": "You'll want to know: l'epoca",
          "segments": [
            {
              "kind": "speech",
              "text": "l'epoca — \"the age, the era, the period\"."
            },
            {
              "kind": "speech",
              "text": "In quell'epoca non c'era la luce elettrica. In those days there was no electric light."
            },
            {
              "kind": "speech",
              "text": "All'epoca — at the time."
            }
          ]
        },
