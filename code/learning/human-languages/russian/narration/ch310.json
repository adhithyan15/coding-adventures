      "sequence": 18390,
      "title": "юбилей (yubiléy) — a jubilee, a big round birthday or anniversary",
      "headword": "юбилей",
      "romanization": "yubiléy",
      "gloss": "a jubilee, a big round birthday or anniversary",
      "script": "cyrillic",
      "modality": "voice",
      "derivedModality": "voice",
