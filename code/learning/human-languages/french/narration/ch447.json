          "index": 1,
          "type": "input",
          "title": "You'll want to know: le pressing",
          "segments": [
            {
              "kind": "speech",
              "text": "le pressing — \"the dry cleaner’s\"."
            },
            {
              "kind": "speech",
              "text": "Il dépose sa veste au pressing le lundi. He drops his jacket off at the dry cleaner's on Mondays."
            },
            {
              "kind": "speech",
              "text": "Le nettoyage à sec — dry cleaning."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "pressing was borrowed from English pressing 'ironing', a sense English does not use for a shop. EtymDB does not list it."
            }
          ]
        },
        {
