    {
      "id": "ZH-W325-shi-world",
      "sequence": 25375,
      "title": "世 (shì) — a long bar and two verticals",
      "headword": "世",
      "romanization": "shì",
      "gloss": "世 — a long bar, two verticals, a short bar and a turning stroke",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:efd8037cd773eba9",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — a long bar and two verticals",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — a long bar and two verticals and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say qùshì — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *qùshì* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "十 去."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — shí, qù",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *shí*, *qù*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — a long bar and two verticals",
          "segments": [
            {
              "kind": "speech",
              "text": "世 (shì)."
            },
            {
              "kind": "speech",
              "text": "One piece, five strokes."
            },
            {
              "kind": "speech",
              "text": "First the long bar, from left to right."
            },
            {
              "kind": "speech",
              "text": "Then two verticals through it, the left one first, each longer above the bar than below it."
            },
            {
              "kind": "speech",
              "text": "Then a short bar joining the feet of the two verticals."
            },
            {
              "kind": "speech",
              "text": "Last, the turning stroke: down the left side, then right along the bottom, under everything."
            },
            {
              "kind": "speech",
              "text": "1 + 2 + 1 + 1 = five."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "世 (shì), all five, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 世, all five, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many strokes in 世 (shì)? (Five.) What comes after the long bar? (Two verticals through it.) What is the last stroke? (One that runs down the left and turns right along the bottom.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 世 (shì), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
