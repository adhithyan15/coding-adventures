{
  "name": "@coding-adventures/diagram-ir",
  "version": "0.1.0",
  "description": "Shared diagram intermediate representation for graph, sequence, and waveform frontends",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc",
    "test": "node node_modules/typescript/bin/tsc -p tsconfig.test.json && node --test dist-test/tests/index.test.js",
    "test:coverage": "node node_modules/typescript/bin/tsc -p tsconfig.test.json && node --experimental-test-coverage --test-coverage-lines=80 --test dist-test/tests/index.test.js"
  },
  "keywords": [
    "diagram",
    "ir",
    "graph",
    "layout",
    "paint"
  ],
  "author": "Adhithya Rajasekaran",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  }
}
