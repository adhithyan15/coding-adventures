          "segments": [
            {
              "kind": "speech",
              "text": "प्रवेशः (praveśaḥ) is built from pra, \"forward\", and the root √viś, \"to enter\", which also gives praviśati, \"enters\"; MW gives praveśa as entering, entrance (MW)."
            }
          ]
        },
