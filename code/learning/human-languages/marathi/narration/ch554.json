        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ऐनवेळी (ainveḷī) is a Marathi compound of ऐन, \"the very\", a loan usually traced to Arabic ʿain, \"eye, essence\", and वेळ, \"time\"."
            }
          ]
        },
