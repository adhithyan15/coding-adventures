        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: stressé",
          "segments": [
            {
              "kind": "speech",
              "text": "stressé — \"stressed\"."
            },
            {
              "kind": "speech",
              "text": "Je suis stressé à cause du travail. I am stressed because of work."
            },
            {
              "kind": "speech",
              "text": "Feminine stressée. Built on English stress."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "stressé is built on stress, which was borrowed from English stress \"strain, pressure\" (EtymDB). The English word goes back to Middle English destresse \"distress\"."
            }
          ]
        },
