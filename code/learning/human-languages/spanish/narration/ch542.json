        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: comenzar",
          "segments": [
            {
              "kind": "speech",
              "text": "comenzar — \"to begin, to start\"."
            },
            {
              "kind": "speech",
              "text": "La película comenzó a las nueve. The film began at nine."
            },
            {
              "kind": "speech",
              "text": "Stem change: comienza, comienzan. A little more formal than empezar. Comenzar a + infinitive."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "comenzar is inherited from spoken Latin cominitiāre (EtymDB), built on com- and initiāre 'to begin', from initium 'a beginning'."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
