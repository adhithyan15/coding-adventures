# Coverlet instruments project references during the build. Building first
# with the same production-only filter makes a clean artifact tree reliable;
# the test then reuses those instrumented binaries and enforces the threshold.
mkdir -p .dotnet/tmp .artifacts && HOME="$PWD/.dotnet" TMPDIR="$PWD/.dotnet/tmp" DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1 DOTNET_CLI_HOME="$PWD/.dotnet" dotnet build tests/CodingAdventures.WasmOpcodes.Tests/CodingAdventures.WasmOpcodes.Tests.csproj --disable-build-servers --artifacts-path .artifacts /p:CollectCoverage=true "/p:Include=[CodingAdventures.WasmOpcodes]*" && HOME="$PWD/.dotnet" TMPDIR="$PWD/.dotnet/tmp" DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1 DOTNET_CLI_HOME="$PWD/.dotnet" dotnet test tests/CodingAdventures.WasmOpcodes.Tests/CodingAdventures.WasmOpcodes.Tests.csproj --no-build --disable-build-servers --artifacts-path .artifacts /p:CollectCoverage=true /p:Threshold=95 /p:ThresholdType=line "/p:Include=[CodingAdventures.WasmOpcodes]*"
