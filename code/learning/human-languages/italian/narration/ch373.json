            },
            {
              "kind": "speech",
              "text": "Per eventuali domande, scrivete alla segreteria. For any questions, write to the office."
            },
            {
              "kind": "speech",
              "text": "It means possible, not final: eventualmente is if need be, not eventually."
            }
          ]
        },
