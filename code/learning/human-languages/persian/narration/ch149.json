        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: هدر دادن",
          "segments": [
            {
              "kind": "speech",
              "text": "هدر دادن — hadar dâdan — \"to waste\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "hadar dâdan pairs hadar, borrowed from Arabic hadar, \"something lost in vain\" (root h-d-r, Lane), with the Persian verb dâdan, \"to give\". dâdan, \"to give\", is an inherited verb; EtymDB takes it back to the Indo-European root deh₃-, \"to give\"."
            }
          ]
        },
