            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Spanish for the stay, then the Spanish for the concierge."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: el localizador",
          "segments": [
            {
              "kind": "speech",
              "text": "el localizador — \"the booking reference\"."
            },
            {
              "kind": "speech",
              "text": "Dígame el localizador de su billete, por favor. Tell me the booking reference for your ticket, please."
            },
            {
              "kind": "speech",
              "text": "A short code of letters and numbers."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "localizador is built on localizar \"to locate\", from local, a learned borrowing from Late Latin locālis (EtymDB), from locus \"place\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
            }
          ]
        },
