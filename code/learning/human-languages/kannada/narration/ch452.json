        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ಸಾರಿಗೆ",
          "segments": [
            {
              "kind": "speech",
              "text": "ಸಾರಿಗೆ — sārige — \"transport; public transport\"."
            },
            {
              "kind": "speech",
              "text": "ಈ ಊರಿಗೆ ಸರ್ಕಾರಿ ಸಾರಿಗೆ ಬಸ್ ದಿನಕ್ಕೆ ಎರಡು ಸಲ ಬರುತ್ತದೆ. ī ūrige sarkāri sārige bas dinakke eraḍu sala baruttade. A government transport bus comes to this town twice a day."
            },
            {
              "kind": "speech",
              "text": "ಸಾರಿಗೆ (sārige) ಇಲಾಖೆ, the transport department."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "ಸಾರಿಗೆ (sārige) is a Kannada word for transport whose origin is not settled."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for getting around."
            }
