          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "daqui a is \"from here to\": de, \"from\", + aqui, \"here\" ( from Vulgar Latin eccu hic), + a, \"to\"."
            }
          ]
        },
