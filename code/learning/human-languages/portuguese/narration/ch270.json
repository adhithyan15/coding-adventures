          "type": "input",
          "title": "You'll want to know: assim que",
          "segments": [
            {
              "kind": "speech",
              "text": "assim que — \"as soon as\"."
            },
            {
              "kind": "speech",
              "text": "Assim que cheguei a casa, começou a chover. As soon as I got home, it started to rain."
            },
            {
              "kind": "speech",
              "text": "Joins two events that follow each other at once. About the future it takes the subjunctive: assim que puderes."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "assim is usually traced to Latin ad sīc \"so, in this way\"; EtymDB lists it beside Spanish así, from Latin sīc \"so, thus\" (Lewis & Short)."
            }
          ]
        },
