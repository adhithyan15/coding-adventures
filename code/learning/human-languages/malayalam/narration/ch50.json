      "id": "ML-C50-now",
      "sequence": 1390,
      "title": "ഇപ്പോൾ (ippōḷ) — now",
      "headword": "ഇപ്പോൾ",
      "romanization": "ippōḷ",
      "gloss": "now",
      "script": "malayalam",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:f6ef0773b8b46c44",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new run of words: what did orupakṣē mean, and what did aṅṅane mean?"
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: ഇപ്പോൾ",
          "segments": [
            {
              "kind": "speech",
              "text": "ഇപ്പോൾ (ippōḷ) — \"now\"."
            },
            {
              "kind": "speech",
              "text": "The pointing pattern again, and this time on time rather than manner. i- is the near one, so ഇപ്പോൾ (ippōḷ) is 'at this time'. Its far partner അപ്പോൾ (appōḷ) is 'at that time, then', and the two differ by one letter."
            },
            {
              "kind": "speech",
              "text": "Tamil says இப்போது (ippōtu) — the same two pieces, put together the same way."
            },
            {
              "kind": "speech",
              "text": "The word ends on ൾ, the chillu already met at the end of നിങ്ങൾ. Kannada's word for now, ಈಗ (īga), is built from its own near-pointer and shares nothing else with this one."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "The first of five words for going away."
            }
          ]
        },
        {
          "index": 3,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "ippōḷ",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *ippōḷ*]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "it once more, slowly",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: it once more, slowly]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "ippōḷ, then aṅṅane, and hear the near and the far openers side by side",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *ippōḷ*, then *aṅṅane*, and hear the near and the far openers side by side]"
            },
            {
              "kind": "prompt",
