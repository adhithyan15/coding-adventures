        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "допустим (dopústim) is a form of допустить \"to allow, to admit\", built from до- and пустить \"to let go\", which is usually linked with пустой \"empty\"."
            }
          ]
        },
