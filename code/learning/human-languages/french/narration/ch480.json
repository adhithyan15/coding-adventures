        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: la fracture",
          "segments": [
            {
              "kind": "speech",
              "text": "la fracture — \"fracture, break (of a bone)\"."
            },
            {
              "kind": "speech",
              "text": "La radio montre une fracture du poignet. The X-ray shows a broken wrist."
            },
            {
              "kind": "speech",
              "text": "The everyday verb is se casser: il s'est cassé la jambe."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "la fracture is a learned borrowing from Latin frāctūra \"a break\", from frangere \"to break\" (Lewis & Short)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
