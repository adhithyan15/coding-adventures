        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: el flechazo",
          "segments": [
            {
              "kind": "speech",
              "text": "el flechazo — \"love at first sight\"."
            },
            {
              "kind": "speech",
              "text": "Fue un flechazo: nos casamos en un año. It was love at first sight: we married within a year."
            },
            {
              "kind": "speech",
              "text": "Literally an arrow shot, Cupid's arrow."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "flechazo is built on flecha \"arrow\" with -azo, the ending for a blow. Flecha is usually traced to French flèche."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
