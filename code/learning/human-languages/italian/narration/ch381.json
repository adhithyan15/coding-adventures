        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: il docente",
          "segments": [
            {
              "kind": "speech",
              "text": "il docente — \"the teacher, the lecturer\"."
            },
            {
              "kind": "speech",
              "text": "Il docente risponde alle domande dopo la lezione. The lecturer answers questions after the lesson."
            },
            {
              "kind": "speech",
              "text": "Formal; one form for a man or a woman. In speech, il professore."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "docente is a learned borrowing from Latin docēns, present participle of docēre \"to teach\" (Lewis & Short)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
