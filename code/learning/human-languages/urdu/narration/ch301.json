            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Urdu for an official notice, then the Urdu for a sensation."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: صحافی",
          "segments": [
            {
              "kind": "speech",
              "text": "صحافی — sahāfī — \"a journalist\"."
            },
            {
              "kind": "speech",
              "text": "صحافی نے داروغے سے سوال پوچھے۔ sahāfī ne dāroghe se savāl pūchhe. The journalist asked the inspector questions."
            },
            {
              "kind": "speech",
              "text": "Masculine or feminine, by the person meant."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "صحافی (sahāfī) is usually traced, through Persian, to Arabic ṣaḥāfa, \"the press, journalism\", with the ending -ī: one who writes for the papers."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling what happened."
