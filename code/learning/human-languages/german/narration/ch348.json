        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: die Verantwortung",
          "segments": [
            {
              "kind": "speech",
              "text": "die Verantwortung — \"the responsibility\"."
            },
            {
              "kind": "speech",
              "text": "Die Eltern tragen die Verantwortung für ihre Kinder. Parents bear responsibility for their children."
            },
            {
              "kind": "speech",
              "text": "Die Verantwortung übernehmen — to take responsibility."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Verantwortung is the noun of verantworten \"to answer for\", built on Antwort \"answer\", from Old High German antwurti and Proto-Germanic andawurdiją (EtymDB), which is built on Wort \"word\"."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
