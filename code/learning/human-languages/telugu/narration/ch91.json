              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: ask a friend what's new, then ask where they are going]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "answer that you are going home",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: answer that you are going home]"
