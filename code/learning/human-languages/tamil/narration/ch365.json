        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: கட்டுரை",
          "segments": [
            {
              "kind": "speech",
              "text": "கட்டுரை — kaṭṭurai — \"an essay; an article\"."
            },
            {
              "kind": "speech",
              "text": "என் தங்கை தன் பள்ளியைப் பற்றி ஒரு கட்டுரை எழுதினாள். eṉ taṅkai taṉ paḷḷiyaip paṟṟi oru kaṭṭurai eḻutiṉāḷ. My younger sister wrote an essay about her school."
            },
            {
              "kind": "speech",
              "text": "கட்டுரைப் போட்டி, an essay competition."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "கட்டுரை (kaṭṭurai) is native: kaṭṭu, \"to tie, build\" (DEDR 1147), and urai, \"word, speech\" (DEDR 648): words put together into a whole."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for giving reasons and opinions."
            }
          ]
        },
