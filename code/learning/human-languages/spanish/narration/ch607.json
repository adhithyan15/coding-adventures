          "segments": [
            {
              "kind": "speech",
              "text": "el medio ambiente — \"the environment\"."
            },
            {
              "kind": "speech",
              "text": "Hay que cuidar el medio ambiente. We have to look after the environment."
            },
            {
              "kind": "speech",
              "text": "Also written medioambiente; the adjective is medioambiental."
