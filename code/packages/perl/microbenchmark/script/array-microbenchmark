#!/usr/bin/env perl
use strict;
use warnings;
use FindBin;
use lib "$FindBin::Bin/../lib";
use CodingAdventures::Microbenchmark qw(array_cli);

binmode STDIN, ':raw';
binmode STDOUT, ':raw';
$| = 1;
my $status = eval { array_cli(\@ARGV) };
if ($@) {
    my $error = $@;
    $error =~ s/\s+\z//;
    print STDERR "benchmark failed: $error\n";
    exit 1;
}
exit $status;
