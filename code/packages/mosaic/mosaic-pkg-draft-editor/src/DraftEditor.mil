// DraftEditor.mil — interface (J3b of #14416; spec
// code/specs/mosaic-pkg-draft-editor.md).
//
// The plain editing surface three products need: an optional one-line
// title, a multi-line body, and labelled actions.
//
//   Title
//   ┌──────────────────────────────────┐
//   │ First light                      │   title   (only if title-label)
//   └──────────────────────────────────┘
//   Entry
//   ┌──────────────────────────────────┐
//   │ Walked to the lighthouse before  │   body    (multi-line, grows)
//   │ breakfast. The fog had …         │
//   └──────────────────────────────────┘
//   [ Save ] [ Delete ] [ Cancel ]         actions (each only if labelled)
//
// It is CONTROLLED: every keystroke emits the whole new text and the host
// owns the draft; Save commits it. That is how Journal, TaskApp's notes and
// Engram's note buffer already work, so adopting this changes no host logic.
//
// Why every label is a slot
// -------------------------
// The component draws no English of its own, so hosts localise, and a label
// doubles as its field's accessible name — the two can never disagree.
//
// Why label-gated parts
// ---------------------
// An empty `title-label` removes the title field (Engram's focused field has
// no title); an empty action label removes that button. The component can
// therefore never draw an unnamed field or an unnamed button.
//
// Why the body placeholder is a slot (0.2.0)
// ------------------------------------------
// The visible body label names the field; the placeholder is only a hint
// shown while the body is empty ("Write something…", or Engram's field
// name). 0.1.0 had none, because the multi-line field's placeholder was then
// literal-only on React, WebComponent and SwiftUI and a slot-bound one would
// have vanished there. EM-13 (2026-10-19) made `placeholder : slot:` lower on
// every backend, so the hint is now a slot like every other label. Pass ""
// for no hint, as Journal does.
//
// Why no preview
// --------------
// A markdown preview is a `node` slot with real costs (no .msl styling, one
// surface per native host, unescaped on the HTML backend); it belongs to the
// one product that wants it (Journal), composed beside this component, not
// inside it.

component DraftEditor {
  // Label of the one-line title field; "" = no title field. Also its
  // accessible name.
  slot title-label : text ;

  // The title text (host-owned draft).
  slot title-value : text ;

  // Hint shown in an empty title field.
  slot title-placeholder : text ;

  // Label of the multi-line body; REQUIRED. Also its accessible name.
  slot body-label : text ;

  // The body text (host-owned draft). Markdown, if the host wants it.
  slot body-value : text ;

  // Hint shown in an empty body; "" = no hint. Never the field's name:
  // that is `body-label`, which stays visible once the user types.
  slot body-placeholder : text ;

  // Action labels; "" = that action is not offered.
  slot save-label : text ;
  slot delete-label : text ;
  slot cancel-label : text ;

  // Fired on every edit with the whole new text.
  emit onTitleChange ( value : text ) ;
  emit onBodyChange ( value : text ) ;

  // Fired when the matching action is activated.
  emit onSave ;
  emit onDelete ;
  emit onCancel ;
}
