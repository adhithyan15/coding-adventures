          "segments": [
            {
              "kind": "speech",
              "text": "der Glückwunsch — \"the good wishes, congratulations\"."
            },
            {
              "kind": "speech",
              "text": "Er schickte ihr einen Glückwunsch zum Geburtstag. He sent her birthday wishes."
            },
            {
              "kind": "speech",
              "text": "Plural: die Glückwünsche. Herzlichen Glückwunsch! — congratulations!"
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Glückwunsch joins Glück \"luck\", Middle High German gelücke (EtymDB), and the inherited Wunsch \"wish\"."
            }
          ]
        },
