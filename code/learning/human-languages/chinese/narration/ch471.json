    {
      "id": "ZH-W471-yan-eye",
      "sequence": 35685,
      "title": "眼 (yǎn) — an eye, then a right side of six",
      "headword": "眼",
      "romanization": "yǎn",
      "gloss": "眼 — an eye of five strokes, then six on the right",
      "script": "chinese",
      "modality": "pen",
      "derivedModality": "pen",
      "modalityReasons": [
        "writing-type",
        "script-block"
      ],
      "sourceHash": "fnv1a64:54be9227828dc38e",
      "notice": {
        "modality": "pen",
        "needs": [
          "a pen and something to write on",
          "your eyes, for letter shapes on the page"
        ],
        "waitUntilStopped": [
          "Warm-up",
          "Script — an eye, then a right side of six",
          "Guided Practice"
        ],
        "text": "Before we start: this one needs your hands, so it is not a driving lesson. You will want a pen and something to write on and your eyes, for letter shapes on the page. You can listen to everything else now. I will say so again when we reach them, but leave these sections until you have stopped: Warm-up, Script — an eye, then a right side of six and Guided Practice."
      },
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "The word first, then the character inside it."
            },
            {
              "kind": "prompt",
              "action": "RECALL",
              "instruction": "say yǎnqián — R1, one lesson back, before it decays",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU RECALL: say *yǎnqián* — **R1**, one lesson back, before it decays]"
            },
            {
              "kind": "speech",
              "text": "日 前."
            },
            {
              "kind": "prompt",
              "action": "READ",
              "instruction": "each one aloud, with nothing said first — rì, qián",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU READ: each one aloud, with nothing said first — *rì*, *qián*]"
            }
          ]
        },
        {
          "index": 1,
          "type": "script",
          "title": "Script — an eye, then a right side of six",
          "segments": [
            {
              "kind": "speech",
              "text": "眼 (yǎn)."
            },
            {
              "kind": "speech",
              "text": "Two pieces, left before right. Count the pieces, not the strokes."
            },
            {
              "kind": "speech",
              "text": "The left piece, the eye, five strokes. Like 日, made tall and narrow, with one bar more: a vertical down the left, a stroke that runs right and turns down, two short bars inside, then the bar across the foot."
            },
            {
              "kind": "speech",
              "text": "The right piece, six strokes. A stroke that runs right and turns down. A bar inside, and a second one under it. Then a vertical down the left that turns up to the right at the foot, a short stroke falling to the left, and last a long stroke falling to the right."
            },
            {
              "kind": "speech",
              "text": "5 + 6 = eleven."
            }
          ]
        },
        {
          "index": 2,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "prompt",
              "action": "WRITE",
              "instruction": "眼 (yǎn), all eleven, with the model in front of you",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU WRITE: 眼, all eleven, with the model in front of you]"
            },
            {
              "kind": "prompt",
              "action": "COVER",
              "instruction": "write it again from memory, and count the pieces, not the strokes",
              "spoken": false,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU COVER: write it again from memory, and count the pieces, not the strokes]"
            }
          ]
        },
        {
          "index": 3,
          "type": "recall",
          "title": "Wrap-up Recall",
          "segments": [
            {
              "kind": "pause",
              "seconds": 3,
              "perItem": false,
              "source": "[PAUSE 3s]"
            },
            {
              "kind": "speech",
              "text": "How many pieces does 眼 (yǎn) have? (Two: five strokes and six.) What is the left piece like? (日, with one bar more.)"
            },
            {
              "kind": "speech",
              "text": "Source: Hanzi Writer Data 眼 (yǎn), pinned stroke paths and medians."
            }
          ]
        }
      ]
    },
