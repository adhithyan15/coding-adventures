        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "حمى (ḥummā) is built on the native Arabic root ḥ-m-m, \"to be hot, to heat\" (Lane). Fever is named on the root of heat, like ḥammām, \"a hot bath\"."
            }
          ]
