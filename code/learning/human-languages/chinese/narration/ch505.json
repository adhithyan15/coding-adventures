      ],
      "sourceHash": "fnv1a64:3418a50fb96ddfaf",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Mandarin for a folk song, then the Mandarin for to perform a song (on stage)."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: wǔdǎo",
          "segments": [
            {
              "kind": "speech",
              "text": "wǔdǎo — \"the art of dance\"."
            },
            {
              "kind": "speech",
              "text": "wǒ nǚ'ér xué le wǔ nián wǔdǎo — My daughter has studied dance for five years."
            },
            {
              "kind": "speech",
              "text": "Its characters come later; for now it is a word for the ear."
            },
            {
              "kind": "speech",
              "text": "Two third tones meet in this word: wǔ is said with a rising tone before dǎo, and the spelling keeps both marks."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "wǔdǎo is built from wǔ 'to dance' and dǎo 'to tread', both inherited from Middle Chinese, mjuX and dawH (Guangyun, in Baxter's transcription), which glosses the first 'singing and dancing' and the second 'to tread'. The modern third tone of dǎo is irregular: dawH would regularly give dào."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for saying how it was."
            }
          ]
        },
        {
          "index": 4,
          "type": "guided-production",
          "title": "Guided Practice",
          "segments": [
            {
              "kind": "pause",
              "seconds": 1,
              "perItem": false,
              "source": "[PAUSE 1s]"
            },
            {
