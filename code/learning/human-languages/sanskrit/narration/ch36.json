        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: मन्दम्",
          "segments": [
            {
              "kind": "speech",
              "text": "मन्दम् (mandam) — \"slowly, gently\"."
            },
            {
              "kind": "speech",
              "text": "मन्दम् asks for less speed. Doubled — mandam mandam — it means \"slowly now, slowly\", which is how it is most often said."
            },
            {
              "kind": "speech",
              "text": "This is the word you want when somebody is talking faster than you can follow, and it goes well with कृपया: kṛpayā mandam, \"slowly, please\". Said kindly, it repairs a conversation instead of stopping it."
            }
          ]
        },
        {
          "index": 2,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "The repair word for a conversation moving too fast."
            }
          ]
        },
