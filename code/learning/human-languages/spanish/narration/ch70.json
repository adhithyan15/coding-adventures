        "no-visual-dependency"
      ],
      "sourceHash": "fnv1a64:f43b4d3aa586dade",
      "notice": null,
      "blocks": [
        {
          "index": 0,
          "type": "warmup",
          "title": "Warm-up",
          "segments": [
            {
              "kind": "pause",
              "seconds": 2,
              "perItem": false,
              "source": "[PAUSE 2s]"
            },
            {
              "kind": "speech",
              "text": "You can ask cómo, say hola, and retrieve hago, haces, hace. Keep those three persons fixed while adding the verb “to say.”"
            }
          ]
        },
        {
          "index": 1,
          "type": "pronunciation",
          "title": "Sounds you'll need",
          "segments": [
            {
              "kind": "speech",
              "text": "In digo, the g before o is hard. Keep the i in all three learned forms short and clear: digo, dices, dice."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "decir means “to say” or “to tell.” It descends from Latin dīcere, “to say.” English keeps the same root in diction, dictionary, predict (“say beforehand”), and verdict (“a true saying”)."
            }
          ]
        },
        {
          "index": 3,
          "type": "grammar",
          "title": "Grammar Lens: one more three-form set",
          "segments": [
            {
              "kind": "table",
              "headers": [
                "person",
                "present of decir"
              ],
              "columns": 2,
              "rowCount": 3,
              "utterances": [
                "person: yo. present of decir: digo.",
                "person: tú. present of decir: dices.",
                "person: él / ella / usted. present of decir: dice."
              ]
            },
            {
              "kind": "speech",
              "text": "Say digo, dices, dice. The yo form has g, while the other two learned forms do not. Do not build a full table or a general vowel-change rule from this small set yet."
            },
            {
              "kind": "speech",
              "text": "Now combine it only with known language:"
            },
            {
              "kind": "speech",
              "text": "Digo hola. — “I say hello.”"
            },
            {
              "kind": "speech",
              "text": "Dices hola. — “You say hello.”"
            },
            {
              "kind": "speech",
              "text": "Dice hola. — “He, she, or formal you says hello.”"
            },
            {
              "kind": "speech",
              "text": "¿Cómo dices “hola”? — “How do you say ‘hello’?”"
            }
          ]
        },
