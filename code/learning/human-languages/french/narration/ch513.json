          "title": "You'll want to know: l'orchestre",
          "segments": [
            {
              "kind": "speech",
              "text": "l'orchestre — \"orchestra; stalls (in a theatre)\"."
            },
            {
              "kind": "speech",
              "text": "L'orchestre joue ce soir au théâtre. The orchestra is playing at the theatre tonight."
            },
            {
              "kind": "speech",
              "text": "Masculine. In a theatre, l'orchestre is also the stalls."
            }
          ]
        },
