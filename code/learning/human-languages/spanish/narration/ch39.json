      "title": "comemos — \"we eat\"",
      "headword": "comemos",
      "romanization": "comemos",
      "gloss": "\"we eat\" — and the first place -er and -ir stop agreeing",
      "script": "latin",
      "modality": "voice",
      "derivedModality": "voice",
      "modalityReasons": [
