        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: der Kassierer",
          "segments": [
            {
              "kind": "speech",
              "text": "der Kassierer — \"the cashier\"."
            },
            {
              "kind": "speech",
              "text": "Der Kassierer gibt mir die Quittung. The cashier gives me the receipt."
            },
            {
              "kind": "speech",
              "text": "Same form in the plural. A woman: die Kassiererin."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "Kassierer is built on kassieren 'to take money in', from Kasse 'till, cash box', which came from Italian cassa, from Latin capsa 'box' (EtymDB)."
            }
          ]
        },
        {
