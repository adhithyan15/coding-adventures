            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "kōyil tiruviḻāvil oliperukki mikavum cattamāka iruntatu. — At the temple festival the loudspeaker was very loud.",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: *kōyil tiruviḻāvil oliperukki mikavum cattamāka iruntatu.* — At the temple festival the loudspeaker was very loud.]"
