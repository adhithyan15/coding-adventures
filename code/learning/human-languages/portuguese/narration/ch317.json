        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: aposentar",
          "segments": [
            {
              "kind": "speech",
              "text": "aposentar — \"to retire (usually aposentar-se)\"."
            },
            {
              "kind": "speech",
              "text": "A professora aposentou-se aos sessenta e seis anos. The teacher retired at sixty-six."
            },
            {
              "kind": "speech",
              "text": "Mostly aposentar-se, the usual word in Brazil; in Portugal reformar-se is more common, though civil servants such as teachers aposentam-se."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "aposentar comes down from Old Portuguese apousentar \"to lodge, to give rest\" (EtymDB), built on pousar \"to rest\", from Latin pausāre \"to stop\" (Lewis & Short)."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
