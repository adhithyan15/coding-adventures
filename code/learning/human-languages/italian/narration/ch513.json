          "title": "You'll want to know: gareggiare",
          "segments": [
            {
              "kind": "speech",
              "text": "gareggiare — \"to compete, to race\"."
            },
            {
              "kind": "speech",
              "text": "Gareggio nei cento metri. I compete in the hundred metres."
            },
            {
              "kind": "speech",
              "text": "Built on la gara \"competition\"."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "gareggiare is built on gara \"a competition\", whose origin is not settled; an Arabic source is often suggested."
            }
          ]
        },
