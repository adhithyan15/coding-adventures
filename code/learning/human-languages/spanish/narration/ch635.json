            },
            {
              "kind": "speech",
              "text": "Before the new one: say the Spanish for to agree on, then the Spanish for to persuade."
            }
          ]
        },
        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: el pacto",
          "segments": [
            {
              "kind": "speech",
              "text": "el pacto — \"the pact, the deal\"."
            },
            {
              "kind": "speech",
              "text": "Hicimos un pacto: yo cocino y tú limpias. We made a deal: I cook and you clean."
            },
            {
              "kind": "speech",
              "text": "Pactar — to agree a deal."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "pacto is a learned borrowing from Latin pactum 'an agreement' (EtymDB), from pacisci 'to make a bargain'."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
            }
          ]
        },
