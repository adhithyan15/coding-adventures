        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "nave is usually traced to the old Iranian word for \"grandson\" that Old Persian wrote napā, the same Indo-European word as Latin nepos, \"grandson\"."
            }
          ]
        },
