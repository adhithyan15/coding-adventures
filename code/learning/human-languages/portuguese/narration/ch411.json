        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: o aluguer",
          "segments": [
            {
              "kind": "speech",
              "text": "o aluguer — \"the hire, the rental\"."
            },
            {
              "kind": "speech",
              "text": "O aluguer do carro custa quarenta euros por dia. The car hire costs forty euros a day."
            },
            {
              "kind": "speech",
              "text": "In Brazil: o aluguel. The verb is alugar."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "aluguer is inherited through Old Portuguese aloguer from Latin allocāre 'to place, to hire out' (EtymDB), built on locus 'place'."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
