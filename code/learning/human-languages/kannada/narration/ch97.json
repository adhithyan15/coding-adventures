              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: name a grandson, a granddaughter, a relative, the neighbours and an uncle]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "ask someone's address and home town; name a birthday, a wedding and a language",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: ask someone's address and home town; name a birthday, a wedding and a language]"
            },
            {
              "kind": "prompt",
              "action": "SAY",
              "instruction": "name a school, a college and an office; ask someone's job; say you know English",
              "spoken": true,
              "scored": false,
              "responseSeconds": 8,
              "source": "[YOU SAY: name a school, a college and an office; ask someone's job; say you know English]"
            }
