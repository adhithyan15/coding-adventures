        {
          "index": 1,
          "type": "input",
          "title": "You'll want to know: مرداب",
          "segments": [
            {
              "kind": "speech",
              "text": "مرداب (mordâb) — \"a marsh, a swamp\"."
            },
            {
              "kind": "speech",
              "text": "پرنده های زیادی در مرداب زندگی میکنند. Parande-hâ-ye ziyâdi dar mordâb zendegi mikonand. Many birds live in the marsh."
            },
            {
              "kind": "speech",
              "text": "Literally 'dead water': mord 'dead' + âb 'water'."
            }
          ]
        },
        {
          "index": 2,
          "type": "etymology",
          "title": "The word, taken apart",
          "segments": [
            {
              "kind": "speech",
              "text": "mordâb is usually analysed as native mord 'dead', from mordan 'to die', and âb 'water', from Middle Persian āb (EtymDB): still, standing water."
            }
          ]
        },
        {
          "index": 3,
          "type": "notice",
          "title": "What you've built",
          "segments": [
            {
              "kind": "speech",
              "text": "One more word for telling, explaining and describing at B1."
